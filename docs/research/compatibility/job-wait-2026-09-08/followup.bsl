//@используй(followup-worker.bsl как ЗамерУточнений)

Функция СостояниеПроба(ЗаданиеПроба)
	Если ЗаданиеПроба.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Возврат "active";
	ИначеЕсли ЗаданиеПроба.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		Возврат "completed";
	ИначеЕсли ЗаданиеПроба.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
		Возврат "failed";
	КонецЕсли;
	Возврат "canceled";
КонецФункции

Функция ПускПроба(Мс, Вид = "completed")
	АргПроба = Новый Массив;
	АргПроба.Добавить(Мс);
	АргПроба.Добавить(Вид);
	Возврат ФоновыеЗадания.Выполнить("ЗамерУточнений.Работа", АргПроба);
КонецФункции

Функция СвежийПроба(ЗаданиеПроба)
	Возврат ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ЗаданиеПроба.УникальныйИдентификатор);
КонецФункции

Функция ГотовыйПроба(ЗаданиеПроба)
	ПределПроба = ТекущаяУниверсальнаяДатаВМиллисекундах() + 20000;
	Пока СостояниеПроба(СвежийПроба(ЗаданиеПроба)) = "active" Цикл
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() > ПределПроба Тогда
			ВызватьИсключение "cleanup timeout";
		КонецЕсли;
	КонецЦикла;
	Возврат СвежийПроба(ЗаданиеПроба);
КонецФункции

Функция ОтветТекстПроба(ОтветПроба)
	Если ОтветПроба = Неопределено Тогда
		Возврат "undefined";
	ИначеЕсли ТипЗнч(ОтветПроба) = Тип("Массив") Тогда
		ТекстПроба = "array";
		Для Каждого ЭлементПроба Из ОтветПроба Цикл
			ТекстПроба = ТекстПроба + ":" + СостояниеПроба(ЭлементПроба);
		КонецЦикла;
		Возврат ТекстПроба;
	КонецЕсли;
	Возврат СостояниеПроба(ОтветПроба);
КонецФункции

Процедура СмесьПроба(Вид, Свежий, ТаймаутПроба)
	ОдноПроба = ПускПроба(?(Вид = "canceled", 5000, 100), Вид);
	Если Вид = "canceled" Тогда
		ОдноПроба.Отменить();
	КонецЕсли;
	ГотовоеПроба = ГотовыйПроба(ОдноПроба);
	Если Вид = "canceled" И СостояниеПроба(ГотовоеПроба) <> "canceled" Тогда
		ВызватьИсключение "Подготовка отмены не достигла состояния canceled";
	КонецЕсли;
	ДваПроба = ПускПроба(600);
	Пока ДваПроба.ПолучитьСообщенияПользователю().Количество() = 0 Цикл
	КонецЦикла;
	НаборПроба = Новый Массив;
	НаборПроба.Добавить(?(Свежий, ГотовоеПроба, ОдноПроба));
	НаборПроба.Добавить(ДваПроба);
	НачПроба = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОтветПроба = ФоновыеЗадания.ОжидатьЗавершенияВыполнения(НаборПроба, ТаймаутПроба);
	Сообщить("mix." + Вид + "." + ?(Свежий, "fresh", "stale") + "." + ?(ТаймаутПроба = Неопределено, "none", "timeout")
		+ Символ(9) + ОтветТекстПроба(ОтветПроба) + Символ(9) + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачПроба, "ЧГ=0;ЧН=0"));
	НачПроба = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПовторПроба = ФоновыеЗадания.ОжидатьЗавершенияВыполнения(ОтветПроба, 2);
	Сообщить("repeat." + Вид + "." + ?(Свежий, "fresh", "stale") + "." + ?(ТаймаутПроба = Неопределено, "none", "timeout")
		+ Символ(9) + ОтветТекстПроба(ПовторПроба) + Символ(9) + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачПроба, "ЧГ=0;ЧН=0"));
	ГотовыйПроба(ДваПроба);
КонецПроцедуры

Процедура СтарыйПроба(ИдПроба, КодПроба, ВыражениеПроба, Вид = "completed")
	ЗаданиеПроба = ПускПроба(300, Вид);
	Если Вид = "canceled" Тогда
		ЗаданиеПроба.Отменить();
	КонецЕсли;
	НаборПроба = Новый Массив;
	НаборПроба.Добавить(ЗаданиеПроба);
	НачПроба = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Если ВыражениеПроба Тогда
			ОтветПроба = Вычислить(КодПроба);
			ТекстПроба = ОтветТекстПроба(ОтветПроба);
		Иначе
			Выполнить(КодПроба);
			ТекстПроба = "ok";
		КонецЕсли;
	Исключение
		ТекстПроба = "error:" + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Сообщить(ИдПроба + Символ(9) + ТекстПроба + Символ(9) + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачПроба, "ЧГ=0;ЧН=0")
		+ Символ(9) + СостояниеПроба(СвежийПроба(ЗаданиеПроба)));
	ГотовыйПроба(ЗаданиеПроба);
КонецПроцедуры

Процедура ДробиПроба(ТаймаутПроба)
	ЗаданиеПроба = ПускПроба(1500);
	НачПроба = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Для СчетчикПроба = 1 По 100 Цикл
			ЗаданиеПроба.ОжидатьЗавершенияВыполнения(ТаймаутПроба);
		КонецЦикла;
		ТекстПроба = "ok";
	Исключение
		ТекстПроба = "error:" + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Сообщить("precision." + Формат(ТаймаутПроба, "ЧГ=0;ЧН=0;ЧРД=.") + Символ(9) + ТекстПроба + Символ(9)
		+ Формат(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачПроба, "ЧГ=0;ЧН=0"));
	ГотовыйПроба(ЗаданиеПроба);
КонецПроцедуры

Процедура ОтрицательнаяГруппаПроба(ТаймаутПроба)
	НаборПроба = Новый Массив;
	НаборПроба.Добавить(ПускПроба(300));
	НаборПроба.Добавить(ПускПроба(1000));
	НачПроба = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОтветПроба = ФоновыеЗадания.ОжидатьЗавершенияВыполнения(НаборПроба, ТаймаутПроба);
	Сообщить("negative.group." + Формат(ТаймаутПроба, "ЧГ=0;ЧРД=.") + Символ(9) + ОтветТекстПроба(ОтветПроба)
		+ Символ(9) + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачПроба, "ЧГ=0;ЧН=0"));
	Для Каждого ЗаданиеПроба Из НаборПроба Цикл
		ГотовыйПроба(ЗаданиеПроба);
	КонецЦикла;
	Сообщить("all.terminal" + Символ(9) + ОтветТекстПроба(ФоновыеЗадания.ОжидатьЗавершенияВыполнения(НаборПроба)));
КонецПроцедуры

Процедура ВложенноеПроба(МенеджерПроба)
	АргПроба = Новый Массив;
	АргПроба.Добавить(МенеджерПроба);
	ЗаданиеПроба = ГотовыйПроба(ФоновыеЗадания.Выполнить("ЗамерУточнений.Вложенное", АргПроба));
	ТекстПроба = СостояниеПроба(ЗаданиеПроба);
	Для Каждого СообщениеПроба Из ЗаданиеПроба.ПолучитьСообщенияПользователю() Цикл
		ТекстПроба = ТекстПроба + ":" + СообщениеПроба.Текст;
	КонецЦикла;
	Сообщить("nested.cancel." + ?(МенеджерПроба, "manager", "object") + Символ(9) + ТекстПроба);
КонецПроцедуры

