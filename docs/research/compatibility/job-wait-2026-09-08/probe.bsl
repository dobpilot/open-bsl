//@используй(worker.bsl как ЗамерОжидания)
// Один исходник для open-bsl и серверного модуля формы 1С.
// Состояния сравниваются символически, миллисекунды сохраняются как свидетельство.

Функция Статус(ЗаданиеПроба)
	Если ЗаданиеПроба.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Возврат "active";
	ИначеЕсли ЗаданиеПроба.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		Возврат "completed";
	ИначеЕсли ЗаданиеПроба.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
		Возврат "failed";
	КонецЕсли;
	Возврат "canceled";
КонецФункции

Процедура ДождатьсяСтартаПроба(ЗаданиеПроба)
	ПределПроба = ТекущаяУниверсальнаяДатаВМиллисекундах() + 20000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < ПределПроба Цикл
		Если ЗаданиеПроба.ПолучитьСообщенияПользователю().Количество() > 0 Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "probe start timeout";
КонецПроцедуры

Функция ЗапуститьПробу(МсРаботы, СОшибка = Ложь)
	АргПроба = Новый Массив;
	АргПроба.Добавить(МсРаботы);
	АргПроба.Добавить(СОшибка);
	Возврат ФоновыеЗадания.Выполнить("ЗамерОжидания.Работать", АргПроба);
КонецФункции

Функция СвежееПроба(ЗаданиеПроба)
	Возврат ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ЗаданиеПроба.УникальныйИдентификатор);
КонецФункции

Функция ОпросПроба(ЗаданиеПроба)
	ПределПроба = ТекущаяУниверсальнаяДатаВМиллисекундах() + 20000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < ПределПроба Цикл
		СвежПроба = СвежееПроба(ЗаданиеПроба);
		Если Статус(СвежПроба) <> "active" Тогда
			Возврат СвежПроба;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "probe cleanup timeout";
КонецФункции

Функция ОписаниеОтвета(ОтветПроба)
	Если ТипЗнч(ОтветПроба) = Тип("Массив") Тогда
		ТекстПроба = "array:" + Формат(ОтветПроба.Количество(), "ЧГ=0;ЧН=0");
		Для Каждого ЧленПроба Из ОтветПроба Цикл
			ТекстПроба = ТекстПроба + ":" + Статус(ЧленПроба);
		КонецЦикла;
		Возврат ТекстПроба;
	КонецЕсли;
	Возврат Статус(ОтветПроба);
КонецФункции

Процедура ГруппаПроба(ИдПроба, ВидПроба, СОшибка = Ложь, Устаревший = Ложь, УжеРаботают = Ложь)
	КороткоеПроба = ЗапуститьПробу(1000, СОшибка);
	Если Устаревший Тогда
		ОпросПроба(КороткоеПроба);
	КонецЕсли;
	ДлинноеПроба = ЗапуститьПробу(4000);
	Если УжеРаботают Или Устаревший Тогда
		ДождатьсяСтартаПроба(КороткоеПроба);
		ДождатьсяСтартаПроба(ДлинноеПроба);
	КонецЕсли;
	НаборПроба = Новый Массив;
	НаборПроба.Добавить(КороткоеПроба);
	НаборПроба.Добавить(ДлинноеПроба);
	НачПроба = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Если ВидПроба = "none" Тогда
			ОтветПроба = ФоновыеЗадания.ОжидатьЗавершенияВыполнения(НаборПроба);
		ИначеЕсли ВидПроба = "undefined" Тогда
			ОтветПроба = ФоновыеЗадания.ОжидатьЗавершенияВыполнения(НаборПроба, Неопределено);
		Иначе
			ОтветПроба = ФоновыеЗадания.ОжидатьЗавершенияВыполнения(НаборПроба, 10);
		КонецЕсли;
		МсПроба = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачПроба;
		Сообщить(ИдПроба + Символ(9) + ОписаниеОтвета(ОтветПроба) + Символ(9)
			+ Формат(МсПроба, "ЧГ=0;ЧН=0") + Символ(9) + "live:"
			+ Статус(СвежееПроба(КороткоеПроба)) + ":" + Статус(СвежееПроба(ДлинноеПроба)));
	Исключение
		Сообщить(ИдПроба + Символ(9) + "error:" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	ОпросПроба(КороткоеПроба);
	ОпросПроба(ДлинноеПроба);
КонецПроцедуры

Процедура АргументПроба(ИдПроба, ВыражениеПроба)
	ЗавершПроба = ОпросПроба(ЗапуститьПробу(1));
	ПустойПроба = Новый Массив;
	Попытка
		ОтветПроба = Вычислить(ВыражениеПроба);
		Сообщить(ИдПроба + Символ(9) + "accepted:" + ОписаниеОтвета(ОтветПроба));
	Исключение
		Сообщить(ИдПроба + Символ(9) + "error:" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецПроцедуры

Процедура ТаймаутПроба(ИдПроба, ТаймПроба, МенеджерПроба)
	ДолгоеПроба = ЗапуститьПробу(2500);
	ДождатьсяСтартаПроба(ДолгоеПроба);
	НаборПроба = Новый Массив;
	НаборПроба.Добавить(ДолгоеПроба);
	НачПроба = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Если МенеджерПроба Тогда
			ОтветПроба = ФоновыеЗадания.ОжидатьЗавершенияВыполнения(НаборПроба, ТаймПроба);
		Иначе
			ОтветПроба = ДолгоеПроба.ОжидатьЗавершенияВыполнения(ТаймПроба);
		КонецЕсли;
		МсПроба = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачПроба;
		Сообщить(ИдПроба + Символ(9) + ОписаниеОтвета(ОтветПроба)
			+ Символ(9) + Формат(МсПроба, "ЧГ=0;ЧН=0"));
	Исключение
		Сообщить(ИдПроба + Символ(9) + "error:" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	ОпросПроба(ДолгоеПроба);
КонецПроцедуры

Попытка
	Для НомерПроба = 1 По 3 Цикл
		СуффиксПроба = "." + Формат(НомерПроба, "ЧГ=0");
		ГруппаПроба("group.none" + СуффиксПроба, "none");
		ГруппаПроба("group.timeout" + СуффиксПроба, "timeout");
		ГруппаПроба("group.undefined" + СуффиксПроба, "undefined");
	КонецЦикла;
	ГруппаПроба("group.failed", "none", Истина);
	ГруппаПроба("group.running.timeout", "timeout", Ложь, Ложь, Истина);
	ГруппаПроба("group.stale.none", "none", Ложь, Истина);
	ГруппаПроба("group.stale.timeout", "timeout", Ложь, Истина);
	АргументПроба("arg.single", "ФоновыеЗадания.ОжидатьЗавершенияВыполнения(ЗавершПроба)");
	АргументПроба("arg.undefined", "ФоновыеЗадания.ОжидатьЗавершенияВыполнения(Неопределено)");
	АргументПроба("arg.missing", "ФоновыеЗадания.ОжидатьЗавершенияВыполнения()");
	АргументПроба("arg.empty", "ФоновыеЗадания.ОжидатьЗавершенияВыполнения(ПустойПроба)");
	ТаймаутПроба("object.none", Неопределено, Ложь);
	ТаймаутПроба("object.zero", 0, Ложь);
	ТаймаутПроба("object.negative", -1, Ложь);
	ТаймаутПроба("object.negative02", -0.2, Ложь);
	ТаймаутПроба("object.fraction02", 0.2, Ложь);
	ТаймаутПроба("object.fraction09", 0.9, Ложь);
	ТаймаутПроба("object.fraction12", 1.2, Ложь);
	ТаймаутПроба("object.fraction19", 1.9, Ложь);
	ТаймаутПроба("manager.fraction02", 0.2, Истина);
	ТаймаутПроба("manager.fraction12", 1.2, Истина);
	ТаймаутПроба("manager.negative", -1, Истина);
	Сообщить("END" + Символ(9) + "OK");
Исключение
	Сообщить("FATAL" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
