// Платформенная проба: вызывающий сеанс отменяет родителя в другом сеансе.
// Успех пробы не требует конкретного результата отмены: он измеряется.

Функция СтатусОтмены(ЗаданиеПроба)
	Если ЗаданиеПроба.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Возврат "active";
	ИначеЕсли ЗаданиеПроба.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		Возврат "completed";
	ИначеЕсли ЗаданиеПроба.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
		Возврат "failed";
	КонецЕсли;
	Возврат "canceled";
КонецФункции

Функция СвежийОтмены(ЗаданиеПроба)
	Возврат ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ЗаданиеПроба.УникальныйИдентификатор);
КонецФункции

Функция СообщенияОтмены(ЗаданиеПроба)
	ТекстПроба = "";
	Для Каждого СообщениеПроба Из ЗаданиеПроба.ПолучитьСообщенияПользователю() Цикл
		Если Лев(СообщениеПроба.Текст, 6) <> "child=" Тогда
			ТекстПроба = ТекстПроба + СообщениеПроба.Текст + ";";
		КонецЕсли;
	КонецЦикла;
	Возврат ТекстПроба;
КонецФункции

Процедура ПаузаОтмены(МсПроба)
	ПределПроба = ТекущаяУниверсальнаяДатаВМиллисекундах() + МсПроба;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < ПределПроба Цикл
	КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьОтмену(ИдПроба, ФазаПроба, РодительПроба, РебенокПроба, НачалоПроба)
	Сообщить(ИдПроба + Символ(9) + ФазаПроба + Символ(9)
		+ Формат(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПроба, "ЧГ=0;ЧН=0")
		+ Символ(9) + СтатусОтмены(СвежийОтмены(РодительПроба))
		+ Символ(9) + СтатусОтмены(СвежийОтмены(РебенокПроба))
		+ Символ(9) + СообщенияОтмены(РодительПроба)
		+ Символ(9) + СообщенияОтмены(РебенокПроба));
КонецПроцедуры

Процедура ПроверитьОтмену(ИдПроба, ВариантПроба, ОтменятьПроба, ПаузаПередОтменой = 200)
	АргПроба = Новый Массив;
	АргПроба.Добавить(ВариантПроба);
	АргПроба.Добавить(?(ОтменятьПроба, 6000, 1000));
	РодительПроба = ФоновыеЗадания.Выполнить("ЗамерОтменыОжидания.Родитель", АргПроба);
	РебенокПроба = Неопределено;
	ПределПроба = ТекущаяУниверсальнаяДатаВМиллисекундах() + 15000;
	ГотовПроба = Ложь;
	Пока Не ГотовПроба Цикл
		Для Каждого СообщениеПроба Из РодительПроба.ПолучитьСообщенияПользователю() Цикл
			Если Лев(СообщениеПроба.Текст, 6) = "child=" Тогда
				РебенокПроба = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
					Новый УникальныйИдентификатор(Сред(СообщениеПроба.Текст, 7)));
			ИначеЕсли СообщениеПроба.Текст = "before_wait" Тогда
				ГотовПроба = Истина;
			КонецЕсли;
		КонецЦикла;
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() > ПределПроба Тогда
			ВызватьИсключение "parent ready timeout";
		КонецЕсли;
	КонецЦикла;
	// Оставляем родителю время войти в метод после публикации before_wait.
	ПаузаОтмены(ПаузаПередОтменой);
	НачалоПроба = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписатьОтмену(ИдПроба, "before_cancel", РодительПроба, РебенокПроба, НачалоПроба);
	Если ОтменятьПроба Тогда
		РодительПроба.Отменить();
	КонецЕсли;
	ЗаписатьОтмену(ИдПроба, "cancel_returned", РодительПроба, РебенокПроба, НачалоПроба);
	ПаузаОтмены(100);
	ЗаписатьОтмену(ИдПроба, "after_100ms", РодительПроба, РебенокПроба, НачалоПроба);
	ПаузаОтмены(900);
	ЗаписатьОтмену(ИдПроба, "after_1000ms", РодительПроба, РебенокПроба, НачалоПроба);
	БылРодительПроба = СтатусОтмены(СвежийОтмены(РодительПроба));
	БылРебенокПроба = СтатусОтмены(СвежийОтмены(РебенокПроба));
	ПределПроба = ТекущаяУниверсальнаяДатаВМиллисекундах() + 20000;
	Пока БылРодительПроба = "active" Или БылРебенокПроба = "active" Цикл
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() > ПределПроба Тогда
			ВызватьИсключение "cleanup timeout";
		КонецЕсли;
		ПаузаОтмены(20);
		СталРодительПроба = СтатусОтмены(СвежийОтмены(РодительПроба));
		СталРебенокПроба = СтатусОтмены(СвежийОтмены(РебенокПроба));
		Если СталРодительПроба <> БылРодительПроба Тогда
			ЗаписатьОтмену(ИдПроба, "parent_changed", РодительПроба, РебенокПроба, НачалоПроба);
		КонецЕсли;
		Если СталРебенокПроба <> БылРебенокПроба Тогда
			ЗаписатьОтмену(ИдПроба, "child_changed", РодительПроба, РебенокПроба, НачалоПроба);
		КонецЕсли;
		БылРодительПроба = СталРодительПроба;
		БылРебенокПроба = СталРебенокПроба;
	КонецЦикла;
	ЗаписатьОтмену(ИдПроба, "final", РодительПроба, РебенокПроба, НачалоПроба);
КонецПроцедуры

Попытка
	ПроверитьОтмену("control.object", "object.none", Ложь);
	ПроверитьОтмену("control.manager", "manager.none", Ложь);
	Для ПовторПроба = 1 По 2 Цикл
		ХвостПроба = "." + Формат(ПовторПроба, "ЧГ=0");
		ЗадержкаПроба = ?(ПовторПроба = 1, 200, 1000);
		ПроверитьОтмену("object.none" + ХвостПроба, "object.none", Истина, ЗадержкаПроба);
		ПроверитьОтмену("object.timeout" + ХвостПроба, "object.timeout", Истина, ЗадержкаПроба);
		ПроверитьОтмену("manager.none" + ХвостПроба, "manager.none", Истина, ЗадержкаПроба);
		ПроверитьОтмену("manager.timeout" + ХвостПроба, "manager.timeout", Истина, ЗадержкаПроба);
	КонецЦикла;
	ПроверитьОтмену("object.short", "object.short", Истина);
	ПроверитьОтмену("manager.short", "manager.short", Истина);
	Сообщить("END" + Символ(9) + "OK");
Исключение
	Сообщить("FATAL" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
