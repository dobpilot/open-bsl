// Только платформа: вложенные задания и отмена ожидающего родителя.
Процедура Ребенок(ДлительностьПроба) Экспорт
	Сообщить("child_started");
	ПределПроба = ТекущаяУниверсальнаяДатаВМиллисекундах() + ДлительностьПроба;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < ПределПроба Цикл
	КонецЦикла;
	Сообщить("child_finished");
КонецПроцедуры

Процедура Родитель(ВариантПроба, ДлительностьПроба) Экспорт
	АргПроба = Новый Массив;
	АргПроба.Добавить(ДлительностьПроба);
	РебенокПроба = ФоновыеЗадания.Выполнить("ЗамерОтменыОжидания.Ребенок", АргПроба);
	Сообщить("child=" + Строка(РебенокПроба.УникальныйИдентификатор));
	ПределПроба = ТекущаяУниверсальнаяДатаВМиллисекундах() + 15000;
	Пока РебенокПроба.ПолучитьСообщенияПользователю().Количество() = 0 Цикл
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() > ПределПроба Тогда
			ВызватьИсключение "child start timeout";
		КонецЕсли;
	КонецЦикла;
	НаборПроба = Новый Массив;
	НаборПроба.Добавить(РебенокПроба);
	Попытка
		Сообщить("before_wait");
		Если ВариантПроба = "object.none" Тогда
			ОтветПроба = РебенокПроба.ОжидатьЗавершенияВыполнения();
		ИначеЕсли ВариантПроба = "object.timeout" Тогда
			ОтветПроба = РебенокПроба.ОжидатьЗавершенияВыполнения(10);
		ИначеЕсли ВариантПроба = "object.short" Тогда
			ОтветПроба = РебенокПроба.ОжидатьЗавершенияВыполнения(2);
		ИначеЕсли ВариантПроба = "manager.short" Тогда
			ОтветПроба = ФоновыеЗадания.ОжидатьЗавершенияВыполнения(НаборПроба, 2);
		ИначеЕсли ВариантПроба = "manager.none" Тогда
			ОтветПроба = ФоновыеЗадания.ОжидатьЗавершенияВыполнения(НаборПроба);
		Иначе
			ОтветПроба = ФоновыеЗадания.ОжидатьЗавершенияВыполнения(НаборПроба, 10);
		КонецЕсли;
		Сообщить("after_wait");
	Исключение
		Сообщить("caught=" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Сообщить("parent_finished");
КонецПроцедуры
