Процедура Работа(Мс, Вид = "completed") Экспорт
	Сообщить("started");
	ПределПроба = ТекущаяУниверсальнаяДатаВМиллисекундах() + Мс;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < ПределПроба Цикл
	КонецЦикла;
	Если Вид = "failed" Тогда
		ВызватьИсключение "expected failure";
	КонецЕсли;
КонецПроцедуры

Процедура Отменитель(ИдПроба) Экспорт
	ПределПроба = ТекущаяУниверсальнаяДатаВМиллисекундах() + 100;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < ПределПроба Цикл
	КонецЦикла;
	ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(ИдПроба)).Отменить();
КонецПроцедуры

Процедура Вложенное(МенеджерПроба) Экспорт
	АргПроба = Новый Массив;
	АргПроба.Добавить(2000);
	ДитяПроба = ФоновыеЗадания.Выполнить("ЗамерУточнений.Работа", АргПроба);
	АргОтмены = Новый Массив;
	// Транспорт объекта UUID в open-bsl не поддержан; проверяем ожидание,
	// передавая строковое представление и восстанавливая UUID у получателя.
	АргОтмены.Добавить(Строка(ДитяПроба.УникальныйИдентификатор));
	ОтменительПроба = ФоновыеЗадания.Выполнить("ЗамерУточнений.Отменитель", АргОтмены);
	Попытка
		Если МенеджерПроба Тогда
			НаборПроба = Новый Массив;
			НаборПроба.Добавить(ДитяПроба);
			ОтветПроба = ФоновыеЗадания.ОжидатьЗавершенияВыполнения(НаборПроба);
			Сообщить("canceled=" + Строка(ОтветПроба[0].Состояние = СостояниеФоновогоЗадания.Отменено));
		Иначе
			ОтветПроба = ДитяПроба.ОжидатьЗавершенияВыполнения();
			Сообщить("canceled=" + Строка(ОтветПроба.Состояние = СостояниеФоновогоЗадания.Отменено));
		КонецЕсли;
	Исключение
		Сообщить("error=" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецПроцедуры
