//@используй(followup-worker.bsl как ЗамерУточнений)

Функция ИтогСтарого(ЗаданиеПроба)
	СвежПроба = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ЗаданиеПроба.УникальныйИдентификатор);
	Если СвежПроба.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Возврат "active";
	ИначеЕсли СвежПроба.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		Возврат "completed";
	ИначеЕсли СвежПроба.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
		Возврат "failed";
	КонецЕсли;
	Возврат "canceled";
КонецФункции

Процедура ПробаСтарого(ИдПроба, КодПроба, ВидПроба = "completed", ВыражениеПроба = Ложь)
	АргПроба = Новый Массив;
	АргПроба.Добавить(?(ВидПроба = "canceled", 5000, 300));
	АргПроба.Добавить(ВидПроба);
	ЗаданиеПроба = ФоновыеЗадания.Выполнить("ЗамерУточнений.Работа", АргПроба);
	Если ВидПроба = "canceled" Тогда
		ЗаданиеПроба.Отменить();
		ЗаданиеПроба.ОжидатьЗавершенияВыполнения();
	КонецЕсли;
	АргПроба[0] = 900;
	АргПроба[1] = "completed";
	ДваПроба = ФоновыеЗадания.Выполнить("ЗамерУточнений.Работа", АргПроба);
	НаборПроба = Новый Массив;
	НаборПроба.Добавить(ЗаданиеПроба);
	НаборПроба.Добавить(ДваПроба);
	ПустоПроба = Новый Массив;
	НачПроба = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Если ВыражениеПроба Тогда
			ОтветПроба = Вычислить(КодПроба);
			ТекстПроба = "expression:" + Строка(ТипЗнч(ОтветПроба));
		Иначе
			Выполнить(КодПроба);
			ТекстПроба = "ok";
		КонецЕсли;
	Исключение
		ТекстПроба = "error:" + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Сообщить(ИдПроба + Символ(9) + ТекстПроба + Символ(9)
		+ Формат(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачПроба, "ЧГ=0;ЧН=0")
		+ Символ(9) + ИтогСтарого(ЗаданиеПроба) + ":" + ИтогСтарого(ДваПроба));
	ЗаданиеПроба.ОжидатьЗавершенияВыполнения();
	ДваПроба.ОжидатьЗавершенияВыполнения();
КонецПроцедуры

Попытка
	ПробаСтарого("manager.array.none", "ФоновыеЗадания.ОжидатьЗавершения(НаборПроба);");
	ПробаСтарого("manager.array.long", "ФоновыеЗадания.ОжидатьЗавершения(НаборПроба, 2);");
	ПробаСтарого("manager.array.short", "ФоновыеЗадания.ОжидатьЗавершения(НаборПроба, 0.05);");
	ПробаСтарого("manager.array.zero", "ФоновыеЗадания.ОжидатьЗавершения(НаборПроба, 0);");
	ПробаСтарого("manager.array.negative", "ФоновыеЗадания.ОжидатьЗавершения(НаборПроба, -1);");
	ПробаСтарого("manager.array.expression", "ФоновыеЗадания.ОжидатьЗавершения(НаборПроба)", "completed", Истина);
	ПробаСтарого("manager.array.failed", "ФоновыеЗадания.ОжидатьЗавершения(НаборПроба);", "failed");
	ПробаСтарого("manager.array.canceled", "ФоновыеЗадания.ОжидатьЗавершения(НаборПроба);", "canceled");
	ПробаСтарого("manager.empty", "ФоновыеЗадания.ОжидатьЗавершения(ПустоПроба);");
	ПробаСтарого("object.timeout.long", "ЗаданиеПроба.ОжидатьЗавершения(2);");
	ПробаСтарого("object.timeout.short", "ЗаданиеПроба.ОжидатьЗавершения(0.05);");
	ПробаСтарого("object.timeout.zero", "ЗаданиеПроба.ОжидатьЗавершения(0);");
	ПробаСтарого("object.timeout.negative", "ЗаданиеПроба.ОжидатьЗавершения(-1);");
	ПробаСтарого("object.twoargs", "ЗаданиеПроба.ОжидатьЗавершения(1, 2);");
	ПробаСтарого("new.object.submsnegative", "ЗаданиеПроба.ОжидатьЗавершенияВыполнения(-0.0001);");
	ПробаСтарого("new.manager.canceled.stale", "ФоновыеЗадания.ОжидатьЗавершенияВыполнения(НаборПроба);", "canceled");
	ПробаСтарого("new.manager.canceled.fresh", "НаборПроба[0] = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ЗаданиеПроба.УникальныйИдентификатор); ФоновыеЗадания.ОжидатьЗавершенияВыполнения(НаборПроба, 2);", "canceled");
	Сообщить("END" + Символ(9) + "OK");
Исключение
	Сообщить("FATAL" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
