Функция ВозвратИзОбработчикаПробы()
    Попытка
        ВызватьИсключение "return-probe";
    Исключение
        Возврат СтрНайти(ОписаниеОшибки(), "return-probe") > 0;
    КонецПопытки;
КонецФункции

Попытка
    Сообщить("return.matches" + Символы.Таб + Формат(ВозвратИзОбработчикаПробы(), "Л=en"));
    Сообщить("after.return.length" + Символы.Таб + СтрДлина(ОписаниеОшибки()));
    СчетчикПробы = 0;
    Пока СчетчикПробы < 2 Цикл
        СчетчикПробы = СчетчикПробы + 1;
        Попытка
            ВызватьИсключение "loop-probe";
        Исключение
            Если СчетчикПробы = 1 Тогда
                Продолжить;
            КонецЕсли;
            Прервать;
        КонецПопытки;
    КонецЦикла;
    Сообщить("loop.count" + Символы.Таб + СчетчикПробы);
    Сообщить("after.loop.length" + Символы.Таб + СтрДлина(ОписаниеОшибки()));
    Попытка
        ВызватьИсключение "goto-probe";
    Исключение
        Перейти ~ВнеОбработчикаПробы;
    КонецПопытки;
    ~ВнеОбработчикаПробы:
    Сообщить("after.goto.length" + Символы.Таб + СтрДлина(ОписаниеОшибки()));
    Попытка
        ВызватьИсключение "outer-probe";
    Исключение
        Сообщить("nested.return.matches" + Символы.Таб + Формат(ВозвратИзОбработчикаПробы(), "Л=en"));
        Попытка
            ВызватьИсключение "inner-probe";
        Исключение
            Перейти ~ВоВнешнийОбработчикПробы;
        КонецПопытки;
        ~ВоВнешнийОбработчикПробы:
        Сообщить("after.goto.outer" + Символы.Таб + Формат(СтрНайти(ОписаниеОшибки(), "outer-probe") > 0, "Л=en"));
    КонецПопытки;
    Сообщить("after.all.length" + Символы.Таб + СтрДлина(ОписаниеОшибки()));
Исключение
    Сообщить("probe.unsupported");
КонецПопытки;
