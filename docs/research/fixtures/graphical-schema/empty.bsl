Попытка
    СхемаПробы = Новый ГрафическаяСхема;
    СхемаДругойПробы = Новый GraphicalSchema;
    Сообщить("graphical.type" + Символ(9) + Строка(ТипЗнч(СхемаПробы)));
    Сообщить("graphical.presentation" + Символ(9) + Строка(СхемаПробы));
    Сообщить("graphical.alias-type" + Символ(9) + ?(ТипЗнч(СхемаДругойПробы) = Тип("ГрафическаяСхема"), "1", "0"));
    Сообщить("graphical.distinct" + Символ(9) + ?(СхемаПробы <> СхемаДругойПробы, "1", "0"));
    ЭлементыСхемыПробы = СхемаПробы.ЭлементыГрафическойСхемы;
    Сообщить("graphical.items.type" + Символ(9) + Строка(ТипЗнч(ЭлементыСхемыПробы)));
    Сообщить("graphical.items.presentation" + Символ(9) + Строка(ЭлементыСхемыПробы));
    Сообщить("graphical.items.count" + Символ(9) + Строка(ЭлементыСхемыПробы.Количество()));
    Сообщить("graphical.items.alias" + Символ(9) + ?(СхемаПробы.GraphicalSchemaItems = ЭлементыСхемыПробы, "1", "0"));
    Сообщить("graphical.items.find" + Символ(9) + ?(ЭлементыСхемыПробы.Найти("нет") = Неопределено, "1", "0"));
    КоличествоОбходаПробы = 0;
    Для Каждого ЭлементСхемыПробы Из ЭлементыСхемыПробы Цикл
        КоличествоОбходаПробы = КоличествоОбходаПробы + 1;
    КонецЦикла;
    Сообщить("graphical.items.iteration" + Символ(9) + Строка(КоличествоОбходаПробы));
    РезультатПрисваиванияСхемыПробы = "accepted";
    Попытка СхемаПробы.ЭлементыГрафическойСхемы = Новый Массив; Исключение РезультатПрисваиванияСхемыПробы = "rejected"; КонецПопытки;
    Сообщить("graphical.items.readonly" + Символ(9) + РезультатПрисваиванияСхемыПробы);
Исключение
    Сообщить("graphical.error" + Символ(9) + ОписаниеОшибки());
КонецПопытки;
