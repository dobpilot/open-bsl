// Начало текущего сеанса: тип, неизменность и английское имя.
Процедура М(ИдПробы, ЗначениеПробы)
    Сообщить(ИдПробы + Символ(9) + Строка(ЗначениеПробы));
КонецПроцедуры
М("SESSION.STARTED.BEGIN", "1");
Попытка
    СеансПробыДата = ПолучитьТекущийСеансИнформационнойБазы();
    НачалоПробыДата = СеансПробыДата.НачалоСеанса;
    М("SESSION.STARTED.TYPE", ?(ТипЗнч(НачалоПробыДата) = Тип("Дата"), "YES", "NO"));
    М("SESSION.STARTED.NONEMPTY", ?(ЗначениеЗаполнено(НачалоПробыДата), "YES", "NO"));
    М("SESSION.STARTED.ALIAS", ?(НачалоПробыДата = СеансПробыДата.SessionStarted, "YES", "NO"));
    ПовторПробыДата = ПолучитьТекущийСеансИнформационнойБазы().НачалоСеанса;
    М("SESSION.STARTED.STABLE", ?(НачалоПробыДата = ПовторПробыДата, "YES", "NO"));
    ОтказПробыДата = "NO";
    Попытка
        СеансПробыДата.НачалоСеанса = Дата(2001, 1, 2);
    Исключение
        ОтказПробыДата = "YES";
    КонецПопытки;
    М("SESSION.STARTED.READONLY", ОтказПробыДата);
Исключение
    М("SESSION.STARTED.ERROR", ОписаниеОшибки());
КонецПопытки;
М("SESSION.STARTED.END", "1");
