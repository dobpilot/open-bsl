Перем ОтменятьКодПробы, ИтогиКодаПробы, ИтогТелаКодаПробы;

Процедура НастроитьКод(ОтменятьПробы) Экспорт
    ОтменятьКодПробы = ОтменятьПробы;
КонецПроцедуры

Функция ПрочитатьКод() Экспорт
    Возврат ИтогиКодаПробы;
КонецФункции

Функция ПрочитатьТелоКода() Экспорт
    Возврат ИтогТелаКодаПробы;
КонецФункции

Процедура ПриУстановкеНовогоКода(СтандартнаяОбработка, Префикс)
    ИтогиКодаПробы.Добавить("standard=" + ?(СтандартнаяОбработка, "YES", "NO") + ":prefix=[" + Префикс + "]:safe=" + ?(БезопасныйРежим(), "YES", "NO") + ":disabled=" + ?(ПолучитьОтключениеБезопасногоРежима(), "YES", "NO") + ":privileged=" + ?(ПривилегированныйРежим(), "YES", "NO"));
    Попытка
        УстановитьБезопасныйРежим(Ложь);
        ИтогиКодаПробы.Добавить("clear.safe=OK:value=" + ?(БезопасныйРежим(), "YES", "NO"));
        УстановитьБезопасныйРежим(Истина);
    Исключение
        ИтогиКодаПробы.Добавить("clear.safe=ERROR");
    КонецПопытки;
    Попытка
        УстановитьОтключениеБезопасногоРежима(Ложь);
        ИтогиКодаПробы.Добавить("clear.disabled=OK:value=" + ?(ПолучитьОтключениеБезопасногоРежима(), "YES", "NO"));
        УстановитьОтключениеБезопасногоРежима(Истина);
    Исключение
        ИтогиКодаПробы.Добавить("clear.disabled=ERROR");
    КонецПопытки;
    Если ОтменятьКодПробы Тогда
        СтандартнаяОбработка = Ложь;
        Код = "manual";
    Иначе
        Префикс = "H-";
    КонецЕсли;
КонецПроцедуры

ОтменятьКодПробы = Ложь;
ИтогиКодаПробы = Новый Массив;
Попытка
    УстановитьНовыйКод();
    ИтогТелаКодаПробы = "OK";
Исключение
    ИтогТелаКодаПробы = "ERROR";
КонецПопытки;
