Функция ПроверитьКодПодавление(ОбъектПробы, РежимПробы, ПодавлениеПробы, ПривилегияПробы)
    Если ПривилегияПробы Тогда
        УстановитьПривилегированныйРежим(Истина);
    КонецЕсли;
    Если РежимПробы Тогда
        УстановитьБезопасныйРежим(Истина);
    КонецЕсли;
    Если ПодавлениеПробы Тогда
        УстановитьОтключениеБезопасногоРежима(Истина);
    КонецЕсли;
    ОбъектПробы.НастроитьКод(Истина);
    ОбъектПробы.УстановитьНовыйКод("X-");
    Возврат "safe=" + ?(БезопасныйРежим(), "YES", "NO")
        + ":disabled=" + ?(ПолучитьОтключениеБезопасногоРежима(), "YES", "NO");
КонецФункции

Попытка
    Для НомерПробы = 0 По 7 Цикл
        РежимПробы = НомерПробы = 1 Или НомерПробы = 3 Или НомерПробы = 5 Или НомерПробы = 7;
        ПодавлениеПробы = НомерПробы = 2 Или НомерПробы = 3 Или НомерПробы = 6 Или НомерПробы = 7;
        ПривилегияПробы = НомерПробы >= 4;
        Для ВидПробы = 1 По 1 Цикл
            ОбъектПробы = Справочники.CP_ЗамерКода.СоздатьЭлемент();
            МеткаПробы = ?(ВидПробы = 1, "own", "borrowed") + "." + Строка(НомерПробы);
            Если ВидПробы = 2 Тогда
                Сообщить(МеткаПробы + ".direct=" + ОбъектПробы.BP_Контроль());
            КонецЕсли;
            Сообщить(МеткаПробы + ".restored=" + ПроверитьКодПодавление(ОбъектПробы, РежимПробы, ПодавлениеПробы, ПривилегияПробы));
            Для Каждого СтрокаПробы Из ОбъектПробы.ПрочитатьКод() Цикл
                Сообщить(МеткаПробы + ".handler=" + СтрокаПробы);
            КонецЦикла;
            Сообщить(МеткаПробы + ".code=" + ОбъектПробы.Код);
            Сообщить(МеткаПробы + ".outer=" + ?(БезопасныйРежим(), "YES", "NO") + ":" + ?(ПолучитьОтключениеБезопасногоРежима(), "YES", "NO"));
        КонецЦикла;
    КонецЦикла;
Исключение
    Сообщить("probe.error=" + ОписаниеОшибки());
КонецПопытки;
