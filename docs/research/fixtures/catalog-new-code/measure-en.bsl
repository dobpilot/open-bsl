Функция ПроверитьБезопасныйКод(ОбъектКодаПробы)
    УстановитьБезопасныйРежим(Истина);
    ОбъектКодаПробы.НастроитьКод(Истина);
    ОбъектКодаПробы.УстановитьНовыйКод("S-");
    Возврат ?(БезопасныйРежим(), "YES", "NO");
КонецФункции

Попытка
    ОбъектКодаПробы = Справочники.ЗамерВременныхТаблиц.СоздатьЭлемент();
    Сообщить("catalog.code.body" + Символ(9) + ОбъектКодаПробы.ПрочитатьТелоКода());
    ОбъектКодаПробы.НастроитьКод(Истина);
    ОбъектКодаПробы.УстановитьНовыйКод("P-");
    Сообщить("catalog.code.cancel" + Символ(9) + ОбъектКодаПробы.Код);
    ОбъектКодаПробы.НастроитьКод(Ложь);
    ОбъектКодаПробы.SetNewCode();
    Сообщить("catalog.code.generate" + Символ(9) + ОбъектКодаПробы.Код);
    ИтогБезопасногоКодаПробы = ПроверитьБезопасныйКод(ОбъектКодаПробы);
    Сообщить("catalog.code.safe.restored" + Символ(9) + ИтогБезопасногоКодаПробы);
    Для Каждого СтрокаКодаПробы Из ОбъектКодаПробы.ПрочитатьКод() Цикл
        Сообщить("catalog.code.handler" + Символ(9) + СтрокаКодаПробы);
    КонецЦикла;
Исключение
    Сообщить("catalog.code.setup.error" + Символ(9) + ОписаниеОшибки());
КонецПопытки;
