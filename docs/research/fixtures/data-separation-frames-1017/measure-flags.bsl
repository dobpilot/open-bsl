Функция ФлагПробы(ЗначениеПробы)
    УстановитьБезопасныйРежимРазделенияДанных("НаименованиеЯзык1", Истина);
    РезультатПробы = "OK";
    Попытка
        УстановитьБезопасныйРежимРазделенияДанных("НаименованиеЯзык1", ЗначениеПробы);
    Исключение
        РезультатПробы = "ERROR";
    КонецПопытки;
    Возврат РезультатПробы + ";MODE=" + ?(БезопасныйРежимРазделенияДанных("НаименованиеЯзык1"), "YES", "NO");
КонецФункции

Функция ОшибкаПробы(ИмяПробы, ЗначениеПробы)
    Попытка
        УстановитьБезопасныйРежимРазделенияДанных(ИмяПробы, ЗначениеПробы);
        Возврат "OK";
    Исключение
        Возврат ОписаниеОшибки();
    КонецПопытки;
КонецФункции

