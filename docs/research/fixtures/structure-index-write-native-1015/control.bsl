Процедура ИзменитьПробу(ПараметрПробы)
    ПараметрПробы = 7;
КонецПроцедуры
Функция ВыполнитьПробу()
    СтруктураПробы = Новый Структура("Поле", 1);
    СтруктураПробы["пОЛЕ"] = 2;
    ВыводПробы = "structure.write=" + Строка(СтруктураПробы.Поле) + Символы.ПС;
    ВыводПробы = ВыводПробы + "structure.count=" + Строка(СтруктураПробы.Количество()) + Символы.ПС;
    Попытка
        СтруктураПробы["НетПоля"] = 3;
        ИтогПробы = "ACCEPTED";
    Исключение
        ИтогПробы = "ERROR";
    КонецПопытки;
    ВыводПробы = ВыводПробы + "structure.missing=" + ИтогПробы + Символы.ПС;
    Попытка
        СтруктураПробы[0] = 4;
        ИтогПробы = "ACCEPTED";
    Исключение
        ИтогПробы = "ERROR";
    КонецПопытки;
    ВыводПробы = ВыводПробы + "structure.numeric=" + ИтогПробы + Символы.ПС;
    ИсточникПробы = Новый Структура("Источник", 7);
    ИсточникПробы.Свойство("Источник", СтруктураПробы["ПОЛЕ"]);
    ВыводПробы = ВыводПробы + "structure.byref=" + Строка(СтруктураПробы.Поле) + Символы.ПС;
    ФиксированнаяПробы = Новый ФиксированнаяСтруктура(СтруктураПробы);
    Попытка
        ФиксированнаяПробы["Поле"] = 5;
        ИтогПробы = "ACCEPTED";
    Исключение
        ИтогПробы = "ERROR";
    КонецПопытки;
    Возврат ВыводПробы + "structure.fixed=" + ИтогПробы;
КонецФункции

Сообщить(ВыполнитьПробу());
Сообщить("completed=YES");
