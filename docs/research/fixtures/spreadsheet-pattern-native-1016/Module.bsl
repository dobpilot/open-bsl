&НаКлиенте
Процедура ПриОткрытии(Отказ)
    ПисательПробы = Новый ЗаписьТекста("/home/kan/Документы/develop/open-bsl/target/diagnostics/spreadsheet-pattern-native-1016/platform.oracle", "UTF-8");
    Попытка
        ПисательПробы.ЗаписатьСтроку(ВыполнитьПробу());
    Исключение
        ПисательПробы.ЗаписатьСтроку("ERROR=" + ОписаниеОшибки());
    КонецПопытки;
    ПисательПробы.ЗаписатьСтроку("completed=YES");
    ПисательПробы.Закрыть();
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры
&НаСервере
Функция ВыполнитьПробу()
    ВыводПробы = "";
    ВыводПробы = ВыводПробы + "alias=" + ПробаВыражения("?(ТипУзораТабличногоДокумента.БезУзора = SpreadsheetDocumentPatternType.WithoutPattern, ""YES"", ""NO"")") + Символы.ПС;
    ВыводПробы = ВыводПробы + "mixed=" + ПробаВыражения("?(типузоратабличногодокумента.безузора = spreadsheetdocumentpatterntype.withoutpattern, ""YES"", ""NO"")") + Символы.ПС;
    ВыводПробы = ВыводПробы + "presentation=" + ПробаВыражения("Строка(ТипУзораТабличногоДокумента.БезУзора)") + Символы.ПС;
    ВыводПробы = ВыводПробы + "value.type=" + ПробаВыражения("ТипЗнч(SpreadsheetDocumentPatternType.WithoutPattern)") + Символы.ПС;
    ВыводПробы = ВыводПробы + "lookup.ru=" + ПробаВыражения("Тип(""ТипУзораТабличногоДокумента"")") + Символы.ПС;
    ВыводПробы = ВыводПробы + "lookup.en=" + ПробаВыражения("Тип(""SpreadsheetDocumentPatternType"")") + Символы.ПС;
    ВыводПробы = ВыводПробы + "enum.type=" + ПробаВыражения("ТипЗнч(ТипУзораТабличногоДокумента)") + Символы.ПС;
    ВыводПробы = ВыводПробы + "enum.presentation=" + ПробаВыражения("Строка(ТипУзораТабличногоДокумента)") + Символы.ПС;
    ВыводПробы = ВыводПробы + "self.equal=" + ПробаВыражения("?(SpreadsheetDocumentPatternType.WithoutPattern = SpreadsheetDocumentPatternType.WithoutPattern, ""YES"", ""NO"")") + Символы.ПС;
    Возврат ВыводПробы;
КонецФункции
&НаСервере
Функция ПробаВыражения(ТекстПробы)
    Попытка
        Возврат Строка(Вычислить(ТекстПробы));
    Исключение
        Возврат "ERROR";
    КонецПопытки;
КонецФункции
