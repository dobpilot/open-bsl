Функция КаноническаяПроба(ТекстXMLПробы, ИмяПробы, ФильтрПробы)
    ЧитательПробы = Новый ЧтениеXML;
    ЧитательПробы.УстановитьСтроку(ТекстXMLПробы);
    СтроительПробы = Новый ПостроительDOM;
    ДокументПробы = СтроительПробы.Прочитать(ЧитательПробы);
    ЧитательПробы.Закрыть();
    КанонизаторПробы = Новый ПреобразованиеККаноническомуXML;
    Для Каждого АлгоритмПробы Из СтрРазделить("КаноническийXML,КаноническийXMLСКомментариями,ИсключающийКаноническийXML,ИсключающийКаноническийXMLСКомментариями,КаноническийXML1_1,КаноническийXML1_1СКомментариями", ",") Цикл
        РезультатПробы = "<rejected>";
        Попытка
            ТипАлгоритмаПробы = Вычислить("ТипКаноническогоXML." + АлгоритмПробы);
            Если ПустаяСтрока(ФильтрПробы) Тогда
                РезультатПробы = КанонизаторПробы.КанонизироватьВСтроку(ДокументПробы, ТипАлгоритмаПробы);
            Иначе
                РезультатПробы = КанонизаторПробы.КанонизироватьВСтроку(ДокументПробы, ТипАлгоритмаПробы, ФильтрПробы);
            КонецЕсли;
        Исключение
        КонецПопытки;
        Сообщить("canonical.extended." + ИмяПробы + "." + АлгоритмПробы + Символ(9) + СтрЗаменить(РезультатПробы, Символ(10), "\n"));
    КонецЦикла;
    Возврат Истина;
КонецФункции
