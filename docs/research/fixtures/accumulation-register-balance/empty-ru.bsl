Попытка
    ТаблицаОстатковПробы = РегистрыНакопления.ЗамерОстатков.Остатки(Дата(2020, 1, 1));
    Сообщить("balance.rows" + Символ(9) + Строка(ТаблицаОстатковПробы.Количество()));
    Сообщить("balance.columns" + Символ(9) + Строка(ТаблицаОстатковПробы.Колонки.Количество()));
    Для Каждого КолонкаОстатковПробы Из ТаблицаОстатковПробы.Колонки Цикл
        Сообщить("balance.column" + Символ(9) + КолонкаОстатковПробы.Имя);
        Сообщить("balance.column.type" + Символ(9) + Строка(КолонкаОстатковПробы.ТипЗначения));
        Если КолонкаОстатковПробы.Имя = "Категория" Тогда
            Сообщить("balance.string.length" + Символ(9) + Строка(КолонкаОстатковПробы.ТипЗначения.КвалификаторыСтроки.Длина));
        Иначе
            Сообщить("balance.number.digits" + Символ(9) + Строка(КолонкаОстатковПробы.ТипЗначения.КвалификаторыЧисла.Разрядность));
            Сообщить("balance.number.fraction" + Символ(9) + Строка(КолонкаОстатковПробы.ТипЗначения.КвалификаторыЧисла.РазрядностьДробнойЧасти));
        КонецЕсли;
    КонецЦикла;
Исключение
    Сообщить("balance.error" + Символ(9) + ОписаниеОшибки());
КонецПопытки;
