Функция ПроверитьКодПодавление(ОбъектПробы, РежимПробы, ПодавлениеПробы)
    Если РежимПробы Тогда
        УстановитьБезопасныйРежим(Истина);
    КонецЕсли;
    Если ПодавлениеПробы Тогда
        УстановитьОтключениеБезопасногоРежима(Истина);
    КонецЕсли;
    ОбъектПробы.НастроитьКод(Истина);
    ОбъектПробы.УстановитьНовыйКод("X-");
    Возврат "safe=" + ?(БезопасныйРежим(), "YES", "NO")
        + ":disabled=" + ?(ПолучитьОтключениеБезопасногоРежима(), "YES", "NO");
КонецФункции

Попытка
    Сообщить("canary.own.body=" + Справочники.CP_ЗамерКода.СоздатьЭлемент().ПрочитатьТелоКода());
    Сообщить("canary.borrowed=" + Справочники.ЗамерВременныхТаблиц.СоздатьЭлемент().BP_Контроль());
    Для НомерПробы = 0 По 3 Цикл
        РежимПробы = НомерПробы = 1 Или НомерПробы = 3;
        ПодавлениеПробы = НомерПробы >= 2;
        Для ВидПробы = 1 По 2 Цикл
            ОбъектПробы = ?(ВидПробы = 1, Справочники.CP_ЗамерКода.СоздатьЭлемент(), Справочники.ЗамерВременныхТаблиц.СоздатьЭлемент());
            МеткаПробы = ?(ВидПробы = 1, "own", "borrowed") + "." + Строка(НомерПробы);
            Если ВидПробы = 2 Тогда
                Сообщить(МеткаПробы + ".direct=" + ОбъектПробы.BP_Контроль());
            КонецЕсли;
            Сообщить(МеткаПробы + ".restored=" + ПроверитьКодПодавление(ОбъектПробы, РежимПробы, ПодавлениеПробы));
            Для Каждого СтрокаПробы Из ОбъектПробы.ПрочитатьКод() Цикл
                Сообщить(МеткаПробы + ".handler=" + СтрокаПробы);
            КонецЦикла;
            Сообщить(МеткаПробы + ".code=" + ОбъектПробы.Код);
            Сообщить(МеткаПробы + ".description=" + ОбъектПробы.Наименование);
            Если ВидПробы = 2 Тогда
                РежимыПерехватчиковПробы = ОбъектПробы.BP_ПрочитатьКод();
                Если РежимыПерехватчиковПробы <> Неопределено Тогда
                    Для Каждого СтрокаПерехватчикаПробы Из РежимыПерехватчиковПробы Цикл
                        Сообщить(МеткаПробы + ".hook=" + СтрокаПерехватчикаПробы);
                    КонецЦикла;
                КонецЕсли;
            КонецЕсли;
            Сообщить(МеткаПробы + ".outer=" + ?(БезопасныйРежим(), "YES", "NO") + ":" + ?(ПолучитьОтключениеБезопасногоРежима(), "YES", "NO"));
        КонецЦикла;
    КонецЦикла;
Исключение
    Сообщить("probe.error=" + ОписаниеОшибки());
КонецПопытки;
