Процедура УровеньПробы(ИдентификаторПробы, ОбъектПробы, РежимПробы = "Уровень")
    Попытка
        Если РежимПробы = "Тело" Тогда
            РезультатПробы = ОбъектПробы.ПрочитатьТело();
        ИначеЕсли РежимПробы = "Метод" Тогда
            РезультатПробы = Строка(ОбъектПробы.ПрочитатьУровень());
        ИначеЕсли РежимПробы = "Alias" Тогда
            РезультатПробы = Строка(ОбъектПробы.lEvEl());
        Иначе
            РезультатПробы = Строка(ОбъектПробы.Уровень());
        КонецЕсли;
    Исключение
        РезультатПробы = "ERROR";
    КонецПопытки;
    Сообщить(ИдентификаторПробы + Символ(9) + РезультатПробы);
КонецПроцедуры
Попытка
    ЭлементПробы = Справочники.ЗамерВременныхТаблиц.СоздатьЭлемент();
    УровеньПробы("catalog.level.flat", ЭлементПробы);
    УровеньПробы("catalog.level.flat.body", ЭлементПробы, "Тело");
Исключение
