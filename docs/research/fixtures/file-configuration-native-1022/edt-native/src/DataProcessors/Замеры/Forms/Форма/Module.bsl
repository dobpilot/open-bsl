

// Приёмник вывода: дописывает строку в файл. Открытие на каждой строке —
// сознательно: строк меньше сотни, зато нет ни модульных переменных, ни
// зависимости от того, переживает ли что-то серверный вызов.
&НаСервереБезКонтекста
Процедура СообщитьВФайл(Текст)
	Ф = Новый ЗаписьТекста("/tmp/tmp.cLLWduSyW5/platform-output.tsv", , , Истина);
	Ф.ЗаписатьСтроку(Строка(Текст));
	Ф.Закрыть();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОчиститьФайлВывода()
	// Файл создаётся заново на каждом прогоне — иначе замеры копились бы.
	ФайлВывода = Новый ЗаписьТекста("/tmp/tmp.cLLWduSyW5/platform-output.tsv");
	ФайлВывода.Закрыть();
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВыполнитьТестНаСервере();
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьТестНаСервере()
	ОчиститьФайлВывода();

	Попытка
	    ДокументПробыФайлов = Новый ТекстовыйДокумент;
	    ДокументПробыФайлов.УстановитьТекст("Контроль & <тег>" + Символы.ПС + "Вторая строка");
	    ЗаписьПробыФайлов = Новый ЗаписьXML;
	    ЗаписьПробыФайлов.УстановитьСтроку();
	    СериализаторXDTO.ЗаписатьXML(ЗаписьПробыФайлов, ДокументПробыФайлов);
	    СообщитьВФайл("text-template.xdto=" + ЗаписьПробыФайлов.Закрыть());
	Исключение
	    СообщитьВФайл("text-template.error=" + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры
