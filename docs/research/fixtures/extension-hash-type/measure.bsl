// Фактический тип хеша расширения, отдельно от строкового вывода ibcmd.
Процедура М(ИдПробы, ЗначениеПробы)
    Сообщить(ИдПробы + Символ(9) + Строка(ЗначениеПробы));
КонецПроцедуры
М("EXTENSION.HASH.BEGIN", "1");
Попытка
    РасширенияПробы = РасширенияКонфигурации.Получить();
    М("EXTENSION.HASH.COUNT", РасширенияПробы.Количество());
    Для Каждого РасширениеПробы Из РасширенияПробы Цикл
        ХешПробы = РасширениеПробы.ХешСумма;
        М("EXTENSION.HASH.NAME", РасширениеПробы.Имя);
        М("EXTENSION.HASH.IS.STRING", ?(ТипЗнч(ХешПробы) = Тип("Строка"), "YES", "NO"));
        М("EXTENSION.HASH.IS.BINARY", ?(ТипЗнч(ХешПробы) = Тип("ДвоичныеДанные"), "YES", "NO"));
        М("EXTENSION.HASH.BASE64", Base64Строка(ХешПробы));
        М("EXTENSION.HASH.BASE64.STRING", Base64Строка("icDIE9O50FZS7IzvkeL/bxMT8+A="));
    КонецЦикла;
Исключение
    М("EXTENSION.HASH.ERROR", ОписаниеОшибки());
КонецПопытки;
М("EXTENSION.HASH.END", "1");
