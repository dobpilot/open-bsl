Попытка
    ИменаХраненияПробы = Новый Массив;
    ИменаХраненияПробы.Добавить("Документ.ЗамерДокумента");
    ИменаХраненияПробы.Добавить("Документ.АльфаМомента");
    ИменаХраненияПробы.Добавить("Документ.ЯмаМомента");
    СтруктураХраненияПробы = ПолучитьСтруктуруХраненияБазыДанных(ИменаХраненияПробы);
    Для Каждого КолонкаХраненияПробы Из СтруктураХраненияПробы.Колонки Цикл
        Сообщить("kinds.storage.column" + Символ(9) + КолонкаХраненияПробы.Имя);
    КонецЦикла;
    Для Каждого СтрокаХраненияПробы Из СтруктураХраненияПробы Цикл
        Для Каждого КолонкаХраненияПробы Из СтруктураХраненияПробы.Колонки Цикл
            ЗначениеХраненияПробы = СтрокаХраненияПробы[КолонкаХраненияПробы.Имя];
            Если ТипЗнч(ЗначениеХраненияПробы) <> Тип("ТаблицаЗначений") Тогда
                Сообщить("kinds.storage.cell" + Символ(9) + КолонкаХраненияПробы.Имя + ";" + Строка(ЗначениеХраненияПробы));
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
Исключение
    Сообщить("kinds.storage.error" + Символ(9) + ОписаниеОшибки());
КонецПопытки;
