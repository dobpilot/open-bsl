&НаКлиенте
Процедура ПриОткрытии(Отказ)
    ПисательПробы = Новый ЗаписьТекста("/home/kan/Документы/develop/open-bsl/docs/research/fixtures/metadata-explicit-subjects-native-1018/platform.oracle", "UTF-8");
    Попытка
        ПисательПробы.ЗаписатьСтроку(ВыполнитьПробу());
    Исключение
        ПисательПробы.ЗаписатьСтроку("ERROR=" + ОписаниеОшибки());
    КонецПопытки;
    ПисательПробы.ЗаписатьСтроку("completed=YES");
    ПисательПробы.Закрыть();
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры
&НаСервере
Функция ВыполнитьПробу()
    ПользовательПробы = ПользователиИнформационнойБазы.ТекущийПользователь();
    ВыводПробы = "user=" + ПользовательПробы.Имя + Символы.ПС;
    СубъектыПробы = Новый Массив;
    СубъектыПробы.Добавить(Неопределено);
    СубъектыПробы.Добавить(Метаданные.Роли.RootAllow);
    СубъектыПробы.Добавить(Метаданные.Роли.RootDeny);
    СубъектыПробы.Добавить(Метаданные.Роли.RootSaveOnly);
    СубъектыПробы.Добавить(ПользовательПробы);
    СтандартыПробы = Новый Массив;
    СтандартыПробы.Добавить(Неопределено);
    СтандартыПробы.Добавить("Code");
    СтандартыПробы.Добавить("Description");
    Для РежимПробы = 0 По 1 Цикл
        Для ИндексСубъектаПробы = 0 По 4 Цикл
            Для ИндексСтандартаПробы = 0 По 2 Цикл
                Для Каждого ПравоПробы Из СтрРазделить("Read,View", ",") Цикл
                    МеткаПробы = "priv=" + Строка(РежимПробы) + ";subject=" + Строка(ИндексСубъектаПробы) + ";standard=" + Строка(ИндексСтандартаПробы) + ";right=" + ПравоПробы;
                    ВыводПробы = ВыводПробы + МеткаПробы + "=" + ПроверитьСубъектПробы(ПравоПробы, СтандартыПробы[ИндексСтандартаПробы], СубъектыПробы[ИндексСубъектаПробы], РежимПробы = 1) + Символы.ПС;
                КонецЦикла;
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;
    Возврат ВыводПробы;
КонецФункции

&НаСервере
Функция ПроверитьСубъектПробы(ПравоПробы, СтандартПробы, СубъектПробы, ПривилегияПробы)
    Если ПривилегияПробы Тогда
        УстановитьПривилегированныйРежим(Истина);
    КонецЕсли;
    Попытка
        РезультатПробы = ?(ПравоДоступа(ПравоПробы, Метаданные.Справочники.ВладелецПробы, СубъектПробы, СтандартПробы), "YES", "NO");
    Исключение
        РезультатПробы = "ERROR:" + ОписаниеОшибки();
    КонецПопытки;
    Если ПривилегияПробы Тогда
        УстановитьПривилегированныйРежим(Ложь);
    КонецЕсли;
    Возврат РезультатПробы;
КонецФункции
