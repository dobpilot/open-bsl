&НаКлиенте
Процедура ПриОткрытии(Отказ)
    ПисательПробы = Новый ЗаписьТекста("/home/kan/Документы/develop/open-bsl/target/diagnostics/default-interface-native-1016/platform.oracle", "UTF-8");
    Попытка
        ПисательПробы.ЗаписатьСтроку(СнятьПробы());
        ПисательПробы.ЗаписатьСтроку("completed=YES");
    Исключение
        ПисательПробы.ЗаписатьСтроку("ERROR=" + ОписаниеОшибки());
    КонецПопытки;
    ПисательПробы.Закрыть();
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры
&НаСервере
Функция Проба(Ид, ВыражениеПробы, ВыполнитьПрисваивание)
    Попытка
        Если ВыполнитьПрисваивание Тогда
            Выполнить(ВыражениеПробы);
            Возврат Ид + "=WRITE:OK";
        КонецЕсли;
        ЗначениеПробы = Вычислить(ВыражениеПробы);
        Возврат Ид + "=OK:TYPE:" + Строка(ТипЗнч(ЗначениеПробы)) + ";VALUE:" + Строка(ЗначениеПробы);
    Исключение
        Возврат Ид + "=ERROR:" + СтрЗаменить(СтрЗаменить(ОписаниеОшибки(), Символы.ПС, "|"), Символы.ВК, "|");
    КонецПопытки;
КонецФункции
&НаСервере
Функция СнятьПробы()
    СледПробы = "";
    СледПробы = СледПробы + Проба("anchor.name", "Метаданные.Имя", Ложь) + Символы.ПС;
    СледПробы = СледПробы + Проба("interface.ru", "Метаданные.ОсновнойИнтерфейс", Ложь) + Символы.ПС;
    СледПробы = СледПробы + Проба("interface.en", "Метаданные.DefaultInterface", Ложь) + Символы.ПС;
    СледПробы = СледПробы + Проба("interface.alias.equal", "Метаданные.ОсновнойИнтерфейс = Метаданные.DefaultInterface", Ложь) + Символы.ПС;
    СледПробы = СледПробы + Проба("interface.empty", "Метаданные.ОсновнойИнтерфейс = Неопределено", Ложь) + Символы.ПС;
    СледПробы = СледПробы + Проба("interface.case", "Метаданные.dEfAuLtInTeRfAcE", Ложь) + Символы.ПС;
    СледПробы = СледПробы + Проба("anchor.language", "Метаданные.ОсновнойЯзык.Имя", Ложь) + Символы.ПС;
    СледПробы = СледПробы + Проба("interface.write.ru", "Метаданные.ОсновнойИнтерфейс = Неопределено;", Истина) + Символы.ПС;
    СледПробы = СледПробы + Проба("interface.write.en", "Метаданные.DefaultInterface = Неопределено;", Истина) + Символы.ПС;
    Возврат Лев(СледПробы, СтрДлина(СледПробы)-СтрДлина(Символы.ПС));
КонецФункции
