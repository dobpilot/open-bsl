Процедура ПробаРазмерДанных(ИдентификаторПробы, ВыражениеПробы, ПроверитьНоль = Ложь)
    ОбъектыПробы = Новый Массив;
    ОбъектыПробы.Добавить(Метаданные.РегистрыСведений.ЗамерПолучить);
    Попытка
        РазмерПробы = Вычислить(ВыражениеПробы);
        Если ПроверитьНоль Тогда
            РезультатПробы = Строка(РазмерПробы);
        Иначе
            РезультатПробы = Строка(ТипЗнч(РазмерПробы) = Тип("Число")) + "|" + Строка(РазмерПробы >= 0);
        КонецЕсли;
    Исключение
        РезультатПробы = "ERROR";
    КонецПопытки;
    Сообщить(ИдентификаторПробы + Символ(9) + РезультатПробы);
КонецПроцедуры
