// Лексические формы `XMLСтрока`, используемые ключом пула Connector.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

РезультатНеопределено = "<ошибка>";
Попытка
	РезультатНеопределено = XMLСтрока(Неопределено);
Исключение
КонецПопытки;
М("XML.STRING.UNDEFINED", РезультатНеопределено);

РезультатNull = "<ошибка>";
Попытка
	РезультатNull = XMLСтрока(Null);
Исключение
КонецПопытки;
М("XML.STRING.NULL", РезультатNull);

М("XML.STRING.STRING", XMLСтрока("аб"));
М("XML.STRING.BOOLEAN", XMLСтрока(Истина));
М("XML.STRING.NUMBER", XMLСтрока(12.50));
М("XML.STRING.DATE", XMLСтрока(Дата(2026, 8, 13, 10, 20, 30)));
