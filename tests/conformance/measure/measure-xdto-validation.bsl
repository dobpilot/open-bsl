// Контракт ПРОВЕРКИ ЗНАЧЕНИЙ XDTO на 8.3.27: где платформа сверяет значение
// с фасетами типа (создание, запись, список, чтение документа, `Проверить`)
// и есть ли у типов и у `ЗначениеXDTO` отдельный метод проверки.
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-xdto-validation.bsl
//
// Правила те же, что у `measure-xdto.bsl`: строка `МЕТКА<таб>ЗНАЧЕНИЕ`, всё
// рискованное — через `Вычислить`/`Выполнить` внутри `Попытка`, приёмники
// проб — переменные МОДУЛЯ, одна проба на строку.
//
// ИМЯ `Ф` ЗАНЯТО ОБВЯЗКОЙ ЗАМЕРОВ: генератор модуля формы держит в `Ф` свою
// `ЗаписьТекста`, поэтому фабрика здесь — `Фаб`.
//
// СХЕМА ЗДЕСЬ СВОЯ, а не та, что в `measure-xdto.bsl`: каждый проверяемый
// вид фасета вынесен в ОТДЕЛЬНЫЙ тип, чтобы отказ нельзя было списать на
// соседний фасет. У `measure-xdto.bsl` тип `Code` несёт сразу длины и
// образец, и по его отказу не видно, какой фасет сработал.
//
// СОЗНАТЕЛЬНОЕ РАСХОЖДЕНИЕ С ЭТИМ ИНТЕРПРЕТАТОРОМ — РОВНО ФАСЕТ `pattern`,
// и оно двустороннее. Движка регулярных выражений в дереве нет, поэтому
// проверка значения по типу СХЕМЫ с образцом отвечает честной ошибкой «не
// поддерживается» вместо разбора образца: на ВАЛИДНОМ значении платформа
// отвечает «ок», а интерпретатор — `<ошибка>`. У ВСТРОЕННЫХ типов XML
// Schema образец, наоборот, пропускается: отказывать по нему нельзя,
// потому что образец `[\-+]?[0-9]+` у `xs:integer` наследует всякий
// `xs:int`, и отказ съел бы любую запись в целое. Поэтому расходятся ровно
// шесть строк, и все шесть — про образец:
//
//   сз Name с цифры, сз Name с пробелом, сз NCName с двоеточием
//       — платформа отвергает по образцу встроенного типа, здесь проходит;
//   обр Pat валидное, обр Pat в свойство, обр Pat чтение
//       — платформа принимает, здесь честный отказ «не поддерживается».
//
// Они помечены тут, чтобы построчное сличение не считало их регрессией.
// Невалидные значения отвергают обе стороны, так что наблюдаемый факт
// отказа в них совпадает.
//
// ИЗМЕРЕНО 13.08.2026 на 8.3.27.2130.

Перем Фаб;
Перем Соб;
Перем Знч;
Перем ТипЗн;
Перем ТипТ;
Перем ОбП;
Перем Чтр;
Перем ИмяВх;
Перем ЛексВх;
Перем ТекстСхемы;
Перем ПутьСхемы;
Перем ТекстСхемы2;
Перем ПутьСхемы2;
Перем Фаб2;
Перем Сер;
Перем НСXSD;

Процедура П(Метка, Значение)
	Сообщить(Метка + Символ(9) + Значение);
КонецПроцедуры

Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Р = СтрЗаменить(Р, Символ(10), "<ПС>");
	Р = СтрЗаменить(Р, Символ(9), "<Т>");
	Возврат Р;
КонецФункции

// Проба ВЫРАЖЕНИЯ: тип результата и его строковое представление.
Функция Ч(Выражение)
	Попытка
		Р = Вычислить(Выражение);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Попытка
		Возврат Строка(ТипЗнч(Р)) + " [" + Видимо(Строка(Р)) + "]";
	Исключение
		Возврат Строка(ТипЗнч(Р)) + " <не печатается>";
	КонецПопытки;
КонецФункции

// Сбор в модульную переменную `Соб`.
Функция Сбор(Код)
	Попытка
		Соб = "";
		Выполнить(Код);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат Видимо(Соб);
КонецФункции

// Проба `Создать` от СВОЕГО типа значения: принята ли лексическая форма и
// что вышло значением. Печатается именно значение, а не тип: у списочных
// типов вид коллекции здесь расходится по другой, уже описанной причине
// (`ФиксированныйМассив` против `Массив`), поэтому списки пробуются
// отдельно, счётом элементов.
Функция Соз(Имя, Лексика)
	ИмяВх = Имя;
	ЛексВх = Лексика;
	Попытка
		Знч = Вычислить("Фаб.Создать(Фаб.Тип(""urn:v"", ИмяВх), ЛексВх)");
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Попытка
		Возврат "ок [" + Видимо(Строка(Знч.Значение)) + "]";
	Исключение
		Возврат "ок <не печатается>";
	КонецПопытки;
КонецФункции

// То же от ВСТРОЕННОГО типа XML Schema — фасеты у них наследуются по
// цепочке (`int` от `long` от `integer` от `decimal`), и проверяется как
// раз она.
Функция СозВст(Имя, Лексика)
	ИмяВх = Имя;
	ЛексВх = Лексика;
	Попытка
		Знч = Вычислить("Фаб.Создать(Фаб.Тип(НСXSD, ИмяВх), ЛексВх)");
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Попытка
		Возврат "ок [" + Видимо(Строка(Знч.Значение)) + "]";
	Исключение
		Возврат "ок <не печатается>";
	КонецПопытки;
КонецФункции

// Свежий пустой экземпляр составного типа в `ОбП`.
Процедура НовыйОбъект()
	ОбП = Фаб.Создать(ТипТ);
КонецПроцедуры

// Читатель над текстом — приёмник модульный, чтобы пробы `Вычислить`
// видели его по имени.
Процедура НовыйЧитатель(Текст)
	Чтр = Новый ЧтениеXML;
	Чтр.УстановитьСтроку(Текст);
КонецПроцедуры

// --- схема ----------------------------------------------------------------

НСXSD = "http://www.w3.org/2001/XMLSchema";

ТекстСхемы = "<?xml version=""1.0"" encoding=""UTF-8""?>"
	+ "<xs:schema xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:t=""urn:v"""
	+ " targetNamespace=""urn:v"" elementFormDefault=""qualified"""
	+ " attributeFormDefault=""unqualified"">"
	+ "<xs:simpleType name=""Col""><xs:restriction base=""xs:string"">"
	+ "<xs:enumeration value=""red""/><xs:enumeration value=""green""/>"
	+ "</xs:restriction></xs:simpleType>"
	+ "<xs:simpleType name=""Len""><xs:restriction base=""xs:string"">"
	+ "<xs:minLength value=""2""/><xs:maxLength value=""5""/>"
	+ "</xs:restriction></xs:simpleType>"
	+ "<xs:simpleType name=""Len2""><xs:restriction base=""t:Len"">"
	+ "<xs:maxLength value=""3""/></xs:restriction></xs:simpleType>"
	+ "<xs:simpleType name=""Fix""><xs:restriction base=""xs:string"">"
	+ "<xs:length value=""3""/></xs:restriction></xs:simpleType>"
	+ "<xs:simpleType name=""Rng""><xs:restriction base=""xs:decimal"">"
	+ "<xs:minInclusive value=""0""/><xs:maxExclusive value=""100""/>"
	+ "</xs:restriction></xs:simpleType>"
	+ "<xs:simpleType name=""Rng2""><xs:restriction base=""xs:decimal"">"
	+ "<xs:minExclusive value=""0""/><xs:maxInclusive value=""100""/>"
	+ "</xs:restriction></xs:simpleType>"
	+ "<xs:simpleType name=""Dig""><xs:restriction base=""xs:decimal"">"
	+ "<xs:totalDigits value=""4""/><xs:fractionDigits value=""2""/>"
	+ "</xs:restriction></xs:simpleType>"
	+ "<xs:simpleType name=""Pat""><xs:restriction base=""xs:string"">"
	+ "<xs:pattern value=""[A-Z]+""/></xs:restriction></xs:simpleType>"
	+ "<xs:simpleType name=""Lst""><xs:list itemType=""t:Len""/></xs:simpleType>"
	+ "<xs:simpleType name=""LstMax""><xs:restriction base=""t:Lst"">"
	+ "<xs:maxLength value=""2""/></xs:restriction></xs:simpleType>"
	+ "<xs:simpleType name=""Uni""><xs:union memberTypes=""t:Col xs:int""/></xs:simpleType>"
	+ "<xs:simpleType name=""ColN""><xs:restriction base=""xs:decimal"">"
	+ "<xs:enumeration value=""1.0""/><xs:enumeration value=""2""/>"
	+ "</xs:restriction></xs:simpleType>"
	+ "<xs:simpleType name=""Bin""><xs:restriction base=""xs:base64Binary"">"
	+ "<xs:maxLength value=""2""/></xs:restriction></xs:simpleType>"
	+ "<xs:simpleType name=""Dt""><xs:restriction base=""xs:date"">"
	+ "<xs:minInclusive value=""2020-01-01""/><xs:maxExclusive value=""2030-01-01""/>"
	+ "</xs:restriction></xs:simpleType>"
	+ "<xs:complexType name=""T""><xs:sequence>"
	+ "<xs:element name=""el"" type=""t:Len"" minOccurs=""0""/>"
	+ "<xs:element name=""ml"" type=""t:Len"" minOccurs=""0"" maxOccurs=""unbounded""/>"
	+ "<xs:element name=""rg"" type=""t:Rng"" minOccurs=""0""/>"
	+ "<xs:element name=""dg"" type=""t:Dig"" minOccurs=""0""/>"
	+ "<xs:element name=""ip"" type=""xs:int"" minOccurs=""0""/>"
	+ "<xs:element name=""pt"" type=""t:Pat"" minOccurs=""0""/>"
	+ "<xs:element name=""ls"" type=""t:Lst"" minOccurs=""0""/>"
	+ "<xs:element name=""un"" type=""t:Uni"" minOccurs=""0""/>"
	+ "<xs:element name=""nb"" type=""t:Nest"" minOccurs=""0""/>"
	+ "</xs:sequence>"
	+ "<xs:attribute name=""ac"" type=""t:Col""/>"
	+ "</xs:complexType>"
	+ "<xs:complexType name=""Nest""><xs:sequence>"
	+ "<xs:element name=""nl"" type=""t:Len""/>"
	+ "</xs:sequence></xs:complexType>"
	+ "</xs:schema>";

ПутьСхемы = "/tmp/open-bsl-measure-xdto-validation.xsd";
Попытка
	Зпс = Новый ЗаписьТекста(ПутьСхемы);
	Зпс.Записать(ТекстСхемы);
	Зпс.Закрыть();
Исключение
КонецПопытки;

// Вторая схема — про УМОЛЧАНИЕ, нарушающее фасет: строится ли вообще
