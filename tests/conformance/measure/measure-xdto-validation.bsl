// --- Проверить у экземпляра -----------------------------------------------
//
// Проверяет ли `Проверить()` фасеты сверх границ вхождения. Значение,
// нарушающее фасет, сначала нужно как-то ВНЕСТИ в объект: если ни запись,
// ни чтение его не пускают, то проверять `Проверить()` не на чем — и это
// само по себе измеренный факт.

П("пр пустой объект", Сбор("НовыйОбъект(); ОбП.Проверить(); Соб = ""ок"";"));
П("пр заполненный", Сбор("НовыйОбъект(); ОбП.el = ""аб""; ОбП.Проверить(); Соб = ""ок"";"));
П("пр после чтения чужого", Сбор("НовыйЧитатель(""<т xmlns=""""urn:v"""" ac=""""синий""""/>""); Х = Фаб.ПрочитатьXML(Чтр, ТипТ); Соб = ""прочитано""; Попытка Х.Проверить(); Соб = Соб + "" проверка ок""; Исключение Соб = Соб + "" проверка ошибка""; КонецПопытки;"));
П("пр вложенный недозаполненный", Сбор("НовыйОбъект(); ОбП.nb = Фаб.Создать(Фаб.Тип(""urn:v"", ""Nest"")); ОбП.Проверить(); Соб = ""ок"";"));

// --- сериализатор и умолчание схемы ---------------------------------------
//
// Два места, где значение появляется НЕ через фабрику: чтение
// `СериализаторXDTO` (там тип берётся по имени элемента) и значение по
// умолчанию, записанное прямо в схему. Оба — про то, где проверка есть, а
// где её нет.

П("сер валидное", Сбор("Сер = Новый СериализаторXDTO(Фаб); НовыйЧитатель(""<Len xmlns=""""urn:v"""">аб</Len>""); Соб = ""["" + Строка(Сер.ПрочитатьXML(Чтр)) + ""]"";"));
П("сер нарушающее", Сбор("Сер = Новый СериализаторXDTO(Фаб); НовыйЧитатель(""<Len xmlns=""""urn:v"""">а</Len>""); Соб = ""["" + Строка(Сер.ПрочитатьXML(Чтр)) + ""]"";"));
П("умл фабрика с плохим умолчанием", Ч("СоздатьФабрикуXDTO(ПутьСхемы2)"));
П("умл значение по умолчанию", Сбор("Фаб2 = СоздатьФабрикуXDTO(ПутьСхемы2); О3 = Фаб2.Создать(Фаб2.Тип(""urn:w"", ""T2"")); Соб = ""["" + Строка(О3.bad) + ""]"";"));

// --- фасет образца: сознательное расхождение ------------------------------
//
// Три строки ниже — те самые, где интерпретатор отвечает `<ошибка>` там,
// где платформа отвечает «ок»: образец не разбирается, а отвергается
// честной ошибкой «не поддерживается». Невалидные значения отвергают обе
// стороны.

П("обр Pat валидное", Соз("Pat", "AB"));
П("обр Pat невалидное", Соз("Pat", "аб"));
П("обр Pat в свойство", Сбор("НовыйОбъект(); ОбП.pt = ""AB""; Соб = ""["" + Строка(ОбП.pt) + ""]"";"));
П("обр Pat в свойство невалидное", Сбор("НовыйОбъект(); ОбП.pt = ""аб""; Соб = ""["" + Строка(ОбП.pt) + ""]"";"));
П("обр Pat чтение", Сбор("НовыйЧитатель(""<т xmlns=""""urn:v""""><pt>AB</pt></т>""); Х = Фаб.ПрочитатьXML(Чтр, ТипТ); Соб = ""["" + Строка(Х.pt) + ""]"";"));
П("обр Pat чтение невалидное", Сбор("НовыйЧитатель(""<т xmlns=""""urn:v""""><pt>аб</pt></т>""); Х = Фаб.ПрочитатьXML(Чтр, ТипТ); Соб = ""["" + Строка(Х.pt) + ""]"";"));

// --- открытые вопросы ------------------------------------------------------
//
// XDTO.VALIDATION.VALIDATE_FACETS: перепроверяет ли `Проверить()` фасеты
// сверх границ вхождения. Прямой пробы нет: чтобы её поставить, нужно
// сперва ВНЕСТИ в экземпляр значение, нарушающее фасет, а все измеренные
// двери закрыты — и присваивание, и `Установить`, и `Добавить` в список
// такое значение отвергают (строки `зп`/`сп` выше), и чтение документа
// тоже. Суррогат перебирает эти двери подряд и печатает ту, что открылась:
// пока ответ «закрыто», вопрос остаётся незакрываемым, а не забытым.
Р = Сбор("НовыйОбъект(); Соб = ""закрыто""; Попытка ОбП.el = ""а""; Соб = ""запись""; Исключение КонецПопытки; Попытка ОбП.Установить(""el"", ""а""); Соб = ""Установить""; Исключение КонецПопытки; Попытка ОбП.ml.Добавить(""а""); Соб = ""список""; Исключение КонецПопытки;");
П("XDTO.VALIDATION.VALIDATE_FACETS", Р);
