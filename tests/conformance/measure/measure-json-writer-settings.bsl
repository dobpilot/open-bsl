Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция HexUTF8(Текст)
	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(
		ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь));
КонецФункции

Функция БулевоСтрокой(Значение)
	Если Значение Тогда
		Возврат "true";
	КонецЕсли;
	Возврат "false";
КонецФункции

Функция ПереносСтрокой(Значение)
	Если Значение = ПереносСтрокJSON.Авто Тогда
		Возврат "auto";
	ИначеЕсли Значение = ПереносСтрокJSON.Нет Тогда
		Возврат "none";
	ИначеЕсли Значение = ПереносСтрокJSON.Windows Тогда
		Возврат "windows";
	КонецЕсли;
	Возврат "unix";
КонецФункции

Функция ЭкранированиеСтрокой(Значение)
	Если Значение = ЭкранированиеСимволовJSON.Нет Тогда
		Возврат "none";
	ИначеЕсли Значение = ЭкранированиеСимволовJSON.СимволыВнеASCII Тогда
		Возврат "non-ascii";
	КонецЕсли;
	Возврат "non-bmp";
КонецФункции

Функция ЗаписатьПробу(Параметры, Имя = "ключ", Значение = "Аб")
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Параметры);
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства(Имя);
	Запись.ЗаписатьЗначение(Значение);
	Запись.ЗаписатьКонецОбъекта();
	Возврат HexUTF8(Запись.Закрыть());
КонецФункции

