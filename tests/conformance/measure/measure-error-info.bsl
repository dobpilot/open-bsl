// Минимальный контракт информации об ошибке, нужный Connector 2.6.0.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция БулевоСтрокой(Значение)
	Если Значение Тогда
		Возврат "true";
	КонецЕсли;
	Возврат "false";
КонецФункции

Функция ОднаСтрока(Значение)
	Результат = СтрЗаменить(Значение, Символ(13), "<CR>");
	Результат = СтрЗаменить(Результат, Символ(10), "<LF>");
	Возврат СтрЗаменить(Результат, Символ(9), "<TAB>");
КонецФункции

ВнешнийТип = "<ошибка>";
ВнешнееПредставление = "<ошибка>";
Попытка
	ВнешняяОшибка = ИнформацияОбОшибке();
	ВнешнийТип = Строка(ТипЗнч(ВнешняяОшибка));
	ВнешнееПредставление = ОднаСтрока(
		ПодробноеПредставлениеОшибки(ВнешняяОшибка));
Исключение
КонецПопытки;
М("ERROR.INFO.OUTSIDE.TYPE", ВнешнийТип);
М("ERROR.INFO.OUTSIDE.DETAIL", ВнешнееПредставление);

СохраненнаяОшибка = Неопределено;
ПодробноВнутри = "";
Попытка
	ВызватьИсключение "connector-boom";
Исключение
	СохраненнаяОшибка = ИнформацияОбОшибке();
	ПодробноВнутри = ПодробноеПредставлениеОшибки(СохраненнаяОшибка);
	М("ERROR.INFO.RAISED.TYPE", БулевоСтрокой(
		ТипЗнч(СохраненнаяОшибка) = Тип("ИнформацияОбОшибке")));
	М("ERROR.INFO.RAISED.DETAIL_CONTAINS_MESSAGE", БулевоСтрокой(
		СтрНайти(ПодробноВнутри, "connector-boom") > 0));
КонецПопытки;

ПодробноПосле = ПодробноеПредставлениеОшибки(СохраненнаяОшибка);
М("ERROR.INFO.SNAPSHOT.STABLE", БулевоСтрокой(ПодробноПосле = ПодробноВнутри));

ПодробноВнутреннее = "";
Попытка
	Частное = 1 / 0;
Исключение
	ПодробноВнутреннее = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
КонецПопытки;
М("ERROR.INFO.INTERNAL.DETAIL_NONEMPTY", БулевоСтрокой(Не ПустаяСтрока(ПодробноВнутреннее)));
