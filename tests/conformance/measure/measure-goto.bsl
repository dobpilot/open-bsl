// Контракт меток `~Имя:` и оператора `Перейти`/`Goto`.
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-goto.bsl
//
// Скрипт исполняется и платформой, и open-bsl. Негодные
// фрагменты идут через `Выполнить`: ошибка их компиляции
// ловится в рантайме и не срывает весь платформенный сеанс.
// Строк `М()` здесь нет: реестру открытых вопросов этот контракт
// ничего не добавляет.

Процедура П(МеткаСтроки, Значение)
	Сообщить(МеткаСтроки + Символ(9) + Значение);
КонецПроцедуры

Функция Проба(ТекстПробы)
	Попытка
		Выполнить(ТекстПробы);
		Возврат "принято";
	Исключение
		Возврат "отказ";
	КонецПопытки;
КонецФункции

Функция МеткаВФункции()
	Goto ~0;
	Возврат 0;
~0:
	Возврат 1;
КонецФункции

// Прямой числовой и обратный именованный переходы.
СчётчикПереходов = 0;
Goto ~0;
СчётчикПереходов = -100;
~Назад:
СчётчикПереходов = СчётчикПереходов + 1;
Если СчётчикПереходов < 2 Тогда
	Goto ~Назад;
КонецЕсли;
Goto ~КонецПереходов;
~0:;
Goto ~Назад;
~КонецПереходов:
П("GOTO.БАЗОВЫЙ", Строка(СчётчикПереходов));

// Русская форма и регистронезависимое имя.
Перейти ~смешанная;
СчётчикПереходов = -100;
~СМЕШАННАЯ:
П("GOTO.РУССКИЙ.РЕГИСТР", "принято");
П("GOTO.ОБЛАСТЬ", Строка(МеткаВФункции()));

// Именные ошибки и границы имени метки.
П("GOTO.НЕИЗВЕСТНАЯ", Проба("Goto ~НетТакойМетки;"));
П("GOTO.ДУБЛЬ", Проба("~Дубль:; ~дубль:;"));
П("GOTO.МЕТКА.ДРОБЬ", Проба("~1.2:;"));
П("GOTO.МЕТКА.КЛЮЧЕВОЕ", Проба("~Если:;"));
П("GOTO.МЕТКА.В.КОНЦЕ", Проба("Goto ~Конец; ~Конец:;"));

// `Если`: внутри одной ветви, наружу, снаружи внутрь и между ветвями.
П("GOTO.ЕСЛИ.ВНУТРИ", Проба("Если Истина Тогда Goto ~М; ~М:; КонецЕсли;"));
П("GOTO.ЕСЛИ.НАРУЖУ", Проба("Если Истина Тогда Goto ~М; КонецЕсли; ~М:;"));
П("GOTO.ЕСЛИ.ВНУТРЬ", Проба("Если Ложь Тогда ~М:; Goto ~К; КонецЕсли; Goto ~М; ~К:;"));
П("GOTO.ЕСЛИ.МЕЖДУ.ВЕТВЯМИ", Проба("Если Истина Тогда Goto ~М; Иначе ~М:; КонецЕсли;"));

// Циклы: внутри, наружу и снаружи внутрь.
П("GOTO.ПОКА.ВНУТРИ", Проба("Счёт = 0; Пока Счёт < 2 Цикл ~М:; Счёт = Счёт + 1; Если Счёт < 2 Тогда Goto ~М; КонецЕсли; КонецЦикла;"));
П("GOTO.ПОКА.НАРУЖУ", Проба("Пока Истина Цикл Goto ~М; КонецЦикла; ~М:;"));
П("GOTO.ПОКА.ВНУТРЬ", Проба("Пока Ложь Цикл ~М:; Goto ~К; КонецЦикла; Goto ~М; ~К:;"));
П("GOTO.ДЛЯ.ВНУТРИ", Проба("Для Счёт = 1 По 1 Цикл Goto ~М; ~М:; КонецЦикла;"));
П("GOTO.ДЛЯ.НАРУЖУ", Проба("Для Счёт = 1 По 1 Цикл Goto ~М; КонецЦикла; ~М:;"));
П("GOTO.ДЛЯ.ВНУТРЬ", Проба("Для Счёт = 1 По 0 Цикл ~М:; Goto ~К; КонецЦикла; Goto ~М; ~К:;"));

// `Попытка`: тело и обработчик исключения имеют разные границы.
П("GOTO.ПОПЫТКА.ТЕЛО.ВНУТРИ", Проба("Попытка Goto ~М; ~М:; Исключение КонецПопытки;"));
П("GOTO.ПОПЫТКА.ТЕЛО.НАРУЖУ", Проба("Попытка Goto ~М; Исключение КонецПопытки; ~М:;"));
П("GOTO.ПОПЫТКА.ТЕЛО.ВНУТРЬ", Проба("Попытка ~М:; Goto ~К; Исключение КонецПопытки; Goto ~М; ~К:;"));
П("GOTO.ПОПЫТКА.ИСКЛЮЧЕНИЕ.ВНУТРИ", Проба("Попытка ВызватьИсключение ""проба""; Исключение Goto ~М; ~М:; КонецПопытки;"));
П("GOTO.ПОПЫТКА.ИСКЛЮЧЕНИЕ.НАРУЖУ", Проба("Попытка ВызватьИсключение ""проба""; Исключение Goto ~М; КонецПопытки; ~М:;"));
П("GOTO.ПОПЫТКА.ИСКЛЮЧЕНИЕ.ВНУТРЬ", Проба("Попытка ВызватьИсключение ""проба""; Исключение ~М:; Goto ~К; КонецПопытки; Goto ~М; ~К:;"));
П("GOTO.ПОПЫТКА.МЕЖДУ", Проба("Попытка Goto ~М; Исключение ~М:; КонецПопытки;"));
