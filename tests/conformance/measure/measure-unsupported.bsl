// Замеры, которые НАШ интерпретатор исполнить не может — их надо
// прогонять на платформе ОТДЕЛЬНО от measure-all.bsl:
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-unsupported.bsl
//
// Формат тот же: `ИД<таб>ЗНАЧЕНИЕ`. Здесь нужны `ДвоичныеДанные` и
// `ПолучитьHexСтрокуИзДвоичныхДанных`: вопрос — какие БАЙТЫ ложатся на
// диск, а прочитать их обратно нам нечем. Прочесть вывод глазами всё
// равно приходится: `--ingest-measurements` сверяет только то, что мы
// умеем посчитать сами.
//
// Значения, снятые 29.07.2026 на 8.3.27, лежат якорями в
// bsl_rt::open_questions — там же и разбор, что каждое из них означает.

Процедура М(Ид, Путь)
	Попытка
		ДД = Новый ДвоичныеДанные(Путь);
		Сообщить(Ид + Символ(9) + ПолучитьHexСтрокуИзДвоичныхДанных(ДД));
	Исключение
		Сообщить(Ид + Символ(9) + "<ошибка: " + ОписаниеОшибки() + ">");
	КонецПопытки;
КонецПроцедуры

К = КаталогВременныхФайлов();

// Перевод строки внутри записываемой строки + метка порядка байтов.
П = К + "w-lf.txt";
З = Новый ЗаписьТекста(П);
З.Записать("A" + Символ(10) + "B");
З.Закрыть();
М("FILE.WRITER.BOM_AND_CRLF", П);

// Одиночный CR: разделителем строк ВХОДНОГО текста он не считается.
П = К + "w-cr.txt";
З = Новый ЗаписьТекста(П);
З.Записать("A" + Символ(13) + "B");
З.Закрыть();
М("FILE.WRITER.CR_IN", П);

// Явный CRLF: CR проходит как есть, LF разворачивается — итого три байта.
П = К + "w-crlf.txt";
З = Новый ЗаписьТекста(П);
З.Записать("A" + Символ(13) + Символ(10) + "B");
З.Закрыть();
М("FILE.WRITER.CRLF_IN", П);

// Кодировка по умолчанию — на кириллице видно сразу.
П = К + "w-cyr.txt";
З = Новый ЗаписьТекста(П);
З.Записать("Ая");
З.Закрыть();
М("FILE.WRITER.CYRILLIC", П);
