// --- обратное направление -------------------------------------------------

// `XMLТип(Тип)` отдаёт `ТипДанныхXML`, у которого читаются `ИмяТипа` и
// `URIПространстваИмен` — это обратная сторона таблицы выше.
Функция Обр(ИмяТипаBSL)
	Попытка
		Р = Вычислить("XMLТип(Тип(""" + ИмяТипаBSL + """))");
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Попытка
		Возврат "{" + Р.URIПространстваИмен + "}" + Р.ИмяТипа;
	Исключение
		Возврат Строка(ТипЗнч(Р)) + " <без имени>";
	КонецПопытки;
КонецФункции

П("обр Строка", Обр("Строка"));
