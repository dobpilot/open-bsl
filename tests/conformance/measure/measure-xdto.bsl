П("объект чтение notype", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); Соб = ""["" + Строка(О2.notype) + ""] тип="" + Строка(ТипЗнч(О2.notype));"));
П("объект чтение anon", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); Соб = ""["" + Строка(О2.anon) + ""] тип="" + Строка(ТипЗнч(О2.anon));"));
П("объект чтение code", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); Соб = ""["" + Строка(О2.code) + ""] тип="" + Строка(ТипЗнч(О2.code));"));
П("объект чтение many5", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); Соб = ""["" + Строка(О2.many5) + ""] тип="" + Строка(ТипЗнч(О2.many5));"));
