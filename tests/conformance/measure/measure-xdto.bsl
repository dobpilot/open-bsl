// --- САМА ФАБРИКА: конструирование, арности, члены -------------------------
// Выше фабрика была ИНСТРУМЕНТОМ: типы доставались через неё, а мерялись
// они. Здесь мерится она сама. Часть уже снята выше и не повторяется:
// `СоздатьФабрикуXDTO` работает ТОЛЬКО от пути к файлу XSD (от схемы, от
// набора, от текста схемы и без аргументов — ошибка), `Новый ФабрикаXDTO`
// без аргументов даёт фабрику со встроенными типами, две фабрики от одного
// файла НЕ равны, а `Строка()`/`ТипЗнч()` фабрики — `ФабрикаXDTO` и
// `Фабрика XDTO`.

// ТЕКСТ ошибки здесь не снимается, и это не забывчивость. Пробы вида
// «`ОписаниеОшибки()` после негодного источника» тут не место по тому же
// правилу, что и в `measure-json.bsl`: скрипту положено компилироваться и
// этим интерпретатором, а `ОписаниеОшибки` он не знает и отвергает имя при
// КОМПИЛЯЦИИ — файл целиком выпал бы и из корпуса бандлов. Обойти это
// через `Вычислить("ОписаниеОшибки()")` не выходит: платформа в этом
// случае отдаёт ПУСТУЮ строку (проверено отдельным прогоном), так что
// вычислять было бы нечего. Отказ печатается стабильным `<ошибка>`.

// Второй конструктор: `Новый ФабрикаXDTO(...)`. Если он принимает набор
// схем или схему, фабрику можно построить БЕЗ файла на диске, и тогда
// проверочная фикстура остаётся самодостаточной на обеих сторонах.
П("новый ФабрикаXDTO от набора", Ч("Новый ФабрикаXDTO(Наб)"));
П("новый ФабрикаXDTO от схемы", Ч("Новый ФабрикаXDTO(Сх)"));
П("новый ФабрикаXDTO от пути", Ч("Новый ФабрикаXDTO(ПутьXSD)"));
П("новый ФабрикаXDTO от текста схемы", Ч("Новый ФабрикаXDTO(ИсточникXSD)"));
П("новый XDTOFactory", Ч("Новый XDTOFactory"));
П("новый ФабрикаXDTO двумя", Ч("Новый ФабрикаXDTO(Наб, Наб)"));
П("новый ФабрикаXDTO массивом", Ч("Новый ФабрикаXDTO(Новый Массив)"));
П("новый ФабрикаXDTO от набора свой тип", Сбор("Ф2 = Новый ФабрикаXDTO(Наб); Соб = Строка(ТипЗнч(Ф2.Тип(""urn:test"", ""RootType""))) + "" ["" + Строка(Ф2.Тип(""urn:test"", ""RootType"")) + ""]"";"));
П("новый ФабрикаXDTO от схемы свой тип", Сбор("Ф2 = Новый ФабрикаXDTO(Сх); Соб = Строка(ТипЗнч(Ф2.Тип(""urn:test"", ""RootType""))) + "" ["" + Строка(Ф2.Тип(""urn:test"", ""RootType"")) + ""]"";"));
П("новый ФабрикаXDTO от набора встроенный", Сбор("Ф2 = Новый ФабрикаXDTO(Наб); Соб = Строка(Ф2.Тип(НСXSD, ""string""));"));
