П("объект чтение унаследованного", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""ExtType"")); Соб = ""["" + Строка(О2.def) + ""] своё=["" + Строка(О2.extra) + ""]"";"));
