// Пятый заход, две мелочи, которые иначе пришлось бы додумывать: куда
// встаёт ПОВТОРНАЯ запись одиночного свойства (на прежнее место в
// последовательности или в конец) и куда встаёт `Вставить` списка.
П("последовательность повторная запись порядок", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""ChoiceType"")); О2.ca = ""вг""; О2.cb.Добавить(""аб""); О2.ca = ""де""; Пс = О2.Последовательность(); Для К8 = 0 По Пс.Количество() - 1 Цикл Соб = Соб + ""["" + Строка(Пс.ПолучитьСвойство(К8)) + ""="" + Строка(Пс.ПолучитьЗначение(К8)) + ""]""; КонецЦикла;"));
П("последовательность Вставить порядок", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""ChoiceType"")); О2.cb.Добавить(""аб""); О2.ca = ""вг""; О2.cb.Вставить(0, ""де""); Пс = О2.Последовательность(); Для К8 = 0 По Пс.Количество() - 1 Цикл Соб = Соб + ""["" + Строка(Пс.ПолучитьСвойство(К8)) + ""="" + Строка(Пс.ПолучитьЗначение(К8)) + ""]""; КонецЦикла;"));
П("последовательность Добавить с приведением", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""ChoiceType"")); О2.Последовательность().Добавить(О2.Тип().Свойства.Получить(""ca""), 5); Соб = ""["" + Строка(О2.ca) + ""] тип="" + Строка(ТипЗнч(О2.ca));"));
П("объект Сбросить и запись заново", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""ChoiceType"")); О2.ca = ""вг""; О2.cb.Добавить(""аб""); О2.Сбросить(""ca""); О2.ca = ""де""; Пс = О2.Последовательность(); Для К8 = 0 По Пс.Количество() - 1 Цикл Соб = Соб + ""["" + Строка(Пс.ПолучитьСвойство(К8)) + ""="" + Строка(Пс.ПолучитьЗначение(К8)) + ""]""; КонецЦикла;"));

// Шестой заход: АНГЛИЙСКИЕ написания членов экземпляра. Русские сняты
// выше, а по-английски пока измерены только `Get`, `Set`, `IsSet`,
// `Unset`, `GetList`, `Validate`, `Properties`, `Owner` и `Type`.
// Придумывать остальные нельзя: таблица имён в рантайме — одна на оба
// написания, и лишнее имя в ней означает программу, которая здесь
// работает, а на платформе нет.
П("список Get", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); О2.code.Добавить(""AB""); Соб = ""["" + Строка(О2.code.Get(0)) + ""]"";"));
П("список Set", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); О2.code.Добавить(""AB""); О2.code.Set(0, ""CD""); Соб = ""["" + Строка(О2.code[0]) + ""]"";"));
П("список Insert", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); О2.code.Insert(0, ""AB""); Соб = Строка(О2.code.Количество());"));
П("список Delete", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); О2.code.Добавить(""AB""); О2.code.Delete(0); Соб = Строка(О2.code.Количество());"));
П("список Remove", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); О2.code.Добавить(""AB""); О2.code.Remove(0); Соб = Строка(О2.code.Количество());"));
П("список Clear", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); О2.code.Добавить(""AB""); О2.code.Clear(); Соб = Строка(О2.code.Количество());"));
П("объект Sequence", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""ChoiceType"")); Соб = Строка(ТипЗнч(О2.Sequence()));"));
П("последовательность Count", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""ChoiceType"")); Соб = Строка(О2.Последовательность().Count());"));
П("последовательность Add", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""ChoiceType"")); О2.Последовательность().Add(О2.Тип().Свойства.Получить(""ca""), ""аб""); Соб = Строка(О2.Последовательность().Количество());"));
П("последовательность Clear", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""ChoiceType"")); О2.ca = ""аб""; О2.Последовательность().Clear(); Соб = Строка(О2.Последовательность().Количество());"));
П("последовательность GetValue", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""ChoiceType"")); О2.ca = ""аб""; Соб = ""["" + Строка(О2.Последовательность().GetValue(0)) + ""]"";"));
П("последовательность GetProperty", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""ChoiceType"")); О2.ca = ""аб""; Соб = Строка(О2.Последовательность().GetProperty(0));"));
П("последовательность Owner", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""ChoiceType"")); Соб = Строка(ТипЗнч(О2.Последовательность().Owner));"));
П("объект Тип свойством ещё раз", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); Соб = Строка(О2.Тип);"));

// Седьмой заход: типы свойств, у которых отображения в один тип BSL нет —
// ОБЪЕДИНЕНИЕ (`hu` типа `t:Either2`), СПИСОК (`hl` типа `t:Codes`) и
// `anyType` (`notype`). Что запись делает с ними, из прежних проб не
// видно: у всех измеренных свойств тип разрешался в один тип BSL.
// Заодно — смотрит ли `Проверить` внутрь ЭЛЕМЕНТОВ СПИСКА, а не только
// внутрь одиночного вложенного объекта.
П("объект запись в объединение строкой", Сбор("Х7 = Фаб.Создать(Фаб.Тип(""urn:test"", ""HolderType"")); Х7.hu = ""5""; Соб = ""["" + Строка(Х7.hu) + ""] тип="" + Строка(ТипЗнч(Х7.hu));"));
П("объект запись в объединение числом", Сбор("Х7 = Фаб.Создать(Фаб.Тип(""urn:test"", ""HolderType"")); Х7.hu = 5; Соб = ""["" + Строка(Х7.hu) + ""] тип="" + Строка(ТипЗнч(Х7.hu));"));
П("объект запись в объединение буквами", Сбор("Х7 = Фаб.Создать(Фаб.Тип(""urn:test"", ""HolderType"")); Х7.hu = ""аб""; Соб = ""["" + Строка(Х7.hu) + ""] тип="" + Строка(ТипЗнч(Х7.hu));"));
П("объект чтение объединения", Сбор("Х7 = Фаб.Создать(Фаб.Тип(""urn:test"", ""HolderType"")); Соб = ""["" + Строка(Х7.hu) + ""] тип="" + Строка(ТипЗнч(Х7.hu));"));
П("объект запись в список строкой", Сбор("Х7 = Фаб.Создать(Фаб.Тип(""urn:test"", ""HolderType"")); Х7.hl = ""AB CD""; Соб = ""["" + Строка(Х7.hl) + ""] тип="" + Строка(ТипЗнч(Х7.hl));"));
П("объект запись в список числом", Сбор("Х7 = Фаб.Создать(Фаб.Тип(""urn:test"", ""HolderType"")); Х7.hl = 5; Соб = ""["" + Строка(Х7.hl) + ""]"";"));
П("объект запись в anyType строкой", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); О2.notype = ""аб""; Соб = ""["" + Строка(О2.notype) + ""] тип="" + Строка(ТипЗнч(О2.notype));"));
П("объект запись в anyType числом", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); О2.notype = 5; Соб = ""["" + Строка(О2.notype) + ""] тип="" + Строка(ТипЗнч(О2.notype));"));
П("объект запись в anyType объектом", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); О2.notype = Фаб.Создать(Фаб.Тип(""urn:test"", ""EmptyType"")); Соб = Строка(ТипЗнч(О2.notype));"));
П("объект Проверить элемента списка", Сбор("Х7 = Фаб.Создать(Фаб.Тип(""urn:test"", ""HolderType"")); Р7 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); Р7.name = ""аб""; Р7.id = 1; Р7.uq = ""вг""; Р7.many5.Добавить(""я""); А7 = Фаб.Создать(Р7.Тип().Свойства.Получить(""anon"").Тип); А7.inner = 1; Р7.anon = А7; Х7.hr = Р7; Х7.hm.Добавить(Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType""))); Х7.Проверить(); Соб = ""ок"";"));
П("объект Проверить только hr", Сбор("Х7 = Фаб.Создать(Фаб.Тип(""urn:test"", ""HolderType"")); Р7 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); Р7.name = ""аб""; Р7.id = 1; Р7.uq = ""вг""; Р7.many5.Добавить(""я""); А7 = Фаб.Создать(Р7.Тип().Свойства.Получить(""anon"").Тип); А7.inner = 1; Р7.anon = А7; Х7.hr = Р7; Х7.Проверить(); Соб = ""ок"";"));

// Восьмой заход, три угла, которые иначе пришлось бы додумывать: куда
// `Вставить` в ПУСТОЙ список и на позицию «сразу за концом», и что читает
// свойство с `fixed` после `Сбросить`.
П("список Вставить в пустой", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); О2.code.Вставить(0, ""AB""); Соб = Строка(О2.code.Количество()) + "" ["" + Строка(О2.code[0]) + ""]"";"));
П("список Вставить за концом", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); О2.many5.Добавить(""я""); О2.many5.Вставить(1, ""ю""); Соб = Строка(О2.many5.Количество()) + "" ["" + Строка(О2.many5[1]) + ""]"";"));
П("объект Сбросить фиксированного", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); О2.fx = 1; О2.Сбросить(""fx""); Соб = ""["" + Строка(О2.fx) + ""]"";"));
