П("объект anon тождество", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); А5 = Фаб.Создать(О2.Тип().Свойства.Получить(""anon"").Тип); О2.anon = А5; Соб = Строка(О2.anon = А5);"));
