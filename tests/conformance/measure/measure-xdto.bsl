// Четвёртый заход. Свойство ОБЪЕКТНОГО типа в схеме до сих пор было
// только анонимным (`anon`), а значит неизвестно, принимает ли запись
// НАСЛЕДНИКА объявленного типа и получает ли владельца объект, попавший в
// список. Ради этого в схему добавлен `HolderType` с `hr` (одиночное
// свойство типа `t:RootType`) и `hm` (множественное того же типа) — на
// уже снятые строки это не влияет: сплющенные списки свойств прежних
// типов от появления нового типа не меняются.

П("объект запись наследника", Сбор("Х6 = Фаб.Создать(Фаб.Тип(""urn:test"", ""HolderType"")); Х6.hr = Фаб.Создать(Фаб.Тип(""urn:test"", ""ExtType"")); Соб = Строка(Х6.hr.Тип());"));
П("объект запись точного типа", Сбор("Х6 = Фаб.Создать(Фаб.Тип(""urn:test"", ""HolderType"")); Х6.hr = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); Соб = Строка(Х6.hr.Тип());"));
П("объект запись постороннего типа", Сбор("Х6 = Фаб.Создать(Фаб.Тип(""urn:test"", ""HolderType"")); Х6.hr = Фаб.Создать(Фаб.Тип(""urn:test"", ""EmptyType"")); Соб = Строка(Х6.hr.Тип());"));
П("объект запись объекта в строку", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); О2.name = Фаб.Создать(Фаб.Тип(""urn:test"", ""EmptyType"")); Соб = ""["" + Строка(О2.name) + ""]"";"));
П("объект запись значения чужого типа", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); О2.id = Фаб.Создать(Фаб.Тип(НСXSD, ""string""), ""5""); Соб = ""["" + Строка(О2.id) + ""] тип="" + Строка(ТипЗнч(О2.id));"));
П("список объектов Добавить", Сбор("Х6 = Фаб.Создать(Фаб.Тип(""urn:test"", ""HolderType"")); Х6.hm.Добавить(Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType""))); Соб = Строка(Х6.hm.Количество()) + "" тип="" + Строка(ТипЗнч(Х6.hm[0]));"));
П("список объектов владелец", Сбор("Х6 = Фаб.Создать(Фаб.Тип(""urn:test"", ""HolderType"")); Х6.hm.Добавить(Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType""))); Соб = Строка(Х6.hm[0].Владелец() = Х6);"));
П("список объектов посторонним типом", Сбор("Х6 = Фаб.Создать(Фаб.Тип(""urn:test"", ""HolderType"")); Х6.hm.Добавить(Фаб.Создать(Фаб.Тип(""urn:test"", ""EmptyType""))); Соб = Строка(Х6.hm.Количество());"));
П("объект владелец после записи в свойство", Сбор("Х6 = Фаб.Создать(Фаб.Тип(""urn:test"", ""HolderType"")); Р6 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); Х6.hr = Р6; Соб = Строка(Р6.Владелец() = Х6);"));

П("последовательность Добавить отражение", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""ChoiceType"")); О2.Последовательность().Добавить(О2.Тип().Свойства.Получить(""ca""), ""аб""); Соб = ""["" + Строка(О2.ca) + ""]"";"));
П("последовательность Добавить дважды", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""ChoiceType"")); О2.Последовательность().Добавить(О2.Тип().Свойства.Получить(""ca""), ""аб""); О2.Последовательность().Добавить(О2.Тип().Свойства.Получить(""ca""), ""вг""); Соб = Строка(О2.Последовательность().Количество()) + "" ca=["" + Строка(О2.ca) + ""]"";"));
П("последовательность Добавить множественного", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""ChoiceType"")); О2.Последовательность().Добавить(О2.Тип().Свойства.Получить(""cb""), ""аб""); Соб = Строка(О2.cb.Количество());"));
П("последовательность Добавить атрибута", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""ChoiceType"")); О2.Последовательность().Добавить(О2.Тип().Свойства.Получить(""cat""), ""аб""); Соб = Строка(О2.Последовательность().Количество()) + "" cat=["" + Строка(О2.cat) + ""]"";"));
