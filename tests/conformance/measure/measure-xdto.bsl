П("объект запись даты в строку", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); О2.name = Дата(2026, 8, 13); Соб = ""["" + Строка(О2.name) + ""] тип="" + Строка(ТипЗнч(О2.name));"));
