П("объект чтение efx", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); Соб = ""["" + Строка(О2.efx) + ""] тип="" + Строка(ТипЗнч(О2.efx));"));
