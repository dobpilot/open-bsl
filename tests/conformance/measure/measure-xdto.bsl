П("список Владелец методом", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); Соб = Строка(ТипЗнч(О2.code.Владелец()));"));
П("список Owner", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); Соб = Строка(ТипЗнч(О2.code.Owner));"));
П("список Свойство методом", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); Соб = Строка(ТипЗнч(О2.code.Свойство()));"));
