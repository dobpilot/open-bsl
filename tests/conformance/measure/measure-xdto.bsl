П("значение запись Значение", Сбор("З5 = Фаб.Создать(Фаб.Тип(НСXSD, ""int""), ""42""); З5.Значение = 5; Соб = ""["" + Строка(З5.Значение) + ""] лекс=["" + Строка(З5.ЛексическоеЗначение) + ""]"";"));
