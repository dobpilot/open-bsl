// АРНОСТЬ этих четырёх членов: терпит ли платформа лишний аргумент. Все
// четыре идут через `Сбор`, то есть через `Выполнить` внутри `Попытка`:
// наш резолвер отвергает лишний аргумент НА КОМПИЛЯЦИИ, и прямой вызов
// снёс бы на нашей стороне весь файл, а не одну строку. У `Проверить`
// получатель — `EmptyType`: `RootType` недозаполнен и отвергается сам по
// себе, на такой пробе арность была бы не видна.
П("объект Проверить с аргументом", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""EmptyType"")); О2.Проверить(1); Соб = ""ок"";"));
П("объект Свойства с аргументом", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); Соб = Строка(ТипЗнч(О2.Свойства(1)));"));
П("объект Владелец с аргументом", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); Соб = Строка(ТипЗнч(О2.Владелец(1)));"));
П("объект Последовательность с аргументом", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""ChoiceType"")); Соб = Строка(ТипЗнч(О2.Последовательность(1)));"));

