// Контракт МОДЕЛИ ТИПОВ XDTO на 8.3.27: `ТипЗначенияXDTO`,
// `ТипОбъектаXDTO`, `СвойствоXDTO` и соответствие встроенных типов XML
// Schema типам BSL.
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-xdto.bsl
//
// Правила те же, что у `measure-xsd.bsl`: строка `МЕТКА<таб>ЗНАЧЕНИЕ`, всё
// рискованное — через `Вычислить`/`Выполнить` внутри `Попытка`, приёмники
// проб — переменные МОДУЛЯ, одна проба на строку. Строк `М()` здесь нет:
// реестру открытых вопросов этот файл ничего не должен, `.expected` у него
// нет и быть не должно.
//
// ПОСТРОЧНОГО ПАРИТЕТА С ЭТИМ ИНТЕРПРЕТАТОРОМ ЗДЕСЬ ПОКА НЕТ. Конструкторы
// фабрики (`Новый ФабрикаXDTO`, `СоздатьФабрикуXDTO`) в нём уже есть, но
// экземплярная семантика домерена не вся — чтение свойств `ОбъектXDTO` и
// прочее, — поэтому часть строк, идущих через фабрику, всё ещё даёт
// перехваченную ошибку (`<ошибка>`, `<нет типа>`), тогда как платформа
// отдаёт значение. Это осознанное состояние, а не недосмотр: модель типов
// — этот файл, фабрика — задача (xdto-factory), построчное сличение —
// задача (xdto-measure). До тех пор снимок односторонний: он говорит, ЧТО
// именно должно получиться, когда экземпляры будут доделаны.
//
// ИМЯ `Ф` ЗАНЯТО ОБВЯЗКОЙ ЗАМЕРОВ. Генератор модуля формы
// (`1c/gen-form-module.py`) пишет вывод процедурой `СообщитьВФайл`, а та
// держит `ЗаписьТекста` в переменной `Ф`. Объявленная здесь `Перем Ф`
// делает эту переменную МОДУЛЬНОЙ, и тогда каждая напечатанная строка
// затирает её: первый прогон этого файла показал `фабрика тип` =
// `ЗаписьТекста`, а все пробы через фабрику — `<ошибка>`. Отсюда `Фаб`.
//
// ПРОБА, КОТОРУЮ СЮДА ВОЗВРАЩАТЬ НЕЛЬЗЯ: `ЗначениеЗаполнено` от
// `ЗначениеXDTO` ВЕШАЕТ платформу. Прогон с ней вернулся по таймауту 180 с
// с пустым выводом (то есть модальным окном), хотя проба стояла внутри
// `Вычислить` в `Попытка`. Остальные шесть проб той же группы позже прошли
// поодиночке и остались ниже: тип, свойство и фасет отвечают ошибкой, обе
// коллекции — «Да»/«Нет» по длине.
//
// ВТОРАЯ ПРОБА, КОТОРУЮ СЮДА ВОЗВРАЩАТЬ НЕЛЬЗЯ:
// `О.Последовательность().Удалить(0)` РОНЯЕТ платформу. 8.3.27 умирает по
// сигналу сегментации — это смерть процесса, а не исключение, так что
// обвязка этого файла бессильна: `Вычислить`/`Выполнить` внутри `Попытка`
// от сегфолта НЕ спасает. Диагностика раннера при этом уводит не туда — он
// печатает «не уложился в 180 с» и пустой файл результата, хотя прогон
// умер за шесть секунд, и выглядит это как обычный модальный тупик.
// Найдено бисекцией по этому файлу; проба удалена навсегда, поэтому
// `Удалить` у `ПоследовательностьXDTO` остаётся неизмеренным — и в
// реализации его тоже нет.
//
// ИЗМЕРЕНО 12.08.2026 на 8.3.27.2130.

Перем Док;
Перем Сх;
Перем Наб;
Перем Фаб;
Перем ТипЗн;
Перем ТипОб;
Перем Свв;
Перем Знч;
Перем БслТип;
Перем НСXSD;
Перем ИмяВх;
Перем ЛексВх;
Перем Соб;
Перем ИсточникXSD;
Перем ПутьXSD;

Процедура П(Метка, Значение)
	Сообщить(Метка + Символ(9) + Значение);
КонецПроцедуры

Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Р = СтрЗаменить(Р, Символ(10), "<ПС>");
	Р = СтрЗаменить(Р, Символ(9), "<Т>");
	Возврат Р;
КонецФункции

// Проба ВЫРАЖЕНИЯ: тип результата и его строковое представление.
Функция Ч(Выражение)
	Попытка
		Р = Вычислить(Выражение);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Попытка
		Возврат Строка(ТипЗнч(Р)) + " [" + Видимо(Строка(Р)) + "]";
	Исключение
		Возврат Строка(ТипЗнч(Р)) + " <не печатается>";
	КонецПопытки;
КонецФункции

// Проба ОПЕРАТОРА: важен сам факт, что фрагмент принят.
Функция Оп(Код)
	Попытка
		Выполнить(Код);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат "ок";
КонецФункции

// Сбор в модульную переменную `Соб`.
Функция Сбор(Код)
	Попытка
		Соб = "";
		Выполнить(Код);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат Видимо(Соб);
КонецФункции

// Есть ли такое имя типа вообще.
Функция ЕстьТип(Имя)
	Попытка
		Р = Вычислить("Тип(""" + Имя + """)");
	Исключение
		Возврат "<нет>";
	КонецПопытки;
	Возврат Строка(Р);
КонецФункции

// Одна строка таблицы встроенных типов XML Schema: тип XDTO из фабрики,
// ТИП BSL, в который платформа отображает это имя, значение из лексической
// формы и обратное представление. Каждый шаг под своей `Попытка` —
// сорвавшийся шаг забирает свою часть строки, а не всю таблицу.
//
// Значение берётся РОДНЫМ путём XDTO — `ФабрикаXDTO.Создать(Тип,
// Лексика)`, — но сам по себе он отдаёт непрозрачное `ЗначениеXDTO`, из
// которого тип BSL не виден: значение лежит в `Значение`, а обратная
// лексическая форма — в `ЛексическоеЗначение` (измерено на `xs:int` «42»).
// Третьим столбцом идёт `ИзXMLТипа(Имя, URI)` — та же таблица, снятая
// глобальной функцией, независимо от фабрики.
Функция Вст(Имя, Лексика)
	ИмяВх = Имя;
	ЛексВх = Лексика;
	Попытка
		ТипЗн = Вычислить("Фаб.Тип(НСXSD, ИмяВх)");
		Соб = "xdto=" + Строка(ТипЗнч(ТипЗн));
	Исключение
		Соб = "xdto=<ошибка>";
	КонецПопытки;
	Попытка
		БслТип = Вычислить("ИзXMLТипа(ИмяВх, НСXSD)");
		Соб = Соб + " бсл=[" + Строка(БслТип) + "]";
	Исключение
		Соб = Соб + " бсл=<ошибка>";
	КонецПопытки;
	Попытка
		Знч = Вычислить("Фаб.Создать(ТипЗн, ЛексВх)");
	Исключение
		Возврат Соб + " знач=<не создаётся>";
	КонецПопытки;
	Попытка
		Соб = Соб + " знач=" + Строка(ТипЗнч(Вычислить("Знч.Значение")))
			+ " [" + Видимо(Строка(Вычислить("Знч.Значение"))) + "]";
	Исключение
		Соб = Соб + " знач=<нет Значение>";
	КонецПопытки;
	Попытка
		Соб = Соб + " лекс=[" + Видимо(Строка(Вычислить("Знч.ЛексическоеЗначение"))) + "]";
	Исключение
		Соб = Соб + " лекс=<ошибка>";
	КонецПопытки;
	Возврат Соб;
КонецФункции

// Базовый тип и фасеты встроенного типа XML Schema. `Фасеты` у типа без
// фасетов — `Неопределено`, а не пустая коллекция (измерено на `xs:date`),
// поэтому проверка на `Неопределено` идёт до перебора.
Функция ФасетыВст(Имя)
	ИмяВх = Имя;
	Попытка
		Соб = "база=[" + Вычислить("Строка(Фаб.Тип(НСXSD, ИмяВх).БазовыйТип)") + "]";
	Исключение
		Возврат "<нет типа>";
	КонецПопытки;
	Попытка
		Знч = Вычислить("Фаб.Тип(НСXSD, ИмяВх).Фасеты");
	Исключение
		Возврат Соб + " фасеты=<ошибка>";
	КонецПопытки;
	Если Знч = Неопределено Тогда
		Возврат Соб + " фасеты=<нет>";
	КонецЕсли;
	Попытка
		Р = "";
		Выполнить("Для Каждого Фс Из Знч Цикл Соб = Соб + "" "" + Строка(Фс.Вид) + ""=["" + Строка(Фс.Значение) + ""]""; КонецЦикла;");
	Исключение
		Возврат Соб + " <обрыв перебора>";
	КонецПопытки;
	Возврат Соб;
КонецФункции

