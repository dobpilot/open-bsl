П("последовательность Свойство номером", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""ChoiceType"")); О2.ca = ""аб""; Соб = Строка(ТипЗнч(О2.Последовательность().Свойство(0)));"));
