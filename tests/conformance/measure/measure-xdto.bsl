П("значение Владелец", Сбор("З5 = Фаб.Создать(Фаб.Тип(НСXSD, ""int""), ""42""); Соб = Строка(ТипЗнч(З5.Владелец));"));

// Догоняющие пробы экземпляра. Первый заход оставил четыре развилки:
// `Добавить(5)` в `code` мог упасть и по типу, и по фасету (`t:Code` —
// это `[A-Z]+` длиной 2..5), `Проверить()` мог не существовать вовсе, а
// мог и честно отвергнуть недозаполненный объект, `Владелец` у списка
// оказался ЧЛЕНОМ, а у объекта — МЕТОДОМ, и неизвестно, связывает ли
// запись вложенный объект с владельцем. Плюс состав членов
// `ПоследовательностьXDTO`, до которой первый заход только добрался.

П("список many5 Добавить числом", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); О2.many5.Добавить(5); Соб = ""["" + Строка(О2.many5[0]) + ""] тип="" + Строка(ТипЗнч(О2.many5[0]));"));
П("список many5 Добавить датой", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); О2.many5.Добавить(Дата(2026, 8, 13)); Соб = ""["" + Строка(О2.many5[0]) + ""] тип="" + Строка(ТипЗнч(О2.many5[0]));"));
П("список many5 Добавить булевым", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); О2.many5.Добавить(Истина); Соб = ""["" + Строка(О2.many5[0]) + ""] тип="" + Строка(ТипЗнч(О2.many5[0]));"));
П("список many5 Добавить Неопределено", Сбор("О2 = Фаб.Создать(Фаб.Тип(""urn:test"", ""RootType"")); О2.many5.Добавить(Неопределено); Соб = Строка(О2.many5.Количество());"));
