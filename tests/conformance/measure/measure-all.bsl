// ЕДИНСТВЕННЫЙ скрипт, который человек прогоняет на реальной 1С.
//
// Формат вывода машинный: `ИД<таб>ЗНАЧЕНИЕ`, ровно одна строка на ИД.
// Вывод платформы сохраняется в файл и скармливается обратно:
//
//     bsl-cli --ingest-measurements <файл-с-выводом-платформы>
//
// — он раскладывает его в tests/conformance/measure/platform.tsv и печатает
// таблицу расхождений с нашим выводом на этом же скрипте. Ничего в коде не
// правится автоматически: что чинить, а что было верно, решает человек.
//
// ПРАВИЛА, на которых держится осмысленность вывода:
//
// 1. Каждый ИД из реестра `bsl_rt::open_questions` присутствует здесь ровно
//    один раз — это проверяет тест
//    crates/bsl-rt/tests/open_questions_registry.rs.
// 2. Числа печатаются ТОЛЬКО через Ч() = Формат(x, "ЧГ=0; ЧРД=."),
//    иначе расхождение семантики не отличить от расхождения форматирования.
//    Исключение — вопросы про САМО форматирование: у них ИД начинается на
//    `FMT.`, и там наоборот нужен голый Строка().
// 3. Строки `ANCHOR`-ов (уже измеренные значения — NUM.DIV.*, SQRT.TWO,
//    FMT.BOOLEAN.TRUE и т.д.) — не вопросы, а канарейка сеанса: если
//    платформа разошлась с ними, сеанс снят не с той конфигурации и
//    остальным строкам верить нельзя.
// 4. Всё, что платформа МОЖЕТ отвергнуть ошибкой (зажатие дня в
//    ДобавитьМесяц, Итог по нечисловой колонке, суррогатная пара), обёрнуто
//    в Попытка: один упавший замер не должен уносить весь сеанс.
//
// Скрипт исполняется и НАШИМ интерпретатором (тест
// `measure_script_runs_under_this_interpreter` в bsl-cli). Конструкции,
// которые мы пока не поддерживаем, вынесены в measure-unsupported.bsl.

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧГ=0; ЧРД=.");
КонецФункции

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

// =====================================================================
// ЯКОРЯ: уже измерено, менять нельзя. Расхождение здесь обесценивает
// весь сеанс.
// =====================================================================

М("NUM.DIV.THIRD",            Ч(1/3));
М("NUM.DIV.TWO_THIRDS",       Ч(2/3));
М("NUM.DIV.TEN_THIRDS",       Ч(10/3));
М("NUM.DIV.EXACT_TIE",        Ч(1/268435456));
М("SQRT.TWO",                 Ч(Sqrt(2)));
М("NUM.MUL.TRAILING_ZEROS",   Ч(1.10 * 1.00));
М("NUM.POW.TEN_TO_30",        Ч(Pow(10, 30)));
М("NUM.STRLEN_OF_THIRD",      Ч(СтрДлина(Строка(1/3))));
М("FMT.NUMBER.DEFAULT",       Строка(1000.5));
М("FMT.GROUP_SEP_CODE",       Ч(КодСимвола(Строка(1000.5), 2)));
М("FMT.NUMBER.ROUND_TRIP",    Ч(Число(Строка(1000000))));
М("FMT.BOOLEAN.TRUE",         Строка(Истина));
М("FMT.ARRAY.DEFAULT",        Строка(Новый Массив));

// =====================================================================
// ЧИСЛА
// =====================================================================

// ЯКОРЬ (измерено 8.3.27): умолчание — половина ОТ нуля.
М("NUM.ROUND.DEFAULT_MODE",
	Ч(Окр(2.5)) + " " + Ч(Окр(3.5)) + " " + Ч(Окр(-2.5)));

// ЯКОРЬ: режим 0 — половина К нулю, режим 1 — от нуля. Решающая точка —
// 3,5 в режиме 0: половина к ЧЁТНОМУ дала бы 4, к нулю даёт 3.
М("NUM.ROUND.MODE_CODES",
	Ч(Окр(2.5, 0, 0)) + " " + Ч(Окр(3.5, 0, 0)) + " "
	+ Ч(Окр(2.5, 0, 1)) + " " + Ч(Окр(3.5, 0, 1)));

// Sqrt(2) воспроизводится моделью «15 значащих», Sqrt(0.02) — нет.
// Соседние точки нужны, чтобы увидеть закономерность, а не подгонять.
М("SQRT.SMALL_ARG",
	Ч(Sqrt(0.02)) + " " + Ч(Sqrt(200)) + " " + Ч(Sqrt(0.0002)) + " " + Ч(Exp(1)));

// =====================================================================
// ФОРМАТ: спецификаторы сверх ЧГ/ЧРД/ЧРГ/ЧДЦ
//
// Здесь голый Строка()/Формат() без "ЧГ=0; ЧРД=." — вопрос ровно про то,
// как выглядит результат самого форматирования.
// =====================================================================

// ЧЦ: считает ли всё вместе, и что с числом, не влезающим в поле.
М("FMT.NUM.TOTAL_DIGITS",
	Формат(123.456, "ЧГ=0; ЧЦ=5") + "|" + Формат(123.456, "ЧГ=0; ЧЦ=3")
	+ "|" + Формат(123456, "ЧГ=0; ЧЦ=3"));

// ЧН: текст вместо нуля, в том числе нуля после округления.
М("FMT.NUM.ZERO_TEXT",
	Формат(0, "ЧН=пусто") + "|" + Формат(0, "ЧН=") + "|"
	+ Формат(0.004, "ЧДЦ=2; ЧН=пусто") + "|" + Формат(0, "ЧГ=0"));

// ЧВН: ведущие нули — до какой ширины и работает ли без ЧЦ.
М("FMT.NUM.LEADING_ZEROS",
	Формат(42, "ЧГ=0; ЧЦ=5; ЧВН=1") + "|" + Формат(42, "ЧГ=0; ЧВН=1")
	+ "|" + Формат(1.5, "ЧГ=0; ЧЦ=5; ЧДЦ=2; ЧВН=1"));

// ЧС: направление сдвига и знак.
М("FMT.NUM.SHIFT",
	Формат(1234, "ЧГ=0; ЧС=3") + "|" + Формат(1234, "ЧГ=0; ЧС=-2"));

// БИ/БЛ: свои тексты булева, в том числе когда задан только один ключ.
М("FMT.BOOLEAN.TRUE_TEXT",
	Формат(Истина, "БИ=ага") + "|" + Формат(Ложь, "БИ=ага"));
М("FMT.BOOLEAN.FALSE_TEXT",
	Формат(Ложь, "БЛ=неа") + "|" + Формат(Истина, "БЛ=неа"));

// Л: имя ключа и действие на разделители.
М("FMT.LOCALE.KEY", Формат(1234.5, "Л=ru") + "|" + Формат(1234.5, "Л=ru_RU"));

// Л: незнакомый код — ошибка, откат к умолчанию или что-то третье.
Р = "";
Попытка
	Р = Формат(1234.5, "Л=en_US") + "|" + Формат(1234.5, "Л=de_DE");
Исключение
	Р = Формат(1234.5, "Л=en_US") + "|<ошибка на de_DE>";
КонецПопытки;
М("FMT.LOCALE.COVERAGE", Р);

// Л: представление булева в английской локали.
Р = "";
Попытка
	Р = Формат(Истина, "Л=en_US") + "|" + Формат(Ложь, "Л=en_US");
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("FMT.LOCALE.BOOLEAN", Р);

// =====================================================================
// ДАТЫ
// =====================================================================

Д1 = Дата(2024, 1, 15, 10, 30, 0);

// Понедельник 15.01.2024 и воскресенье 21.01.2024.
М("DATE.WEEKDAY_NUMBERING",
	Ч(ДеньНедели(Дата(2024, 1, 15))) + " " + Ч(ДеньНедели(Дата(2024, 1, 21))));

// Зажатие в последний день месяца ИЛИ ошибка — поэтому Попытка.
Р = "";
Попытка
	Р = Строка(ДобавитьМесяц(Дата(2024, 1, 31), 1))
		+ " " + Строка(ДобавитьМесяц(Дата(2023, 1, 31), 1));
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("DATE.ADD_MONTH_CLAMP", Р);

// Буквы шаблона сверх реализованных: квартал, до/после полудня, 12-часовой
// час. Значения БЕЗ кавычек — в кавычках 1С копирует текст буквально.
М("DATE.PATTERN_LETTERS",
	Формат(Д1, "ДФ=К") + "|" + Формат(Д1, "ДФ=в") + "|" + Формат(Д1, "ДФ=ч"));

// Набор кодов ДЛФ плюс поведение на неизвестном коде.
Р = "";
Попытка
	Р = Формат(Д1, "ДЛФ=НЕТТАКОГО");
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("DATE.LONG_FORMAT_CODES",
	Формат(Д1, "ДЛФ=Д") + "|" + Формат(Д1, "ДЛФ=ДД") + "|"
	+ Формат(Д1, "ДЛФ=ДДД") + "|" + Формат(Д1, "ДЛФ=В") + "|" + Р);

// ЯКОРЬ (измерено 8.3.27): время печатается всегда, час без ведущего нуля.
М("FMT.DATE.DEFAULT",
	Строка(Д1) + "|" + Строка(Дата(2024, 1, 15)) + "|" + Строка('00010101'));

// =====================================================================
// СТРОКИ И ТИПЫ
// =====================================================================

// Код-юнит (55357) или кодовая точка (128512); заодно длина строки из
// одного астрального символа: 1 или 2.
Р = "";
Попытка
	Р = Ч(КодСимвола(Символ(128512))) + " " + Ч(СтрДлина(Символ(128512)));
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("STR.CHAR_CODE_SURROGATE", Р);

М("TYPE.IS_FILLED.BOOLEAN",
	Строка(ЗначениеЗаполнено(Ложь)) + "|" + Строка(ЗначениеЗаполнено(Истина)));
М("TYPE.IS_FILLED.BLANK_STRING",
	Строка(ЗначениеЗаполнено("   ")) + "|" + Строка(ЗначениеЗаполнено("")));
М("TYPE.IS_FILLED.EMPTY_COLLECTION",
	Строка(ЗначениеЗаполнено(Новый Массив)) + "|"
	+ Строка(ЗначениеЗаполнено(Новый Структура)));

// =====================================================================
// ТАБЛИЦА ЗНАЧЕНИЙ
// =====================================================================

// Итог по нечисловой и по смешанной колонке: 0, ошибка или пропуск.
ТИтог = Новый ТаблицаЗначений;
ТИтог.Колонки.Добавить("К");
ТИтог.Добавить().К = "текст";
Р = "";
Попытка
	Р = Ч(ТИтог.Итог("К"));
	ТИтог.Добавить().К = 5;
	Р = Р + " " + Ч(ТИтог.Итог("К"));
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("TABLE.TOTAL.NON_NUMERIC", Р);

// ГЛАВНЫЙ вопрос волны 2: где `ё` относительно `е`, что с регистром, как
// соотносятся кириллица, латиница и цифры.
ТКол = Новый ТаблицаЗначений;
ТКол.Колонки.Добавить("С");
Для Каждого З Из СтрРазделить("яблоко,Яблоко,ёлка,Ель,zebra,Апельсин,10,2", ",") Цикл
	ТКол.Добавить().С = З;
КонецЦикла;
ТКол.Сортировать("С");
Р = "";
Для Каждого С Из ТКол Цикл
	Р = Р + С.С + ",";
КонецЦикла;
М("TABLE.SORT.COLLATION", Р);

// Порядок РАЗНОТИПНЫХ значений одной колонки.
ТТипы = Новый ТаблицаЗначений;
ТТипы.Колонки.Добавить("К");
ТТипы.Добавить().К = "текст";
ТТипы.Добавить().К = 5;
ТТипы.Добавить().К = Дата(2024, 1, 15);
ТТипы.Добавить().К = Истина;
ТТипы.Добавить().К = Неопределено;
Р = "";
Попытка
	ТТипы.Сортировать("К");
	Для Каждого С Из ТТипы Цикл
		Р = Р + Строка(ТипЗнч(С.К)) + ",";
	КонецЦикла;
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("TABLE.SORT.TYPE_ORDER", Р);

// --- Свернуть ---------------------------------------------------------
// Таблица с колонкой ВНЕ обоих списков (`прочее`) и с нечисловым значением
// в суммируемой колонке — три вопроса сразу на одних данных.
ТСв = Новый ТаблицаЗначений;
ТСв.Колонки.Добавить("группа");
ТСв.Колонки.Добавить("сумма");
ТСв.Колонки.Добавить("прочее");
С1 = ТСв.Добавить(); С1.группа = "б"; С1.сумма = 10;      С1.прочее = "х";
С2 = ТСв.Добавить(); С2.группа = "а"; С2.сумма = 1;       С2.прочее = "у";
С3 = ТСв.Добавить(); С3.группа = "б"; С3.сумма = 20;      С3.прочее = "z";
С4 = ТСв.Добавить(); С4.группа = "а"; С4.сумма = "текст"; С4.прочее = "ц";
ТСв.Свернуть("группа", "сумма");

// Порядок строк: первое вхождение дало бы «б, а», сортировка по ключам —
// «а, б».
Р = "";
Для Каждого С Из ТСв Цикл
	Р = Р + С.группа + ",";
КонецЦикла;
М("TABLE.COLLAPSE.ROW_ORDER", Р);

// Судьба колонки `прочее`: удалена (тогда обращение к ней — ошибка) или
// осталась с каким-то значением.
Р = Ч(ТСв.Колонки.Количество());
Попытка
	Р = Р + " прочее=" + Строка(ТСв[0].прочее);
Исключение
	Р = Р + " прочее=<нет колонки>";
КонецПопытки;
М("TABLE.COLLAPSE.OTHER_COLUMNS", Р);

// Группа «а» — это 1 и "текст": 1 при игнорировании нечисловых, ошибка или
// что-то иное при другом решении.
Р = "";
Попытка
	Для Каждого С Из ТСв Цикл
		Р = Р + С.группа + "=" + Ч(С.сумма) + ",";
	КонецЦикла;
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("TABLE.COLLAPSE.NON_NUMERIC", Р);

// --- ЗагрузитьКолонку: длина массива не равна числу строк -------------
ТЗагр = Новый ТаблицаЗначений;
ТЗагр.Колонки.Добавить("К");
ТЗагр.Добавить().К = 1;
ТЗагр.Добавить().К = 2;
МассивКороткий = Новый Массив;
МассивКороткий.Добавить(9);
Р = "";
Попытка
	ТЗагр.ЗагрузитьКолонку(МассивКороткий, "К");
	Р = Ч(ТЗагр.Количество()) + " строк:";
	Для Каждого С Из ТЗагр Цикл
		Р = Р + " " + Строка(С.К);
	КонецЦикла;
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("TABLE.LOAD_COLUMN.LENGTH_MISMATCH", Р);

// --- Сдвинуть за границу ----------------------------------------------
ТСдв = Новый ТаблицаЗначений;
ТСдв.Колонки.Добавить("К");
ТСдв.Добавить().К = 1;
ТСдв.Добавить().К = 2;
Р = "";
Попытка
	ТСдв.Сдвинуть(0, -1);
	Р = "принято, порядок:";
	Для Каждого С Из ТСдв Цикл
		Р = Р + " " + Ч(С.К);
	КонецЦикла;
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("TABLE.MOVE.OUT_OF_RANGE", Р);

// =====================================================================
// ВЫПОЛНИТЬ / ВЫЧИСЛИТЬ
// =====================================================================

// Переживает ли вызов имя, впервые созданное внутри фрагмента. Прямое
// обращение к нему (без Вычислить) у нас не компилируется — оно вынесено
// в measure-unsupported.bsl.
Р = "";
Попытка
	Выполнить("НоваяПеременнаяФрагмента = 5");
	Р = Ч(Вычислить("НоваяПеременнаяФрагмента"));
Исключение
	Р = "<ошибка: имя не пережило Выполнить>";
КонецПопытки;
М("EXEC.NEW_VARIABLE_SCOPE", Р);

// Может ли фрагмент объявлять процедуры.
Р = "";
Попытка
	Выполнить("Процедура ФрагментнаяПроцедура() КонецПроцедуры");
	Р = "объявление принято";
Исключение
	Р = "<ошибка: объявление отвергнуто>";
КонецПопытки;
М("EXEC.PROC_DECLARATION", Р);
