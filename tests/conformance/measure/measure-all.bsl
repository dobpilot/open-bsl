	ЗаписатьJSON(ЗаписьГлубокого, ГлубокийМассив);
	СтрокаГлубокого = ЗаписьГлубокого.Закрыть();
	Р = "Ок";
Исключение
	Р = "Ошибка";
КонецПопытки;
М("JSON.MAX_DEPTH", Р);

// --- Ширина разбираемой шестнадцатеричной строки ----------------------------

// ЯКОРЬ. Различить точный разбор, ошибку и молчаливую потерю старших
// разрядов можно только по ДЛИНЕ десятичной записи, поэтому печатаются
// длины: 40 знакам F отвечают 49 цифр (2^160-1), 200 — 241 (2^800-1),
// и до этой ширины платформа сходится с нами знак в знак. На 5000 знаках
// она отдаёт 309 цифр вместо точных 6021 — не ошибку и не усечение, а
// чужое число (концы его напечатаны контрактом measure-binary.bsl).
// Три ширины пробуются порознь, а печатается одна строка: правило
// «один М() на ИД» сильнее удобства.
Ширина40 = "";
Для Шаг = 1 По 40 Цикл
	Ширина40 = Ширина40 + "F";
КонецЦикла;
Ширина200 = Ширина40;
Для Шаг = 41 По 200 Цикл
	Ширина200 = Ширина200 + "F";
КонецЦикла;
Ширина5000 = Ширина200;
Для Шаг = 201 По 5000 Цикл
	Ширина5000 = Ширина5000 + "F";
КонецЦикла;

Р40 = "Ошибка";
Попытка
	Разобрано40 = ЧислоИзШестнадцатеричнойСтроки("0x" + Ширина40);
	Р40 = Ч(СтрДлина(Ч(Разобрано40)));
Исключение
	Р40 = "Ошибка";
КонецПопытки;

Р200 = "Ошибка";
Попытка
	Разобрано200 = ЧислоИзШестнадцатеричнойСтроки("0x" + Ширина200);
	Р200 = Ч(СтрДлина(Ч(Разобрано200)));
Исключение
	Р200 = "Ошибка";
КонецПопытки;

Р5000 = "Ошибка";
Попытка
	Разобрано5000 = ЧислоИзШестнадцатеричнойСтроки("0x" + Ширина5000);
	Р5000 = Ч(СтрДлина(Ч(Разобрано5000)));
Исключение
	Р5000 = "Ошибка";
КонецПопытки;

М("BIN.RADIX.WIDTH", "40=" + Р40 + " 200=" + Р200 + " 5000=" + Р5000);

// DOM: находит ли платформа элемент по идентификатору — сперва когда
// атрибут объявлен типом `ID` во внутреннем подмножестве DTD, потом когда
// он просто назван `id`. Печатается пара «из DTD|обычный id».
Функция ЭлементПоИдентификатору(ТекстДокумента, Идентификатор)
	Попытка
		ПостроительДляИд = Новый ПостроительDOM;
		ЧтениеДляИд = Новый ЧтениеXML;
		ЧтениеДляИд.УстановитьСтроку(ТекстДокумента);
		ДокументДляИд = ПостроительДляИд.Прочитать(ЧтениеДляИд);
		НайденныйУзел = ДокументДляИд.ПолучитьЭлементПоИдентификатору(Идентификатор);
		Если НайденныйУзел = Неопределено Тогда
			Возврат "Неопределено";
		КонецЕсли;
		Возврат НайденныйУзел.ИмяУзла;
	Исключение
		Возврат "Ошибка";
	КонецПопытки;
КонецФункции

ПоИдИзDTD = ЭлементПоИдентификатору("<!DOCTYPE к [<!ATTLIST т ид ID #IMPLIED>]><к><т ид=""х""/></к>", "х");
ПоОбычномуИд = ЭлементПоИдентификатору("<к><т id=""х""/></к>", "х");
М("DOM.DOC.ELEMENT_BY_ID", ПоИдИзDTD + "|" + ПоОбычномуИд);

// --- DOM: предел вложенности ------------------------------------------------

// Нижняя граница глубины ПостроительDOM: 500 уровней обязаны читаться.
// Растущий зонд намеренно не ставится: если платформа падает на слишком
// глубоком документе, он уносит весь сеанс. Проверяется не только
// отсутствие ошибки, но и то, что корень действительно построен: пустой
// документ платформа отдаёт молча, ошибкой это не считая.
ОткрывающиеТеги = "";
ЗакрывающиеТеги = "";
Для Шаг = 1 По 500 Цикл
	ОткрывающиеТеги = ОткрывающиеТеги + "<а>";
	ЗакрывающиеТеги = ЗакрывающиеТеги + "</а>";
КонецЦикла;
Р = "";
Попытка
	ПостроительГлубокого = Новый ПостроительDOM;
	ЧтениеГлубокого = Новый ЧтениеXML;
	ЧтениеГлубокого.УстановитьСтроку(ОткрывающиеТеги + "х" + ЗакрывающиеТеги);
	ДокументГлубокого = ПостроительГлубокого.Прочитать(ЧтениеГлубокого);
	Если ДокументГлубокого.ЭлементДокумента = Неопределено Тогда
		Р = "Пусто";
	Иначе
		Р = "Ок";
	КонецЕсли;
Исключение
	Р = "Ошибка";
КонецПопытки;
М("DOM.MAX_DEPTH", Р);

// XSD.TYPED_VALUE: во что превращается `default` объявления, чей тип —
// НЕ измеренные `xs:string`/`xs:int`/`xs:boolean`. Пробуем `xs:decimal`:
// если платформа отдаёт число, наше правило «все встроенные числовые типы
// дают Число» верно и для него.
ИсточникСхемыДробной = "<xs:schema xmlns:xs=""http://www.w3.org/2001/XMLSchema"">"
	+ "<xs:element name=""д"" type=""xs:decimal"" default=""1.5""/></xs:schema>";
Р = "";
Попытка
	ПостроительСхемыДробной = Новый ПостроительDOM;
	ЧтениеСхемыДробной = Новый ЧтениеXML;
	ЧтениеСхемыДробной.УстановитьСтроку(ИсточникСхемыДробной);
	ПостроительСхемДробной = Новый ПостроительСхемXML;
	СхемаДробная = ПостроительСхемДробной.СоздатьСхемуXML(ПостроительСхемыДробной.Прочитать(ЧтениеСхемыДробной));
	ЗначениеДробное = СхемаДробная.ОбъявленияЭлементов.Получить("д").Значение;
	Р = Строка(ТипЗнч(ЗначениеДробное)) + ":" + Строка(ЗначениеДробное);
Исключение
	Р = "Ошибка";
КонецПопытки;
М("XSD.TYPED_VALUE", Р);

// Чем отвечает `ЗначениеЗаполнено` на значениях модели типов XDTO. САМО
// `ЗначениеXDTO` здесь не строится и строиться не должно:
// проба на нём вешает 8.3.27 модальным окном (таймаут 180 с, пустой вывод)
// даже из-под `Вычислить` в `Попытка`, то есть уносит весь сеанс замеров.
// Суррогат перепроверяет измеренного соседа семейства — тип значения из
// глобальной фабрики: у него ответ ИЗМЕРЕН ошибкой, и пока он держится,
// отнесение `ЗначениеXDTO` к тем же четырём соседям остаётся правдоподобным.
// Обращение к фабрике идёт через `Вычислить`, и здесь оно даёт «Нет
// фабрики»: голое имя `ФабрикаXDTO` — это фабрика КОНФИГУРАЦИИ, а
// конфигурации у интерпретатора нет, поэтому имя поднимает честную
// `RtError` про отсутствие метаданных, которую ловит та же `Попытка`.
// Сами `Новый ФабрикаXDTO`/`СоздатьФабрикуXDTO` здесь уже есть.
Р = "";
Попытка
	ТипXDTOПробы = Вычислить("ФабрикаXDTO.Тип(""http://www.w3.org/2001/XMLSchema"", ""string"")");
	Попытка
		Р = "Признак:" + Строка(ЗначениеЗаполнено(ТипXDTOПробы));
	Исключение
		Р = "Ошибка признака";
	КонецПопытки;
Исключение
	Р = "Нет фабрики";
КонецПопытки;
М("XDTO.VALUE.FILLED", Р);

// --- XDTO: предел вложенности экземпляра при записи -------------------------

// Нижняя граница глубины `ЗаписатьXML` фабрики XDTO: 400 уровней экземпляра
// обязаны записываться. Зонд фиксированный, как у DOM.MAX_DEPTH: растущий
// намеренно не ставится — если платформа падает на слишком глубоком
// экземпляре, он уносит весь сеанс замеров. Циклический граф (свойство,
// указывающее на владельца) здесь не пробуется по той же причине.
// Схема рекурсивная: `RootType` содержит необязательный `child` того же
// типа, поэтому цепочку любой длины строит один цикл. Схема идёт файлом,
// потому что `СоздатьФабрикуXDTO` берёт только путь к XSD (измерено).
// Пустой результат успехом не считается — проверяется, что документ
// действительно записан.
ТекстСхемыГлубокой = "<?xml version=""1.0"" encoding=""UTF-8""?>"
	+ "<xs:schema xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:t=""urn:depth"""
	+ " targetNamespace=""urn:depth"" elementFormDefault=""qualified"">"
