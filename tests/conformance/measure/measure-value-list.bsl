// Минимальный контракт СписокЗначений для canonical query AWS4.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция БулевоСтрокой(Значение)
	Если Значение Тогда
		Возврат "true";
	КонецЕсли;
	Возврат "false";
КонецФункции

Список = Новый СписокЗначений;
М("HTTP.VALUELIST.TYPE", ТипЗнч(Список));
М("HTTP.VALUELIST.EMPTY", Список.Количество());

ЭлементB = Список.Добавить("b", "B-value");
ЭлементA1 = Список.Добавить("a", "A-first");
ЭлементA2 = Список.Добавить("a", "A-second");
М("HTTP.VALUELIST.ADD.RETURN_ALIAS", БулевоСтрокой(ЭлементB = Список[0]));
М("HTTP.VALUELIST.ITEM.VALUE", ЭлементB.Значение);
М("HTTP.VALUELIST.ITEM.PRESENTATION", ЭлементB.Представление);

РезультатПоиска = "<ошибка>";
РезультатОтсутствия = "<ошибка>";
Попытка
	Найденный = Список.Найти("a");
	РезультатПоиска = БулевоСтрокой(Найденный = ЭлементA1);
	РезультатОтсутствия = БулевоСтрокой(Список.Найти("missing") = Неопределено);
Исключение
КонецПопытки;
М("HTTP.VALUELIST.FIND.FIRST", РезультатПоиска);
М("HTTP.VALUELIST.FIND.MISSING", РезультатОтсутствия);

Список.СортироватьПоЗначению(НаправлениеСортировки.Возр);
Порядок = "";
Для Каждого Элемент Из Список Цикл
	Порядок = Порядок + Элемент.Значение + ":" + Элемент.Представление + ";";
КонецЦикла;
М("HTTP.VALUELIST.SORT.ASC", Порядок);
М("HTTP.VALUELIST.SORT.STABLE", БулевоСтрокой(
	Список[0] = ЭлементA1 И Список[1] = ЭлементA2));
М("HTTP.VALUELIST.DIRECTION.DISPLAY", НаправлениеСортировки.Возр);
М("HTTP.VALUELIST.DIRECTION.TYPE", ТипЗнч(НаправлениеСортировки.Возр));
