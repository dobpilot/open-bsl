// Контракт потоковых операций, которые использует Connector 2.6.0.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция БулевоСтрокой(Значение)
	Если Значение Тогда
		Возврат "true";
	КонецЕсли;
	Возврат "false";
КонецФункции

Функция ПотокИзСтроки(ТекстПотока)
	БуферПотока = ПолучитьБуферДвоичныхДанныхИзСтроки(
		ТекстПотока, КодировкаТекста.UTF8, Ложь);
	Возврат Новый ПотокВПамяти(БуферПотока);
КонецФункции

Функция HexЗакрытогоПотока(ПотокБайтов)
	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(
		ПотокБайтов.ЗакрытьИПолучитьДвоичныеДанные());
КонецФункции

// `Поток.КопироватьВ`: позиции обеих сторон и обработка количества.
ИсточникКопии = ПотокИзСтроки("ABCDE");
ИсточникКопии.Перейти(2, ПозицияВПотоке.Начало);
ПриемникКопии = Новый ПотокВПамяти;
НачальнаяЗаписьКопии = Новый ЗаписьДанных(ПриемникКопии);
НачальнаяЗаписьКопии.ЗаписатьБайт(88);
ИсточникКопии.КопироватьВ(ПриемникКопии, 2);
М("STREAM.COPY.COUNT.SOURCE_POSITION", ИсточникКопии.ТекущаяПозиция());
М("STREAM.COPY.COUNT.TARGET_POSITION", ПриемникКопии.ТекущаяПозиция());
М("STREAM.COPY.COUNT.BYTES", HexЗакрытогоПотока(ПриемникКопии));

ИсточникДоКонца = ПотокИзСтроки("ABCD");
ИсточникДоКонца.Перейти(1, ПозицияВПотоке.Начало);
ПриемникДоКонца = Новый ПотокВПамяти;
ИсточникДоКонца.КопироватьВ(ПриемникДоКонца);
М("STREAM.COPY.OMITTED.SOURCE_POSITION", ИсточникДоКонца.ТекущаяПозиция());
М("STREAM.COPY.OMITTED.BYTES", HexЗакрытогоПотока(ПриемникДоКонца));

ИсточникНоль = ПотокИзСтроки("ABC");
ПриемникНоль = Новый ПотокВПамяти;
ИсточникНоль.КопироватьВ(ПриемникНоль, 0);
М("STREAM.COPY.ZERO.SOURCE_POSITION", ИсточникНоль.ТекущаяПозиция());
М("STREAM.COPY.ZERO.BYTES", HexЗакрытогоПотока(ПриемникНоль));

ИсточникБольше = ПотокИзСтроки("ABC");
ИсточникБольше.Перейти(1, ПозицияВПотоке.Начало);
ПриемникБольше = Новый ПотокВПамяти;
ИсточникБольше.КопироватьВ(ПриемникБольше, 100);
М("STREAM.COPY.OVERSIZED.SOURCE_POSITION", ИсточникБольше.ТекущаяПозиция());
М("STREAM.COPY.OVERSIZED.BYTES", HexЗакрытогоПотока(ПриемникБольше));

// `ЗакрытьИПолучитьДвоичныеДанные` возвращает весь носитель, а не хвост.
ПотокЗакрытия = ПотокИзСтроки("ABC");
ПотокЗакрытия.Перейти(1, ПозицияВПотоке.Начало);
ДанныеЗакрытия = ПотокЗакрытия.ЗакрытьИПолучитьДвоичныеДанные();
М("STREAM.CLOSE_DATA.TYPE", БулевоСтрокой(ТипЗнч(ДанныеЗакрытия) = Тип("ДвоичныеДанные")));
М("STREAM.CLOSE_DATA.BYTES", ПолучитьHexСтрокуИзДвоичныхДанных(ДанныеЗакрытия));
РезультатПовтора = "<ошибка>";
Попытка
	ДанныеПовтора = ПотокЗакрытия.ЗакрытьИПолучитьДвоичныеДанные();
	РезультатПовтора = ПолучитьHexСтрокуИзДвоичныхДанных(ДанныеПовтора);
Исключение
КонецПопытки;
М("STREAM.CLOSE_DATA.REPEATED", РезультатПовтора);

// `ЧтениеДанных.ИсходныйПоток` должен вернуть нижележащий поток.
ПотокЧитателя = ПотокИзСтроки("ABCD");
ПотокЧитателя.Перейти(1, ПозицияВПотоке.Начало);
ЧитательИсточника = Новый ЧтениеДанных(ПотокЧитателя);
ВозвращенныйПоток = ЧитательИсточника.ИсходныйПоток();
М("DATAREADER.SOURCE_STREAM.TYPE", БулевоСтрокой(ТипЗнч(ВозвращенныйПоток) = Тип("Поток")));
М("DATAREADER.SOURCE_STREAM.POSITION", ВозвращенныйПоток.ТекущаяПозиция());
М("DATAREADER.SOURCE_STREAM.SIZE", ВозвращенныйПоток.Размер());
ВозвращенныйПоток.Перейти(3, ПозицияВПотоке.Начало);
М("DATAREADER.SOURCE_STREAM.ORIGINAL_AFTER_SEEK", ПотокЧитателя.ТекущаяПозиция());
РезультатСдвига = "<ошибка>";
Попытка
	РезультатСдвига = ЧитательИсточника.ПрочитатьБайт();
Исключение
КонецПопытки;
М("DATAREADER.SOURCE_STREAM.ALIAS", РезультатСдвига);
М("DATAREADER.SOURCE_STREAM.ORIGINAL_AFTER_READ", ПотокЧитателя.ТекущаяПозиция());
М("DATAREADER.SOURCE_STREAM.RETURNED_AFTER_READ", ВозвращенныйПоток.ТекущаяПозиция());

// `ЧтениеДанных.КопироватьВ` пишет через `ЗаписьДанных`.
ПотокКопииЧитателя = ПотокИзСтроки("ABCD");
ПотокКопииЧитателя.Перейти(1, ПозицияВПотоке.Начало);
ЧитательКопии = Новый ЧтениеДанных(ПотокКопииЧитателя);
ПотокПисателя = Новый ПотокВПамяти;
НачальнаяЗаписьПисателя = Новый ЗаписьДанных(ПотокПисателя);
НачальнаяЗаписьПисателя.ЗаписатьБайт(88);
ПисательКопии = Новый ЗаписьДанных(ПотокПисателя);
ЧитательКопии.КопироватьВ(ПисательКопии, 2);
М("DATAREADER.COPY.COUNT.SOURCE_POSITION", ПотокКопииЧитателя.ТекущаяПозиция());
М("DATAREADER.COPY.COUNT.TARGET_POSITION", ПотокПисателя.ТекущаяПозиция());
М("DATAREADER.COPY.COUNT.BYTES", HexЗакрытогоПотока(ПотокПисателя));

ПотокКопииНоль = ПотокИзСтроки("ABC");
ЧитательКопииНоль = Новый ЧтениеДанных(ПотокКопииНоль);
ПотокПисателяНоль = Новый ПотокВПамяти;
ПисательКопииНоль = Новый ЗаписьДанных(ПотокПисателяНоль);
ЧитательКопииНоль.КопироватьВ(ПисательКопииНоль, 0);
М("DATAREADER.COPY.ZERO.SOURCE_POSITION", ПотокКопииНоль.ТекущаяПозиция());
М("DATAREADER.COPY.ZERO.BYTES", HexЗакрытогоПотока(ПотокПисателяНоль));

// Connector передаёт этому методу один целый буфер.
ПотокБуфера = Новый ПотокВПамяти;
ПисательБуфера = Новый ЗаписьДанных(ПотокБуфера);
БуферConnector = ПолучитьБуферДвоичныхДанныхИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
ПисательБуфера.ЗаписатьБуферДвоичныхДанных(БуферConnector);
М("DATAWRITER.WRITE_BUFFER.POSITION", ПотокБуфера.ТекущаяПозиция());
М("DATAWRITER.WRITE_BUFFER.BYTES", HexЗакрытогоПотока(ПотокБуфера));

// Два прямых преобразования между буфером и двоичными данными
// нужны HMAC и проверке большого GZIP-тела Connector.
ДанныеИзБуфера = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(БуферConnector);
М("BINBUF.TO_BINARY.TYPE", БулевоСтрокой(ТипЗнч(ДанныеИзБуфера) = Тип("ДвоичныеДанные")));
М("BINBUF.TO_BINARY.BYTES", ПолучитьHexСтрокуИзДвоичныхДанных(ДанныеИзБуфера));
БуферИзДанных = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДанныеИзБуфера);
М("BINBUF.FROM_BINARY.TYPE", БулевоСтрокой(ТипЗнч(БуферИзДанных) = Тип("БуферДвоичныхДанных")));
М("BINBUF.FROM_BINARY.BYTES", ПолучитьСтрокуИзБуфераДвоичныхДанных(БуферИзДанных, КодировкаТекста.UTF8));

// Точная форма конструктора из Connector 2.6.0.
ПотокШестиАргументов = Новый ПотокВПамяти;
ПисательШестиАргументов = Новый ЗаписьДанных(
	ПотокШестиАргументов, КодировкаТекста.UTF8,
	ПорядокБайтов.LittleEndian, "", "", Ложь);
ПисательШестиАргументов.ЗаписатьСимволы("A" + Символы.ПС + "B");
М("DATAWRITER.SIX_ARGS.BYTES", HexЗакрытогоПотока(ПотокШестиАргументов));

// Поток чтения над нативными `ДвоичныеДанные` строит компонент потоков.
ДанныеПотока = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
ПотокДанных = ДанныеПотока.ОткрытьПотокДляЧтения();
М("BINARYDATA.OPEN_STREAM.TYPE", БулевоСтрокой(ТипЗнч(ПотокДанных) = Тип("Поток")));
М("BINARYDATA.OPEN_STREAM.POSITION", ПотокДанных.ТекущаяПозиция());
М("BINARYDATA.OPEN_STREAM.SIZE", ПотокДанных.Размер());
ЧтениеПотокаДанных = Новый ЧтениеДанных(ПотокДанных);
М("BINARYDATA.OPEN_STREAM.FIRST_BYTE", ЧтениеПотокаДанных.ПрочитатьБайт());
М("BINARYDATA.OPEN_STREAM.POSITION_AFTER_READ", ПотокДанных.ТекущаяПозиция());
РезультатЗаписиВПоток = "ok";
Попытка
	БуферЗаписиВПоток = ПолучитьБуферДвоичныхДанныхИзСтроки("X", КодировкаТекста.UTF8, Ложь);
	ПотокДанных.Записать(БуферЗаписиВПоток, 0, 1);
Исключение
	РезультатЗаписиВПоток = "<ошибка>";
КонецПопытки;
М("BINARYDATA.OPEN_STREAM.WRITE", РезультатЗаписиВПоток);
