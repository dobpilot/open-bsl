// Сетевой oracle требует локального HTTP-сервера: порт 80 отвечает на
// /default-port, порт 18080 задерживает /timeout больше одной секунды и
// возвращает два заголовка X-Duplicate на /duplicate-headers. Прокси на
// порту 18081 возвращает отличный статус, чтобы наблюдать его обход.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Результат = "ошибка";
Попытка
	Соединение = Новый HTTPСоединение("127.0.0.1");
	Ответ = Соединение.Получить(Новый HTTPЗапрос("/default-port"));
	Результат = Ответ.КодСостояния;
Исключение
КонецПопытки;
М("HTTP.CONNECTION.DEFAULT_PORT", Результат);

РезультатДоЗаголовков = "ошибка";
Попытка
	Соединение = Новый HTTPСоединение("127.0.0.1", 18080, , , , 1);
	Ответ = Соединение.Получить(Новый HTTPЗапрос("/timeout-before-headers"));
	РезультатДоЗаголовков = Ответ.КодСостояния;
Исключение
КонецПопытки;
РезультатМеждуТелом = "ошибка";
Попытка
	Соединение = Новый HTTPСоединение("127.0.0.1", 18080, , , , 1);
	Ответ = Соединение.Получить(Новый HTTPЗапрос("/timeout-between-body"));
	РезультатМеждуТелом = Ответ.КодСостояния;
Исключение
КонецПопытки;
РезультатНакопительный = "ошибка";
Попытка
	Соединение = Новый HTTPСоединение("127.0.0.1", 18080, , , , 1);
	Ответ = Соединение.Получить(Новый HTTPЗапрос("/timeout-cumulative"));
	РезультатНакопительный = Ответ.КодСостояния;
Исключение
КонецПопытки;
М("HTTP.TIMEOUT.SCOPE", РезультатДоЗаголовков + "|"
	+ РезультатМеждуТелом + "|" + РезультатНакопительный);

Результат = "ошибка";
Попытка
	Соединение = Новый HTTPСоединение("127.0.0.1", 18080);
	Ответ = Соединение.Получить(Новый HTTPЗапрос("/duplicate-headers"));
	Результат = Ответ.Заголовки.Получить("X-Duplicate");
Исключение
КонецПопытки;
М("HTTP.RESPONSE.DUPLICATE_HEADERS", Результат);

СтрокаТела = "ошибка";
ТипПотокаТела = "ошибка";
Попытка
	Соединение = Новый HTTPСоединение("127.0.0.1", 18080);
	Ответ = Соединение.Получить(Новый HTTPЗапрос("/response-body"));
	СтрокаТела = Ответ.ПолучитьТелоКакСтроку();
	ТипПотокаТела = Строка(ТипЗнч(Ответ.ПолучитьТелоКакПоток()));
Исключение
КонецПопытки;
М("HTTP.RESPONSE.BODY.STRING", СтрокаТела);
М("HTTP.RESPONSE.BODY.STREAM.TYPE", ТипПотокаТела);

РезультатIP = "ошибка";
РезультатИмя = "ошибка";
Попытка
	Прокси = Новый ИнтернетПрокси(Ложь);
	Прокси.Установить("http", "127.0.0.1", 18081);
	Прокси.НеИспользоватьПроксиДляЛокальныхАдресов = Истина;
	СоединениеIP = Новый HTTPСоединение("127.0.0.1", 18080, , , Прокси);
	СоединениеИмя = Новый HTTPСоединение("localhost", 18080, , , Прокси);
	РезультатIP = СоединениеIP.Получить(
		Новый HTTPЗапрос("/proxy-local-ip")).КодСостояния;
	РезультатИмя = СоединениеИмя.Получить(
		Новый HTTPЗапрос("/proxy-local-name")).КодСостояния;
Исключение
КонецПопытки;

РезультатIPv6БезСкобок = "ошибка";
Попытка
	Соединение = Новый HTTPСоединение("::1", 18082);
	РезультатIPv6БезСкобок = Соединение.Получить(
		Новый HTTPЗапрос("/ipv6-raw")).КодСостояния;
Исключение
КонецПопытки;

РезультатIPv6СоСкобками = "ошибка";
Попытка
	Соединение = Новый HTTPСоединение("[::1]", 18082);
	РезультатIPv6СоСкобками = Соединение.Получить(
		Новый HTTPЗапрос("/ipv6-bracketed")).КодСостояния;
Исключение
КонецПопытки;

РезультатIPv6Прокси = "ошибка";
Попытка
	Соединение = Новый HTTPСоединение("[::1]", 18082, , , Прокси);
	РезультатIPv6Прокси = Соединение.Получить(
		Новый HTTPЗапрос("/proxy-local-ipv6")).КодСостояния;
Исключение
КонецПопытки;

РезультатIPv4ДругойLoopback = "ошибка";
Попытка
	Соединение = Новый HTTPСоединение("127.0.0.2", 18083, , , Прокси);
	РезультатIPv4ДругойLoopback = Соединение.Получить(
		Новый HTTPЗапрос("/proxy-other-loopback")).КодСостояния;
Исключение
КонецПопытки;

РезультатЧастнойСети = "ошибка";
Попытка
	ЛокальноеИмя = Вычислить("ИмяКомпьютера()");
	Соединение = Новый HTTPСоединение(ЛокальноеИмя, 18084, , , Прокси);
	РезультатЧастнойСети = Соединение.Получить(
		Новый HTTPЗапрос("/proxy-private-host")).КодСостояния;
Исключение
КонецПопытки;

РезультатОдночастногоИмени = "ошибка";
Попытка
	Соединение = Новый HTTPСоединение("nonexistent-open-bsl-local", 18084, , , Прокси);
	РезультатОдночастногоИмени = Соединение.Получить(
		Новый HTTPЗапрос("/proxy-single-label")).КодСостояния;
Исключение
КонецПопытки;

РезультатИмениСТочкой = "ошибка";
Попытка
	Соединение = Новый HTTPСоединение("nonexistent.open-bsl", 18084, , , Прокси);
	РезультатИмениСТочкой = Соединение.Получить(
		Новый HTTPЗапрос("/proxy-dotted-name")).КодСостояния;
Исключение
КонецПопытки;
М("HTTP.PROXY.LOCAL_MATCHING", Строка(РезультатIP) + "|" + Строка(РезультатИмя)
	+ "|" + Строка(РезультатIPv6БезСкобок)
	+ "|" + Строка(РезультатIPv6СоСкобками)
	+ "|" + Строка(РезультатIPv6Прокси)
	+ "|" + Строка(РезультатIPv4ДругойLoopback)
	+ "|" + Строка(РезультатЧастнойСети)
	+ "|" + Строка(РезультатОдночастногоИмени)
	+ "|" + Строка(РезультатИмениСТочкой));
