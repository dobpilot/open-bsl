// Два режима URL-кодирования, которые использует Connector 2.6.0.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Исходная = "AZaz09-._~ /?:@&=+$,#[]%";
Кириллица = "Привет мир";

М("HTTP.URL.ENUM.URL_DISPLAY", СпособКодированияСтроки.КодировкаURL);
М("HTTP.URL.ENUM.URL_IN_URL_DISPLAY", СпособКодированияСтроки.URLВКодировкеURL);
М("HTTP.URL.ENUM.TYPE", ТипЗнч(СпособКодированияСтроки.КодировкаURL));

М("HTTP.URL.ENCODE.URL", КодироватьСтроку(
	Исходная, СпособКодированияСтроки.КодировкаURL));
М("HTTP.URL.ENCODE.URL_IN_URL", КодироватьСтроку(
	Исходная, СпособКодированияСтроки.URLВКодировкеURL));
М("HTTP.URL.ENCODE.CYRILLIC", КодироватьСтроку(
	Кириллица, СпособКодированияСтроки.КодировкаURL));
М("HTTP.URL.DECODE.URL", РаскодироватьСтроку(
	"a+b%20c%2Fd%25", СпособКодированияСтроки.КодировкаURL));
М("HTTP.URL.DECODE.URL_IN_URL", РаскодироватьСтроку(
	"a+b%20c%2Fd%25", СпособКодированияСтроки.URLВКодировкеURL));
М("HTTP.URL.DECODE.CYRILLIC", РаскодироватьСтроку(
	"%D0%9F%D1%80%D0%B8%D0%B2%D0%B5%D1%82", СпособКодированияСтроки.КодировкаURL));

РезультатНеполногоПроцента = "<ошибка>";
Попытка
	РезультатНеполногоПроцента = РаскодироватьСтроку(
		"x%2", СпособКодированияСтроки.КодировкаURL);
Исключение
КонецПопытки;
М("HTTP.URL.DECODE.INCOMPLETE_PERCENT", РезультатНеполногоПроцента);

РезультатНегодногоUTF8 = "<ошибка>";
Попытка
	РезультатНегодногоUTF8 = РаскодироватьСтроку(
		"%FF", СпособКодированияСтроки.КодировкаURL);
Исключение
КонецПопытки;
М("HTTP.URL.DECODE.INVALID_UTF8", РезультатНегодногоUTF8);
