// Нативный контроль достигнутого перечисления расположения легенды.
Процедура ПробаЛегенды(ИдПробы, ВыражениеПробы)
 Попытка
  РезультатПробы = Строка(Вычислить(ВыражениеПробы));
 Исключение
  РезультатПробы = "error";
 КонецПопытки;
 Сообщить(ИдПробы + Символ(9) + РезультатПробы);
КонецПроцедуры
ПробаЛегенды("legend.root", "РасположениеЛегендыДиаграммы");
ПробаЛегенды("legend.type", "ТипЗнч(РасположениеЛегендыДиаграммы.Авто)");
ПробаЛегенды("legend.Auto", "РасположениеЛегендыДиаграммы.Авто");
ПробаЛегенды("legend.Bottom", "РасположениеЛегендыДиаграммы.Низ");
ПробаЛегенды("legend.Top", "РасположениеЛегендыДиаграммы.Верх");
ПробаЛегенды("legend.Left", "РасположениеЛегендыДиаграммы.Лево");
ПробаЛегенды("legend.Right", "РасположениеЛегендыДиаграммы.Право");
ПробаЛегенды("legend.None", "РасположениеЛегендыДиаграммы.Нет");
ПробаЛегенды("legend.UseCoordinates", "РасположениеЛегендыДиаграммы.УказываетсяРасположение");
Если РасположениеЛегендыДиаграммы.Авто = ChartLegendPlacement.Auto И РасположениеЛегендыДиаграммы.Низ = ChartLegendPlacement.Bottom И РасположениеЛегендыДиаграммы.Верх = ChartLegendPlacement.Top И РасположениеЛегендыДиаграммы.Лево = ChartLegendPlacement.Left И РасположениеЛегендыДиаграммы.Право = ChartLegendPlacement.Right И РасположениеЛегендыДиаграммы.Нет = ChartLegendPlacement.None И РасположениеЛегендыДиаграммы.УказываетсяРасположение = ChartLegendPlacement.UseCoordinates Тогда
 Сообщить("legend.aliases" + Символ(9) + "PASS");
Иначе
 Сообщить("legend.aliases" + Символ(9) + "FAIL");
КонецЕсли;
Если расположениелегендыдиаграммы.авто = chartlegendplacement.auto Тогда
 Сообщить("legend.folded" + Символ(9) + "PASS");
Иначе
 Сообщить("legend.folded" + Символ(9) + "FAIL");
КонецЕсли;
