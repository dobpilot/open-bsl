// Неопределённая кодировка в потоковых читателях Connector.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

ТекстовыеДанные = ПолучитьДвоичныеДанныеИзСтроки(
	"Аб", КодировкаТекста.UTF8, Ложь);
РезультатТекста = "<ошибка>";
Попытка
	ЧтениеТекста = Новый ЧтениеТекста(
		ТекстовыеДанные.ОткрытьПотокДляЧтения(), Неопределено);
	РезультатТекста = ПолучитьHexСтрокуИзДвоичныхДанных(
		ПолучитьДвоичныеДанныеИзСтроки(
			ЧтениеТекста.Прочитать(), КодировкаТекста.UTF8, Ложь));
Исключение
КонецПопытки;
М("TEXTREADER.ENCODING.UNDEFINED", РезультатТекста);

ДанныеJSON = ПолучитьДвоичныеДанныеИзСтроки(
	"{""name"":""value""}", КодировкаТекста.UTF8, Ложь);
РезультатJSON = "<ошибка>";
Попытка
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.ОткрытьПоток(
		ДанныеJSON.ОткрытьПотокДляЧтения(), Неопределено);
	ОбъектJSON = ПрочитатьJSON(ЧтениеJSON, Истина);
	РезультатJSON = ОбъектJSON.Получить("name");
Исключение
КонецПопытки;
М("JSON.READER.STREAM.UNDEFINED_ENCODING", РезультатJSON);
