// Замеры ЗАПИСИ табличного документа в PDF на 8.3.27 и ПЕРЕКРЁСТНАЯ
// проверка: платформа своим `ДокументPDF` открывает файл, собранный ЭТИМ
// интерпретатором.
//
// Скрипт исполняется обеими сторонами, и их вывод сверяется построчно:
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-pdf-write.bsl
//   cargo run -p bsl-cli -- tests/conformance/measure/measure-pdf-write.bsl \
//       > /tmp/наш.txt
//   diff /tmp/наш.txt tests/conformance/measure/measure-pdf-write.platform.txt
//
// Ингестировать этот вывод НЕЛЬЗЯ: `--ingest-measurements` всегда пишет
// `platform.tsv` рядом с указанным файлом, а рядом лежит оракул реестра
// `measure-all`. Сверка — руками, глазами и diff'ом.
//
// РАЗМЕР ФАЙЛА, КОТОРЫЙ ПИШЕТ САМА ИСПОЛНЯЮЩАЯ СТОРОНА, здесь не
// печатается нигде: платформа встраивает подмножество системного шрифта,
// мы опираемся на базовый Courier, и совпасть эти числа не обязаны.
// Печатается то, что обязано совпасть: сигнатура файла, число страниц у
// ПЕРЕКРЁСТНОГО файла (он один и тот же с обеих сторон, из шестнадцатеричной
// строки) и вся поверхность встроенного языка — написания, умолчания,
// принимаемые значения.
//
// ПРОИСХОЖДЕНИЕ ПЕРЕКРЁСТНОГО ФАЙЛА (шестнадцатеричная строка ниже, 2826
// байт, sha256 8f7a8354dc7a462e500b9479d82890017c113073cc767df4ed151d6003f11e3d).
// Собран этим интерпретатором из документа:
//
//   Д = Новый ТабличныйДокумент;
//   Д.Область(1, 1, 1, 1).Текст = "Накладная № 7";
//   Д.Область(1, 1, 1, 2).Объединить();
//   Д.Область(2, 1, 2, 1).Текст = "Гвоздь";
//   Д.Область(2, 2, 2, 2).Текст = "123.45";
//   Д.Область(1, 1, 2, 2).ВысотаСтроки = 400;
//   Д.Область(3, 1, 3, 1).Текст = "Latin 2";
//   Д.Записать(Путь, ТипФайлаТабличногоДокумента.PDF);
//
// В нём есть всё, ради чего затевалась перекрёстная проверка: кириллица в
// однобайтовой кодировке с `/Differences`, объединённая ячейка, разрыв
// страницы (две строки по 400 пунктов на A4 не помещаются) и, значит,
// дерево страниц из двух листов.
//
// РАСХОЖДЕНИЕ РОВНО ОДНО, и оно — сама цель проверки:
//
//   * «платформа читает наш PDF». У платформы есть тип `ДокументPDF`, у
//     нас его нет до отдельной задачи чтения PDF, поэтому наша сторона
//     печатает «нет типа ДокументPDF», а платформа — «страниц: 2». Это и
//     значит, что её разбор принял наш файл: нашёл заголовок, `xref`,
//     каталог и дерево из двух страниц.
//
// ЧТО ИЗМЕРЕНО ЭТИМ СКРИПТОМ, кроме перекрёстного чтения:
//
//   * поля страницы — свойства `ПолеСлева`, `ПолеСправа`, `ПолеСверху`,
//     `ПолеСнизу` типа «Число», умолчание 10 у каждого, дробные и
//     отрицательные значения принимаются как есть (-5 остаётся -5, 500
//     остаётся 500 — платформа их не поджимает);
//   * присваивание СТРОКИ полю: `"10"` кладёт число 10, `"12,7"` — 12,7
//     (разделитель дробной части — запятая), `"не число"` — ошибка;
//   * английские написания полей — только `LeftMargin` и его собратья
//     (`LeftMargin`, `RightMargin`, `TopMargin`, `BottomMargin` вернули
//     `10 10 10 10`); три правдоподобных соседа перебраны здесь же и все
//     три дали ошибку: «поле FieldLeft: ошибка», «поле MarginLeft:
//     ошибка», «поле FieldOnLeft: ошибка»;
//   * `ОриентацияСтраницы` — свойство документа, умолчание «Портрет»,
//     присваивание не-члена перечисления отвергается обеими сторонами;
//   * запись PDF пустого документа проходит и даёт файл с сигнатурой
//     `%PDF-`, а запись в несуществующий каталог — ошибка.
//
// Пять правил письма для скриптов, идущих на платформу (каждое стоило
// прогона): идентификаторы `М()`-меток буквальные, всякая проба — в
// `Попытка`, текст ЧУЖОЙ ошибки печатать нельзя, `Выполнить` в модуле
// управляемой формы не компилируется вовсе (проверено: пустой вывод и
// таймаут), а короткое имя вроде `Ширина` присвоится САМОЙ ФОРМЕ.

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

// Байты из шестнадцатеричной строки в файл — тем же способом, что в
// `measure-zip-write.bsl`: другого способа положить заранее известные
// байты на диск у обеих сторон нет.
Функция Материализовать(Путь, Шестнадцатеричный)
	Буфер = Новый БуферДвоичныхДанных(СтрДлина(Шестнадцатеричный) / 2);
	Для Сч = 0 По Буфер.Размер - 1 Цикл
		Буфер[Сч] = ЧислоИзШестнадцатеричнойСтроки("0x" + Сред(Шестнадцатеричный, Сч * 2 + 1, 2));
	КонецЦикла;
	Поток = ФайловыеПотоки.Создать(Путь);
	Поток.Записать(Буфер, 0, Буфер.Размер);
	Поток.Закрыть();
	Возврат Путь;
КонецФункции

// Первые пять байтов файла строкой: сигнатура PDF обязана совпасть у
// обеих сторон, а вот размер файла — нет.
Функция Сигнатура(Путь)
	Попытка
		Буфер = Новый БуферДвоичныхДанных(5);
		Поток = ФайловыеПотоки.ОткрытьДляЧтения(Путь);
		Поток.Прочитать(Буфер, 0, 5);
		Поток.Закрыть();
		Итог = "";
		Для Сч = 0 По 4 Цикл
			Итог = Итог + Символ(Буфер[Сч]);
		КонецЦикла;
		Возврат Итог;
	Исключение
		Возврат "<нет файла>";
	КонецПопытки;
КонецФункции

// Документ, который пишет в PDF каждая сторона СВОИМ писателем.
Функция СобратьДокумент()
	Док = Новый ТабличныйДокумент;
	Док.Область(1, 1, 1, 1).Текст = "Накладная № 7";
	Док.Область(2, 1, 2, 1).Текст = "Гвоздь строительный";
	Док.Область(2, 2, 2, 2).Текст = "123.45";
	Возврат Док;
КонецФункции

