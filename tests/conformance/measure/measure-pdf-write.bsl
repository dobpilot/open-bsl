// --- 5. Перекрёстная проверка: платформа читает НАШ файл ----------------

ПутьПерекрёстный = Материализовать("/tmp/open-bsl-pdfx-перекрёстный.pdf", ШестнПДФ);
ДанныеПерекрёстные = Новый ДвоичныеДанные(ПутьПерекрёстный);
П("перекрёстный размер", Ч(ДанныеПерекрёстные.Размер()));
П("перекрёстный сигнатура", Сигнатура(ПутьПерекрёстный));

Попытка
	ЧитательPDF = Вычислить("Новый ДокументPDF");
Исключение
	ЧитательPDF = Неопределено;
КонецПопытки;

Если ЧитательPDF = Неопределено Тогда
	П("платформа читает наш PDF", "нет типа ДокументPDF");
Иначе
	Попытка
		ЧитательPDF.Прочитать(ПутьПерекрёстный);
		П("платформа читает наш PDF", "страниц: " + Ч(ЧитательPDF.Страницы.Количество()));
	Исключение
		П("платформа читает наш PDF", "ошибка чтения");
	КонецПопытки;
КонецЕсли;
