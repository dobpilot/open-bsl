// Контракт глобальных преобразований Base64 и hex, нужных Connector.
// Этот сценарий запускается на платформе и в open-bsl; результаты должны
// совпадать построчно.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Данные = Base64Значение("AQID/w==");
М("BASE64.DECODE", ПолучитьHexСтрокуИзДвоичныхДанных(Данные));
М("BASE64.ENCODE", ПолучитьBase64СтрокуИзДвоичныхДанных(Данные));
М("BASE64.EMPTY.SIZE", Base64Значение("").Размер());
М("BASE64.WHITESPACE", ПолучитьHexСтрокуИзДвоичныхДанных(Base64Значение("AQID" + Символ(10) + "/w==")));
М("BASE64.ALIAS", ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзBase64Строки("AQID/w==")));

РезультатПлохогоДополнения = "ошибка";
Попытка
	РезультатПлохогоДополнения = ТипЗнч(Base64Значение("Zg="));
Исключение
КонецПопытки;
М("BASE64.BAD_PADDING", РезультатПлохогоДополнения);

РезультатПлохогоСимвола = "ошибка";
Попытка
	РезультатПлохогоСимвола = ТипЗнч(Base64Значение("Zm$v"));
Исключение
КонецПопытки;
М("BASE64.BAD_CHARACTER", РезультатПлохогоСимвола);

РезультатПлохогоАлиаса = "ошибка";
Попытка
	РезультатПлохогоАлиаса = ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзBase64Строки("Zm$v"));
Исключение
КонецПопытки;
М("BASE64.ALIAS.BAD_CHARACTER", РезультатПлохогоАлиаса);

РезультатПлохогоДополненияАлиаса = "ошибка";
Попытка
	РезультатПлохогоДополненияАлиаса = ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзBase64Строки("Zg="));
Исключение
КонецПопытки;
М("BASE64.ALIAS.BAD_PADDING", РезультатПлохогоДополненияАлиаса);
