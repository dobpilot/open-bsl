// Форма и часовой пояс `ТекущаяУниверсальнаяДата`, используемой Connector.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция БулевоСтрокой(Значение)
	Возврат ?(Значение, "true", "false");
КонецФункции

Функция Выполняется(Код)
	Попытка
		Выполнить(Код);
		Возврат "true";
	Исключение
		Возврат "false";
	КонецПопытки;
КонецФункции

Универсальная = ТекущаяУниверсальнаяДата();
М("DATE.UNIVERSAL.TYPE", БулевоСтрокой(ТипЗнч(Универсальная) = Тип("Дата")));
М("DATE.UNIVERSAL.LOCAL_OFFSET", ТекущаяДата() - Универсальная);
М("DATE.UNIVERSAL.AS_STATEMENT", Выполняется("ТекущаяУниверсальнаяДата();"));
М("DATE.UNIVERSAL.ENGLISH_ALIAS", Выполняется("Результат = CurrentUniversalDate();"));
