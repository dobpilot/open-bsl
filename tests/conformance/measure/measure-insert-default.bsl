// Одноместный `Вставить`, который Connector использует для структуры cookie.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция БулевоСтрокой(Значение)
	Возврат ?(Значение, "true", "false");
КонецФункции

Структура = Новый Структура;
Структура.Вставить("x");
М("COLLECTION.INSERT.STRUCTURE.DEFAULT", БулевоСтрокой(Структура.x = Неопределено));
Соответствие = Новый Соответствие;
Соответствие.Вставить("x");
М("COLLECTION.INSERT.MAP.DEFAULT", БулевоСтрокой(Соответствие.Получить("x") = Неопределено));
