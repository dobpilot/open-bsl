// Контракт: КАКОЕ смещение платформа приписывает местному времени рядом с
// переходом часового пояса.
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-zone.bsl
//
// Правила те же, что у соседних контрактов: строка `МЕТКА<таб>ЗНАЧЕНИЕ`,
// скрипт исполняется И НАШИМ интерпретатором, сличение построчное. Строк
// `М()` здесь нет: реестру этот файл ничего не должен.
//
// ЗАЧЕМ. `ЗаписатьДатуJSON(..., ЛокальнаяДатаСоСмещением)` получает
// МЕСТНОЕ время и должен назвать смещение, действовавшее в этот момент. У
// зоны смещение зависит от МОМЕНТА, а момент из местного времени как раз и
// получается вычитанием смещения — круг. Наша реализация разрывает его,
// толкуя местные секунды как секунды UTC; вокруг перехода это может дать
// не ту сторону. Спрашиваем платформу.
//
// ПОЧЕМУ ИМЕННО ЭТИ ДАТЫ. Машина замеров живёт в Europe/Moscow, где
// переходы кончились в 2014-м, но в истории они есть: 31.10.2010 стрелки
// шли с +04 назад на +03 (час 02:00–02:59 местного времени прожит ДВАЖДЫ),
// а 27.03.2011 — вперёд с +03 на +04 в последний раз, после чего зона
// осталась +04 до 26.10.2014. Даты вокруг этих трёх точек и спрашиваем.

Функция Смещение(Год, Месяц, День, Час, Минута)
	Д = Дата(Год, Месяц, День, Час, Минута, 0);
	Возврат ЗаписатьДатуJSON(Д, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДатаСоСмещением);
КонецФункции

Процедура П(Метка, Значение)
	Сообщить(Метка + Символ(9) + Значение);
КонецПроцедуры

// Заведомо однозначные точки — контроль пробы.
П("2010 лето", Смещение(2010, 7, 1, 12, 0));
П("2010 зима", Смещение(2010, 12, 1, 12, 0));
П("2012 зима", Смещение(2012, 12, 1, 12, 0));
П("2016 зима", Смещение(2016, 12, 1, 12, 0));

// Осенний переход 31.10.2010: 02:00 местного времени наступало дважды.
П("осень до", Смещение(2010, 10, 31, 1, 30));
П("осень в час перевода", Смещение(2010, 10, 31, 2, 30));
П("осень после", Смещение(2010, 10, 31, 3, 30));

// Весенний переход 27.03.2011: часа 02:00–02:59 местного времени не было.
П("весна до", Смещение(2011, 3, 27, 1, 30));
П("весна в пропущенный час", Смещение(2011, 3, 27, 2, 30));
П("весна после", Смещение(2011, 3, 27, 3, 30));

// Переход 26.10.2014 без перевода стрелок назад в привычном смысле:
// зона сменилась с +04 на +03 разово.
П("2014 до смены", Смещение(2014, 10, 26, 0, 30));
П("2014 после смены", Смещение(2014, 10, 26, 3, 30));
