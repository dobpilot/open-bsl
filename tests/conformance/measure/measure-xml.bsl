// =====================================================================
// ЧТЕНИЕ: последовательность узлов
// =====================================================================
//
// Дамп документа: на каждом узле — тип, имя и значение. Имя и значение
// берутся под `Попытка`: на каком-то типе узла обращение может быть
// недопустимо, и это тоже измеряемый факт.

Функция Дамп(Текст)
	Р = "";
	Попытка
		Ч = Новый ЧтениеXML;
		Ч.УстановитьСтроку(Текст);
		Пока Ч.Прочитать() Цикл
			Т = Строка(Ч.ТипУзла);
			ИмяУзла = "<ошибка>";
			Попытка
				ИмяУзла = Ч.Имя;
			Исключение
			КонецПопытки;
			З = "<ошибка>";
			Попытка
				З = Ч.Значение;
			Исключение
			КонецПопытки;
			Р = Р + Разделитель(Р) + Т + " имя=[" + ИмяУзла + "] знач=[" + З + "]";
		КонецЦикла;
		Ч.Закрыть();
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат Р;
КонецФункции

М("XML.READ.SIMPLE", Дамп("<к>текст</к>"));
М("XML.READ.NESTED", Дамп("<а><б>1</б><в>2</в></а>"));
М("XML.READ.EMPTY_ELEMENT", Дамп("<а/>"));
М("XML.READ.EMPTY_PAIR", Дамп("<а></а>"));
М("XML.READ.ATTRS", Дамп("<а х=""1"" у=""два"">т</а>"));
М("XML.READ.DECLARATION", Дамп("<?xml version=""1.0"" encoding=""UTF-8""?><а/>"));
М("XML.READ.COMMENT", Дамп("<а><!-- сюда --></а>"));
М("XML.READ.CDATA", Дамп("<а><![CDATA[<не разметка>]]></а>"));
М("XML.READ.PI", Дамп("<а><?целевой данные?></а>"));
М("XML.READ.ENTITIES", Дамп("<а>&amp;&lt;&gt;&quot;&apos;</а>"));
М("XML.READ.CHAR_REF", Дамп("<а>&#65;&#x42;</а>"));
М("XML.READ.WHITESPACE_BETWEEN", Дамп("<а>  <б/>  </а>"));
М("XML.READ.WHITESPACE_ONLY_TEXT", Дамп("<а> </а>"));
М("XML.READ.NEWLINE_BETWEEN", Дамп("<а>" + Символ(10) + "  <б/>" + Символ(10) + "</а>"));
М("XML.READ.NAMESPACE", Дамп("<п:а xmlns:п=""http://прим"">т</п:а>"));
М("XML.READ.TEXT_SPLIT_BY_COMMENT", Дамп("<а>раз<!--к-->два</а>"));
М("XML.READ.CYRILLIC", Дамп("<тег>значение</тег>"));

// Битый ввод: платформа либо ловит, либо молчит — что именно, измеряем.
М("XML.READ.UNCLOSED", Дамп("<а><б></а>"));
М("XML.READ.GARBAGE", Дамп("не разметка"));
М("XML.READ.EMPTY_STRING", Дамп(""));
М("XML.READ.TWO_ROOTS", Дамп("<а/><б/>"));

// =====================================================================
// ЧТЕНИЕ: имя, локальное имя, префикс, пространство имён
// =====================================================================

Функция ПерваяЧастиИмени(Текст)
	Р = "";
	Попытка
		Ч = Новый ЧтениеXML;
		Ч.УстановитьСтроку(Текст);
		Ч.Прочитать();
		Р = "имя=[" + Ч.Имя + "]";
		Попытка
			Р = Р + " локальное=[" + Ч.ЛокальноеИмя + "]";
		Исключение
			Р = Р + " локальное=<ошибка>";
		КонецПопытки;
		Попытка
			Р = Р + " префикс=[" + Ч.Префикс + "]";
		Исключение
			Р = Р + " префикс=<ошибка>";
		КонецПопытки;
		Попытка
			Р = Р + " ури=[" + Ч.URIПространстваИмен + "]";
		Исключение
			Р = Р + " ури=<ошибка>";
		КонецПопытки;
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат Р;
КонецФункции

М("XML.READ.NAME_PARTS_PLAIN", ПерваяЧастиИмени("<а>т</а>"));
М("XML.READ.NAME_PARTS_NS", ПерваяЧастиИмени("<п:а xmlns:п=""http://прим"">т</п:а>"));

