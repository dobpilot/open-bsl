Функция Атрибуты(Текст)
	Р = "";
	Попытка
		Ч = Новый ЧтениеXML;
		Ч.УстановитьСтроку(Текст);
		Ч.Прочитать();
		Попытка
			Р = "количество=" + Строка(Ч.КоличествоАтрибутов());
		Исключение
			Р = "количество=<ошибка>";
		КонецПопытки;
		Попытка
			Р = Р + " имя0=[" + Строка(Ч.ИмяАтрибута(0)) + "]";
		Исключение
			Р = Р + " имя0=<ошибка>";
		КонецПопытки;
		Попытка
			Р = Р + " знач0=[" + Строка(Ч.ЗначениеАтрибута(0)) + "]";
		Исключение
			Р = Р + " знач0=<ошибка>";
		КонецПопытки;
		Попытка
			Р = Р + " поимени=[" + Строка(Ч.ЗначениеАтрибута("х")) + "]";
		Исключение
			Р = Р + " поимени=<ошибка>";
		КонецПопытки;
		Попытка
			Р = Р + " нет=[" + Строка(Ч.ЗначениеАтрибута("нету")) + "]";
		Исключение
			Р = Р + " нет=<ошибка>";
		КонецПопытки;
		Попытка
			Р = Р + " типнет=" + Строка(ТипЗнч(Ч.ЗначениеАтрибута("нету")));
		Исключение
			Р = Р + " типнет=<ошибка>";
		КонецПопытки;
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат Р;
КонецФункции

М("XML.READ.ATTR_ACCESS", Атрибуты("<а х=""1"" у=""два""/>"));
М("XML.READ.ATTR_NONE", Атрибуты("<а/>"));
М("XML.READ.ATTR_ESCAPED", Атрибуты("<а х=""&amp;&lt;&quot;""/>"));

// Обход атрибутов курсором.
Функция ОбходАтрибутов(Текст)
	Р = "";
	Попытка
		Ч = Новый ЧтениеXML;
		Ч.УстановитьСтроку(Текст);
		Ч.Прочитать();
		Пока Ч.ПрочитатьАтрибут() Цикл
			Р = Р + Разделитель(Р) + Строка(Ч.ТипУзла) + " [" + Ч.Имя + "]=[" + Ч.Значение + "]";
		КонецЦикла;
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат Р;
КонецФункции

М("XML.READ.ATTR_CURSOR", ОбходАтрибутов("<а х=""1"" у=""два""/>"));

// Пропуск поддерева.
Функция Пропуск(Текст)
	Р = "";
	Попытка
		Ч = Новый ЧтениеXML;
		Ч.УстановитьСтроку(Текст);
		Ч.Прочитать();
		Ч.Прочитать();
		Ч.Пропустить();
		Р = "после=" + Строка(Ч.ТипУзла) + " имя=[" + Ч.Имя + "]";
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат Р;
КонецФункции

М("XML.READ.SKIP", Пропуск("<а><б><в>1</в></б><г/></а>"));

