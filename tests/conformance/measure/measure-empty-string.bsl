Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Значение);
КонецПроцедуры

Функция РезультатПустойСтроки(Значение)
	Попытка
		Если ПустаяСтрока(Значение) Тогда
			Возврат "true";
		Иначе
			Возврат "false";
		КонецЕсли;
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

М("EMPTYSTRING.EMPTY", РезультатПустойСтроки(""));
М("EMPTYSTRING.SPACES", РезультатПустойСтроки("   "));
М("EMPTYSTRING.TAB", РезультатПустойСтроки(Символ(9)));
М("EMPTYSTRING.LF", РезультатПустойСтроки(Символ(10)));
М("EMPTYSTRING.CRLF", РезультатПустойСтроки(Символ(13) + Символ(10)));
М("EMPTYSTRING.NBSP", РезультатПустойСтроки(Символ(160)));
М("EMPTYSTRING.TEXT", РезультатПустойСтроки(" а "));
М("EMPTYSTRING.UNDEFINED", РезультатПустойСтроки(Неопределено));
М("EMPTYSTRING.NUMBER", РезультатПустойСтроки(0));
М("EMPTYSTRING.BOOLEAN", РезультатПустойСтроки(Ложь));

Результат = "error";
Попытка
	Если IsBlankString("") Тогда
		Результат = "true";
	Иначе
		Результат = "false";
	КонецЕсли;
Исключение
КонецПопытки;
М("EMPTYSTRING.ENGLISH_ALIAS", Результат);
