// Локальные свойства HTTPЗапрос: сеть для этих проб не требуется.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Запрос = Новый HTTPЗапрос("/ресурс?а=1");
М("HTTP.REQUEST.RESOURCE", Запрос.АдресРесурса);
М("HTTP.REQUEST.HEADERS.TYPE", ТипЗнч(Запрос.Заголовки));

Заголовки = Новый Соответствие;
Заголовки.Вставить("X-One", "1");
Запрос.Заголовки = Заголовки;
Заголовки.Вставить("X-Two", "2");
М("HTTP.REQUEST.HEADERS.ALIAS", Запрос.Заголовки.Получить("X-Two"));

Запрос.УстановитьТелоИзСтроки("Аб");
М("HTTP.BODY.STRING.DEFAULT", ПолучитьHexСтрокуИзДвоичныхДанных(Запрос.ПолучитьТелоКакДвоичныеДанные()));
М("HTTP.BODY.AS_STRING.DEFAULT", Запрос.ПолучитьТелоКакСтроку());
Запрос.УстановитьТелоИзСтроки("Аб", КодировкаТекста.UTF8, ИспользованиеByteOrderMark.Использовать);
М("HTTP.BODY.STRING.UTF8_BOM", ПолучитьHexСтрокуИзДвоичныхДанных(Запрос.ПолучитьТелоКакДвоичныеДанные()));
М("HTTP.BODY.AS_STRING.BOM", Запрос.ПолучитьТелоКакСтроку());
Запрос.УстановитьТелоИзСтроки("Аб", КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
М("HTTP.BODY.STRING.UTF8_NO_BOM", ПолучитьHexСтрокуИзДвоичныхДанных(Запрос.ПолучитьТелоКакДвоичныеДанные()));

Запрос.УстановитьТелоИзДвоичныхДанных(Base64Значение("AQID"));
М("HTTP.BODY.BINARY", ПолучитьHexСтрокуИзДвоичныхДанных(Запрос.ПолучитьТелоКакДвоичныеДанные()));

ПотоковыйЗапрос = Новый HTTPЗапрос;
Запись = Новый ЗаписьДанных(ПотоковыйЗапрос.ПолучитьТелоКакПоток(), КодировкаТекста.UTF8);
Запись.ЗаписатьСтроку("Аб");
Запись.Закрыть();
М("HTTP.BODY.AS_STRING.STREAM", ПотоковыйЗапрос.ПолучитьТелоКакСтроку());
М("HTTP.BOM.ENUM", Строка(ИспользованиеByteOrderMark.Использовать) + "|" + Строка(ИспользованиеByteOrderMark.НеИспользовать));
М("HTTP.BOM.TYPE", ТипЗнч(ИспользованиеByteOrderMark.Использовать));
