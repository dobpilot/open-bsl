// Строковая кодировка ASCII из ручной GZIP-ветки Connector.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция HexСтроки(Текст, Кодировка)
	Данные = ПолучитьДвоичныеДанныеИзСтроки(Текст, Кодировка, Ложь);
	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Данные);
КонецФункции

Процедура П(Ид, Текст, Кодировка)
	Результат = "<ошибка>";
	Попытка
		Результат = HexСтроки(Текст, Кодировка);
	Исключение
	КонецПопытки;
	М(Ид, Результат);
КонецПроцедуры

П("ENC.ASCII.NAME", "Ab", "ascii");
П("ENC.US_ASCII.NAME", "Ab", "US-ASCII");
П("ENC.ASCII.UNMAPPABLE", "Аб", "ascii");

Буфер = Новый БуферДвоичныхДанных(2);
Буфер.Установить(0, 65);
Буфер.Установить(1, 128);
РезультатДекодирования = "<ошибка>";
Попытка
	СтрокаASCII = ПолучитьСтрокуИзБуфераДвоичныхДанных(Буфер, "ascii");
	РезультатДекодирования = КодСимвола(СтрокаASCII, 1) + "," + КодСимвола(СтрокаASCII, 2);
Исключение
КонецПопытки;
М("ENC.ASCII.DECODE.CODES", РезультатДекодирования);
