// Контракт конструкций, которые движок до перехода на fancy-regex честно
// отвергал, а платформа понимает: просмотры вперёд и назад, обратные
// ссылки, `(?s)`, флаговые группы с снятием, притяжательные кванторы,
// атомарные группы и операции над множествами в классе.
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-regex2.bsl
//
// Правила те же, что у `measure-regex.bsl`: строка `МЕТКА<таб>ЗНАЧЕНИЕ`,
// скрипт исполняется И НАШИМ интерпретатором, сличение построчное; до
// реализации этих конструкций наша сторона печатает `<ошибка>` — это
// ожидаемое начальное состояние, а не поломка. Строк `М()` здесь нет:
// якоря области заведены в `measure-all.bsl`, правило реестра — ровно одна
// строка на ИД по всем скриптам каталога. `.expected` у файла нет и быть
// не должно: контракт сличается с `measure-regex2.platform.txt`. После
// реализации пяти семейств расходятся РОВНО три строки последней секции —
// `(?#…)`, `\Q…\E` и `(?x)` остаются честными отказами до своего захода.
//
// `Попытка` внутри хелперов накрывает каждую пробу целиком: битый шаблон
// платформа отдаёт исключением, а необработанное исключение в модуле
// формы — модальное окно, пустой вывод и таймаут всего сеанса.

Процедура П(Метка, Значение)
	Сообщить(Метка + Символ(9) + Значение);
КонецПроцедуры

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

// Да/Нет/<ошибка> для частичного поиска.
Функция Совпало(Субъект, Шаблон)
	Ответ = "<ошибка>";
	Попытка
		Найдено = СтрНайтиПоРегулярномуВыражению(Субъект, Шаблон);
		Если Найдено.НачальнаяПозиция = 0 Тогда
			Ответ = "Нет";
		Иначе
			Ответ = "Да";
		КонецЕсли;
	Исключение
		Ответ = "<ошибка>";
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// Число непересекающихся совпадений.
Функция Сколько(Субъект, Шаблон)
	Ответ = "<ошибка>";
	Попытка
		Все = СтрНайтиВсеПоРегулярномуВыражению(Субъект, Шаблон);
		Ответ = Ч(Все.Количество());
	Исключение
		Ответ = "<ошибка>";
	КонецПопытки;
	Возврат Ответ;
КонецФункции

Функция Тр(Промежуток)
	Возврат "[" + Промежуток.Значение + "|" + Ч(Промежуток.НачальнаяПозиция)
		+ "|" + Ч(Промежуток.Длина) + "]";
КонецФункции

// Всё совпадение и группа с данным индексом (нулевой группы в массиве
// `ПолучитьГруппы()` нет — первая группа шаблона лежит по индексу 0).
Функция ВсёИГруппаН(Субъект, Шаблон, Индекс)
	Ответ = "<ошибка>";
	Попытка
		Найдено = СтрНайтиПоРегулярномуВыражению(Субъект, Шаблон);
		Если Найдено.НачальнаяПозиция = 0 Тогда
			Ответ = "<нет совпадения>";
		Иначе
			Ответ = Тр(Найдено) + Тр(Найдено.ПолучитьГруппы()[Индекс]);
		КонецЕсли;
	Исключение
		Ответ = "<ошибка>";
	КонецПопытки;
	Возврат Ответ;
КонецФункции

Функция ВсёИГруппа(Субъект, Шаблон)
	Возврат ВсёИГруппаН(Субъект, Шаблон, 0);
КонецФункции

ВертТабуляция = Символ(11);
ПереводФормата = Символ(12);
НЕЛ = Символ(133);
РазделительСтрок = Символ(8232);
РазделительАбзацев = Символ(8233);
ВК = Символ(13);
ПС = Символ(10);

// --- просмотр вперёд ----------------------------------------------------
// Первая пара — контроль: если просмотр не понят вовсе, обе отвечают
// одинаково. Захват в просмотре и его видимость снаружи — отдельный
// вопрос: движки расходятся, участвует ли группа из несъеденного текста.

П("просмотр вперёд", Совпало("аб", "а(?=б)"));
П("просмотр вперёд промах", Совпало("ав", "а(?=б)"));
П("просмотр не ест", ВсёИГруппа("аб", "(а(?=б))"));
П("отрицательный просмотр", Совпало("ав", "а(?!б)"));
П("отрицательный просмотр промах", Совпало("аб", "а(?!б)"));
П("захват в просмотре", ВсёИГруппа("аб", "а(?=(б))"));
П("захват в отрицательном просмотре", ВсёИГруппа("а", "(?!(б))а"));
П("квантор на просмотр", Совпало("а", "а(?=б)?"));

// --- просмотр назад -----------------------------------------------------
// Переменная длина — ключевой вопрос: ICU исторически требует у просмотра
// назад ограниченной длины, и от ответа зависит, что должен принимать
// парсер.

П("просмотр назад", Совпало("аб", "(?<=а)б"));
П("просмотр назад промах", Совпало("хб", "(?<=а)б"));
П("отрицательный просмотр назад", Совпало("хб", "(?<!а)б"));
П("назад переменной длины", Совпало("аааб", "(?<=а+)б"));
П("назад ограниченный диапазон", Совпало("аааб", "(?<=а{1,3})б"));
П("назад звезда", Совпало("б", "(?<=а*)б"));
П("назад альтернатива разной длины", Совпало("ааб", "(?<=а|аа)б"));
П("захват в просмотре назад", ВсёИГруппа("аб", "(?<=(а))б"));
П("назад с границей слова", Совпало("аб", "(?<=\bа)б"));

// --- обратные ссылки ----------------------------------------------------
// Ссылка на неучаствовавшую группу разделяет диалекты: PCRE проваливает
// совпадение, ECMAScript подставляет пустоту.

П("ссылка", Совпало("аа", "(а)\1"));
П("ссылка промах", Совпало("аб", "(а)\1"));
П("ссылка со свёрткой", Совпало("аА", "(?i)(а)\1"));
П("ссылка без свёртки", Совпало("аА", "(а)\1"));
П("ссылка на неучаствовавшую", Совпало("а", "(б)?а\1"));
П("ссылка на пустую", Совпало("а", "(б?)а\1"));
П("ссылка в кванторе", ВсёИГруппаН("баа", "((а)|б)+\2", 1));
П("ссылка вперёд", Совпало("аа", "\1(а)"));

// --- `(?s)` и точка -----------------------------------------------------
// Без `(?s)` точка не берёт ни один из семи терминаторов UTS#18; вопрос —
// берёт ли под `(?s)` каждый из них.

П("дотолл ПС", Совпало("а" + ПС + "б", "(?s)а.б"));
П("дотолл ВК", Совпало("а" + ВК + "б", "(?s)а.б"));
П("дотолл вертикальная табуляция", Совпало("а" + ВертТабуляция + "б", "(?s)а.б"));
П("дотолл перевод формата", Совпало("а" + ПереводФормата + "б", "(?s)а.б"));
П("дотолл НЕЛ", Совпало("а" + НЕЛ + "б", "(?s)а.б"));
П("дотолл разделитель строк", Совпало("а" + РазделительСтрок + "б", "(?s)а.б"));
П("дотолл разделитель абзацев", Совпало("а" + РазделительАбзацев + "б", "(?s)а.б"));
П("дотолл группой", Совпало("а" + ПС + "б", "а(?s:.)б"));
П("дотолл кончается с группой", Совпало("а" + ПС + "б" + ПС + "в", "а(?s:.)б.в"));
П("дотолл снятие", Совпало("а" + ПС + "б", "(?s)а(?-s:.)б"));

// --- флаговые группы и снятие флага -------------------------------------

П("флаг группой", Совпало("Аб", "(?i:а)б"));
П("флаг группой не наружу", Совпало("АБ", "(?i:а)б"));
П("снятие флага группой", Совпало("Аб", "(?i)а(?-i:б)"));
П("снятие флага группой регистр", Совпало("АБ", "(?i)а(?-i:б)"));
П("снятие флага без группы", Совпало("АБ", "(?i)а(?-i)б"));
П("многострочный группой", Сколько("а" + ПС + "б", "(?m:^)"));
П("многострочный группой не наружу", Сколько("а" + ПС + "б", "(?m:а)^б"));

// --- притяжательные кванторы и атомарные группы -------------------------
// Притяжательный квантор не отдаёт назад: `а*+а` не совпадает нигде.

П("притяжательная звезда", Совпало("аа", "а*+а"));
П("притяжательный плюс", Совпало("аа", "а++а"));
П("притяжательный вопрос", Совпало("а", "а?+а"));
П("притяжательный диапазон", Совпало("ааа", "а{1,2}+а"));
П("атомарная группа", Совпало("абв", "(?>а|аб)в"));
П("атомарная прозрачная", Совпало("аб", "(?>а)б"));
П("квантор на атомарную", Совпало("аб", "(?>а)+б"));

// --- операции над множествами в классе ----------------------------------

П("пересечение", Совпало("в", "[а-в&&[^б]]"));
П("пересечение вычитает", Совпало("б", "[а-в&&[^б]]"));
П("пересечение диапазонов", Совпало("б", "[а-в&&б-г]"));
П("вложенный класс", Совпало("в", "[[аб]в]"));
П("вложенное отрицание", Совпало("х", "[[^аб]]"));
П("разность", Совпало("а", "[а-я-[б]]"));
П("разность вычитает", Совпало("б", "[а-я-[б]]"));
П("пересечение со свёрткой", Совпало("Б", "(?i)[а-в&&[^б]]"));
П("амперсанд в классе", Совпало("&", "[а&]"));

// --- то, что пока остаётся за бортом ------------------------------------
// Ответы нужны каталогу отказов: что платформа сама отвергает, то и у нас
// остаётся честной ошибкой, а что понимает — кандидат следующего захода.

П("именованная группа", ВсёИГруппа("аб", "(?<имя>а)б"));
П("комментарий в шаблоне", Совпало("аб", "а(?#х)б"));
П("цитирование", Совпало("а.б", "а\Q.\Eб"));
П("флаг икс", Совпало("аб", "(?x)а б"));
