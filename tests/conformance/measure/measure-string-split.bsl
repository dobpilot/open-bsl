// Трёхместная форма `СтрРазделить`, которую использует Connector 2.6.0.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("STRING.SPLIT.DEFAULT", СтрСоединить(СтрРазделить("a,,b,", ","), "|"));
М("STRING.SPLIT.INCLUDE_EMPTY", СтрСоединить(СтрРазделить("a,,b,", ",", Истина), "|"));
М("STRING.SPLIT.SKIP_EMPTY", СтрСоединить(СтрРазделить("a,,b,", ",", Ложь), "|"));
