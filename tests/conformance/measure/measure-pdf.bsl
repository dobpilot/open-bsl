	Вставка = "есть: вложений " + Ч(Вставляем.Вложения.Количество())
		+ ", [0] " + Вставляем.Вложения[0].ИмяФайла;
Исключение
	Вставка = "нет";
КонецПопытки;

М("PDF.ATTACH_INSERT", Вставка);

