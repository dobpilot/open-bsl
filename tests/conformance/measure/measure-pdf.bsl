// Сводный замер ЧЕТЫРЁХ последних PDF-неизвестных на 8.3.27 — тех, что
// прежние задачи назвали вслух, но померить не успели: экраны в имени
// вложения, имя не в UTF-8, `Вставить` у коллекции вложений и текст
// ошибки на несуществующих членах подписи. Открытых вопросов `PDF.*` в
// реестре нет и не было; после этого прогона каждая из четырёх строк
// стала якорем в `MEASURED_ANCHORS`.
//
// Скрипт исполняется обеими сторонами, и их вывод сверяется построчно:
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-pdf.bsl
//   cargo run -p bsl-cli -- tests/conformance/measure/measure-pdf.bsl \
//       | diff - tests/conformance/measure/measure-pdf.platform.txt
//
// Ингестировать этот вывод НЕЛЬЗЯ: `--ingest-measurements` всегда пишет
// `platform.tsv` рядом с указанным файлом, а рядом лежит оракул реестра
// `measure-all`. Сверка — руками и diff'ом.
//
// РАСХОЖДЕНИЕ РОВНО ОДНО — одна причина, одна строка `<`:
//
//   * `PDF.SIGN_MEMBER_ERROR`. Здесь печатается ТЕКСТ ошибки платформы,
//     а достать его можно только через `ОписаниеОшибки()`, которой у нас
//     нет ни как встроенной функции, ни как чего-либо ещё. Поэтому проба
//     обёрнута в `Выполнить`: у платформы фрагмент компилируется и
//     отдаёт текст, у нас не компилируется вовсе, `Выполнить` бросает,
//     и внешняя `Попытка` печатает `<нет ОписаниеОшибки>`. Расхождение
//     намеренное: измеряется чужой текст, а не наш.
//
// ЧТО ИЗМЕРЕНО (полные ответы — в `.platform.txt` рядом):
//
//   * `PDF.ATTACH_STR_ESCAPES_READ` — три экрана `\\`, `\(` и `\)`
//     читатель имён СНИМАЕТ. Это не то же самое, что восьмеричные `\ooo`
//     и шестнадцатеричная форма `<...>`, которые платформа отдаёт
//     текстом как есть (пробы «имя 0» и «имя 1» в
//     `measure-pdf-attachments.bsl`). Проба двойная, потому что одного
//     кругового прогона мало: он доказывает лишь, что писатель и
//     читатель ОДНОЙ стороны согласованы, а вопрос — про читатель. Отсюда
//     `ШестнЭкраны`: собранный руками `/F (a\(b\)c\\d.txt)`, на который
//     обе стороны отвечают «a(b)c\d.txt». Круговой прогон рядом отвечает
//     на прикладную половину вопроса — вложение с именем «па(ра)\кет.txt»
//     переживает запись и чтение целым;
//   * `PDF.ATTACH_NAME_NON_UTF8` — байты имени не в UTF-8 платформа НЕ
//     перекодирует. `ШестнCP1251` кладёт в `/F` имя «файл.txt» в cp1251
//     (F4 E0 E9 EB 2E 74 78 74), и возвращаются четыре знака замены
//     U+FFFD плюс целый хвост «.txt» — по одному знаку замены на негодный
//     байт, ровно как у `from_utf8_lossy`. Правки в `pdf.rs` замер не
//     потребовал. Имя печатается КОДАМИ знаков: сырая печать чего угодно
//     порвала бы построчную сверку;
//   * `PDF.ATTACH_INSERT` — `Вставить` у коллекции вложений НЕТ.
//     Пополнять её можно только `Добавить`, то есть порядок вложений
//     прикладным кодом не задаётся;
//   * `PDF.SIGN_MEMBER_ERROR` — несуществующие члены платформа разводит
//     по роду: свойство даёт «Поле объекта не обнаружено (Имя)», метод —
//     «Метод объекта не обнаружен (Имя)». Заодно это подтверждает, что
//     электронных подписей у «ДокументPDF» в 8.3.27 нет вовсе: в
//     `measure-pdf-attachments.bsl` все шесть написаний ответили «нет»,
//     и теперь видно, что отказ приходит именно от ненайденного члена.
//
// ПРАВИЛА ПИСЬМА, из-за которых скрипт выглядит именно так (полный
// список — в шапках `measure-pdf-read.bsl` и AGENTS.md): каждая проба
// заворачивается в `Попытка` и печатается ОДНОЙ строкой `М()` на ИД —
// реестровый тест требует ровно одну строку на идентификатор во всех
// скриптах замеров вместе взятых, поэтому обе половины первой пробы и
// оба рода члена в четвёртой сведены в одну строку. Отсутствующий метод
// (`Вставить`) вызывается через `Выполнить`, а не напрямую: прямой вызов
// — ошибка КОМПИЛЯЦИИ модуля, то есть немой таймаут на 180 секунд вместо
// одной строки вывода. Текст ошибки нормализуется `Кратко()`: платформа
// предваряет описание фигурными скобками с местом возникновения, а место
// у двух сторон разное по определению.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

// Байты из шестнадцатеричной строки в файл — тем же способом, что в
// `measure-pdf-read.bsl` и `measure-pdf-attachments.bsl`.
Функция Материализовать(Путь, Шестнадцатеричный)
	Буфер = Новый БуферДвоичныхДанных(СтрДлина(Шестнадцатеричный) / 2);
	Для Сч = 0 По Буфер.Размер - 1 Цикл
		Буфер[Сч] = ЧислоИзШестнадцатеричнойСтроки("0x" + Сред(Шестнадцатеричный, Сч * 2 + 1, 2));
	КонецЦикла;
	Поток = ФайловыеПотоки.Создать(Путь);
	Поток.Записать(Буфер, 0, Буфер.Размер);
	Поток.Закрыть();
	Возврат Путь;
КонецФункции

// Имя печатается КОДАМИ знаков, а не как есть: байты не в UTF-8 могут
// вернуться чем угодно, вплоть до управляющих знаков, и сырая печать
// порвала бы построчную сверку.
Функция Коды(Текст)
	Р = Ч(СтрДлина(Текст)) + ":";
	Для Сч = 1 По СтрДлина(Текст) Цикл
		Р = Р + " " + Ч(КодСимвола(Текст, Сч));
	КонецЦикла;
	Возврат Р;
КонецФункции

// Текст ошибки в одну строку и без координат модуля: платформа
// предваряет описание фигурными скобками с местом возникновения, а место
// у двух сторон разное по определению.
Функция Кратко(Текст)
	Р = СтрЗаменить(Текст, Символ(13), " ");
	Р = СтрЗаменить(Р, Символ(10), " ");
	Поз = СтрНайти(Р, "}: ");
	Если Поз > 0 Тогда
		Р = Сред(Р, Поз + 3);
	КонецЕсли;
	Возврат СокрЛП(Р);
КонецФункции

