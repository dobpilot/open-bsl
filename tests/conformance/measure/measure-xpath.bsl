// Контракт подсистемы XPath над DOM на 8.3.27: `ВычислитьВыражениеXPath`,
// `СоздатьВыражениеXPath`, `СоздатьРазыменовательПИ`, `РезультатXPath` и
// перечисление `ТипРезультатаDOMXPath`.
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-xpath.bsl
//
// Правила те же, что у `measure-dom.bsl`: строка `МЕТКА<таб>ЗНАЧЕНИЕ`, всё
// рискованное — через `Вычислить`/`Выполнить` внутри `Попытка`, приёмники
// проб — переменные МОДУЛЯ, одна проба на строку. Строк `М()` здесь нет
// намеренно: реестру открытых вопросов этот файл ничего не должен, а
// `.expected` у него нет и быть не должно — контракт сличается вручную.
//
// НИ ОДНО ИМЯ ЧЛЕНА НЕ ВЗЯТО ИЗ СПРАВКИ. Каждое найдено перебором
// кандидатов, и отвергнутые написания остались в файле пробами: они
// показывают, что имя выбрано не наугад. Так, `ВычислитьВыражение`,
// `Evaluate` у документа и `СоздатьРазыменовательПространствИмен`
// платформа НЕ знает, а у `SingleNodeValue` русского написания нет вовсе —
// четырнадцать кандидатов отвергнуты.
//
// КАВЫЧКИ ВНУТРИ ВЛОЖЕННОГО КОДА УЧЕТВЕРЯЮТСЯ. Строка XML внутри
// `Выполнить` внутри `П(…)` лежит на третьем уровне вложенности, поэтому
// значение атрибута пишется `xml:lang=""""ru-RU""""`. Пропущенная пара
// кавычек прогон НЕ роняет: документ просто перестаёт быть XML, обе
// стороны печатают `<ошибка>`, и проба молча измеряет отказ разборщика
// вместо того, ради чего написана.
//
// ДВЕ ПРОБЫ, КОТОРЫЕ СЮДА ВОЗВРАЩАТЬ НЕЛЬЗЯ.
//
//   1. `Док.СоздатьРазыменовательПИ(ЧужойДок.ЭлементДокумента)` —
//      разыменователь по узлу ДРУГОГО документа. Прогон снимается по
//      таймауту (модальное окно), вывода нет; `Попытка` не спасает.
//   2. `Новый ДокументDOM` и вычисление любого выражения на нём —
//      документ БЕЗ элемента документа. Тоже таймаут: контекстным узлом
//      платформе служит элемент документа, а его там нет.
//
// Ответ платформы в обоих случаях неизвестен в принципе; наши ответы
// описаны как сознательные расхождения в шапке `bsl-rt/src/xpath.rs`.
//
// ДЕСЯТЬ СТРОК РАСХОДЯТСЯ С ПЛАТФОРМОЙ НАМЕРЕННО, и это видно прямо в
// снимке.
//
//   * «снимок РазмерСнимка», «снимок SnapshotLength», «снимок пустой
//     РазмерСнимка» — у платформы длина снимка сломана: 0 при двух узлах
//     и 1 при нуле, притом `ЭлементСнимка(1)` на том же снимке исправно
//     отдаёт второй узел;
//   * «инф ЧисловоеЗначение» и «ф number пустого набора» — нечисло в
//     `ЧисловоеЗначение`. У платформы там испорченное значение, причём
//     НЕВОСПРОИЗВОДИМОЕ: в четырёх прогонах подряд оно напечаталось
//     пустой строкой и тремя разными числами
//     (`-0,374666640336174704`, `-0,374666640858774704` и лежащее в
//     снимке `-0,374666640148574704`). У нас — ловимая ошибка:
//     бесконечности и `NaN` в десятичном `Число` нет;
//   * «г namespace::» — оси пространств имён здесь нет;
//   * «э count(/к:каталог)», «э count(/нет) кириллица», «э голый
//     /к:каталог» и «т CDATA строка» (`string(/а)`) — разбор одинарного
//     `/` перед НЕЛАТИНСКИМ именем. Платформа отвечает ошибкой, хотя те
//     же имена после `//` и после `child::` берёт, а латинское имя на том
//     же месте (`count(/a)`) тоже берёт. Граница проходит по алфавиту, а
//     не по наличию префикса: отвергнуты и префиксное `к:каталог`, и
//     беспрефиксные `нет` и `а`. Соседние строки снимка показывают обе
//     стороны границы.
//
// Обоснование каждой — в шапке `bsl-rt/src/xpath.rs`.
//
// ИЗМЕРЕНО 13.08.2026 на 8.3.27.2130.

Перем Док;
Перем Э;
Перем Раз;
Перем Рез;
Перем Соб;
Перем ИсточникXML;

Процедура П(Метка, Значение)
	Сообщить(Метка + Символ(9) + Значение);
КонецПроцедуры

Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Р = СтрЗаменить(Р, Символ(10), "<ПС>");
	Р = СтрЗаменить(Р, Символ(9), "<Т>");
	Возврат Р;
КонецФункции

// Проба ВЫРАЖЕНИЯ: тип результата и его строковое представление.
Функция Ч(Выражение)
	Попытка
		Р = Вычислить(Выражение);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Попытка
		Возврат Строка(ТипЗнч(Р)) + " [" + Видимо(Строка(Р)) + "]";
	Исключение
		Возврат Строка(ТипЗнч(Р)) + " <не печатается>";
	КонецПопытки;
КонецФункции

// Проба ОПЕРАТОРА: важен сам факт, что фрагмент принят.
Функция Оп(Код)
	Попытка
		Выполнить(Код);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат "ок";
КонецФункции

// Сбор в модульную переменную `Соб`.
Функция Сбор(Код)
	Попытка
		Соб = "";
		Выполнить(Код);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат Видимо(Соб);
КонецФункции

Функция ОписаниеУзла(У)
	Попытка
		Если У.ТипУзла = ТипУзлаDOM.Атрибут Тогда
			Возврат "@" + У.ИмяУзла + "=" + У.Значение;
		ИначеЕсли У.ЗначениеУзла = Неопределено Тогда
			Возврат У.ИмяУзла;
		Иначе
			Возврат У.ИмяУзла + "[" + Видимо(Строка(У.ЗначениеУзла)) + "]";
		КонецЕсли;
	Исключение
		Возврат "<узел не печатается>";
	КонецПопытки;
КонецФункции

// Вычисление выражения и компактная печать результата ЛЮБОГО вида.
Функция ВычXP(Выражение)
	Попытка
		Р = Вычислить("Док.ВычислитьВыражениеXPath(Выражение, Док, Раз)");
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Попытка
		Т = Р.ТипРезультата;
		Если Т = ТипРезультатаDOMXPath.Число Тогда
			Возврат "число [" + Строка(Р.ЧисловоеЗначение) + "]";
		ИначеЕсли Т = ТипРезультатаDOMXPath.Строка Тогда
			Возврат "строка [" + Видимо(Р.СтроковоеЗначение) + "]";
		ИначеЕсли Т = ТипРезультатаDOMXPath.Булево Тогда
			Возврат "булево " + Строка(Р.БулевоЗначение);
		Иначе
			С = "";
			У = Р.ПолучитьСледующий();
			Пока У <> Неопределено Цикл
				С = С + ОписаниеУзла(У) + " ";
				У = Р.ПолучитьСледующий();
			КонецЦикла;
			Возврат "узлы: " + С;
		КонецЕсли;
	Исключение
		Возврат "<обход не удался>";
	КонецПопытки;
КонецФункции

