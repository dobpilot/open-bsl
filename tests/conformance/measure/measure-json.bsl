// Замеры контракта JSON, снятые на 8.3.27.
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-json.bsl
//
// Формат тот же: `ИД<таб>ЗНАЧЕНИЕ`. Скрипт исполняется И НАШИМ
// интерпретатором — так вывод сличается с платформенным построчно, а не
// глазами. Поэтому здесь нет ни `ОписаниеОшибки()`, ни чего-либо ещё, чего
// мы не умеем: отказ печатается стабильным маркером `<ошибка>`, а не
// текстом платформы (в нём номера строк её модуля — якорь из такого не
// сделать).
//
// Переводы строк и табуляции заменяются видимыми маркерами <ПС>/<ВК>/<Т>:
// иначе многострочный вывод разъедет построчный формат.

Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Р = СтрЗаменить(Р, Символ(10), "<ПС>");
	Р = СтрЗаменить(Р, Символ(9), "<Т>");
	Возврат Р;
КонецФункции

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Видимо(Строка(Значение)));
КонецПроцедуры

Функция Компакт()
	З = Новый ЗаписьJSON;
	З.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	Возврат З;
КонецФункции

// Первое из имён-кандидатов, которое читается как поле объекта НС, либо
// "-", если не подошло ни одно. Платформа 8.3.27 отвергла документированное
// `ФорматСериализацииДат` («Поле объекта не обнаружено»), так что настоящие
// имена свойств НастройкиСериализацииJSON выясняются перебором.
Функция ИмяЖивогоПоля(НС, Кандидаты)
	Для Каждого Имя Из Кандидаты Цикл
		Попытка
			Проба = Вычислить("НС." + Имя);
			Возврат Имя;
		Исключение
		КонецПопытки;
	КонецЦикла;
	Возврат "-";
КонецФункции

// =====================================================================
// ЗАПИСЬ: форматирование
// =====================================================================

// Умолчание: переносы строк есть, отступа нет, после двоеточия пробел.
З = Новый ЗаписьJSON;
З.УстановитьСтроку();
З.ЗаписатьНачалоОбъекта();
З.ЗаписатьИмяСвойства("а");
З.ЗаписатьЗначение(1);
З.ЗаписатьИмяСвойства("б");
З.ЗаписатьЗначение("текст");
З.ЗаписатьКонецОбъекта();
М("JSON.WRITE.DEFAULT_FORMAT", З.Закрыть());

// Массив верхнего уровня и вложенный объект.
З = Новый ЗаписьJSON;
З.УстановитьСтроку();
З.ЗаписатьНачалоМассива();
З.ЗаписатьЗначение(1);
З.ЗаписатьНачалоОбъекта();
З.ЗаписатьИмяСвойства("к");
З.ЗаписатьЗначение(Истина);
З.ЗаписатьКонецОбъекта();
З.ЗаписатьКонецМассива();
М("JSON.WRITE.NESTED", З.Закрыть());

// Без переносов строк — пробела после двоеточия тоже нет.
З = Компакт();
З.ЗаписатьНачалоОбъекта();
З.ЗаписатьИмяСвойства("а");
З.ЗаписатьЗначение(1);
З.ЗаписатьКонецОбъекта();
М("JSON.WRITE.NO_LINE_BREAKS", З.Закрыть());

// Отступ повторяется по глубине.
З = Новый ЗаписьJSON;
З.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "__"));
З.ЗаписатьНачалоОбъекта();
З.ЗаписатьИмяСвойства("а");
З.ЗаписатьНачалоОбъекта();
З.ЗаписатьИмяСвойства("б");
З.ЗаписатьЗначение(1);
З.ЗаписатьКонецОбъекта();
З.ЗаписатьКонецОбъекта();
М("JSON.WRITE.INDENT_NESTED", З.Закрыть());

// Что порождают Windows и Unix.
З = Новый ЗаписьJSON;
З.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Windows, " "));
З.ЗаписатьНачалоОбъекта();
З.ЗаписатьИмяСвойства("а");
З.ЗаписатьЗначение(1);
З.ЗаписатьКонецОбъекта();
М("JSON.WRITE.BREAK_WINDOWS", З.Закрыть());

З = Новый ЗаписьJSON;
З.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Unix, " "));
З.ЗаписатьНачалоОбъекта();
З.ЗаписатьИмяСвойства("а");
З.ЗаписатьЗначение(1);
З.ЗаписатьКонецОбъекта();
М("JSON.WRITE.BREAK_UNIX", З.Закрыть());

// =====================================================================
// ЗАПИСЬ: значения
// =====================================================================

// Числа: точная десятичная запись с ТОЧКОЙ, без группировки.
З = Компакт();
З.ЗаписатьНачалоМассива();
З.ЗаписатьЗначение(1.5);
З.ЗаписатьЗначение(-2);
З.ЗаписатьЗначение(1000000);
З.ЗаписатьЗначение(0);
З.ЗаписатьЗначение(1/3);
З.ЗаписатьКонецМассива();
М("JSON.WRITE.NUMBERS", З.Закрыть());

// Экранирование: кавычка, косые, ПС, табуляция, кириллица, 0x01.
З = Компакт();
З.ЗаписатьЗначение("""\/" + Символ(10) + Символ(9) + "Ёж" + Символ(1));
М("JSON.WRITE.ESCAPES", З.Закрыть());

// Управляющие символы: ВК и те, что уходят как \uXXXX.
З = Компакт();
З.ЗаписатьЗначение(Символ(13) + Символ(8) + Символ(12) + Символ(11));
М("JSON.WRITE.CONTROL_CHARS", З.Закрыть());

// Какие типы ЗаписатьЗначение принимает поодиночке.
Р = "";
Попытка
	З = Компакт();
	З.ЗаписатьЗначение(Истина);
	Р = З.Закрыть();
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("JSON.WRITE.VALUE_BOOLEAN", Р);

Р = "";
Попытка
	З = Компакт();
	З.ЗаписатьЗначение(Null);
	Р = З.Закрыть();
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("JSON.WRITE.VALUE_NULL", Р);

Р = "";
Попытка
	З = Компакт();
	З.ЗаписатьЗначение(Дата(2024, 1, 2, 3, 4, 5));
	Р = З.Закрыть();
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("JSON.WRITE.VALUE_DATE", Р);

Р = "";
Попытка
	З = Компакт();
	З.ЗаписатьЗначение(Неопределено);
	Р = З.Закрыть();
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("JSON.WRITE.VALUE_UNDEFINED", Р);

// Нарушение структуры: значение в объекте без имени свойства.
Р = "";
Попытка
	З = Компакт();
	З.ЗаписатьНачалоОбъекта();
	З.ЗаписатьЗначение(1);
	Р = "принято: " + З.Закрыть();
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("JSON.WRITE.VALUE_WITHOUT_NAME", Р);

// =====================================================================
// ЗАПИСАТЬJSON: сериализация целого значения
// =====================================================================

З = Компакт();
ЗаписатьJSON(З, Новый Структура("Фамилия, Имя, Возраст", "Петров", "Иван", 30));
М("JSON.SERIALIZE.STRUCTURE", З.Закрыть());

З = Компакт();
М1 = Новый Массив;
М1.Добавить(1);
М1.Добавить("два");
Соотв = Новый Соответствие;
Соотв.Вставить("к", 1);
М1.Добавить(Соотв);
ЗаписатьJSON(З, М1);
М("JSON.SERIALIZE.NESTED", З.Закрыть());

З = Компакт();
ЗаписатьJSON(З, Новый Структура("д", Дата(2024, 3, 4, 5, 6, 7)));
М("JSON.SERIALIZE.DATE_DEFAULT", З.Закрыть());

З = Компакт();
ЗаписатьJSON(З, Новый Структура("д", Дата(1, 1, 1)));
М("JSON.SERIALIZE.DATE_EMPTY", З.Закрыть());

Р = "";
Попытка
	З = Компакт();
	ЗаписатьJSON(З, Новый Структура("т", Новый ТаблицаЗначений));
	Р = "принято: " + З.Закрыть();
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("JSON.SERIALIZE.UNSUPPORTED_TYPE", Р);

// =====================================================================
// ЧТЕНИЕ
// =====================================================================

// Последовательность типов текущего значения.
Ч = Новый ЧтениеJSON;
Ч.УстановитьСтроку("{""а"":1,""б"":[true,null]}");
Р = "";
Пока Ч.Прочитать() Цикл
	Р = Р + Строка(Ч.ТипТекущегоЗначения) + " ";
КонецЦикла;
М("JSON.READ.EVENT_SEQUENCE", Р);

// ТекущееЗначение — только там, где значение есть.
Ч = Новый ЧтениеJSON;
Ч.УстановитьСтроку("{""а"":1.5,""б"":""с"",""в"":true}");
Р = "";
Пока Ч.Прочитать() Цикл
	Т = Ч.ТипТекущегоЗначения;
	Если Т = ТипЗначенияJSON.ИмяСвойства ИЛИ Т = ТипЗначенияJSON.Строка
		ИЛИ Т = ТипЗначенияJSON.Число ИЛИ Т = ТипЗначенияJSON.Булево Тогда
		Р = Р + "[" + Строка(Ч.ТекущееЗначение) + "]";
	КонецЕсли;
КонецЦикла;
М("JSON.READ.CURRENT_VALUE", Р);

// ТекущееЗначение на скобке — ошибка, а не Неопределено.
Ч = Новый ЧтениеJSON;
Ч.УстановитьСтроку("{""а"":1}");
Ч.Прочитать();
Р = "";
Попытка
	Р = "принято: " + Строка(Ч.ТекущееЗначение);
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("JSON.READ.VALUE_ON_BRACE", Р);

// Пропустить проглатывает вложенное значение целиком.
Ч = Новый ЧтениеJSON;
Ч.УстановитьСтроку("{""а"":[1,2,3],""б"":7}");
Р = "";
Пока Ч.Прочитать() Цикл
	Если Ч.ТипТекущегоЗначения = ТипЗначенияJSON.ИмяСвойства И Ч.ТекущееЗначение = "а" Тогда
		Ч.Прочитать();
		Ч.Пропустить();
	КонецЕсли;
	Р = Р + Строка(Ч.ТипТекущегоЗначения) + " ";
КонецЦикла;
М("JSON.READ.SKIP", Р);

// Снятие экранирования при чтении.
Ч = Новый ЧтениеJSON;
Ч.УстановитьСтроку("[""Ё\t\""\\/""]");
М("JSON.READ.UNESCAPE", ПрочитатьJSON(Ч)[0]);

// Битый ввод: сколько событий отдаёт разборщик и где всё-таки ошибка.
Ч = Новый ЧтениеJSON;
Ч.УстановитьСтроку("{""а"":}");
Шагов = 0;
Пока Ч.Прочитать() Цикл
	Шагов = Шагов + 1;
КонецЦикла;
М("JSON.READ.MALFORMED_NO_VALUE", Шагов);

Ч = Новый ЧтениеJSON;
Ч.УстановитьСтроку("[1,]");
Шагов = 0;
Пока Ч.Прочитать() Цикл
	Шагов = Шагов + 1;
КонецЦикла;
М("JSON.READ.MALFORMED_TRAILING_COMMA", Шагов);

Ч = Новый ЧтениеJSON;
Ч.УстановитьСтроку("{""а"" 1}");
Шагов = 0;
Пока Ч.Прочитать() Цикл
	Шагов = Шагов + 1;
КонецЦикла;
М("JSON.READ.MALFORMED_NO_COLON", Шагов);

Ч = Новый ЧтениеJSON;
Ч.УстановитьСтроку("{""а"":1");
Шагов = 0;
Пока Ч.Прочитать() Цикл
	Шагов = Шагов + 1;
КонецЦикла;
М("JSON.READ.MALFORMED_UNCLOSED", Шагов);

Р = "";
Попытка
	Ч = Новый ЧтениеJSON;
	Ч.УстановитьСтроку("нечто");
	Пока Ч.Прочитать() Цикл
	КонецЦикла;
	Р = "принято";
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("JSON.READ.MALFORMED_GARBAGE", Р);

// =====================================================================
// ПРОЧИТАТЬJSON
// =====================================================================

Ч = Новый ЧтениеJSON;
Ч.УстановитьСтроку("{""а"":1,""б"":""текст""}");
М("JSON.DESERIALIZE.DEFAULT_TYPE", ТипЗнч(ПрочитатьJSON(Ч)));

Ч = Новый ЧтениеJSON;
Ч.УстановитьСтроку("{""а"":1}");
Соотв = ПрочитатьJSON(Ч, Истина);
М("JSON.DESERIALIZE.AS_MAP", Строка(ТипЗнч(Соотв)) + "|" + Строка(Соотв.Получить("а")));

Ч = Новый ЧтениеJSON;
Ч.УстановитьСтроку("[1,true,null,""с"",2.5]");
Прочитанное = ПрочитатьJSON(Ч);
Р = Строка(ТипЗнч(Прочитанное)) + ":";
Для Каждого Э Из Прочитанное Цикл
	Р = Р + " " + Строка(ТипЗнч(Э));
КонецЦикла;
М("JSON.DESERIALIZE.VALUE_TYPES", Р);

Ч = Новый ЧтениеJSON;
Ч.УстановитьСтроку("{""а"":{""б"":1},""м"":[1,2]}");
Прочитанное = ПрочитатьJSON(Ч);
М("JSON.DESERIALIZE.NESTED", Строка(ТипЗнч(Прочитанное.а)) + "|" + Строка(Прочитанное.а.б) + "|" + Строка(ТипЗнч(Прочитанное.м)));

// Ключ, который не может быть именем поля структуры.
Р = "";
Попытка
	Ч = Новый ЧтениеJSON;
	Ч.УстановитьСтроку("{""не имя"":1}");
	Р = "принято: " + Строка(ТипЗнч(ПрочитатьJSON(Ч)));
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("JSON.DESERIALIZE.BAD_KEY", Р);

// Дата без указания зоны.
Ч = Новый ЧтениеJSON;
Ч.УстановитьСтроку("{""д"":""2024-03-04T05:06:07""}");
ИменаДат = Новый Массив;
ИменаДат.Добавить("д");
Прочитанное = ПрочитатьJSON(Ч, Истина, ИменаДат);
М("JSON.DESERIALIZE.DATE_NO_ZONE", Строка(ТипЗнч(Прочитанное.Получить("д"))) + "|" + Строка(Прочитанное.Получить("д")));

// Круговой прогон.
З = Компакт();
ЗаписатьJSON(З, Новый Структура("а, б", 1, "текст"));
Текст = З.Закрыть();
Ч = Новый ЧтениеJSON;
Ч.УстановитьСтроку(Текст);
Обратно = ПрочитатьJSON(Ч, Истина);
М("JSON.ROUND_TRIP", Текст + " -> " + Строка(Обратно.Получить("а")) + "|" + Строка(Обратно.Получить("б")));

// =====================================================================
// ПЕРЕЧИСЛЕНИЯ
// =====================================================================

М("JSON.ENUM.VALUE_TYPES", Строка(ТипЗначенияJSON.Строка) + "|" + Строка(ТипЗначенияJSON.Число)
	+ "|" + Строка(ТипЗначенияJSON.Булево) + "|" + Строка(ТипЗначенияJSON.Null)
	+ "|" + Строка(ТипЗначенияJSON.НачалоОбъекта) + "|" + Строка(ТипЗначенияJSON.КонецОбъекта)
	+ "|" + Строка(ТипЗначенияJSON.НачалоМассива) + "|" + Строка(ТипЗначенияJSON.КонецМассива)
	+ "|" + Строка(ТипЗначенияJSON.ИмяСвойства) + "|" + Строка(ТипЗначенияJSON.Ничего)
	+ "|" + Строка(ТипЗначенияJSON.Комментарий));

М("JSON.ENUM.LINE_BREAKS", Строка(ПереносСтрокJSON.Нет) + "|" + Строка(ПереносСтрокJSON.Авто)
	+ "|" + Строка(ПереносСтрокJSON.Windows) + "|" + Строка(ПереносСтрокJSON.Unix));

М("JSON.TYPE.NAMES", Строка(ТипЗнч(Новый ЧтениеJSON)) + "|" + Строка(ТипЗнч(Новый ЗаписьJSON))
	+ "|" + Строка(ТипЗнч(Новый ПараметрыЗаписиJSON)));

М("JSON.VALUE.NAMES", Строка(Новый ЧтениеJSON) + "|" + Строка(Новый ЗаписьJSON)
	+ "|" + Строка(Новый ПараметрыЗаписиJSON));

// =====================================================================
// ЭТАП 0: даты и настройки сериализации — пробы открытых вопросов
// =====================================================================
//
// Функциональность как таковая (форматы дат, круговой прогон, отступление
// от структуры) снята отдельной фикстурой без эталона
// (tests/conformance/fixtures/json-dates.bsl) — здесь только открытые
// вопросы и оставшиеся якоря из bsl_rt::open_questions, по одной строке на
// ИД. JSON.VALUE.READ_KIND и JSON.WRITE.CHECK_STRUCTURE_DEFAULT уже
// перешли в MEASURED_ANCHORS (первый прогон подтвердил выбор), но строки
// оставлены как регрессия факта.

// Английские написания членов ВариантЗаписиДатыJSON — детализированная
// проба: первый прогон (равенство всех трёх сразу одним махом) дал общий
// <ошибка>, не показав, что именно не совпало — имя ТИПА перечисления или
// одно из имён ЧЛЕНОВ. Здесь — отдельная Попытка на тип и по отдельной
// вложенной Попытке на каждый член с несколькими написаниями-кандидатами;
// результат — компактная строка "Т<+/-> Л:<совпавшее|-> О:<совпавшее|-> \
// У:<совпавшее|->".
// Результат Вычислить обязан быть присвоен: встроенную ФУНКЦИЮ платформа
// не даёт вызвать как процедуру — это ошибка компиляции всего модуля
// (проверено прогоном: форма молча не собралась, пустой вывод).
Т = "-";
Попытка
	ТипПеречисления = Вычислить("JSONDateWritingVariant");
	Т = "+";
Исключение
КонецПопытки;

Л = "-";
Попытка
	Если ВариантЗаписиДатыJSON.ЛокальнаяДата = Вычислить("JSONDateWritingVariant.LocalDate") Тогда
		Л = "LocalDate";
	КонецЕсли;
Исключение
КонецПопытки;

О = "-";
Попытка
	Если ВариантЗаписиДатыJSON.ЛокальнаяДатаСоСмещением
		= Вычислить("JSONDateWritingVariant.LocalDateTimeOffset") Тогда
		О = "LocalDateTimeOffset";
	КонецЕсли;
Исключение
КонецПопытки;
Если О = "-" Тогда
	Попытка
		Если ВариантЗаписиДатыJSON.ЛокальнаяДатаСоСмещением
			= Вычислить("JSONDateWritingVariant.LocalDateWithOffset") Тогда
			О = "LocalDateWithOffset";
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецЕсли;
Если О = "-" Тогда
	Попытка
		Если ВариантЗаписиДатыJSON.ЛокальнаяДатаСоСмещением
			= Вычислить("JSONDateWritingVariant.LocalDateOffset") Тогда
			О = "LocalDateOffset";
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецЕсли;

У = "-";
Попытка
	Если ВариантЗаписиДатыJSON.УниверсальнаяДата = Вычислить("JSONDateWritingVariant.UniversalDate") Тогда
		У = "UniversalDate";
	КонецЕсли;
Исключение
КонецПопытки;

М("JSON.DATE_VARIANT_EN_NAMES", "Т" + Т + " Л:" + Л + " О:" + О + " У:" + У);

// «Т+» выше означает: платформа вычисляет ГОЛОЕ имя перечисления
// (без .Член) как выражение. Что при этом отдают Строка()/ТипЗнч() —
// отдельно не измерено.
Р = "";
Попытка
	Р = Вычислить("Строка(JSONDateWritingVariant) + ""|"" + Строка(ТипЗнч(JSONDateWritingVariant))");
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("JSON.ENUM.BARE_NAME", Р);

// Настоящие имена свойств НастройкиСериализацииJSON. Платформа отвергла
// документированное статьёй написание ФорматСериализацииДат («Поле объекта
// не обнаружено», снято живой ошибкой при прогоне фикстуры) — перебираем
// кандидатов на чтение по каждому из трёх свойств. Русские кандидаты
// (первые три поля результата) уже дали ответ ФорматСериализацииДаты
// (с «ы»)|ВариантЗаписиДаты|СериализовыватьМассивыКакОбъекты — следующие
// три поля перебирают АНГЛИЙСКИЕ написания тех же трёх свойств, которые
// ещё не измерены.
Р = "";
Попытка
	НС = Новый НастройкиСериализацииJSON;
	КандидатыФормата = Новый Массив;
	КандидатыФормата.Добавить("ФорматСериализацииДат");
	КандидатыФормата.Добавить("ФорматСериализацииДаты");
	КандидатыФормата.Добавить("ФорматЗаписиДаты");
	КандидатыФормата.Добавить("ФорматДаты");
	КандидатыВарианта = Новый Массив;
	КандидатыВарианта.Добавить("ВариантЗаписиДаты");
	КандидатыВарианта.Добавить("ВариантСериализацииДаты");
	КандидатыВарианта.Добавить("ВариантЗаписиДат");
	КандидатыМассивов = Новый Массив;
	КандидатыМассивов.Добавить("СериализовыватьМассивыКакОбъекты");
	КандидатыМассивов.Добавить("СериализоватьМассивыКакОбъекты");
	КандидатыМассивов.Добавить("ЗаписыватьМассивыКакОбъекты");
	КандидатыМассивов.Добавить("МассивыКакОбъекты");
	КандидатыФорматаEn = Новый Массив;
	КандидатыФорматаEn.Добавить("DateSerializationFormat");
	КандидатыФорматаEn.Добавить("DatesSerializationFormat");
	КандидатыФорматаEn.Добавить("SerializationDateFormat");
	КандидатыВариантаEn = Новый Массив;
	КандидатыВариантаEn.Добавить("DateWritingVariant");
	КандидатыВариантаEn.Добавить("DateWritingOption");
	КандидатыМассивовEn = Новый Массив;
	КандидатыМассивовEn.Добавить("SerializeArraysAsObjects");
	Р = ИмяЖивогоПоля(НС, КандидатыФормата) + "|" + ИмяЖивогоПоля(НС, КандидатыВарианта)
		+ "|" + ИмяЖивогоПоля(НС, КандидатыМассивов)
		+ "|" + ИмяЖивогоПоля(НС, КандидатыФорматаEn) + "|" + ИмяЖивогоПоля(НС, КандидатыВариантаEn)
		+ "|" + ИмяЖивогоПоля(НС, КандидатыМассивовEn);
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("JSON.SETTINGS.PROPERTY_NAMES", Р);

// Умолчание НастройкиСериализацииJSON.ВариантЗаписиДаты, ПЛЮС Строка()
// каждого члена ВариантЗаписиДатыJSON по порядку (Локальная/СоСмещением/
// Универсальная) — первый прогон измерил умолчание и текст первого члена,
// два следующих текста пока предположение по аналогии (см.
// crates/bsl-rt/src/enums.rs).
Р = "";
Попытка
	НС = Новый НастройкиСериализацииJSON;
	Р = Строка(НС.ВариантЗаписиДаты) + "|" + Строка(ВариантЗаписиДатыJSON.ЛокальнаяДата)
		+ "|" + Строка(ВариантЗаписиДатыJSON.ЛокальнаяДатаСоСмещением)
		+ "|" + Строка(ВариантЗаписиДатыJSON.УниверсальнаяДата);
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("JSON.SETTINGS.DATE_VARIANT_DEFAULT", Р);

// Не-ISO формат с не-универсальным вариантом записи — статья запрещает
// сочетание, но не называет тип исключения. ЗАКРЫТО (Anchor): факт
// исключения измерен; попытка достать точный текст через
// Вычислить("КраткоеПредставлениеОшибки(ИнформацияОбОшибке())") дала
// «Непредвиденная ошибка» — ИнформацияОбОшибке() не видит контекст чужого
// исключения внутри Вычислить, этим способом текст не снять. Проба
// упрощена обратно до факта исключения — трюк с вложенным Вычислить
// только шумит в diff.
Р = "";
Попытка
	Р = "принято: " + ЗаписатьДатуJSON(Дата(2024, 1, 2, 3, 4, 5), ФорматДатыJSON.JavaScript,
		ВариантЗаписиДатыJSON.ЛокальнаяДата);
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("JSON.WRITE_DATE.NON_ISO_LOCAL_ERROR", Р);

// ПрочитатьДатуJSON на представлении, которое не разбирается ни в одном
// известном формате — тот же вывод (ЗАКРЫТО, Anchor), та же причина
// упрощения.
Р = "";
Попытка
	Р = "принято: " + Строка(ПрочитатьДатуJSON("совсем не дата", ФорматДатыJSON.ISO));
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("JSON.READ_DATE.BAD_FORMAT_TEXT", Р);

// ИЗМЕРЕНО (перешло в MEASURED_ANCHORS) — строка оставлена как регрессия.
Р = "";
Попытка
	Р = Строка(ТипЗнч(ПрочитатьЗначениеJSON("{""а"":1}")));
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("JSON.VALUE.READ_KIND", Р);

// Умолчание ЗаписьJSON.ПроверятьСтруктуру — ПОСЛЕ назначения приёмника
// (Компакт() уже вызывает УстановитьСтроку), чтобы не смешивать вопрос об
// умолчании с вопросом о том, читается ли свойство ДО назначения приёмника.
Р = "";
Попытка
	З = Компакт();
	Р = Строка(З.ПроверятьСтруктуру);
Исключение
	Р = "<ошибка>";
КонецПопытки;
М("JSON.WRITE.CHECK_STRUCTURE_DEFAULT", Р);

// Что вообще отключает ПроверятьСтруктуру = Ложь. ИЗМЕРЕНО: она не снимает
// ни одну из четырёх известных проверок (значение без имени свойства,
// конец объекта/массива без открытого контейнера, имя свойства вне
// объекта — все четыре дали "ошибка" что при Истина, что при Ложь). Эта
// проба — два НОВЫХ кандидата, каждый и при Истина, и при Ложь: (а)
// повторное имя свойства в одном объекте, (б) Закрыть() при незакрытом
// объекте. Накопление в одну строку.
Р = "";
Попытка
	З = Компакт();
	З.ЗаписатьНачалоОбъекта();
	З.ЗаписатьИмяСвойства("х");
	З.ЗаписатьЗначение(1);
	З.ЗаписатьИмяСвойства("х");
	З.ЗаписатьЗначение(2);
	З.ЗаписатьКонецОбъекта();
	Р = Р + "Повтор@Истина:" + З.Закрыть();
Исключение
	Р = Р + "Повтор@Истина:ошибка";
КонецПопытки;
Попытка
	З = Компакт();
	З.ПроверятьСтруктуру = Ложь;
	З.ЗаписатьНачалоОбъекта();
	З.ЗаписатьИмяСвойства("х");
	З.ЗаписатьЗначение(1);
	З.ЗаписатьИмяСвойства("х");
	З.ЗаписатьЗначение(2);
	З.ЗаписатьКонецОбъекта();
	Р = Р + " Повтор@Ложь:" + З.Закрыть();
Исключение
	Р = Р + " Повтор@Ложь:ошибка";
КонецПопытки;
Попытка
	З = Компакт();
	З.ЗаписатьНачалоОбъекта();
	Р = Р + " Закрыть@Истина:" + З.Закрыть();
Исключение
	Р = Р + " Закрыть@Истина:ошибка";
КонецПопытки;
Попытка
	З = Компакт();
	З.ПроверятьСтруктуру = Ложь;
	З.ЗаписатьНачалоОбъекта();
	Р = Р + " Закрыть@Ложь:" + З.Закрыть();
Исключение
	Р = Р + " Закрыть@Ложь:ошибка";
КонецПопытки;
М("JSON.WRITE.CHECK_STRUCTURE_OFF", Р);
