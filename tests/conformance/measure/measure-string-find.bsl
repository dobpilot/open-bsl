// Полная форма `СтрНайти`, которую Connector использует для URL и заголовков.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("STRING.FIND.DEFAULT", СтрНайти("ababa", "a"));
М("STRING.FIND.REVERSE", СтрНайти("ababa", "a", НаправлениеПоиска.СКонца));
М("STRING.FIND.FORWARD_FROM", СтрНайти("ababa", "a", НаправлениеПоиска.СНачала, 2));
М("STRING.FIND.REVERSE_FROM", СтрНайти("ababa", "a", НаправлениеПоиска.СКонца, 4));
М("STRING.FIND.SECOND", СтрНайти("ababa", "a", НаправлениеПоиска.СНачала, 1, 2));
