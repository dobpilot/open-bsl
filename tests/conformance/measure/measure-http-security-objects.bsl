// Объектный контракт proxy и TLS, который Connector использует до сети.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция БулевоСтрокой(Значение)
	Если Значение Тогда
		Возврат "true";
	КонецЕсли;
	Возврат "false";
КонецФункции

ПроксиПоУмолчанию = Новый ИнтернетПрокси;
М("HTTP.PROXY.DEFAULT.TYPE",
	БулевоСтрокой(ТипЗнч(ПроксиПоУмолчанию) = Тип("ИнтернетПрокси")));
М("HTTP.PROXY.DEFAULT.EXCLUSIONS",
	ПроксиПоУмолчанию.НеИспользоватьПроксиДляАдресов.Количество());
М("HTTP.PROXY.DEFAULT.LOCAL",
	БулевоСтрокой(ПроксиПоУмолчанию.НеИспользоватьПроксиДляЛокальныхАдресов));
М("HTTP.PROXY.DEFAULT.USER", ПроксиПоУмолчанию.Пользователь);
М("HTTP.PROXY.DEFAULT.PASSWORD", ПроксиПоУмолчанию.Пароль);

ПрямойПрокси = Новый ИнтернетПрокси(Ложь);
М("HTTP.PROXY.DIRECT.TYPE",
	БулевоСтрокой(ТипЗнч(ПрямойПрокси) = Тип("ИнтернетПрокси")));
М("HTTP.PROXY.DIRECT.EXCLUSIONS",
	ПрямойПрокси.НеИспользоватьПроксиДляАдресов.Количество());
М("HTTP.PROXY.DIRECT.LOCAL",
	БулевоСтрокой(ПрямойПрокси.НеИспользоватьПроксиДляЛокальныхАдресов));
М("HTTP.PROXY.DIRECT.USER", ПрямойПрокси.Пользователь);
М("HTTP.PROXY.DIRECT.PASSWORD", ПрямойПрокси.Пароль);

ЯвныйПрокси = Новый ИнтернетПрокси(Ложь);
УстановкаHTTP = Истина;
Попытка
	ЯвныйПрокси.Установить("http", "proxy.test", 3128);
Исключение
	УстановкаHTTP = Ложь;
КонецПопытки;
М("HTTP.PROXY.EXPLICIT.SET", БулевоСтрокой(УстановкаHTTP));

СерверЯвногоПрокси = "<ошибка>";
ПортЯвногоПрокси = "<ошибка>";
Попытка
	СерверЯвногоПрокси = ЯвныйПрокси.ПолучитьСервер("http");
	ПортЯвногоПрокси = Строка(ЯвныйПрокси.ПолучитьПорт("http"));
Исключение
КонецПопытки;
М("HTTP.PROXY.EXPLICIT.SERVER", СерверЯвногоПрокси);
М("HTTP.PROXY.EXPLICIT.PORT", ПортЯвногоПрокси);

ЗаписьУчетныхДанных = Истина;
Попытка
	ЯвныйПрокси.Пользователь = "user";
	ЯвныйПрокси.Пароль = "password";
Исключение
	ЗаписьУчетныхДанных = Ложь;
КонецПопытки;
М("HTTP.PROXY.EXPLICIT.CREDENTIALS_WRITABLE",
	БулевоСтрокой(ЗаписьУчетныхДанных));
М("HTTP.PROXY.EXPLICIT.USER", ЯвныйПрокси.Пользователь);
М("HTTP.PROXY.EXPLICIT.PASSWORD", ЯвныйПрокси.Пароль);

РезультатИсключений = "<ошибка>";
РезультатЛокальных = "<ошибка>";
Попытка
	ЯвныйПрокси.НеИспользоватьПроксиДляАдресов.Добавить("localhost");
	ЯвныйПрокси.НеИспользоватьПроксиДляЛокальныхАдресов = Истина;
	РезультатИсключений = ЯвныйПрокси.НеИспользоватьПроксиДляАдресов[0];
	РезультатЛокальных = БулевоСтрокой(
		ЯвныйПрокси.НеИспользоватьПроксиДляЛокальныхАдресов);
Исключение
КонецПопытки;
М("HTTP.PROXY.EXPLICIT.EXCLUSIONS", РезультатИсключений);
М("HTTP.PROXY.EXPLICIT.LOCAL", РезультатЛокальных);

СистемныеКорни = Новый СертификатыУдостоверяющихЦентровОС;
М("HTTP.TLS.SYSTEM_ROOTS.TYPE", БулевоСтрокой(
	ТипЗнч(СистемныеКорни) = Тип("СертификатыУдостоверяющихЦентровОС")));

ЗащищенноеСистемное = Новый ЗащищенноеСоединениеOpenSSL(
	Неопределено, СистемныеКорни);
М("HTTP.TLS.SECURE.TYPE", БулевоСтрокой(
	ТипЗнч(ЗащищенноеСистемное) = Тип("ЗащищенноеСоединениеOpenSSL")));
М("HTTP.TLS.SECURE.CLIENT_UNDEFINED", БулевоСтрокой(
	ЗащищенноеСистемное.СертификатКлиента = Неопределено));
М("HTTP.TLS.SECURE.ROOTS_ALIAS", БулевоСтрокой(
	ЗащищенноеСистемное.СертификатыУдостоверяющихЦентров = СистемныеКорни));

ЗащищенноеБезПроверки = Новый ЗащищенноеСоединениеOpenSSL;
М("HTTP.TLS.INSECURE.CLIENT_UNDEFINED", БулевоСтрокой(
	ЗащищенноеБезПроверки.СертификатКлиента = Неопределено));
М("HTTP.TLS.INSECURE.ROOTS_UNDEFINED", БулевоСтрокой(
	ЗащищенноеБезПроверки.СертификатыУдостоверяющихЦентров = Неопределено));

ТипWindowsСертификата = "<ошибка>";
Попытка
	ТипWindowsСертификата = Строка(Тип("СертификатКлиентаWindows"));
Исключение
КонецПопытки;
М("HTTP.TLS.CLIENT_WINDOWS.TYPE", ТипWindowsСертификата);

ПутьНегодногоСертификата = ПолучитьИмяВременногоФайла(".pem");
ПолучитьДвоичныеДанныеИзСтроки(
	"не сертификат", КодировкаТекста.UTF8, Ложь).Записать(ПутьНегодногоСертификата);

РезультатКорнейФайл = "<ошибка>";
Попытка
	КорниФайл = Новый СертификатыУдостоверяющихЦентровФайл(
		ПутьНегодногоСертификата);
	РезультатКорнейФайл = Строка(ТипЗнч(КорниФайл));
Исключение
КонецПопытки;
М("HTTP.TLS.ROOTS_FILE.INVALID_CONTENT", РезультатКорнейФайл);

РезультатКлиентаФайл = "<ошибка>";
Попытка
	КлиентФайл = Новый СертификатКлиентаФайл(
		ПутьНегодногоСертификата, "");
	РезультатКлиентаФайл = Строка(ТипЗнч(КлиентФайл));
Исключение
КонецПопытки;
М("HTTP.TLS.CLIENT_FILE.INVALID_CONTENT", РезультатКлиентаФайл);

РезультатСвязиКорней = "<нет объекта>";
Если РезультатКорнейФайл <> "<ошибка>" Тогда
	СвязьСФайловымиКорнями = Новый ЗащищенноеСоединениеOpenSSL(
		Неопределено, КорниФайл);
	РезультатСвязиКорней = БулевоСтрокой(
		СвязьСФайловымиКорнями.СертификатыУдостоверяющихЦентров = КорниФайл);
КонецЕсли;
М("HTTP.TLS.ROOTS_FILE.ALIAS", РезультатСвязиКорней);

РезультатСвязиКлиента = "<нет объекта>";
Если РезультатКлиентаФайл <> "<ошибка>" Тогда
	СвязьСКлиентскимФайлом = Новый ЗащищенноеСоединениеOpenSSL(
		КлиентФайл, Неопределено);
	РезультатСвязиКлиента = БулевоСтрокой(
		СвязьСКлиентскимФайлом.СертификатКлиента = КлиентФайл);
КонецЕсли;
М("HTTP.TLS.CLIENT_FILE.ALIAS", РезультатСвязиКлиента);

УдалитьФайлы(ПутьНегодногоСертификата);
