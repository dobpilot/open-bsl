// Контракт подсистемы DOM на ЗАПИСЬ: фабричные методы `ДокументDOM`,
// мутация дерева и сериализация дерева обратно в XML, снятые на 8.3.27.
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-dom-write.bsl
//
// Правила те же, что у `measure-dom.bsl`: строка `МЕТКА<таб>ЗНАЧЕНИЕ`,
// скрипт исполняется И НАШИМ интерпретатором, сличение построчное. Строк
// `М()` здесь нет намеренно: реестру открытых вопросов этот файл ничего не
// должен, а `.expected` у него нет и быть не должно.
//
// ПОЧЕМУ ВСЁ ЧЕРЕЗ `Вычислить` И `Выполнить` — причина та же, что в
// `measure-dom.bsl`: неизвестное имя типа или метода наш резолвер отвергает
// НА ЭТАПЕ КОМПИЛЯЦИИ, и прямой вызов сломал бы не строку, а весь скрипт.
// Здесь это особенно важно: половина проб — перебор ИМЁН, из которых
// платформа принимает не все. Обмен между фрагментами идёт только через
// переменные МОДУЛЯ (`Перем` ниже), как и в `measure-dom.bsl`.
//
// ИЗМЕРЕНО 12.08.2026 на 8.3.27.2130.

Перем Док;
Перем Э;
Перем Соб;
Перем ИсточникXML;

Процедура П(Метка, Значение)
	Сообщить(Метка + Символ(9) + Значение);
КонецПроцедуры

Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Р = СтрЗаменить(Р, Символ(10), "<ПС>");
	Р = СтрЗаменить(Р, Символ(9), "<Т>");
	Возврат Р;
КонецФункции

// Проба ВЫРАЖЕНИЯ: тип результата и его строковое представление.
Функция Ч(Выражение)
	Попытка
		Р = Вычислить(Выражение);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Попытка
		Возврат Строка(ТипЗнч(Р)) + " [" + Видимо(Строка(Р)) + "]";
	Исключение
		Возврат Строка(ТипЗнч(Р)) + " <не печатается>";
	КонецПопытки;
КонецФункции

// Сбор в модульную переменную `Соб` без подготовки дерева.
Функция Сбор(Код)
	Попытка
		Соб = "";
		Выполнить(Код);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат Видимо(Соб);
КонецФункции

// Свежее дерево из `Текст` в модульных `Док` и `Э`, затем фрагмент `Код`.
// Подготовка отделена от пробы: её отказ — это `<нет дерева>`, а не
// `<ошибка>`, иначе сломанная подготовка притворялась бы отказом пробы.
Функция НаДереве(Текст, Код)
	ИсточникXML = Текст;
	Попытка
		Выполнить("П1 = Новый ПостроительDOM; Ч1 = Новый ЧтениеXML; Ч1.УстановитьСтроку(ИсточникXML); Док = П1.Прочитать(Ч1); Э = Док.ЭлементДокумента;");
	Исключение
		Возврат "<нет дерева>";
	КонецПопытки;
	Попытка
		Соб = "";
		Выполнить(Код);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат Видимо(Соб);
КонецФункции

П("подготовка", НаДереве("<корень а=""1""><дитя>текст</дитя><второй/></корень>", "Соб = Э.ИмяУзла;"));

