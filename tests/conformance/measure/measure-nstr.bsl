Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("NSTR.RU", НСтр("ru = 'Привет'"));
М("NSTR.ESCAPED_QUOTE", НСтр("ru = 'Это ''цитата'''", "ru"));
М("NSTR.MULTI_LANGUAGE", НСтр("en = 'Hello'; ru = 'Привет'"));
М("NSTR.EXPLICIT_RU", НСтр("en = 'Hello'; ru = 'Привет'", "ru"));
М("NSTR.EXPLICIT_EN", НСтр("en = 'Hello'; ru = 'Привет'", "en"));
М("NSTR.MULTILINE", СтрЗаменить(НСтр("ru = 'Первая
	|Вторая'", "ru"), Символ(10), "<LF>"));

Результат = "не ошибка";
Попытка
	Результат = НСтр("не ресурсная строка");
Исключение
	Результат = "ошибка";
КонецПопытки;
М("NSTR.INVALID", Результат);
