// Закрытие ЧтениеJSON в helper JsonВОбъект Connector.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Чтение = Новый ЧтениеJSON;
Чтение.УстановитьСтроку("{}");
ПрочитатьJSON(Чтение);
Чтение.Закрыть();
Если ТипЗнч(Чтение) = Тип("ЧтениеJSON") Тогда
	РезультатТипа = "true";
Иначе
	РезультатТипа = "false";
КонецЕсли;
М("JSON.READER.CLOSE.TYPE_STABLE", РезультатТипа);

РезультатЧтения = "принято";
Попытка
	Чтение.Прочитать();
Исключение
	РезультатЧтения = "ошибка";
КонецПопытки;
М("JSON.READER.CLOSE.READ_AFTER", РезультатЧтения);

РезультатПовтора = "принято";
Попытка
	Чтение.Закрыть();
Исключение
	РезультатПовтора = "ошибка";
КонецПопытки;
М("JSON.READER.CLOSE.REPEATED", РезультатПовтора);
