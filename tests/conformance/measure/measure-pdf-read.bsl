	П("заполнено пустая коллекция", "ошибка");
КонецПопытки;

// --- 13. Откуда берутся поля страницы ------------------------------------
//
// Свои PDF платформа пишет с `/TrimBox` и `/BleedBox`, вставленными внутрь
// `/MediaBox` (`probe-empty.pdf` — обе рамки [28.35 28.35 566.97 813.57]
// при A4, то есть отступ 10 мм со всех сторон, ровно умолчание полей
// табличного документа). Восемь страниц файла `ШестнПоля` разбирают, какая
// именно рамка и от чего меряется: 1 — обе рамки как у `probe-margins.pdf`
// (поля документа были 30/10/25/5), 2 — только `/TrimBox`, 3 — только
// `/BleedBox`, 4 — обе, но РАЗНЫЕ, 5 — только `/ArtBox`, 6 — `/CropBox`
// вместе с `/TrimBox`, 7 — `/TrimBox` шире `/MediaBox`, 8 — `/TrimBox`
// равен `/MediaBox`.

ДокПоля = Новый ДокументPDF;
Попытка
	ДокПоля.Прочитать(ПутьПоля);
	П("поля страниц", Ч(ДокПоля.Страницы.Количество()));
Исключение
	П("поля страниц", "ошибка");
КонецПопытки;

Для ИндПоля = 0 По 10 Цикл
	Попытка
		СтрнПоля = ДокПоля.Страницы[ИндПоля];
		П("поля стр" + Ч(ИндПоля), "ш=" + Строка(СтрнПоля.Ширина)
			+ " в=" + Строка(СтрнПоля.Высота)
			+ " л=" + Строка(СтрнПоля.ПолеСлева)
			+ " п=" + Строка(СтрнПоля.ПолеСправа)
			+ " вх=" + Строка(СтрнПоля.ПолеСверху)
			+ " н=" + Строка(СтрнПоля.ПолеСнизу));
	Исключение
		П("поля стр" + Ч(ИндПоля), "ошибка");
	КонецПопытки;
КонецЦикла;

