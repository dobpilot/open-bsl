// Замеры равенства РАЗНОТИПНЫХ значений, снимаемые на 8.3.27.
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-equality.bsl
//
// Правила те же, что у соседних скриптов замеров: строка `ИД<таб>ЗНАЧЕНИЕ`,
// скрипт исполняется И НАШИМ интерпретатором, отказ — маркером `<ошибка>`.
//
// ЗАЧЕМ. Замер `ARITH.BOOL.COMPARE_EQUAL` показал, что `Истина = 1` у
// платформы ИСТИНА, тогда как `"5" = 5` — ложь. То есть равенство приводит
// булево к числу, но не строку. Прежде чем повторять это у себя, нужно
// знать границы правила — и, главное, ответ на решающий вопрос: считает ли
// платформа `Истина` и `1` ОДНИМ ключом `Соответствие`. От этого зависит,
// можно ли трогать равенство, не переписывая хеширование: `Hash` и `Eq`
// обязаны согласовываться, иначе соответствие ломается молча.
//
// ОДНА СТРОКА СХОДИТЬСЯ НЕ ОБЯЗАНА: `EQ.ARRAY.FIND_BOOL_BY_NUMBER`. Метода
// `Массив.Найти` у нас пока нет вовсе (`Найти` реализован только для
// таблицы значений), и это отдельный пробел, а не про равенство. Проба
// оставлена: платформенное «не найдено» — как раз то свидетельство, что
// поиск идёт по СТРОГОМУ отношению, а не по оператору `=`.

Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Р = СтрЗаменить(Р, Символ(10), "<ПС>");
	Р = СтрЗаменить(Р, Символ(9), "<Т>");
	Р = СтрЗаменить(Р, Символ(160), "<НП>");
	Возврат Р;
КонецФункции

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Видимо(Строка(Значение)));
КонецПроцедуры

// =====================================================================
// БУЛЕВО ПРОТИВ ЧИСЛА
// =====================================================================

Р = "<ошибка>";
Попытка
	Р = Истина = 1;
Исключение
КонецПопытки;
М("EQ.BOOL.TRUE_ONE", Р);

Р = "<ошибка>";
Попытка
	Р = Ложь = 0;
Исключение
КонецПопытки;
М("EQ.BOOL.FALSE_ZERO", Р);

// Ключевой вопрос: сравнение ЧИСЛЕННОЕ или «истинность»? Если численное,
// то двойка Истине не равна.
Р = "<ошибка>";
Попытка
	Р = Истина = 2;
Исключение
КонецПопытки;
М("EQ.BOOL.TRUE_TWO", Р);

Р = "<ошибка>";
Попытка
	Р = Истина = 1.0;
Исключение
КонецПопытки;
М("EQ.BOOL.TRUE_ONE_FLOAT", Р);

Р = "<ошибка>";
Попытка
	Р = Истина <> 0;
Исключение
КонецПопытки;
М("EQ.BOOL.TRUE_NOT_ZERO", Р);

// Порядок операндов.
Р = "<ошибка>";
Попытка
	Р = 1 = Истина;
Исключение
КонецПопытки;
М("EQ.BOOL.ONE_TRUE", Р);

// =====================================================================
// ОСТАЛЬНЫЕ ПАРЫ ТИПОВ
// =====================================================================

Р = "<ошибка>";
Попытка
	Р = "5" = 5;
Исключение
КонецПопытки;
М("EQ.STRING.NUMBER", Р);

Р = "<ошибка>";
Попытка
	Р = "Да" = Истина;
Исключение
КонецПопытки;
М("EQ.STRING.BOOL", Р);

Р = "<ошибка>";
Попытка
	Р = "" = Неопределено;
Исключение
КонецПопытки;
М("EQ.STRING.UNDEFINED", Р);

Р = "<ошибка>";
Попытка
	Р = Null = Неопределено;
Исключение
КонецПопытки;
М("EQ.NULL.UNDEFINED", Р);

Р = "<ошибка>";
Попытка
	Р = 0 = Неопределено;
Исключение
КонецПопытки;
М("EQ.NUMBER.UNDEFINED", Р);

Р = "<ошибка>";
Попытка
	Р = '00010101' = 0;
Исключение
КонецПопытки;
М("EQ.DATE.NUMBER", Р);

Р = "<ошибка>";
Попытка
	Р = 1 = 1.0;
Исключение
КонецПопытки;
М("EQ.NUMBER.SAME_VALUE", Р);

// Ссылочное равенство коллекций.
Р = "<ошибка>";
Попытка
	А = Новый Массив;
	Б = Новый Массив;
	Р = "" + (А = Б) + "|" + (А = А);
Исключение
КонецПопытки;
М("EQ.ARRAY.IDENTITY", Р);

// =====================================================================
// РЕШАЮЩИЙ ВОПРОС: КЛЮЧИ СООТВЕТСТВИЯ
// =====================================================================
//
// Если `Истина` и `1` — один ключ, то равенство и хеширование у платформы
// согласованы, и повторять это надо в обоих местах разом. Если ключи
// РАЗНЫЕ, то у платформы равенство и тождество ключей — разные отношения,
// и трогать хеширование не нужно.

Р = "<ошибка>";
Попытка
	С = Новый Соответствие;
	С.Вставить(Истина, "по булеву");
	Р = "" + С.Количество() + "|" + Строка(С.Получить(1));
Исключение
КонецПопытки;
М("EQ.MAP.BOOL_KEY_BY_NUMBER", Р);

Р = "<ошибка>";
Попытка
	С = Новый Соответствие;
	С.Вставить(Истина, "по булеву");
	С.Вставить(1, "по числу");
	Р = "" + С.Количество() + "|" + Строка(С.Получить(Истина)) + "|" + Строка(С.Получить(1));
Исключение
КонецПопытки;
М("EQ.MAP.BOTH_KEYS", Р);

// То же для строки и числа — здесь равенство заведомо ложно, и ключи
// обязаны быть разными.
Р = "<ошибка>";
Попытка
	С = Новый Соответствие;
	С.Вставить("5", "по строке");
	С.Вставить(5, "по числу");
	Р = "" + С.Количество() + "|" + Строка(С.Получить("5")) + "|" + Строка(С.Получить(5));
Исключение
КонецПопытки;
М("EQ.MAP.STRING_AND_NUMBER", Р);

// =====================================================================
// ГДЕ ЕЩЁ ВИДНО РАВЕНСТВО
// =====================================================================
//
// `Найти` у массива ищет по тому же отношению или по строгому совпадению
// типов — отдельный вопрос.

Р = "<ошибка>";
Попытка
	А = Новый Массив;
	А.Добавить(Истина);
	Р = Строка(А.Найти(1));
Исключение
КонецПопытки;
М("EQ.ARRAY.FIND_BOOL_BY_NUMBER", Р);
