// Контракт: что может стоять СЛЕВА ОТ «=» в присваивании.
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-lvalue.bsl
//
// Правила те же, что у соседних контрактов: строка `МЕТКА<таб>ЗНАЧЕНИЕ`,
// скрипт исполняется И НАШИМ интерпретатором, сличение построчное. Строк
// `М()` здесь нет: реестру этот файл ничего не должен.
//
// ЗАЧЕМ. Разбор присваивания устроен так, что левая часть сначала
// разбирается КАК ВЫРАЖЕНИЕ (постфиксная цепочка), и только потом
// проверяется на пригодность быть целью. Пригодными объявлены имя,
// элемент по индексу и поле — а скобки при этом прозрачны: `(Ц)`
// разбирается в тот же узел, что и `Ц`, поэтому целью остаётся. Это
// свойство разбора, а не решение: спрашиваем платформу, согласна ли она.
//
// ПОЧЕМУ ЧЕРЕЗ `Выполнить`. Негодная цель — ошибка КОМПИЛЯЦИИ, а ошибка
// компиляции в модуле формы означает модальное окно, то есть пустой
// вывод и таймаут на весь сеанс. Внутри `Выполнить` фрагмент
// компилируется в рантайме, и отказ ловится `Попыткой` на обеих
// сторонах.
//
// ИМЕНА ПЕРЕМЕННЫХ. Скрипт исполняется в модуле управляемой формы, где
// имя, совпадающее со свойством формы, достаётся форме, а не процедуре.
// Отсюда `Метка`, `Проба`, `Текст` снаружи и `Ц` внутри фрагментов.

Процедура П(Метка, Значение)
	Сообщить(Метка + Символ(9) + Значение);
КонецПроцедуры

Функция Проба(Текст)
	Попытка
		Выполнить(Текст);
		Возврат "принято";
	Исключение
		Возврат "отказ";
	КонецПопытки;
КонецФункции

// Канарейка механизма: простое присваивание внутри фрагмента обязано
// проходить, иначе «отказ» ниже означал бы поломку пробы, а не запрет.
П("ЦЕЛЬ.ИМЯ", Проба("Ц = 4;"));

// Собственно вопрос: прозрачны ли скобки слева от «=».
П("ЦЕЛЬ.СКОБКИ", Проба("(Ц) = 4;"));
П("ЦЕЛЬ.СКОБКИ.ДВОЙНЫЕ", Проба("((Ц)) = 4;"));

П("ЦЕЛЬ.ИНДЕКС", Проба("Ц = Новый Массив(2); Ц[0] = 4;"));
П("ЦЕЛЬ.ИНДЕКС.В.СКОБКАХ", Проба("Ц = Новый Массив(2); (Ц[0]) = 4;"));

П("ЦЕЛЬ.ПОЛЕ", Проба("Ц = Новый Структура(""а"", 1); Ц.а = 4;"));
П("ЦЕЛЬ.ПОЛЕ.ЧЕРЕЗ.СКОБКИ", Проба("Ц = Новый Структура(""а"", 1); (Ц).а = 4;"));

// Заведомо негодные цели — вторая половина контракта: запрет должен быть
// именно запретом, а не общей неразборчивостью пробы. Вызов взят
// СУЩЕСТВУЮЩЕЙ функции: с неизвестным именем отказ означал бы «нет
// такой функции», а не «вызов не может быть целью».
П("ЦЕЛЬ.ВЫЗОВ", Проба("СтрДлина(""а"") = 4;"));
П("ЦЕЛЬ.ЧИСЛО", Проба("1 = 2;"));
П("ЦЕЛЬ.СТРОКА", Проба("""а"" = ""б"";"));
