// =====================================================================
// ССЫЛКА НА СУЩНОСТЬ В ДЕРЕВЕ DOM
// =====================================================================

Функция ДетиКорня(ТекстДок)
	Р = "";
	Попытка
		СтроительД = Новый ПостроительDOM;
		ЧитательД = Новый ЧтениеXML;
		ЧитательД.УстановитьСтроку(ТекстДок);
		Д = СтроительД.Прочитать(ЧитательД);
		Для Каждого У Из Д.ЭлементДокумента.ДочерниеУзлы Цикл
			Р = Р + Разделитель(Р) + Строка(У.ТипУзла) + " имя=[" + Строка(У.ИмяУзла) + "]";
		КонецЦикла;
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат Р;
КонецФункции

Функция СодержимоеКорня(ТекстДок)
	Попытка
		СтроительТ = Новый ПостроительDOM;
		ЧитательТ = Новый ЧтениеXML;
		ЧитательТ.УстановитьСтроку(ТекстДок);
		ДТ = СтроительТ.Прочитать(ЧитательТ);
		Возврат "[" + Строка(ДТ.ЭлементДокумента.ТекстовоеСодержимое) + "]";
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
КонецФункции

// Запись КОРНЯ обратно: документ целиком здесь не пишется намеренно —
// платформа выводит перед ним объявление типа документа, узла которого у
// нас нет (см. шапку).
Функция ЗаписатьКорень(ТекстДок)
	Попытка
		СтроительЗ = Новый ПостроительDOM;
		ЧитательЗ = Новый ЧтениеXML;
		ЧитательЗ.УстановитьСтроку(ТекстДок);
		ДЗ = СтроительЗ.Прочитать(ЧитательЗ);
		Писатель = Новый ЗаписьXML;
		Писатель.УстановитьСтроку();
		ЗаписьД = Новый ЗаписьDOM;
		ЗаписьД.Записать(ДЗ.ЭлементДокумента, Писатель);
		Возврат "[" + Писатель.Закрыть() + "]";
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
КонецФункции

Процедура ВзятьСсылку(ТекстДок)
	Ссылка = Неопределено;
	Попытка
		СтроительС = Новый ПостроительDOM;
		ЧитательС = Новый ЧтениеXML;
		ЧитательС.УстановитьСтроку(ТекстДок);
		ДС = СтроительС.Прочитать(ЧитательС);
		Для Каждого У Из ДС.ЭлементДокумента.ДочерниеУзлы Цикл
			Если Строка(У.ТипУзла) = "Ссылка на сущность" Тогда
				Ссылка = У;
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
КонецПроцедуры

М("DTD.DOM.CHILDREN", ДетиКорня("<!DOCTYPE к [<!ENTITY е ""хи"">]><к>раз&е;два</к>"));
М("DTD.DOM.ROOT_TEXT", СодержимоеКорня("<!DOCTYPE к [<!ENTITY е ""хи"">]><к>раз&е;два</к>"));
М("DTD.DOM.WRITE_ROOT", ЗаписатьКорень("<!DOCTYPE к [<!ENTITY е ""хи"">]><к>раз&е;два</к>"));
М("DTD.DOM.WRITE_ROOT_LAST", ЗаписатьКорень("<!DOCTYPE к [<!ENTITY е ""хи"">]><к>раз&е;</к>"));

ВзятьСсылку("<!DOCTYPE к [<!ENTITY е ""хи"">]><к>раз&е;два</к>");
М("DTD.DOM.REF_NAME", Ч("Ссылка.ИмяУзла"));
М("DTD.DOM.REF_VALUE", Ч("Строка(ТипЗнч(Ссылка.ЗначениеУзла))"));
