М("DTD.DOM.REF_PARENT", Ч("Ссылка.РодительскийУзел.ИмяУзла"));
М("DTD.DOM.REF_TYPE", Ч("Строка(ТипЗнч(Ссылка))"));
М("DTD.DOM.REF_STRING", Ч("Строка(Ссылка)"));
М("DTD.DOM.REF_TYPE_BY_NAME", Ч("Строка(Тип(""СсылкаНаСущностьDOM""))"));
М("DTD.DOM.REF_TYPE_BY_ENGLISH", Ч("Строка(Тип(""DOMEntityReference""))"));
