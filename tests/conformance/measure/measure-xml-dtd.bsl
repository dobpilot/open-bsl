// Замеры контракта DTD: объявление типа документа, внутреннее подмножество
// и сущности, снимаемые на 8.3.27.
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-xml-dtd.bsl
//
// Формат и правила те же, что у `measure-xml.bsl`: строка `ИД<таб>ЗНАЧЕНИЕ`,
// каждая проба под `Попытка`, ИД литеральные, скрипт исполняется И НАШИМ
// интерпретатором — вывод обязан совпасть построчно.
//
// ЧЕГО ЗДЕСЬ НЕТ И ПОЧЕМУ.
//
// * `ТекстовоеСодержимое` УЗЛА-ССЫЛКИ. Проба `Ссылка.ТекстовоеСодержимое`
//   на дереве от `<к>раз&е;два</к>` при объявленной НЕрекурсивной `е`
//   ВЕШАЕТ платформу: прогон снят по таймауту, вывода нет, а тот же
//   прогон без одной этой строки проходит целиком. Держать её в контракте
//   нельзя — она уносит весь сеанс.
// * УЗЕЛ ОПРЕДЕЛЕНИЯ ТИПА ДОКУМЕНТА. Платформа кладёт его в документ, и
//   его свойства измерены, но здесь он не строится — сознательное
//   расхождение, описанное в заголовке `bsl-rt/src/dom.rs` вместе со
//   снятыми значениями.
//
// ИЗМЕРЕНО 15.08.2026 на 8.3.27.2130.

Перем Ссылка;

Функция Разделитель(Накопленное)
	Если Накопленное = "" Тогда
		Возврат "";
	Иначе
		Возврат " | ";
	КонецЕсли;
КонецФункции

Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Р = СтрЗаменить(Р, Символ(10), "<ПС>");
	Р = СтрЗаменить(Р, Символ(9), "<Т>");
	Возврат Р;
КонецФункции

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Видимо(Строка(Значение)));
КонецПроцедуры

// Значение выражения либо `<ошибка>`; выражение обязано быть замкнутым или
// опираться только на переменные МОДУЛЯ.
Функция Ч(Выражение)
	Попытка
		Возврат Строка(Вычислить(Выражение));
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
КонецФункции

// Дамп потока: тип, имя и значение каждого узла.
Функция Дамп(Текст)
	Р = "";
	Попытка
		Читатель = Новый ЧтениеXML;
		Читатель.УстановитьСтроку(Текст);
		Пока Читатель.Прочитать() Цикл
			Т = Строка(Читатель.ТипУзла);
			ИмяУзла = "<ошибка>";
			Попытка
				ИмяУзла = Читатель.Имя;
			Исключение
			КонецПопытки;
			З = "<ошибка>";
			Попытка
				З = Читатель.Значение;
			Исключение
			КонецПопытки;
			Р = Р + Разделитель(Р) + Т + " имя=[" + ИмяУзла + "] знач=[" + З + "]";
		КонецЦикла;
		Читатель.Закрыть();
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат Р;
КонецФункции

// Значение первого атрибута первого элемента.
Функция ПервыйАтрибут(Текст)
	Попытка
		Читатель = Новый ЧтениеXML;
		Читатель.УстановитьСтроку(Текст);
		Читатель.Прочитать();
		Возврат "[" + Строка(Читатель.ЗначениеАтрибута(0)) + "]";
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
КонецФункции

