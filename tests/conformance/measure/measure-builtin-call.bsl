// Контракт позиции вызова глобальных имён: платформа делит их на функции
// ВСТРОЕННОГО ЯЗЫКА (оператором нельзя), функции ГЛОБАЛЬНОГО КОНТЕКСТА
// (оператором можно, результат отбрасывается) и ПРОЦЕДУРЫ (в выражении
// нельзя). Полный перебор таблицы имён снят одноразовым классификатором
// (см. комментарий у признака деления в builtin.rs); здесь — три
// канарейки, по одной на класс, исполняемые и платформой, и этим
// интерпретатором.
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-builtin-call.bsl
//
// Правила соседних контрактов: строка «МЕТКА<таб>ЗНАЧЕНИЕ», пробы — через
// «Выполнить»/«Вычислить» внутри «Попытка» (отказ компиляции фрагмента
// ловится, отказ компиляции модуля — нет), тексты ошибок в вывод не идут —
// только исход. «.expected» у файла нет и быть не должно.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

// Функция встроенного языка отдельным оператором: отказ компиляции.
Исход1 = "";
Попытка
	Выполнить("СтрЗаменить(""а"", ""а"", ""б"");");
	Исход1 = "выполнен";
Исключение
	Исход1 = "отвергнут";
КонецПопытки;
М("CALL.STMT.INTRINSIC", Исход1);

// Функция глобального контекста оператором: обычный вызов, результат
// отброшен. Нуль-арная — просто выполняется.
Исход2 = "";
Попытка
	Выполнить("ТекущаяУниверсальнаяДатаВМиллисекундах();");
	Исход2 = "выполнен";
Исключение
	Исход2 = "отвергнут";
КонецПопытки;
М("CALL.STMT.PLAIN", Исход2);

// Глобальная процедура в позиции выражения: отказ компиляции.
Исход3 = "";
Попытка
	Й = Вычислить("Сообщить(1)");
	Исход3 = "выполнен";
Исключение
	Исход3 = "отвергнут";
КонецПопытки;
М("CALL.EXPR.PROCEDURE", Исход3);
