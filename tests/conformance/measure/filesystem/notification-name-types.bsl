Функция СнимокСвойстваОповещения(ОписаниеСнимка, ИмяСвойстваСнимка)
	Попытка
		ЗначениеСнимка = Вычислить("ОписаниеСнимка." + ИмяСвойстваСнимка);
		Если ТипЗнч(ЗначениеСнимка) = Тип("Строка") Тогда
			Возврат "string:" + ЗначениеСнимка;
		Иначе
			Возврат "type:" + Строка(ТипЗнч(ЗначениеСнимка));
		КонецЕсли;
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

Процедура ПробаИмени(ИдПробы, ИмяПробы)
	ПредставлениеПробы = Строка(ИмяПробы);
	Для Каждого РольПробы Из СтрРазделить("успех,ошибка", ",") Цикл
		ПолучательПробы = Новый Массив;
		Попытка
			Если РольПробы = "успех" Тогда
				ОписаниеПробы = Вычислить("Новый ОписаниеОповещения(ИмяПробы, ПолучательПробы)");
				СохраненноеИмя = ОписаниеПробы.ИмяПроцедуры;
			Иначе
				ОписаниеПробы = Вычислить("Новый ОписаниеОповещения(""Добавить"", ПолучательПробы, 7, ИмяПробы, ПолучательПробы)");
				СохраненноеИмя = ОписаниеПробы.ИмяПроцедурыОбработкиОшибки;
			КонецЕсли;
			Сообщить(ИдПробы + "." + РольПробы + Символ(9)
				+ "ok|string=" + ПредставлениеПробы
				+ "|stored=" + СохраненноеИмя);
		Исключение
			Сообщить(ИдПробы + "." + РольПробы + Символ(9)
				+ "error|string=" + ПредставлениеПробы);
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

