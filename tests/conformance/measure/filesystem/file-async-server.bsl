// Серверная доступность асинхронного поиска и методов чтения метаданных.
Процедура ПробаФайловАсинхСервера(ИдентификаторАсинх, ВыражениеАсинх)
	ФайлАсинхПробы = Новый Файл("/tmp");
	Попытка
		ЗначениеАсинхПробы = Вычислить(ВыражениеАсинх);
		РезультатАсинхПробы = "ok|" + Строка(ТипЗнч(ЗначениеАсинхПробы));
	Исключение
		ОшибкаАсинхПробы = ИнформацияОбОшибке();
		РезультатАсинхПробы = "error|" + ОшибкаАсинхПробы.Описание;
		Если ОшибкаАсинхПробы.Причина <> Неопределено Тогда
			РезультатАсинхПробы = РезультатАсинхПробы + "|cause=" + ОшибкаАсинхПробы.Причина.Описание;
		КонецЕсли;
	КонецПопытки;
	Сообщить(ИдентификаторАсинх + Символ(9) + РезультатАсинхПробы);
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-async-server-1");
ПробаФайловАсинхСервера("find.async.ru", "НайтиФайлыАсинх(""/tmp"")");
ПробаФайловАсинхСервера("find.async.en", "FindFilesAsync(""/tmp"")");
ПробаФайловАсинхСервера("find.async.missing", "НайтиФайлыАсинх(""/open-bsl-nonexistent-directory"")");
ПробаФайловАсинхСервера("find.async.recursive.undefined", "НайтиФайлыАсинх(""/tmp"", ""open-bsl-no-such-entry"", Неопределено)");
ПробаФайловАсинхСервера("file.exists.async", "ФайлАсинхПробы.СуществуетАсинх()");
ПробаФайловАсинхСервера("file.isfile.async", "ФайлАсинхПробы.ЭтоФайлАсинх()");
ПробаФайловАсинхСервера("file.isdir.async", "ФайлАсинхПробы.ЭтоКаталогАсинх()");
ПробаФайловАсинхСервера("file.size.async", "ФайлАсинхПробы.РазмерАсинх()");
ПробаФайловАсинхСервера("file.readonly.async", "ФайлАсинхПробы.ПолучитьТолькоЧтениеАсинх()");
ПробаФайловАсинхСервера("file.hidden.async", "ФайлАсинхПробы.ПолучитьНевидимостьАсинх()");
ПробаФайловАсинхСервера("file.time.async", "ФайлАсинхПробы.ПолучитьВремяИзмененияАсинх()");
ПробаФайловАсинхСервера("file.timeutc.async", "ФайлАсинхПробы.ПолучитьУниверсальноеВремяИзмененияАсинх()");
ПробаФайловАсинхСервера("file.tempdir.async", "КаталогВременныхФайловАсинх()");
Сообщить("file.end" + Символ(9) + "file-async-server-1");
