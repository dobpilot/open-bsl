// Серверная проба операционного пути ТекстовыйДокумент.Прочитать/Записать.

Функция ЗаписатьТекстовыйДокументКрая(ПутьТекстовогоДокументаКрая)
	Попытка
		ДокументКрая = Новый ТекстовыйДокумент;
		ДокументКрая.УстановитьТекст("1");
		ДокументКрая.Записать(ПутьТекстовогоДокументаКрая);
		Возврат "ok";
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

Функция ПрочитатьТекстовыйДокументКрая(ПутьТекстовогоДокументаКрая)
	Попытка
		ДокументКрая = Новый ТекстовыйДокумент;
		ДокументКрая.Прочитать(ПутьТекстовогоДокументаКрая);
		Возврат "ok:" + ДокументКрая.ПолучитьТекст();
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

Процедура ПробаТекстовогоДокументаКрая(ИдТекстовогоДокументаКрая,
		КодСимволаТекстовогоДокументаКрая,
		СимволВНачалеТекстовогоДокументаКрая, ВидТекстовогоДокументаКрая)
	КореньТекстовогоДокументаКрая = "";
	Попытка
		КореньТекстовогоДокументаКрая = ПолучитьИмяВременногоФайла(
			".file-textdoc-io-edges");
		СоздатьКаталог(КореньТекстовогоДокументаКрая);
		БазовыйПутьТекстовогоДокументаКрая =
			КореньТекстовогоДокументаКрая + "/leaf";
		Если ВидТекстовогоДокументаКрая = "writer" Тогда
			ИсходныйТекстТекстовогоДокументаКрая = "ABC";
		Иначе
			ИсходныйТекстТекстовогоДокументаКрая = "1";
		КонецЕсли;
		ИсходныеДанныеТекстовогоДокументаКрая = ПолучитьДвоичныеДанныеИзСтроки(
			ИсходныйТекстТекстовогоДокументаКрая,
			КодировкаТекста.UTF8, Ложь);
		ИсходныеДанныеТекстовогоДокументаКрая.Записать(
			БазовыйПутьТекстовогоДокументаКрая);
		Если СимволВНачалеТекстовогоДокументаКрая Тогда
			ИсходныйПутьТекстовогоДокументаКрая =
				КореньТекстовогоДокументаКрая + "/"
				+ Символ(КодСимволаТекстовогоДокументаКрая) + "leaf";
		Иначе
			ИсходныйПутьТекстовогоДокументаКрая =
				БазовыйПутьТекстовогоДокументаКрая
				+ Символ(КодСимволаТекстовогоДокументаКрая);
		КонецЕсли;
		Если ВидТекстовогоДокументаКрая = "writer" Тогда
			СтатусТекстовогоДокументаКрая = ЗаписатьТекстовыйДокументКрая(
				ИсходныйПутьТекстовогоДокументаКрая);
			Попытка
				БайтыТекстовогоДокументаКрая = ПолучитьHexСтрокуИзДвоичныхДанных(
					Новый ДвоичныеДанные(БазовыйПутьТекстовогоДокументаКрая));
			Исключение
				БайтыТекстовогоДокументаКрая = "error";
			КонецПопытки;
			РезультатТекстовогоДокументаКрая = СтатусТекстовогоДокументаКрая
				+ ":" + БайтыТекстовогоДокументаКрая;
		Иначе
			РезультатТекстовогоДокументаКрая = ПрочитатьТекстовыйДокументКрая(
				ИсходныйПутьТекстовогоДокументаКрая);
		КонецЕсли;
		Сообщить(ИдТекстовогоДокументаКрая + "." + ВидТекстовогоДокументаКрая
			+ Символ(9) + РезультатТекстовогоДокументаКрая);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдТекстовогоДокументаКрая
			+ "." + ВидТекстовогоДокументаКрая + ":"
			+ ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньТекстовогоДокументаКрая <> "" Тогда
		Попытка
			УдалитьФайлы(КореньТекстовогоДокументаКрая);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9)
				+ ИдТекстовогоДокументаКрая + "." + ВидТекстовогоДокументаКрая);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-textdoc-io-edges-1");
Для Каждого КодТекстовогоДокументаКрая Из СтрРазделить(
		"0|9|10|13|32|127|133|160|8203|65279", "|") Цикл
	Для Каждого ВидТекстовогоДокументаКрая Из СтрРазделить(
			"writer|reader", "|") Цикл
		ПробаТекстовогоДокументаКрая(
			"textdoc.suffix." + КодТекстовогоДокументаКрая,
			Число(КодТекстовогоДокументаКрая), Ложь,
			ВидТекстовогоДокументаКрая);
		Если КодТекстовогоДокументаКрая = "0"
				И ВидТекстовогоДокументаКрая = "writer" Тогда
			ПробаТекстовогоДокументаКрая("textdoc.prefix.0", 0, Истина,
				ВидТекстовогоДокументаКрая);
		КонецЕсли;
	КонецЦикла;
КонецЦикла;
Сообщить("file.end" + Символ(9) + "file-textdoc-io-edges-1");
