// Все setter работают только с собственным файлом; рабочий каталог не меняется.
Процедура ПробаАргументаАтрибута(ФайлАргументаАтрибута, КореньАргументаАтрибута, ИдАргументаАтрибута, ВыражениеАргументаАтрибута)
	ЗначениеАргументаАтрибута = Вычислить(ВыражениеАргументаАтрибута);
	ИменаМетодовАтрибута = СтрРазделить("УстановитьТолькоЧтение,SetReadOnly,УстановитьНевидимость,SetHidden", ",");
	ИдМетодовАтрибута = СтрРазделить("readonly.ru,readonly.en,hidden.ru,hidden.en", ",");
	Для НомерМетодаАтрибута = 0 По 3 Цикл
		Для НачальноеЗначениеАтрибута = 0 По 1 Цикл
			ФайлАргументаАтрибута.УстановитьТолькоЧтение(НачальноеЗначениеАтрибута = 1);
			ОшибкаАргументаАтрибута = "";
			Попытка
				Выполнить("ФайлАргументаАтрибута." + ИменаМетодовАтрибута[НомерМетодаАтрибута] + "(ЗначениеАргументаАтрибута);");
				ИтогАргументаАтрибута = "ok";
			Исключение
				ИтогАргументаАтрибута = "error";
				ИнформацияАргументаАтрибута = ИнформацияОбОшибке();
				Пока ИнформацияАргументаАтрибута.Причина <> Неопределено Цикл
					ИнформацияАргументаАтрибута = ИнформацияАргументаАтрибута.Причина;
				КонецЦикла;
				ОшибкаАргументаАтрибута = ИнформацияАргументаАтрибута.Описание;
			КонецПопытки;
			ИдРезультатаАтрибута = "attribute." + ИдАргументаАтрибута + "." + ИдМетодовАтрибута[НомерМетодаАтрибута] + "." + Строка(НачальноеЗначениеАтрибута);
			Сообщить(ИдРезультатаАтрибута + Символ(9) + ИтогАргументаАтрибута
				+ "|readonly=" + ?(ФайлАргументаАтрибута.ПолучитьТолькоЧтение(), "1", "0")
				+ "|hidden=" + ?(ФайлАргументаАтрибута.ПолучитьНевидимость(), "1", "0")
				+ "|bytes=" + Строка(ФайлАргументаАтрибута.Размер()));
			Если ОшибкаАргументаАтрибута <> "" Тогда
				ОшибкаАргументаАтрибута = СтрЗаменить(ОшибкаАргументаАтрибута, КореньАргументаАтрибута, "<root>");
				ОшибкаАргументаАтрибута = СтрЗаменить(СтрЗаменить(СтрЗаменить(ОшибкаАргументаАтрибута, Символ(13), "<CR>"), Символ(10), "<LF>"), Символ(9), "<TAB>");
				Сообщить(ИдРезультатаАтрибута + ".detail" + Символ(9) + ОшибкаАргументаАтрибута);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-attribute-arguments-1");
Попытка
	Сообщить("context.compatibility" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
Исключение
	Сообщить("context.compatibility" + Символ(9) + "unavailable");
КонецПопытки;
КореньАргументовАтрибута = ПолучитьИмяВременногоФайла(".attribute-arguments");
Попытка
	СоздатьКаталог(КореньАргументовАтрибута);
	БайтыАргументовАтрибута = ПолучитьДвоичныеДанныеИзСтроки("abc", КодировкаТекста.UTF8, Ложь);
	БайтыАргументовАтрибута.Записать(КореньАргументовАтрибута + "/data");
	ФайлАргументовАтрибута = Новый Файл(КореньАргументовАтрибута + "/data");
	ПробыАргументовАтрибута = СтрРазделить("true=Истина|false=Ложь|zero=0|one=1|negative=-1|two=2|fraction=0.1|negative_fraction=-0.1|ru_true=""Истина""|ru_false=""Ложь""|en_true=""True""|en_false=""False""|mixed=""tRuE""|space="" Истина ""|tab=Символ(9) + ""False"" + Символ(9)|nbsp=Символ(160) + ""True"" + Символ(160)|one_text=""1""|zero_text=""0""|empty=""""|blank="" ""|yes=""Да""|no=""Нет""|nul=""True"" + Символ(0) + ""False""|undefined=Неопределено|null=Null|array=Новый Массив|structure=Новый Структура|date=Дата(2020,1,2)", "|");
	Для Каждого ПробаТекстаАтрибута Из ПробыАргументовАтрибута Цикл
		РазделениеПробыАтрибута = СтрНайти(ПробаТекстаАтрибута, "=");
		ПробаАргументаАтрибута(ФайлАргументовАтрибута, КореньАргументовАтрибута,
			Лев(ПробаТекстаАтрибута, РазделениеПробыАтрибута - 1), Сред(ПробаТекстаАтрибута, РазделениеПробыАтрибута + 1));
	КонецЦикла;
Исключение
	Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Попытка
	ФайлАргументовАтрибута.УстановитьТолькоЧтение(Ложь);
	УдалитьФайлы(КореньАргументовАтрибута);
Исключение
	Сообщить("file.cleanup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Сообщить("file.end" + Символ(9) + "file-attribute-arguments-1");
