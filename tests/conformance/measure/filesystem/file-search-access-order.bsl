Функция ГлубиннаяОшибкаПоиска(ИнформацияПоиска)
	Пока ИнформацияПоиска.Причина <> Неопределено Цикл
		ИнформацияПоиска = ИнформацияПоиска.Причина;
	КонецЦикла;
	Возврат СтрЗаменить(СтрЗаменить(СтрЗаменить(ИнформацияПоиска.Описание, Символ(13), "<CR>"), Символ(10), "<LF>"), Символ(9), "<TAB>");
КонецФункции

Процедура ПробаСинхронногоПоиска(ИмяМетодаПоиска, ИдМетодаПоиска, ЗначениеРекурсииПоиска, ИдЗначенияПоиска)
	ИдПробыПоиска = "order.sync." + ИдМетодаПоиска + "." + ИдЗначенияПоиска;
	Попытка
		РезультатПоиска = Вычислить(ИмяМетодаПоиска + "(""/tmp/open-bsl-search-access-order-denied"", ""*"", ЗначениеРекурсииПоиска)");
		Сообщить(ИдПробыПоиска + Символ(9) + "ok|count=" + Строка(РезультатПоиска.Количество()));
	Исключение
		Сообщить(ИдПробыПоиска + Символ(9) + "error");
		Сообщить(ИдПробыПоиска + ".detail" + Символ(9) + ГлубиннаяОшибкаПоиска(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

Асинх Функция ПробаАсинхронногоПоиска(ИмяМетодаПоиска, ИдМетодаПоиска, ЗначениеРекурсииПоиска, ИдЗначенияПоиска)
	ИдПробыПоиска = "order.async." + ИдМетодаПоиска + "." + ИдЗначенияПоиска;
	СтадияПоиска = "call";
	Попытка
		ОбещаниеПоиска = Вычислить(ИмяМетодаПоиска + "(""/tmp/open-bsl-search-access-order-denied"", ""*"", ЗначениеРекурсииПоиска)");
		СтадияПоиска = "await";
		РезультатПоиска = Ждать ОбещаниеПоиска;
		Сообщить(ИдПробыПоиска + Символ(9) + "ok|count=" + Строка(РезультатПоиска.Количество()));
	Исключение
		Сообщить(ИдПробыПоиска + Символ(9) + "error|stage=" + СтадияПоиска);
		Сообщить(ИдПробыПоиска + ".detail" + Символ(9) + ГлубиннаяОшибкаПоиска(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Асинх Процедура ИзмеритьПорядокОшибокПоиска()
	Сообщить("file.begin" + Символ(9) + "file-search-access-order-1");
	Для Каждого ИдМетодаПоиска Из СтрРазделить("ru,en", ",") Цикл
		ИмяСинхронногоМетодаПоиска = ?(ИдМетодаПоиска = "ru", "НайтиФайлы", "FindFiles");
		ИмяАсинхронногоМетодаПоиска = ?(ИдМетодаПоиска = "ru", "НайтиФайлыАсинх", "FindFilesAsync");
		ПробаСинхронногоПоиска(ИмяСинхронногоМетодаПоиска, ИдМетодаПоиска, Ложь, "valid");
		ПробаСинхронногоПоиска(ИмяСинхронногоМетодаПоиска, ИдМетодаПоиска, "Да", "invalid");
		Ждать ПробаАсинхронногоПоиска(ИмяАсинхронногоМетодаПоиска, ИдМетодаПоиска, Ложь, "valid");
		Ждать ПробаАсинхронногоПоиска(ИмяАсинхронногоМетодаПоиска, ИдМетодаПоиска, "Да", "invalid");
	КонецЦикла;
	Сообщить("file.end" + Символ(9) + "file-search-access-order-1");
	Попытка
		Выполнить("ЗавершитьРаботуСистемы(Ложь);");
	Исключение
	КонецПопытки;
КонецПроцедуры

ИзмеритьПорядокОшибокПоиска();
