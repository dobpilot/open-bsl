Функция ПричинаОтказаОбработчика(ОшибкаПробы)
	Пока ОшибкаПробы.Причина <> Неопределено Цикл
		ОшибкаПробы = ОшибкаПробы.Причина;
	КонецЦикла;
	Возврат ОшибкаПробы.Описание;
КонецФункции

Процедура ПроверитьОбработчик(ИдОбработчика, ИмяОбработчика)
	Для НомерРоли = 1 По 2 Цикл
		Попытка
			Если НомерРоли = 1 Тогда
				ОписаниеОбработчика = Вычислить("Новый ОписаниеОповещения(ИмяОбработчика, ЭтотОбъект)");
				СохраненноеИмя = ОписаниеОбработчика.ИмяПроцедуры;
			Иначе
				ОписаниеОбработчика = Вычислить("Новый ОписаниеОповещения(""ПараДанных"", ЭтотОбъект, Неопределено, ИмяОбработчика, ЭтотОбъект)");
				СохраненноеИмя = ОписаниеОбработчика.ИмяПроцедурыОбработкиОшибки;
			КонецЕсли;
			Сообщить(ИдОбработчика + "." + Строка(НомерРоли) + Символ(9) + "ok|name=" + СохраненноеИмя);
		Исключение
			Сообщить(ИдОбработчика + "." + Строка(НомерРоли) + Символ(9) + "error:" + ПричинаОтказаОбработчика(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "notification-handlers-1");
ПроверитьОбработчик("handler.zero", "НольДанных");
ПроверитьОбработчик("handler.one", "ОдниДанные");
ПроверитьОбработчик("handler.two", "ПараДанных");
ПроверитьОбработчик("handler.three", "ТриДанных");
ПроверитьОбработчик("handler.optional", "НеобязательныеДанные");
ПроверитьОбработчик("handler.private", "ЗакрытаяПроцедура");
ПроверитьОбработчик("handler.function", "ЭкспортнаяФункция");
ПроверитьОбработчик("handler.private_function", "ЗакрытаяФункция");
ПроверитьОбработчик("handler.async", "АсинхроннаяФункция");
ПроверитьОбработчик("handler.upper", "ПАРАДАННЫХ");
ПроверитьОбработчик("handler.spaces", " ПараДанных ");
ПроверитьОбработчик("handler.empty", "");
ПроверитьОбработчик("handler.number", 123);
ПроверитьОбработчик("handler.undefined", Неопределено);
ИменаМодуляПробы = СтрРазделить("ЭтотОбъект,ThisObject,ЭтаФорма,ThisForm", ",");
Для Каждого ИмяМодуляПробы Из ИменаМодуляПробы Цикл
	Попытка
		СовпадениеМодуля = Вычислить(ИмяМодуляПробы + " = ЭтотОбъект");
		Сообщить("module." + ИмяМодуляПробы + Символ(9) + ?(СовпадениеМодуля, "same", "different"));
	Исключение
		Сообщить("module." + ИмяМодуляПробы + Символ(9) + "error:" + ПричинаОтказаОбработчика(ИнформацияОбОшибке()));
	КонецПопытки;
КонецЦикла;
Сообщить("file.end" + Символ(9) + "notification-handlers-1");
Попытка
	Выполнить("ЗавершитьРаботуСистемы(Ложь)");
