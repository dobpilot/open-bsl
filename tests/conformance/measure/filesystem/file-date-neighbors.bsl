// Соседние значения времени: каждый setter работает только с собственным файлом.
// Ошибка getter не скрывает остальные случаи и обычные контрольные даты.

Функция ПоляСоседнейДаты(Знач ДатаСоседнейПробы)
    Возврат Строка(Год(ДатаСоседнейПробы)) + "-" + Строка(Месяц(ДатаСоседнейПробы))
        + "-" + Строка(День(ДатаСоседнейПробы)) + " " + Строка(Час(ДатаСоседнейПробы))
        + ":" + Строка(Минута(ДатаСоседнейПробы)) + ":" + Строка(Секунда(ДатаСоседнейПробы));
КонецФункции

Процедура ВывестиСоседнююПробу(КлючСоседнейПробы, ВыражениеСоседнейПробы, ДатаСоседнейПробы)
    Попытка
        ЗначениеСоседнейПробы = Вычислить(ВыражениеСоседнейПробы);
        Если ТипЗнч(ЗначениеСоседнейПробы) = Тип("Дата") Тогда
            ТекстСоседнейПробы = "Date:" + ПоляСоседнейДаты(ЗначениеСоседнейПробы)
                + "|delta=" + Строка(ЗначениеСоседнейПробы - Дата(1, 1, 1));
        ИначеЕсли ТипЗнч(ЗначениеСоседнейПробы) = Тип("Булево") Тогда
            ТекстСоседнейПробы = "Boolean:" + ?(ЗначениеСоседнейПробы, "1", "0");
        Иначе
            ТекстСоседнейПробы = Строка(ТипЗнч(ЗначениеСоседнейПробы)) + ":" + Строка(ЗначениеСоседнейПробы);
        КонецЕсли;
    Исключение
        ТекстСоседнейПробы = "error:" + ИнформацияОбОшибке().Описание;
    КонецПопытки;
    ТекстСоседнейПробы = СтрЗаменить(ТекстСоседнейПробы, Символ(13), "\r");
    ТекстСоседнейПробы = СтрЗаменить(ТекстСоседнейПробы, Символ(10), "\n");
    Сообщить(КлючСоседнейПробы + Символ(9) + ТекстСоседнейПробы);
КонецПроцедуры

Процедура ОперацииСоседнейДаты(ПрефиксСоседнейПробы, ДатаСоседнейПробы)
    ВывестиСоседнююПробу(ПрефиксСоседнейПробы + ".value", "ДатаСоседнейПробы", ДатаСоседнейПробы);
    ВывестиСоседнююПробу(ПрефиксСоседнейПробы + ".gt_max", "ДатаСоседнейПробы > Дата(9999,12,31,23,59,59)", ДатаСоседнейПробы);
    ВывестиСоседнююПробу(ПрефиксСоседнейПробы + ".add0_equal", "ДатаСоседнейПробы + 0 = ДатаСоседнейПробы", ДатаСоседнейПробы);
    ВывестиСоседнююПробу(ПрефиксСоседнейПробы + ".add1", "ДатаСоседнейПробы + 1", ДатаСоседнейПробы);
    ВывестиСоседнююПробу(ПрефиксСоседнейПробы + ".sub1", "ДатаСоседнейПробы - 1", ДатаСоседнейПробы);
    ВывестиСоседнююПробу(ПрефиксСоседнейПробы + ".add_tick", "ДатаСоседнейПробы + 0.0001", ДатаСоседнейПробы);
    ВывестиСоседнююПробу(ПрефиксСоседнейПробы + ".sub_tick", "ДатаСоседнейПробы - 0.0001", ДатаСоседнейПробы);
    ВывестиСоседнююПробу(ПрефиксСоседнейПробы + ".add_half", "ДатаСоседнейПробы + 0.5", ДатаСоседнейПробы);
    ВывестиСоседнююПробу(ПрефиксСоседнейПробы + ".add_half_equal", "ДатаСоседнейПробы + 0.5 = ДатаСоседнейПробы", ДатаСоседнейПробы);
    ВывестиСоседнююПробу(ПрефиксСоседнейПробы + ".add1_reverse", "(ДатаСоседнейПробы + 1) - 1 = ДатаСоседнейПробы", ДатаСоседнейПробы);
    ВывестиСоседнююПробу(ПрефиксСоседнейПробы + ".week_equal", "НачалоНедели(ДатаСоседнейПробы) = ДатаСоседнейПробы", ДатаСоседнейПробы);
    ВывестиСоседнююПробу(ПрефиксСоседнейПробы + ".format_ru", "Формат(ДатаСоседнейПробы, ""Л=ru_RU;ДФ=dd.MM.yyyy HH:mm:ss"")", ДатаСоседнейПробы);
    ВывестиСоседнююПробу(ПрефиксСоседнейПробы + ".format_en", "Формат(ДатаСоседнейПробы, ""L=en_US;DF=yyyy-MM-dd HH:mm:ss"")", ДатаСоседнейПробы);
КонецПроцедуры

Процедура ПробаСоседнегоВремени(ПутьСоседнейПробы, КлючСоседнейПробы, Знач АргументСоседнейПробы, МестнаяСоседняяПроба)
    ОбъектСоседнейПробы = Новый Файл(ПутьСоседнейПробы);
    Попытка
        Если МестнаяСоседняяПроба Тогда
            ОбъектСоседнейПробы.УстановитьВремяИзменения(АргументСоседнейПробы);
        Иначе
            ОбъектСоседнейПробы.УстановитьУниверсальноеВремяИзменения(АргументСоседнейПробы);
        КонецЕсли;
    Исключение
        Сообщить(КлючСоседнейПробы + ".set_error" + Символ(9) + ИнформацияОбОшибке().Описание);
        Возврат;
    КонецПопытки;
    Попытка
        ДатаСоседнейПробы = ОбъектСоседнейПробы.ПолучитьУниверсальноеВремяИзменения();
        ОперацииСоседнейДаты(КлючСоседнейПробы, ДатаСоседнейПробы);
        ПовторСоседнейПробы = ОбъектСоседнейПробы.ПолучитьУниверсальноеВремяИзменения();
        НовыйОбъектСоседнейПробы = Новый Файл(ПутьСоседнейПробы);
        НоваяДатаСоседнейПробы = НовыйОбъектСоседнейПробы.ПолучитьУниверсальноеВремяИзменения();
        Сообщить(КлючСоседнейПробы + ".repeat" + Символ(9)
            + ?(ДатаСоседнейПробы = ПовторСоседнейПробы, "1", "0") + "|"
            + ?(ДатаСоседнейПробы = НоваяДатаСоседнейПробы, "1", "0"));
    Исключение
        Сообщить(КлючСоседнейПробы + ".get_error" + Символ(9) + ИнформацияОбОшибке().Описание);
    КонецПопытки;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-date-neighbors-1");
ОперацииСоседнейДаты("control.empty", Дата(1, 1, 1));
ОперацииСоседнейДаты("control.ordinary", Дата(2020, 1, 15, 12, 34, 56));
ПутьСоседнейПробы = ПолучитьИмяВременногоФайла(".date-neighbors");
Попытка
    ДанныеСоседнейПробы = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
    ДанныеСоседнейПробы.Записать(ПутьСоседнейПробы);
    СмещенияСоседнейПробы = Новый Массив;
    СмещенияСоседнейПробы.Добавить(0);
    СмещенияСоседнейПробы.Добавить(1);
    СмещенияСоседнейПробы.Добавить(2);
    СмещенияСоседнейПробы.Добавить(9016);
    СмещенияСоседнейПробы.Добавить(9017);
    СмещенияСоседнейПробы.Добавить(9018);
    СмещенияСоседнейПробы.Добавить(86400);
    Для Каждого СмещениеСоседнейПробы Из СмещенияСоседнейПробы Цикл
        ПробаСоседнегоВремени(ПутьСоседнейПробы, "utc.min+" + Строка(СмещениеСоседнейПробы), Дата(1, 1, 1) + СмещениеСоседнейПробы, Ложь);
        ПробаСоседнегоВремени(ПутьСоседнейПробы, "local.min+" + Строка(СмещениеСоседнейПробы), Дата(1, 1, 1) + СмещениеСоседнейПробы, Истина);
    КонецЦикла;
    ПробаСоседнегоВремени(ПутьСоседнейПробы, "utc.epoch-1", Дата(1969,12,31,23,59,59), Ложь);
    ПробаСоседнегоВремени(ПутьСоседнейПробы, "utc.epoch", Дата(1970,1,1), Ложь);
    ПробаСоседнегоВремени(ПутьСоседнейПробы, "utc.ordinary", Дата(2020,1,15,12,34,56), Ложь);
    ПробаСоседнегоВремени(ПутьСоседнейПробы, "utc.max", Дата(9999,12,31,23,59,59), Ложь);
Исключение
    Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Попытка
    УдалитьФайлы(ПутьСоседнейПробы);
Исключение
    Сообщить("file.cleanup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Сообщить("file.end" + Символ(9) + "file-date-neighbors-1");
