// Серверная проба операционного пути ТабличныйДокумент.Прочитать/Записать.

Функция ЗаписатьТабличныйДокументКрая(ПутьТабличногоДокументаКрая)
	Попытка
		ДокументКрая = Новый ТабличныйДокумент;
		ДокументКрая.Область(1, 1, 1, 1).Текст = "1";
		ДокументКрая.Записать(ПутьТабличногоДокументаКрая);
		Возврат "ok";
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

Функция ПрочитатьТабличныйДокументКрая(ПутьТабличногоДокументаКрая)
	Попытка
		ДокументКрая = Новый ТабличныйДокумент;
		ДокументКрая.Прочитать(ПутьТабличногоДокументаКрая);
		Возврат "ok:" + ДокументКрая.Область(1, 1, 1, 1).Текст;
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

Процедура ПробаТабличногоДокументаКрая(ИдТабличногоДокументаКрая,
		КодСимволаТабличногоДокументаКрая,
		СимволВНачалеТабличногоДокументаКрая, ВидТабличногоДокументаКрая)
	КореньТабличногоДокументаКрая = "";
	Попытка
		КореньТабличногоДокументаКрая = ПолучитьИмяВременногоФайла(
			".file-spreadsheet-io-edges");
		СоздатьКаталог(КореньТабличногоДокументаКрая);
		БазовыйПутьТабличногоДокументаКрая =
			КореньТабличногоДокументаКрая + "/leaf";
		Если ВидТабличногоДокументаКрая = "writer" Тогда
			ИсходныеДанныеТабличногоДокументаКрая = ПолучитьДвоичныеДанныеИзСтроки(
				"ABC", КодировкаТекста.UTF8, Ложь);
			ИсходныеДанныеТабличногоДокументаКрая.Записать(
				БазовыйПутьТабличногоДокументаКрая);
		Иначе
			ИсходныйДокументТабличногоДокументаКрая = Новый ТабличныйДокумент;
			ИсходныйДокументТабличногоДокументаКрая.Область(1, 1, 1, 1).Текст = "1";
			ИсходныйДокументТабличногоДокументаКрая.Записать(
				БазовыйПутьТабличногоДокументаКрая);
		КонецЕсли;
		Если СимволВНачалеТабличногоДокументаКрая Тогда
			ИсходныйПутьТабличногоДокументаКрая =
				КореньТабличногоДокументаКрая + "/"
				+ Символ(КодСимволаТабличногоДокументаКрая) + "leaf";
		Иначе
			ИсходныйПутьТабличногоДокументаКрая =
				БазовыйПутьТабличногоДокументаКрая
				+ Символ(КодСимволаТабличногоДокументаКрая);
		КонецЕсли;
		Если ВидТабличногоДокументаКрая = "writer" Тогда
			СтатусТабличногоДокументаКрая = ЗаписатьТабличныйДокументКрая(
				ИсходныйПутьТабличногоДокументаКрая);
			ДанныеРезультатаТабличногоДокументаКрая = Новый ДвоичныеДанные(
				БазовыйПутьТабличногоДокументаКрая);
			РазмерТабличногоДокументаКрая =
				ДанныеРезультатаТабличногоДокументаКрая.Размер();
			РезультатТабличногоДокументаКрая = СтатусТабличногоДокументаКрая
				+ ":" + ?(РазмерТабличногоДокументаКрая = 3, "base", "changed");
		Иначе
			РезультатТабличногоДокументаКрая = ПрочитатьТабличныйДокументКрая(
				ИсходныйПутьТабличногоДокументаКрая);
		КонецЕсли;
		Сообщить(ИдТабличногоДокументаКрая + "." + ВидТабличногоДокументаКрая
			+ Символ(9) + РезультатТабличногоДокументаКрая);
	Исключение
		Сообщить("file.setup_error" + Символ(9)
			+ ИдТабличногоДокументаКрая + "." + ВидТабличногоДокументаКрая
			+ ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньТабличногоДокументаКрая <> "" Тогда
		Попытка
			УдалитьФайлы(КореньТабличногоДокументаКрая);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9)
				+ ИдТабличногоДокументаКрая + "." + ВидТабличногоДокументаКрая);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-spreadsheet-io-edges-1");
Для Каждого КодТабличногоДокументаКрая Из СтрРазделить(
		"0|9|10|13|32|127|133|160|8203|65279", "|") Цикл
	Для Каждого ВидТабличногоДокументаКрая Из СтрРазделить(
			"writer|reader", "|") Цикл
		ПробаТабличногоДокументаКрая(
			"spreadsheet.suffix." + КодТабличногоДокументаКрая,
			Число(КодТабличногоДокументаКрая), Ложь,
			ВидТабличногоДокументаКрая);
		Если КодТабличногоДокументаКрая = "0"
				И ВидТабличногоДокументаКрая = "writer" Тогда
			ПробаТабличногоДокументаКрая("spreadsheet.prefix.0", 0, Истина,
				ВидТабличногоДокументаКрая);
		КонецЕсли;
	КонецЦикла;
КонецЦикла;
Сообщить("file.end" + Символ(9) + "file-spreadsheet-io-edges-1");
