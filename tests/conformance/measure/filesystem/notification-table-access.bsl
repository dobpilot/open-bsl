// Доступ таблицы/колонок/строки как методы получателей оповещения.
Процедура ПробаМетодаТаблицы(ИдМетодаТаблицы, ВидПолучателяТаблицы, ИндексМетодаТаблицы, ВызовМетодаТаблицы, ВыражениеМетодаТаблицы)
	ТаблицаМетодаПробы = Новый ТаблицаЗначений;
	ТаблицаМетодаПробы.Колонки.Добавить("Левая");
	ТаблицаМетодаПробы.Колонки.Добавить("Правая");
	СтрокаМетодаПервая = ТаблицаМетодаПробы.Добавить();
	СтрокаМетодаПервая.Левая = 10;
	СтрокаМетодаПервая.Правая = 20;
	СтрокаМетодаВторая = ТаблицаМетодаПробы.Добавить();
	СтрокаМетодаВторая.Левая = 30;
	СтрокаМетодаВторая.Правая = 40;
	Если ВидПолучателяТаблицы = 1 Тогда
		ПолучательМетодаТаблицы = ТаблицаМетодаПробы;
	ИначеЕсли ВидПолучателяТаблицы = 2 Тогда
		ПолучательМетодаТаблицы = ТаблицаМетодаПробы.Колонки;
	Иначе
		ПолучательМетодаТаблицы = СтрокаМетодаПервая;
	КонецЕсли;
	Попытка
		Если ВыражениеМетодаТаблицы Тогда
			РезультатМетодаТаблицы = Вычислить(ВызовМетодаТаблицы);
			Если ВидПолучателяТаблицы = 1 Тогда
				ИтогМетодаТаблицы = "ok|value=" + Строка(РезультатМетодаТаблицы.Левая);
			ИначеЕсли ВидПолучателяТаблицы = 2 Тогда
				ИтогМетодаТаблицы = "ok|value=" + РезультатМетодаТаблицы.Имя;
			Иначе
				ИтогМетодаТаблицы = "ok|value=" + Строка(РезультатМетодаТаблицы);
			КонецЕсли;
		Иначе
			Выполнить(ВызовМетодаТаблицы);
			ИтогМетодаТаблицы = "ok";
		КонецЕсли;
	Исключение
		ИтогМетодаТаблицы = "error";
	КонецПопытки;
	Сообщить(ИдМетодаТаблицы + Символ(9) + ИтогМетодаТаблицы
		+ "|row=" + Строка(СтрокаМетодаПервая.Левая) + "," + Строка(СтрокаМетодаПервая.Правая)
		+ "|other=" + Строка(СтрокаМетодаВторая.Левая) + "," + Строка(СтрокаМетодаВторая.Правая)
		+ "|rows=" + Строка(ТаблицаМетодаПробы.Количество()) + "|cols=" + Строка(ТаблицаМетодаПробы.Колонки.Количество()));
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "table-access-1");
Попытка
	Сообщить("context.compatibility" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
Исключение
	Сообщить("context.compatibility" + Символ(9) + "unavailable");
КонецПопытки;
