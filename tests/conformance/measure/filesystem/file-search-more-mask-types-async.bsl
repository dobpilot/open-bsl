// Дополнительные типы маски синхронного и асинхронного поиска. Каждый тип
// проверяется в собственном дереве; разделители в представлении отвергаются
// до I/O, чтобы значение не могло расширить область пробы.

Асинх Функция ПробаТипаМаскиПоиска(ИдТипаМаски, ЗначениеМаски, ПрямоеСовпадение = Истина)
	КореньТипаМаски = "";
	ПредставлениеТипаМаски = Строка(ЗначениеМаски);
	ПредставлениеБезопасно = ПрямоеСовпадение
		И ПредставлениеТипаМаски <> ""
		И СтрНайти(ПредставлениеТипаМаски, "/") = 0
		И СтрНайти(ПредставлениеТипаМаски, "\") = 0;
	Попытка
		КореньТипаМаски = ПолучитьИмяВременногоФайла(".search-more-mask-types");
		СоздатьКаталог(КореньТипаМаски);
		ДанныеТипаМаски = ПолучитьДвоичныеДанныеИзСтроки("x", КодировкаТекста.UTF8, Ложь);
		ИмяФайлаТипаМаски = ?(ПредставлениеБезопасно, ПредставлениеТипаМаски, "keep.bin");
		ДанныеТипаМаски.Записать(КореньТипаМаски + "/" + ИмяФайлаТипаМаски);
		Попытка
			СинхронныйТипаМаски = НайтиФайлы(КореньТипаМаски, ЗначениеМаски);
			ИтогСинхронногоТипаМаски = "ok:" + Строка(СинхронныйТипаМаски.Количество());
		Исключение
			ИтогСинхронногоТипаМаски = "error";
		КонецПопытки;
		Попытка
			ОбещаниеТипаМаски = НайтиФайлыАсинх(КореньТипаМаски, ЗначениеМаски);
			АсинхронныйТипаМаски = Ждать ОбещаниеТипаМаски;
			ИтогАсинхронногоТипаМаски = "ok:" + Строка(АсинхронныйТипаМаски.Количество());
		Исключение
			ИтогАсинхронногоТипаМаски = "error";
		КонецПопытки;
		Сообщить(ИдТипаМаски + Символ(9)
			+ "safe=" + ?(ПредставлениеБезопасно, "1", "0")
			+ "|sync=" + ИтогСинхронногоТипаМаски
			+ "|async=" + ИтогАсинхронногоТипаМаски);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдТипаМаски + ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньТипаМаски <> "" Тогда
		Попытка
			УдалитьФайлы(КореньТипаМаски);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдТипаМаски);
		КонецПопытки;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Асинх Процедура ИзмеритьТипыМаскиПоиска()
	Сообщить("file.begin" + Символ(9) + "search-more-mask-types-async-1");
	Попытка
		Сообщить("context.effective" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
	Исключение
		Сообщить("context.effective_unavailable" + Символ(9) + "error");
	КонецПопытки;
	Ждать ПробаТипаМаскиПоиска("find.more.date", Дата(2020, 1, 15, 12, 34, 56), Ложь);
	Ждать ПробаТипаМаскиПоиска("find.more.map", Новый Соответствие);
	Ждать ПробаТипаМаскиПоиска("find.more.fixed_array", Новый ФиксированныйМассив(Новый Массив));
	Ждать ПробаТипаМаскиПоиска("find.more.fixed_structure", Новый ФиксированнаяСтруктура(Новый Структура));
	Ждать ПробаТипаМаскиПоиска("find.more.value_table", Вычислить("Новый ТаблицаЗначений"));
	Ждать ПробаТипаМаскиПоиска("find.more.uuid", Новый УникальныйИдентификатор("00112233-4455-6677-8899-aabbccddeeff"));
	Ждать ПробаТипаМаскиПоиска("find.more.file", Новый Файл("inside"));
	Ждать ПробаТипаМаскиПоиска("find.more.binary", ПолучитьДвоичныеДанныеИзСтроки("AB", КодировкаТекста.UTF8, Ложь));
	Ждать ПробаТипаМаскиПоиска("find.more.enum", КодировкаТекста.UTF8);
	Ждать ПробаТипаМаскиПоиска("find.more.type", Тип("Строка"));
	Сообщить("file.end" + Символ(9) + "search-more-mask-types-async-1");
	Попытка
		Выполнить("ЗавершитьРаботуСистемы(Ложь);");
	Исключение
	КонецПопытки;
КонецПроцедуры

ИзмеритьТипыМаскиПоиска();
