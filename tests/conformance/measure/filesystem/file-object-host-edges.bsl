// Серверная матрица видов host-объектов, ошибок metadata и корневых форм Файл.
// Для 1С placeholder заменяется корнем дерева, созданного средствами ОС.

Функция ПовторитьДляГраницыФайла(СимволГраницыФайла, КоличествоГраницыФайла)
	РезультатГраницыФайла = "";
	Для ИндексГраницыФайла = 1 По КоличествоГраницыФайла Цикл
		РезультатГраницыФайла = РезультатГраницыФайла + СимволГраницыФайла;
	КонецЦикла;
	Возврат РезультатГраницыФайла;
КонецФункции

Функция ЭкранироватьГраницуФайла(ТекстГраницыФайла, КореньГраницыФайла)
	Возврат СтрЗаменить(Строка(ТекстГраницыФайла), КореньГраницыФайла, "<root>");
КонецФункции

Процедура ПробаБулеваМетодаФайла(ИдГраницыФайла, ОбъектГраницыФайла,
		ИмяМетодаГраницыФайла)
	Попытка
		ЗначениеГраницыФайла = Вычислить(
			"ОбъектГраницыФайла." + ИмяМетодаГраницыФайла + "()");
		Если ЗначениеГраницыФайла Тогда
			РезультатГраницыФайла = "ok:1";
		Иначе
			РезультатГраницыФайла = "ok:0";
		КонецЕсли;
	Исключение
		РезультатГраницыФайла = "error";
	КонецПопытки;
	Сообщить(ИдГраницыФайла + "." + ИмяМетодаГраницыФайла
		+ Символ(9) + РезультатГраницыФайла);
КонецПроцедуры

Процедура ПробаМетаданныхФайла(ИдГраницыФайла, ПутьГраницыФайла)
	ОбъектГраницыФайла = Новый Файл(ПутьГраницыФайла);
	ПробаБулеваМетодаФайла(ИдГраницыФайла, ОбъектГраницыФайла, "Существует");
	ПробаБулеваМетодаФайла(ИдГраницыФайла, ОбъектГраницыФайла, "ЭтоФайл");
	ПробаБулеваМетодаФайла(ИдГраницыФайла, ОбъектГраницыФайла, "ЭтоКаталог");
	Попытка
		РезультатГраницыФайла = "ok:" + Строка(ОбъектГраницыФайла.Размер());
	Исключение
		РезультатГраницыФайла = "error";
	КонецПопытки;
	Сообщить(ИдГраницыФайла + ".Размер" + Символ(9) + РезультатГраницыФайла);
КонецПроцедуры

Процедура ПробаСвойствГраницыФайла(ИдГраницыФайла, ПутьГраницыФайла,
		КореньГраницыФайла)
	ОбъектГраницыФайла = Новый Файл(ПутьГраницыФайла);
	Сообщить("path." + ИдГраницыФайла + Символ(9)
		+ "full=" + ЭкранироватьГраницуФайла(ОбъектГраницыФайла.ПолноеИмя,
			КореньГраницыФайла)
		+ "|path=" + ЭкранироватьГраницуФайла(ОбъектГраницыФайла.Путь,
			КореньГраницыФайла)
		+ "|name=" + ОбъектГраницыФайла.Имя
		+ "|base=" + ОбъектГраницыФайла.ИмяБезРасширения
		+ "|ext=" + ОбъектГраницыФайла.Расширение);
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "object-host-edges-1");
КореньГраницыФайла = "__OPEN_BSL_FILE_HOST_EDGES_ROOT__";
СвойКореньГраницыФайла = Лев(КореньГраницыФайла, 1) = "_";
Попытка
	Если СвойКореньГраницыФайла Тогда
		КореньГраницыФайла = ПолучитьИмяВременногоФайла(".object-host-edges");
		КодПодготовкиГраницыФайла = 0;
		ЗапуститьПриложение("/bin/mkdir -p " + КореньГраницыФайла + "/directory",
			"/tmp", Истина, КодПодготовкиГраницыФайла);
		ЗапуститьПриложение("/bin/mkdir -p " + КореньГраницыФайла + "/denied",
			"/tmp", Истина, КодПодготовкиГраницыФайла);
		ДанныеГраницыФайла = ПолучитьДвоичныеДанныеИзСтроки("",
			КодировкаТекста.UTF8, Ложь);
		ДанныеГраницыФайла.Записать(КореньГраницыФайла + "/regular.txt");
		ДанныеГраницыФайла.Записать(КореньГраницыФайла + "/parent-file");
		ЗапуститьПриложение("/usr/bin/mkfifo " + КореньГраницыФайла + "/pipe",
			"/tmp", Истина, КодПодготовкиГраницыФайла);
		ЗапуститьПриложение("/usr/bin/python3 -c ""import socket;s=socket.socket(socket.AF_UNIX);s.bind('"
			+ КореньГраницыФайла + "/socket');s.close()""",
			"/tmp", Истина, КодПодготовкиГраницыФайла);
		ЗапуститьПриложение("/bin/ln -s " + КореньГраницыФайла + "/missing "
			+ КореньГраницыФайла + "/dangling",
			"/tmp", Истина, КодПодготовкиГраницыФайла);
		ЗапуститьПриложение("/bin/ln -s " + КореньГраницыФайла + "/loop "
			+ КореньГраницыФайла + "/loop",
			"/tmp", Истина, КодПодготовкиГраницыФайла);
		ЗапуститьПриложение("/bin/chmod 000 " + КореньГраницыФайла + "/denied",
			"/tmp", Истина, КодПодготовкиГраницыФайла);
	КонецЕсли;

	ПробаМетаданныхФайла("regular", КореньГраницыФайла + "/regular.txt");
	ПробаМетаданныхФайла("directory", КореньГраницыФайла + "/directory");
	ПробаМетаданныхФайла("fifo", КореньГраницыФайла + "/pipe");
	ПробаМетаданныхФайла("socket", КореньГраницыФайла + "/socket");
	ПробаМетаданныхФайла("dangling", КореньГраницыФайла + "/dangling");
	ПробаМетаданныхФайла("loop", КореньГраницыФайла + "/loop");
	ПробаМетаданныхФайла("notdir", КореньГраницыФайла + "/parent-file/child");
	ПробаМетаданныхФайла("long", КореньГраницыФайла + "/"
		+ ПовторитьДляГраницыФайла("x", 300));
	ПробаМетаданныхФайла("denied", КореньГраницыФайла + "/denied/child");

	ПробаСвойствГраницыФайла("empty", "", КореньГраницыФайла);
	ПробаСвойствГраницыФайла("dot", ".", КореньГраницыФайла);
	ПробаСвойствГраницыФайла("dot-slash", "./", КореньГраницыФайла);
	ПробаСвойствГраницыФайла("parent", "..", КореньГраницыФайла);
	ПробаСвойствГраницыФайла("parent-slash", "../", КореньГраницыФайла);
	ПробаСвойствГраницыФайла("slash", "/", КореньГраницыФайла);
	ПробаСвойствГраницыФайла("double-slash", "//", КореньГраницыФайла);
	ПробаСвойствГраницыФайла("triple-slash", "///", КореньГраницыФайла);
Исключение
	Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;

Если СвойКореньГраницыФайла Тогда
	Попытка
		КодОчисткиГраницыФайла = 0;
		ЗапуститьПриложение("/bin/chmod 700 " + КореньГраницыФайла + "/denied",
			"/tmp", Истина, КодОчисткиГраницыФайла);
		ЗапуститьПриложение("/bin/rm -rf " + КореньГраницыФайла,
			"/tmp", Истина, КодОчисткиГраницыФайла);
	Исключение
		Сообщить("file.cleanup_error" + Символ(9) + "object-host-edges");
	КонецПопытки;
КонецЕсли;
Сообщить("file.end" + Символ(9) + "object-host-edges-1");
