// Серверная проба операционного пути чтения и записи ZIP-архивов.

Функция ЗаписатьАрхивКрая(ВидАрхиваКрая, ПутьАрхиваКрая,
		ПутьИсточникаАрхиваКрая)
	Попытка
		Если ВидАрхиваКрая = "writer.zip.ctor" Тогда
			ПисательАрхиваКрая = Новый ЗаписьZipФайла(ПутьАрхиваКрая);
		ИначеЕсли ВидАрхиваКрая = "writer.zip.open" Тогда
			ПисательАрхиваКрая = Новый ЗаписьZipФайла;
			ПисательАрхиваКрая.Открыть(ПутьАрхиваКрая);
		ИначеЕсли ВидАрхиваКрая = "writer.archive.ctor" Тогда
			ПисательАрхиваКрая = Новый ЗаписьФайлаАрхива(ПутьАрхиваКрая);
		Иначе
			ПисательАрхиваКрая = Новый ЗаписьФайлаАрхива;
			ПисательАрхиваКрая.Открыть(ПутьАрхиваКрая);
		КонецЕсли;
		ПисательАрхиваКрая.Добавить(ПутьИсточникаАрхиваКрая);
		ПисательАрхиваКрая.Записать();
		Возврат "ok";
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

Функция ПрочитатьАрхивКрая(ВидАрхиваКрая, ПутьАрхиваКрая)
	Попытка
		Если ВидАрхиваКрая = "reader.zip.ctor" Тогда
			ЧитательАрхиваКрая = Новый ЧтениеZipФайла(ПутьАрхиваКрая);
		ИначеЕсли ВидАрхиваКрая = "reader.zip.open" Тогда
			ЧитательАрхиваКрая = Новый ЧтениеZipФайла;
			ЧитательАрхиваКрая.Открыть(ПутьАрхиваКрая);
		ИначеЕсли ВидАрхиваКрая = "reader.archive.ctor" Тогда
			ЧитательАрхиваКрая = Новый ЧтениеФайлаАрхива(ПутьАрхиваКрая);
		Иначе
			ЧитательАрхиваКрая = Новый ЧтениеФайлаАрхива;
			ЧитательАрхиваКрая.Открыть(ПутьАрхиваКрая);
		КонецЕсли;
		Возврат "ok:" + Строка(ЧитательАрхиваКрая.Элементы.Количество());
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

Процедура ПробаАрхиваКрая(ИдАрхиваКрая, КодСимволаАрхиваКрая,
		СимволВНачалеАрхиваКрая, ВидАрхиваКрая)
	КореньАрхиваКрая = "";
	Попытка
		КореньАрхиваКрая = ПолучитьИмяВременногоФайла(".file-archive-io-edges");
		СоздатьКаталог(КореньАрхиваКрая);
		БазовыйПутьАрхиваКрая = КореньАрхиваКрая + "/leaf.zip";
		ПутьИсточникаАрхиваКрая = КореньАрхиваКрая + "/source.txt";
		ДанныеИсточникаАрхиваКрая = ПолучитьДвоичныеДанныеИзСтроки(
			"1", КодировкаТекста.UTF8, Ложь);
		ДанныеИсточникаАрхиваКрая.Записать(ПутьИсточникаАрхиваКрая);
		Если Лев(ВидАрхиваКрая, 6) = "writer" Тогда
			БазовыеДанныеАрхиваКрая = ПолучитьДвоичныеДанныеИзСтроки(
				"ABC", КодировкаТекста.UTF8, Ложь);
			БазовыеДанныеАрхиваКрая.Записать(БазовыйПутьАрхиваКрая);
		Иначе
			ПодготовкаАрхиваКрая = Новый ЗаписьZipФайла(БазовыйПутьАрхиваКрая);
			ПодготовкаАрхиваКрая.Добавить(ПутьИсточникаАрхиваКрая);
			ПодготовкаАрхиваКрая.Записать();
		КонецЕсли;
		Если СимволВНачалеАрхиваКрая Тогда
			ИсходныйПутьАрхиваКрая = КореньАрхиваКрая + "/"
				+ Символ(КодСимволаАрхиваКрая) + "leaf.zip";
		Иначе
			ИсходныйПутьАрхиваКрая = БазовыйПутьАрхиваКрая
				+ Символ(КодСимволаАрхиваКрая);
		КонецЕсли;
		Если Лев(ВидАрхиваКрая, 6) = "writer" Тогда
			СтатусАрхиваКрая = ЗаписатьАрхивКрая(ВидАрхиваКрая,
				ИсходныйПутьАрхиваКрая, ПутьИсточникаАрхиваКрая);
			ДанныеРезультатаАрхиваКрая = Новый ДвоичныеДанные(
				БазовыйПутьАрхиваКрая);
			РазмерРезультатаАрхиваКрая = ДанныеРезультатаАрхиваКрая.Размер();
			РезультатАрхиваКрая = СтатусАрхиваКрая + ":"
				+ ?(РазмерРезультатаАрхиваКрая = 3, "base", "changed");
		Иначе
			РезультатАрхиваКрая = ПрочитатьАрхивКрая(ВидАрхиваКрая,
				ИсходныйПутьАрхиваКрая);
		КонецЕсли;
		Сообщить(ИдАрхиваКрая + "." + ВидАрхиваКрая + Символ(9)
			+ РезультатАрхиваКрая);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдАрхиваКрая + "."
			+ ВидАрхиваКрая + ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньАрхиваКрая <> "" Тогда
		Попытка
			УдалитьФайлы(КореньАрхиваКрая);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдАрхиваКрая + "."
				+ ВидАрхиваКрая);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-archive-io-edges-1");
Для Каждого КодАрхиваКрая Из СтрРазделить("0|9|10|13|32|127|133|160|8203|65279", "|") Цикл
	Для Каждого ВидАрхиваКрая Из СтрРазделить(
			"writer.zip.ctor|writer.zip.open|writer.archive.ctor|writer.archive.open|"
			+ "reader.zip.ctor|reader.zip.open|reader.archive.ctor|reader.archive.open", "|") Цикл
		ПробаАрхиваКрая("archive.suffix." + КодАрхиваКрая,
			Число(КодАрхиваКрая), Ложь, ВидАрхиваКрая);
		Если КодАрхиваКрая = "0" И Лев(ВидАрхиваКрая, 6) = "writer" Тогда
			ПробаАрхиваКрая("archive.prefix.0", 0, Истина, ВидАрхиваКрая);
		КонецЕсли;
	КонецЦикла;
КонецЦикла;
Сообщить("file.end" + Символ(9) + "file-archive-io-edges-1");
