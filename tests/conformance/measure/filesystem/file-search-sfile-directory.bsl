// Серверная характеризация каталога со звёздочкой в физическом имени.
// Для 1С placeholder заменяется корнем дерева, созданного средствами ОС.

Функция ЭкранироватьКаталогSFile(ТекстКаталогаSFile, КореньКаталогаSFile)
	Возврат СтрЗаменить(Строка(ТекстКаталогаSFile), КореньКаталогаSFile, "<root>");
КонецФункции

Функция ОписаниеКаталогаSFile(ОбъектКаталогаSFile, КореньКаталогаSFile)
	РезультатКаталогаSFile = ЭкранироватьКаталогSFile(
		ОбъектКаталогаSFile.ПолноеИмя, КореньКаталогаSFile);
	Попытка
		РезультатКаталогаSFile = РезультатКаталогаSFile + "|dir="
			+ Строка(ОбъектКаталогаSFile.ЭтоКаталог());
	Исключение
		РезультатКаталогаSFile = РезультатКаталогаSFile + "|dir=error";
	КонецПопытки;
	Возврат РезультатКаталогаSFile;
КонецФункции

Процедура ПробаКаталогаSFile(ИдКаталогаSFile, КореньКаталогаSFile,
		МаскаКаталогаSFile, РекурсивноКаталогSFile)
	Попытка
		РезультатыКаталогаSFile = НайтиФайлы(КореньКаталогаSFile,
			МаскаКаталогаSFile, РекурсивноКаталогSFile);
		ТекстКаталогаSFile = "ok:" + Строка(РезультатыКаталогаSFile.Количество());
		Для ИндексКаталогаSFile = 0 По РезультатыКаталогаSFile.Количество() - 1 Цикл
			ТекстКаталогаSFile = ТекстКаталогаSFile + "|"
				+ ОписаниеКаталогаSFile(РезультатыКаталогаSFile[ИндексКаталогаSFile],
					КореньКаталогаSFile);
		КонецЦикла;
	Исключение
		ТекстКаталогаSFile = "error";
	КонецПопытки;
	Сообщить(ИдКаталогаSFile + Символ(9) + ТекстКаталогаSFile);
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "search-sfile-directory-1");
КореньКаталогаSFile = "__OPEN_BSL_SFILE_DIRECTORY_ROOT__";
СвойКореньКаталогаSFile = Лев(КореньКаталогаSFile, 1) = "_";
Попытка
	Если СвойКореньКаталогаSFile Тогда
		КореньКаталогаSFile = ПолучитьИмяВременногоФайла(".search-sfile-directory");
		КодСозданияКаталогаSFile = 0;
		ЗапуститьПриложение("/bin/mkdir -p " + КореньКаталогаSFile + "/a*",
			"/tmp", Истина, КодСозданияКаталогаSFile);
		Если КодСозданияКаталогаSFile <> 0 Тогда
			ВызватьИсключение "mkdir";
		КонецЕсли;
		ДанныеКаталогаSFile = ПолучитьДвоичныеДанныеИзСтроки("ABC",
			КодировкаТекста.UTF8, Ложь);
		ДанныеКаталогаSFile.Записать(КореньКаталогаSFile + "/a*/deep.txt");
	КонецЕсли;

	ПробаКаталогаSFile("flat.literal", КореньКаталогаSFile, "a\*", Ложь);
	ПробаКаталогаSFile("flat.name", КореньКаталогаSFile, "a*", Ложь);
	ПробаКаталогаSFile("flat.question", КореньКаталогаSFile, "a?", Ложь);
	ПробаКаталогаSFile("flat.all", КореньКаталогаSFile, "*", Ложь);
	ПробаКаталогаSFile("recursive.literal", КореньКаталогаSFile, "a\*", Истина);
	ПробаКаталогаSFile("recursive.name", КореньКаталогаSFile, "a*", Истина);
	ПробаКаталогаSFile("recursive.question", КореньКаталогаSFile, "a?", Истина);
	ПробаКаталогаSFile("recursive.all", КореньКаталогаSFile, "*", Истина);
	ПробаКаталогаSFile("recursive.txt", КореньКаталогаSFile, "*.txt", Истина);
	Попытка
		ПрямойКаталогSFile = НайтиФайлы(КореньКаталогаSFile + "/a*");
		Сообщить("direct.path" + Символ(9) + "ok:"
			+ Строка(ПрямойКаталогSFile.Количество()));
	Исключение
		Сообщить("direct.path" + Символ(9) + "error");
	КонецПопытки;
Исключение
	Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;

Если СвойКореньКаталогаSFile Тогда
	Попытка
		КодОчисткиКаталогаSFile = 0;
		ЗапуститьПриложение("/bin/rm -rf " + КореньКаталогаSFile,
			"/tmp", Истина, КодОчисткиКаталогаSFile);
	Исключение
		Сообщить("file.cleanup_error" + Символ(9) + "search-sfile-directory");
	КонецПопытки;
КонецЕсли;
Сообщить("file.end" + Символ(9) + "search-sfile-directory-1");
