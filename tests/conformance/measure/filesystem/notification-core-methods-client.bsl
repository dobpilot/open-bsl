// Снимок имён BUILTIN_METHOD_NAMES; измеритель не вызывает проверяемые методы.
Функция ПоследняяПричинаМатрицы(ОшибкаПробы)
	Пока ОшибкаПробы.Причина <> Неопределено Цикл
		ОшибкаПробы = ОшибкаПробы.Причина;
	КонецЦикла;
	Возврат ОшибкаПробы.Описание;
КонецФункции

Процедура ПроверитьТипМатрицы(ИдТипа, ВыражениеТипа, ИменаМетодов)
	Попытка
		Если СтрНачинаетсяС(ИдТипа, "table") Тогда
			ТаблицаПробы = Вычислить("Новый ТаблицаЗначений");
			ТаблицаПробы.Колонки.Добавить("К");
			ТаблицаПробы.Добавить();
			ТаблицаПробы.Индексы.Добавить("К");
		КонецЕсли;
		Если ИдТипа = "list.item" Тогда
			СписокПробы = Новый СписокЗначений;
			СписокПробы.Добавить(1);
		КонецЕсли;
		ПолучательМатрицы = Вычислить(ВыражениеТипа);
		МаскаМетодов = "";
		Для Каждого ИмяМетодаМатрицы Из ИменаМетодов Цикл
			Попытка
				ОписаниеМатрицы = Вычислить("Новый ОписаниеОповещения(ИмяМетодаМатрицы, ПолучательМатрицы)");
				МаскаМетодов = МаскаМетодов + "1";
			Исключение
				ПричинаМатрицы = ПоследняяПричинаМатрицы(ИнформацияОбОшибке());
				Если СтрНачинаетсяС(ПричинаМатрицы, "The export method is not found:") Тогда
					МаскаМетодов = МаскаМетодов + "0";
				Иначе
					МаскаМетодов = МаскаМетодов + "?";
					Сообщить(ИдТипа + ".error." + ИмяМетодаМатрицы + Символ(9) + ПричинаМатрицы);
				КонецЕсли;
			КонецПопытки;
		КонецЦикла;
		Сообщить(ИдТипа + Символ(9) + Строка(ТипЗнч(ПолучательМатрицы)) + "|" + МаскаМетодов);
	Исключение
		Сообщить(ИдТипа + ".setup_error" + Символ(9) + ПоследняяПричинаМатрицы(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

