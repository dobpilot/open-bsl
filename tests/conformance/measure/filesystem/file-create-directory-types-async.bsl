// Типы аргумента СоздатьКаталог в тонком клиенте. Процесс ENTERPRISE должен
// запускаться с --enterprise-cwd-in-io: принятые относительные представления
// тогда остаются внутри приватных артефактов runner.

Функция ПредставлениеТипаСоздания(ЗначениеТипаСоздания)
	Возврат СтрЗаменить(
		СтрЗаменить(
			СтрЗаменить(Строка(ЗначениеТипаСоздания), Символ(0), "<NUL>"),
			Символ(9), "<TAB>"),
		Символ(10), "<LF>");
КонецФункции

Функция СуществуетПредставлениеСоздания(ПредставлениеСоздания)
	Если ПредставлениеСоздания = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	ФайлПредставленияСоздания = Новый Файл(ПредставлениеСоздания);
	Возврат ФайлПредставленияСоздания.Существует();
КонецФункции

Процедура ОчиститьПредставлениеСоздания(ИдТипаСоздания, ПредставлениеСоздания, ЭтапСоздания)
	Если ПредставлениеСоздания = "" Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ФайлОчисткиСоздания = Новый Файл(ПредставлениеСоздания);
		Если ФайлОчисткиСоздания.Существует() Тогда
			УдалитьФайлы(ПредставлениеСоздания);
		КонецЕсли;
	Исключение
		Сообщить("file.cleanup_error" + Символ(9) + ИдТипаСоздания + ":" + ЭтапСоздания);
	КонецПопытки;
КонецПроцедуры

Асинх Функция ПробаТипаСоздания(ИдТипаСоздания, ЗначениеТипаСоздания)
	ПредставлениеСоздания = Строка(ЗначениеТипаСоздания);
	Попытка
		СоздатьКаталог(ЗначениеТипаСоздания);
		ИтогСинхронногоТипаСоздания = "ok";
	Исключение
		ИтогСинхронногоТипаСоздания = "error";
	КонецПопытки;
	ИтогСинхронногоТипаСоздания = ИтогСинхронногоТипаСоздания
		+ ":exists=" + ?(СуществуетПредставлениеСоздания(ПредставлениеСоздания), "1", "0");
	ОчиститьПредставлениеСоздания(ИдТипаСоздания, ПредставлениеСоздания, "sync");
	Попытка
		ОбещаниеТипаСоздания = СоздатьКаталогАсинх(ЗначениеТипаСоздания);
		РезультатТипаСоздания = Ждать ОбещаниеТипаСоздания;
		ИтогАсинхронногоТипаСоздания = "ok:" + Строка(ТипЗнч(РезультатТипаСоздания))
			+ ":same=" + ?(РезультатТипаСоздания = ЗначениеТипаСоздания, "1", "0");
	Исключение
		ИтогАсинхронногоТипаСоздания = "error";
	КонецПопытки;
	ИтогАсинхронногоТипаСоздания = ИтогАсинхронногоТипаСоздания
		+ ":exists=" + ?(СуществуетПредставлениеСоздания(ПредставлениеСоздания), "1", "0");
	ОчиститьПредставлениеСоздания(ИдТипаСоздания, ПредставлениеСоздания, "async");
	Сообщить(ИдТипаСоздания + Символ(9)
		+ "repr=" + ПредставлениеТипаСоздания(ЗначениеТипаСоздания)
		+ "|sync=" + ИтогСинхронногоТипаСоздания
		+ "|async=" + ИтогАсинхронногоТипаСоздания);
	Возврат Неопределено;
КонецФункции

Асинх Процедура ИзмеритьТипыСоздания()
	Сообщить("file.begin" + Символ(9) + "create-directory-types-async-1");
	Попытка
		Сообщить("context.effective" + Символ(9)
			+ Строка(Вычислить("Метаданные.РежимСовместимости")));
	Исключение
		Сообщить("context.effective_unavailable" + Символ(9) + "error");
	КонецПопытки;

	Ждать ПробаТипаСоздания("create.type.string", "plain");
	Ждать ПробаТипаСоздания("create.type.number", 17);
	Ждать ПробаТипаСоздания("create.type.true", Истина);
	Ждать ПробаТипаСоздания("create.type.false", Ложь);
	Ждать ПробаТипаСоздания("create.type.date", Дата(2020, 1, 15, 12, 34, 56));
	Ждать ПробаТипаСоздания("create.type.array", Новый Массив);
	Ждать ПробаТипаСоздания("create.type.structure", Новый Структура);
	Ждать ПробаТипаСоздания("create.type.map", Новый Соответствие);
	Ждать ПробаТипаСоздания("create.type.fixed_array", Новый ФиксированныйМассив(Новый Массив));
	Ждать ПробаТипаСоздания("create.type.fixed_structure", Новый ФиксированнаяСтруктура(Новый Структура));
	Ждать ПробаТипаСоздания("create.type.fixed_map", Новый ФиксированноеСоответствие(Новый Соответствие));
	Ждать ПробаТипаСоздания("create.type.value_table", Вычислить("Новый ТаблицаЗначений"));
	Ждать ПробаТипаСоздания("create.type.value_list", Новый СписокЗначений);
	Ждать ПробаТипаСоздания("create.type.uuid", Новый УникальныйИдентификатор("00112233-4455-6677-8899-aabbccddeeff"));
	Ждать ПробаТипаСоздания("create.type.file", Новый Файл("inside"));
	Ждать ПробаТипаСоздания("create.type.binary", ПолучитьДвоичныеДанныеИзСтроки("AB", КодировкаТекста.UTF8, Ложь));
	Ждать ПробаТипаСоздания("create.type.enum", КодировкаТекста.UTF8);
	Ждать ПробаТипаСоздания("create.type.type", Тип("Строка"));
	Ждать ПробаТипаСоздания("create.type.undefined", Неопределено);
	Ждать ПробаТипаСоздания("create.type.null", Null);

	Сообщить("file.end" + Символ(9) + "create-directory-types-async-1");
	Попытка
		Выполнить("ЗавершитьРаботуСистемы(Ложь);");
	Исключение
	КонецПопытки;
КонецПроцедуры

ИзмеритьТипыСоздания();
