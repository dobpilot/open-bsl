Асинх Процедура КлиентскийКонтекстИндексовПробы()
КонецПроцедуры

Функция НоваяТаблицаИндексовПробы()
	ТаблицаИндексовПробы = Вычислить("Новый ТаблицаЗначений");
	ТаблицаИндексовПробы.Колонки.Добавить("А");
	ТаблицаИндексовПробы.Колонки.Добавить("Б");
	СтрокаИндексовПробы = ТаблицаИндексовПробы.Добавить();
	СтрокаИндексовПробы.А = 1;
	СтрокаИндексовПробы.Б = 2;
	Возврат ТаблицаИндексовПробы;
КонецФункции

Процедура ПробаИндексовВыражением(ИдПробы, ВыражениеПробы, ЭтоВыражение)
	ТаблицаИндексовПробы = НоваяТаблицаИндексовПробы();
	Попытка
		Если ЭтоВыражение Тогда
			РезультатИндексовПробы = Вычислить(ВыражениеПробы);
			ИтогИндексовПробы = "ok:" + Строка(ТипЗнч(РезультатИндексовПробы));
		Иначе
			Выполнить(ВыражениеПробы);
			ИтогИндексовПробы = "ok";
		КонецЕсли;
	Исключение
		ИтогИндексовПробы = "error";
	КонецПопытки;
	Сообщить(ИдПробы + Символ(9) + ИтогИндексовПробы
		+ "|count=" + Строка(ТаблицаИндексовПробы.Индексы.Количество()));
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "notification-table-index-methods-client-1");
ТаблицаИндексовПробы = НоваяТаблицаИндексовПробы();
КоллекцияИндексовПробы = ТаблицаИндексовПробы.Индексы;
Сообщить("collection.type" + Символ(9) + Строка(ТипЗнч(КоллекцияИндексовПробы)));
Сообщить("collection.identity" + Символ(9) + Строка(КоллекцияИндексовПробы = ТаблицаИндексовПробы.Индексы));
Сообщить("collection.empty" + Символ(9) + Строка(КоллекцияИндексовПробы.Count()));

ИндексАПробы = КоллекцияИндексовПробы.Добавить("А");
Сообщить("add.ru" + Символ(9) + Строка(ТипЗнч(ИндексАПробы))
	+ "|alias=" + Строка(ИндексАПробы = КоллекцияИндексовПробы[0])
	+ "|count=" + Строка(КоллекцияИндексовПробы.Количество()));
ИндексБПробы = КоллекцияИндексовПробы.Add("Б");
Сообщить("add.en" + Символ(9) + Строка(ТипЗнч(ИндексБПробы))
	+ "|alias=" + Строка(ИндексБПробы = КоллекцияИндексовПробы[1])
	+ "|count=" + Строка(КоллекцияИндексовПробы.Count()));

ПробаИндексовВыражением("add.none", "ТаблицаИндексовПробы.Индексы.Add()", Истина);
ПробаИндексовВыражением("add.extra", "ТаблицаИндексовПробы.Индексы.Add(""А"", 1)", Истина);
ПробаИндексовВыражением("add.bad_column", "ТаблицаИндексовПробы.Индексы.Add(""НетКолонки"")", Истина);
ПробаИндексовВыражением("add.empty", "ТаблицаИндексовПробы.Индексы.Add("""")", Истина);
ПробаИндексовВыражением("add.multiple", "ТаблицаИндексовПробы.Индексы.Add(""А, Б"")", Истина);
ПробаИндексовВыражением("add.duplicate", "ТаблицаИндексовПробы.Индексы.Add(""А,А"")", Истина);

ТаблицаИндексовПробы = НоваяТаблицаИндексовПробы();
ПервыйИндексПробы = ТаблицаИндексовПробы.Индексы.Add("А");
ВторойИндексПробы = ТаблицаИндексовПробы.Индексы.Add("Б");
ТаблицаИндексовПробы.Индексы.Удалить(ПервыйИндексПробы);
Сообщить("delete.ru" + Символ(9) + Строка(ТаблицаИндексовПробы.Индексы.Count())
	+ "|remaining=" + Строка(ТаблицаИндексовПробы.Индексы[0] = ВторойИндексПробы));
ТаблицаИндексовПробы.Индексы.Delete(ВторойИндексПробы);
Сообщить("delete.en" + Символ(9) + Строка(ТаблицаИндексовПробы.Индексы.Count()));
ПробаИндексовВыражением("delete.none", "ТаблицаИндексовПробы.Индексы.Delete()", Ложь);
ПробаИндексовВыражением("delete.extra", "ТаблицаИндексовПробы.Индексы.Delete(ТаблицаИндексовПробы.Индексы.Add(""А""), 1)", Ложь);
ПробаИндексовВыражением("delete.expression", "ТаблицаИндексовПробы.Индексы.Delete(ТаблицаИндексовПробы.Индексы.Add(""А""))", Истина);

ТаблицаИндексовПробы = НоваяТаблицаИндексовПробы();
ТаблицаИндексовПробы.Индексы.Add("А");
ТаблицаИндексовПробы.Индексы.Очистить();
Сообщить("clear.ru" + Символ(9) + Строка(ТаблицаИндексовПробы.Индексы.Count()));
ТаблицаИндексовПробы.Индексы.Add("А");
ТаблицаИндексовПробы.Индексы.Clear();
Сообщить("clear.en" + Символ(9) + Строка(ТаблицаИндексовПробы.Индексы.Count()));
ПробаИндексовВыражением("clear.extra", "ТаблицаИндексовПробы.Индексы.Clear(1)", Ложь);
ПробаИндексовВыражением("clear.expression", "ТаблицаИндексовПробы.Индексы.Clear()", Истина);

ТаблицаИндексовПробы = НоваяТаблицаИндексовПробы();
ИсходныйИндексКопииПробы = ТаблицаИндексовПробы.Индексы.Add("А");
ТаблицаИндексовПробы.Индексы.Add("А, Б");
КопияИндексовПробы = ТаблицаИндексовПробы.Скопировать();
Сообщить("copy.indexes" + Символ(9) + Строка(КопияИндексовПробы.Индексы.Count())
	+ "|same=" + Строка(ИсходныйИндексКопииПробы = КопияИндексовПробы.Индексы[0]));
КопияИндексовПробы.Индексы.Delete(КопияИндексовПробы.Индексы[0]);
Сообщить("copy.independent" + Символ(9) + Строка(ТаблицаИндексовПробы.Индексы.Count())
	+ "|copy=" + Строка(КопияИндексовПробы.Индексы.Count()));
КопияОднойКолонкиПробы = ТаблицаИндексовПробы.Скопировать(Неопределено, "А");
Сообщить("copy.selected_column" + Символ(9) + Строка(КопияОднойКолонкиПробы.Индексы.Count()));
КопияЯвноВсехКолонокПробы = ТаблицаИндексовПробы.Скопировать(Неопределено, "А, Б");
КопияПустыхКолонокПробы = ТаблицаИндексовПробы.Скопировать(Неопределено, "");
Сообщить("copy.explicit_columns" + Символ(9) + Строка(КопияЯвноВсехКолонокПробы.Индексы.Count())
	+ "|empty=" + Строка(КопияПустыхКолонокПробы.Индексы.Count()));
КопияСтруктурыПробы = ТаблицаИндексовПробы.СкопироватьКолонки();
КопияСтруктурыОднойКолонкиПробы = ТаблицаИндексовПробы.СкопироватьКолонки("А");
Сообщить("copy_columns.indexes" + Символ(9) + Строка(КопияСтруктурыПробы.Индексы.Count())
	+ "|selected=" + Строка(КопияСтруктурыОднойКолонкиПробы.Индексы.Count()));

// Коллекция принимает измеренные методы, отдельный индекс — не получатель.
ТаблицаИндексовПробы = НоваяТаблицаИндексовПробы();
ИндексАПробы = ТаблицаИндексовПробы.Индексы.Add("А");
Для Каждого ИмяМетодаИндексов Из СтрРазделить("Количество,Count,Добавить,Add,Удалить,Delete,Очистить,Clear", ",") Цикл
	Попытка
		ОписаниеИндексовПробы = Вычислить("Новый ОписаниеОповещения(ИмяМетодаИндексов, ТаблицаИндексовПробы.Индексы)");
		ИтогОписанияИндексов = "ok";
	Исключение
		ИтогОписанияИндексов = "error";
	КонецПопытки;
	Сообщить("notify.collection." + ИмяМетодаИндексов + Символ(9) + ИтогОписанияИндексов);
КонецЦикла;
Для Каждого ИмяМетодаИндекса Из СтрРазделить("Количество,Count,НетМетода", ",") Цикл
	Попытка
		ОписаниеИндексаПробы = Вычислить("Новый ОписаниеОповещения(ИмяМетодаИндекса, ИндексАПробы)");
		ИтогОписанияИндекса = "ok";
	Исключение
		ПричинаИндексаПробы = ИнформацияОбОшибке();
		Пока ПричинаИндексаПробы.Причина <> Неопределено Цикл
			ПричинаИндексаПробы = ПричинаИндексаПробы.Причина;
		КонецЦикла;
		Если СтрНачинаетсяС(ПричинаИндексаПробы.Описание, "The export method is not found:") Тогда
			ИтогОписанияИндекса = "missing";
		Иначе
			ИтогОписанияИндекса = "receiver";
		КонецЕсли;
	КонецПопытки;
	Сообщить("notify.index." + ИмяМетодаИндекса + Символ(9) + ИтогОписанияИндекса);
КонецЦикла;

Сообщить("file.end" + Символ(9) + "notification-table-index-methods-client-1");
Попытка Выполнить("ЗавершитьРаботуСистемы(Ложь)"); Исключение КонецПопытки;
