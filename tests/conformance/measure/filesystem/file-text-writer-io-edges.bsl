// Серверная проба операционного пути конструктора ЗаписьТекста.

Функция ЗаписатьТекстомКрая(ПутьЗаписиТекстаКрая)
	ПисательКрая = Неопределено;
	Попытка
		ПисательКрая = Новый ЗаписьТекста(ПутьЗаписиТекстаКрая);
		ПисательКрая.Закрыть();
		Возврат "ok";
	Исключение
		Если ПисательКрая <> Неопределено Тогда
			Попытка
				ПисательКрая.Закрыть();
			Исключение
			КонецПопытки;
		КонецЕсли;
		Возврат "error";
	КонецПопытки;
КонецФункции

Процедура ПробаЗаписиТекстаКрая(ИдЗаписиТекстаКрая,
		КодСимволаЗаписиТекстаКрая, СимволВНачалеЗаписиТекстаКрая)
	КореньЗаписиТекстаКрая = "";
	Попытка
		КореньЗаписиТекстаКрая = ПолучитьИмяВременногоФайла(
			".file-text-writer-io-edges");
		СоздатьКаталог(КореньЗаписиТекстаКрая);
		БазовыйПутьЗаписиТекстаКрая = КореньЗаписиТекстаКрая + "/leaf";
		ИсходныеДанныеЗаписиТекстаКрая = ПолучитьДвоичныеДанныеИзСтроки("ABC",
			КодировкаТекста.UTF8, Ложь);
		ИсходныеДанныеЗаписиТекстаКрая.Записать(БазовыйПутьЗаписиТекстаКрая);
		Если СимволВНачалеЗаписиТекстаКрая Тогда
			ИсходныйПутьЗаписиТекстаКрая = КореньЗаписиТекстаКрая + "/"
				+ Символ(КодСимволаЗаписиТекстаКрая) + "leaf";
		Иначе
			ИсходныйПутьЗаписиТекстаКрая = БазовыйПутьЗаписиТекстаКрая
				+ Символ(КодСимволаЗаписиТекстаКрая);
		КонецЕсли;
		СтатусЗаписиТекстаКрая = ЗаписатьТекстомКрая(
			ИсходныйПутьЗаписиТекстаКрая);
		Попытка
			БайтыЗаписиТекстаКрая = ПолучитьHexСтрокуИзДвоичныхДанных(
				Новый ДвоичныеДанные(БазовыйПутьЗаписиТекстаКрая));
		Исключение
			БайтыЗаписиТекстаКрая = "error";
		КонецПопытки;
		Сообщить(ИдЗаписиТекстаКрая + Символ(9)
			+ СтатусЗаписиТекстаКрая + ":" + БайтыЗаписиТекстаКрая);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдЗаписиТекстаКрая + ":"
			+ ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньЗаписиТекстаКрая <> "" Тогда
		Попытка
			УдалитьФайлы(КореньЗаписиТекстаКрая);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдЗаписиТекстаКрая);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-text-writer-io-edges-1");
Для Каждого КодЗаписиТекстаКрая Из СтрРазделить(
		"0|9|10|13|32|127|133|160|8203|65279", "|") Цикл
	ПробаЗаписиТекстаКрая("text.suffix." + КодЗаписиТекстаКрая,
		Число(КодЗаписиТекстаКрая), Ложь);
	Если КодЗаписиТекстаКрая = "0" Тогда
		ПробаЗаписиТекстаКрая("text.prefix.0", 0, Истина);
	КонецЕсли;
КонецЦикла;
Сообщить("file.end" + Символ(9) + "file-text-writer-io-edges-1");
