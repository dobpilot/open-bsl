// Дополнительные безопасные границы индекса методов массива.
// Массив каждой пробы создаётся заново; большие индексы не используются
// для Вставить, чтобы измеритель не запрашивал большой объём памяти.

Процедура ПроверитьИндексМассива(ИдПробы, ИндексПробы)
	Для НомерМетодаПробы = 1 По 4 Цикл
		МассивПробы = Новый Массив;
		МассивПробы.Добавить(10);
		МассивПробы.Добавить(20);
		Если НомерМетодаПробы = 1 Тогда
			ВыражениеПробы = "МассивПробы.Получить(ИндексПробы)";
		ИначеЕсли НомерМетодаПробы = 2 Тогда
			ВыражениеПробы = "МассивПробы.Get(ИндексПробы)";
		ИначеЕсли НомерМетодаПробы = 3 Тогда
			ВыражениеПробы = "МассивПробы.Установить(ИндексПробы, 99)";
		Иначе
			ВыражениеПробы = "МассивПробы.Set(ИндексПробы, 99)";
		КонецЕсли;
		Попытка
			Если НомерМетодаПробы <= 2 Тогда
				ИтогПробы = "ok:" + Строка(Вычислить(ВыражениеПробы));
			Иначе
				Выполнить(ВыражениеПробы);
				ИтогПробы = "ok";
			КонецЕсли;
		Исключение
			ИтогПробы = "error";
		КонецПопытки;
		Сообщить(ИдПробы + "." + Строка(НомерМетодаПробы) + Символ(9)
			+ ИтогПробы + "|array=" + Строка(МассивПробы[0]) + "," + Строка(МассивПробы[1]));
	КонецЦикла;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "notification-array-index-edges-1");
ПроверитьИндексМассива("number.negative_fraction", -0.9);
ПроверитьИндексМассива("number.negative_large_fraction", -1.9);
ПроверитьИндексМассива("number.positive_subunit", 0.9);
ПроверитьИндексМассива("number.negative_zero", -0.0);
ПроверитьИндексМассива("string.spaces", " 1 ");
ПроверитьИндексМассива("string.dot_fraction", "0.9");
ПроверитьИндексМассива("string.comma_fraction", "0,9");
ПроверитьИндексМассива("string.negative_fraction", "-0.9");
ПроверитьИндексМассива("string.plus", "+1");
ПроверитьИндексМассива("string.leading_zero", "01");
ПроверитьИндексМассива("string.exponent", "1e0");
ПроверитьИндексМассива("string.empty", "");
Сообщить("file.end" + Символ(9) + "notification-array-index-edges-1");
