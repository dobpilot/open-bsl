// Серверные пробы поиска. Все пути находятся в собственном scratch-каталоге.
Процедура ПробаГраницыПоиска(ИдентификаторПоиска, КореньПробыПоиска, ВыражениеПоиска)
	Попытка
		МассивПробыПоиска = Вычислить(ВыражениеПоиска);
		ТекстПробыПоиска = Строка(МассивПробыПоиска.Количество());
		Для Каждого ФайлПробыПоиска Из МассивПробыПоиска Цикл
			ИмяГраничногоРезультата = ФайлПробыПоиска.Имя;
			Если ФайлПробыПоиска.ПолноеИмя = КореньПробыПоиска Тогда
				ИмяГраничногоРезультата = ".";
			КонецЕсли;
			ТекстПробыПоиска = ТекстПробыПоиска + "|" + ИмяГраничногоРезультата;
		КонецЦикла;
	Исключение
		ТекстПробыПоиска = "error:" + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Сообщить(ИдентификаторПоиска + Символ(9) + ТекстПробыПоиска);
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "search-edges-1");
КореньГраницПоиска = "";
Попытка
	КореньГраницПоиска = ПолучитьИмяВременногоФайла(".searchedges");
	СоздатьКаталог(КореньГраницПоиска + "/branch");
	ДанныеГраницПоиска = ПолучитьДвоичныеДанныеИзСтроки("x", КодировкаТекста.UTF8, Ложь);
	ДанныеГраницПоиска.Записать(КореньГраницПоиска + "/a.txt");
	ДанныеГраницПоиска.Записать(КореньГраницПоиска + "/branch/deep.txt");
	ПробаГраницыПоиска("find.missing.mask", КореньГраницПоиска, "НайтиФайлы(КореньПробыПоиска + ""/missing"", ""*"")");
	ПробаГраницыПоиска("find.missing.recursive", КореньГраницПоиска, "НайтиФайлы(КореньПробыПоиска + ""/missing"", ""*"", Истина)");
	ПробаГраницыПоиска("find.file.mask", КореньГраницПоиска, "НайтиФайлы(КореньПробыПоиска + ""/a.txt"", ""*"")");
	ПробаГраницыПоиска("find.file.recursive", КореньГраницПоиска, "НайтиФайлы(КореньПробыПоиска + ""/a.txt"", ""*"", Истина)");
	ПробаГраницыПоиска("find.trailing", КореньГраницПоиска, "НайтиФайлы(КореньПробыПоиска + ""/"", ""*.txt"")");
	ПробаГраницыПоиска("find.recursive.undefined", КореньГраницПоиска, "НайтиФайлы(КореньПробыПоиска, ""*.txt"", Неопределено)");
	ПробаГраницыПоиска("find.recursive.zero", КореньГраницПоиска, "НайтиФайлы(КореньПробыПоиска, ""*.txt"", 0)");
	ПробаГраницыПоиска("find.recursive.one", КореньГраницПоиска, "НайтиФайлы(КореньПробыПоиска, ""*.txt"", 1)");
	ПробаГраницыПоиска("find.recursive.string", КореньГраницПоиска, "НайтиФайлы(КореньПробыПоиска, ""*.txt"", ""Ложь"")");
	ПробаГраницыПоиска("find.mask.number", КореньГраницПоиска, "НайтиФайлы(КореньПробыПоиска, 17)");
	ПробаГраницыПоиска("find.path.number", КореньГраницПоиска, "НайтиФайлы(17)");
	ПробаГраницыПоиска("find.path.undefined", КореньГраницПоиска, "НайтиФайлы(Неопределено)");
	ПробаГраницыПоиска("find.direct.recursive", КореньГраницПоиска, "НайтиФайлы(КореньПробыПоиска, Неопределено, Истина)");
Исключение
	Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Если КореньГраницПоиска <> "" Тогда
	Попытка
		УдалитьФайлы(КореньГраницПоиска);
	Исключение
		Сообщить("file.cleanup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецЕсли;
Сообщить("file.end" + Символ(9) + "search-edges-1");
