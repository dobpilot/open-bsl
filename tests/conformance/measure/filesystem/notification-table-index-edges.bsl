// Дополнительные безопасные границы индекса методов таблицы и строки.

Процедура ПроверитьИндексТаблицы(ИдПробы, ИндексПробы)
	Для НомерМетодаПробы = 1 По 4 Цикл
		ТаблицаПробы = Новый ТаблицаЗначений;
		ТаблицаПробы.Колонки.Добавить("Левая");
		ТаблицаПробы.Колонки.Добавить("Правая");
		ПерваяСтрокаПробы = ТаблицаПробы.Добавить();
		ПерваяСтрокаПробы.Левая = 10;
		ПерваяСтрокаПробы.Правая = 20;
		ВтораяСтрокаПробы = ТаблицаПробы.Добавить();
		ВтораяСтрокаПробы.Левая = 30;
		ВтораяСтрокаПробы.Правая = 40;
		Если НомерМетодаПробы = 1 Тогда
			ВыражениеПробы = "ТаблицаПробы.Получить(ИндексПробы)";
		ИначеЕсли НомерМетодаПробы = 2 Тогда
			ВыражениеПробы = "ТаблицаПробы.Get(ИндексПробы)";
		ИначеЕсли НомерМетодаПробы = 3 Тогда
			ВыражениеПробы = "ПерваяСтрокаПробы.Установить(ИндексПробы, 99)";
		Иначе
			ВыражениеПробы = "ПерваяСтрокаПробы.Set(ИндексПробы, 99)";
		КонецЕсли;
		Попытка
			Если НомерМетодаПробы <= 2 Тогда
				РезультатПробы = Вычислить(ВыражениеПробы);
				ИтогПробы = "ok:" + Строка(РезультатПробы.Левая);
			Иначе
				Выполнить(ВыражениеПробы);
				ИтогПробы = "ok";
			КонецЕсли;
		Исключение
			ИтогПробы = "error";
		КонецПопытки;
		Сообщить(ИдПробы + "." + Строка(НомерМетодаПробы) + Символ(9)
			+ ИтогПробы + "|row=" + Строка(ПерваяСтрокаПробы.Левая) + ","
			+ Строка(ПерваяСтрокаПробы.Правая));
	КонецЦикла;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "notification-table-index-edges-1");
ПроверитьИндексТаблицы("number.positive_subunit", 0.9);
ПроверитьИндексТаблицы("number.negative_zero", -0.0);
ПроверитьИндексТаблицы("string.dot_fraction", "0.9");
ПроверитьИндексТаблицы("string.comma_fraction", "0,9");
ПроверитьИндексТаблицы("string.negative_fraction", "-0.9");
ПроверитьИндексТаблицы("string.plus", "+1");
ПроверитьИндексТаблицы("string.leading_zero", "01");
ПроверитьИндексТаблицы("string.exponent", "1e0");
ПроверитьИндексТаблицы("string.empty", "");
Сообщить("file.end" + Символ(9) + "notification-table-index-edges-1");
