Функция СнимокОбщегоБуфера(БуферПробы, ПотокПробы, ДругойПотокПробы)
	СнимокПробы = Строка(ПотокПробы.Размер()) + ":" + Строка(ПотокПробы.ТекущаяПозиция())
		+ "|other=" + Строка(ДругойПотокПробы.Размер()) + ":" + Строка(ДругойПотокПробы.ТекущаяПозиция())
		+ "|buffer=" + Строка(БуферПробы.Размер) + ":";
	Для ИндексПробы = 0 По БуферПробы.Размер - 1 Цикл
		СнимокПробы = СнимокПробы + Строка(БуферПробы[ИндексПробы]) + ",";
	КонецЦикла;
	Возврат СнимокПробы;
КонецФункции

Процедура ПоследовательностьРазмеров(ИмяМетодаПробы, НачальнаяПозицияПробы)
	Попытка
		БуферПробы = Новый БуферДвоичныхДанных(6);
		Для ИндексПробы = 0 По 5 Цикл
			БуферПробы[ИндексПробы] = ИндексПробы + 1;
		КонецЦикла;
		ПотокПробы = Новый ПотокВПамяти(БуферПробы);
		ДругойПотокПробы = Новый ПотокВПамяти(БуферПробы);
		ПотокПробы.Перейти(НачальнаяПозицияПробы, ПозицияВПотоке.Начало);
		ДругойПотокПробы.Перейти(5, ПозицияВПотоке.Начало);
		Для Каждого НовыйРазмерПробы Из СтрРазделить("2,4,0,6,8", ",") Цикл
			Попытка
				Выполнить("ПотокПробы." + ИмяМетодаПробы + "(" + НовыйРазмерПробы + ");");
				СтатусПробы = "ok";
			Исключение
				СтатусПробы = "error";
			КонецПопытки;
			Сообщить(ИмяМетодаПробы + "." + Строка(НачальнаяПозицияПробы) + "." + НовыйРазмерПробы
				+ Символ(9) + СтатусПробы + "|" + СнимокОбщегоБуфера(БуферПробы, ПотокПробы, ДругойПотокПробы));
		КонецЦикла;
		ПотокПробы.Перейти(0, ПозицияВПотоке.Начало);
		БуферЗаписиПробы = Новый БуферДвоичныхДанных(1);
		БуферЗаписиПробы[0] = 99;
		Попытка
			ПотокПробы.Записать(БуферЗаписиПробы, 0, 1);
			СтатусПробы = "ok";
		Исключение
			СтатусПробы = "error";
		КонецПопытки;
		Сообщить(ИмяМетодаПробы + "." + Строка(НачальнаяПозицияПробы) + ".write"
			+ Символ(9) + СтатусПробы + "|" + СнимокОбщегоБуфера(БуферПробы, ПотокПробы, ДругойПотокПробы));
		ПотокПробы.Закрыть();
		ДругойПотокПробы.Закрыть();
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИмяМетодаПробы + "." + Строка(НачальнаяПозицияПробы));
	КонецПопытки;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "stream-resize-buffer-1");
Для Каждого МетодРазмеров Из СтрРазделить("УстановитьРазмер,SetSize", ",") Цикл
	Для Каждого НачальнаяПозицияРазмеров Из СтрРазделить("0,1,2,5,6", ",") Цикл
		ПоследовательностьРазмеров(МетодРазмеров, Число(НачальнаяПозицияРазмеров));
	КонецЦикла;
КонецЦикла;
Сообщить("file.end" + Символ(9) + "stream-resize-buffer-1");
