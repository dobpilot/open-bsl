// Только чтение; дерево и цели ссылок сохраняются отдельным host-снимком.
Процедура ПробаПробельныхСсылок(ИдПробы, КореньПробы, ДеревоПробы, МаскаПробы, РекурсияПробы, АнглийскийВызов)
	Попытка
		ПутьПробы = КореньПробы + "/" + ДеревоПробы;
		Если АнглийскийВызов Тогда
			РезультатПробы = FindFiles(ПутьПробы, МаскаПробы, РекурсияПробы);
		Иначе
			РезультатПробы = НайтиФайлы(ПутьПробы, МаскаПробы, РекурсияПробы);
		КонецЕсли;
		ТекстПробы = "ok|count=" + Строка(РезультатПробы.Количество());
		Для Каждого ЭлементПробы Из РезультатПробы Цикл
			ТекстПробы = ТекстПробы + "|" + СтрЗаменить(ЭлементПробы.ПолноеИмя, КореньПробы, "<root>");
		КонецЦикла;
		Сообщить(ИдПробы + Символ(9) + ТекстПробы);
	Исключение
		Сообщить(ИдПробы + Символ(9) + "error|" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-search-link-spaces-1");
Попытка
	Сообщить("context.compatibility" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
Исключение
	Сообщить("context.compatibility" + Символ(9) + "unavailable");
КонецПопытки;

КореньПробельныхСсылок = "/tmp/open-bsl-find-link-spaces-Q7mP2a";
Для Каждого ДеревоПробельныхСсылок Из СтрРазделить("late space|first space", "|") Цикл
	Для Каждого МаскаПробельныхСсылок Из СтрРазделить("*|*.*|*.txt|* *|space*|*dir|broken*|[[:space:]]*", "|") Цикл
		Для РежимПробельныхСсылок = 0 По 3 Цикл
			РекурсияПробельныхСсылок = РежимПробельныхСсылок >= 2;
			АнглийскийПробельныхСсылок = РежимПробельныхСсылок % 2 = 1;
			ИдПробельныхСсылок = "spaces." + СтрЗаменить(ДеревоПробельныхСсылок, " ", "-")
				+ "." + СтрЗаменить(МаскаПробельныхСсылок, " ", "<space>")
				+ ?(РекурсияПробельныхСсылок, ".recursive", ".flat")
				+ ?(АнглийскийПробельныхСсылок, ".en", ".ru");
			ПробаПробельныхСсылок(
				ИдПробельныхСсылок,
				КореньПробельныхСсылок,
				ДеревоПробельныхСсылок,
				МаскаПробельныхСсылок,
				РекурсияПробельныхСсылок,
				АнглийскийПробельныхСсылок);
		КонецЦикла;
	КонецЦикла;
КонецЦикла;
Сообщить("file.end" + Символ(9) + "file-search-link-spaces-1");
