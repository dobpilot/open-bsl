// Клиентская проба приоритета ошибок аргумента и доступа. Путь не создаётся.
Функция ГлубиннаяОшибкаАтрибута(ИнформацияАтрибута, КореньАтрибута)
	Пока ИнформацияАтрибута.Причина <> Неопределено Цикл
		ИнформацияАтрибута = ИнформацияАтрибута.Причина;
	КонецЦикла;
	ТекстОшибкиАтрибута = СтрЗаменить(ИнформацияАтрибута.Описание, КореньАтрибута, "<root>");
	Возврат СтрЗаменить(СтрЗаменить(СтрЗаменить(ТекстОшибкиАтрибута, Символ(13), "<CR>"), Символ(10), "<LF>"), Символ(9), "<TAB>");
КонецФункции

Процедура ПробаСинхронногоАтрибута(ФайлАтрибута, КореньАтрибута, ИмяМетодаАтрибута, ИдМетодаАтрибута, ЗначениеАтрибута, ИдЗначенияАтрибута)
	ИдПробыАтрибута = "order.sync." + ИдМетодаАтрибута + "." + ИдЗначенияАтрибута;
	Попытка
		Выполнить("ФайлАтрибута." + ИмяМетодаАтрибута + "(ЗначениеАтрибута);");
		Сообщить(ИдПробыАтрибута + Символ(9) + "ok");
	Исключение
		Сообщить(ИдПробыАтрибута + Символ(9) + "error");
		Сообщить(ИдПробыАтрибута + ".detail" + Символ(9) + ГлубиннаяОшибкаАтрибута(ИнформацияОбОшибке(), КореньАтрибута));
	КонецПопытки;
КонецПроцедуры

Асинх Функция ПробаАсинхронногоАтрибута(ФайлАтрибута, КореньАтрибута, ИмяМетодаАтрибута, ИдМетодаАтрибута, ЗначениеАтрибута, ИдЗначенияАтрибута)
	ИдПробыАтрибута = "order.async." + ИдМетодаАтрибута + "." + ИдЗначенияАтрибута;
	СтадияАтрибута = "call";
	Попытка
		ОбещаниеАтрибута = Вычислить("ФайлАтрибута." + ИмяМетодаАтрибута + "(ЗначениеАтрибута)");
		СтадияАтрибута = "await";
		Ждать ОбещаниеАтрибута;
		Сообщить(ИдПробыАтрибута + Символ(9) + "ok");
	Исключение
		Сообщить(ИдПробыАтрибута + Символ(9) + "error|stage=" + СтадияАтрибута);
		Сообщить(ИдПробыАтрибута + ".detail" + Символ(9) + ГлубиннаяОшибкаАтрибута(ИнформацияОбОшибке(), КореньАтрибута));
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Асинх Процедура ИзмеритьПриоритетАтрибутов()
	Сообщить("file.begin" + Символ(9) + "file-attribute-access-order-1");
	Попытка
		Сообщить("context.compatibility" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
	Исключение
		Сообщить("context.compatibility" + Символ(9) + "unavailable");
	КонецПопытки;
	КореньАтрибута = ПолучитьИмяВременногоФайла(".attribute-order");
	ПутьАтрибута = КореньАтрибута + "/missing-child";
	ФайлАтрибута = Новый Файл(ПутьАтрибута);
	ИменаСинхронныхМетодовАтрибута = СтрРазделить("УстановитьТолькоЧтение,SetReadOnly,УстановитьНевидимость,SetHidden", ",");
	ИменаАсинхронныхМетодовАтрибута = СтрРазделить("УстановитьТолькоЧтениеАсинх,SetReadOnlyAsync,УстановитьНевидимостьАсинх,SetHiddenAsync", ",");
	ИдМетодовАтрибута = СтрРазделить("readonly.ru,readonly.en,hidden.ru,hidden.en", ",");
	Для НомерМетодаАтрибута = 0 По 3 Цикл
		ПробаСинхронногоАтрибута(ФайлАтрибута, КореньАтрибута, ИменаСинхронныхМетодовАтрибута[НомерМетодаАтрибута], ИдМетодовАтрибута[НомерМетодаАтрибута], Ложь, "valid");
		ПробаСинхронногоАтрибута(ФайлАтрибута, КореньАтрибута, ИменаСинхронныхМетодовАтрибута[НомерМетодаАтрибута], ИдМетодовАтрибута[НомерМетодаАтрибута], "Да", "invalid");
		Ждать ПробаАсинхронногоАтрибута(ФайлАтрибута, КореньАтрибута, ИменаАсинхронныхМетодовАтрибута[НомерМетодаАтрибута], ИдМетодовАтрибута[НомерМетодаАтрибута], Ложь, "valid");
		Ждать ПробаАсинхронногоАтрибута(ФайлАтрибута, КореньАтрибута, ИменаАсинхронныхМетодовАтрибута[НомерМетодаАтрибута], ИдМетодовАтрибута[НомерМетодаАтрибута], "Да", "invalid");
	КонецЦикла;
	Сообщить("file.end" + Символ(9) + "file-attribute-access-order-1");
	Попытка
		Выполнить("ЗавершитьРаботуСистемы(Ложь);");
	Исключение
	КонецПопытки;
КонецПроцедуры

ИзмеритьПриоритетАтрибутов();
