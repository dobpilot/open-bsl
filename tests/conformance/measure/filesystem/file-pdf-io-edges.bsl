Функция ЗаписатьPDFКрая(БазовыйПутьPDFКрая, ИсходныйПутьPDFКрая)
	Попытка
		БазовыйФайлPDFКрая = Новый Файл(БазовыйПутьPDFКрая);
		ИсходныйРазмерPDFКрая = БазовыйФайлPDFКрая.Размер();
		ДокументPDFКрая = Новый ДокументPDF;
		ДокументPDFКрая.Прочитать(БазовыйПутьPDFКрая);
		ДанныеPDFКрая = ПолучитьДвоичныеДанныеИзСтроки("1", КодировкаТекста.UTF8, Ложь);
		ДокументPDFКрая.Вложения.Добавить("a.txt", ДанныеPDFКрая,
			"text/plain", ТипСвязиВложенияPDF.Дополнение);
		ДокументPDFКрая.Записать(ИсходныйПутьPDFКрая);
		НовыйБазовыйФайлPDFКрая = Новый Файл(БазовыйПутьPDFКрая);
		НовыйРазмерPDFКрая = НовыйБазовыйФайлPDFКрая.Размер();
		Возврат "ok:" + ?(НовыйРазмерPDFКрая > ИсходныйРазмерPDFКрая, "changed", "base");
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

Функция ПрочитатьPDFКрая(ИсходныйПутьPDFКрая)
	Попытка
		ДокументPDFКрая = Новый ДокументPDF;
		ДокументPDFКрая.Прочитать(ИсходныйПутьPDFКрая);
		Возврат "ok:" + Строка(ДокументPDFКрая.Страницы.Количество());
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

Процедура ПробаPDFКрая(ИдPDFКрая, КодСимволаPDFКрая, СимволВНачалеPDFКрая, ВидPDFКрая)
	КореньPDFКрая = "";
	РезультатPDFКрая = "";
	Попытка
		КореньPDFКрая = ПолучитьИмяВременногоФайла(".file-pdf-io-edges");
		СоздатьКаталог(КореньPDFКрая);
		БазовыйПутьPDFКрая = КореньPDFКрая + "/leaf.pdf";
		МатериализоватьPDFКрая(БазовыйПутьPDFКрая, ПолучитьШестнPDFКрая());
		Если СимволВНачалеPDFКрая Тогда
			ИсходныйПутьPDFКрая = КореньPDFКрая + "/" + Символ(КодСимволаPDFКрая) + "leaf.pdf";
		Иначе
			ИсходныйПутьPDFКрая = БазовыйПутьPDFКрая + Символ(КодСимволаPDFКрая);
		КонецЕсли;
		Если ВидPDFКрая = "writer" Тогда
			РезультатPDFКрая = ЗаписатьPDFКрая(БазовыйПутьPDFКрая, ИсходныйПутьPDFКрая);
		Иначе
			РезультатPDFКрая = ПрочитатьPDFКрая(ИсходныйПутьPDFКрая);
		КонецЕсли;
		Сообщить(ИдPDFКрая + "." + ВидPDFКрая + Символ(9) + РезультатPDFКрая);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдPDFКрая + "." + ВидPDFКрая
			+ ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньPDFКрая <> "" Тогда
		Попытка
			УдалитьФайлы(КореньPDFКрая);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдPDFКрая + "." + ВидPDFКрая);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-pdf-io-edges-1");
