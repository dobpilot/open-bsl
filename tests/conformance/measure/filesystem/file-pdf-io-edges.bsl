			"0x" + Сред(ШестнадцатеричныйPDFКрая, СчётчикPDFКрая * 2 + 1, 2));
	КонецЦикла;
	ПотокPDFКрая = ФайловыеПотоки.Создать(ПутьPDFКрая);
	ПотокPDFКрая.Записать(БуферPDFКрая, 0, БуферPDFКрая.Размер);
	ПотокPDFКрая.Закрыть();
