// __OPEN_BSL_PROBE_ROOT__ в копии модуля заменяется путём нового scratch-каталога.
// Его сохраняет внешний наблюдатель для stat; обычный запуск удаляет свой temp.
Процедура ВыводГраницыВремени(ИдентификаторПробы, ТекстПробы)
	Сообщить(ИдентификаторПробы + Символ(9) + ТекстПробы);
КонецПроцедуры

Функция ПоляДатыПробы(ДатаПробы)
	Возврат Строка(ТипЗнч(ДатаПробы)) + ":" + Строка(Год(ДатаПробы))
		+ "-" + Строка(Месяц(ДатаПробы)) + "-" + Строка(День(ДатаПробы))
		+ " " + Строка(Час(ДатаПробы)) + ":" + Строка(Минута(ДатаПробы))
		+ ":" + Строка(Секунда(ДатаПробы));
КонецФункции

Процедура ПробаГраницыВремени(КореньПробы, ИдентификаторПробы, АргументПробы, МестнаяПроба)
	ПутьПробы = КореньПробы + ПолучитьРазделительПути() + ИдентификаторПробы;
	Попытка
		ДанныеПробы = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
		ДанныеПробы.Записать(ПутьПробы);
		ОбъектПробы = Вычислить("Новый Файл(ПутьПробы)");
		Выполнить("ОбъектПробы.УстановитьУниверсальноеВремяИзменения(Дата(2020, 1, 1));");
		Если МестнаяПроба Тогда
			Выполнить("ОбъектПробы.УстановитьВремяИзменения(АргументПробы);");
		Иначе
			Выполнить("ОбъектПробы.УстановитьУниверсальноеВремяИзменения(АргументПробы);");
		КонецЕсли;
		ВыводГраницыВремени(ИдентификаторПробы + ".set", "ok");
	Исключение
		ВыводГраницыВремени(ИдентификаторПробы + ".set", "error:" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Попытка
		ДатаПробы = Вычислить("ОбъектПробы.ПолучитьВремяИзменения()");
		ВыводГраницыВремени(ИдентификаторПробы + ".local", ПоляДатыПробы(ДатаПробы));
	Исключение
		ВыводГраницыВремени(ИдентификаторПробы + ".local", "error:" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Попытка
		ДатаПробы = Вычислить("ОбъектПробы.ПолучитьУниверсальноеВремяИзменения()");
		ВыводГраницыВремени(ИдентификаторПробы + ".utc", ПоляДатыПробы(ДатаПробы));
	Исключение
		ВыводГраницыВремени(ИдентификаторПробы + ".utc", "error:" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецПроцедуры

ВыводГраницыВремени("file.begin", "1");
КореньГраничнойПробы = "__OPEN_BSL_PROBE_ROOT__";
СвойКаталогПробы = Лев(КореньГраничнойПробы, 1) = "_";
Если СвойКаталогПробы Тогда
	КореньГраничнойПробы = ПолучитьИмяВременногоФайла(".timeedges");
КонецЕсли;
Попытка
	Выполнить("СоздатьКаталог(КореньГраничнойПробы);");
	ВыводГраницыВремени("file.scratch", КореньГраничнойПробы);
	ПробаГраницыВремени(КореньГраничнойПробы, "utc.minus1", Дата(1969, 12, 31, 23, 59, 59), Ложь);
	ПробаГраницыВремени(КореньГраничнойПробы, "utc.epoch", Дата(1970, 1, 1), Ложь);
	ПробаГраницыВремени(КореньГраничнойПробы, "utc.plus1", Дата(1970, 1, 1, 0, 0, 1), Ложь);
	ПробаГраницыВремени(КореньГраничнойПробы, "utc.1960", Дата(1960, 1, 15, 12, 34, 56), Ложь);
	ПробаГраницыВремени(КореньГраничнойПробы, "utc.minimum", Дата(1, 1, 1), Ложь);
	ПробаГраницыВремени(КореньГраничнойПробы, "utc.maximum", Дата(9999, 12, 31, 23, 59, 59), Ложь);
	ПробаГраницыВремени(КореньГраничнойПробы, "utc.string", "20210314151617", Ложь);
	ПробаГраницыВремени(КореньГраничнойПробы, "local.1960", Дата(1960, 1, 15, 12, 34, 56), Истина);
	ПробаГраницыВремени(КореньГраничнойПробы, "local.minimum", Дата(1, 1, 1), Истина);
	ПробаГраницыВремени(КореньГраничнойПробы, "local.maximum", Дата(9999, 12, 31, 23, 59, 59), Истина);
	ПробаГраницыВремени(КореньГраничнойПробы, "local.gap", Дата(2011, 3, 27, 2, 30, 0), Истина);
	ПробаГраницыВремени(КореньГраничнойПробы, "local.fold", Дата(2014, 10, 26, 1, 30, 0), Истина);
	ПробаГраницыВремени(КореньГраничнойПробы, "local.string", "20210314151617", Истина);
Исключение
	ВыводГраницыВремени("file.setup_error", ИнформацияОбОшибке().Описание);
КонецПопытки;
Если СвойКаталогПробы Тогда
	Попытка
		УдалитьФайлы(КореньГраничнойПробы);
		ВыводГраницыВремени("file.cleanup", "ok");
	Исключение
		ВыводГраницыВремени("file.cleanup_error", ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецЕсли;
ВыводГраницыВремени("file.end", "1");

