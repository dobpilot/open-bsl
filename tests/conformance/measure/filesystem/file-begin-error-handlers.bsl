Перем ЧислоОбработчиковОшибки;
Перем ТикиОбработчиковОшибки;

Процедура ЗавершитьОбработчикиОшибки() Экспорт
    ТикиОбработчиковОшибки = ТикиОбработчиковОшибки + 1;
    Если ТикиОбработчиковОшибки < 5 Тогда Возврат; КонецЕсли;
    Сообщить("errorhandler.count" + Символ(9) + Строка(ЧислоОбработчиковОшибки));
    Сообщить("file.end" + Символ(9) + "file-begin-error-handlers-1");
    Попытка Выполнить("ЗавершитьРаботуСистемы(Ложь);"); Исключение КонецПопытки;
КонецПроцедуры

Процедура УспехВместоОшибки(Знач РезультатПробыОшибки, Знач ДанныеПробыОшибки) Экспорт
    Сообщить("errorhandler.unexpected_success" + Символ(9) + ДанныеПробыОшибки.Ключ);
КонецПроцедуры

Процедура ВходОбработчикаОшибки(Знач ИнформацияПробыОшибки, Знач СтандартнаяПробыОшибки, Знач ДанныеПробыОшибки)
    ЧислоОбработчиковОшибки = ЧислоОбработчиковОшибки + 1;
    Сообщить("errorhandler.enter" + Символ(9) + ДанныеПробыОшибки.Ключ
        + "|initial=" + ?(СтандартнаяПробыОшибки, "1", "0")
        + "|type=" + Строка(ТипЗнч(ИнформацияПробыОшибки)));
КонецПроцедуры

Процедура СинхПроцедураОшибки(Знач ИнформацияПробыОшибки, СтандартнаяПробыОшибки, Знач ДанныеПробыОшибки) Экспорт
    ВходОбработчикаОшибки(ИнформацияПробыОшибки, СтандартнаяПробыОшибки, ДанныеПробыОшибки);
    СтандартнаяПробыОшибки = Ложь;
    Если ДанныеПробыОшибки.Исключение Тогда ВызватьИсключение "error-handler:" + ДанныеПробыОшибки.Ключ; КонецЕсли;
    Сообщить("errorhandler.return" + Символ(9) + ДанныеПробыОшибки.Ключ);
КонецПроцедуры

Функция СинхФункцияОшибки(Знач ИнформацияПробыОшибки, СтандартнаяПробыОшибки, Знач ДанныеПробыОшибки) Экспорт
    ВходОбработчикаОшибки(ИнформацияПробыОшибки, СтандартнаяПробыОшибки, ДанныеПробыОшибки);
    СтандартнаяПробыОшибки = Ложь;
    Если ДанныеПробыОшибки.Исключение Тогда ВызватьИсключение "error-handler:" + ДанныеПробыОшибки.Ключ; КонецЕсли;
    Сообщить("errorhandler.return" + Символ(9) + ДанныеПробыОшибки.Ключ);
    Возврат 99;
КонецФункции

Асинх Процедура АсинхПроцедураОшибки(Знач ИнформацияПробыОшибки, СтандартнаяПробыОшибки, Знач ДанныеПробыОшибки) Экспорт
    ВходОбработчикаОшибки(ИнформацияПробыОшибки, СтандартнаяПробыОшибки, ДанныеПробыОшибки);
    Если ДанныеПробыОшибки.ДоОжидания Тогда СтандартнаяПробыОшибки = Ложь; КонецЕсли;
    Сообщить("errorhandler.before" + Символ(9) + ДанныеПробыОшибки.Ключ + "|flag=" + ?(СтандартнаяПробыОшибки, "1", "0"));
    Если ДанныеПробыОшибки.ДоОжидания И ДанныеПробыОшибки.Исключение Тогда ВызватьИсключение "error-handler:" + ДанныеПробыОшибки.Ключ; КонецЕсли;
    СуществуетПробыОшибки = Ждать ДанныеПробыОшибки.Файл.СуществуетАсинх();
    Если Не ДанныеПробыОшибки.ДоОжидания Тогда СтандартнаяПробыОшибки = Ложь; КонецЕсли;
    Сообщить("errorhandler.after" + Символ(9) + ДанныеПробыОшибки.Ключ + "|flag=" + ?(СтандартнаяПробыОшибки, "1", "0") + "|exists=" + ?(СуществуетПробыОшибки, "1", "0"));
    Если ДанныеПробыОшибки.Исключение Тогда ВызватьИсключение "error-handler:" + ДанныеПробыОшибки.Ключ; КонецЕсли;
    Сообщить("errorhandler.return" + Символ(9) + ДанныеПробыОшибки.Ключ);
КонецПроцедуры

Асинх Функция АсинхФункцияОшибки(Знач ИнформацияПробыОшибки, СтандартнаяПробыОшибки, Знач ДанныеПробыОшибки) Экспорт
    ВходОбработчикаОшибки(ИнформацияПробыОшибки, СтандартнаяПробыОшибки, ДанныеПробыОшибки);
    Если ДанныеПробыОшибки.ДоОжидания Тогда СтандартнаяПробыОшибки = Ложь; КонецЕсли;
    Сообщить("errorhandler.before" + Символ(9) + ДанныеПробыОшибки.Ключ + "|flag=" + ?(СтандартнаяПробыОшибки, "1", "0"));
    Если ДанныеПробыОшибки.ДоОжидания И ДанныеПробыОшибки.Исключение Тогда ВызватьИсключение "error-handler:" + ДанныеПробыОшибки.Ключ; КонецЕсли;
    СуществуетПробыОшибки = Ждать ДанныеПробыОшибки.Файл.СуществуетАсинх();
    Если Не ДанныеПробыОшибки.ДоОжидания Тогда СтандартнаяПробыОшибки = Ложь; КонецЕсли;
    Сообщить("errorhandler.after" + Символ(9) + ДанныеПробыОшибки.Ключ + "|flag=" + ?(СтандартнаяПробыОшибки, "1", "0") + "|exists=" + ?(СуществуетПробыОшибки, "1", "0"));
    Если ДанныеПробыОшибки.Исключение Тогда ВызватьИсключение "error-handler:" + ДанныеПробыОшибки.Ключ; КонецЕсли;
    Сообщить("errorhandler.return" + Символ(9) + ДанныеПробыОшибки.Ключ);
    Возврат 99;
КонецФункции

Процедура ЗапуститьОбработчикОшибки(КлючПробыОшибки, ИмяПробыОшибки, Знач ДоОжиданияПробыОшибки, Знач ИсключениеПробыОшибки)
    ФайлПробыОшибки = Новый Файл("/open-bsl-error-handler-20260917-" + КлючПробыОшибки);
    ДанныеПробыОшибки = Новый Структура("Ключ,ДоОжидания,Исключение,Файл", КлючПробыОшибки, ДоОжиданияПробыОшибки, ИсключениеПробыОшибки, ФайлПробыОшибки);
    ФайлПробыОшибки.НачатьПолучениеРазмера(Новый ОписаниеОповещения("УспехВместоОшибки", ЭтотОбъект, ДанныеПробыОшибки, ИмяПробыОшибки, ЭтотОбъект));
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-begin-error-handlers-1");
