// Частичные отказы СоздатьКаталог на Linux. Все изменяемые пути находятся
// внутри отдельного временного корня; права обязательно восстанавливаются
// перед очисткой.

Функция ПовторитьСимволСоздания(СимволСоздания, КоличествоСоздания)
	РезультатСоздания = "";
	Для ИндексСоздания = 1 По КоличествоСоздания Цикл
		РезультатСоздания = РезультатСоздания + СимволСоздания;
	КонецЦикла;
	Возврат РезультатСоздания;
КонецФункции

Процедура ИзмеритьЧастичныеОтказыСоздания()
	Сообщить("file.begin" + Символ(9) + "create-directory-failures-1");
	Попытка
		Сообщить("context.effective" + Символ(9)
			+ Строка(Вычислить("Метаданные.РежимСовместимости")));
	Исключение
		Сообщить("context.effective_unavailable" + Символ(9) + "error");
	КонецПопытки;

	КореньОтказовСоздания = ПолучитьИмяВременногоФайла(".create-directory-failures");
	ЗакрытыйКаталогСоздания = КореньОтказовСоздания + "/private";
	ПраваЗакрытогоКаталогаСняты = Ложь;
	Попытка
		СоздатьКаталог(ЗакрытыйКаталогСоздания);

		ДлинныйКомпонентСоздания = ПовторитьСимволСоздания("a", 300);
		ПутьДлинногоКомпонентаСоздания = КореньОтказовСоздания
			+ "/created/" + ДлинныйКомпонентСоздания + "/leaf";
		Попытка
			СоздатьКаталог(ПутьДлинногоКомпонентаСоздания);
			ИтогДлинногоКомпонентаСоздания = "ok";
		Исключение
			ИтогДлинногоКомпонентаСоздания = "error";
		КонецПопытки;
		СозданПрефиксПослеОтказа = Новый Файл(КореньОтказовСоздания + "/created");
		Сообщить("create.failure.long_component" + Символ(9)
			+ ИтогДлинногоКомпонентаСоздания + "|prefix="
			+ ?(СозданПрефиксПослеОтказа.Существует(), "1", "0"));

		КодИзмененияПравСоздания = 0;
		ЗапуститьПриложение("/bin/chmod 000 " + ЗакрытыйКаталогСоздания,
			"/tmp", Истина, КодИзмененияПравСоздания);
		Если КодИзмененияПравСоздания <> 0 Тогда
			Сообщить("file.setup_error" + Символ(9) + "chmod-000:"
				+ Строка(КодИзмененияПравСоздания));
		Иначе
			ПраваЗакрытогоКаталогаСняты = Истина;
		КонецЕсли;

		Попытка
			СоздатьКаталог(ЗакрытыйКаталогСоздания + "/child/leaf");
			ИтогОтказаДоступаСоздания = "ok";
		Исключение
			ИтогОтказаДоступаСоздания = "error";
		КонецПопытки;

		КодВосстановленияПравСоздания = 0;
		ЗапуститьПриложение("/bin/chmod 700 " + ЗакрытыйКаталогСоздания,
			"/tmp", Истина, КодВосстановленияПравСоздания);
		ПраваЗакрытогоКаталогаСняты = Ложь;
		Если КодВосстановленияПравСоздания <> 0 Тогда
			Сообщить("file.setup_error" + Символ(9) + "chmod-700:"
				+ Строка(КодВосстановленияПравСоздания));
		КонецЕсли;
		СозданРебенокПослеОтказа = Новый Файл(ЗакрытыйКаталогСоздания + "/child");
		Сообщить("create.failure.permission" + Символ(9)
			+ ИтогОтказаДоступаСоздания + "|child="
			+ ?(СозданРебенокПослеОтказа.Существует(), "1", "0"));
	Исключение
		Сообщить("file.setup_error" + Символ(9) + "create-directory-failures:"
			+ ИнформацияОбОшибке().Описание);
	КонецПопытки;

	Если ПраваЗакрытогоКаталогаСняты Тогда
		Попытка
			ЗапуститьПриложение("/bin/chmod 700 " + ЗакрытыйКаталогСоздания,
				"/tmp", Истина);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + "chmod-700");
		КонецПопытки;
	КонецЕсли;
	Попытка
		УдалитьФайлы(КореньОтказовСоздания);
	Исключение
		Сообщить("file.cleanup_error" + Символ(9) + "create-directory-failures:"
			+ ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Сообщить("file.end" + Символ(9) + "create-directory-failures-1");
КонецПроцедуры

ИзмеритьЧастичныеОтказыСоздания();
