// В копии модуля placeholder заменяется новым подготовленным scratch.
// Без подстановки выполняется только smoke-прогон с обычными правами файлов.
Процедура ВыводАтрибутов(КодПробы, ТекстПробы)
	Сообщить(КодПробы + Символ(9) + ТекстПробы);
КонецПроцедуры

Процедура ЧтениеАтрибута(КодПробы, ОбъектПробы, ВыражениеПробы)
	Попытка
		ТекстПробы = Строка(Вычислить(ВыражениеПробы));
	Исключение
		ТекстПробы = "error:" + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	ВыводАтрибутов(КодПробы, ТекстПробы);
КонецПроцедуры

Процедура ПробаАтрибута(КореньПробы, ИмяПробы, КомандаПробы)
	Попытка
		ПутьПробы = КореньПробы + ПолучитьРазделительПути() + ИмяПробы;
		ОбъектПробы = Вычислить("Новый Файл(ПутьПробы)");
		ЧтениеАтрибута(ИмяПробы + ".readonly.before", ОбъектПробы, "ОбъектПробы.ПолучитьТолькоЧтение()");
		ЧтениеАтрибута(ИмяПробы + ".hidden.before", ОбъектПробы, "ОбъектПробы.GetHidden()");
		Попытка
			Выполнить("ОбъектПробы." + КомандаПробы + ";");
			ВыводАтрибутов(ИмяПробы + ".set", "ok");
		Исключение
			ВыводАтрибутов(ИмяПробы + ".set", "error:" + ИнформацияОбОшибке().Описание);
		КонецПопытки;
		ЧтениеАтрибута(ИмяПробы + ".readonly.after", ОбъектПробы, "ОбъектПробы.GetReadOnly()");
		ЧтениеАтрибута(ИмяПробы + ".hidden.after", ОбъектПробы, "ОбъектПробы.ПолучитьНевидимость()");
	Исключение
		ВыводАтрибутов(ИмяПробы + ".error", ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецПроцедуры

ВыводАтрибутов("file.begin", "1");
КореньАтрибутовПробы = "__OPEN_BSL_PROBE_ROOT__";
СвойКореньАтрибутов = Лев(КореньАтрибутовПробы, 1) = "_";
Если СвойКореньАтрибутов Тогда
	КореньАтрибутовПробы = ПолучитьИмяВременногоФайла(".attributes");
КонецЕсли;
Попытка
	Если СвойКореньАтрибутов Тогда
		Выполнить("СоздатьКаталог(КореньАтрибутовПробы);");
		ДанныеАтрибутовПробы = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
		Для Каждого ИмяАтрибутовПробы Из СтрРазделить("clear0440|set0660|clear0550|set0777|clear0000|link|.hidden|plain|undefined|number|string|hidden_bad", "|") Цикл
			ДанныеАтрибутовПробы.Записать(КореньАтрибутовПробы + ПолучитьРазделительПути() + ИмяАтрибутовПробы);
		КонецЦикла;
		ПутьКаталогаПробы = КореньАтрибутовПробы + ПолучитьРазделительПути() + "directory";
		Выполнить("СоздатьКаталог(ПутьКаталогаПробы);");
	КонецЕсли;
	ВыводАтрибутов("file.scratch", КореньАтрибутовПробы);
	ПробаАтрибута(КореньАтрибутовПробы, "clear0440", "УстановитьТолькоЧтение(Ложь)");
	ПробаАтрибута(КореньАтрибутовПробы, "set0660", "УстановитьТолькоЧтение(Истина)");
	ПробаАтрибута(КореньАтрибутовПробы, "clear0550", "SetReadOnly(Ложь)");
	ПробаАтрибута(КореньАтрибутовПробы, "set0777", "SetReadOnly(Истина)");
	ПробаАтрибута(КореньАтрибутовПробы, "clear0000", "УстановитьТолькоЧтение(Ложь)");
	ПробаАтрибута(КореньАтрибутовПробы, "link", "УстановитьТолькоЧтение(Ложь)");
	ПробаАтрибута(КореньАтрибутовПробы, "directory", "УстановитьТолькоЧтение(Ложь)");
	ПробаАтрибута(КореньАтрибутовПробы, ".hidden", "УстановитьНевидимость(Ложь)");
	ПробаАтрибута(КореньАтрибутовПробы, "plain", "SetHidden(Истина)");
	ПробаАтрибута(КореньАтрибутовПробы, "undefined", "УстановитьТолькоЧтение(Неопределено)");
	ПробаАтрибута(КореньАтрибутовПробы, "number", "УстановитьТолькоЧтение(1)");
	ПробаАтрибута(КореньАтрибутовПробы, "string", "УстановитьТолькоЧтение(""Ложь"")");
	ПробаАтрибута(КореньАтрибутовПробы, "hidden_bad", "УстановитьНевидимость(Неопределено)");
	ПробаАтрибута(КореньАтрибутовПробы, "missing", "УстановитьНевидимость(Истина)");
	ПробаАтрибута(КореньАтрибутовПробы, "missing_readonly", "УстановитьТолькоЧтение(Истина)");
Исключение
	ВыводАтрибутов("file.setup_error", ИнформацияОбОшибке().Описание);
КонецПопытки;
Если СвойКореньАтрибутов Тогда
	Попытка
		УдалитьФайлы(КореньАтрибутовПробы);
		ВыводАтрибутов("file.cleanup", "ok");
	Исключение
		ВыводАтрибутов("file.cleanup_error", ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецЕсли;
ВыводАтрибутов("file.end", "1");

