// Серверные пробы расширений файловой маски. Каждый случай получает
// отдельный каталог, поэтому в результате достаточно количества совпадений.

Процедура ПробаРасширенияМаски(ИдПробы, ИмяПробы, МаскаПробы)
	КореньПробы = "";
	Попытка
		// Обрамление не даёт `Файл` трактовать точку как компонент пути и
		// обрезать завершающие пробельные/разделительные символы.
		ИмяПробы = "x" + ИмяПробы + "y";
		МаскаПробы = "x" + МаскаПробы + "y";
		КореньПробы = ПолучитьИмяВременногоФайла(".mask-extension");
		СоздатьКаталог(КореньПробы);
		ДанныеПробы = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
		ДанныеПробы.Записать(КореньПробы + "/" + ИмяПробы);
		РезультатПробы = НайтиФайлы(КореньПробы, МаскаПробы);
		Сообщить(ИдПробы + Символ(9) + Строка(РезультатПробы.Количество()));
	Исключение
		Сообщить(ИдПробы + Символ(9) + "error:" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньПробы <> "" Тогда
		Попытка
			УдалитьФайлы(КореньПробы);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдПробы);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "mask-extensions-1");

ПробаРасширенияМаски("class.alnum.letter", "A", "[[:alnum:]]");
ПробаРасширенияМаски("class.alnum.digit", "7", "[[:alnum:]]");
