// Клиентские пробы путей СоздатьКаталогАсинх. Непустые пути ограничены своим корнем.
// Числа/коллекции не проверяются: неявное Строка могло бы записать вне корня.
Функция ЭкранироватьИмяСоздания(ИмяСоздания)
	Возврат СтрЗаменить(СтрЗаменить(СтрЗаменить(ИмяСоздания, Символ(0), "<NUL>"), Символ(10), "<LF>"), Символ(9), "<TAB>");
КонецФункции

Асинх Функция ПробаПутиСоздания(ИдСоздания, ХвостСоздания, ВызовСоздания = "СоздатьКаталогАсинх(АргументСоздания)")
	КореньСоздания = "";
	Попытка
		КореньСоздания = ПолучитьИмяВременногоФайла(".create-paths");
		СоздатьКаталог(КореньСоздания);
		ДанныеСоздания = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
		ДанныеСоздания.Записать(КореньСоздания + "/block");
		АргументСоздания = КореньСоздания + "/" + ХвостСоздания;
		СтадияСоздания = "call";
		ТипОбещанияСоздания = "none";
		Попытка
			ОбещаниеСоздания = Вычислить(ВызовСоздания);
			ТипОбещанияСоздания = Строка(ТипЗнч(ОбещаниеСоздания));
			СтадияСоздания = "await";
			РезультатСоздания = Ждать ОбещаниеСоздания;
			ИтогСоздания = "ok|type=" + Строка(ТипЗнч(РезультатСоздания)) + "|same=" + ?(РезультатСоздания = АргументСоздания, "1", "0");
		Исключение
			ИтогСоздания = "error|stage=" + СтадияСоздания;
		КонецПопытки;
		ИтогСоздания = "promise=" + ТипОбещанияСоздания + "|" + ИтогСоздания;
		ИменаСоздания = Новый Массив;
		Для Каждого ФайлСоздания Из НайтиФайлы(КореньСоздания, "*", Истина) Цикл
			ИменаСоздания.Добавить(ЭкранироватьИмяСоздания(Сред(ФайлСоздания.ПолноеИмя, СтрДлина(КореньСоздания) + 2)));
		КонецЦикла;
		Для ИндексСоздания = 0 По ИменаСоздания.Количество() - 1 Цикл
			Для СледующийСоздания = ИндексСоздания + 1 По ИменаСоздания.Количество() - 1 Цикл
				Если ИменаСоздания[ИндексСоздания] > ИменаСоздания[СледующийСоздания] Тогда
					ОбменСоздания = ИменаСоздания[ИндексСоздания];
					ИменаСоздания[ИндексСоздания] = ИменаСоздания[СледующийСоздания];
					ИменаСоздания[СледующийСоздания] = ОбменСоздания;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Для Каждого СтрокаСоздания Из ИменаСоздания Цикл
			ИтогСоздания = ИтогСоздания + "|" + СтрокаСоздания;
		КонецЦикла;
		ФайлКонтроляСоздания = Новый Файл(КореньСоздания + "/block");
		ИтогСоздания = ИтогСоздания + "|bytes=" + Строка(ФайлКонтроляСоздания.Размер());
		Сообщить(ИдСоздания + Символ(9) + ИтогСоздания);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдСоздания + ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньСоздания <> "" Тогда
		Попытка
			УдалитьФайлы(КореньСоздания);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдСоздания + ":" + ИнформацияОбОшибке().Описание);
		КонецПопытки;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Асинх Функция ПробаПустогоСоздания(ИдПустогоСоздания, АргументПустогоСоздания)
	СтадияПустогоСоздания = "call";
	ТипПустогоОбещания = "none";
	Попытка
		ПустоеОбещание = СоздатьКаталогАсинх(АргументПустогоСоздания);
		ТипПустогоОбещания = Строка(ТипЗнч(ПустоеОбещание));
		СтадияПустогоСоздания = "await";
		РезультатПустогоСоздания = Ждать ПустоеОбещание;
		ИтогПустогоСоздания = "ok|type=" + Строка(ТипЗнч(РезультатПустогоСоздания));
	Исключение
		ИтогПустогоСоздания = "error|stage=" + СтадияПустогоСоздания;
	КонецПопытки;
	Сообщить(ИдПустогоСоздания + Символ(9) + "promise=" + ТипПустогоОбещания + "|" + ИтогПустогоСоздания);
	Возврат Неопределено;
КонецФункции

Асинх Процедура ВыполнитьПробыСозданияАсинх()
	Сообщить("file.begin" + Символ(9) + "create-paths-async-1");
	Попытка
		Сообщить("context.effective" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
	Исключение
		Сообщить("context.effective_unavailable" + Символ(9) + "error");
	КонецПопытки;
	Ждать ПробаПутиСоздания("create.plain", "leaf");
	Ждать ПробаПутиСоздания("create.english", "leaf", "CreateDirectoryAsync(АргументСоздания)");
	Ждать ПробаПутиСоздания("create.repeat", "branch//leaf///");
	Ждать ПробаПутиСоздания("create.dot", "branch/./leaf");
	Ждать ПробаПутиСоздания("create.parent", "missing/../leaf");
	Ждать ПробаПутиСоздания("create.file", "block");
	Ждать ПробаПутиСоздания("create.file_child", "block/leaf");
	Ждать ПробаПутиСоздания("create.file_parent", "block/../leaf");
	Ждать ПробаПутиСоздания("create.backslash", "branch\leaf");
	Ждать ПробаПутиСоздания("create.backslash_tail", "branch\");
	Ждать ПробаПутиСоздания("create.backslash_parent", "missing\..\leaf");
	Ждать ПробаПутиСоздания("create.mixed", "branch\middle/leaf");
	Ждать ПробаПутиСоздания("create.spaces", " spaced /leaf ");
	Ждать ПробаПутиСоздания("create.trailing_dot", "leaf.");
	Ждать ПробаПутиСоздания("create.three_dots", "...");
	Ждать ПробаПутиСоздания("create.unicode", "каталог/файл");
	Ждать ПробаПутиСоздания("create.star", "star*");
	Ждать ПробаПутиСоздания("create.question", "question?");
	// Случай двоеточия требует отдельной проверки поиска и очистки на 1С.
	Ждать ПробаПутиСоздания("create.tab", "tab" + Символ(9) + "leaf");
	Ждать ПробаПутиСоздания("create.nul", "nul" + Символ(0) + "tail");
	Ждать ПробаПутиСоздания("create.nul_child", "nul" + Символ(0) + "/tail");
	Ждать ПробаПутиСоздания("create.extra_argument", "leaf", "СоздатьКаталогАсинх(АргументСоздания, Истина)");
	Ждать ПробаПустогоСоздания("create.empty", "");
	Ждать ПробаПустогоСоздания("create.undefined", Неопределено);
	Ждать ПробаПустогоСоздания("create.null", Null);
	Сообщить("file.end" + Символ(9) + "create-paths-async-1");

	Попытка
		Выполнить("ЗавершитьРаботуСистемы(Ложь);");
	Исключение
	КонецПопытки;
КонецПроцедуры

ВыполнитьПробыСозданияАсинх();
