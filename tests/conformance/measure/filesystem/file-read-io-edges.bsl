// Серверная проба путей трёх уже реализованных читателей файлов.
// Физически создаётся только базовый файл внутри отдельного temp-корня.

Функция ПрочитатьДвоичныеКрая(ПутьЧтенияКрая)
	Попытка
		ДвоичныеЧтенияКрая = Новый ДвоичныеДанные(ПутьЧтенияКрая);
		Возврат Строка(ДвоичныеЧтенияКрая.Размер());
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

Функция ПрочитатьПотокомКрая(ПутьЧтенияКрая)
	Попытка
		ПотокЧтенияКрая = Новый ФайловыйПоток(ПутьЧтенияКрая, РежимОткрытияФайла.Открыть);
		РазмерЧтенияКрая = ПотокЧтенияКрая.Размер();
		ПотокЧтенияКрая.Закрыть();
		Возврат Строка(РазмерЧтенияКрая);
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

Функция ПрочитатьМенеджеромКрая(ПутьЧтенияКрая)
	Попытка
		ПотокЧтенияКрая = ФайловыеПотоки.ОткрытьДляЧтения(ПутьЧтенияКрая);
		РазмерЧтенияКрая = ПотокЧтенияКрая.Размер();
		ПотокЧтенияКрая.Закрыть();
		Возврат Строка(РазмерЧтенияКрая);
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

Процедура ПробаЧтенияКрая(ИдЧтенияКрая, КодСимволаКрая, СимволВНачале)
	КореньЧтенияКрая = "";
	Попытка
		КореньЧтенияКрая = ПолучитьИмяВременногоФайла(".file-read-io-edges");
		СоздатьКаталог(КореньЧтенияКрая);
		БазовыйПутьЧтенияКрая = КореньЧтенияКрая + "/leaf";
		ДанныеЧтенияКрая = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
		ДанныеЧтенияКрая.Записать(БазовыйПутьЧтенияКрая);
		Если СимволВНачале Тогда
			ИсходныйПутьЧтенияКрая = КореньЧтенияКрая + "/" + Символ(КодСимволаКрая) + "leaf";
		Иначе
			ИсходныйПутьЧтенияКрая = БазовыйПутьЧтенияКрая + Символ(КодСимволаКрая);
		КонецЕсли;
		ИтогЧтенияКрая = "binary=" + ПрочитатьДвоичныеКрая(ИсходныйПутьЧтенияКрая)
			+ "|stream=" + ПрочитатьПотокомКрая(ИсходныйПутьЧтенияКрая)
			+ "|manager=" + ПрочитатьМенеджеромКрая(ИсходныйПутьЧтенияКрая);
		Сообщить(ИдЧтенияКрая + Символ(9) + ИтогЧтенияКрая);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдЧтенияКрая + ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньЧтенияКрая <> "" Тогда
		Попытка
			УдалитьФайлы(КореньЧтенияКрая);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдЧтенияКрая + ":" + ИнформацияОбОшибке().Описание);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-read-io-edges-1");
Попытка
	Сообщить("context.effective" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
Исключение
	Сообщить("context.effective_unavailable" + Символ(9) + "error");
КонецПопытки;
Для Каждого КодЧтенияКрая Из СтрРазделить("0|9|10|13|32|127|133|160|8203|65279", "|") Цикл
	ПробаЧтенияКрая("read.suffix." + КодЧтенияКрая, Число(КодЧтенияКрая), Ложь);
	Если КодЧтенияКрая = "0" Тогда
		ПробаЧтенияКрая("read.prefix.0", 0, Истина);
	КонецЕсли;
КонецЦикла;
Сообщить("file.end" + Символ(9) + "file-read-io-edges-1");
