// Формы выходного аргумента `ЗапуститьПриложение`.
// Запускает только завершающийся `/usr/bin/false`, файлы не меняет.

Перем СчетчикОбъектаЦели;
Перем СчетчикИндексаЦели;
Перем ОбъектПовторнойЦели;
Перем ПорядокЦели;

Функция ПолучитьОбъектЦели()
    СчетчикОбъектаЦели = СчетчикОбъектаЦели + 1;
    Возврат ОбъектПовторнойЦели;
КонецФункции

Функция ПолучитьКомандуЦели()
    ПорядокЦели = ПорядокЦели + "C";
    Возврат "/usr/bin/false";
КонецФункции

Функция ПолучитьОбъектПорядкаЦели()
    ПорядокЦели = ПорядокЦели + "T";
    Возврат ОбъектПовторнойЦели;
КонецФункции

Функция ПолучитьИндексЦели()
    СчетчикИндексаЦели = СчетчикИндексаЦели + 1;
    Возврат 0;
КонецФункции

Сообщить("file.begin" + Символ(9) + "runapp-output-targets-1");

КодЛокальнойЦели = 99;
Попытка
    Выполнить("ЗапуститьПриложение(""/usr/bin/false"", ""/tmp"", Истина, КодЛокальнойЦели);");
    Сообщить("target.local" + Символ(9) + "ok");
Исключение
    Сообщить("target.local" + Символ(9) + "error");
КонецПопытки;
Сообщить("target.local.value" + Символ(9) + Строка(КодЛокальнойЦели));

СтруктураЦели = Новый Структура("Code", 99);
Попытка
    Выполнить("ЗапуститьПриложение(""/usr/bin/false"", ""/tmp"", Истина, СтруктураЦели.Code);");
    Сообщить("target.field" + Символ(9) + "ok");
Исключение
    Сообщить("target.field" + Символ(9) + "error");
КонецПопытки;
Сообщить("target.field.value" + Символ(9) + Строка(СтруктураЦели.Code));

МассивЦели = Новый Массив;
МассивЦели.Добавить(99);
Попытка
    Выполнить("ЗапуститьПриложение(""/usr/bin/false"", ""/tmp"", Истина, МассивЦели[0]);");
    Сообщить("target.index" + Символ(9) + "ok");
Исключение
    Сообщить("target.index" + Символ(9) + "error");
КонецПопытки;
Сообщить("target.index.value" + Символ(9) + Строка(МассивЦели[0]));

СчетчикОбъектаЦели = 0;
ОбъектПовторнойЦели = Новый Структура("Code", 99);
Попытка
    Выполнить("ЗапуститьПриложение(""/usr/bin/false"", ""/tmp"", Истина, ПолучитьОбъектЦели().Code);");
    Сообщить("target.field.evaluations" + Символ(9) + Строка(СчетчикОбъектаЦели) + "|" + Строка(ОбъектПовторнойЦели.Code));
Исключение
    Сообщить("target.field.evaluations" + Символ(9) + "error");
КонецПопытки;

СчетчикИндексаЦели = 0;
МассивПовторнойЦели = Новый Массив;
МассивПовторнойЦели.Добавить(99);
Попытка
    Выполнить("ЗапуститьПриложение(""/usr/bin/false"", ""/tmp"", Истина, МассивПовторнойЦели[ПолучитьИндексЦели()]);");
    Сообщить("target.index.evaluations" + Символ(9) + Строка(СчетчикИндексаЦели) + "|" + Строка(МассивПовторнойЦели[0]));
Исключение
    Сообщить("target.index.evaluations" + Символ(9) + "error");
КонецПопытки;

ПорядокЦели = "";
ОбъектПовторнойЦели = Новый Структура("Code", 99);
Попытка
    Выполнить("ЗапуститьПриложение(ПолучитьКомандуЦели(), ""/tmp"", Истина, ПолучитьОбъектПорядкаЦели().Code);");
    Сообщить("target.evaluation_order" + Символ(9) + ПорядокЦели + "|" + Строка(ОбъектПовторнойЦели.Code));
Исключение
    Сообщить("target.evaluation_order" + Символ(9) + "error");
КонецПопытки;

Попытка
    Выполнить("ЗапуститьПриложение(""/usr/bin/false"", ""/tmp"", Истина, НоваяЦель); Сообщить(""target.new.value"" + Символ(9) + Строка(НоваяЦель));");
    Сообщить("target.new" + Символ(9) + "ok");
Исключение
    Сообщить("target.new" + Символ(9) + "error");
КонецПопытки;
Сообщить("file.end" + Символ(9) + "runapp-output-targets-1");
