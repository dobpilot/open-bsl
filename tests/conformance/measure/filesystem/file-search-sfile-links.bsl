// Серверная характеризация ссылок с особым именем a*.
// Для 1С placeholder заменяется корнем дерева, созданного средствами ОС.

Функция ЭкранироватьСсылкуSFile(ТекстСсылкиSFile, КореньСсылкиSFile)
	Возврат СтрЗаменить(Строка(ТекстСсылкиSFile), КореньСсылкиSFile, "<root>");
КонецФункции

Функция МетодСсылкиSFile(ОбъектСсылкиSFile, ИмяМетодаСсылкиSFile)
	Попытка
		РезультатМетодаСсылкиSFile = Вычислить(
			"ОбъектСсылкиSFile." + ИмяМетодаСсылкиSFile + "()");
		Если РезультатМетодаСсылкиSFile Тогда
			Возврат "1";
		Иначе
			Возврат "0";
		КонецЕсли;
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

Функция ОписаниеСсылкиSFile(ОбъектСсылкиSFile, КореньСсылкиSFile)
	Возврат ЭкранироватьСсылкуSFile(ОбъектСсылкиSFile.ПолноеИмя, КореньСсылкиSFile)
		+ "|exists=" + МетодСсылкиSFile(ОбъектСсылкиSFile, "Существует")
		+ "|dir=" + МетодСсылкиSFile(ОбъектСсылкиSFile, "ЭтоКаталог");
КонецФункции

Процедура ПробаСсылкиSFile(ИдСсылкиSFile, КаталогСсылкиSFile,
		КореньСсылкиSFile, МаскаСсылкиSFile, РекурсивноСсылкаSFile)
	Попытка
		РезультатыСсылкиSFile = НайтиФайлы(КаталогСсылкиSFile,
			МаскаСсылкиSFile, РекурсивноСсылкаSFile);
		ТекстСсылкиSFile = "ok:" + Строка(РезультатыСсылкиSFile.Количество());
		Для ИндексСсылкиSFile = 0 По РезультатыСсылкиSFile.Количество() - 1 Цикл
			ТекстСсылкиSFile = ТекстСсылкиSFile + "|"
				+ ОписаниеСсылкиSFile(РезультатыСсылкиSFile[ИндексСсылкиSFile],
					КореньСсылкиSFile);
		КонецЦикла;
	Исключение
		ТекстСсылкиSFile = "error";
	КонецПопытки;
	Сообщить(ИдСсылкиSFile + Символ(9) + ТекстСсылкиSFile);
КонецПроцедуры

Процедура МатрицаСсылкиSFile(ИдСсылкиSFile, КореньСсылкиSFile)
	КаталогСсылкиSFile = КореньСсылкиSFile + "/" + ИдСсылкиSFile;
	ПробаСсылкиSFile(ИдСсылкиSFile + ".flat.literal", КаталогСсылкиSFile,
		КореньСсылкиSFile, "a\*", Ложь);
	ПробаСсылкиSFile(ИдСсылкиSFile + ".flat.name", КаталогСсылкиSFile,
		КореньСсылкиSFile, "a*", Ложь);
	ПробаСсылкиSFile(ИдСсылкиSFile + ".flat.question", КаталогСсылкиSFile,
		КореньСсылкиSFile, "a?", Ложь);
	ПробаСсылкиSFile(ИдСсылкиSFile + ".flat.all", КаталогСсылкиSFile,
		КореньСсылкиSFile, "*", Ложь);
	ПробаСсылкиSFile(ИдСсылкиSFile + ".recursive.literal", КаталогСсылкиSFile,
		КореньСсылкиSFile, "a\*", Истина);
	ПробаСсылкиSFile(ИдСсылкиSFile + ".recursive.all", КаталогСсылкиSFile,
		КореньСсылкиSFile, "*", Истина);
	ПробаСсылкиSFile(ИдСсылкиSFile + ".recursive.txt", КаталогСсылкиSFile,
		КореньСсылкиSFile, "*.txt", Истина);
	Попытка
		ПрямыеСсылкиSFile = НайтиФайлы(КаталогСсылкиSFile + "/a*");
		Сообщить(ИдСсылкиSFile + ".direct.path" + Символ(9) + "ok:"
			+ Строка(ПрямыеСсылкиSFile.Количество()));
	Исключение
		Сообщить(ИдСсылкиSFile + ".direct.path" + Символ(9) + "error");
	КонецПопытки;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "search-sfile-links-1");
КореньСсылкиSFile = "__OPEN_BSL_SFILE_LINKS_ROOT__";
СвойКореньСсылкиSFile = Лев(КореньСсылкиSFile, 1) = "_";
Попытка
	Если СвойКореньСсылкиSFile Тогда
		КореньСсылкиSFile = ПолучитьИмяВременногоФайла(".search-sfile-links");
		КореньЦелейСсылкиSFile = КореньСсылкиSFile + "-targets";
		КодСсылкиSFile = 0;
		ЗапуститьПриложение("/bin/mkdir -p " + КореньСсылкиSFile + "/dir",
			"/tmp", Истина, КодСсылкиSFile);
		ЗапуститьПриложение("/bin/mkdir -p " + КореньСсылкиSFile + "/file",
			"/tmp", Истина, КодСсылкиSFile);
		ЗапуститьПриложение("/bin/mkdir -p " + КореньСсылкиSFile + "/broken",
			"/tmp", Истина, КодСсылкиSFile);
		ЗапуститьПриложение("/bin/mkdir -p " + КореньЦелейСсылкиSFile + "/actual-dir",
			"/tmp", Истина, КодСсылкиSFile);
		ДанныеСсылкиSFile = ПолучитьДвоичныеДанныеИзСтроки("ABC",
			КодировкаТекста.UTF8, Ложь);
		ДанныеСсылкиSFile.Записать(КореньЦелейСсылкиSFile + "/actual-dir/deep.txt");
		ДанныеСсылкиSFile.Записать(КореньЦелейСсылкиSFile + "/actual.txt");
		ЗапуститьПриложение("/bin/ln -s " + КореньЦелейСсылкиSFile
			+ "/actual-dir " + КореньСсылкиSFile + "/dir/a*",
			"/tmp", Истина, КодСсылкиSFile);
		ЗапуститьПриложение("/bin/ln -s " + КореньЦелейСсылкиSFile
			+ "/actual.txt " + КореньСсылкиSFile + "/file/a*",
			"/tmp", Истина, КодСсылкиSFile);
		ЗапуститьПриложение("/bin/ln -s " + КореньЦелейСсылкиSFile
			+ "/missing " + КореньСсылкиSFile + "/broken/a*",
			"/tmp", Истина, КодСсылкиSFile);
	КонецЕсли;

	МатрицаСсылкиSFile("dir", КореньСсылкиSFile);
	МатрицаСсылкиSFile("file", КореньСсылкиSFile);
	МатрицаСсылкиSFile("broken", КореньСсылкиSFile);
Исключение
	Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;

Если СвойКореньСсылкиSFile Тогда
	Попытка
		КодОчисткиСсылкиSFile = 0;
		ЗапуститьПриложение("/bin/rm -rf " + КореньСсылкиSFile,
			"/tmp", Истина, КодОчисткиСсылкиSFile);
		ЗапуститьПриложение("/bin/rm -rf " + КореньЦелейСсылкиSFile,
			"/tmp", Истина, КодОчисткиСсылкиSFile);
	Исключение
		Сообщить("file.cleanup_error" + Символ(9) + "search-sfile-links");
	КонецПопытки;
КонецЕсли;
Сообщить("file.end" + Символ(9) + "search-sfile-links-1");
