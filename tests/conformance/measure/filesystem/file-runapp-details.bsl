// Уточнение командной строки и выходного параметра на сервере.
// Пробы shell-операторов ограничены true/false/exit без изменения файлов.
Процедура ПробаДеталейЗапуска(ИдентификаторЗапуска, ТекстЗапуска)
	КодЗапускаПробы = 12345;
	Попытка
		Выполнить(ТекстЗапуска);
		РезультатЗапускаПробы = "ok";
	Исключение
		РезультатЗапускаПробы = "error|" + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Сообщить(ИдентификаторЗапуска + Символ(9) + РезультатЗапускаПробы + "|type=" + Строка(ТипЗнч(КодЗапускаПробы)) + "|code=" + Строка(КодЗапускаПробы));
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "runapp-details-1");
ПробаДеталейЗапуска("runapp.wait.true", "ЗапуститьПриложение(""/usr/bin/true"", ""/tmp"", Истина, КодЗапускаПробы);");
ПробаДеталейЗапуска("runapp.wait.false", "ЗапуститьПриложение(""/usr/bin/false"", ""/tmp"", Истина, КодЗапускаПробы);");
ПробаДеталейЗапуска("runapp.nowait.type", "ЗапуститьПриложение(""/usr/bin/true"", ""/tmp"", Ложь, КодЗапускаПробы);");
ПробаДеталейЗапуска("runapp.wait.undefined", "ЗапуститьПриложение(""/usr/bin/true"", ""/tmp"", Неопределено, КодЗапускаПробы);");
ПробаДеталейЗапуска("runapp.wait.hole", "ЗапуститьПриложение(""/usr/bin/true"", ""/tmp"", , КодЗапускаПробы);");
ПробаДеталейЗапуска("runapp.wait.zero", "ЗапуститьПриложение(""/usr/bin/true"", ""/tmp"", 0, КодЗапускаПробы);");
ПробаДеталейЗапуска("runapp.wait.one", "ЗапуститьПриложение(""/usr/bin/false"", ""/tmp"", 1, КодЗапускаПробы);");
ПробаДеталейЗапуска("runapp.wait.null", "ЗапуститьПриложение(""/usr/bin/true"", ""/tmp"", Null, КодЗапускаПробы);");
ПробаДеталейЗапуска("runapp.cwd.undefined", "ЗапуститьПриложение(""/usr/bin/true"", Неопределено, Истина, КодЗапускаПробы);");
ПробаДеталейЗапуска("runapp.cwd.missing", "ЗапуститьПриложение(""/usr/bin/true"", ""/open-bsl-nonexistent-directory"", Истина, КодЗапускаПробы);");
ПробаДеталейЗапуска("runapp.command.empty", "ЗапуститьПриложение("""", ""/tmp"", Истина, КодЗапускаПробы);");
ПробаДеталейЗапуска("runapp.command.undefined", "ЗапуститьПриложение(Неопределено, ""/tmp"", Истина, КодЗапускаПробы);");
ПробаДеталейЗапуска("runapp.shell.semicolon", "ЗапуститьПриложение(""/usr/bin/true ; /usr/bin/false"", ""/tmp"", Истина, КодЗапускаПробы);");
ПробаДеталейЗапуска("runapp.shell.and", "ЗапуститьПриложение(""/usr/bin/true && /usr/bin/false"", ""/tmp"", Истина, КодЗапускаПробы);");
ПробаДеталейЗапуска("runapp.shell.or", "ЗапуститьПриложение(""/usr/bin/false || /usr/bin/true"", ""/tmp"", Истина, КодЗапускаПробы);");
ПробаДеталейЗапуска("runapp.shell.builtin", "ЗапуститьПриложение(""exit 17"", ""/tmp"", Истина, КодЗапускаПробы);");
