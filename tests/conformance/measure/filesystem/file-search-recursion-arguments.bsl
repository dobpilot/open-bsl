// Поиск читает только собственное дерево. Рабочий каталог не меняется.
Процедура ИзмеритьАргументыРекурсии()
	Сообщить("file.begin" + Символ(9) + "file-search-recursion-arguments-1");
	Попытка
		Сообщить("context.compatibility" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
	Исключение
		Сообщить("context.compatibility" + Символ(9) + "unavailable");
	КонецПопытки;
	КореньПробыРекурсии = ПолучитьИмяВременногоФайла(".search-recursion");
	Попытка
		СоздатьКаталог(КореньПробыРекурсии + "/branch");
		БайтыПробыРекурсии = ПолучитьДвоичныеДанныеИзСтроки("abc", КодировкаТекста.UTF8, Ложь);
		БайтыПробыРекурсии.Записать(КореньПробыРекурсии + "/top.txt");
		БайтыПробыРекурсии.Записать(КореньПробыРекурсии + "/branch/deep.txt");
		МатрицаПробыРекурсии = СтрРазделить("true=Истина|false=Ложь|zero=0|one=1|negative=-1|two=2|fraction=0.1|negative_fraction=-0.1|ru_true=""Истина""|ru_false=""Ложь""|en_true=""True""|en_false=""False""|mixed=""tRuE""|space="" Истина ""|tab=Символ(9) + ""False"" + Символ(9)|nbsp=Символ(160) + ""True"" + Символ(160)|one_text=""1""|zero_text=""0""|empty=""""|blank="" ""|yes=""Да""|no=""Нет""|nul=""True"" + Символ(0) + ""False""|undefined=Неопределено|null=Null|array=Новый Массив|structure=Новый Структура|date=Дата(2020,1,2)", "|");
		ИменаПробыРекурсии = СтрРазделить("НайтиФайлы,FindFiles", ",");
		Для Каждого ЗаписьПробыРекурсии Из МатрицаПробыРекурсии Цикл
			РазделительПробыРекурсии = СтрНайти(ЗаписьПробыРекурсии, "=");
			ИдПробыРекурсии = Лев(ЗаписьПробыРекурсии, РазделительПробыРекурсии - 1);
			ЗначениеПробыРекурсии = Вычислить(Сред(ЗаписьПробыРекурсии, РазделительПробыРекурсии + 1));
			Для ИндексПробыРекурсии = 0 По 1 Цикл
				ОшибкаПробыРекурсии = "";
				СтадияПробыРекурсии = "call";
				Попытка
					РезультатПробыРекурсии = Вычислить(ИменаПробыРекурсии[ИндексПробыРекурсии] + "(КореньПробыРекурсии, ""*.txt"", ЗначениеПробыРекурсии)");
					ИтогПробыРекурсии = "ok|count=" + Строка(РезультатПробыРекурсии.Количество());
					Для Каждого ФайлПробыРекурсии Из РезультатПробыРекурсии Цикл
						ИтогПробыРекурсии = ИтогПробыРекурсии + "|" + СтрЗаменить(ФайлПробыРекурсии.ПолноеИмя, КореньПробыРекурсии, "<root>");
					КонецЦикла;
				Исключение
					ИтогПробыРекурсии = "error|stage=" + СтадияПробыРекурсии;
					ИнформацияПробыРекурсии = ИнформацияОбОшибке();
					Пока ИнформацияПробыРекурсии.Причина <> Неопределено Цикл
						ИнформацияПробыРекурсии = ИнформацияПробыРекурсии.Причина;
					КонецЦикла;
					ОшибкаПробыРекурсии = ИнформацияПробыРекурсии.Описание;
				КонецПопытки;
				ИдРезультатаРекурсии = "recursion." + ИдПробыРекурсии + "." + ?(ИндексПробыРекурсии = 0, "ru", "en");
				Сообщить(ИдРезультатаРекурсии + Символ(9) + ИтогПробыРекурсии);
				Если ОшибкаПробыРекурсии <> "" Тогда
					ОшибкаПробыРекурсии = СтрЗаменить(ОшибкаПробыРекурсии, КореньПробыРекурсии, "<root>");
					ОшибкаПробыРекурсии = СтрЗаменить(СтрЗаменить(СтрЗаменить(ОшибкаПробыРекурсии, Символ(13), "<CR>"), Символ(10), "<LF>"), Символ(9), "<TAB>");
					Сообщить(ИдРезультатаРекурсии + ".detail" + Символ(9) + ОшибкаПробыРекурсии);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Попытка
		УдалитьФайлы(КореньПробыРекурсии);
	Исключение
		Сообщить("file.cleanup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Сообщить("file.end" + Символ(9) + "file-search-recursion-arguments-1");
КонецПроцедуры

ИзмеритьАргументыРекурсии();

