// Только чтение подготовленного дерева; все цели ссылок принадлежат этой пробе.
Процедура ПробаПоискаСсылок(ИдСсылок, ПутьСсылок, МаскаСсылок, РекурсияСсылок, КореньСсылок)
	Попытка
		НайденныеСсылки = НайтиФайлы(ПутьСсылок, МаскаСсылок, РекурсияСсылок);
		ТекстСсылок = "ok|count=" + Строка(НайденныеСсылки.Количество());
		Для Каждого ЭлементСсылок Из НайденныеСсылки Цикл
			ТекстСсылок = ТекстСсылок + "|" + СтрЗаменить(ЭлементСсылок.ПолноеИмя, КореньСсылок, "<root>");
		КонецЦикла;
		Сообщить(ИдСсылок + Символ(9) + ТекстСсылок);
	Исключение
		Сообщить(ИдСсылок + Символ(9) + "error|" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецПроцедуры

Процедура ПробаМетаданныхСсылок(ИдСсылок, ПутьСсылок)
	ФайлСсылок = Новый Файл(ПутьСсылок);
	Для Каждого МетодСсылок Из СтрРазделить("Существует|ЭтоФайл|ЭтоКаталог|Размер", "|") Цикл
		Попытка
			ЗначениеСсылок = Вычислить("ФайлСсылок." + МетодСсылок + "()");
			Если ТипЗнч(ЗначениеСсылок) = Тип("Булево") Тогда
				ТекстСсылок = ?(ЗначениеСсылок, "1", "0");
			Иначе
				ТекстСсылок = Строка(ЗначениеСсылок);
			КонецЕсли;
		Исключение
			ТекстСсылок = "error";
		КонецПопытки;
		Сообщить(ИдСсылок + "." + МетодСсылок + Символ(9) + ТекстСсылок);
	КонецЦикла;
КонецПроцедуры

КореньСсылок = "/tmp/open-bsl-find-links-qqNElD/tree";
Сообщить("file.begin" + Символ(9) + "file-search-links-1");
ПробаПоискаСсылок("links.flat", КореньСсылок + "/root", "*", Ложь, КореньСсылок);
ПробаПоискаСсылок("links.recursive", КореньСсылок + "/root", "*", Истина, КореньСсылок);
ПробаПоискаСсылок("links.recursive.txt", КореньСсылок + "/root", "*.txt", Истина, КореньСсылок);
ПробаПоискаСсылок("links.root.alias", КореньСсылок + "/root/linked-dir", "*", Истина, КореньСсылок);
ПробаПоискаСсылок("links.direct.dir", КореньСсылок + "/root/linked-dir", "", Ложь, КореньСсылок);
ПробаПоискаСсылок("links.direct.file", КореньСсылок + "/root/linked-file.txt", "", Ложь, КореньСсылок);
ПробаПоискаСсылок("links.direct.broken", КореньСсылок + "/root/broken.txt", "", Ложь, КореньСсылок);
ПробаМетаданныхСсылок("links.meta.dir", КореньСсылок + "/root/linked-dir");
ПробаМетаданныхСсылок("links.meta.file", КореньСсылок + "/root/linked-file.txt");
ПробаМетаданныхСсылок("links.meta.broken", КореньСсылок + "/root/broken.txt");
Сообщить("file.end" + Символ(9) + "file-search-links-1");
