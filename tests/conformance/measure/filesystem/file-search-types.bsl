// Преобразования аргументов поиска: записи ограничены собственным каталогом.
Процедура ПробаТипаПоиска(ИдентификаторТиповойПробы, КореньТиповойПробы, ВыражениеТиповойПробы)
	Попытка
		МассивТиповойПробы = Вычислить(ВыражениеТиповойПробы);
		ТекстТиповойПробы = Строка(МассивТиповойПробы.Количество());
		Для Каждого ФайлТиповойПробы Из МассивТиповойПробы Цикл
			ИмяТиповойПробы = ФайлТиповойПробы.Имя;
			Если ФайлТиповойПробы.ПолноеИмя = КореньТиповойПробы Тогда
				ИмяТиповойПробы = ".";
			КонецЕсли;
			ТекстТиповойПробы = ТекстТиповойПробы + "|" + ИмяТиповойПробы;
		КонецЦикла;
	Исключение
		ТекстТиповойПробы = "error:" + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Сообщить(ИдентификаторТиповойПробы + Символ(9) + ТекстТиповойПробы);
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "search-types-1");
КореньТиповогоПоиска = "";
Попытка
	КореньТиповогоПоиска = ПолучитьИмяВременногоФайла(".searchtypes");
	СоздатьКаталог(КореньТиповогоПоиска + "/branch");
	ДанныеТиповогоПоиска = ПолучитьДвоичныеДанныеИзСтроки("x", КодировкаТекста.UTF8, Ложь);
	Для Каждого ИмяТиповогоФайла Из СтрРазделить("17|0|True|False|Да|Нет|Истина|Ложь|Null|Массив|Array|a.txt|branch/deep.txt", "|") Цикл
		ДанныеТиповогоПоиска.Записать(КореньТиповогоПоиска + "/" + ИмяТиповогоФайла);
	КонецЦикла;
	ПробаТипаПоиска("find.mask.number", КореньТиповогоПоиска, "НайтиФайлы(КореньТиповойПробы, 17)");
	ПробаТипаПоиска("find.mask.zero", КореньТиповогоПоиска, "НайтиФайлы(КореньТиповойПробы, 0)");
	ПробаТипаПоиска("find.mask.true", КореньТиповогоПоиска, "НайтиФайлы(КореньТиповойПробы, Истина)");
	ПробаТипаПоиска("find.mask.false", КореньТиповогоПоиска, "НайтиФайлы(КореньТиповойПробы, Ложь)");
	ПробаТипаПоиска("find.mask.null", КореньТиповогоПоиска, "НайтиФайлы(КореньТиповойПробы, Null)");
	ПробаТипаПоиска("find.mask.array", КореньТиповогоПоиска, "НайтиФайлы(КореньТиповойПробы, Новый Массив)");
	ПробаТипаПоиска("find.mask.undefined", КореньТиповогоПоиска, "НайтиФайлы(КореньТиповойПробы, Неопределено)");
	ПробаТипаПоиска("find.mask.string17", КореньТиповогоПоиска, "НайтиФайлы(КореньТиповойПробы, ""17"")");
	ПробаТипаПоиска("find.recursive.hole", КореньТиповогоПоиска, "НайтиФайлы(КореньТиповойПробы, ""*.txt"", )");
	ПробаТипаПоиска("find.mask.hole", КореньТиповогоПоиска, "НайтиФайлы(КореньТиповойПробы, , Истина)");
	ПробаТипаПоиска("find.both.holes", КореньТиповогоПоиска, "НайтиФайлы(КореньТиповойПробы, , )");
	ПробаТипаПоиска("find.recursive.undefined", КореньТиповогоПоиска, "НайтиФайлы(КореньТиповойПробы, ""*.txt"", Неопределено)");
	ПробаТипаПоиска("find.recursive.null", КореньТиповогоПоиска, "НайтиФайлы(КореньТиповойПробы, ""*.txt"", Null)");
	ПробаТипаПоиска("find.recursive.negative", КореньТиповогоПоиска, "НайтиФайлы(КореньТиповойПробы, ""*.txt"", -1)");
	ПробаТипаПоиска("find.recursive.stringtrue", КореньТиповогоПоиска, "НайтиФайлы(КореньТиповойПробы, ""*.txt"", ""Истина"")");
	ПробаТипаПоиска("find.recursive.empty", КореньТиповогоПоиска, "НайтиФайлы(КореньТиповойПробы, ""*.txt"", """")");
	ПробаТипаПоиска("find.path.fileobject", КореньТиповогоПоиска, "НайтиФайлы(Новый Файл(КореньТиповойПробы + ""/17""))");
Исключение
	Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Если КореньТиповогоПоиска <> "" Тогда
	Попытка
		УдалитьФайлы(КореньТиповогоПоиска);
	Исключение
		Сообщить("file.cleanup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецЕсли;
Сообщить("file.end" + Символ(9) + "search-types-1");
