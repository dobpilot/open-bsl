// Только чтение; порядок и цели ссылок сохранены в file-search-late-links.host.txt.
Процедура ПробаПозднихСсылок(ИдПозднихСсылок, КореньПозднихСсылок, ДеревоПозднихСсылок, МаскаПозднихСсылок, РекурсияПозднихСсылок, АнглийскийПозднихСсылок)
	Попытка
		ПутьПозднихСсылок = КореньПозднихСсылок + "/" + ДеревоПозднихСсылок;
		Если АнглийскийПозднихСсылок Тогда
			РезультатПозднихСсылок = FindFiles(ПутьПозднихСсылок, МаскаПозднихСсылок, РекурсияПозднихСсылок);
		Иначе
			РезультатПозднихСсылок = НайтиФайлы(ПутьПозднихСсылок, МаскаПозднихСсылок, РекурсияПозднихСсылок);
		КонецЕсли;
		ТекстПозднихСсылок = "ok|count=" + Строка(РезультатПозднихСсылок.Количество());
		Для Каждого ЭлементПозднихСсылок Из РезультатПозднихСсылок Цикл
			ТекстПозднихСсылок = ТекстПозднихСсылок + "|" + СтрЗаменить(ЭлементПозднихСсылок.ПолноеИмя, КореньПозднихСсылок, "<root>");
		КонецЦикла;
		Сообщить(ИдПозднихСсылок + Символ(9) + ТекстПозднихСсылок);
	Исключение
		Сообщить(ИдПозднихСсылок + Символ(9) + "error|" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-search-late-links-1");
Попытка
	Сообщить("context.compatibility" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
Исключение
	Сообщить("context.compatibility" + Символ(9) + "unavailable");
КонецПопытки;
КореньПозднихСсылок = "/tmp/open-bsl-find-late-links-wf3Azc";
Для Каждого ДеревоПозднихСсылок Из СтрРазделить("late,between,double,first", ",") Цикл
	Для Каждого МаскаПозднихСсылок Из СтрРазделить("*,*.*,*.txt,*.bin,b*,a*,*dir,broken.*", ",") Цикл
		Для РежимПозднихСсылок = 0 По 3 Цикл
			РекурсияПозднихСсылок = РежимПозднихСсылок >= 2;
			АнглийскийПозднихСсылок = РежимПозднихСсылок % 2 = 1;
			ИдПозднихСсылок = "late." + ДеревоПозднихСсылок + "." + МаскаПозднихСсылок
				+ ?(РекурсияПозднихСсылок, ".recursive", ".flat") + ?(АнглийскийПозднихСсылок, ".en", ".ru");
			ПробаПозднихСсылок(ИдПозднихСсылок, КореньПозднихСсылок, ДеревоПозднихСсылок, МаскаПозднихСсылок, РекурсияПозднихСсылок, АнглийскийПозднихСсылок);
		КонецЦикла;
	КонецЦикла;
КонецЦикла;
Сообщить("file.end" + Символ(9) + "file-search-late-links-1");
