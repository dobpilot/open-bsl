// Параметры и наблюдаемая видимость временного потока, без предположений о внутреннем буфере.
Процедура ПробаПараметровВременного(ИдПробыВременного, ВыражениеПробыВременного)
    ПотокПробыВременного = Неопределено;
    СтадияПробыВременного = "call";
    Попытка
        ПотокПробыВременного = Вычислить(ВыражениеПробыВременного);
        СтадияПробыВременного = "inspect";
        ИтогПробыВременного = "ok|" + Строка(ТипЗнч(ПотокПробыВременного))
            + "|" + Строка(ПотокПробыВременного.Размер())
            + "|" + Строка(ПотокПробыВременного.ТекущаяПозиция())
            + "|" + ?(ПотокПробыВременного.ДоступноЧтение, "r", "-")
            + ?(ПотокПробыВременного.ДоступнаЗапись, "w", "-")
            + ?(ПотокПробыВременного.ДоступноИзменениеПозиции, "s", "-");
        ПутьПробыВременного = Вычислить("ПотокПробыВременного.ИмяФайла");
        ФайлПробыВременного = Новый Файл(ПутьПробыВременного);
        ИтогПробыВременного = ИтогПробыВременного + "|exists=" + ?(ФайлПробыВременного.Существует(), "1", "0");
        ПотокПробыВременного.Закрыть();
        ИтогПробыВременного = ИтогПробыВременного + "|closed_name="
            + ?(Вычислить("ПотокПробыВременного.FileName") = ПутьПробыВременного, "same", "different")
            + "|closed_exists=" + ?(ФайлПробыВременного.Существует(), "1", "0");
    Исключение
        ИтогПробыВременного = "error|" + СтадияПробыВременного;
    КонецПопытки;
    Сообщить(ИдПробыВременного + Символ(9) + ИтогПробыВременного);
    Если ПотокПробыВременного <> Неопределено Тогда
        Попытка ПотокПробыВременного.Закрыть(); Исключение КонецПопытки;
    КонецЕсли;
КонецПроцедуры

Процедура ВидимостьВременного(ИдВидимости, АргументыВидимости)
    ПотокВидимости = Неопределено;
    Попытка
        ПотокВидимости = Вычислить("ФайловыеПотоки.СоздатьВременныйФайл(" + АргументыВидимости + ")");
        ПутьВидимости = Вычислить("ПотокВидимости.ИмяФайла");
        ФайлВидимости = Новый Файл(ПутьВидимости);
        ИтогВидимости = "";
        Для Каждого РазмерТекстаВидимости Из СтрРазделить("1,8,8191,8192,8193", ",") Цикл
            РазмерВидимости = Число(РазмерТекстаВидимости);
            БуферВидимости = Новый БуферДвоичныхДанных(РазмерВидимости);
            БуферВидимости[0] = 65;
            БуферВидимости[РазмерВидимости - 1] = 90;
            ПотокВидимости.Перейти(0, ПозицияВПотоке.Начало);
            ПотокВидимости.Записать(БуферВидимости, 0, РазмерВидимости);
            // Независимый дескриптор читает до Размер/Перейти/Закрыть исходного потока.
            ДанныеВидимости = Новый ДвоичныеДанные(ПутьВидимости);
            БуферЧтенияВидимости = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДанныеВидимости);
            Если ИтогВидимости <> "" Тогда ИтогВидимости = ИтогВидимости + ";"; КонецЕсли;
            ИтогВидимости = ИтогВидимости + Строка(ФайлВидимости.Размер()) + "/"
                + Строка(ДанныеВидимости.Размер()) + "/"
                + Строка(БуферЧтенияВидимости[0]) + "/"
                + Строка(БуферЧтенияВидимости[РазмерВидимости - 1]);
        КонецЦикла;
        Сообщить(ИдВидимости + Символ(9) + ИтогВидимости);
    Исключение
        Сообщить(ИдВидимости + Символ(9) + "error|" + ИнформацияОбОшибке().Описание);
    КонецПопытки;
    Если ПотокВидимости <> Неопределено Тогда
        Попытка ПотокВидимости.Закрыть(); Исключение КонецПопытки;
    КонецЕсли;
КонецПроцедуры

