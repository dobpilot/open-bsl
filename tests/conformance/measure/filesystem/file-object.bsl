// Исследовательский измеритель интерфейса Файл. Это не oracle реестра.
// Неизвестные open-bsl члены проверяются динамически, без ошибки компиляции
// всего модуля формы. Все записи и удаления ограничены выданными temp-путями.

Процедура ЗаписатьПробу(ИдентификаторПробы, ТекстПробы)
	Сообщить(ИдентификаторПробы + Символ(9) + ТекстПробы);
КонецПроцедуры

Процедура ПроверитьВыражениеФайла(ИдентификаторПробы, ПутьПробы, ВыражениеПробы)
	Попытка
		ОбъектПробы = Вычислить("Новый Файл(ПутьПробы)");
		РезультатПробы = Вычислить(ВыражениеПробы);
		ТекстПробы = Строка(ТипЗнч(РезультатПробы)) + ":" + Строка(РезультатПробы);
	Исключение
		ТекстПробы = "error:" + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	ЗаписатьПробу(ИдентификаторПробы, ТекстПробы);
КонецПроцедуры

Процедура ПроверитьИзменениеФайла(ИдентификаторПробы, ПутьПробы, КомандаПробы, ВыражениеПробы)
	Попытка
		ОбъектПробы = Вычислить("Новый Файл(ПутьПробы)");
		Выполнить(КомандаПробы);
		РезультатПробы = Вычислить(ВыражениеПробы);
		ТекстПробы = Строка(ТипЗнч(РезультатПробы)) + ":" + Строка(РезультатПробы);
	Исключение
		ТекстПробы = "error:" + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	ЗаписатьПробу(ИдентификаторПробы, ТекстПробы);
КонецПроцедуры

Процедура ПроверитьКонструкторФайла(ИдентификаторПробы, ВыражениеПробы)
	Попытка
		ОбъектПробы = Вычислить(ВыражениеПробы);
		ТекстПробы = Строка(ТипЗнч(ОбъектПробы)) + ":" + ОбъектПробы.ПолноеИмя;
	Исключение
		ТекстПробы = "error:" + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	ЗаписатьПробу(ИдентификаторПробы, ТекстПробы);
КонецПроцедуры

Процедура ПроверитьАктуальностьФайла(ПутьПробы)
	Попытка
		ОбъектПробы = Вычислить("Новый Файл(ПутьПробы)");
		ЗаписатьПробу("refresh.before", Строка(Вычислить("ОбъектПробы.Существует()")));
		ДанныеПробы = ПолучитьДвоичныеДанныеИзСтроки("A", КодировкаТекста.UTF8, Ложь);
		ДанныеПробы.Записать(ПутьПробы);
		ЗаписатьПробу("refresh.created", Строка(Вычислить("ОбъектПробы.Существует()")));
		ЗаписатьПробу("refresh.size.before", Строка(Вычислить("ОбъектПробы.Размер()")));
		ДанныеПробы = ПолучитьДвоичныеДанныеИзСтроки("ABCDE", КодировкаТекста.UTF8, Ложь);
		ДанныеПробы.Записать(ПутьПробы);
		ЗаписатьПробу("refresh.size.after", Строка(Вычислить("ОбъектПробы.Размер()")));
		УдалитьФайлы(ПутьПробы);
		ЗаписатьПробу("refresh.deleted", Строка(Вычислить("ОбъектПробы.Существует()")));
	Исключение
		ЗаписатьПробу("refresh.error", ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецПроцедуры

ЗаписатьПробу("file.begin", "1");
ПроверитьВыражениеФайла("path.name", "каталог/имя.tar.gz", "ОбъектПробы.Имя");
ПроверитьВыражениеФайла("path.basename", "каталог/имя.tar.gz", "ОбъектПробы.ИмяБезРасширения");
ПроверитьВыражениеФайла("path.extension", "каталог/имя.tar.gz", "ОбъектПробы.Расширение");
ПроверитьВыражениеФайла("path.parent", "каталог/имя.tar.gz", "ОбъектПробы.Путь");
ПроверитьВыражениеФайла("path.full", "каталог/имя.tar.gz", "ОбъектПробы.ПолноеИмя");
ПроверитьВыражениеФайла("path.empty", "", "ОбъектПробы.ПолноеИмя");
ПроверитьВыражениеФайла("path.dotfile", ".hidden", "ОбъектПробы.ИмяБезРасширения + Символ(124) + ОбъектПробы.Расширение");
ПроверитьВыражениеФайла("path.trailing", "каталог/", "ОбъектПробы.Имя + Символ(124) + ОбъектПробы.Путь");
ПроверитьВыражениеФайла("path.dots", "каталог/../имя.txt", "ОбъектПробы.ПолноеИмя");
ПроверитьВыражениеФайла("path.backslash", "каталог\имя.txt", "ОбъектПробы.Имя + Символ(124) + ОбъектПробы.Путь");
ПроверитьКонструкторФайла("constructor.en", "Новый File(""directory/name.txt"")");
ПроверитьВыражениеФайла("path.name.en", "каталог/имя.tar.gz", "ОбъектПробы.Name");
ПроверитьВыражениеФайла("path.basename.en", "каталог/имя.tar.gz", "ОбъектПробы.BaseName");
ПроверитьВыражениеФайла("path.extension.en", "каталог/имя.tar.gz", "ОбъектПробы.Extension");
ПроверитьВыражениеФайла("path.parent.en", "каталог/имя.tar.gz", "ОбъектПробы.Path");
ПроверитьВыражениеФайла("path.full.en", "каталог/имя.tar.gz", "ОбъектПробы.FullName");

ПутьФайловойПробы = "";
КореньФайловойПробы = "";
Попытка
	КореньФайловойПробы = ПолучитьИмяВременногоФайла(".files");
	Выполнить("СоздатьКаталог(КореньФайловойПробы);");
	ЗаписатьПробу("file.scratch", КореньФайловойПробы);
	ПроверитьВыражениеФайла("directory.exists", КореньФайловойПробы, "ОбъектПробы.Существует()");
	ПроверитьВыражениеФайла("directory.isfile", КореньФайловойПробы, "ОбъектПробы.ЭтоФайл()");
	ПроверитьВыражениеФайла("directory.isdir", КореньФайловойПробы, "ОбъектПробы.ЭтоКаталог()");
	ПроверитьВыражениеФайла("directory.size", КореньФайловойПробы, "ОбъектПробы.Размер()");
	ПроверитьВыражениеФайла("directory.trailing.isdir", КореньФайловойПробы + ПолучитьРазделительПути(), "ОбъектПробы.ЭтоКаталог()");
	ПроверитьАктуальностьФайла(КореньФайловойПробы + ПолучитьРазделительПути() + "refresh.bin");
	ПутьФайловойПробы = КореньФайловойПробы + ПолучитьРазделительПути() + "probe.bin";
	ПроверитьВыражениеФайла("missing.exists", ПутьФайловойПробы, "ОбъектПробы.Существует()");
	ПроверитьВыражениеФайла("missing.isfile", ПутьФайловойПробы, "ОбъектПробы.ЭтоФайл()");
	ПроверитьВыражениеФайла("missing.isdir", ПутьФайловойПробы, "ОбъектПробы.ЭтоКаталог()");
	ПроверитьВыражениеФайла("missing.size", ПутьФайловойПробы, "ОбъектПробы.Размер()");
	ДанныеФайловойПробы = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
	ДанныеФайловойПробы.Записать(ПутьФайловойПробы);
	ПроверитьВыражениеФайла("existing.exists", ПутьФайловойПробы, "ОбъектПробы.Существует()");
	ПроверитьВыражениеФайла("existing.isfile", ПутьФайловойПробы, "ОбъектПробы.ЭтоФайл()");
	ПроверитьВыражениеФайла("existing.isdir", ПутьФайловойПробы, "ОбъектПробы.ЭтоКаталог()");
	ПроверитьВыражениеФайла("existing.size", ПутьФайловойПробы, "ОбъектПробы.Размер()");
	ПроверитьВыражениеФайла("existing.hidden", ПутьФайловойПробы, "ОбъектПробы.ПолучитьНевидимость()");
	ПроверитьВыражениеФайла("existing.readonly", ПутьФайловойПробы, "ОбъектПробы.ПолучитьТолькоЧтение()");
	ПроверитьИзменениеФайла("time.local", ПутьФайловойПробы,
		"ОбъектПробы.УстановитьВремяИзменения(Дата(2020, 7, 15, 12, 34, 56));",
		"ОбъектПробы.ПолучитьВремяИзменения() = Дата(2020, 7, 15, 12, 34, 56)");
	ПроверитьИзменениеФайла("time.utc", ПутьФайловойПробы,
		"ОбъектПробы.УстановитьУниверсальноеВремяИзменения(Дата(2020, 1, 15, 12, 34, 56));",
		"ОбъектПробы.ПолучитьУниверсальноеВремяИзменения() = Дата(2020, 1, 15, 12, 34, 56)");
	ПроверитьИзменениеФайла("attribute.hidden", ПутьФайловойПробы,
		"ОбъектПробы.УстановитьНевидимость(Истина);", "ОбъектПробы.ПолучитьНевидимость()");
	ПроверитьИзменениеФайла("attribute.readonly.set", ПутьФайловойПробы,
		"ОбъектПробы.УстановитьТолькоЧтение(Истина);", "ОбъектПробы.ПолучитьТолькоЧтение()");
	ПроверитьИзменениеФайла("attribute.readonly.clear", ПутьФайловойПробы,
		"ОбъектПробы.УстановитьТолькоЧтение(Ложь);", "ОбъектПробы.ПолучитьТолькоЧтение()");
Исключение
	ЗаписатьПробу("file.setup_error", ИнформацияОбОшибке().Описание);
КонецПопытки;

Если КореньФайловойПробы <> "" Тогда
	Попытка
		УдалитьФайлы(КореньФайловойПробы);
		ЗаписатьПробу("file.cleanup", "ok");
	Исключение
		ЗаписатьПробу("file.cleanup_error", ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецЕсли;
ЗаписатьПробу("file.end", "1");
