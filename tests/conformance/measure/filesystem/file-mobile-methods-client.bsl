Процедура ПробаМобильногоМетода(ИдПробы, ФайлПробы, ВыражениеПробы, ЭтоПроцедура)
	Попытка
		Если ЭтоПроцедура Тогда
			Выполнить(ВыражениеПробы);
			Сообщить(ИдПробы + Символ(9) + "ok|procedure");
		Иначе
			РезультатПробы = Вычислить(ВыражениеПробы);
			Сообщить(ИдПробы + Символ(9) + "ok|type=" + Строка(ТипЗнч(РезультатПробы)));
		КонецЕсли;
	Исключение
		ИнформацияПробы = ИнформацияОбОшибке();
		ТекстОшибкиПробы = СтрЗаменить(ИнформацияПробы.Описание, Символ(13), "<CR>");
		ТекстОшибкиПробы = СтрЗаменить(ТекстОшибкиПробы, Символ(10), "<LF>");
		Сообщить(ИдПробы + Символ(9) + "error|" + ТекстОшибкиПробы);
	КонецПопытки;
КонецПроцедуры

Асинх Функция ПробаМобильногоМетодаАсинх(ИдПробы, ФайлПробы, ВыражениеПробы)
	СтадияПробы = "call";
	ТипОбещанияПробы = "none";
	Попытка
		ОбещаниеПробы = Вычислить(ВыражениеПробы);
		ТипОбещанияПробы = Строка(ТипЗнч(ОбещаниеПробы));
		СтадияПробы = "await";
		РезультатПробы = Ждать ОбещаниеПробы;
		Сообщить(ИдПробы + Символ(9) + "promise=" + ТипОбещанияПробы
			+ "|ok|type=" + Строка(ТипЗнч(РезультатПробы)));
	Исключение
		ИнформацияПробы = ИнформацияОбОшибке();
		ТекстОшибкиПробы = СтрЗаменить(ИнформацияПробы.Описание, Символ(13), "<CR>");
		ТекстОшибкиПробы = СтрЗаменить(ТекстОшибкиПробы, Символ(10), "<LF>");
		Сообщить(ИдПробы + Символ(9) + "promise=" + ТипОбещанияПробы
			+ "|error|stage=" + СтадияПробы + "|" + ТекстОшибкиПробы);
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

