// Строковая грамматика setter-ов времени Файл. Каждый случай использует
// отдельный файл, чтобы отказ не наследовал результат предыдущей пробы.

Функция ПоляСтроковойДаты(ЗначениеСтроковойДаты)
	Возврат Формат(Год(ЗначениеСтроковойДаты), "ЧН=0;ЧГ=0") + "-"
		+ Формат(Месяц(ЗначениеСтроковойДаты), "ЧН=0;ЧГ=0") + "-"
		+ Формат(День(ЗначениеСтроковойДаты), "ЧН=0;ЧГ=0") + " "
		+ Формат(Час(ЗначениеСтроковойДаты), "ЧН=0;ЧГ=0") + ":"
		+ Формат(Минута(ЗначениеСтроковойДаты), "ЧН=0;ЧГ=0") + ":"
		+ Формат(Секунда(ЗначениеСтроковойДаты), "ЧН=0;ЧГ=0");
КонецФункции

Процедура ПробаСтроковогоВремени(КореньСтроковогоВремени, КодСтроковогоВремени,
		АргументСтроковогоВремени, МестноеСтроковоеВремя)
	ПутьСтроковогоВремени = КореньСтроковогоВремени + "/" + КодСтроковогоВремени;
	ДанныеСтроковогоВремени = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
	ДанныеСтроковогоВремени.Записать(ПутьСтроковогоВремени);
	ФайлСтроковогоВремени = Новый Файл(ПутьСтроковогоВремени);
	ФайлСтроковогоВремени.УстановитьУниверсальноеВремяИзменения(Дата(2020, 1, 2, 3, 4, 5));
	Попытка
		Если МестноеСтроковоеВремя Тогда
			ФайлСтроковогоВремени.УстановитьВремяИзменения(АргументСтроковогоВремени);
		Иначе
			ФайлСтроковогоВремени.УстановитьУниверсальноеВремяИзменения(АргументСтроковогоВремени);
		КонецЕсли;
		ИтогСтроковогоВремени = "ok";
	Исключение
		ИтогСтроковогоВремени = "error";
	КонецПопытки;
	Попытка
		ИтогСтроковогоВремени = ИтогСтроковогоВремени + "|local="
			+ ПоляСтроковойДаты(ФайлСтроковогоВремени.ПолучитьВремяИзменения());
	Исключение
		ИтогСтроковогоВремени = ИтогСтроковогоВремени + "|local=error";
	КонецПопытки;
	Попытка
		ИтогСтроковогоВремени = ИтогСтроковогоВремени + "|utc="
			+ ПоляСтроковойДаты(ФайлСтроковогоВремени.ПолучитьУниверсальноеВремяИзменения());
	Исключение
		ИтогСтроковогоВремени = ИтогСтроковогоВремени + "|utc=error";
	КонецПопытки;
	Сообщить(КодСтроковогоВремени + Символ(9) + ИтогСтроковогоВремени);
КонецПроцедуры

Процедура МатрицаСтроковогоВремени(КореньСтроковогоВремени,
		ПрефиксСтроковогоВремени, МестноеСтроковоеВремя)
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".empty", "", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".space", " ", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".valid8", "20200115", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".valid14", "20200115123456", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".zero8", "00000000", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".zero14", "00000000000000", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".len7", "2020011", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".len9", "202001150", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".len13", "2020011512345", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".len15", "202001151234567", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".month", "20201301", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".day", "20200230", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".hour", "20200101240000", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".minute", "20200101006000", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".second", "20200101000060", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".leading", " 20200115", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".trailing", "20200115 ", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".tab.leading", Символ(9) + "20200115", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".tab.trailing", "20200115" + Символ(9), МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".lf.leading", Символ(10) + "20200115", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".lf.trailing", "20200115" + Символ(10), МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".cr.leading", Символ(13) + "20200115", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".cr.trailing", "20200115" + Символ(13), МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".nel.leading", Символ(133) + "20200115", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".nel.trailing", "20200115" + Символ(133), МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".nbsp.leading", Символ(160) + "20200115", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".nbsp.trailing", "20200115" + Символ(160), МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".zwsp.leading", Символ(8203) + "20200115", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".zwsp.trailing", "20200115" + Символ(8203), МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".bom.leading", Символ(65279) + "20200115", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".bom.trailing", "20200115" + Символ(65279), МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".hyphen", "2020-01-15", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".dot", "15.01.2020", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".plus", "+20200115", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".letter", "2020A115", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".nul.trailing8", "20200115" + Символ(0), МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".nul.trailing14", "20200115123456" + Символ(0), МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".nul.leading", Символ(0) + "20200115", МестноеСтроковоеВремя);
	ПробаСтроковогоВремени(КореньСтроковогоВремени, ПрефиксСтроковогоВремени + ".nul.middle", "2020" + Символ(0) + "0115", МестноеСтроковоеВремя);
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "time-string-arguments-1");
КореньСтроковогоВремени = "";
Попытка
	КореньСтроковогоВремени = ПолучитьИмяВременногоФайла(".time-string-arguments");
	СоздатьКаталог(КореньСтроковогоВремени);
	МатрицаСтроковогоВремени(КореньСтроковогоВремени, "utc", Ложь);
	МатрицаСтроковогоВремени(КореньСтроковогоВремени, "local", Истина);
Исключение
	Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Если КореньСтроковогоВремени <> "" Тогда
	Попытка
		УдалитьФайлы(КореньСтроковогоВремени);
	Исключение
		Сообщить("file.cleanup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецЕсли;
Сообщить("file.end" + Символ(9) + "time-string-arguments-1");
