Процедура ПроверитьКонструкторОбъекта(ИдПробы, ВыражениеПробы)
	МассивПолучателя = Новый Массив;
	МассивПолучателя.Добавить(10);
	Попытка
		ОписаниеПробы = Вычислить(ВыражениеПробы);
		Сообщить(ИдПробы + Символ(9) + "ok");
	Исключение
		Сообщить(ИдПробы + Символ(9) + "error");
	КонецПопытки;
	Сообщить(ИдПробы + ".unchanged" + Символ(9) + Строка(МассивПолучателя.Количество()) + ":" + Строка(МассивПолучателя[0]));
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "notification-object-constructor-1");
Попытка
	ПустоеОписание = Вычислить("Новый ОписаниеОповещения()");
	Сообщить("canary" + Символ(9) + "ok");
	Сообщить("type" + Символ(9) + Строка(ТипЗнч(ПустоеОписание)));
	Сообщить("display" + Символ(9) + Строка(ПустоеОписание));
	Сообщить("zero.names" + Символ(9) + ?(ПустоеОписание.ИмяПроцедуры = "" И ПустоеОписание.ИмяПроцедурыОбработкиОшибки = "", "ok", "bad"));
	Сообщить("zero.values" + Символ(9) + ?(ПустоеОписание.Модуль = Неопределено И ПустоеОписание.ДополнительныеПараметры = Неопределено И ПустоеОписание.МодульОбработкиОшибки = Неопределено, "ok", "bad"));
Исключение
	Сообщить("canary" + Символ(9) + "error");
	Возврат;
КонецПопытки;

ПроверитьКонструкторОбъекта("arity.0", "Новый ОписаниеОповещения()");
ПроверитьКонструкторОбъекта("arity.1", "Новый ОписаниеОповещения(""Добавить"")");
ПроверитьКонструкторОбъекта("arity.2", "Новый ОписаниеОповещения(""Добавить"", МассивПолучателя)");
ПроверитьКонструкторОбъекта("arity.3", "Новый ОписаниеОповещения(""Добавить"", МассивПолучателя, 7)");
ПроверитьКонструкторОбъекта("arity.4", "Новый ОписаниеОповещения(""Добавить"", МассивПолучателя, 7, ""Количество"")");
ПроверитьКонструкторОбъекта("arity.5", "Новый ОписаниеОповещения(""Добавить"", МассивПолучателя, 7, ""Количество"", МассивПолучателя)");
ПроверитьКонструкторОбъекта("arity.6", "Новый ОписаниеОповещения(""Добавить"", МассивПолучателя, 7, ""Количество"", МассивПолучателя, 8)");
ПроверитьКонструкторОбъекта("english", "New NotifyDescription(""Add"", МассивПолучателя)");
ПроверитьКонструкторОбъекта("name.number", "Новый ОписаниеОповещения(123, МассивПолучателя)");
ПроверитьКонструкторОбъекта("name.empty", "Новый ОписаниеОповещения("""", МассивПолучателя)");
ПроверитьКонструкторОбъекта("name.undefined", "Новый ОписаниеОповещения(Неопределено, МассивПолучателя)");
ПроверитьКонструкторОбъекта("name.spaces", "Новый ОписаниеОповещения("" Add "", МассивПолучателя)");
ПроверитьКонструкторОбъекта("receiver.null", "Новый ОписаниеОповещения(""Add"", Null)");
ПроверитьКонструкторОбъекта("receiver.boolean", "Новый ОписаниеОповещения(""Add"", Истина)");
ПроверитьКонструкторОбъекта("receiver.date", "Новый ОписаниеОповещения(""Add"", '20260910')");
ПроверитьКонструкторОбъекта("receiver.type", "Новый ОписаниеОповещения(""Add"", Тип(""Массив""))");

Попытка
	ПолучательСвойств = Новый Массив;
	ДанныеСвойств = Новый Структура("Счетчик", 1);
	ОписаниеСвойств = Вычислить("Новый ОписаниеОповещения(""ADD"", ПолучательСвойств, ДанныеСвойств, ""Count"", ПолучательСвойств)");
	ПсевдонимСвойств = ОписаниеСвойств;
	ВтороеОписаниеСвойств = Вычислить("Новый ОписаниеОповещения(""ADD"", ПолучательСвойств, ДанныеСвойств, ""Count"", ПолучательСвойств)");
	ДанныеСвойств.Счетчик = 2;
	Сообщить("identity.alias" + Символ(9) + ?(ОписаниеСвойств = ПсевдонимСвойств, "ok", "bad"));
	Сообщить("identity.independent" + Символ(9) + ?(ОписаниеСвойств <> ВтороеОписаниеСвойств, "ok", "bad"));
	Сообщить("identity.data" + Символ(9) + Строка(ОписаниеСвойств.ДополнительныеПараметры.Счетчик));
	Сообщить("identity.receivers" + Символ(9) + ?(ОписаниеСвойств.Модуль = ПолучательСвойств И ОписаниеСвойств.МодульОбработкиОшибки = ПолучательСвойств, "ok", "bad"));
	Сообщить("names.original" + Символ(9) + ОписаниеСвойств.ИмяПроцедуры + ":" + ОписаниеСвойств.ИмяПроцедурыОбработкиОшибки);
	ИменаСвойств = СтрРазделить("ИмяПроцедуры,ProcedureName,Модуль,Module,ДополнительныеПараметры,AdditionalParameters,ИмяПроцедурыОбработкиОшибки,ErrorHandlerProcedureName,МодульОбработкиОшибки,ErrorHandlerModule", ",");
	Для Каждого ИмяПроверяемогоСвойства Из ИменаСвойств Цикл
		Попытка
			ЗначениеПроверяемогоСвойства = Вычислить("ОписаниеСвойств." + ИмяПроверяемогоСвойства);
			Сообщить("read." + ИмяПроверяемогоСвойства + Символ(9) + "ok");
		Исключение
			Сообщить("read." + ИмяПроверяемогоСвойства + Символ(9) + "error");
		КонецПопытки;
		Попытка
			Выполнить("ОписаниеСвойств." + ИмяПроверяемогоСвойства + " = Неопределено;");
			Сообщить("write." + ИмяПроверяемогоСвойства + Символ(9) + "ok");
		Исключение
			Сообщить("write." + ИмяПроверяемогоСвойства + Символ(9) + "error");
		КонецПопытки;
	КонецЦикла;
Исключение
	Сообщить("properties.error" + Символ(9) + "error");
КонецПопытки;
Сообщить("file.end" + Символ(9) + "notification-object-constructor-1");
