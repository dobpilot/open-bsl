// Нулевые календарные поля через клиентские Async-getter'ы времени файла.

Функция ТекстАсинхДаты(Знач АсинхДата)
    Возврат Строка(Год(АсинхДата)) + "-" + Строка(Месяц(АсинхДата))
        + "-" + Строка(День(АсинхДата)) + " " + Строка(Час(АсинхДата))
        + ":" + Строка(Минута(АсинхДата)) + ":" + Строка(Секунда(АсинхДата))
        + "|delta=" + Формат(АсинхДата - Дата(1, 1, 1), "ЧГ=0;ЧРД=.;ЧН=0");
КонецФункции

Асинх Процедура ИзмеритьНулевыеДатыАсинх()
    Сообщить("file.begin" + Символ(9) + "file-zero-date-async-1");
    ПутьАсинхДат = ПолучитьИмяВременногоФайла(".zero-date-async");
    Попытка
        ДанныеАсинхДат = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
        ДанныеАсинхДат.Записать(ПутьАсинхДат);
        ФайлАсинхДат = Новый Файл(ПутьАсинхДат);

        ФайлАсинхДат.УстановитьВремяИзменения(Дата(1, 1, 1));
        ЛокальнаяСинхДата = ФайлАсинхДат.ПолучитьУниверсальноеВремяИзменения();
        ЛокальноеОбещание = ФайлАсинхДат.ПолучитьУниверсальноеВремяИзмененияАсинх();
        ЛокальнаяАсинхДата = Ждать ЛокальноеОбещание;

        ФайлАсинхДат.SetModificationUniversalTime(Дата(1, 1, 1));
        УниверсальнаяСинхДата = ФайлАсинхДат.GetModificationUniversalTime();
        УниверсальноеОбещание = Вычислить("ФайлАсинхДат.GetModificationUniversalTimeAsync()");
        УниверсальнаяАсинхДата = Ждать УниверсальноеОбещание;

        Сообщить("async.local" + Символ(9) + ТекстАсинхДаты(ЛокальнаяАсинхДата)
            + "|sync=" + ?(ЛокальнаяАсинхДата = ЛокальнаяСинхДата, "1", "0"));
        Сообщить("async.utc" + Символ(9) + ТекстАсинхДаты(УниверсальнаяАсинхДата)
            + "|sync=" + ?(УниверсальнаяАсинхДата = УниверсальнаяСинхДата, "1", "0"));
        Сообщить("async.order" + Символ(9)
            + ?(ЛокальнаяАсинхДата < УниверсальнаяАсинхДата, "1", "0"));
        Сообщить("async.repeat" + Символ(9)
            + ?((Ждать ЛокальноеОбещание) = ЛокальнаяАсинхДата, "1", "0")
            + "|" + ?((Ждать УниверсальноеОбещание) = УниверсальнаяАсинхДата, "1", "0"));
    Исключение
        Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
    КонецПопытки;
    Попытка
        УдалитьФайлы(ПутьАсинхДат);
    Исключение
        Сообщить("file.cleanup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
    КонецПопытки;
    Сообщить("file.end" + Символ(9) + "file-zero-date-async-1");
    Попытка Выполнить("ЗавершитьРаботуСистемы(Ложь)"); Исключение КонецПопытки;
КонецПроцедуры

ИзмеритьНулевыеДатыАсинх();
