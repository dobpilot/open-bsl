Асинх Функция ЗадачаОжидания(ОшибкаОжидания)
    Ждать 0;
    Если ОшибкаОжидания Тогда
        ВызватьИсключение "ошибка ожидания";
    КонецЕсли;
    Возврат 23;
КонецФункции

Асинх Функция ПроверитьОжидание(ИдОжидания, ВыражениеОжидания, ОшибкаОжидания)
    ОбещаниеОжидания = ЗадачаОжидания(ОшибкаОжидания);
    ЛокальнаяОжидания = 1;
    Попытка
        Выполнить(ВыражениеОжидания);
        ОтветОжидания = "ok|" + Строка(ЛокальнаяОжидания);
    Исключение
        ОтветОжидания = "error|" + Строка(ЛокальнаяОжидания);
    КонецПопытки;
    Попытка
        Ждать ОбещаниеОжидания;
    Исключение
    КонецПопытки;
    Сообщить(ИдОжидания + Символ(9) + ОтветОжидания);
    Возврат Неопределено;
КонецФункции

Асинх Процедура ИзмеритьОжидание()
    Сообщить("file.begin" + Символ(9) + "dynamic-async-await-1");
    Попытка
        Ждать ПроверитьОжидание("dynamic.await.execute", "ЛокальнаяОжидания = Ждать ОбещаниеОжидания;", Ложь);
        Ждать ПроверитьОжидание("dynamic.await.eval", "ЛокальнаяОжидания = Вычислить(""Ждать ОбещаниеОжидания"");", Ложь);
        Ждать ПроверитьОжидание("dynamic.await.execute.error", "ЛокальнаяОжидания = 11; ЛокальнаяОжидания = Ждать ОбещаниеОжидания;", Истина);
        Ждать ПроверитьОжидание("dynamic.await.eval.error", "ЛокальнаяОжидания = 11; ЛокальнаяОжидания = Вычислить(""Ждать ОбещаниеОжидания"");", Истина);
    Исключение
        Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
    КонецПопытки;
    Сообщить("file.end" + Символ(9) + "dynamic-async-await-1");
    Попытка Выполнить("ЗавершитьРаботуСистемы(Ложь);"); Исключение КонецПопытки;
КонецПроцедуры

ИзмеритьОжидание();
