	ПробаМетода("settime.en", "BeginSettingModificationTime", "GetModificationTime", 1, Дата(2021, 2, 3, 4, 5, 6));
	ПробаМетода("setutc.ru", "НачатьУстановкуУниверсальногоВремениИзменения", "ПолучитьУниверсальноеВремяИзменения", 1, Дата(2022, 3, 4, 5, 6, 7));
	ПробаМетода("setutc.en", "BeginSettingModificationUniversalTime", "GetModificationUniversalTime", 1, Дата(2022, 3, 4, 5, 6, 7));
