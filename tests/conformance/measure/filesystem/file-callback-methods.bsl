Перем ЗавершенныхМетодов;
Перем ЗапускМетодовЗакончен;
Перем КореньМетодов;

Асинх Процедура КлиентскийКонтекстМетодов()
КонецПроцедуры

Процедура ЗавершитьМетодыКогдаГотово()
	Если Не ЗапускМетодовЗакончен Или ЗавершенныхМетодов <> 26 Тогда
		Возврат;
	КонецЕсли;
	Попытка
		УдалитьФайлы(КореньМетодов);
	Исключение
		Сообщить("file.cleanup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Сообщить("file.end" + Символ(9) + "file-callback-methods-1");
	Попытка
		Выполнить("ЗавершитьРаботуСистемы(Ложь)");
	Исключение
	КонецПопытки;
КонецПроцедуры

Процедура РезультатМетода(Знач РезультатМетода, Знач ДанныеМетода) Экспорт
	ОбработатьРезультатМетода(РезультатМетода, ДанныеМетода, 2);
КонецПроцедуры

Процедура РезультатЗаписи(Знач ДанныеМетода) Экспорт
	ОбработатьРезультатМетода(Неопределено, ДанныеМетода, 1);
КонецПроцедуры

Процедура ОбработатьРезультатМетода(Знач РезультатМетода, Знач ДанныеМетода, АргументовМетода)
	Попытка
		ФайлМетода = ДанныеМетода.Файл;
		Если ДанныеМетода.Режим = 0 Тогда
			ПроверкаМетода = РезультатМетода = ДанныеМетода.Ожидание;
		ИначеЕсли ДанныеМетода.Режим = 1 Тогда
			ПроверкаМетода = Вычислить("ФайлМетода." + ДанныеМетода.Чтение + "()") = ДанныеМетода.Ожидание;
		Иначе
			ПроверкаМетода = РезультатМетода = ФайлМетода И РезультатМетода.ПолноеИмя = ДанныеМетода.Ожидание;
		КонецЕсли;
		Сообщить(ДанныеМетода.Ид + ".result" + Символ(9) + "returned=" + ?(ДанныеМетода.Вернулся, "1", "0")
			+ "|argc=" + Строка(АргументовМетода) + "|type=" + Строка(ТипЗнч(РезультатМетода))
			+ "|check=" + ?(ПроверкаМетода, "1", "0"));
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	ЗавершенныхМетодов = ЗавершенныхМетодов + 1;
	ЗавершитьМетодыКогдаГотово();
КонецПроцедуры

Процедура ОшибкаМетода(Знач ОшибкаМетода, СтандартнаяОбработкаМетода, Знач ДанныеМетода) Экспорт
	СтандартнаяОбработкаМетода = Ложь;
	Сообщить(ДанныеМетода.Ид + ".error" + Символ(9) + "returned=" + ?(ДанныеМетода.Вернулся, "1", "0")
		+ "|description=" + ОшибкаМетода.Описание);
	ЗавершенныхМетодов = ЗавершенныхМетодов + 1;
	ЗавершитьМетодыКогдаГотово();
КонецПроцедуры

Процедура ПробаМетода(ИдМетода, ИмяМетода, ЧтениеМетода, РежимМетода, АргументМетода = Неопределено)
	Попытка
		ПутьМетода = КореньМетодов + "/" + ИдМетода;
		ДанныеФайлаМетода = ПолучитьДвоичныеДанныеИзСтроки("abc", КодировкаТекста.UTF8, Ложь);
		ДанныеФайлаМетода.Записать(ПутьМетода);
		ФайлМетода = Новый Файл(ПутьМетода);
		ФайлМетода.УстановитьУниверсальноеВремяИзменения(Дата(2020, 1, 2, 3, 4, 5));
		ДанныеМетода = Новый Структура("Ид,Вернулся,Файл,Режим,Чтение,Ожидание", ИдМетода, Ложь, ФайлМетода, РежимМетода, ЧтениеМетода, АргументМетода);
		Если РежимМетода = 0 Тогда
			ДанныеМетода.Ожидание = Вычислить("ФайлМетода." + ЧтениеМетода + "()");
		ИначеЕсли РежимМетода = 2 Тогда
			АргументМетода = ПутьМетода + ".new";
			ДанныеМетода.Ожидание = АргументМетода;
		КонецЕсли;
		ИмяОбработчикаМетода = ?(РежимМетода = 1, "РезультатЗаписи", "РезультатМетода");
		ОповещениеМетода = Вычислить("Новый ОписаниеОповещения(ИмяОбработчикаМетода, ЭтотОбъект, ДанныеМетода, ""ОшибкаМетода"", ЭтотОбъект)");
		Если РежимМетода = 0 Тогда
			Выполнить("ФайлМетода." + ИмяМетода + "(ОповещениеМетода)");
		Иначе
			Выполнить("ФайлМетода." + ИмяМетода + "(ОповещениеМетода, АргументМетода)");
		КонецЕсли;
		ДанныеМетода.Вернулся = Истина;
		Сообщить(ИдМетода + ".return" + Символ(9) + "path_changed=" + ?(ФайлМетода.ПолноеИмя <> ПутьМетода, "1", "0"));
	Исключение
		Сообщить(ИдМетода + ".call_error" + Символ(9) + ИнформацияОбОшибке().Описание);
		ЗавершенныхМетодов = ЗавершенныхМетодов + 1;
	КонецПопытки;
КонецПроцедуры

ЗавершенныхМетодов = 0;
ЗапускМетодовЗакончен = Ложь;
КореньМетодов = ПолучитьИмяВременногоФайла(".callback-methods");
