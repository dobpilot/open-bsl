// Рекурсивный поиск в цикле ссылки на каталог. Длинное имя ссылки ограничивает
// глубину путём системного предела разрешения; очистка не обходит цикл.

Функция ПовторитьСимволЦикла(СимволЦикла, КоличествоЦикла)
	РезультатЦикла = "";
	Для ИндексЦикла = 1 По КоличествоЦикла Цикл
		РезультатЦикла = РезультатЦикла + СимволЦикла;
	КонецЦикла;
	Возврат РезультатЦикла;
КонецФункции

Процедура ИзмеритьЦиклПоиска()
	Сообщить("file.begin" + Символ(9) + "search-directory-cycle-1");
	Попытка
		Сообщить("context.effective" + Символ(9)
			+ Строка(Вычислить("Метаданные.РежимСовместимости")));
	Исключение
		Сообщить("context.effective_unavailable" + Символ(9) + "error");
	КонецПопытки;

	КореньЦиклаПоиска = ПолучитьИмяВременногоФайла(".search-directory-cycle");
	Попытка
		ВеткаЦиклаПоиска = КореньЦиклаПоиска + "/branch";
		СоздатьКаталог(ВеткаЦиклаПоиска);
		ДанныеЦиклаПоиска = ПолучитьДвоичныеДанныеИзСтроки("x", КодировкаТекста.UTF8, Ложь);
		ДанныеЦиклаПоиска.Записать(КореньЦиклаПоиска + "/top.txt");
		ДанныеЦиклаПоиска.Записать(ВеткаЦиклаПоиска + "/deep.txt");
		ИмяСсылкиЦиклаПоиска = ПовторитьСимволЦикла("l", 80);
		ПутьСсылкиЦиклаПоиска = ВеткаЦиклаПоиска + "/" + ИмяСсылкиЦиклаПоиска;
		КодСсылкиЦиклаПоиска = 0;
		ЗапуститьПриложение("/bin/ln -s " + ВеткаЦиклаПоиска + " "
			+ ПутьСсылкиЦиклаПоиска, "/tmp", Истина, КодСсылкиЦиклаПоиска);
		Если КодСсылкиЦиклаПоиска <> 0 Тогда
			Сообщить("file.setup_error" + Символ(9) + "ln:"
				+ Строка(КодСсылкиЦиклаПоиска));
		Иначе
			Попытка
				РезультатЦиклаПоиска = НайтиФайлы(КореньЦиклаПоиска, "*.txt", Истина);
				Сообщить("find.cycle.result" + Символ(9) + "ok:"
					+ Строка(РезультатЦиклаПоиска.Количество()));
			Исключение
				Сообщить("find.cycle.result" + Символ(9) + "error");
			КонецПопытки;
		КонецЕсли;
	Исключение
		Сообщить("file.setup_error" + Символ(9) + "search-directory-cycle:"
			+ ИнформацияОбОшибке().Описание);
	КонецПопытки;

	Попытка
		КодОчисткиЦиклаПоиска = 0;
		ЗапуститьПриложение("/bin/rm -rf " + КореньЦиклаПоиска,
			"/tmp", Истина, КодОчисткиЦиклаПоиска);
		Если КодОчисткиЦиклаПоиска <> 0 Тогда
			Сообщить("file.cleanup_error" + Символ(9) + "rm:"
				+ Строка(КодОчисткиЦиклаПоиска));
		КонецЕсли;
	Исключение
		Сообщить("file.cleanup_error" + Символ(9) + "search-directory-cycle:"
			+ ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Сообщить("file.end" + Символ(9) + "search-directory-cycle-1");
КонецПроцедуры

ИзмеритьЦиклПоиска();
