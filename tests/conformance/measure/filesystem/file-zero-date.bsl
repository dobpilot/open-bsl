// Проверка даты с нулевыми календарными полями, полученной из времени файла.
// Меняет и удаляет только собственный временный файл.

Функция ОписаниеЗначенияНулевойДаты(Знач ЗначениеИсследования)
    ТипИсследования = ТипЗнч(ЗначениеИсследования);
    Если ТипИсследования = Тип("Дата") Тогда
        Возврат "Date:" + Строка(Год(ЗначениеИсследования))
            + "-" + Строка(Месяц(ЗначениеИсследования))
            + "-" + Строка(День(ЗначениеИсследования))
            + " " + Строка(Час(ЗначениеИсследования))
            + ":" + Строка(Минута(ЗначениеИсследования))
            + ":" + Строка(Секунда(ЗначениеИсследования));
    КонецЕсли;
    Если ТипИсследования = Тип("Булево") Тогда
        Возврат "Boolean:" + ?(ЗначениеИсследования, "1", "0");
    КонецЕсли;
    ПредставлениеИсследования = Строка(ЗначениеИсследования);
    ПредставлениеИсследования = СтрЗаменить(ПредставлениеИсследования, Символ(13), "\r");
    ПредставлениеИсследования = СтрЗаменить(ПредставлениеИсследования, Символ(10), "\n");
    ПредставлениеИсследования = СтрЗаменить(ПредставлениеИсследования, Символ(9), "\t");
    Возврат Строка(ТипИсследования) + ":" + ПредставлениеИсследования;
КонецФункции

Процедура ПробаНулевойДаты(КлючИсследования, ВыражениеИсследования, ДатаИсследования, ДругаяДатаИсследования)
    Попытка
        ИтогИсследования = ОписаниеЗначенияНулевойДаты(Вычислить(ВыражениеИсследования));
    Исключение
        ИтогИсследования = "error:" + ИнформацияОбОшибке().Описание;
    КонецПопытки;
    Сообщить(КлючИсследования + Символ(9) + ИтогИсследования);
КонецПроцедуры

Функция КлючиНулевойДаты(Знач ПерваяДатаКлюча, Знач ВтораяДатаКлюча)
    КлючиИсследования = Новый Соответствие;
    КлючиИсследования.Вставить(ПерваяДатаКлюча, 11);
    КлючиИсследования.Вставить(ВтораяДатаКлюча, 22);
    Возврат Строка(КлючиИсследования.Количество()) + "|"
        + Строка(КлючиИсследования.Получить(ПерваяДатаКлюча)) + "|"
        + Строка(КлючиИсследования.Получить(ВтораяДатаКлюча));
КонецФункции

Функция JSONНулевойДаты(Знач ДатаJSONИсследования)
    ЗаписьJSONИсследования = Новый ЗаписьJSON;
    ЗаписьJSONИсследования.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSONИсследования, ДатаJSONИсследования);
    Возврат ЗаписьJSONИсследования.Закрыть();
КонецФункции

Процедура ПроверитьНулевуюДату(ПрефиксИсследования, ДатаИсследования, ДругаяДатаИсследования)
    ПробаНулевойДаты(ПрефиксИсследования + ".fields", "ДатаИсследования", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".string", "Строка(ДатаИсследования)", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".format", "Формат(ДатаИсследования, ""ДФ=yyyy-MM-dd HH:mm:ss"")", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".filled", "ЗначениеЗаполнено(ДатаИсследования)", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".eq_empty", "ДатаИсследования = Дата(1, 1, 1)", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".lt_empty", "ДатаИсследования < Дата(1, 1, 1)", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".gt_empty", "ДатаИсследования > Дата(1, 1, 1)", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".eq_other", "ДатаИсследования = ДругаяДатаИсследования", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".diff_empty", "ДатаИсследования - Дата(1, 1, 1)", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".empty_diff", "Дата(1, 1, 1) - ДатаИсследования", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".diff_other", "ДатаИсследования - ДругаяДатаИсследования", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".add0", "ДатаИсследования + 0", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".add1", "ДатаИсследования + 1", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".sub1", "ДатаИсследования - 1", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".add_day", "ДатаИсследования + 86400", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".weekday", "ДеньНедели(ДатаИсследования)", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".start_day", "НачалоДня(ДатаИсследования)", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".end_day", "КонецДня(ДатаИсследования)", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".start_month", "НачалоМесяца(ДатаИсследования)", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".end_month", "КонецМесяца(ДатаИсследования)", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".start_year", "НачалоГода(ДатаИсследования)", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".end_year", "КонецГода(ДатаИсследования)", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".start_week", "НачалоНедели(ДатаИсследования)", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".add_month0", "ДобавитьМесяц(ДатаИсследования, 0)", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".add_month1", "ДобавитьМесяц(ДатаИсследования, 1)", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".internal", "ЗначениеВСтрокуВнутр(ДатаИсследования)", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".internal_roundtrip", "ЗначениеИзСтрокиВнутр(ЗначениеВСтрокуВнутр(ДатаИсследования))", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".xml", "XMLСтрока(ДатаИсследования)", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".json", "JSONНулевойДаты(ДатаИсследования)", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".map_empty", "КлючиНулевойДаты(ДатаИсследования, Дата(1, 1, 1))", ДатаИсследования, ДругаяДатаИсследования);
    ПробаНулевойДаты(ПрефиксИсследования + ".map_other", "КлючиНулевойДаты(ДатаИсследования, ДругаяДатаИсследования)", ДатаИсследования, ДругаяДатаИсследования);
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-zero-date-1");
ПутьНулевойДаты = ПолучитьИмяВременногоФайла(".zero-date");
Попытка
    ДанныеНулевойДаты = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
    ДанныеНулевойДаты.Записать(ПутьНулевойДаты);
    ФайлНулевойДаты = Новый Файл(ПутьНулевойДаты);
    ФайлНулевойДаты.УстановитьВремяИзменения(Дата(1, 1, 1));
    НулеваяДатаМестная = ФайлНулевойДаты.ПолучитьУниверсальноеВремяИзменения();
    ФайлНулевойДаты.УстановитьУниверсальноеВремяИзменения(Дата(1, 1, 1));
    НулеваяДатаUTC = ФайлНулевойДаты.ПолучитьУниверсальноеВремяИзменения();
    ПроверитьНулевуюДату("local_min", НулеваяДатаМестная, НулеваяДатаUTC);
    ПроверитьНулевуюДату("utc_min", НулеваяДатаUTC, НулеваяДатаМестная);
    ПробаНулевойДаты("constructor.zero_fields", "Дата(0, 0, 0)", НулеваяДатаМестная, НулеваяДатаUTC);
    ПробаНулевойДаты("constructor.zero_string", "Дата(""00000000000000"")", НулеваяДатаМестная, НулеваяДатаUTC);
    ПробаНулевойДаты("constructor.zero_literal", "'00000000000000'", НулеваяДатаМестная, НулеваяДатаUTC);
Исключение
    Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Попытка
    УдалитьФайлы(ПутьНулевойДаты);
Исключение
    Сообщить("file.cleanup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Сообщить("file.end" + Символ(9) + "file-zero-date-1");
