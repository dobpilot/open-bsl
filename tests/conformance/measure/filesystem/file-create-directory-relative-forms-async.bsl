// Составные относительные и корневые формы указывают только на уже
// существующие каталоги. Проверяется успех sync и исходная строка Async.

Асинх Функция ПробаОтносительнойФормыСоздания(ИдФормы, ПутьФормы)
	Попытка
		СоздатьКаталог(ПутьФормы);
		ИтогСинхроннойФормы = "ok";
	Исключение
		ИтогСинхроннойФормы = "error";
	КонецПопытки;
	Попытка
		ОбещаниеФормы = СоздатьКаталогАсинх(ПутьФормы);
		РезультатФормы = Ждать ОбещаниеФормы;
		ИтогАсинхроннойФормы = "ok|same=" + ?(РезультатФормы = ПутьФормы, "1", "0")
			+ "|value=" + Строка(РезультатФормы);
	Исключение
		ИтогАсинхроннойФормы = "error";
	КонецПопытки;
	Сообщить(ИдФормы + Символ(9) + "sync=" + ИтогСинхроннойФормы
		+ "|async=" + ИтогАсинхроннойФормы);
	Возврат Неопределено;
КонецФункции

Асинх Процедура ИзмеритьОтносительныеФормыСоздания()
	Сообщить("file.begin" + Символ(9) + "create-directory-relative-forms-async-1");
	Попытка
		Сообщить("context.effective" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
	Исключение
		Сообщить("context.effective_unavailable" + Символ(9) + "error");
	КонецПопытки;
	Ждать ПробаОтносительнойФормыСоздания("create.relative.dot_dot", "./.");
	Ждать ПробаОтносительнойФормыСоздания("create.relative.dot_dot_slash", "././");
	Ждать ПробаОтносительнойФормыСоздания("create.relative.dot_double_slash", ".//");
	Ждать ПробаОтносительнойФормыСоздания("create.relative.parent_dot", "../.");
	Ждать ПробаОтносительнойФормыСоздания("create.relative.parent_dot_slash", ".././");
	Ждать ПробаОтносительнойФормыСоздания("create.relative.parent_double_slash", "..//");
	Ждать ПробаОтносительнойФормыСоздания("create.relative.dot_parent", "./..");
	Ждать ПробаОтносительнойФормыСоздания("create.relative.dot_parent_slash", "./../");
	Ждать ПробаОтносительнойФормыСоздания("create.relative.dot_parent_dot", "./../.");
	Ждать ПробаОтносительнойФормыСоздания("create.relative.two_parents", "../../");
	Ждать ПробаОтносительнойФормыСоздания("create.root.dot", "/./");
	Ждать ПробаОтносительнойФормыСоздания("create.root.parent", "/../");
	Сообщить("file.end" + Символ(9) + "create-directory-relative-forms-async-1");
	Попытка
		Выполнить("ЗавершитьРаботуСистемы(Ложь);");
	Исключение
	КонецПопытки;
КонецПроцедуры

ИзмеритьОтносительныеФормыСоздания();
