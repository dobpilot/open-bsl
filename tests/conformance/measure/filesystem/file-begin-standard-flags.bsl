Перем ЧислоФлаговОповещения;
Перем ТикиФлаговОповещения;

Асинх Процедура КлиентскийКонтекстФлаговОповещения()
КонецПроцедуры

Процедура ЗавершитьФлагиОповещения() Экспорт
    ТикиФлаговОповещения = ТикиФлаговОповещения + 1;
    Если ТикиФлаговОповещения < 5 Тогда Возврат; КонецЕсли;
    Сообщить("flag.count" + Символ(9) + Строка(ЧислоФлаговОповещения));
    Сообщить("file.end" + Символ(9) + "file-begin-standard-flags-1");
    Попытка Выполнить("ЗавершитьРаботуСистемы(Ложь);"); Исключение КонецПопытки;
КонецПроцедуры

Процедура НеожиданныйУспехФлага(Знач ДанныеФлагаОповещения) Экспорт
    Сообщить("flag.unexpected_success" + Символ(9) + ДанныеФлагаОповещения.Ключ);
КонецПроцедуры

Процедура ОбработатьФлагОповещения(Знач ИнформацияФлагаОповещения, СтандартнаяФлагаОповещения, Знач ДанныеФлагаОповещения) Экспорт
    ЧислоФлаговОповещения = ЧислоФлаговОповещения + 1;
    Сообщить("flag.enter" + Символ(9) + ДанныеФлагаОповещения.Ключ + "|initial=" + ?(СтандартнаяФлагаОповещения, "1", "0"));
    СтандартнаяФлагаОповещения = ДанныеФлагаОповещения.Значение;
    Сообщить("flag.assigned" + Символ(9) + ДанныеФлагаОповещения.Ключ + "|" + Строка(ТипЗнч(СтандартнаяФлагаОповещения)));
КонецПроцедуры

Процедура ЗапуститьФлагОповещения(КлючФлагаОповещения, Знач ЗначениеФлагаОповещения)
    ДанныеФлагаОповещения = Новый Структура("Ключ,Значение", КлючФлагаОповещения, ЗначениеФлагаОповещения);
    ФайлФлагаОповещения = Новый Файл("/open-bsl-standard-flags-no-file-20260917");
    ОписаниеФлагаОповещения = Новый ОписаниеОповещения("НеожиданныйУспехФлага", ЭтотОбъект, ДанныеФлагаОповещения, "ОбработатьФлагОповещения", ЭтотОбъект);
    ФайлФлагаОповещения.НачатьУстановкуНевидимости(ОписаниеФлагаОповещения, Новый Массив);
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-begin-standard-flags-1");
ЧислоФлаговОповещения = 0;
ТикиФлаговОповещения = 0;
Попытка
    ЗапуститьФлагОповещения("false", Ложь);
    ЗапуститьФлагОповещения("true", Истина);
    ЗапуститьФлагОповещения("zero", 0);
    ЗапуститьФлагОповещения("one", 1);
    ЗапуститьФлагОповещения("negative", -1);
    ЗапуститьФлагОповещения("undefined", Неопределено);
    ЗапуститьФлагОповещения("null", Null);
    ЗапуститьФлагОповещения("empty", "");
    ЗапуститьФлагОповещения("string", "False");
    ЗапуститьФлагОповещения("array", Новый Массив);
    ЗапуститьФлагОповещения("structure", Новый Структура);
    Сообщить("flag.return" + Символ(9) + Строка(ЧислоФлаговОповещения));
    Попытка Выполнить("ПодключитьОбработчикОжидания(""ЗавершитьФлагиОповещения"", 1);"); Исключение КонецПопытки;
Исключение
    Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
    ТикиФлаговОповещения = 5;
    ЗавершитьФлагиОповещения();
КонецПопытки;
