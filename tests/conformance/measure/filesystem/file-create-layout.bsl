// Серверный снимок побочных эффектов без НайтиФайлы и свойств Файл.
// Внешний наблюдатель снимает дерево ДО выхода, затем создаёт observer.release.
// Не запускать без наблюдателя и последующей очистки точного file.scratch.
Процедура ПробаРазмещенияСоздания(КореньРазмещения, ИдРазмещения, ХвостРазмещения)
	КаталогРазмещения = КореньРазмещения + "/" + ИдРазмещения;
	Попытка
		СоздатьКаталог(КаталогРазмещения);
		ДанныеРазмещения = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
		ДанныеРазмещения.Записать(КаталогРазмещения + "/block");
		Попытка
			СоздатьКаталог(КаталогРазмещения + "/" + ХвостРазмещения);
			ИтогРазмещения = "ok";
		Исключение
			ИтогРазмещения = "error";
		КонецПопытки;
		Сообщить(ИдРазмещения + Символ(9) + ИтогРазмещения);
		ФайлРазмещения = Новый Файл(КаталогРазмещения + "/" + ХвостРазмещения);
		Сообщить("lexical." + ИдРазмещения + Символ(9)
			+ СтрЗаменить(СтрЗаменить(ФайлРазмещения.ПолноеИмя, КореньРазмещения, "<root>"), Символ(0), "<NUL>"));
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдРазмещения + ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "create-layout-1");
Попытка
	КореньРазмещенияСоздания = ПолучитьИмяВременногоФайла(".create-layout") + "-tree";
	СоздатьКаталог(КореньРазмещенияСоздания);
	Сообщить("file.scratch" + Символ(9) + КореньРазмещенияСоздания);
	ПробаРазмещенияСоздания(КореньРазмещенияСоздания, "plain", "leaf");
	ПробаРазмещенияСоздания(КореньРазмещенияСоздания, "parent", "missing/../leaf");
	ПробаРазмещенияСоздания(КореньРазмещенияСоздания, "file-parent", "block/../leaf");
	ПробаРазмещенияСоздания(КореньРазмещенияСоздания, "backslash", "branch\leaf");
	ПробаРазмещенияСоздания(КореньРазмещенияСоздания, "spaces", " spaced /leaf ");
	ПробаРазмещенияСоздания(КореньРазмещенияСоздания, "space-leaf", "leaf ");
	ПробаРазмещенияСоздания(КореньРазмещенияСоздания, "space-parent", "branch /leaf");
	ПробаРазмещенияСоздания(КореньРазмещенияСоздания, "space-leading", " leaf");
	ПробаРазмещенияСоздания(КореньРазмещенияСоздания, "nul", "nul" + Символ(0) + "tail");
	ПробаРазмещенияСоздания(КореньРазмещенияСоздания, "nul-child", "nul" + Символ(0) + "/tail");
	ПробаРазмещенияСоздания(КореньРазмещенияСоздания, "star", "star*");
	ПробаРазмещенияСоздания(КореньРазмещенияСоздания, "star-parent", "star*/leaf");
	ПробаРазмещенияСоздания(КореньРазмещенияСоздания, "question", "question?");
	ПробаРазмещенияСоздания(КореньРазмещенияСоздания, "colon", "C:leaf");
	Сообщить("file.observe" + Символ(9) + "ready");
	ФайлРазрешенияНаблюдателя = Новый Файл(КореньРазмещенияСоздания + "/observer.release");
	Для ШагОжиданияНаблюдателя = 1 По 60 Цикл
		Если ФайлРазрешенияНаблюдателя.Существует() Тогда
			Прервать;
		КонецЕсли;
		ЗапуститьПриложение("/usr/bin/sleep 1", "", Истина);
	КонецЦикла;
	Если Не ФайлРазрешенияНаблюдателя.Существует() Тогда
		Сообщить("file.setup_error" + Символ(9) + "observer timeout");
	КонецЕсли;
Исключение
	Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Сообщить("file.end" + Символ(9) + "create-layout-1");
