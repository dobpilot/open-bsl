// Серверная проба символьных устройств Linux для объекта Файл.

Процедура ПробаБулеваМетодаУстройства(ИдУстройства, ОбъектУстройства,
		ИмяМетодаУстройства)
	Попытка
		ЗначениеУстройства = Вычислить(
			"ОбъектУстройства." + ИмяМетодаУстройства + "()");
		Если ЗначениеУстройства Тогда
			РезультатУстройства = "ok:1";
		Иначе
			РезультатУстройства = "ok:0";
		КонецЕсли;
	Исключение
		РезультатУстройства = "error";
	КонецПопытки;
	Сообщить(ИдУстройства + "." + ИмяМетодаУстройства
		+ Символ(9) + РезультатУстройства);
КонецПроцедуры

Процедура ПробаУстройства(ИдУстройства, ПутьУстройства)
	ОбъектУстройства = Новый Файл(ПутьУстройства);
	ПробаБулеваМетодаУстройства(ИдУстройства, ОбъектУстройства, "Существует");
	ПробаБулеваМетодаУстройства(ИдУстройства, ОбъектУстройства, "ЭтоФайл");
	ПробаБулеваМетодаУстройства(ИдУстройства, ОбъектУстройства, "ЭтоКаталог");
	Попытка
		РезультатУстройства = "ok:" + Строка(ОбъектУстройства.Размер());
	Исключение
		РезультатУстройства = "error";
	КонецПопытки;
	Сообщить(ИдУстройства + ".Размер" + Символ(9) + РезультатУстройства);
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "object-devices-1");
ПробаУстройства("null", "/dev/null");
ПробаУстройства("zero", "/dev/zero");
ПробаУстройства("full", "/dev/full");
ПробаУстройства("random", "/dev/random");
ПробаУстройства("urandom", "/dev/urandom");
Сообщить("file.end" + Символ(9) + "object-devices-1");
