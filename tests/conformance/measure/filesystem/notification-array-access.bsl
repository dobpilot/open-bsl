Процедура ПроверитьДоступМассива(ИдПробы, ИндексПробы)
	Для НомерМетодаПробы = 1 По 4 Цикл
		МассивПробы = Новый Массив;
		МассивПробы.Добавить(10);
		МассивПробы.Добавить(20);
		Если НомерМетодаПробы = 1 Тогда
			ВыражениеПробы = "МассивПробы.Получить(ИндексПробы)";
		ИначеЕсли НомерМетодаПробы = 2 Тогда
			ВыражениеПробы = "МассивПробы.Get(ИндексПробы)";
		ИначеЕсли НомерМетодаПробы = 3 Тогда
			ВыражениеПробы = "МассивПробы.Установить(ИндексПробы, 99)";
		Иначе
			ВыражениеПробы = "МассивПробы.Set(ИндексПробы, 99)";
		КонецЕсли;
		Попытка
			Если НомерМетодаПробы <= 2 Тогда
				РезультатДоступа = "ok:" + Строка(Вычислить(ВыражениеПробы));
			Иначе
				Выполнить(ВыражениеПробы);
				РезультатДоступа = "ok";
			КонецЕсли;
		Исключение
			РезультатДоступа = "error";
		КонецПопытки;
		Сообщить(ИдПробы + "." + Строка(НомерМетодаПробы) + Символ(9)
			+ РезультатДоступа + "|array=" + Строка(МассивПробы[0]) + "," + Строка(МассивПробы[1]));
	КонецЦикла;
КонецПроцедуры

Процедура ПроверитьФормуДоступа(ИдПробы, ВыражениеПробы, ЭтоВыражение)
	МассивПробы = Новый Массив;
	МассивПробы.Добавить(10);
	МассивПробы.Добавить(20);
	Попытка
		Если ЭтоВыражение Тогда
			ЗначениеФормы = Вычислить(ВыражениеПробы);
			РезультатФормы = "ok:" + Строка(ЗначениеФормы);
		Иначе
			Выполнить(ВыражениеПробы);
			РезультатФормы = "ok";
		КонецЕсли;
	Исключение
		РезультатФормы = "error";
	КонецПопытки;
	Сообщить(ИдПробы + Символ(9) + РезультатФормы + "|array="
		+ Строка(МассивПробы[0]) + "," + Строка(МассивПробы[1]));
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "notification-array-access-1");
ПроверитьДоступМассива("index.zero", 0);
ПроверитьДоступМассива("index.one", 1);
ПроверитьДоступМассива("index.negative", -1);
ПроверитьДоступМассива("index.end", 2);
ПроверитьДоступМассива("index.fraction", 1.9);
ПроверитьДоступМассива("index.string", "1");
ПроверитьДоступМассива("index.boolean", Истина);
ПроверитьДоступМассива("index.undefined", Неопределено);
ПроверитьДоступМассива("index.null", Null);
ПроверитьФормуДоступа("arity.get.zero", "МассивПробы.Получить()", Истина);
ПроверитьФормуДоступа("arity.get.extra", "МассивПробы.Get(0, 1)", Истина);
ПроверитьФормуДоступа("arity.set.zero", "МассивПробы.Установить()", Ложь);
ПроверитьФормуДоступа("arity.set.one", "МассивПробы.Set(0)", Ложь);
ПроверитьФормуДоступа("arity.set.extra", "МассивПробы.Set(0, 99, 1)", Ложь);
ПроверитьФормуДоступа("kind.set.expression", "МассивПробы.Установить(0, 99)", Истина);
