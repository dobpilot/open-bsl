// Клиентские пробы запуска: только завершающиеся true/false и безопасный exit.
// Нет записи файлов и пользовательских приложений; неизвестные вызовы — через Вычислить.
Асинх Функция ПробаЗапускаАсинх(ИдЗапускаАсинх, ВыражениеЗапускаАсинх)
	СтадияЗапускаАсинх = "call";
	ТипОбещанияЗапуска = "none";
	Попытка
		ОбещаниеЗапуска = Вычислить(ВыражениеЗапускаАсинх);
		ТипОбещанияЗапуска = Строка(ТипЗнч(ОбещаниеЗапуска));
		СтадияЗапускаАсинх = "await";
		РезультатЗапуска = Ждать ОбещаниеЗапуска;
		СтадияЗапускаАсинх = "await-again";
		ПовторЗапуска = Ждать ОбещаниеЗапуска;
		ВыводЗапуска = "ok|type=" + Строка(ТипЗнч(РезультатЗапуска))
			+ "|value=" + Строка(РезультатЗапуска)
			+ "|repeat=" + ?(ПовторЗапуска = РезультатЗапуска, "1", "0");
	Исключение
		ОшибкаЗапуска = ИнформацияОбОшибке();
		ВыводЗапуска = "error|stage=" + СтадияЗапускаАсинх + "|" + ОшибкаЗапуска.Описание;
		Если ОшибкаЗапуска.Причина <> Неопределено Тогда
			ВыводЗапуска = ВыводЗапуска + "|cause=" + ОшибкаЗапуска.Причина.Описание;
		КонецЕсли;
	КонецПопытки;
	Сообщить(ИдЗапускаАсинх + Символ(9) + "promise=" + ТипОбещанияЗапуска + "|" + ВыводЗапуска);
	Возврат Неопределено;
КонецФункции

Асинх Процедура ИзмеритьЗапускАсинх()
	Сообщить("file.begin" + Символ(9) + "runapp-async-1");
	Попытка
		Сообщить("context.compatibility" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
	Исключение
		Сообщить("context.compatibility" + Символ(9) + "unavailable");
	КонецПопытки;
	Ждать ПробаЗапускаАсинх("runasync.true", "ЗапуститьПриложениеАсинх(""/usr/bin/true"")");
	Ждать ПробаЗапускаАсинх("runasync.english", "RunAppAsync(""/usr/bin/false"")");
	Ждать ПробаЗапускаАсинх("runasync.false", "ЗапуститьПриложениеАсинх(""/usr/bin/false"")");
	Ждать ПробаЗапускаАсинх("runasync.cwd_empty", "ЗапуститьПриложениеАсинх(""/usr/bin/true"", """")");
	Ждать ПробаЗапускаАсинх("runasync.cwd_tmp", "ЗапуститьПриложениеАсинх(""/usr/bin/true"", ""/tmp"")");
	Ждать ПробаЗапускаАсинх("runasync.cwd_missing", "ЗапуститьПриложениеАсинх(""/usr/bin/true"", ""/open-bsl-no-such-cwd-20260916"")");
	Ждать ПробаЗапускаАсинх("runasync.cwd_undefined", "ЗапуститьПриложениеАсинх(""/usr/bin/true"", Неопределено)");
	Ждать ПробаЗапускаАсинх("runasync.cwd_null", "ЗапуститьПриложениеАсинх(""/usr/bin/true"", Null)");
	Ждать ПробаЗапускаАсинх("runasync.cwd_number", "ЗапуститьПриложениеАсинх(""/usr/bin/true"", 0)");
	Ждать ПробаЗапускаАсинх("runasync.wait_true", "ЗапуститьПриложениеАсинх(""/usr/bin/false"", """", Истина)");
	Ждать ПробаЗапускаАсинх("runasync.wait_false", "ЗапуститьПриложениеАсинх(""/usr/bin/false"", """", Ложь)");
	Ждать ПробаЗапускаАсинх("runasync.wait_undefined", "ЗапуститьПриложениеАсинх(""/usr/bin/true"", """", Неопределено)");
	Ждать ПробаЗапускаАсинх("runasync.wait_null", "ЗапуститьПриложениеАсинх(""/usr/bin/true"", """", Null)");
	Ждать ПробаЗапускаАсинх("runasync.wait_zero", "ЗапуститьПриложениеАсинх(""/usr/bin/true"", """", 0)");
	Ждать ПробаЗапускаАсинх("runasync.wait_one", "ЗапуститьПриложениеАсинх(""/usr/bin/true"", """", 1)");
	Ждать ПробаЗапускаАсинх("runasync.four_arguments", "ЗапуститьПриложениеАсинх(""/usr/bin/true"", """", Истина, 42)");
	Ждать ПробаЗапускаАсинх("runasync.omitted_cwd", "ЗапуститьПриложениеАсинх(""/usr/bin/false"", , Истина)");
	Ждать ПробаЗапускаАсинх("runasync.empty", "ЗапуститьПриложениеАсинх("""")");
	Ждать ПробаЗапускаАсинх("runasync.missing", "ЗапуститьПриложениеАсинх(""/open-bsl-no-such-program-20260916"")");
	Ждать ПробаЗапускаАсинх("runasync.command_undefined", "ЗапуститьПриложениеАсинх(Неопределено)");
	Ждать ПробаЗапускаАсинх("runasync.command_null", "ЗапуститьПриложениеАсинх(Null)");
	Ждать ПробаЗапускаАсинх("runasync.command_number", "ЗапуститьПриложениеАсинх(0)");
	Ждать ПробаЗапускаАсинх("runasync.zero_arguments", "ЗапуститьПриложениеАсинх()");
	Ждать ПробаЗапускаАсинх("runasync.quoted", "ЗапуститьПриложениеАсинх(""""""/usr/bin/false"""""")");
	Ждать ПробаЗапускаАсинх("runasync.shell_exit", "ЗапуститьПриложениеАсинх(""exit 17"")");
	Сообщить("file.end" + Символ(9) + "runapp-async-1");
	Попытка
		Выполнить("ЗавершитьРаботуСистемы(Ложь);");
	Исключение
	КонецПопытки;
КонецПроцедуры

ИзмеритьЗапускАсинх();
