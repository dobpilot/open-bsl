// Границы числового аргумента арифметики даты. Файловую систему не меняет.

Процедура ПробаПределаСдвига(КлючПределаСдвига, ВыражениеПределаСдвига)
    Попытка
        РезультатПределаСдвига = Вычислить(ВыражениеПределаСдвига);
        Если ТипЗнч(РезультатПределаСдвига) = Тип("Дата") Тогда
            ТекстПределаСдвига = Строка(Год(РезультатПределаСдвига)) + "-"
                + Строка(Месяц(РезультатПределаСдвига)) + "-"
                + Строка(День(РезультатПределаСдвига)) + " "
                + Строка(Час(РезультатПределаСдвига)) + ":"
                + Строка(Минута(РезультатПределаСдвига)) + ":"
                + Строка(Секунда(РезультатПределаСдвига));
        Иначе
            ТекстПределаСдвига = Строка(ТипЗнч(РезультатПределаСдвига));
        КонецЕсли;
    Исключение
        ТекстПределаСдвига = "error";
    КонецПопытки;
    Сообщить(КлючПределаСдвига + Символ(9) + ТекстПределаСдвига);
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "date-shift-limits-1");
ПробаПределаСдвига("plus.huge", "Дата(2020,1,1) + 1000000000000000000");
ПробаПределаСдвига("minus.huge", "Дата(2020,1,1) - 1000000000000000000");
ПробаПределаСдвига("plus.i64max", "Дата(2020,1,1) + 922337203685477.5807");
ПробаПределаСдвига("plus.i64overflow", "Дата(2020,1,1) + 922337203685477.5808");
ПробаПределаСдвига("minus.i64max", "Дата(2020,1,1) - 922337203685477.5807");
ПробаПределаСдвига("minus.i64overflow", "Дата(2020,1,1) - 922337203685477.5808");
ПробаПределаСдвига("plus.negative.i64min", "Дата(2020,1,1) + -922337203685477.5808");
ПробаПределаСдвига("plus.maxdate.huge", "Дата(9999,12,31,23,59,59) + 1000000000000000000");
ПробаПределаСдвига("minus.empty.huge", "Дата(1,1,1) - 1000000000000000000");
ПробаПределаСдвига("plus.string", "Дата(2020,1,1) + ""1""");
ПробаПределаСдвига("plus.boolean", "Дата(2020,1,1) + Истина");
ПробаПределаСдвига("plus.undefined", "Дата(2020,1,1) + Неопределено");
ПробаПределаСдвига("plus.null", "Дата(2020,1,1) + Null");
ПробаПределаСдвига("reverse.number", "1 + Дата(2020,1,1)");
Сообщить("file.end" + Символ(9) + "date-shift-limits-1");
