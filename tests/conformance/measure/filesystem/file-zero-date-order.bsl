// Прямой порядок двух файловых дат с нулевыми календарными полями.
// Меняет и удаляет только собственный временный файл.

Процедура ВывестиБулевоПорядка(КлючПорядка, ЗначениеПорядка)
    Сообщить(КлючПорядка + Символ(9) + ?(ЗначениеПорядка, "1", "0"));
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-zero-date-order-1");
ПутьПорядкаДат = ПолучитьИмяВременногоФайла(".zero-date-order");
Попытка
    ДанныеПорядкаДат = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
    ДанныеПорядкаДат.Записать(ПутьПорядкаДат);
    ФайлПорядкаДат = Новый Файл(ПутьПорядкаДат);
    ФайлПорядкаДат.УстановитьВремяИзменения(Дата(1, 1, 1));
    ЛокальнаяМинимальнаяДата = ФайлПорядкаДат.ПолучитьУниверсальноеВремяИзменения();
    ФайлПорядкаДат.УстановитьУниверсальноеВремяИзменения(Дата(1, 1, 1));
    УниверсальнаяМинимальнаяДата = ФайлПорядкаДат.ПолучитьУниверсальноеВремяИзменения();
    ВывестиБулевоПорядка("local.lt.utc", ЛокальнаяМинимальнаяДата < УниверсальнаяМинимальнаяДата);
    ВывестиБулевоПорядка("local.gt.utc", ЛокальнаяМинимальнаяДата > УниверсальнаяМинимальнаяДата);
    ВывестиБулевоПорядка("utc.lt.local", УниверсальнаяМинимальнаяДата < ЛокальнаяМинимальнаяДата);
    ВывестиБулевоПорядка("utc.gt.local", УниверсальнаяМинимальнаяДата > ЛокальнаяМинимальнаяДата);
    ВывестиБулевоПорядка("local.add0.eq", ЛокальнаяМинимальнаяДата + 0 = ЛокальнаяМинимальнаяДата);
    ВывестиБулевоПорядка("utc.add0.eq", УниверсальнаяМинимальнаяДата + 0 = УниверсальнаяМинимальнаяДата);
Исключение
    Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Попытка
    УдалитьФайлы(ПутьПорядкаДат);
Исключение
    Сообщить("file.cleanup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Сообщить("file.end" + Символ(9) + "file-zero-date-order-1");
