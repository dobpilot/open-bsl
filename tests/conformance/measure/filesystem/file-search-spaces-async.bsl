// Только чтение дерева из file-search-spaces.host.txt, подготовленного средствами ОС.
// Конечные пробелы и TAB в именах не создаются через BSL-нормализацию пути.
Асинх Функция ПробаПоискаПробелов(ИдПоискаПробелов, ПутьПоискаПробелов, МаскаПоискаПробелов, РекурсияПоискаПробелов, КореньПоискаПробелов)
	Попытка
		ОбещаниеПоискаПробелов = НайтиФайлыАсинх(ПутьПоискаПробелов, МаскаПоискаПробелов, РекурсияПоискаПробелов);
		Если ТипЗнч(ОбещаниеПоискаПробелов) <> Тип("Обещание") Тогда
			ВызватьИсключение "не получено обещание";
		КонецЕсли;
		РезультатПоискаПробелов = Ждать ОбещаниеПоискаПробелов;
		ВыводПоискаПробелов = "ok|count=" + Строка(РезультатПоискаПробелов.Количество());
		Для Каждого ЭлементПоискаПробелов Из РезультатПоискаПробелов Цикл
			ИмяПоискаПробелов = СтрЗаменить(ЭлементПоискаПробелов.ПолноеИмя, КореньПоискаПробелов, "<root>");
			ИмяПоискаПробелов = СтрЗаменить(СтрЗаменить(ИмяПоискаПробелов, " ", "<SP>"), Символ(9), "<TAB>");
			Попытка
				КаталогПоискаПробелов = ?(ЭлементПоискаПробелов.ЭтоКаталог(), "1", "0");
			Исключение
				КаталогПоискаПробелов = "error";
			КонецПопытки;
			ВыводПоискаПробелов = ВыводПоискаПробелов + "|" + ИмяПоискаПробелов
				+ ":exists=" + ?(ЭлементПоискаПробелов.Существует(), "1", "0")
				+ ":dir=" + КаталогПоискаПробелов;
		КонецЦикла;
		Сообщить(ИдПоискаПробелов + Символ(9) + ВыводПоискаПробелов);
	Исключение
		Сообщить(ИдПоискаПробелов + Символ(9) + "error|" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Асинх Функция ПараПоискаПробелов(ИдПарыПробелов, ПутьПарыПробелов, МаскаПарыПробелов, КореньПарыПробелов)
	Ждать ПробаПоискаПробелов(ИдПарыПробелов + ".flat", ПутьПарыПробелов, МаскаПарыПробелов, Ложь, КореньПарыПробелов);
	Ждать ПробаПоискаПробелов(ИдПарыПробелов + ".recursive", ПутьПарыПробелов, МаскаПарыПробелов, Истина, КореньПарыПробелов);
	Возврат Неопределено;
КонецФункции

Асинх Процедура ВыполнитьПоискПробеловАсинх()
	КореньПоискаПробелов = "/tmp/open-bsl-search-spaces-miRh6I";
	Сообщить("file.begin" + Символ(9) + "search-spaces-async-1");
	Попытка
		Сообщить("context.effective" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
	Исключение
		Сообщить("context.effective_unavailable" + Символ(9) + "error");
	КонецПопытки;
	Для Каждого СлучайПоискаПробелов Из СтрРазделить("alone|middle|twins|file|file-twins|leading|tab", "|") Цикл
		ПутьСлучаяПробелов = КореньПоискаПробелов + "/" + СлучайПоискаПробелов;
		Ждать ПараПоискаПробелов(СлучайПоискаПробелов + ".star", ПутьСлучаяПробелов, "*", КореньПоискаПробелов);
		Ждать ПараПоискаПробелов(СлучайПоискаПробелов + ".star_dot", ПутьСлучаяПробелов, "*.*", КореньПоискаПробелов);
		Ждать ПараПоискаПробелов(СлучайПоискаПробелов + ".prefix", ПутьСлучаяПробелов, "p*", КореньПоискаПробелов);
		Ждать ПараПоискаПробелов(СлучайПоискаПробелов + ".exact", ПутьСлучаяПробелов, "padded", КореньПоискаПробелов);
		Ждать ПараПоискаПробелов(СлучайПоискаПробелов + ".spaced", ПутьСлучаяПробелов, "padded ", КореньПоискаПробелов);
		Ждать ПараПоискаПробелов(СлучайПоискаПробелов + ".txt", ПутьСлучаяПробелов, "*.txt", КореньПоискаПробелов);
		Ждать ПараПоискаПробелов(СлучайПоискаПробелов + ".direct_space", ПутьСлучаяПробелов + "/padded ", Неопределено, КореньПоискаПробелов);
		Ждать ПараПоискаПробелов(СлучайПоискаПробелов + ".inside_space", ПутьСлучаяПробелов + "/padded ", "*", КореньПоискаПробелов);
		Ждать ПараПоискаПробелов(СлучайПоискаПробелов + ".inside_space_slash", ПутьСлучаяПробелов + "/padded /", "*", КореньПоискаПробелов);
	КонецЦикла;
	Сообщить("file.end" + Символ(9) + "search-spaces-async-1");
	Попытка
		Выполнить("ЗавершитьРаботуСистемы(Ложь);");
	Исключение
	КонецПопытки;
КонецПроцедуры

ВыполнитьПоискПробеловАсинх();
