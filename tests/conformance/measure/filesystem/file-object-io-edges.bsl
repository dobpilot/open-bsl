// Серверная проба I/O методов Файл на необычных именах. Каждый случай
// работает в собственном временном корне; вывод не содержит самих управляющих
// символов, а только отношения путей и результаты методов.

Функция РезультатМетодаКрая(ОбъектКрая, ИмяМетодаКрая)
	Попытка
		Если ИмяМетодаКрая = "Существует" Тогда
			Возврат ?(ОбъектКрая.Существует(), "1", "0");
		ИначеЕсли ИмяМетодаКрая = "ЭтоФайл" Тогда
			Возврат ?(ОбъектКрая.ЭтоФайл(), "1", "0");
		ИначеЕсли ИмяМетодаКрая = "ЭтоКаталог" Тогда
			Возврат ?(ОбъектКрая.ЭтоКаталог(), "1", "0");
		Иначе
			Возврат Строка(ОбъектКрая.Размер());
		КонецЕсли;
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

Процедура ПробаВводаВыводаКрая(ИдКрая, КодСимволаКрая, СимволВНачале)
	КореньКрая = "";
	Попытка
		КореньКрая = ПолучитьИмяВременногоФайла(".file-object-io-edges");
		СоздатьКаталог(КореньКрая);
		БазовыйПутьКрая = КореньКрая + "/leaf";
		Если СимволВНачале Тогда
			ИсходныйПутьКрая = КореньКрая + "/" + Символ(КодСимволаКрая) + "leaf";
		Иначе
			ИсходныйПутьКрая = БазовыйПутьКрая + Символ(КодСимволаКрая);
		КонецЕсли;
		ОбъектКрая = Новый Файл(ИсходныйПутьКрая);
		Попытка
			ДанныеКрая = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
			ДанныеКрая.Записать(ИсходныйПутьКрая);
			ЗаписьКрая = "ok";
		Исключение
			ЗаписьКрая = "error";
		КонецПопытки;
		БазовыйОбъектКрая = Новый Файл(БазовыйПутьКрая);
		НайденоКрая = НайтиФайлы(КореньКрая, "*", Истина).Количество();
		ИтогКрая = "write=" + ЗаписьКрая
			+ "|lex.raw=" + ?(ОбъектКрая.ПолноеИмя = ИсходныйПутьКрая, "1", "0")
			+ "|lex.base=" + ?(ОбъектКрая.ПолноеИмя = БазовыйПутьКрая, "1", "0")
			+ "|exists=" + РезультатМетодаКрая(ОбъектКрая, "Существует")
			+ "|isfile=" + РезультатМетодаКрая(ОбъектКрая, "ЭтоФайл")
			+ "|isdir=" + РезультатМетодаКрая(ОбъектКрая, "ЭтоКаталог")
			+ "|size=" + РезультатМетодаКрая(ОбъектКрая, "Размер")
			+ "|base.exists=" + РезультатМетодаКрая(БазовыйОбъектКрая, "Существует")
			+ "|found=" + Строка(НайденоКрая);
		Сообщить(ИдКрая + Символ(9) + ИтогКрая);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдКрая + ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньКрая <> "" Тогда
		Попытка
			УдалитьФайлы(КореньКрая);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдКрая + ":" + ИнформацияОбОшибке().Описание);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-object-io-edges-1");
Попытка
	Сообщить("context.effective" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
Исключение
	Сообщить("context.effective_unavailable" + Символ(9) + "error");
КонецПопытки;
Для Каждого КодКрая Из СтрРазделить("0|1|9|10|13|32|127|133|160|8203|65279", "|") Цикл
	ПробаВводаВыводаКрая("io.suffix." + КодКрая, Число(КодКрая), Ложь);
	ПробаВводаВыводаКрая("io.prefix." + КодКрая, Число(КодКрая), Истина);
КонецЦикла;
Сообщить("file.end" + Символ(9) + "file-object-io-edges-1");
