// Дополнительные типы маски. Маска применяется только к непосредственным
// детям собственного временного корня; представление значения не используется
// для построения пути и не может расширить область удаления.

Процедура ПробаДополнительногоТипаУдаления(ИдДополнительногоУдаления, МаскаДополнительногоУдаления)
	КореньДополнительногоУдаления = "";
	Попытка
		КореньДополнительногоУдаления = ПолучитьИмяВременногоФайла(".delete-more-types");
		СоздатьКаталог(КореньДополнительногоУдаления + "/data");
		ДанныеДополнительногоУдаления = ПолучитьДвоичныеДанныеИзСтроки("x", КодировкаТекста.UTF8, Ложь);
		ДанныеДополнительногоУдаления.Записать(КореньДополнительногоУдаления + "/data/keep.bin");
		Попытка
			УдалитьФайлы(КореньДополнительногоУдаления + "/data", МаскаДополнительногоУдаления);
			ИтогДополнительногоУдаления = "ok";
		Исключение
			ИтогДополнительногоУдаления = "error";
		КонецПопытки;
		КаталогДополнительногоУдаления = Новый Файл(КореньДополнительногоУдаления + "/data");
		СоседДополнительногоУдаления = Новый Файл(КореньДополнительногоУдаления + "/data/keep.bin");
		Сообщить(ИдДополнительногоУдаления + Символ(9) + ИтогДополнительногоУдаления
			+ "|root=" + ?(КаталогДополнительногоУдаления.Существует(), "1", "0")
			+ "|keep=" + ?(СоседДополнительногоУдаления.Существует(), "1", "0"));
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдДополнительногоУдаления + ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньДополнительногоУдаления <> "" Тогда
		Попытка
			УдалитьФайлы(КореньДополнительногоУдаления);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдДополнительногоУдаления + ":" + ИнформацияОбОшибке().Описание);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "delete-more-types-1");
Попытка
	Сообщить("context.effective" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
Исключение
	Сообщить("context.effective_unavailable" + Символ(9) + "error");
КонецПопытки;
ПробаДополнительногоТипаУдаления("delete.more.date", Дата(2020, 1, 15, 12, 34, 56));
ПробаДополнительногоТипаУдаления("delete.more.map", Новый Соответствие);
ПробаДополнительногоТипаУдаления("delete.more.fixed_array", Новый ФиксированныйМассив(Новый Массив));
ПробаДополнительногоТипаУдаления("delete.more.fixed_structure", Новый ФиксированнаяСтруктура(Новый Структура));
ПробаДополнительногоТипаУдаления("delete.more.value_table", Новый ТаблицаЗначений);
ПробаДополнительногоТипаУдаления("delete.more.uuid", Новый УникальныйИдентификатор("00112233-4455-6677-8899-aabbccddeeff"));
ПробаДополнительногоТипаУдаления("delete.more.file", Новый Файл("inside"));
ПробаДополнительногоТипаУдаления("delete.more.binary", ПолучитьДвоичныеДанныеИзСтроки("AB", КодировкаТекста.UTF8, Ложь));
ПробаДополнительногоТипаУдаления("delete.more.enum", КодировкаТекста.UTF8);
ПробаДополнительногоТипаУдаления("delete.more.type", Тип("Строка"));
Сообщить("file.end" + Символ(9) + "delete-more-types-1");
