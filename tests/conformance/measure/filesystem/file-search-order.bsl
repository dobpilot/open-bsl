Процедура ЗаписатьФайлПорядка(ИмяФайлаПорядка, ДанныеПорядка)
	ДанныеПорядка.Записать(ИмяФайлаПорядка);
КонецПроцедуры

Процедура ПробаПорядкаПоиска(ИдПорядка, КореньПорядка, ИмяМетодаПорядка, МаскаПорядка, РекурсияПорядка)
	Попытка
		РезультатПорядка = Вычислить(ИмяМетодаПорядка + "(КореньПорядка, МаскаПорядка, РекурсияПорядка)");
		ТекстПорядка = "ok|count=" + Строка(РезультатПорядка.Количество());
		Для Каждого ФайлПорядка Из РезультатПорядка Цикл
			ОтносительноеИмяПорядка = СтрЗаменить(ФайлПорядка.ПолноеИмя, КореньПорядка + "/", "");
			ТекстПорядка = ТекстПорядка + "|" + ОтносительноеИмяПорядка;
		КонецЦикла;
		Сообщить(ИдПорядка + Символ(9) + ТекстПорядка);
	Исключение
		Сообщить(ИдПорядка + Символ(9) + "error");
	КонецПопытки;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-search-order-1");
КореньПорядка = "";
Попытка
	КореньПорядка = ПолучитьИмяВременногоФайла(".search-order");
	СоздатьКаталог(КореньПорядка + "/z-dir");
	СоздатьКаталог(КореньПорядка + "/a-dir");
	СоздатьКаталог(КореньПорядка + "/m-dir");
	ДанныеПорядка = ПолучитьДвоичныеДанныеИзСтроки("x", КодировкаТекста.UTF8, Ложь);
	ЗаписатьФайлПорядка(КореньПорядка + "/z.txt", ДанныеПорядка);
	ЗаписатьФайлПорядка(КореньПорядка + "/a.txt", ДанныеПорядка);
	ЗаписатьФайлПорядка(КореньПорядка + "/m.bin", ДанныеПорядка);
	ЗаписатьФайлПорядка(КореньПорядка + "/z-dir/b.txt", ДанныеПорядка);
	ЗаписатьФайлПорядка(КореньПорядка + "/a-dir/c.txt", ДанныеПорядка);
	ЗаписатьФайлПорядка(КореньПорядка + "/m-dir/d.bin", ДанныеПорядка);
	Для Каждого ИмяМетодаПорядка Из СтрРазделить("НайтиФайлы,FindFiles", ",") Цикл
		ИдМетодаПорядка = ?(ИмяМетодаПорядка = "НайтиФайлы", "ru", "en");
		ПробаПорядкаПоиска("order." + ИдМетодаПорядка + ".star.flat", КореньПорядка, ИмяМетодаПорядка, "*", Ложь);
		ПробаПорядкаПоиска("order." + ИдМетодаПорядка + ".star.recursive", КореньПорядка, ИмяМетодаПорядка, "*", Истина);
		ПробаПорядкаПоиска("order." + ИдМетодаПорядка + ".txt.recursive", КореньПорядка, ИмяМетодаПорядка, "*.txt", Истина);
	КонецЦикла;
Исключение
	Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Если КореньПорядка <> "" Тогда
	Попытка
		УдалитьФайлы(КореньПорядка);
	Исключение
		Сообщить("file.cleanup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецЕсли;
Сообщить("file.end" + Символ(9) + "file-search-order-1");
