Асинх Процедура КлиентскийКонтекстФиксированныхКоллекций()
КонецПроцедуры

Процедура ПробаКонструктораФиксированнойКоллекции(ИдПробы, ВыражениеПробы)
	Попытка
		ЗначениеФиксированнойКоллекции = Вычислить(ВыражениеПробы);
		ИтогФиксированнойКоллекции = "ok:" + Строка(ТипЗнч(ЗначениеФиксированнойКоллекции));
	Исключение
		ИтогФиксированнойКоллекции = "error";
	КонецПопытки;
	Сообщить(ИдПробы + Символ(9) + ИтогФиксированнойКоллекции);
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "notification-fixed-collections-client-1");

ИсходныйМассивСтруктуры = Новый Массив;
ИсходныйМассивСтруктуры.Добавить(10);
ИсходнаяСтруктура = Новый Структура("А,Б", 1, ИсходныйМассивСтруктуры);
ФиксированнаяСтруктураПробы = Новый ФиксированнаяСтруктура(ИсходнаяСтруктура);
АнглийскаяФиксированнаяСтруктура = Новый FixedStructure(ИсходнаяСтруктура);
Сообщить("fixed_structure.basic" + Символ(9) + Строка(ТипЗнч(ФиксированнаяСтруктураПробы))
	+ "|count=" + Строка(ФиксированнаяСтруктураПробы.Count())
	+ "|property=" + Строка(ФиксированнаяСтруктураПробы.Property("А"))
	+ "|missing=" + Строка(ФиксированнаяСтруктураПробы.Свойство("Нет"))
	+ "|field=" + Строка(ФиксированнаяСтруктураПробы.А)
	+ "|alias=" + Строка(АнглийскаяФиксированнаяСтруктура.А));
ИсходнаяСтруктура.А = 2;
ИсходныйМассивСтруктуры.Add(20);
Сообщить("fixed_structure.snapshot" + Символ(9) + Строка(ФиксированнаяСтруктураПробы.А)
	+ "|nested=" + Строка(ФиксированнаяСтруктураПробы.Б.Count()));
ВыходноеЗначениеСтруктуры = 99;
НайденоСвойствоСтруктуры = ФиксированнаяСтруктураПробы.Property("А", ВыходноеЗначениеСтруктуры);
Сообщить("fixed_structure.out" + Символ(9) + Строка(НайденоСвойствоСтруктуры)
	+ "|value=" + Строка(ВыходноеЗначениеСтруктуры));

ИсходныйМассивСоответствия = Новый Массив;
ИсходныйМассивСоответствия.Add(30);
ИсходноеСоответствие = Новый Соответствие;
ИсходноеСоответствие.Insert("А", 1);
ИсходноеСоответствие.Insert(2, ИсходныйМассивСоответствия);
ФиксированноеСоответствиеПробы = Новый ФиксированноеСоответствие(ИсходноеСоответствие);
АнглийскоеФиксированноеСоответствие = Новый FixedMap(ИсходноеСоответствие);
Сообщить("fixed_map.basic" + Символ(9) + Строка(ТипЗнч(ФиксированноеСоответствиеПробы))
	+ "|count=" + Строка(ФиксированноеСоответствиеПробы.Count())
	+ "|get=" + Строка(ФиксированноеСоответствиеПробы.Get("А"))
	+ "|missing=" + Строка(ФиксированноеСоответствиеПробы.Получить("Нет"))
	+ "|alias=" + Строка(АнглийскоеФиксированноеСоответствие.Get("А")));
ИсходноеСоответствие.Insert("А", 2);
ИсходныйМассивСоответствия.Add(40);
Сообщить("fixed_map.snapshot" + Символ(9) + Строка(ФиксированноеСоответствиеПробы.Get("А"))
	+ "|nested=" + Строка(ФиксированноеСоответствиеПробы.Get(2).Count()));

Для Каждого СтрокаПробы Из СтрРазделить(
	"fixed_structure.none|Новый ФиксированнаяСтруктура;fixed_structure.extra|Новый ФиксированнаяСтруктура(ИсходнаяСтруктура, 1);fixed_structure.bad|Новый ФиксированнаяСтруктура(1);fixed_structure.fixed|Новый ФиксированнаяСтруктура(ФиксированнаяСтруктураПробы);fixed_map.none|Новый ФиксированноеСоответствие;fixed_map.extra|Новый ФиксированноеСоответствие(ИсходноеСоответствие, 1);fixed_map.bad|Новый ФиксированноеСоответствие(1);fixed_map.fixed|Новый ФиксированноеСоответствие(ФиксированноеСоответствиеПробы)", ";") Цикл
	ЧастиПробы = СтрРазделить(СтрокаПробы, "|");
	ПробаКонструктораФиксированнойКоллекции(ЧастиПробы[0], ЧастиПробы[1]);
КонецЦикла;
ПробаКонструктораФиксированнойКоллекции("fixed_structure.count.extra", "ФиксированнаяСтруктураПробы.Count(1)");
ПробаКонструктораФиксированнойКоллекции("fixed_structure.property.none", "ФиксированнаяСтруктураПробы.Property()");
ПробаКонструктораФиксированнойКоллекции("fixed_structure.property.extra", "ФиксированнаяСтруктураПробы.Property(""А"", ВыходноеЗначениеСтруктуры, 1)");
ПробаКонструктораФиксированнойКоллекции("fixed_map.count.extra", "ФиксированноеСоответствиеПробы.Count(1)");
ПробаКонструктораФиксированнойКоллекции("fixed_map.get.none", "ФиксированноеСоответствиеПробы.Get()");
ПробаКонструктораФиксированнойКоллекции("fixed_map.get.extra", "ФиксированноеСоответствиеПробы.Get(""А"", 1)");

Попытка ФиксированнаяСтруктураПробы.А = 3; ИтогЗаписиСтруктуры = "ok"; Исключение ИтогЗаписиСтруктуры = "error"; КонецПопытки;
Попытка ФиксированноеСоответствиеПробы.Insert("А", 3); ИтогЗаписиСоответствия = "ok"; Исключение ИтогЗаписиСоответствия = "error"; КонецПопытки;
Сообщить("immutable" + Символ(9) + ИтогЗаписиСтруктуры + "|" + ИтогЗаписиСоответствия
	+ "|structure=" + Строка(ФиксированнаяСтруктураПробы.А) + "|map=" + Строка(ФиксированноеСоответствиеПробы.Get("А")));

Сообщить("file.end" + Символ(9) + "notification-fixed-collections-client-1");
Попытка Выполнить("ЗавершитьРаботуСистемы(Ложь)"); Исключение КонецПопытки;
