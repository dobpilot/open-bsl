// Доступность запуска на сервере; команды не меняют внешние данные.
Процедура ПробаЗапускаСервера(ИдентификаторЗапуска, ТекстЗапуска)
	КодЗапускаПробы = 12345;
	Попытка
		Выполнить(ТекстЗапуска);
		РезультатЗапускаПробы = "ok";
	Исключение
		РезультатЗапускаПробы = "error|" + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Сообщить(ИдентификаторЗапуска + Символ(9) + РезультатЗапускаПробы + "|code=" + Строка(КодЗапускаПробы));
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "runapp-server-1");
ПробаЗапускаСервера("runapp.ru.wait", "ЗапуститьПриложение(""/usr/bin/true"", ""/tmp"", Истина, КодЗапускаПробы)");
ПробаЗапускаСервера("runapp.en.wait", "RunApp(""/usr/bin/true"", ""/tmp"", True, КодЗапускаПробы)");
ПробаЗапускаСервера("runapp.ru.nowait", "ЗапуститьПриложение(""/usr/bin/true"", ""/tmp"", Ложь, КодЗапускаПробы)");
ПробаЗапускаСервера("runapp.ru.missing", "ЗапуститьПриложение(""/open-bsl-nonexistent-executable"", ""/tmp"", Истина, КодЗапускаПробы)");
ПробаЗапускаСервера("runapp.ru.async", "РезультатАсинхПробы = ЗапуститьПриложениеАсинх(""/usr/bin/true"", ""/tmp"", Истина)");
Сообщить("file.end" + Символ(9) + "runapp-server-1");
