Перем КореньДоставкиОбъекту;
Перем МассивЗаписиОповещения;
Перем СоответствиеЧтенияОповещения;
Перем МассивУстановкиОповещения;
Перем МассивВставкиОповещения;
Перем ПервыйРезультатИнициализации;
Перем ВторойРезультатИнициализации;
Перем ФайлПовторнойИнициализации;
Перем ДанныеДоставкиОбъекту;
Перем ОшибокДоставкиОбъекту;
Перем ПопытокНаблюденияДоставки;

Асинх Процедура КлиентскийКонтекстДоставкиОбъекту()
КонецПроцедуры

Процедура ОшибкаДоставкиОбъекту(Знач ОшибкаОперации, СтандартнаяОбработкаОшибки, Знач ДанныеОшибки) Экспорт
	СтандартнаяОбработкаОшибки = Ложь;
	ОшибокДоставкиОбъекту = ОшибокДоставкиОбъекту + 1;
	Сообщить("delivery.error" + Символ(9) + Строка(ТипЗнч(ОшибкаОперации)));
КонецПроцедуры

Функция ОписаниеДоставкиОбъекту(ИмяМетодаДоставки, ПолучательДоставки, ДанныеДоставки)
	Возврат Вычислить("Новый ОписаниеОповещения(ИмяМетодаДоставки, ПолучательДоставки, ДанныеДоставки, ""ОшибкаДоставкиОбъекту"", ЭтотОбъект)");
КонецФункции

Процедура СнятьДоставкуОбъекту() Экспорт
	ПопытокНаблюденияДоставки = ПопытокНаблюденияДоставки + 1;
	ГотовоНаблюдениеДоставки = МассивЗаписиОповещения.Количество() = 1
		И СоответствиеЧтенияОповещения.Количество() = 1
		И МассивУстановкиОповещения[1] = 99
		И МассивВставкиОповещения.Количество() = 3
		И ПервыйРезультатИнициализации.Количество() = 1
		И ВторойРезультатИнициализации.Количество() = 1;
	Если Не ГотовоНаблюдениеДоставки И ПопытокНаблюденияДоставки < 10 Тогда
		Возврат;
	КонецЕсли;
	Попытка Выполнить("ОтключитьОбработчикОжидания(""СнятьДоставкуОбъекту"");"); Исключение КонецПопытки;
	Сообщить("delivery.ready" + Символ(9) + ?(ГотовоНаблюдениеДоставки, "1", "0"));
	Сообщить("delivery.errors" + Символ(9) + Строка(ОшибокДоставкиОбъекту));
	Попытка
		Сообщить("delivery.write.array" + Символ(9) + ?(МассивЗаписиОповещения[0] = ДанныеДоставкиОбъекту, "same", "different") + "|returned=" + ?(МассивЗаписиОповещения[0].Вернулся, "1", "0"));
		Сообщить("delivery.read.map" + Символ(9) + ?(СоответствиеЧтенияОповещения[3] = ДанныеДоставкиОбъекту, "same", "different") + "|returned=" + ?(СоответствиеЧтенияОповещения[3].Вернулся, "1", "0"));
		Сообщить("delivery.read.array_set" + Символ(9) + Строка(МассивУстановкиОповещения[0]) + "," + Строка(МассивУстановкиОповещения[1]));
		Сообщить("delivery.read.array_insert" + Символ(9) + Строка(МассивВставкиОповещения[0]) + "," + Строка(МассивВставкиОповещения[1]) + "," + Строка(МассивВставкиОповещения[2]));
		Сообщить("delivery.init.first" + Символ(9) + Строка(ПервыйРезультатИнициализации[ФайлПовторнойИнициализации]));
		Сообщить("delivery.init.second" + Символ(9) + Строка(ВторойРезультатИнициализации[ФайлПовторнойИнициализации]));
		Для Каждого ЭлементРезультатаДоставки Из ПервыйРезультатИнициализации Цикл
			Сообщить("delivery.init.first_path" + Символ(9) + СтрЗаменить(ЭлементРезультатаДоставки.Ключ.ПолноеИмя, КореньДоставкиОбъекту, "<root>"));
		КонецЦикла;
		Для Каждого ЭлементРезультатаДоставки Из ВторойРезультатИнициализации Цикл
			Сообщить("delivery.init.second_path" + Символ(9) + СтрЗаменить(ЭлементРезультатаДоставки.Ключ.ПолноеИмя, КореньДоставкиОбъекту, "<root>"));
		КонецЦикла;
	Исключение
		Сообщить("delivery.inspect_error" + Символ(9) + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Попытка УдалитьФайлы(КореньДоставкиОбъекту); Исключение Сообщить("file.cleanup_error" + Символ(9) + ИнформацияОбОшибке().Описание); КонецПопытки;
	Сообщить("file.end" + Символ(9) + "callback-object-delivery-1");
	Попытка Выполнить("ЗавершитьРаботуСистемы(Ложь);"); Исключение КонецПопытки;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "callback-object-delivery-1");
Попытка
	Сообщить("context.compatibility" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
Исключение
	Сообщить("context.compatibility" + Символ(9) + "unavailable");
КонецПопытки;
ОшибокДоставкиОбъекту = 0;
ПопытокНаблюденияДоставки = 0;
МассивЗаписиОповещения = Новый Массив;
СоответствиеЧтенияОповещения = Новый Соответствие;
МассивУстановкиОповещения = Новый Массив;
МассивУстановкиОповещения.Добавить(10);
МассивУстановкиОповещения.Добавить(20);
МассивВставкиОповещения = Новый Массив;
МассивВставкиОповещения.Добавить(10);
МассивВставкиОповещения.Добавить(20);
ПервыйРезультатИнициализации = Новый Соответствие;
ВторойРезультатИнициализации = Новый Соответствие;
ДанныеДоставкиОбъекту = Новый Структура("Вернулся", Ложь);
КореньДоставкиОбъекту = ПолучитьИмяВременногоФайла(".callback-objects");
Попытка
	СоздатьКаталог(КореньДоставкиОбъекту);
	БайтыДоставкиОбъекту = ПолучитьДвоичныеДанныеИзСтроки("abc", КодировкаТекста.UTF8, Ложь);
	БайтыДоставкиОбъекту.Записать(КореньДоставкиОбъекту + "/three");
	ФайлДоставкиОбъекту = Новый Файл(КореньДоставкиОбъекту + "/three");
	ФайлПовторнойИнициализации = Новый Файл(КореньДоставкиОбъекту + "/initial");
	Для НомерПробыДоставки = 1 По 6 Цикл
		Попытка
			Если НомерПробыДоставки = 1 Тогда
				ОписаниеПробыДоставки = ОписаниеДоставкиОбъекту("Добавить", МассивЗаписиОповещения, ДанныеДоставкиОбъекту);
				Выполнить("ФайлДоставкиОбъекту.НачатьУстановкуТолькоЧтения(ОписаниеПробыДоставки, Ложь);");
			ИначеЕсли НомерПробыДоставки = 2 Тогда
				ОписаниеПробыДоставки = ОписаниеДоставкиОбъекту("Insert", СоответствиеЧтенияОповещения, ДанныеДоставкиОбъекту);
				Выполнить("ФайлДоставкиОбъекту.BeginGettingSize(ОписаниеПробыДоставки);");
			ИначеЕсли НомерПробыДоставки = 3 Тогда
				ОписаниеПробыДоставки = ОписаниеДоставкиОбъекту("Set", МассивУстановкиОповещения, 99);
				Выполнить("ФайлДоставкиОбъекту.BeginCheckingExistence(ОписаниеПробыДоставки);");
			ИначеЕсли НомерПробыДоставки = 4 Тогда
				ОписаниеПробыДоставки = ОписаниеДоставкиОбъекту("Вставить", МассивВставкиОповещения, 77);
				Выполнить("ФайлДоставкиОбъекту.НачатьПроверкуЭтоКаталог(ОписаниеПробыДоставки);");
			ИначеЕсли НомерПробыДоставки = 5 Тогда
				ОписаниеПробыДоставки = ОписаниеДоставкиОбъекту("Insert", ПервыйРезультатИнициализации, "first");
				Выполнить("ФайлПовторнойИнициализации.BeginInitialization(ОписаниеПробыДоставки, КореньДоставкиОбъекту + ""/first"");");
			Иначе
				ОписаниеПробыДоставки = ОписаниеДоставкиОбъекту("Insert", ВторойРезультатИнициализации, "second");
				Выполнить("ФайлПовторнойИнициализации.BeginInitialization(ОписаниеПробыДоставки, КореньДоставкиОбъекту + ""/second"");");
			КонецЕсли;
			Сообщить("delivery.call." + Строка(НомерПробыДоставки) + Символ(9) + "returned");
		Исключение
			Сообщить("delivery.call." + Строка(НомерПробыДоставки) + Символ(9) + "error|" + ИнформацияОбОшибке().Описание);
		КонецПопытки;
	КонецЦикла;
	ДанныеДоставкиОбъекту.Вернулся = Истина;
	Сообщить("delivery.init.return_path" + Символ(9) + СтрЗаменить(ФайлПовторнойИнициализации.ПолноеИмя, КореньДоставкиОбъекту, "<root>"));
Исключение
	Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Попытка
	Выполнить("ПодключитьОбработчикОжидания(""СнятьДоставкуОбъекту"", 1, Ложь);");
Исключение
	ПопытокНаблюденияДоставки = 10;
	СнятьДоставкуОбъекту();
КонецПопытки;
