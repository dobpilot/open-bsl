// Безопасные клиентские пробы корневых форм и объекта Файл для
// СоздатьКаталогАсинх. Относительные формы указывают на существующие каталоги.

Асинх Функция ПробаКорняСозданияАсинх(ИдКорняСоздания, АргументКорняСоздания)
	СтадияКорняСоздания = "call";
	ТипОбещанияКорняСоздания = "none";
	Попытка
		ОбещаниеКорняСоздания = СоздатьКаталогАсинх(АргументКорняСоздания);
		ТипОбещанияКорняСоздания = Строка(ТипЗнч(ОбещаниеКорняСоздания));
		СтадияКорняСоздания = "await";
		РезультатКорняСоздания = Ждать ОбещаниеКорняСоздания;
		ИтогКорняСоздания = "ok|type=" + Строка(ТипЗнч(РезультатКорняСоздания))
			+ "|same=" + ?(РезультатКорняСоздания = АргументКорняСоздания, "1", "0");
	Исключение
		ИтогКорняСоздания = "error|stage=" + СтадияКорняСоздания;
	КонецПопытки;
	Сообщить(ИдКорняСоздания + Символ(9) + "promise=" + ТипОбещанияКорняСоздания + "|" + ИтогКорняСоздания);
	Возврат Неопределено;
КонецФункции

Асинх Функция ПробаФайлаСозданияАсинх(ИдФайлаСоздания, ВидФайлаСоздания)
	КореньФайлаСоздания = "";
	Попытка
		КореньФайлаСоздания = ПолучитьИмяВременногоФайла(".create-directory-file-async");
		СоздатьКаталог(КореньФайлаСоздания);
		Если ВидФайлаСоздания = "directory" Тогда
			ПутьФайлаСоздания = КореньФайлаСоздания;
		Иначе
			ПутьФайлаСоздания = КореньФайлаСоздания + "/leaf";
		КонецЕсли;
		Если ВидФайлаСоздания = "regular" Тогда
			ДанныеФайлаСоздания = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
			ДанныеФайлаСоздания.Записать(ПутьФайлаСоздания);
		КонецЕсли;
		АргументФайлаСоздания = Новый Файл(ПутьФайлаСоздания);
		СтадияФайлаСоздания = "call";
		ТипОбещанияФайлаСоздания = "none";
		Попытка
			ОбещаниеФайлаСоздания = СоздатьКаталогАсинх(АргументФайлаСоздания);
			ТипОбещанияФайлаСоздания = Строка(ТипЗнч(ОбещаниеФайлаСоздания));
			СтадияФайлаСоздания = "await";
			РезультатФайлаСоздания = Ждать ОбещаниеФайлаСоздания;
			ИтогФайлаСоздания = "ok|type=" + Строка(ТипЗнч(РезультатФайлаСоздания))
				+ "|same=" + ?(РезультатФайлаСоздания = АргументФайлаСоздания, "1", "0");
		Исключение
			ИтогФайлаСоздания = "error|stage=" + СтадияФайлаСоздания;
		КонецПопытки;
		ПроверочныйФайлСоздания = Новый Файл(ПутьФайлаСоздания);
		СуществуетФайлСоздания = ПроверочныйФайлСоздания.Существует();
		Если СуществуетФайлСоздания Тогда
			ЭтоФайлСоздания = ПроверочныйФайлСоздания.ЭтоФайл();
		Иначе
			ЭтоФайлСоздания = Ложь;
		КонецЕсли;
		ИтогФайлаСоздания = "promise=" + ТипОбещанияФайлаСоздания + "|"
			+ ИтогФайлаСоздания + "|exists=" + ?(СуществуетФайлСоздания, "1", "0")
			+ "|file=" + ?(ЭтоФайлСоздания, "1", "0");
		Сообщить(ИдФайлаСоздания + Символ(9) + ИтогФайлаСоздания);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдФайлаСоздания + ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньФайлаСоздания <> "" Тогда
		Попытка
			УдалитьФайлы(КореньФайлаСоздания);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдФайлаСоздания + ":" + ИнформацияОбОшибке().Описание);
		КонецПопытки;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Асинх Процедура ВыполнитьПробыКорнейСозданияАсинх()
	Сообщить("file.begin" + Символ(9) + "create-directory-roots-async-1");
	Попытка
		Сообщить("context.effective" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
	Исключение
		Сообщить("context.effective_unavailable" + Символ(9) + "error");
	КонецПопытки;
	Ждать ПробаКорняСозданияАсинх("create.root.one", "/");
	Ждать ПробаКорняСозданияАсинх("create.root.two", "//");
	Ждать ПробаКорняСозданияАсинх("create.root.three", "///");
	Ждать ПробаКорняСозданияАсинх("create.relative.dot", ".");
	Ждать ПробаКорняСозданияАсинх("create.relative.dot_slash", "./");
	Ждать ПробаКорняСозданияАсинх("create.relative.parent", "..");
	Ждать ПробаКорняСозданияАсинх("create.relative.parent_slash", "../");
	Ждать ПробаФайлаСозданияАсинх("create.file_object.new", "new");
	Ждать ПробаФайлаСозданияАсинх("create.file_object.directory", "directory");
	Ждать ПробаФайлаСозданияАсинх("create.file_object.regular", "regular");
	Сообщить("file.end" + Символ(9) + "create-directory-roots-async-1");

	Попытка
		Выполнить("ЗавершитьРаботуСистемы(Ложь);");
	Исключение
	КонецПопытки;
КонецПроцедуры

ВыполнитьПробыКорнейСозданияАсинх();
