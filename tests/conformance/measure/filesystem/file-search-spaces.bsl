// Только чтение дерева из file-search-spaces.host.txt, подготовленного средствами ОС.
// Конечные пробелы и TAB в именах не создаются через BSL-нормализацию пути.
Процедура ПробаПоискаПробелов(ИдПоискаПробелов, ПутьПоискаПробелов, МаскаПоискаПробелов, РекурсияПоискаПробелов, КореньПоискаПробелов)
	Попытка
		РезультатПоискаПробелов = НайтиФайлы(ПутьПоискаПробелов, МаскаПоискаПробелов, РекурсияПоискаПробелов);
		ВыводПоискаПробелов = "ok|count=" + Строка(РезультатПоискаПробелов.Количество());
		Для Каждого ЭлементПоискаПробелов Из РезультатПоискаПробелов Цикл
			ИмяПоискаПробелов = СтрЗаменить(ЭлементПоискаПробелов.ПолноеИмя, КореньПоискаПробелов, "<root>");
			ИмяПоискаПробелов = СтрЗаменить(СтрЗаменить(ИмяПоискаПробелов, " ", "<SP>"), Символ(9), "<TAB>");
			Попытка
				КаталогПоискаПробелов = ?(ЭлементПоискаПробелов.ЭтоКаталог(), "1", "0");
			Исключение
				КаталогПоискаПробелов = "error";
			КонецПопытки;
			ВыводПоискаПробелов = ВыводПоискаПробелов + "|" + ИмяПоискаПробелов
				+ ":exists=" + ?(ЭлементПоискаПробелов.Существует(), "1", "0")
				+ ":dir=" + КаталогПоискаПробелов;
		КонецЦикла;
		Сообщить(ИдПоискаПробелов + Символ(9) + ВыводПоискаПробелов);
	Исключение
		Сообщить(ИдПоискаПробелов + Символ(9) + "error|" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецПроцедуры

Процедура ПараПоискаПробелов(ИдПарыПробелов, ПутьПарыПробелов, МаскаПарыПробелов, КореньПарыПробелов)
	ПробаПоискаПробелов(ИдПарыПробелов + ".flat", ПутьПарыПробелов, МаскаПарыПробелов, Ложь, КореньПарыПробелов);
	ПробаПоискаПробелов(ИдПарыПробелов + ".recursive", ПутьПарыПробелов, МаскаПарыПробелов, Истина, КореньПарыПробелов);
КонецПроцедуры

КореньПоискаПробелов = "/tmp/open-bsl-search-spaces-miRh6I";
Сообщить("file.begin" + Символ(9) + "search-spaces-1");
Попытка
	Сообщить("context.effective" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
Исключение
	Сообщить("context.effective_unavailable" + Символ(9) + "error");
КонецПопытки;
Для Каждого СлучайПоискаПробелов Из СтрРазделить("alone|middle|twins|file|file-twins|leading|tab", "|") Цикл
	ПутьСлучаяПробелов = КореньПоискаПробелов + "/" + СлучайПоискаПробелов;
	ПараПоискаПробелов(СлучайПоискаПробелов + ".star", ПутьСлучаяПробелов, "*", КореньПоискаПробелов);
	ПараПоискаПробелов(СлучайПоискаПробелов + ".star_dot", ПутьСлучаяПробелов, "*.*", КореньПоискаПробелов);
	ПараПоискаПробелов(СлучайПоискаПробелов + ".prefix", ПутьСлучаяПробелов, "p*", КореньПоискаПробелов);
	ПараПоискаПробелов(СлучайПоискаПробелов + ".exact", ПутьСлучаяПробелов, "padded", КореньПоискаПробелов);
	ПараПоискаПробелов(СлучайПоискаПробелов + ".spaced", ПутьСлучаяПробелов, "padded ", КореньПоискаПробелов);
	ПараПоискаПробелов(СлучайПоискаПробелов + ".txt", ПутьСлучаяПробелов, "*.txt", КореньПоискаПробелов);
	ПараПоискаПробелов(СлучайПоискаПробелов + ".direct_space", ПутьСлучаяПробелов + "/padded ", Неопределено, КореньПоискаПробелов);
	ПараПоискаПробелов(СлучайПоискаПробелов + ".inside_space", ПутьСлучаяПробелов + "/padded ", "*", КореньПоискаПробелов);
	ПараПоискаПробелов(СлучайПоискаПробелов + ".inside_space_slash", ПутьСлучаяПробелов + "/padded /", "*", КореньПоискаПробелов);
КонецЦикла;
Сообщить("file.end" + Символ(9) + "search-spaces-1");
