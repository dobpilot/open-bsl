Функция ПричинаПробыРазмера(ОшибкаПробы)
	Пока ОшибкаПробы.Причина <> Неопределено Цикл
		ОшибкаПробы = ОшибкаПробы.Причина;
	КонецЦикла;
	Возврат ОшибкаПробы.Описание;
КонецФункции

Процедура ПроверитьМетодыРазмера(ВидПотокаПробы, ИменаМетодовПробы)
	ИмяФайлаПробы = "";
	Для Каждого ИмяМетодаПробы Из ИменаМетодовПробы Цикл
		ПотокПробы = Неопределено;
		Попытка
			Если ВидПотокаПробы = "memory" Тогда
				ПотокПробы = Новый ПотокВПамяти;
			Иначе
				ИмяФайлаПробы = ПолучитьИмяВременногоФайла("tmp");
				ПотокПробы = ФайловыеПотоки.Создать(ИмяФайлаПробы);
			КонецЕсли;
			БуферПробы = Новый БуферДвоичныхДанных(6);
			ПотокПробы.Записать(БуферПробы, 0, 6);
			ПотокПробы.Перейти(5, ПозицияВПотоке.Начало);
		Исключение
			Сообщить("file.setup_error" + Символ(9) + ПричинаПробыРазмера(ИнформацияОбОшибке()));
			Возврат;
		КонецПопытки;
		Попытка
			Выполнить("ПотокПробы." + ИмяМетодаПробы + "(2);");
			РезультатРазмера = "ok";
		Исключение
			РезультатРазмера = "error:" + ПричинаПробыРазмера(ИнформацияОбОшибке());
		КонецПопытки;
		Сообщить(ВидПотокаПробы + "." + ИмяМетодаПробы + Символ(9) + РезультатРазмера
			+ "|size=" + Строка(ПотокПробы.Размер()) + "|position=" + Строка(ПотокПробы.ТекущаяПозиция()));
		Попытка
			ПотокПробы.Закрыть();
			Если ИмяФайлаПробы <> "" Тогда
				УдалитьФайлы(ИмяФайлаПробы);
				ИмяФайлаПробы = "";
			КонецЕсли;
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ПричинаПробыРазмера(ИнформацияОбОшибке()));
			Возврат;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "stream-resize-methods-1");
ИменаМетодовРазмера = СтрРазделить("УстановитьРазмер,SetSize,ИзменитьРазмер,Resize,УстановитьДлину,SetLength,Обрезать,Truncate,УстановитьКонецПотока,SetEndOfStream", ",");
ПроверитьМетодыРазмера("memory", ИменаМетодовРазмера);
ПроверитьМетодыРазмера("file", ИменаМетодовРазмера);
Сообщить("file.end" + Символ(9) + "stream-resize-methods-1");
