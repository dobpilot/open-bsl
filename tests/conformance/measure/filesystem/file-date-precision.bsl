// Точность числового сдвига даты; не изменяет пользовательские файлы.
Функция ЧислоТочностиДаты(Знач ЧислоТочностиПробы)
    Возврат Формат(ЧислоТочностиПробы, "ЧГ=0;ЧРД=.;ЧН=0");
КонецФункции

Процедура ПроверкаТочностиДаты(КлючТочностиПробы, ДатаТочностиПробы, СмещениеТочностиПробы)
    Для ИндексОперацииТочности = 0 По 1 Цикл
        Попытка
            Если ИндексОперацииТочности = 0 Тогда
                ИтогТочностиПробы = ДатаТочностиПробы + СмещениеТочностиПробы;
            Иначе
                ИтогТочностиПробы = ДатаТочностиПробы - СмещениеТочностиПробы;
            КонецЕсли;
            ТекстТочностиПробы = ЧислоТочностиДаты(ИтогТочностиПробы - ДатаТочностиПробы)
                + "|" + ?(ИтогТочностиПробы = ДатаТочностиПробы, "1", "0")
                + "|" + ЧислоТочностиДаты(Секунда(ИтогТочностиПробы));
        Исключение
            ТекстТочностиПробы = "error";
        КонецПопытки;
        Сообщить(КлючТочностиПробы + "." + ?(ИндексОперацииТочности = 0, "add", "sub")
            + Символ(9) + ТекстТочностиПробы);
    КонецЦикла;
КонецПроцедуры

