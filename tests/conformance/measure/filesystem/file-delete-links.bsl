// Удаляются только подготовленные данные отдельной пробы, все цели внутри неё.
Процедура ПробаУдаленияСсылок(ИдУдаления, КореньСлучая, ОтносительныйПуть, МаскаУдаления)
	Попытка
		Попытка
			УдалитьФайлы(КореньСлучая + "/root" + ОтносительныйПуть, МаскаУдаления);
			ИтогУдаления = "ok";
		Исключение
			ИтогУдаления = "error";
		КонецПопытки;
		ФайлКорняУдаления = Новый Файл(КореньСлучая + "/root");
		ИтогУдаления = ИтогУдаления + "|root=" + ?(ФайлКорняУдаления.Существует(), "1", "0");
		Для Каждого ИмяСсылкиУдаления Из СтрРазделить("a.txt|actual|linked-dir|linked-file.txt|broken.txt", "|") Цикл
			ИтогУдаления = ИтогУдаления + "|" + ИмяСсылкиУдаления + "="
				+ Строка(НайтиФайлы(КореньСлучая + "/root", ИмяСсылкиУдаления).Количество());
		КонецЦикла;
		Для Каждого ИмяЦелиУдаления Из СтрРазделить("outside/remote.txt|outside/nested/leaf.txt", "|") Цикл
			ФайлЦелиУдаления = Новый Файл(КореньСлучая + "/" + ИмяЦелиУдаления);
			ИтогУдаления = ИтогУдаления + "|" + ИмяЦелиУдаления + "=" + ?(ФайлЦелиУдаления.Существует(), "1", "0");
		КонецЦикла;
		Сообщить(ИдУдаления + Символ(9) + ИтогУдаления);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдУдаления + ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецПроцедуры

КореньУдаленияСсылок = "/tmp/open-bsl-delete-links-fDfotu/native";
Сообщить("file.begin" + Символ(9) + "file-delete-links-1");
ПробаУдаленияСсылок("delete.links.early.file", КореньУдаленияСсылок + "/early_file", "/linked-file.txt", Неопределено);
ПробаУдаленияСсылок("delete.links.early.dir", КореньУдаленияСсылок + "/early_dir", "/linked-dir", Неопределено);
ПробаУдаленияСсылок("delete.links.early.broken", КореньУдаленияСсылок + "/early_broken", "/broken.txt", Неопределено);
ПробаУдаленияСсылок("delete.links.early.star", КореньУдаленияСсылок + "/early_star", "", "*");
ПробаУдаленияСсылок("delete.links.early.txt", КореньУдаленияСсылок + "/early_txt", "", "*.txt");
ПробаУдаленияСсылок("delete.links.early.exact_broken", КореньУдаленияСсылок + "/early_exact_broken", "", "broken.txt");
ПробаУдаленияСсылок("delete.links.early.empty", КореньУдаленияСсылок + "/early_empty", "", "");
ПробаУдаленияСсылок("delete.links.early.exact_dir", КореньУдаленияСсылок + "/early_exact_dir", "", "linked-dir");
ПробаУдаленияСсылок("delete.links.early.exact_file", КореньУдаленияСсылок + "/early_exact_file", "", "linked-file.txt");
ПробаУдаленияСсылок("delete.links.late.file", КореньУдаленияСсылок + "/late_file", "/linked-file.txt", Неопределено);
ПробаУдаленияСсылок("delete.links.late.dir", КореньУдаленияСсылок + "/late_dir", "/linked-dir", Неопределено);
ПробаУдаленияСсылок("delete.links.late.broken", КореньУдаленияСсылок + "/late_broken", "/broken.txt", Неопределено);
ПробаУдаленияСсылок("delete.links.late.star", КореньУдаленияСсылок + "/late_star", "", "*");
ПробаУдаленияСсылок("delete.links.late.txt", КореньУдаленияСсылок + "/late_txt", "", "*.txt");
ПробаУдаленияСсылок("delete.links.late.exact_broken", КореньУдаленияСсылок + "/late_exact_broken", "", "broken.txt");
ПробаУдаленияСсылок("delete.links.late.empty", КореньУдаленияСсылок + "/late_empty", "", "");
ПробаУдаленияСсылок("delete.links.late.exact_dir", КореньУдаленияСсылок + "/late_exact_dir", "", "linked-dir");
ПробаУдаленияСсылок("delete.links.late.exact_file", КореньУдаленияСсылок + "/late_exact_file", "", "linked-file.txt");
Сообщить("file.end" + Символ(9) + "file-delete-links-1");
