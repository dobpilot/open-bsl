// Серверная проба операционного пути ЧтениеXML и ЗаписьXML.

Функция ОткрытьXMLДляЗаписиКрая(ПутьXMLКрая)
	Попытка
		ПисательXMLКрая = Новый ЗаписьXML;
		ПисательXMLКрая.ОткрытьФайл(ПутьXMLКрая);
		ПисательXMLКрая.ЗаписатьНачалоЭлемента("a");
		ПисательXMLКрая.ЗаписатьКонецЭлемента();
		ПисательXMLКрая.Закрыть();
		Возврат "ok";
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

Функция ОткрытьXMLДляЧтенияКрая(ПутьXMLКрая)
	Попытка
		ЧитательXMLКрая = Новый ЧтениеXML;
		ЧитательXMLКрая.ОткрытьФайл(ПутьXMLКрая);
		Если ЧитательXMLКрая.Прочитать() Тогда
			Возврат "ok:" + ЧитательXMLКрая.Имя;
		КонецЕсли;
		Возврат "ok:empty";
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

Процедура ПробаXMLКрая(ИдXMLКрая, КодСимволаXMLКрая,
		СимволВНачалеXMLКрая, ВидXMLКрая)
	КореньXMLКрая = "";
	Попытка
		КореньXMLКрая = ПолучитьИмяВременногоФайла(".file-xml-io-edges");
		СоздатьКаталог(КореньXMLКрая);
		БазовыйПутьXMLКрая = КореньXMLКрая + "/leaf";
		Если ВидXMLКрая = "writer" Тогда
			ИсходныйТекстXMLКрая = "ABC";
		Иначе
			ИсходныйТекстXMLКрая = "<a/>";
		КонецЕсли;
		ИсходныеДанныеXMLКрая = ПолучитьДвоичныеДанныеИзСтроки(
			ИсходныйТекстXMLКрая, КодировкаТекста.UTF8, Ложь);
		ИсходныеДанныеXMLКрая.Записать(БазовыйПутьXMLКрая);
		Если СимволВНачалеXMLКрая Тогда
			ИсходныйПутьXMLКрая = КореньXMLКрая + "/"
				+ Символ(КодСимволаXMLКрая) + "leaf";
		Иначе
			ИсходныйПутьXMLКрая = БазовыйПутьXMLКрая
				+ Символ(КодСимволаXMLКрая);
		КонецЕсли;
		Если ВидXMLКрая = "writer" Тогда
			СтатусXMLКрая = ОткрытьXMLДляЗаписиКрая(ИсходныйПутьXMLКрая);
			Попытка
				БайтыXMLКрая = ПолучитьHexСтрокуИзДвоичныхДанных(
					Новый ДвоичныеДанные(БазовыйПутьXMLКрая));
			Исключение
				БайтыXMLКрая = "error";
			КонецПопытки;
			РезультатXMLКрая = СтатусXMLКрая + ":" + БайтыXMLКрая;
		Иначе
			РезультатXMLКрая = ОткрытьXMLДляЧтенияКрая(ИсходныйПутьXMLКрая);
		КонецЕсли;
		Сообщить(ИдXMLКрая + "." + ВидXMLКрая + Символ(9) + РезультатXMLКрая);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдXMLКрая + "."
			+ ВидXMLКрая + ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньXMLКрая <> "" Тогда
		Попытка
			УдалитьФайлы(КореньXMLКрая);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдXMLКрая + "."
				+ ВидXMLКрая);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-xml-io-edges-1");
Для Каждого КодXMLКрая Из СтрРазделить(
		"0|9|10|13|32|127|133|160|8203|65279", "|") Цикл
	Для Каждого ВидXMLКрая Из СтрРазделить("writer|reader", "|") Цикл
		ПробаXMLКрая("xml.suffix." + КодXMLКрая, Число(КодXMLКрая),
			Ложь, ВидXMLКрая);
		Если КодXMLКрая = "0" И ВидXMLКрая = "writer" Тогда
			ПробаXMLКрая("xml.prefix.0", 0, Истина, ВидXMLКрая);
		КонецЕсли;
	КонецЦикла;
КонецЦикла;
Сообщить("file.end" + Символ(9) + "file-xml-io-edges-1");
