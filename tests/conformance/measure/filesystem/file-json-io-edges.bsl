// Серверная проба операционного пути ЧтениеJSON и ЗаписьJSON.

Функция ОткрытьJSONДляЗаписиКрая(ПутьJSONКрая)
	ПисательJSONКрая = Неопределено;
	Попытка
		ПисательJSONКрая = Новый ЗаписьJSON;
		ПисательJSONКрая.ОткрытьФайл(ПутьJSONКрая);
		ПисательJSONКрая.ЗаписатьЗначение(1);
		ПисательJSONКрая.Закрыть();
		Возврат "ok";
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

Функция ОткрытьJSONДляЧтенияКрая(ПутьJSONКрая)
	Попытка
		ЧитательJSONКрая = Новый ЧтениеJSON;
		ЧитательJSONКрая.ОткрытьФайл(ПутьJSONКрая);
		ЗначениеJSONКрая = ПрочитатьJSON(ЧитательJSONКрая);
		Возврат "ok:" + Строка(ЗначениеJSONКрая);
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

Процедура ПробаJSONКрая(ИдJSONКрая, КодСимволаJSONКрая,
		СимволВНачалеJSONКрая, ВидJSONКрая)
	КореньJSONКрая = "";
	Попытка
		КореньJSONКрая = ПолучитьИмяВременногоФайла(".file-json-io-edges");
		СоздатьКаталог(КореньJSONКрая);
		БазовыйПутьJSONКрая = КореньJSONКрая + "/leaf";
		Если ВидJSONКрая = "writer" Тогда
			ИсходныеДанныеJSONКрая = ПолучитьДвоичныеДанныеИзСтроки("ABC",
				КодировкаТекста.UTF8, Ложь);
		Иначе
			ИсходныеДанныеJSONКрая = ПолучитьДвоичныеДанныеИзСтроки("1",
				КодировкаТекста.UTF8, Ложь);
		КонецЕсли;
		ИсходныеДанныеJSONКрая.Записать(БазовыйПутьJSONКрая);
		Если СимволВНачалеJSONКрая Тогда
			ИсходныйПутьJSONКрая = КореньJSONКрая + "/"
				+ Символ(КодСимволаJSONКрая) + "leaf";
		Иначе
			ИсходныйПутьJSONКрая = БазовыйПутьJSONКрая
				+ Символ(КодСимволаJSONКрая);
		КонецЕсли;
		Если ВидJSONКрая = "writer" Тогда
			СтатусJSONКрая = ОткрытьJSONДляЗаписиКрая(ИсходныйПутьJSONКрая);
			Попытка
				БайтыJSONКрая = ПолучитьHexСтрокуИзДвоичныхДанных(
					Новый ДвоичныеДанные(БазовыйПутьJSONКрая));
			Исключение
				БайтыJSONКрая = "error";
			КонецПопытки;
			РезультатJSONКрая = СтатусJSONКрая + ":" + БайтыJSONКрая;
		Иначе
			РезультатJSONКрая = ОткрытьJSONДляЧтенияКрая(ИсходныйПутьJSONКрая);
		КонецЕсли;
		Сообщить(ИдJSONКрая + "." + ВидJSONКрая + Символ(9)
			+ РезультатJSONКрая);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдJSONКрая + "."
			+ ВидJSONКрая + ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньJSONКрая <> "" Тогда
		Попытка
			УдалитьФайлы(КореньJSONКрая);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдJSONКрая + "."
				+ ВидJSONКрая);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-json-io-edges-1");
Для Каждого КодJSONКрая Из СтрРазделить(
		"0|9|10|13|32|127|133|160|8203|65279", "|") Цикл
	Для Каждого ВидJSONКрая Из СтрРазделить("writer|reader", "|") Цикл
		ПробаJSONКрая("json.suffix." + КодJSONКрая, Число(КодJSONКрая),
			Ложь, ВидJSONКрая);
		Если КодJSONКрая = "0" И ВидJSONКрая = "writer" Тогда
			ПробаJSONКрая("json.prefix.0", 0, Истина, ВидJSONКрая);
		КонецЕсли;
	КонецЦикла;
КонецЦикла;
Сообщить("file.end" + Символ(9) + "file-json-io-edges-1");
