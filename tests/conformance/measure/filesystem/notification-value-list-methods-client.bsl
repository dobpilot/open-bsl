Функция СнимокСпискаПробы(СписокПробы)
	СнимокПробы = Строка(СписокПробы.Количество()) + ":";
	Для НомерЭлементаПробы = 0 По СписокПробы.Количество() - 1 Цикл
		ЭлементСнимкаПробы = СписокПробы[НомерЭлементаПробы];
		СнимокПробы = СнимокПробы + Строка(ЭлементСнимкаПробы.Значение)
			+ "/" + Строка(ЭлементСнимкаПробы.Представление) + ";";
	КонецЦикла;
	Возврат СнимокПробы;
КонецФункции

Функция НовыйСписокПробы()
	СписокПробы = Новый СписокЗначений;
	СписокПробы.Добавить("a", "A");
	СписокПробы.Добавить("b", "B");
	СписокПробы.Добавить("c", "C");
	Возврат СписокПробы;
КонецФункции

Процедура ПробаВыраженияСписка(ИдПробы, ВыражениеПробы, ЭтоВыражение)
	СписокПробы = НовыйСписокПробы();
	Попытка
		Если ЭтоВыражение Тогда
			РезультатПробы = Вычислить(ВыражениеПробы);
			ИтогПробы = "ok:" + Строка(ТипЗнч(РезультатПробы)) + ":" + Строка(РезультатПробы);
		Иначе
			Выполнить(ВыражениеПробы);
			ИтогПробы = "ok";
		КонецЕсли;
	Исключение
		ИтогПробы = "error";
	КонецПопытки;
	Сообщить(ИдПробы + Символ(9) + ИтогПробы + "|list=" + СнимокСпискаПробы(СписокПробы));
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "notification-value-list-methods-client-1");

// Получить и Индекс: результат и преобразование индекса.
ПробаВыраженияСписка("get.ru", "СписокПробы.Получить(1).Значение", Истина);
ПробаВыраженияСписка("get.en", "СписокПробы.Get(1).Value", Истина);
ПробаВыраженияСписка("get.fraction", "СписокПробы.Get(1.9).Value", Истина);
ПробаВыраженияСписка("get.string", "СписокПробы.Get(""1"").Value", Истина);
ПробаВыраженияСписка("get.negative", "СписокПробы.Get(-1)", Истина);
ПробаВыраженияСписка("get.none", "СписокПробы.Get()", Истина);
ПробаВыраженияСписка("get.extra", "СписокПробы.Get(0, 1)", Истина);

СписокПробы = НовыйСписокПробы();
ЭлементПробы = СписокПробы[1];
Сообщить("index.ru" + Символ(9) + Строка(СписокПробы.Индекс(ЭлементПробы)));
Сообщить("index.en" + Символ(9) + Строка(СписокПробы.IndexOf(ЭлементПробы)));
ЧужойСписокПробы = НовыйСписокПробы();
Сообщить("index.foreign" + Символ(9) + Строка(СписокПробы.IndexOf(ЧужойСписокПробы[1])));
ПробаВыраженияСписка("index.value", "СписокПробы.IndexOf(""b"")", Истина);
ПробаВыраженияСписка("index.none", "СписокПробы.IndexOf()", Истина);
ПробаВыраженияСписка("index.extra", "СписокПробы.IndexOf(СписокПробы[0], 1)", Истина);

// Удалить, Очистить и Сдвинуть — процедуры; ошибка не должна менять список.
СписокПробы = НовыйСписокПробы();
ЭлементПробы = СписокПробы[1];
СписокПробы.Удалить(ЭлементПробы);
Сообщить("delete.ru" + Символ(9) + СнимокСпискаПробы(СписокПробы));
СписокПробы = НовыйСписокПробы();
ЭлементПробы = СписокПробы[1];
СписокПробы.Delete(ЭлементПробы);
Сообщить("delete.en" + Символ(9) + СнимокСпискаПробы(СписокПробы));
ПробаВыраженияСписка("delete.value", "СписокПробы.Delete(""b"")", Ложь);
СписокПробы = НовыйСписокПробы();
ЧужойСписокПробы = НовыйСписокПробы();
Попытка
	СписокПробы.Delete(ЧужойСписокПробы[1]);
	ИтогЧужогоЭлементаПробы = "ok";
Исключение
	ИтогЧужогоЭлементаПробы = "error";
КонецПопытки;
Сообщить("delete.foreign" + Символ(9) + ИтогЧужогоЭлементаПробы
	+ "|list=" + СнимокСпискаПробы(СписокПробы));
ПробаВыраженияСписка("delete.none", "СписокПробы.Delete()", Ложь);
ПробаВыраженияСписка("delete.extra", "СписокПробы.Delete(СписокПробы[0], 1)", Ложь);
ПробаВыраженияСписка("delete.expression", "СписокПробы.Delete(СписокПробы[0])", Истина);
ПробаВыраженияСписка("clear.ru", "СписокПробы.Очистить()", Ложь);
ПробаВыраженияСписка("clear.en", "СписокПробы.Clear()", Ложь);
ПробаВыраженияСписка("clear.extra", "СписокПробы.Clear(1)", Ложь);
ПробаВыраженияСписка("clear.expression", "СписокПробы.Clear()", Истина);

СписокПробы = НовыйСписокПробы();
ЭлементПробы = СписокПробы[0];
СписокПробы.Сдвинуть(ЭлементПробы, 1);
Сообщить("move.ru" + Символ(9) + СнимокСпискаПробы(СписокПробы));
ПробаВыраженияСписка("move.en.large", "СписокПробы.Move(СписокПробы[0], 20)", Ложь);
ПробаВыраженияСписка("move.en.negative", "СписокПробы.Move(СписокПробы[2], -20)", Ложь);
ПробаВыраженияСписка("move.value", "СписокПробы.Move(""a"", 1)", Ложь);
Для НомерЧужогоЭлементаПробы = 0 По 2 Цикл
	СписокПробы = НовыйСписокПробы();
	ЧужойСписокПробы = НовыйСписокПробы();
	Попытка
		СписокПробы.Move(ЧужойСписокПробы[НомерЧужогоЭлементаПробы], 1);
		ИтогЧужогоЭлементаПробы = "ok";
	Исключение
		ИтогЧужогоЭлементаПробы = "error";
	КонецПопытки;
	Сообщить("move.foreign." + Строка(НомерЧужогоЭлементаПробы) + Символ(9)
		+ ИтогЧужогоЭлементаПробы + "|list=" + СнимокСпискаПробы(СписокПробы));
КонецЦикла;
ПробаВыраженияСписка("move.offset_fraction", "СписокПробы.Move(СписокПробы[0], 1.9)", Ложь);
ПробаВыраженияСписка("move.offset_string", "СписокПробы.Move(СписокПробы[0], ""1"")", Ложь);
ПробаВыраженияСписка("move.none", "СписокПробы.Move()", Ложь);
ПробаВыраженияСписка("move.one", "СписокПробы.Move(СписокПробы[0])", Ложь);
ПробаВыраженияСписка("move.extra", "СписокПробы.Move(СписокПробы[0], 1, 2)", Ложь);
ПробаВыраженияСписка("move.expression", "СписокПробы.Move(СписокПробы[0], 1)", Истина);

// Вставить возвращает тот же элемент и принимает четыре поля после индекса.
Для КоличествоАргументовПробы = 1 По 5 Цикл
	СписокПробы = НовыйСписокПробы();
	Если КоличествоАргументовПробы = 1 Тогда
		ВыражениеВставкиПробы = "СписокПробы.Insert(1)";
	ИначеЕсли КоличествоАргументовПробы = 2 Тогда
		ВыражениеВставкиПробы = "СписокПробы.Insert(1, ""x"")";
	ИначеЕсли КоличествоАргументовПробы = 3 Тогда
		ВыражениеВставкиПробы = "СписокПробы.Insert(1, ""x"", ""X"")";
	ИначеЕсли КоличествоАргументовПробы = 4 Тогда
		ВыражениеВставкиПробы = "СписокПробы.Insert(1, ""x"", ""X"", Истина)";
	Иначе
		ВыражениеВставкиПробы = "СписокПробы.Insert(1, ""x"", ""X"", Истина, Неопределено)";
	КонецЕсли;
	Попытка
		ЭлементВставкиПробы = Вычислить(ВыражениеВставкиПробы);
		ИтогВставкиПробы = "ok|alias=" + Строка(ЭлементВставкиПробы = СписокПробы[1])
			+ "|mark=" + Строка(ЭлементВставкиПробы.Пометка)
			+ "|picture=" + Строка(ЭлементВставкиПробы.Картинка);
	Исключение
		ИтогВставкиПробы = "error";
	КонецПопытки;
	Сообщить("insert." + Строка(КоличествоАргументовПробы) + Символ(9)
		+ ИтогВставкиПробы + "|list=" + СнимокСпискаПробы(СписокПробы));
КонецЦикла;
ПробаВыраженияСписка("insert.zero", "СписокПробы.Insert()", Истина);
ПробаВыраженияСписка("insert.extra", "СписокПробы.Insert(1, 2, 3, Ложь, Неопределено, 6)", Истина);
ПробаВыраженияСписка("insert.index.zero", "СписокПробы.Insert(0, ""x"").Value", Истина);
ПробаВыраженияСписка("insert.index.end", "СписокПробы.Insert(3, ""x"").Value", Истина);
ПробаВыраженияСписка("insert.index.beyond", "СписокПробы.Insert(5, ""x"").Value", Истина);
ПробаВыраженияСписка("insert.index.negative", "СписокПробы.Insert(-1, ""x"").Value", Истина);
ПробаВыраженияСписка("insert.index.fraction", "СписокПробы.Insert(1.9, ""x"").Value", Истина);
ПробаВыраженияСписка("insert.index.string", "СписокПробы.Insert(""1"", ""x"").Value", Истина);

// Добавить имеет тот же набор полей без индекса.
Для КоличествоАргументовПробы = 0 По 4 Цикл
	СписокПробы = Новый СписокЗначений;
	Если КоличествоАргументовПробы = 0 Тогда
		ВыражениеДобавленияПробы = "СписокПробы.Add()";
	ИначеЕсли КоличествоАргументовПробы = 1 Тогда
		ВыражениеДобавленияПробы = "СписокПробы.Add(""x"")";
	ИначеЕсли КоличествоАргументовПробы = 2 Тогда
		ВыражениеДобавленияПробы = "СписокПробы.Add(""x"", ""X"")";
	ИначеЕсли КоличествоАргументовПробы = 3 Тогда
		ВыражениеДобавленияПробы = "СписокПробы.Add(""x"", ""X"", Истина)";
	Иначе
		ВыражениеДобавленияПробы = "СписокПробы.Add(""x"", ""X"", Истина, Неопределено)";
	КонецЕсли;
	Попытка
		ЭлементДобавленияПробы = Вычислить(ВыражениеДобавленияПробы);
		ИтогДобавленияПробы = "ok|alias=" + Строка(ЭлементДобавленияПробы = СписокПробы[0])
			+ "|mark=" + Строка(ЭлементДобавленияПробы.Пометка)
			+ "|picture=" + Строка(ЭлементДобавленияПробы.Картинка);
	Исключение
		ИтогДобавленияПробы = "error";
	КонецПопытки;
	Сообщить("add." + Строка(КоличествоАргументовПробы) + Символ(9)
		+ ИтогДобавленияПробы + "|list=" + СнимокСпискаПробы(СписокПробы));
КонецЦикла;
ПробаВыраженияСписка("add.extra", "СписокПробы.Add(1, 2, 3, 4, 5)", Истина);

// Копия независима как список; тождество элементов проверяется отдельно.
СписокПробы = НовыйСписокПробы();
КопияПробы = СписокПробы.Скопировать();
ЭлементПробы = СписокПробы[1];
Сообщить("copy.ru" + Символ(9) + Строка(КопияПробы = СписокПробы)
	+ "|item_alias=" + Строка(КопияПробы[1] = ЭлементПробы)
	+ "|list=" + СнимокСпискаПробы(КопияПробы));
КопияПробы.Удалить(КопияПробы[0]);
Сообщить("copy.independent" + Символ(9) + СнимокСпискаПробы(СписокПробы)
	+ "|copy=" + СнимокСпискаПробы(КопияПробы));
СписокПробы = НовыйСписокПробы();
КопияПробы = СписокПробы.Copy();
Сообщить("copy.en" + Символ(9) + СнимокСпискаПробы(КопияПробы));
ПробаВыраженияСписка("copy.extra", "СписокПробы.Copy(1)", Истина);

Сообщить("file.end" + Символ(9) + "notification-value-list-methods-client-1");

Попытка
	Выполнить("ЗавершитьРаботуСистемы(Ложь)");
Исключение
КонецПопытки;
