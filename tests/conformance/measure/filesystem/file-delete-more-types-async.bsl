// Дополнительные типы маски асинхронного удаления. Каждый случай ограничен
// собственным временным деревом. Локале-зависимая дата проверяет принятие
// типа на контрольном имени, остальные значения — фактическое совпадение.

Асинх Функция ПробаДополнительногоТипаУдаленияАсинх(ИдПробы, ЗначениеМаски, ПрямоеСовпадение = Истина)
	КореньПробы = "";
	ПредставлениеМаски = Строка(ЗначениеМаски);
	ПредставлениеБезопасно = ПрямоеСовпадение
		И ПредставлениеМаски <> ""
		И СтрНайти(ПредставлениеМаски, "/") = 0
		И СтрНайти(ПредставлениеМаски, "\") = 0;
	Попытка
		КореньПробы = ПолучитьИмяВременногоФайла(".delete-more-types-async");
		СоздатьКаталог(КореньПробы + "/data");
		ИмяФайлаПробы = ?(ПредставлениеБезопасно, ПредставлениеМаски, "keep.bin");
		ПутьФайлаПробы = КореньПробы + "/data/" + ИмяФайлаПробы;
		ДанныеПробы = ПолучитьДвоичныеДанныеИзСтроки("x", КодировкаТекста.UTF8, Ложь);
		ДанныеПробы.Записать(ПутьФайлаПробы);
		Попытка
			ОбещаниеПробы = УдалитьФайлыАсинх(КореньПробы + "/data", ЗначениеМаски);
			РезультатПробы = Ждать ОбещаниеПробы;
			ИтогПробы = "ok:" + ?(РезультатПробы = Неопределено, "undefined", "other");
		Исключение
			ИтогПробы = "error";
		КонецПопытки;
		КаталогПробы = Новый Файл(КореньПробы + "/data");
		ФайлПробы = Новый Файл(ПутьФайлаПробы);
		Сообщить(ИдПробы + Символ(9)
			+ "safe=" + ?(ПредставлениеБезопасно, "1", "0")
			+ "|result=" + ИтогПробы
			+ "|root=" + ?(КаталогПробы.Существует(), "1", "0")
			+ "|file=" + ?(ФайлПробы.Существует(), "1", "0"));
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдПробы + ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньПробы <> "" Тогда
		Попытка
			УдалитьФайлы(КореньПробы);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдПробы);
		КонецПопытки;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Асинх Процедура ИзмеритьДополнительныеТипыУдаленияАсинх()
	Сообщить("file.begin" + Символ(9) + "delete-more-types-async-1");
	Попытка
		Сообщить("context.effective" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
	Исключение
		Сообщить("context.effective_unavailable" + Символ(9) + "error");
	КонецПопытки;
	Ждать ПробаДополнительногоТипаУдаленияАсинх("delete.async.date", Дата(2020, 1, 15, 12, 34, 56), Ложь);
	Ждать ПробаДополнительногоТипаУдаленияАсинх("delete.async.map", Новый Соответствие);
	Ждать ПробаДополнительногоТипаУдаленияАсинх("delete.async.fixed_array", Новый ФиксированныйМассив(Новый Массив));
	Ждать ПробаДополнительногоТипаУдаленияАсинх("delete.async.fixed_structure", Новый ФиксированнаяСтруктура(Новый Структура));
	Ждать ПробаДополнительногоТипаУдаленияАсинх("delete.async.value_table", Вычислить("Новый ТаблицаЗначений"));
	Ждать ПробаДополнительногоТипаУдаленияАсинх("delete.async.uuid", Новый УникальныйИдентификатор("00112233-4455-6677-8899-aabbccddeeff"));
	Ждать ПробаДополнительногоТипаУдаленияАсинх("delete.async.file", Новый Файл("inside"));
	Ждать ПробаДополнительногоТипаУдаленияАсинх("delete.async.binary", ПолучитьДвоичныеДанныеИзСтроки("AB", КодировкаТекста.UTF8, Ложь));
	Ждать ПробаДополнительногоТипаУдаленияАсинх("delete.async.enum", КодировкаТекста.UTF8);
	Ждать ПробаДополнительногоТипаУдаленияАсинх("delete.async.type", Тип("Строка"));
	Сообщить("file.end" + Символ(9) + "delete-more-types-async-1");
	Попытка
		Выполнить("ЗавершитьРаботуСистемы(Ложь);");
	Исключение
	КонецПопытки;
КонецПроцедуры

ИзмеритьДополнительныеТипыУдаленияАсинх();
