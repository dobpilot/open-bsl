Функция ОписаниеОшибкиПробы(СведенияОбОшибкеПробы)
	ТекстОшибкиПробы = СведенияОбОшибкеПробы.Описание;
	Пока СведенияОбОшибкеПробы.Причина <> Неопределено Цикл
		СведенияОбОшибкеПробы = СведенияОбОшибкеПробы.Причина;
		ТекстОшибкиПробы = ТекстОшибкиПробы + "|cause=" + СведенияОбОшибкеПробы.Описание;
	КонецЦикла;
	Возврат ТекстОшибкиПробы;
КонецФункции

Функция СнимокСвойстваОписания(ОписаниеПробы, ИмяСвойстваПробы)
	Попытка
		ЗначениеСвойстваПробы = Вычислить("ОписаниеПробы." + ИмяСвойстваПробы);
		Если ЗначениеСвойстваПробы = Неопределено Тогда
			Возврат "undefined";
		ИначеЕсли ТипЗнч(ЗначениеСвойстваПробы) = Тип("Строка") Тогда
			Возврат "string:" + ЗначениеСвойстваПробы;
		ИначеЕсли ТипЗнч(ЗначениеСвойстваПробы) = Тип("Число") Тогда
			Возврат "number:" + Строка(ЗначениеСвойстваПробы);
		Иначе
			Возврат "type:" + Строка(ТипЗнч(ЗначениеСвойстваПробы));
		КонецЕсли;
	Исключение
		Возврат "error:" + ОписаниеОшибкиПробы(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Процедура ПробаКонструктораОписания(ИдОписания, ВыражениеОписания)
	Попытка
		ДанныеОписания = Новый Структура("Счетчик", 1);
		ОписаниеПробы = Вычислить(ВыражениеОписания);
		Сообщить(ИдОписания + Символ(9) + "ok|" + СнимокСвойстваОписания(ОписаниеПробы, "ИмяПроцедуры")
			+ "|" + СнимокСвойстваОписания(ОписаниеПробы, "Модуль")
			+ "|" + СнимокСвойстваОписания(ОписаниеПробы, "ДополнительныеПараметры")
			+ "|" + СнимокСвойстваОписания(ОписаниеПробы, "ИмяПроцедурыОбработкиОшибки")
			+ "|" + СнимокСвойстваОписания(ОписаниеПробы, "МодульОбработкиОшибки"));
	Исключение
		Сообщить(ИдОписания + Символ(9) + "error:" + ОписаниеОшибкиПробы(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

Процедура ПробаСвойстваОписания(ИмяСвойстваПробы, ЗаписьПробы, ЗначениеЗаписиПробы = Неопределено)
	Попытка
		ОписаниеПробы = Вычислить("Новый ОписаниеОповещения(""Проба"", ЭтотОбъект, 7, ""Ошибка"", ЭтотОбъект)");
		Если ЗаписьПробы Тогда
			Выполнить("ОписаниеПробы." + ИмяСвойстваПробы + " = ЗначениеЗаписиПробы;");
		КонецЕсли;
		Сообщить("property." + ИмяСвойстваПробы + ?(ЗаписьПробы, ".write", ".read") + Символ(9)
			+ СнимокСвойстваОписания(ОписаниеПробы, ИмяСвойстваПробы));
	Исключение
		Сообщить("property." + ИмяСвойстваПробы + ?(ЗаписьПробы, ".write", ".read") + Символ(9)
			+ "error:" + ОписаниеОшибкиПробы(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

