Процедура ПробаСинхронногоЗапускаКлиента(ИдПробы, ВыражениеПробы)
	КодПробы = 12345;
	Попытка
		Выполнить(ВыражениеПробы);
		Сообщить(ИдПробы + Символ(9)
			+ "ok|type=" + Строка(ТипЗнч(КодПробы))
			+ "|value=" + Строка(КодПробы));
	Исключение
		ИнформацияПробы = ИнформацияОбОшибке();
		Сообщить(ИдПробы + Символ(9)
			+ "error|type=" + Строка(ТипЗнч(КодПробы))
			+ "|value=" + Строка(КодПробы)
			+ "|" + ИнформацияПробы.Описание);
	КонецПопытки;
КонецПроцедуры

Асинх Процедура ИзмеритьСинхронныйЗапускКлиента()
	Сообщить("file.begin" + Символ(9) + "file-runapp-sync-client-1");
	ПробаСинхронногоЗапускаКлиента("runsync.true", "RunApp(""/usr/bin/true"", """", Истина, КодПробы)");
	ПробаСинхронногоЗапускаКлиента("runsync.false", "RunApp(""/usr/bin/false"", """", Истина, КодПробы)");
	ПробаСинхронногоЗапускаКлиента("runsync.no_wait", "RunApp(""/usr/bin/false"", """", Ложь, КодПробы)");
	ПробаСинхронногоЗапускаКлиента("runsync.omitted_wait", "RunApp(""/usr/bin/false"", """", , КодПробы)");
	ПробаСинхронногоЗапускаКлиента("runsync.empty", "RunApp("""", """", Истина, КодПробы)");
	ПробаСинхронногоЗапускаКлиента("runsync.missing", "RunApp(""/open-bsl-no-such-program-20260917"", """", Истина, КодПробы)");
	ПробаСинхронногоЗапускаКлиента("runsync.cwd_missing", "RunApp(""/usr/bin/true"", ""/open-bsl-no-such-cwd-20260917"", Истина, КодПробы)");
	ПробаСинхронногоЗапускаКлиента("runsync.command_undefined", "RunApp(Неопределено, """", Истина, КодПробы)");
	ПробаСинхронногоЗапускаКлиента("runsync.cwd_undefined", "RunApp(""/usr/bin/true"", Неопределено, Истина, КодПробы)");
	ПробаСинхронногоЗапускаКлиента("runsync.wait_zero", "RunApp(""/usr/bin/true"", """", 0, КодПробы)");
	ПробаСинхронногоЗапускаКлиента("runsync.quoted", "RunApp(""""""/usr/bin/false"""""", """", Истина, КодПробы)");
	ПробаСинхронногоЗапускаКлиента("runsync.shell_exit", "RunApp(""exit 17"", """", Истина, КодПробы)");
	ПробаСинхронногоЗапускаКлиента("runsync.shell_sequence", "RunApp(""/usr/bin/true ; /usr/bin/false"", """", Истина, КодПробы)");
	Сообщить("file.end" + Символ(9) + "file-runapp-sync-client-1");
	Попытка
		Выполнить("ЗавершитьРаботуСистемы(Ложь)");
	Исключение
	КонецПопытки;
КонецПроцедуры

ИзмеритьСинхронныйЗапускКлиента();
