// Серверная проба операционного пути четырёх записывающих файловых потоков.

Функция ЗаписатьПотокомКрая(ВидЗаписиКрая, ПутьЗаписиКрая)
	ПотокЗаписиКрая = Неопределено;
	Попытка
		Если ВидЗаписиКрая = "constructor.create" Тогда
			ПотокЗаписиКрая = Новый ФайловыйПоток(ПутьЗаписиКрая,
				РежимОткрытияФайла.Создать, ДоступКФайлу.Запись);
		ИначеЕсли ВидЗаписиКрая = "constructor.open" Тогда
			ПотокЗаписиКрая = Новый ФайловыйПоток(ПутьЗаписиКрая,
				РежимОткрытияФайла.ОткрытьИлиСоздать, ДоступКФайлу.Запись);
		ИначеЕсли ВидЗаписиКрая = "manager.write" Тогда
			ПотокЗаписиКрая = ФайловыеПотоки.ОткрытьДляЗаписи(ПутьЗаписиКрая);
		Иначе
			ПотокЗаписиКрая = ФайловыеПотоки.ОткрытьДляДописывания(ПутьЗаписиКрая);
		КонецЕсли;
		ДанныеЗаписиКрая = ПолучитьДвоичныеДанныеИзСтроки("Z",
			КодировкаТекста.UTF8, Ложь);
		БуферЗаписиКрая = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(
			ДанныеЗаписиКрая);
		ПотокЗаписиКрая.Записать(БуферЗаписиКрая, 0, 1);
		ПотокЗаписиКрая.Закрыть();
		Возврат "ok";
	Исключение
		Если ПотокЗаписиКрая <> Неопределено Тогда
			Попытка
				ПотокЗаписиКрая.Закрыть();
			Исключение
			КонецПопытки;
		КонецЕсли;
		Возврат "error";
	КонецПопытки;
КонецФункции

Процедура ПробаЗаписиКрая(ИдЗаписиКрая, КодСимволаЗаписиКрая,
		СимволВНачалеЗаписиКрая, ВидЗаписиКрая)
	КореньЗаписиКрая = "";
	Попытка
		КореньЗаписиКрая = ПолучитьИмяВременногоФайла(".file-write-io-edges");
		СоздатьКаталог(КореньЗаписиКрая);
		БазовыйПутьЗаписиКрая = КореньЗаписиКрая + "/leaf";
		ИсходныеДанныеЗаписиКрая = ПолучитьДвоичныеДанныеИзСтроки("ABC",
			КодировкаТекста.UTF8, Ложь);
		ИсходныеДанныеЗаписиКрая.Записать(БазовыйПутьЗаписиКрая);
		Если СимволВНачалеЗаписиКрая Тогда
			ИсходныйПутьЗаписиКрая = КореньЗаписиКрая + "/"
				+ Символ(КодСимволаЗаписиКрая) + "leaf";
		Иначе
			ИсходныйПутьЗаписиКрая = БазовыйПутьЗаписиКрая
				+ Символ(КодСимволаЗаписиКрая);
		КонецЕсли;
		СтатусЗаписиКрая = ЗаписатьПотокомКрая(ВидЗаписиКрая,
			ИсходныйПутьЗаписиКрая);
		Попытка
			БайтыЗаписиКрая = ПолучитьHexСтрокуИзДвоичныхДанных(
				Новый ДвоичныеДанные(БазовыйПутьЗаписиКрая));
		Исключение
			БайтыЗаписиКрая = "error";
		КонецПопытки;
		Сообщить(ИдЗаписиКрая + "." + ВидЗаписиКрая + Символ(9)
			+ СтатусЗаписиКрая + ":" + БайтыЗаписиКрая);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдЗаписиКрая + "."
			+ ВидЗаписиКрая + ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньЗаписиКрая <> "" Тогда
		Попытка
			УдалитьФайлы(КореньЗаписиКрая);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдЗаписиКрая + "."
				+ ВидЗаписиКрая);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-write-io-edges-1");
Для Каждого КодЗаписиКрая Из СтрРазделить("0|9|10|13|32|127|133|160|8203|65279", "|") Цикл
	Для Каждого ВидЗаписиКрая Из СтрРазделить(
		"constructor.create|constructor.open|manager.write|manager.append", "|") Цикл
		ПробаЗаписиКрая("write.suffix." + КодЗаписиКрая,
			Число(КодЗаписиКрая), Ложь, ВидЗаписиКрая);
		Если КодЗаписиКрая = "0" Тогда
			ПробаЗаписиКрая("write.prefix.0", 0, Истина, ВидЗаписиКрая);
		КонецЕсли;
	КонецЦикла;
КонецЦикла;
Сообщить("file.end" + Символ(9) + "file-write-io-edges-1");
