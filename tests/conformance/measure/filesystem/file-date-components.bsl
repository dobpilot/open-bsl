// Потребители даты с дробной частью: календарь и сериализация.
Функция ТекстДолиДаты(Знач ЗначениеДолиДаты)
    Если ТипЗнч(ЗначениеДолиДаты) = Тип("Дата") Тогда
        Возврат "Date:" + Формат(ЗначениеДолиДаты - Дата(1,1,1), "ЧГ=0;ЧРД=.;ЧН=0");
    КонецЕсли;
    Возврат СтрЗаменить(СтрЗаменить(Строка(ЗначениеДолиДаты), Символ(13), "\\r"), Символ(10), "\\n");
КонецФункции

Функция JSONДолиДаты(Знач ДатаДолиПробы)
    ПисательДолиДаты = Новый ЗаписьJSON;
    ПисательДолиДаты.УстановитьСтроку();
    ЗаписатьJSON(ПисательДолиДаты, ДатаДолиПробы);
    Возврат ПисательДолиДаты.Закрыть();
КонецФункции

Процедура ПробаДолиДаты(КлючДолиПробы, ВыражениеДолиПробы, ДатаДолиПробы)
    Попытка
        ТекстДолиПробы = ТекстДолиДаты(Вычислить(ВыражениеДолиПробы));
    Исключение
        ТекстДолиПробы = "error";
    КонецПопытки;
    Сообщить(КлючДолиПробы + Символ(9) + ТекстДолиПробы);
КонецПроцедуры

