// Строковые границы булевого аргумента файлового атрибута.
// Setter меняет только собственный файл; перед очисткой read-only снимается.

Процедура ПробаСтрокиАтрибута(ФайлСтрокиАтрибута, ИдСтрокиАтрибута, ЗначениеСтрокиАтрибута)
	Для НачальноеСтрокиАтрибута = 0 По 1 Цикл
		ФайлСтрокиАтрибута.УстановитьТолькоЧтение(НачальноеСтрокиАтрибута = 1);
		Попытка
			ФайлСтрокиАтрибута.SetReadOnly(ЗначениеСтрокиАтрибута);
			ИтогСтрокиАтрибута = "ok";
		Исключение
			ИтогСтрокиАтрибута = "error";
		КонецПопытки;
		Сообщить("attribute.string." + ИдСтрокиАтрибута + "." + Строка(НачальноеСтрокиАтрибута)
			+ Символ(9) + ИтогСтрокиАтрибута + "|readonly="
			+ ?(ФайлСтрокиАтрибута.ПолучитьТолькоЧтение(), "1", "0"));
	КонецЦикла;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-attribute-string-edges-1");
Попытка
	Сообщить("context.effective" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
Исключение
	Сообщить("context.effective_unavailable" + Символ(9) + "error");
КонецПопытки;
КореньСтрокиАтрибута = ПолучитьИмяВременногоФайла(".attribute-string-edges");
Попытка
	СоздатьКаталог(КореньСтрокиАтрибута);
	ДанныеСтрокиАтрибута = ПолучитьДвоичныеДанныеИзСтроки("abc", КодировкаТекста.UTF8, Ложь);
	ДанныеСтрокиАтрибута.Записать(КореньСтрокиАтрибута + "/data");
	ФайлСтрокиАтрибута = Новый Файл(КореньСтрокиАтрибута + "/data");
	ПробаСтрокиАтрибута(ФайлСтрокиАтрибута, "lower_ru_true", "истина");
	ПробаСтрокиАтрибута(ФайлСтрокиАтрибута, "upper_ru_false", "ЛОЖЬ");
	ПробаСтрокиАтрибута(ФайлСтрокиАтрибута, "lower_en_true", "true");
	ПробаСтрокиАтрибута(ФайлСтрокиАтрибута, "upper_en_false", "FALSE");
	ПробаСтрокиАтрибута(ФайлСтрокиАтрибута, "cr", Символ(13) + "True" + Символ(13));
	ПробаСтрокиАтрибута(ФайлСтрокиАтрибута, "lf", Символ(10) + "False" + Символ(10));
	ПробаСтрокиАтрибута(ФайлСтрокиАтрибута, "vt", Символ(11) + "True" + Символ(11));
	ПробаСтрокиАтрибута(ФайлСтрокиАтрибута, "ff", Символ(12) + "False" + Символ(12));
	ПробаСтрокиАтрибута(ФайлСтрокиАтрибута, "u001c", Символ(28) + "True" + Символ(28));
	ПробаСтрокиАтрибута(ФайлСтрокиАтрибута, "u001d", Символ(29) + "False" + Символ(29));
	ПробаСтрокиАтрибута(ФайлСтрокиАтрибута, "u001e", Символ(30) + "True" + Символ(30));
	ПробаСтрокиАтрибута(ФайлСтрокиАтрибута, "u001f", Символ(31) + "False" + Символ(31));
	ПробаСтрокиАтрибута(ФайлСтрокиАтрибута, "u0085", Символ(133) + "True" + Символ(133));
	ПробаСтрокиАтрибута(ФайлСтрокиАтрибута, "nbsp", Символ(160) + "False" + Символ(160));
	ПробаСтрокиАтрибута(ФайлСтрокиАтрибута, "u2028", Символ(8232) + "True" + Символ(8232));
	ПробаСтрокиАтрибута(ФайлСтрокиАтрибута, "u2029", Символ(8233) + "False" + Символ(8233));
	ПробаСтрокиАтрибута(ФайлСтрокиАтрибута, "u200b", Символ(8203) + "True" + Символ(8203));
	ПробаСтрокиАтрибута(ФайлСтрокиАтрибута, "yes", "yes");
	ПробаСтрокиАтрибута(ФайлСтрокиАтрибута, "no", "no");
Исключение
	Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Попытка
	ФайлСтрокиАтрибута.УстановитьТолькоЧтение(Ложь);
	УдалитьФайлы(КореньСтрокиАтрибута);
Исключение
	Сообщить("file.cleanup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Сообщить("file.end" + Символ(9) + "file-attribute-string-edges-1");
