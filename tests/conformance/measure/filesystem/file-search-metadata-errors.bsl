// Только чтение из отдельного host-дерева с заранее подготовленными ошибками.
Процедура ПробаОшибокМетаданных(ИдПробы, КореньПробы, ДеревоПробы, МаскаПробы, РекурсияПробы, АнглийскийВызов)
	Попытка
		ПутьПробы = КореньПробы + "/" + ДеревоПробы;
		Если АнглийскийВызов Тогда
			РезультатПробы = FindFiles(ПутьПробы, МаскаПробы, РекурсияПробы);
		Иначе
			РезультатПробы = НайтиФайлы(ПутьПробы, МаскаПробы, РекурсияПробы);
		КонецЕсли;
		ТекстПробы = "ok|count=" + Строка(РезультатПробы.Количество());
		Для Каждого ЭлементПробы Из РезультатПробы Цикл
			ТекстПробы = ТекстПробы + "|" + СтрЗаменить(ЭлементПробы.ПолноеИмя, КореньПробы, "<root>");
		КонецЦикла;
		Сообщить(ИдПробы + Символ(9) + ТекстПробы);
	Исключение
		Сообщить(ИдПробы + Символ(9) + "error");
	КонецПопытки;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-search-metadata-errors-1");
Попытка
	Сообщить("context.compatibility" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
Исключение
	Сообщить("context.compatibility" + Символ(9) + "unavailable");
КонецПопытки;

КореньОшибокМетаданных = "/tmp/open-bsl-find-metadata-errors-N4xK8c";
Для Каждого ДеревоОшибокМетаданных Из СтрРазделить("permission|loop", "|") Цикл
	Для Каждого МаскаОшибокМетаданных Из СтрРазделить("*|*.txt|error*", "|") Цикл
		Для РежимОшибокМетаданных = 0 По 3 Цикл
			РекурсияОшибокМетаданных = РежимОшибокМетаданных >= 2;
			АнглийскийОшибокМетаданных = РежимОшибокМетаданных % 2 = 1;
			ИдОшибокМетаданных = "metadata." + ДеревоОшибокМетаданных + "." + МаскаОшибокМетаданных
				+ ?(РекурсияОшибокМетаданных, ".recursive", ".flat")
				+ ?(АнглийскийОшибокМетаданных, ".en", ".ru");
			ПробаОшибокМетаданных(
				ИдОшибокМетаданных,
				КореньОшибокМетаданных,
				ДеревоОшибокМетаданных,
				МаскаОшибокМетаданных,
				РекурсияОшибокМетаданных,
				АнглийскийОшибокМетаданных);
		КонецЦикла;
	КонецЦикла;
КонецЦикла;
Сообщить("file.end" + Символ(9) + "file-search-metadata-errors-1");
