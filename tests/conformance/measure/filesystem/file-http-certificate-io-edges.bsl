// Серверная проба операционного пути файловых TLS-сертификатов.

Функция ОткрытьСертификатКрая(ИсходныйПутьСертификатаКрая, ВидСертификатаКрая)
	Попытка
		Если ВидСертификатаКрая = "roots" Тогда
			ОбъектСертификатаКрая = Новый СертификатыУдостоверяющихЦентровФайл(
				ИсходныйПутьСертификатаКрая);
		Иначе
			ОбъектСертификатаКрая = Новый СертификатКлиентаФайл(
				ИсходныйПутьСертификатаКрая, "");
		КонецЕсли;
		Возврат ?(ОбъектСертификатаКрая = Неопределено, "undefined", "ok");
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

Процедура ПробаСертификатаКрая(ИдСертификатаКрая, КодСимволаСертификатаКрая, ВидСертификатаКрая)
	КореньСертификатаКрая = "";
	Попытка
		КореньСертификатаКрая = ПолучитьИмяВременногоФайла(".file-http-cert-io-edges");
		СоздатьКаталог(КореньСертификатаКрая);
		БазовыйПутьСертификатаКрая = КореньСертификатаКрая + "/leaf.pem";
		ДанныеСертификатаКрая = ПолучитьДвоичныеДанныеИзСтроки(
			"not a certificate", КодировкаТекста.UTF8, Ложь);
		ДанныеСертификатаКрая.Записать(БазовыйПутьСертификатаКрая);
		ИсходныйПутьСертификатаКрая = БазовыйПутьСертификатаКрая
			+ Символ(КодСимволаСертификатаКрая);
		Сообщить(ИдСертификатаКрая + "." + ВидСертификатаКрая + Символ(9)
			+ ОткрытьСертификатКрая(ИсходныйПутьСертификатаКрая, ВидСертификатаКрая));
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдСертификатаКрая + "." + ВидСертификатаКрая);
	КонецПопытки;
	Если КореньСертификатаКрая <> "" Тогда
		Попытка
			УдалитьФайлы(КореньСертификатаКрая);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдСертификатаКрая + "." + ВидСертификатаКрая);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-http-certificate-io-edges-1");
Для Каждого КодСертификатаКрая Из СтрРазделить("0|9|10|13|32|127|133|160|8203|65279", "|") Цикл
	Для Каждого ВидСертификатаКрая Из СтрРазделить("roots|client", "|") Цикл
		ПробаСертификатаКрая("cert.suffix." + КодСертификатаКрая,
			Число(КодСертификатаКрая), ВидСертификатаКрая);
	КонецЦикла;
КонецЦикла;
Сообщить("file.end" + Символ(9) + "file-http-certificate-io-edges-1");
