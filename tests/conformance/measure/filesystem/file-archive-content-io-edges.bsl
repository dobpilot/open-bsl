// Серверная проба путей Добавить и ИзвлечьВсе ZIP-архива.

Процедура ПробаСодержимогоАрхиваКрая(ИдСодержимогоАрхиваКрая,
		КодСимволаСодержимогоАрхиваКрая, ВидСодержимогоАрхиваКрая)
	КореньСодержимогоАрхиваКрая = "";
	Попытка
		КореньСодержимогоАрхиваКрая = ПолучитьИмяВременногоФайла(
			".file-archive-content-io-edges");
		СоздатьКаталог(КореньСодержимогоАрхиваКрая);
		ПутьФайлаСодержимогоАрхиваКрая = КореньСодержимогоАрхиваКрая + "/source.txt";
		ДанныеФайлаСодержимогоАрхиваКрая = ПолучитьДвоичныеДанныеИзСтроки(
			"1", КодировкаТекста.UTF8, Ложь);
		ДанныеФайлаСодержимогоАрхиваКрая.Записать(ПутьФайлаСодержимогоАрхиваКрая);
		Если ВидСодержимогоАрхиваКрая = "add" Тогда
			ПутьАрхиваСодержимогоАрхиваКрая = КореньСодержимогоАрхиваКрая + "/result.zip";
			ИсходныйПутьСодержимогоАрхиваКрая = ПутьФайлаСодержимогоАрхиваКрая
				+ Символ(КодСимволаСодержимогоАрхиваКрая);
			Попытка
				ПисательСодержимогоАрхиваКрая = Новый ЗаписьZipФайла(ПутьАрхиваСодержимогоАрхиваКрая);
				ПисательСодержимогоАрхиваКрая.Добавить(ИсходныйПутьСодержимогоАрхиваКрая);
				ПисательСодержимогоАрхиваКрая.Записать();
				ЧитательСодержимогоАрхиваКрая = Новый ЧтениеZipФайла(ПутьАрхиваСодержимогоАрхиваКрая);
				РезультатСодержимогоАрхиваКрая = "ok:"
					+ Строка(ЧитательСодержимогоАрхиваКрая.Элементы.Количество());
			Исключение
				РезультатСодержимогоАрхиваКрая = "error";
			КонецПопытки;
		Иначе
			ПутьАрхиваСодержимогоАрхиваКрая = КореньСодержимогоАрхиваКрая + "/source.zip";
			ПодготовкаСодержимогоАрхиваКрая = Новый ЗаписьZipФайла(ПутьАрхиваСодержимогоАрхиваКрая);
			ПодготовкаСодержимогоАрхиваКрая.Добавить(ПутьФайлаСодержимогоАрхиваКрая);
			ПодготовкаСодержимогоАрхиваКрая.Записать();
			БазовыйКаталогСодержимогоАрхиваКрая = КореньСодержимогоАрхиваКрая + "/out";
			ИсходныйКаталогСодержимогоАрхиваКрая = БазовыйКаталогСодержимогоАрхиваКрая
				+ Символ(КодСимволаСодержимогоАрхиваКрая);
			Попытка
				ЧитательСодержимогоАрхиваКрая = Новый ЧтениеZipФайла(ПутьАрхиваСодержимогоАрхиваКрая);
				ЧитательСодержимогоАрхиваКрая.ИзвлечьВсе(ИсходныйКаталогСодержимогоАрхиваКрая);
				БазовыйФайлРезультатаСодержимогоАрхиваКрая = Новый Файл(
					БазовыйКаталогСодержимогоАрхиваКрая + "/source.txt");
				РезультатСодержимогоАрхиваКрая = "ok:"
					+ ?(БазовыйФайлРезультатаСодержимогоАрхиваКрая.Существует(), "base", "other");
			Исключение
				РезультатСодержимогоАрхиваКрая = "error";
			КонецПопытки;
		КонецЕсли;
		Сообщить(ИдСодержимогоАрхиваКрая + "." + ВидСодержимогоАрхиваКрая
			+ Символ(9) + РезультатСодержимогоАрхиваКрая);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдСодержимогоАрхиваКрая + "."
			+ ВидСодержимогоАрхиваКрая + ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньСодержимогоАрхиваКрая <> "" Тогда
		Попытка
			УдалитьФайлы(КореньСодержимогоАрхиваКрая);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдСодержимогоАрхиваКрая + "."
				+ ВидСодержимогоАрхиваКрая);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-archive-content-io-edges-1");
Для Каждого КодСодержимогоАрхиваКрая Из СтрРазделить(
		"0|9|10|13|32|127|133|160|8203|65279", "|") Цикл
	Для Каждого ВидСодержимогоАрхиваКрая Из СтрРазделить("add|extract", "|") Цикл
		ПробаСодержимогоАрхиваКрая("archive-content.suffix." + КодСодержимогоАрхиваКрая,
			Число(КодСодержимогоАрхиваКрая), ВидСодержимогоАрхиваКрая);
	КонецЦикла;
КонецЦикла;
Сообщить("file.end" + Символ(9) + "file-archive-content-io-edges-1");
