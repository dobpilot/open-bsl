// Нужен внешний наблюдатель с ack-файлами; ожидание каждой фазы ограничено 5 с.
Процедура ФазаНосителя(ИдентификаторФазы, КаталогНаблюдения)
	Сообщить("native.phase" + Символ(9) + ИдентификаторФазы);
	ПодтверждениеНосителя = Новый Файл(КаталогНаблюдения + "/ack-" + ИдентификаторФазы);
	ПределОжиданияНосителя = ТекущаяУниверсальнаяДатаВМиллисекундах() + 5000;
	Пока Не ПодтверждениеНосителя.Существует() Цикл
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() > ПределОжиданияНосителя Тогда
			ВызватьИсключение "Нет подтверждения внешнего наблюдателя";
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ПробаНативногоНосителя(ПрефиксФазы, КаталогНаблюдения, ВыражениеСоздания, ГраницаНосителя)
	НативныйПотокПробы = Неопределено;
	Попытка
		ФазаНосителя(ПрефиксФазы + "0", КаталогНаблюдения);
		НативныйПотокПробы = Вычислить(ВыражениеСоздания);
		ФазаНосителя(ПрефиксФазы + "1", КаталогНаблюдения);
		БуферНативнойПробы = Новый БуферДвоичныхДанных(ГраницаНосителя + 1);
		БуферНативнойПробы[0] = 65;
		БуферНативнойПробы[ГраницаНосителя] = 90;
		НативныйПотокПробы.Записать(БуферНативнойПробы, 0, ГраницаНосителя);
		ФазаНосителя(ПрефиксФазы + "2", КаталогНаблюдения);
		НативныйПотокПробы.Записать(БуферНативнойПробы, ГраницаНосителя, 1);
		ФазаНосителя(ПрефиксФазы + "3", КаталогНаблюдения);
		Сообщить("native.name" + Символ(9) + ПрефиксФазы + Символ(9) + Вычислить("НативныйПотокПробы.ИмяФайла"));
		ФазаНосителя(ПрефиксФазы + "4", КаталогНаблюдения);
		НативныйПотокПробы.Закрыть();
		ФазаНосителя(ПрефиксФазы + "5", КаталогНаблюдения);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ПрефиксФазы + ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если НативныйПотокПробы <> Неопределено Тогда
		Попытка
			НативныйПотокПробы.Закрыть();
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

КаталогНативногоНаблюдения = "__OPEN_BSL_OBSERVER_ROOT__";
Сообщить("file.begin" + Символ(9) + "temp-native-1");
ПробаНативногоНосителя("a", КаталогНативногоНаблюдения, "ФайловыеПотоки.СоздатьВременныйФайл()", 65535);
ПробаНативногоНосителя("b", КаталогНативногоНаблюдения, "ФайловыеПотоки.СоздатьВременныйФайл(8)", 8);
ПробаНативногоНосителя("c", КаталогНативногоНаблюдения, "ФайловыеПотоки.СоздатьВременныйФайл(8, 0)", 8);
Сообщить("file.end" + Символ(9) + "temp-native-1");
