// Каждый случай удаляет только собственное дерево, выданное временным именем.
Процедура ПробаУдаления(ИдентификаторУдаления, КомандаУдаления, ТолькоЧтениеУдаления)
	КореньУдаления = "";
	Попытка
		КореньУдаления = ПолучитьИмяВременногоФайла(".deleteprobe");
		СоздатьКаталог(КореньУдаления + "/data/branch.txt");
		СоздатьКаталог(КореньУдаления + "/data/stay");
		ДанныеУдаления = ПолучитьДвоичныеДанныеИзСтроки("x", КодировкаТекста.UTF8, Ложь);
		Для Каждого ИмяСозданияУдаления Из СтрРазделить("a.txt|b.bin|ro.txt|branch.txt/deep.bin|stay/deep.txt", "|") Цикл
			ДанныеУдаления.Записать(КореньУдаления + "/data/" + ИмяСозданияУдаления);
		КонецЦикла;
		Если ТолькоЧтениеУдаления Тогда
			ФайлАтрибутаУдаления = Новый Файл(КореньУдаления + "/data/ro.txt");
			ФайлАтрибутаУдаления.УстановитьТолькоЧтение(Истина);
		КонецЕсли;
		Попытка
			Выполнить(КомандаУдаления);
			ТекстУдаления = "ok";
		Исключение
			ТекстУдаления = "error:" + ИнформацияОбОшибке().Описание;
		КонецПопытки;
		Для Каждого ИмяПроверкиУдаления Из СтрРазделить("data|data/a.txt|data/b.bin|data/ro.txt|data/branch.txt|data/branch.txt/deep.bin|data/stay/deep.txt", "|") Цикл
			ФайлПроверкиУдаления = Новый Файл(КореньУдаления + "/" + ИмяПроверкиУдаления);
			Если ФайлПроверкиУдаления.Существует() Тогда
				ТекстУдаления = ТекстУдаления + "|1";
			Иначе
				ТекстУдаления = ТекстУдаления + "|0";
			КонецЕсли;
		КонецЦикла;
		Сообщить(ИдентификаторУдаления + Символ(9) + ТекстУдаления);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдентификаторУдаления + ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньУдаления <> "" Тогда
		Попытка
			ФайлОчисткиУдаления = Новый Файл(КореньУдаления + "/data/ro.txt");
			Если ФайлОчисткиУдаления.Существует() Тогда
				ФайлОчисткиУдаления.УстановитьТолькоЧтение(Ложь);
			КонецЕсли;
			УдалитьФайлы(КореньУдаления);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдентификаторУдаления + ":" + ИнформацияОбОшибке().Описание);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "delete-masks-1");
ПробаУдаления("delete.mask.txt", "УдалитьФайлы(КореньУдаления + ""/data"", ""*.txt"");", Ложь);
ПробаУдаления("delete.mask.star", "УдалитьФайлы(КореньУдаления + ""/data"", ""*"");", Ложь);
ПробаУдаления("delete.mask.empty", "УдалитьФайлы(КореньУдаления + ""/data"", """");", Ложь);
ПробаУдаления("delete.mask.undefined", "УдалитьФайлы(КореньУдаления + ""/data"", Неопределено);", Ложь);
ПробаУдаления("delete.mask.missing", "УдалитьФайлы(КореньУдаления + ""/missing"", ""*"");", Ложь);
ПробаУдаления("delete.mask.file", "УдалитьФайлы(КореньУдаления + ""/data/a.txt"", ""*"");", Ложь);
ПробаУдаления("delete.readonly.file", "УдалитьФайлы(КореньУдаления + ""/data/ro.txt"");", Истина);
ПробаУдаления("delete.readonly.mask", "УдалитьФайлы(КореньУдаления + ""/data"", ""ro.txt"");", Истина);
ПробаУдаления("delete.readonly.tree", "УдалитьФайлы(КореньУдаления + ""/data"");", Истина);
Сообщить("file.end" + Символ(9) + "delete-masks-1");
