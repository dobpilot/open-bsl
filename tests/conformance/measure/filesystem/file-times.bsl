// Серверные пробы времени Файл. Изменяется только собственное временное дерево.
// Динамические вызовы позволяют тому же измерителю работать до реализации API.

Процедура ВывестиПробуВремени(ИдентификаторПробы, ТекстПробы)
	Сообщить(ИдентификаторПробы + Символ(9) + ТекстПробы);
КонецПроцедуры

Процедура ПроверитьКонтекстВремени(ИдентификаторПробы, ВыражениеПробы)
	Попытка
		ТекстПробы = Строка(Вычислить(ВыражениеПробы));
	Исключение
		ТекстПробы = "error:" + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	ВывестиПробуВремени(ИдентификаторПробы, ТекстПробы);
КонецПроцедуры

Процедура ПроверитьВремяФайла(ИдентификаторПробы, ПутьПробы, КомандаПробы)
	Попытка
		ОбъектПробы = Вычислить("Новый Файл(ПутьПробы)");
		Выполнить(КомандаПробы);
		ВывестиПробуВремени(ИдентификаторПробы + ".set", "ok");
	Исключение
		ВывестиПробуВремени(ИдентификаторПробы + ".set", "error:" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Попытка
		ДатаПробы = Вычислить("ОбъектПробы.ПолучитьВремяИзменения()");
		ВывестиПробуВремени(ИдентификаторПробы + ".local", Формат(ДатаПробы, "ДФ=yyyy-MM-dd HH:mm:ss"));
	Исключение
		ВывестиПробуВремени(ИдентификаторПробы + ".local", "error:" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Попытка
		ДатаПробы = Вычислить("ОбъектПробы.ПолучитьУниверсальноеВремяИзменения()");
		ВывестиПробуВремени(ИдентификаторПробы + ".utc", Формат(ДатаПробы, "ДФ=yyyy-MM-dd HH:mm:ss"));
	Исключение
		ВывестиПробуВремени(ИдентификаторПробы + ".utc", "error:" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецПроцедуры

ВывестиПробуВремени("file.begin", "1");
ПроверитьКонтекстВремени("context.zone", "ЧасовойПоясСеанса()");
ПроверитьКонтекстВремени("context.compatibility", "Метаданные.РежимСовместимости");
КореньВременнойПробы = "";
Попытка
	КореньВременнойПробы = ПолучитьИмяВременногоФайла(".times");
	Выполнить("СоздатьКаталог(КореньВременнойПробы);");
	ВывестиПробуВремени("file.scratch", КореньВременнойПробы);
	ПутьВременнойПробы = КореньВременнойПробы + ПолучитьРазделительПути() + "probe.bin";
	ДанныеВременнойПробы = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
	ДанныеВременнойПробы.Записать(ПутьВременнойПробы);
	ПроверитьВремяФайла("local.summer", ПутьВременнойПробы, "ОбъектПробы.УстановитьВремяИзменения(Дата(2020, 7, 15, 12, 34, 56));");
	ПроверитьВремяФайла("local.winter", ПутьВременнойПробы, "ОбъектПробы.УстановитьВремяИзменения(Дата(2020, 1, 15, 12, 34, 56));");
	ПроверитьВремяФайла("utc.summer", ПутьВременнойПробы, "ОбъектПробы.УстановитьУниверсальноеВремяИзменения(Дата(2020, 7, 15, 12, 34, 56));");
	ПроверитьВремяФайла("utc.winter", ПутьВременнойПробы, "ОбъектПробы.УстановитьУниверсальноеВремяИзменения(Дата(2020, 1, 15, 12, 34, 56));");
	ПроверитьВремяФайла("utc.1960", ПутьВременнойПробы, "ОбъектПробы.УстановитьУниверсальноеВремяИзменения(Дата(1960, 1, 15, 12, 34, 56));");
	ПроверитьВремяФайла("utc.1900", ПутьВременнойПробы, "ОбъектПробы.УстановитьУниверсальноеВремяИзменения(Дата(1900, 1, 15, 12, 34, 56));");
	ПроверитьВремяФайла("utc.minimum", ПутьВременнойПробы, "ОбъектПробы.УстановитьУниверсальноеВремяИзменения(Дата(1, 1, 1));");
	ПроверитьВремяФайла("utc.maximum", ПутьВременнойПробы, "ОбъектПробы.УстановитьУниверсальноеВремяИзменения(Дата(9999, 12, 31, 23, 59, 59));");
	ПроверитьВремяФайла("utc.reset", ПутьВременнойПробы, "ОбъектПробы.УстановитьУниверсальноеВремяИзменения(Дата(2020, 1, 15, 12, 34, 56));");
	ПроверитьВремяФайла("utc.undefined", ПутьВременнойПробы, "ОбъектПробы.УстановитьУниверсальноеВремяИзменения(Неопределено);");
	ПроверитьВремяФайла("utc.number", ПутьВременнойПробы, "ОбъектПробы.УстановитьУниверсальноеВремяИзменения(17);");
	ПроверитьВремяФайла("utc.string", ПутьВременнойПробы, "ОбъектПробы.УстановитьУниверсальноеВремяИзменения(""20200115123456"");");
	ПроверитьВремяФайла("utc.result", ПутьВременнойПробы, "РезультатПробы = ОбъектПробы.УстановитьУниверсальноеВремяИзменения(Дата(2020, 1, 15, 12, 34, 56));");
	ПроверитьВремяФайла("directory.utc", КореньВременнойПробы, "ОбъектПробы.УстановитьУниверсальноеВремяИзменения(Дата(2020, 1, 15, 12, 34, 56));");
	ПроверитьВремяФайла("missing.utc", ПутьВременнойПробы + ".missing", "ОбъектПробы.УстановитьУниверсальноеВремяИзменения(Дата(2020, 1, 15, 12, 34, 56));");
Исключение
	ВывестиПробуВремени("file.setup_error", ИнформацияОбОшибке().Описание);
КонецПопытки;
Если КореньВременнойПробы <> "" Тогда
	Попытка
		УдалитьФайлы(КореньВременнойПробы);
		ВывестиПробуВремени("file.cleanup", "ok");
	Исключение
		ВывестиПробуВремени("file.cleanup_error", ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецЕсли;
ВывестиПробуВремени("file.end", "1");
