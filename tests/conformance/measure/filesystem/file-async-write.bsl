// Клиентская запись атрибутов и инициализация Файл; собственное временное дерево.
Асинх Функция ПробаЗаписиАсинх(ИдЗаписи, ПутьЗаписи, ВызовЗаписи, ЧтениеЗаписи, КореньЗаписи)
	ФайлЗаписиПробы = Новый Файл(ПутьЗаписи);
	СтадияЗаписи = "call";
	ТипОбещанияЗаписи = "none";
	Попытка
		ОбещаниеЗаписи = Вычислить("ФайлЗаписиПробы." + ВызовЗаписи);
		ТипОбещанияЗаписи = Строка(ТипЗнч(ОбещаниеЗаписи));
		СтадияЗаписи = "await";
		РезультатЗаписи = Ждать ОбещаниеЗаписи;
		СтадияЗаписи = "read";
		ЗначениеПослеЗаписи = Вычислить("ФайлЗаписиПробы." + ЧтениеЗаписи + "()");
		Если ТипЗнч(ЗначениеПослеЗаписи) = Тип("Дата") Тогда
			ТекстПослеЗаписи = Формат(ЗначениеПослеЗаписи, "ДФ=yyyyMMddHHmmss");
		Иначе
			ТекстПослеЗаписи = ?(ЗначениеПослеЗаписи, "1", "0");
		КонецЕсли;
		ВыводЗаписи = "ok|" + Строка(ТипЗнч(РезультатЗаписи)) + "|undefined=" + ?(РезультатЗаписи = Неопределено, "1", "0") + "|after=" + ТекстПослеЗаписи;
	Исключение
		ОшибкаЗаписи = ИнформацияОбОшибке();
		ВыводЗаписи = "error|stage=" + СтадияЗаписи + "|" + ОшибкаЗаписи.Описание;
		Если ОшибкаЗаписи.Причина <> Неопределено Тогда
			ВыводЗаписи = ВыводЗаписи + "|cause=" + СтрЗаменить(ОшибкаЗаписи.Причина.Описание, КореньЗаписи, "<root>");
		КонецЕсли;
	КонецПопытки;
	Сообщить(ИдЗаписи + Символ(9) + "promise=" + ТипОбещанияЗаписи + "|" + ВыводЗаписи);
	Возврат Неопределено;
КонецФункции

Асинх Функция ПробаИнициализацииАсинх(ИдИнициализации, ВызовИнициализации, КореньИнициализации)
	ИсходныйФайлПробы = Новый Файл(КореньИнициализации + "/a");
	ПсевдонимФайлаПробы = ИсходныйФайлПробы;
	СтадияИнициализации = "call";
	ТипОбещанияИнициализации = "none";
	ПослеВызоваИнициализации = "<not-called>";
	Попытка
		ОбещаниеИнициализации = Вычислить("ИсходныйФайлПробы." + ВызовИнициализации);
		ТипОбещанияИнициализации = Строка(ТипЗнч(ОбещаниеИнициализации));
		ПослеВызоваИнициализации = ИсходныйФайлПробы.ПолноеИмя;
		СтадияИнициализации = "await";
		РезультатИнициализации = Ждать ОбещаниеИнициализации;
		ВыводИнициализации = "ok|" + Строка(ТипЗнч(РезультатИнициализации)) + "|result=" + РезультатИнициализации.ПолноеИмя;
	Исключение
		ОшибкаИнициализации = ИнформацияОбОшибке();
		ВыводИнициализации = "error|stage=" + СтадияИнициализации + "|" + ОшибкаИнициализации.Описание;
		Если ОшибкаИнициализации.Причина <> Неопределено Тогда
			ВыводИнициализации = ВыводИнициализации + "|cause=" + ОшибкаИнициализации.Причина.Описание;
		КонецЕсли;
	КонецПопытки;
	ВыводИнициализации = "promise=" + ТипОбещанияИнициализации + "|" + ВыводИнициализации + "|after_call=" + ПослеВызоваИнициализации + "|receiver=" + ИсходныйФайлПробы.ПолноеИмя + "|alias=" + ПсевдонимФайлаПробы.ПолноеИмя;
	Сообщить(ИдИнициализации + Символ(9) + СтрЗаменить(ВыводИнициализации, КореньИнициализации, "<root>"));
	Возврат Неопределено;
КонецФункции

