Перем РезультатыОписания;
Перем ФайлОписания;
Перем ПопытокОписания;

Асинх Процедура КлиентскийКонтекстОписания()
КонецПроцедуры

Процедура ЗавершитьПроверкуОписания() Экспорт
    ПопытокОписания = ПопытокОписания + 1;
    Если РезультатыОписания.Количество() = 0 И ПопытокОписания < 10 Тогда
        Возврат;
    КонецЕсли;
    Попытка Выполнить("ОтключитьОбработчикОжидания(""ЗавершитьПроверкуОписания"");"); Исключение КонецПопытки;
    Сообщить("begin.description.control" + Символ(9) + Строка(РезультатыОписания.Количество()));
    Если РезультатыОписания.Количество() = 1 Тогда
        Сообщить("begin.description.identity" + Символ(9) + Строка(РезультатыОписания[ФайлОписания]));
    КонецЕсли;
    Сообщить("file.end" + Символ(9) + "file-begin-description-1");
    Попытка Выполнить("ЗавершитьРаботуСистемы(Ложь);"); Исключение КонецПопытки;
КонецПроцедуры

Процедура ПроверитьОписаниеНачала(ИдОписания, ТекстОписания, МетодОписания)
    ФайлПробыОписания = Новый Файл("/open-bsl-begin-description-before");
    ПутьДоОписания = ФайлПробыОписания.ПолноеИмя;
    СтадияОписания = "construct";
    Попытка
        ОписаниеПробы = Вычислить(ТекстОписания);
        СтадияОписания = "call";
        Выполнить("ФайлПробыОписания." + МетодОписания + "(ОписаниеПробы, ""/open-bsl-begin-description-after"");");
        ИтогОписания = "returned";
    Исключение
        ИтогОписания = "error|" + СтадияОписания;
    КонецПопытки;
    Сообщить(ИдОписания + Символ(9) + ИтогОписания + "|changed=" + ?(ФайлПробыОписания.ПолноеИмя <> ПутьДоОписания, "1", "0"));
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-begin-description-1");
РезультатыОписания = Новый Соответствие;
ПопытокОписания = 0;
Попытка
    ПроверитьОписаниеНачала("begin.description.undefined.ru", "Неопределено", "НачатьИнициализацию");
    ПроверитьОписаниеНачала("begin.description.undefined.en", "Undefined", "BeginInitialization");
    ПроверитьОписаниеНачала("begin.description.null", "Null", "НачатьИнициализацию");
    ПроверитьОписаниеНачала("begin.description.false", "Ложь", "НачатьИнициализацию");
    ПроверитьОписаниеНачала("begin.description.zero", "0", "НачатьИнициализацию");
    ПроверитьОписаниеНачала("begin.description.empty_string", """""", "НачатьИнициализацию");
    ПроверитьОписаниеНачала("begin.description.string", """x""", "НачатьИнициализацию");
    ПроверитьОписаниеНачала("begin.description.array", "Новый Массив", "НачатьИнициализацию");
    ПроверитьОписаниеНачала("begin.description.struct", "Новый Структура", "НачатьИнициализацию");
    ПроверитьОписаниеНачала("begin.description.empty.ru", "Новый ОписаниеОповещения", "НачатьИнициализацию");
    ПроверитьОписаниеНачала("begin.description.empty.en", "Новый NotifyDescription", "BeginInitialization");
    ФайлОписания = Новый Файл("/open-bsl-begin-description-before");
    ОписаниеКонтроля = Новый ОписаниеОповещения("Вставить", РезультатыОписания, "same");
    Выполнить("ФайлОписания.НачатьИнициализацию(ОписаниеКонтроля, ""/open-bsl-begin-description-after"");");
    Сообщить("begin.description.returned" + Символ(9) + Строка(РезультатыОписания.Количество()));
Исключение
    Сообщить("begin.description.control_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Попытка
    Выполнить("ПодключитьОбработчикОжидания(""ЗавершитьПроверкуОписания"", 1);");
Исключение
    ПопытокОписания = 10;
    ЗавершитьПроверкуОписания();
КонецПопытки;
