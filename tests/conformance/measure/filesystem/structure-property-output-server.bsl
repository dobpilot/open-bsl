Процедура СообщитьРезультатСвойства(ИдПробы, СтруктураПробы, ИмяСвойства, АнглийскоеИмя)
	ВыходноеЗначениеПробы = 99;
	Если АнглийскоеИмя Тогда
		НайденоСвойствоПробы = СтруктураПробы.Property(ИмяСвойства, ВыходноеЗначениеПробы);
	Иначе
		НайденоСвойствоПробы = СтруктураПробы.Свойство(ИмяСвойства, ВыходноеЗначениеПробы);
	КонецЕсли;
	Сообщить(ИдПробы + Символ(9) + Строка(НайденоСвойствоПробы)
		+ "|value=" + Строка(ВыходноеЗначениеПробы));
КонецПроцедуры

Процедура СообщитьОшибкуАргументаСвойства(ИдПробы, ВыражениеПробы, СтруктураПробы, МассивПробы)
	Попытка
		РезультатПробы = Вычислить(ВыражениеПробы);
		Сообщить(ИдПробы + Символ(9) + "ok:" + Строка(РезультатПробы));
	Исключение
		Сообщить(ИдПробы + Символ(9) + "error");
	КонецПопытки;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "structure-property-output-1");

ОбычнаяСтруктураПробы = Новый Структура("А", 1);
СообщитьРезультатСвойства("structure.ru.found", ОбычнаяСтруктураПробы, "А", Ложь);
СообщитьРезультатСвойства("structure.ru.missing", ОбычнаяСтруктураПробы, "Нет", Ложь);
СообщитьРезультатСвойства("structure.en.found", ОбычнаяСтруктураПробы, "А", Истина);
СообщитьРезультатСвойства("structure.en.missing", ОбычнаяСтруктураПробы, "Нет", Истина);

ФиксированнаяСтруктураПробы = Новый ФиксированнаяСтруктура(ОбычнаяСтруктураПробы);
СообщитьРезультатСвойства("fixed.ru.found", ФиксированнаяСтруктураПробы, "А", Ложь);
СообщитьРезультатСвойства("fixed.ru.missing", ФиксированнаяСтруктураПробы, "Нет", Ложь);
СообщитьРезультатСвойства("fixed.en.found", ФиксированнаяСтруктураПробы, "А", Истина);
СообщитьРезультатСвойства("fixed.en.missing", ФиксированнаяСтруктураПробы, "Нет", Истина);

МассивВыходаПробы = Новый Массив;
МассивВыходаПробы.Добавить(99);
СообщитьОшибкуАргументаСвойства("structure.literal", "СтруктураПробы.Свойство(""А"", 99)", ОбычнаяСтруктураПробы, МассивВыходаПробы);
СообщитьОшибкуАргументаСвойства("structure.index", "СтруктураПробы.Свойство(""А"", МассивПробы[0])", ОбычнаяСтруктураПробы, МассивВыходаПробы);
Сообщить("structure.index.value" + Символ(9) + Строка(МассивВыходаПробы[0]));

Сообщить("file.end" + Символ(9) + "structure-property-output-1");
