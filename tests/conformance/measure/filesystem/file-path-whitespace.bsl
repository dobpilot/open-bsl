// Лексические свойства Файл, без файлового I/O и без интерпретации вывода через пробелы.
Процедура ПробаПробельногоПути(ИдПробельногоПути, ПутьПробельногоПути, БазаПробельногоПути, СохраненныйПробельныйПуть)
	Попытка
		ФайлПробельногоПути = Новый Файл(ПутьПробельногоПути);
		ИтогПробельногоПути = ФайлПробельногоПути.ПолноеИмя;
		Сообщить(ИдПробельногоПути + Символ(9)
			+ "base=" + ?(ИтогПробельногоПути = БазаПробельногоПути, "1", "0")
			+ "kept=" + ?(ИтогПробельногоПути = СохраненныйПробельныйПуть, "1", "0")
			+ "length=" + Строка(СтрДлина(ИтогПробельногоПути)));
	Исключение
		Сообщить(ИдПробельногоПути + Символ(9) + "error");
	КонецПопытки;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "path-whitespace-1");
БазаПробельнойПробы = "/tmp/probe/leaf";
Для Каждого КодТекстаПробельнойПробы Из СтрРазделить("0|1|8|9|10|11|12|13|28|29|30|31|32|127|133|160|5760|8192|8193|8194|8195|8196|8197|8198|8199|8200|8201|8202|8203|8232|8233|8239|8287|12288|65279", "|") Цикл
	СимволПробельнойПробы = Символ(Число(КодТекстаПробельнойПробы));
	ИдПробельнойПробы = "ws." + КодТекстаПробельнойПробы;
	КонецПробельнойПробы = БазаПробельнойПробы + СимволПробельнойПробы;
	НачалоПробельнойПробы = СимволПробельнойПробы + БазаПробельнойПробы;
	ВнутриПробельнойПробы = КонецПробельнойПробы + "/child";
	ПробаПробельногоПути(ИдПробельнойПробы + ".suffix", КонецПробельнойПробы, БазаПробельнойПробы, КонецПробельнойПробы);
	ПробаПробельногоПути(ИдПробельнойПробы + ".prefix", НачалоПробельнойПробы, БазаПробельнойПробы, НачалоПробельнойПробы);
	ПробаПробельногоПути(ИдПробельнойПробы + ".inside", ВнутриПробельнойПробы, БазаПробельнойПробы + "/child", ВнутриПробельнойПробы);
	ПробаПробельногоПути(ИдПробельнойПробы + ".slash", КонецПробельнойПробы + "/", БазаПробельнойПробы, КонецПробельнойПробы);
КонецЦикла;
Сообщить("file.end" + Символ(9) + "path-whitespace-1");
