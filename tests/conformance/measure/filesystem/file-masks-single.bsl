// В подготовленной копии placeholder заменяется каталогом с normal и s00..s13.
// Порядок результатов сохраняется, в выводе сокращается только scratch-префикс.
Процедура ВыводОдиночнойМаски(КодПробы, ТекстПробы)
	Сообщить(КодПробы + Символ(9) + ТекстПробы);
КонецПроцедуры

Процедура ОдиночнаяМаска(КодПробы, ПутьПробы, МаскаПробы)
	Попытка
		РезультатПробы = Вычислить("НайтиФайлы(ПутьПробы, МаскаПробы)");
		ТекстПробы = Строка(РезультатПробы.Количество());
		Для Каждого ФайлПробы Из РезультатПробы Цикл
			ТекстПробы = ТекстПробы + "|" + ФайлПробы.Имя + ":" + СтрЗаменить(ФайлПробы.ПолноеИмя, ПутьПробы + "/", "");
		КонецЦикла;
	Исключение
		ТекстПробы = "error:" + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	ВыводОдиночнойМаски(КодПробы, ТекстПробы);
КонецПроцедуры

Процедура ВсеОдиночныеМаски(КодПробы, ПутьПробы)
	ОдиночнаяМаска(КодПробы + ".01", ПутьПробы, "?");
	ОдиночнаяМаска(КодПробы + ".02", ПутьПробы, "??");
	ОдиночнаяМаска(КодПробы + ".03", ПутьПробы, "???");
	ОдиночнаяМаска(КодПробы + ".04", ПутьПробы, "????");
	ОдиночнаяМаска(КодПробы + ".05", ПутьПробы, "[a-z]");
	ОдиночнаяМаска(КодПробы + ".06", ПутьПробы, "[!a-z]");
	ОдиночнаяМаска(КодПробы + ".07", ПутьПробы, "[^a-z]");
	ОдиночнаяМаска(КодПробы + ".08", ПутьПробы, "[[:alpha:]]");
	ОдиночнаяМаска(КодПробы + ".09", ПутьПробы, "[а-я]");
	ОдиночнаяМаска(КодПробы + ".10", ПутьПробы, "[");
	ОдиночнаяМаска(КодПробы + ".11", ПутьПробы, "\?");
	ОдиночнаяМаска(КодПробы + ".12", ПутьПробы, "a\*");
	ОдиночнаяМаска(КодПробы + ".13", ПутьПробы, "a*");
	ОдиночнаяМаска(КодПробы + ".14", ПутьПробы, "*.*");
	ОдиночнаяМаска(КодПробы + ".15", ПутьПробы, "*");
	ОдиночнаяМаска(КодПробы + ".16", ПутьПробы, "[[]x]");
	ОдиночнаяМаска(КодПробы + ".17", ПутьПробы, "[a-]");
	ОдиночнаяМаска(КодПробы + ".18", ПутьПробы, "[z-a]");
	ОдиночнаяМаска(КодПробы + ".19", ПутьПробы, "[[]");
	ОдиночнаяМаска(КодПробы + ".20", ПутьПробы, "[]]");
КонецПроцедуры

ВыводОдиночнойМаски("file.begin", "1");
КореньОдиночныхМасок = "__OPEN_BSL_PROBE_ROOT__";
СвойКореньОдиночных = Лев(КореньОдиночныхМасок, 1) = "_";
Попытка
	Если СвойКореньОдиночных Тогда
		КореньОдиночныхМасок = ПолучитьИмяВременногоФайла(".singlemasks");
		Выполнить("СоздатьКаталог(КореньОдиночныхМасок);");
		ДанныеОдиночныхМасок = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
		ПутьОдиночныхМасок = КореньОдиночныхМасок + "/s00";
		Выполнить("СоздатьКаталог(ПутьОдиночныхМасок);");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/a");
		ПутьОдиночныхМасок = КореньОдиночныхМасок + "/s01";
		Выполнить("СоздатьКаталог(ПутьОдиночныхМасок);");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/Z");
		ПутьОдиночныхМасок = КореньОдиночныхМасок + "/s02";
		Выполнить("СоздатьКаталог(ПутьОдиночныхМасок);");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/1");
		ПутьОдиночныхМасок = КореньОдиночныхМасок + "/s03";
		Выполнить("СоздатьКаталог(ПутьОдиночныхМасок);");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/я");
		ПутьОдиночныхМасок = КореньОдиночныхМасок + "/s04";
		Выполнить("СоздатьКаталог(ПутьОдиночныхМасок);");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/漢");
		ПутьОдиночныхМасок = КореньОдиночныхМасок + "/s05";
		Выполнить("СоздатьКаталог(ПутьОдиночныхМасок);");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/😀");
		ПутьОдиночныхМасок = КореньОдиночныхМасок + "/s06";
		Выполнить("СоздатьКаталог(ПутьОдиночныхМасок);");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/.hidden");
		ПутьОдиночныхМасок = КореньОдиночныхМасок + "/s07";
		Выполнить("СоздатьКаталог(ПутьОдиночныхМасок);");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/a*");
		ПутьОдиночныхМасок = КореньОдиночныхМасок + "/s08";
		Выполнить("СоздатьКаталог(ПутьОдиночныхМасок);");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/a?");
		ПутьОдиночныхМасок = КореньОдиночныхМасок + "/s09";
		Выполнить("СоздатьКаталог(ПутьОдиночныхМасок);");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/a\b");
		ПутьОдиночныхМасок = КореньОдиночныхМасок + "/s10";
		Выполнить("СоздатьКаталог(ПутьОдиночныхМасок);");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/[");
		ПутьОдиночныхМасок = КореньОдиночныхМасок + "/s11";
		Выполнить("СоздатьКаталог(ПутьОдиночныхМасок);");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/[x]");
		ПутьОдиночныхМасок = КореньОдиночныхМасок + "/s12";
		Выполнить("СоздатьКаталог(ПутьОдиночныхМасок);");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/-");
		ПутьОдиночныхМасок = КореньОдиночныхМасок + "/s13";
		Выполнить("СоздатьКаталог(ПутьОдиночныхМасок);");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/]");
		ПутьОдиночныхМасок = КореньОдиночныхМасок + "/normal";
		Выполнить("СоздатьКаталог(ПутьОдиночныхМасок);");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/a");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/Z");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/1");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/я");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/漢");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/😀");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/.hidden");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/[");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/[x]");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/-");
		ДанныеОдиночныхМасок.Записать(ПутьОдиночныхМасок + "/]");
	КонецЕсли;
	ВыводОдиночнойМаски("file.scratch", КореньОдиночныхМасок);
	ВсеОдиночныеМаски("normal", КореньОдиночныхМасок + "/normal");
	ВсеОдиночныеМаски("s00", КореньОдиночныхМасок + "/s00");
	ВсеОдиночныеМаски("s01", КореньОдиночныхМасок + "/s01");
	ВсеОдиночныеМаски("s02", КореньОдиночныхМасок + "/s02");
	ВсеОдиночныеМаски("s03", КореньОдиночныхМасок + "/s03");
	ВсеОдиночныеМаски("s04", КореньОдиночныхМасок + "/s04");
	ВсеОдиночныеМаски("s05", КореньОдиночныхМасок + "/s05");
	ВсеОдиночныеМаски("s06", КореньОдиночныхМасок + "/s06");
	ВсеОдиночныеМаски("s07", КореньОдиночныхМасок + "/s07");
	ВсеОдиночныеМаски("s08", КореньОдиночныхМасок + "/s08");
	ВсеОдиночныеМаски("s09", КореньОдиночныхМасок + "/s09");
	ВсеОдиночныеМаски("s10", КореньОдиночныхМасок + "/s10");
	ВсеОдиночныеМаски("s11", КореньОдиночныхМасок + "/s11");
	ВсеОдиночныеМаски("s12", КореньОдиночныхМасок + "/s12");
	ВсеОдиночныеМаски("s13", КореньОдиночныхМасок + "/s13");
Исключение
	ВыводОдиночнойМаски("file.setup_error", ИнформацияОбОшибке().Описание);
КонецПопытки;
Если СвойКореньОдиночных Тогда
	Попытка
		УдалитьФайлы(КореньОдиночныхМасок);
		ВыводОдиночнойМаски("file.cleanup", "ok");
	Исключение
		ВыводОдиночнойМаски("file.cleanup_error", ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецЕсли;
ВыводОдиночнойМаски("file.end", "1");

