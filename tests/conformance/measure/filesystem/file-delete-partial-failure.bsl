// Частичный отказ удаления по маске. Все объекты находятся в отдельном
// временном корне; права закрытого каталога восстанавливаются до очистки.

Процедура ИзмеритьЧастичныйОтказУдаления()
	Сообщить("file.begin" + Символ(9) + "delete-partial-failure-1");
	Попытка
		Сообщить("context.effective" + Символ(9)
			+ Строка(Вычислить("Метаданные.РежимСовместимости")));
	Исключение
		Сообщить("context.effective_unavailable" + Символ(9) + "error");
	КонецПопытки;

	КореньЧастичногоУдаления = ПолучитьИмяВременногоФайла(".delete-partial-failure");
	ЗакрытыйКаталогУдаления = КореньЧастичногоУдаления + "/b-denied";
	ПраваКаталогаУдаленияСняты = Ложь;
	Попытка
		СоздатьКаталог(ЗакрытыйКаталогУдаления);
		ДанныеЧастичногоУдаления = ПолучитьДвоичныеДанныеИзСтроки("x", КодировкаТекста.UTF8, Ложь);
		ДанныеЧастичногоУдаления.Записать(КореньЧастичногоУдаления + "/a-before.txt");
		ДанныеЧастичногоУдаления.Записать(ЗакрытыйКаталогУдаления + "/inside.txt");
		ДанныеЧастичногоУдаления.Записать(КореньЧастичногоУдаления + "/c-after.txt");

		КодИзмененияПравУдаления = 0;
		ЗапуститьПриложение("/bin/chmod 000 " + ЗакрытыйКаталогУдаления,
			"/tmp", Истина, КодИзмененияПравУдаления);
		Если КодИзмененияПравУдаления <> 0 Тогда
			Сообщить("file.setup_error" + Символ(9) + "chmod-000:"
				+ Строка(КодИзмененияПравУдаления));
		Иначе
			ПраваКаталогаУдаленияСняты = Истина;
		КонецЕсли;

		Попытка
			УдалитьФайлы(КореньЧастичногоУдаления, "*");
			ИтогЧастичногоУдаления = "ok";
		Исключение
			ИтогЧастичногоУдаления = "error";
		КонецПопытки;

		КодВосстановленияПравУдаления = 0;
		ЗапуститьПриложение("/bin/chmod 700 " + ЗакрытыйКаталогУдаления,
			"/tmp", Истина, КодВосстановленияПравУдаления);
		ПраваКаталогаУдаленияСняты = Ложь;
		Если КодВосстановленияПравУдаления <> 0 Тогда
			Сообщить("file.setup_error" + Символ(9) + "chmod-700:"
				+ Строка(КодВосстановленияПравУдаления));
		КонецЕсли;

		ФайлДоОтказаУдаления = Новый Файл(КореньЧастичногоУдаления + "/a-before.txt");
		КаталогОтказаУдаления = Новый Файл(ЗакрытыйКаталогУдаления);
		ФайлПослеОтказаУдаления = Новый Файл(КореньЧастичногоУдаления + "/c-after.txt");
		Сообщить("delete.partial.result" + Символ(9) + ИтогЧастичногоУдаления
			+ "|before=" + ?(ФайлДоОтказаУдаления.Существует(), "1", "0")
			+ "|denied=" + ?(КаталогОтказаУдаления.Существует(), "1", "0")
			+ "|after=" + ?(ФайлПослеОтказаУдаления.Существует(), "1", "0"));
	Исключение
		Сообщить("file.setup_error" + Символ(9) + "delete-partial-failure:"
			+ ИнформацияОбОшибке().Описание);
	КонецПопытки;

	Если ПраваКаталогаУдаленияСняты Тогда
		Попытка
			ЗапуститьПриложение("/bin/chmod 700 " + ЗакрытыйКаталогУдаления,
				"/tmp", Истина);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + "chmod-700");
		КонецПопытки;
	КонецЕсли;
	Попытка
		ЗапуститьПриложение("/bin/rm -rf " + КореньЧастичногоУдаления,
			"/tmp", Истина);
	Исключение
		Сообщить("file.cleanup_error" + Символ(9) + "delete-partial-failure");
	КонецПопытки;
	Сообщить("file.end" + Символ(9) + "delete-partial-failure-1");
КонецПроцедуры

ИзмеритьЧастичныйОтказУдаления();
