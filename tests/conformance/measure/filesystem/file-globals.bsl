// Серверные исследовательские пробы. Неизвестные методы вызываются динамически.
// Все записи и удаления ограничены собственным scratch-каталогом.

Процедура ЗаписатьПробу(ИдентификаторПробы, ТекстПробы)
	Сообщить(ИдентификаторПробы + Символ(9) + ТекстПробы);
КонецПроцедуры

Процедура ПроверитьЗначение(ИдентификаторПробы, ВыражениеПробы)
	Попытка
		РезультатПробы = Вычислить(ВыражениеПробы);
		ТекстПробы = Строка(ТипЗнч(РезультатПробы)) + ":" + Строка(РезультатПробы);
	Исключение
		ТекстПробы = "error:" + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	ЗаписатьПробу(ИдентификаторПробы, ТекстПробы);
КонецПроцедуры

Процедура ПроверитьКоманду(ИдентификаторПробы, ПутьПробы, КомандаПробы)
	Попытка
		Выполнить(КомандаПробы);
		ТекстПробы = "ok";
	Исключение
		ТекстПробы = "error:" + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	ЗаписатьПробу(ИдентификаторПробы, ТекстПробы);
КонецПроцедуры

Процедура ПроверитьПоиск(ИдентификаторПробы, КореньПробы, ПутьПробы, ВыражениеПробы)
	Попытка
		РезультатПробы = Вычислить(ВыражениеПробы);
		ТекстПробы = Строка(ТипЗнч(РезультатПробы)) + ":" + Строка(РезультатПробы.Количество());
		Для Каждого ЭлементПробы Из РезультатПробы Цикл
			ИмяЭлементаПробы = ЭлементПробы.ПолноеИмя;
			Если ИмяЭлементаПробы = КореньПробы Тогда
				ИмяЭлементаПробы = ".";
			ИначеЕсли Лев(ИмяЭлементаПробы, СтрДлина(КореньПробы) + 1) = КореньПробы + ПолучитьРазделительПути() Тогда
				ИмяЭлементаПробы = Сред(ИмяЭлементаПробы, СтрДлина(КореньПробы) + 2);
			КонецЕсли;
			ТекстПробы = ТекстПробы + "|" + Строка(ТипЗнч(ЭлементПробы)) + ":" + ИмяЭлементаПробы;
		КонецЦикла;
	Исключение
		ТекстПробы = "error:" + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	ЗаписатьПробу(ИдентификаторПробы, ТекстПробы);
КонецПроцедуры

ЗаписатьПробу("file.begin", "globals-1");
ПроверитьЗначение("temp.directory", "КаталогВременныхФайлов()");
ПроверитьЗначение("temp.default", "ПолучитьИмяВременногоФайла()");
ПроверитьЗначение("temp.undefined", "ПолучитьИмяВременногоФайла(Неопределено)");
ПроверитьЗначение("temp.empty", "ПолучитьИмяВременногоФайла("""")");
ПроверитьЗначение("temp.plain", "ПолучитьИмяВременногоФайла(""xml"")");
ПроверитьЗначение("temp.dot", "ПолучитьИмяВременногоФайла("".xml"")");
ПроверитьЗначение("temp.dots", "ПолучитьИмяВременногоФайла(""..tar.gz"")");
ПроверитьЗначение("temp.slash", "ПолучитьИмяВременногоФайла(""a/b"")");
ПроверитьЗначение("temp.backslash", "ПолучитьИмяВременногоФайла(""a\b"")");
ПроверитьЗначение("temp.number", "ПолучитьИмяВременногоФайла(17)");
КореньГлобальнойПробы = "";
Попытка
	КореньГлобальнойПробы = ПолучитьИмяВременногоФайла(".globals");
	Выполнить("СоздатьКаталог(КореньГлобальнойПробы);");
	ЗаписатьПробу("file.scratch", КореньГлобальнойПробы);
	ПроверитьКоманду("create.existing", КореньГлобальнойПробы, "СоздатьКаталог(ПутьПробы);");
	ПроверитьКоманду("create.parents", КореньГлобальнойПробы + "/branch/leaf", "СоздатьКаталог(ПутьПробы);");
	ДанныеГлобальнойПробы = ПолучитьДвоичныеДанныеИзСтроки("x", КодировкаТекста.UTF8, Ложь);
	Для Каждого ИмяГлобальнойПробы Из СтрРазделить("a.txt,b.TXT,plain,.hidden,я.txt,branch/leaf/deep.txt", ",") Цикл
		ДанныеГлобальнойПробы.Записать(КореньГлобальнойПробы + "/" + ИмяГлобальнойПробы);
	КонецЦикла;
	ПроверитьКоманду("create.file", КореньГлобальнойПробы + "/a.txt", "СоздатьКаталог(ПутьПробы);");
	ПроверитьПоиск("find.direct.directory", КореньГлобальнойПробы, КореньГлобальнойПробы, "НайтиФайлы(ПутьПробы)");
	ПроверитьПоиск("find.direct.file", КореньГлобальнойПробы, КореньГлобальнойПробы + "/a.txt", "НайтиФайлы(ПутьПробы)");
	ПроверитьПоиск("find.direct.missing", КореньГлобальнойПробы, КореньГлобальнойПробы + "/missing", "НайтиФайлы(ПутьПробы)");
	ПроверитьПоиск("find.empty", КореньГлобальнойПробы, КореньГлобальнойПробы, "НайтиФайлы(ПутьПробы, """")");
	ПроверитьПоиск("find.undefined", КореньГлобальнойПробы, КореньГлобальнойПробы, "НайтиФайлы(ПутьПробы, Неопределено)");
	ПроверитьПоиск("find.star", КореньГлобальнойПробы, КореньГлобальнойПробы, "НайтиФайлы(ПутьПробы, ""*"")");
	ПроверитьПоиск("find.star.dot.star", КореньГлобальнойПробы, КореньГлобальнойПробы, "НайтиФайлы(ПутьПробы, ""*.*"")");
	ПроверитьПоиск("find.question", КореньГлобальнойПробы, КореньГлобальнойПробы, "НайтиФайлы(ПутьПробы, ""?.txt"")");
	ПроверитьПоиск("find.class", КореньГлобальнойПробы, КореньГлобальнойПробы, "НайтиФайлы(ПутьПробы, ""[a-z].*"")");
	ПроверитьПоиск("find.recursive", КореньГлобальнойПробы, КореньГлобальнойПробы, "НайтиФайлы(ПутьПробы, ""*.txt"", Истина)");
	ПроверитьКоманду("delete.mask", КореньГлобальнойПробы, "УдалитьФайлы(ПутьПробы, ""*.txt"");");
	ПроверитьПоиск("delete.survivors", КореньГлобальнойПробы, КореньГлобальнойПробы, "НайтиФайлы(ПутьПробы, ""*"", Истина)");
	ПроверитьПоиск("delete.root", КореньГлобальнойПробы, КореньГлобальнойПробы, "НайтиФайлы(ПутьПробы)");
Исключение
	ЗаписатьПробу("file.setup_error", ИнформацияОбОшибке().Описание);
КонецПопытки;
Если КореньГлобальнойПробы <> "" Тогда
	Попытка
		УдалитьФайлы(КореньГлобальнойПробы);
		ЗаписатьПробу("file.cleanup", "ok");
	Исключение
		ЗаписатьПробу("file.cleanup_error", ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецЕсли;
ЗаписатьПробу("file.end", "globals-1");
