// Нулевые календарные поля через Begin-getter времени файла на клиенте.

Перем РезультатыНулевогоBegin;
Перем СинхНулевогоBegin;
Перем ПутиНулевогоBegin;

// Маркер клиентского контекста для генератора нативного модуля формы.
Асинх Процедура КлиентскийКонтекстНулевогоBegin()
КонецПроцедуры

Функция ТекстНулевогоBegin(Знач ДатаНулевогоBegin)
    Возврат Строка(Год(ДатаНулевогоBegin)) + "-" + Строка(Месяц(ДатаНулевогоBegin))
        + "-" + Строка(День(ДатаНулевогоBegin)) + " " + Строка(Час(ДатаНулевогоBegin))
        + ":" + Строка(Минута(ДатаНулевогоBegin)) + ":" + Строка(Секунда(ДатаНулевогоBegin))
        + "|delta=" + Формат(ДатаНулевогоBegin - Дата(1, 1, 1), "ЧГ=0;ЧРД=.;ЧН=0");
КонецФункции

Процедура ЗавершитьНулевойBegin()
    Если РезультатыНулевогоBegin.Количество() <> 2 Тогда Возврат; КонецЕсли;
    ЛокальнаяДатаBegin = РезультатыНулевогоBegin["local"];
    УниверсальнаяДатаBegin = РезультатыНулевогоBegin["utc"];
    Сообщить("begin.local" + Символ(9) + ТекстНулевогоBegin(ЛокальнаяДатаBegin)
        + "|sync=" + ?(ЛокальнаяДатаBegin = СинхНулевогоBegin["local"], "1", "0"));
    Сообщить("begin.utc" + Символ(9) + ТекстНулевогоBegin(УниверсальнаяДатаBegin)
        + "|sync=" + ?(УниверсальнаяДатаBegin = СинхНулевогоBegin["utc"], "1", "0"));
    Сообщить("begin.order" + Символ(9)
        + ?(ЛокальнаяДатаBegin < УниверсальнаяДатаBegin, "1", "0"));
    Попытка УдалитьФайлы(ПутиНулевогоBegin["local"]); Исключение КонецПопытки;
    Попытка УдалитьФайлы(ПутиНулевогоBegin["utc"]); Исключение КонецПопытки;
    Сообщить("file.end" + Символ(9) + "file-zero-date-begin-1");
    Попытка Выполнить("ЗавершитьРаботуСистемы(Ложь)"); Исключение КонецПопытки;
КонецПроцедуры

Процедура ПолученаНулеваяДатаBegin(Знач ДатаНулевогоBegin, Знач КлючНулевогоBegin) Экспорт
    РезультатыНулевогоBegin.Вставить(КлючНулевогоBegin, ДатаНулевогоBegin);
    ЗавершитьНулевойBegin();
КонецПроцедуры

Процедура ОшибкаНулевогоBegin(Знач ИнформацияНулевогоBegin, СтандартнаяНулевогоBegin, Знач КлючНулевогоBegin) Экспорт
    СтандартнаяНулевогоBegin = Ложь;
    Сообщить("begin.error." + КлючНулевогоBegin + Символ(9) + ИнформацияНулевогоBegin.Описание);
    РезультатыНулевогоBegin.Вставить(КлючНулевогоBegin, Дата(1, 1, 1));
    ЗавершитьНулевойBegin();
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-zero-date-begin-1");
РезультатыНулевогоBegin = Новый Соответствие;
СинхНулевогоBegin = Новый Соответствие;
ПутиНулевогоBegin = Новый Соответствие;
Попытка
    Для Каждого КлючНулевогоBegin Из СтрРазделить("local,utc", ",") Цикл
        ПутьНулевогоBegin = ПолучитьИмяВременногоФайла(".zero-date-begin-" + КлючНулевогоBegin);
        ПутиНулевогоBegin.Вставить(КлючНулевогоBegin, ПутьНулевогоBegin);
        ДанныеНулевогоBegin = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
        ДанныеНулевогоBegin.Записать(ПутьНулевогоBegin);
        ФайлНулевогоBegin = Новый Файл(ПутьНулевогоBegin);
        Если КлючНулевогоBegin = "local" Тогда
            ФайлНулевогоBegin.УстановитьВремяИзменения(Дата(1, 1, 1));
        Иначе
            ФайлНулевогоBegin.SetModificationUniversalTime(Дата(1, 1, 1));
        КонецЕсли;
        СинхНулевогоBegin.Вставить(КлючНулевогоBegin,
            ФайлНулевогоBegin.ПолучитьУниверсальноеВремяИзменения());
        ОписаниеНулевогоBegin = Новый NotifyDescription(
            "ПолученаНулеваяДатаBegin", ThisObject, КлючНулевогоBegin,
            "ОшибкаНулевогоBegin", ThisObject);
        Если КлючНулевогоBegin = "local" Тогда
            ФайлНулевогоBegin.НачатьПолучениеУниверсальногоВремениИзменения(ОписаниеНулевогоBegin);
        Иначе
            ФайлНулевогоBegin.BeginGettingModificationUniversalTime(ОписаниеНулевогоBegin);
        КонецЕсли;
    КонецЦикла;
    Сообщить("begin.return" + Символ(9) + Строка(РезультатыНулевогоBegin.Количество()));
Исключение
    Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
    Сообщить("file.end" + Символ(9) + "file-zero-date-begin-1");
    Попытка Выполнить("ЗавершитьРаботуСистемы(Ложь)"); Исключение КонецПопытки;
КонецПопытки;
