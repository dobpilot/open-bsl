// Только собственные временные файлы. ln/mv вызываются явными executable,
// чтобы проверить идентичность носителя независимо от файловых методов BSL.
Функция ПрочитатьСовместный(ПутьСовместного)
    Попытка
        ДанныеСовместного = Новый ДвоичныеДанные(ПутьСовместного);
        Возврат "read=" + Строка(ДанныеСовместного.Размер());
    Исключение
        Возврат "error";
    КонецПопытки;
КонецФункции

Процедура КомандаСовместного(КомандаСовместного)
    КодСовместного = -99;
    ЗапуститьПриложение(КомандаСовместного, , Истина, КодСовместного);
    Если КодСовместного <> 0 Тогда
        ВызватьИсключение "fixture command failed: " + Строка(КодСовместного);
    КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "temp-sharing-1");
ПотокСовместного = Неопределено;
ИсходноеИмяСовместного = "";
КореньСовместного = ПолучитьИмяВременногоФайла(".sharing");
Попытка
    СоздатьКаталог(КореньСовместного);
    ПотокСовместного = ФайловыеПотоки.СоздатьВременныйФайл();
    ИсходноеИмяСовместного = Вычислить("ПотокСовместного.ИмяФайла");
    БуферСовместного = Новый БуферДвоичныхДанных(2);
    БуферСовместного[0] = 65;
    БуферСовместного[1] = 90;
    ПотокСовместного.Записать(БуферСовместного, 0, 2);
    Сообщить("temp.sharing.initial" + Символ(9) + ПрочитатьСовместный(ИсходноеИмяСовместного));
    ПсевдонимСовместного = КореньСовместного + "/alias";
    ПеренесенныйСовместного = КореньСовместного + "/moved";
    КомандаСовместного("/usr/bin/ln """ + ИсходноеИмяСовместного + """ """ + ПсевдонимСовместного + """");
    Сообщить("temp.sharing.alias" + Символ(9) + ПрочитатьСовместный(ПсевдонимСовместного));
    КомандаСовместного("/usr/bin/mv """ + ИсходноеИмяСовместного + """ """ + ПеренесенныйСовместного + """");
    Сообщить("temp.sharing.moved" + Символ(9) + ПрочитатьСовместный(ПеренесенныйСовместного));
    ПодменаСовместного = Новый ФайловыйПоток(ИсходноеИмяСовместного, РежимОткрытияФайла.Создать);
    ПодменаСовместного.Закрыть();
    Сообщить("temp.sharing.replacement" + Символ(9) + ПрочитатьСовместный(ИсходноеИмяСовместного));
    Сообщить("temp.sharing.name" + Символ(9) + ?(Вычислить("ПотокСовместного.ИмяФайла") = ИсходноеИмяСовместного, "original", "changed"));
    ПотокСовместного.Закрыть();
    Сообщить("temp.sharing.closed_alias" + Символ(9) + ПрочитатьСовместный(ПсевдонимСовместного));
    Сообщить("temp.sharing.closed_moved" + Символ(9) + ПрочитатьСовместный(ПеренесенныйСовместного));
Исключение
    Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Если ПотокСовместного <> Неопределено Тогда
    Попытка ПотокСовместного.Закрыть(); Исключение КонецПопытки;
КонецЕсли;
Попытка
    Если ИсходноеИмяСовместного <> "" Тогда УдалитьФайлы(ИсходноеИмяСовместного); КонецЕсли;
    УдалитьФайлы(КореньСовместного);
Исключение
    Сообщить("file.cleanup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Сообщить("file.end" + Символ(9) + "temp-sharing-1");
