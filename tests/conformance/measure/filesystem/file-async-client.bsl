// Клиентские обещания; __ASYNC_ROOT__ заменяется только в модуле формы.
Асинх Функция ПробаФайловАсинхКлиента(ИдентификаторАсинх, ВыражениеАсинх)
	КореньАсинхПробы = "__ASYNC_ROOT__";
	ФайлАсинхПробы = Новый Файл(КореньАсинхПробы + "/a.txt");
	СтадияАсинхПробы = "call";
	ТипОбещанияПробы = "none";
	Попытка
		ОбещаниеАсинхПробы = Вычислить(ВыражениеАсинх);
		ТипОбещанияПробы = Строка(ТипЗнч(ОбещаниеАсинхПробы));
		СтадияАсинхПробы = "await";
		ЗначениеАсинхПробы = Ждать ОбещаниеАсинхПробы;
		РезультатАсинхПробы = "ok|" + Строка(ТипЗнч(ЗначениеАсинхПробы));
		Если ТипЗнч(ЗначениеАсинхПробы) = Тип("Массив") Тогда
			РезультатАсинхПробы = РезультатАсинхПробы + "|count=" + Строка(ЗначениеАсинхПробы.Количество());
			Если ЗначениеАсинхПробы.Количество() > 0 Тогда
				РезультатАсинхПробы = РезультатАсинхПробы + "|item=" + Строка(ТипЗнч(ЗначениеАсинхПробы[0]));
			КонецЕсли;
		ИначеЕсли ТипЗнч(ЗначениеАсинхПробы) = Тип("Булево") Тогда
			РезультатАсинхПробы = РезультатАсинхПробы + "|value=" + ?(ЗначениеАсинхПробы, "1", "0");
		ИначеЕсли ТипЗнч(ЗначениеАсинхПробы) = Тип("Число") Тогда
			РезультатАсинхПробы = РезультатАсинхПробы + "|value=" + Строка(ЗначениеАсинхПробы);
		ИначеЕсли ТипЗнч(ЗначениеАсинхПробы) = Тип("Файл") Тогда
			РезультатАсинхПробы = РезультатАсинхПробы + "|name=" + ЗначениеАсинхПробы.Имя;
		КонецЕсли;
	Исключение
		ОшибкаАсинхПробы = ИнформацияОбОшибке();
		РезультатАсинхПробы = "error|stage=" + СтадияАсинхПробы + "|" + ОшибкаАсинхПробы.Описание;
		Если ОшибкаАсинхПробы.Причина <> Неопределено Тогда
			РезультатАсинхПробы = РезультатАсинхПробы + "|cause=" + ОшибкаАсинхПробы.Причина.Описание;
		КонецЕсли;
	КонецПопытки;
	Сообщить(ИдентификаторАсинх + Символ(9) + "promise=" + ТипОбещанияПробы + "|" + РезультатАсинхПробы);
	Возврат Неопределено;
КонецФункции

Асинх Процедура ИзмеритьФайлыАсинхКлиента()
	Сообщить("file.begin" + Символ(9) + "file-async-client-1");
	Ждать ПробаФайловАсинхКлиента("find.async.direct", "НайтиФайлыАсинх(КореньАсинхПробы)");
	Ждать ПробаФайловАсинхКлиента("find.async.mask", "НайтиФайлыАсинх(КореньАсинхПробы, ""*.txt"")");
	Ждать ПробаФайловАсинхКлиента("find.async.en", "FindFilesAsync(КореньАсинхПробы, ""*.txt"")");
	Ждать ПробаФайловАсинхКлиента("find.async.missing", "НайтиФайлыАсинх(КореньАсинхПробы + ""/missing"")");
	Ждать ПробаФайловАсинхКлиента("find.async.recursive.undefined", "НайтиФайлыАсинх(КореньАсинхПробы, ""*.txt"", Неопределено)");
	Ждать ПробаФайловАсинхКлиента("file.exists.async", "ФайлАсинхПробы.СуществуетАсинх()");
	Ждать ПробаФайловАсинхКлиента("file.isfile.async", "ФайлАсинхПробы.ЭтоФайлАсинх()");
	Ждать ПробаФайловАсинхКлиента("file.isdir.async", "ФайлАсинхПробы.ЭтоКаталогАсинх()");
	Ждать ПробаФайловАсинхКлиента("file.size.async", "ФайлАсинхПробы.РазмерАсинх()");
	Ждать ПробаФайловАсинхКлиента("file.readonly.async", "ФайлАсинхПробы.ПолучитьТолькоЧтениеАсинх()");
	Ждать ПробаФайловАсинхКлиента("file.hidden.async", "ФайлАсинхПробы.ПолучитьНевидимостьАсинх()");
	Ждать ПробаФайловАсинхКлиента("file.time.async", "ФайлАсинхПробы.ПолучитьВремяИзмененияАсинх()");
	Ждать ПробаФайловАсинхКлиента("file.timeutc.async", "ФайлАсинхПробы.ПолучитьУниверсальноеВремяИзмененияАсинх()");
	Ждать ПробаФайловАсинхКлиента("file.initialize.async", "ФайлАсинхПробы.ИнициализироватьАсинх(КореньАсинхПробы + ""/b.txt"")");
	Ждать ПробаФайловАсинхКлиента("file.tempdir.async", "КаталогВременныхФайловАсинх()");
	Сообщить("file.end" + Символ(9) + "file-async-client-1");
	Попытка
		Выполнить("ЗавершитьРаботуСистемы(Ложь)");
	Исключение
	КонецПопытки;
КонецПроцедуры

ИзмеритьФайлыАсинхКлиента();
