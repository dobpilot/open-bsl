// Вставить массива — измерение обработчика будущего объектного оповещения.
Процедура ПробаВставкиМассива(ИдВставки, ИндексВставки, ВызовВставки, КакВыражение = Ложь, ПустойМассив = Ложь)
	МассивВставки = Новый Массив;
	Если Не ПустойМассив Тогда
		МассивВставки.Добавить(10);
		МассивВставки.Добавить(20);
	КонецЕсли;
	Попытка
		Если КакВыражение Тогда
			РезультатВставки = Вычислить(ВызовВставки);
		Иначе
			Выполнить(ВызовВставки);
		КонецЕсли;
		ИтогВставки = "ok";
	Исключение
		ИтогВставки = "error";
	КонецПопытки;
	ТекстМассиваВставки = "";
	Для Каждого ЭлементВставки Из МассивВставки Цикл
		ТекстМассиваВставки = ТекстМассиваВставки + "|" + ?(ЭлементВставки = Неопределено, "<u>", Строка(ЭлементВставки));
	КонецЦикла;
	Сообщить(ИдВставки + Символ(9) + ИтогВставки + "|count=" + Строка(МассивВставки.Количество()) + ТекстМассиваВставки);
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "array-insert-1");
Попытка
	Сообщить("context.compatibility" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
Исключение
	Сообщить("context.compatibility" + Символ(9) + "unavailable");
КонецПопытки;
