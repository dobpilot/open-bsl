Функция СнимокКрайнегоПотока(ПотокКрайнейПробы)
	Попытка
		Возврат Строка(ПотокКрайнейПробы.Размер()) + ":" + Строка(ПотокКрайнейПробы.ТекущаяПозиция());
	Исключение
		Возврат "unreadable";
	КонецПопытки;
КонецФункции

Процедура ПробаПустогоПотока(ВидКрайнейПробы, ИмяКрайнегоМетода, РазмерКрайнейПробы)
	ПотокКрайнейПробы = Неопределено;
	Попытка
		Если ВидКрайнейПробы = "buffer" Тогда
			ПотокКрайнейПробы = Новый ПотокВПамяти(Новый БуферДвоичныхДанных(0));
		Иначе
			ПотокКрайнейПробы = Новый ПотокВПамяти;
		КонецЕсли;
		Попытка
			Выполнить("ПотокКрайнейПробы." + ИмяКрайнегоМетода + "(" + Строка(РазмерКрайнейПробы) + ");");
			СтатусКрайнейПробы = "ok";
		Исключение
			СтатусКрайнейПробы = "error";
		КонецПопытки;
		Сообщить("empty." + ВидКрайнейПробы + "." + ИмяКрайнегоМетода + "." + Строка(РазмерКрайнейПробы) + Символ(9) + СтатусКрайнейПробы + "|" + СнимокКрайнегоПотока(ПотокКрайнейПробы));
	Исключение
		Сообщить("empty.setup_error" + Символ(9) + ВидКрайнейПробы);
	КонецПопытки;
КонецПроцедуры

Процедура ПробаПроксиПотока(ВидКрайнейПробы, ИмяКрайнегоМетода, РазмерКрайнейПробы)
	Попытка
	ИсходныйКрайнийПоток = Новый ПотокВПамяти;
	ИсходныйКрайнийПоток.УстановитьРазмер(6);
	Если ВидКрайнейПробы = "reader" Тогда
		ВладелецКрайнейПробы = Новый ЧтениеДанных(ИсходныйКрайнийПоток);
	Иначе
		ВладелецКрайнейПробы = Новый ЗаписьДанных(ИсходныйКрайнийПоток);
	КонецЕсли;
	ПроксиКрайнейПробы = ВладелецКрайнейПробы.ИсходныйПоток();
	Попытка
		Выполнить("ПроксиКрайнейПробы." + ИмяКрайнегоМетода + "(" + Строка(РазмерКрайнейПробы) + ");");
		СтатусКрайнейПробы = "ok";
	Исключение
		СтатусКрайнейПробы = "error";
	КонецПопытки;
	Сообщить("proxy." + ВидКрайнейПробы + "." + ИмяКрайнегоМетода + "." + Строка(РазмерКрайнейПробы) + Символ(9) + СтатусКрайнейПробы + "|proxy=" + СнимокКрайнегоПотока(ПроксиКрайнейПробы) + "|source=" + СнимокКрайнегоПотока(ИсходныйКрайнийПоток));
	Исключение
		Сообщить("proxy.setup_error" + Символ(9) + ВидКрайнейПробы + "." + ИмяКрайнегоМетода + "." + Строка(РазмерКрайнейПробы));
	КонецПопытки;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "stream-resize-edges-1");
Для Каждого ВидКрайнегоПустого Из СтрРазделить("memory,buffer", ",") Цикл
	Для Каждого ИмяКрайнегоМетода Из СтрРазделить("УстановитьРазмер,SetSize", ",") Цикл
		ПробаПустогоПотока(ВидКрайнегоПустого, ИмяКрайнегоМетода, 0);
		ПробаПустогоПотока(ВидКрайнегоПустого, ИмяКрайнегоМетода, 1);
	КонецЦикла;
КонецЦикла;
Для Каждого ВидКрайнегоПрокси Из СтрРазделить("reader,writer", ",") Цикл
	Для Каждого ИмяКрайнегоМетода Из СтрРазделить("УстановитьРазмер,SetSize", ",") Цикл
		ПробаПроксиПотока(ВидКрайнегоПрокси, ИмяКрайнегоМетода, 2);
		ПробаПроксиПотока(ВидКрайнегоПрокси, ИмяКрайнегоМетода, 8);
	КонецЦикла;
КонецЦикла;
Сообщить("file.end" + Символ(9) + "stream-resize-edges-1");
