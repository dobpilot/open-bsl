// Безопасные серверные пробы корневых форм и объекта Файл для СоздатьКаталог.
// Относительные формы указывают только на уже существующие каталоги. Объект
// Файл содержит абсолютный путь внутри собственного временного корня.

Процедура ПробаКорняСоздания(ИдКорняСоздания, АргументКорняСоздания)
	Попытка
		СоздатьКаталог(АргументКорняСоздания);
		ИтогКорняСоздания = "ok";
	Исключение
		ИтогКорняСоздания = "error";
	КонецПопытки;
	Сообщить(ИдКорняСоздания + Символ(9) + ИтогКорняСоздания);
КонецПроцедуры

Процедура ПробаФайлаСоздания(ИдФайлаСоздания, ВидФайлаСоздания)
	КореньФайлаСоздания = "";
	Попытка
		КореньФайлаСоздания = ПолучитьИмяВременногоФайла(".create-directory-file");
		СоздатьКаталог(КореньФайлаСоздания);
		Если ВидФайлаСоздания = "directory" Тогда
			ПутьФайлаСоздания = КореньФайлаСоздания;
		Иначе
			ПутьФайлаСоздания = КореньФайлаСоздания + "/leaf";
		КонецЕсли;
		Если ВидФайлаСоздания = "regular" Тогда
			ДанныеФайлаСоздания = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
			ДанныеФайлаСоздания.Записать(ПутьФайлаСоздания);
		КонецЕсли;
		АргументФайлаСоздания = Новый Файл(ПутьФайлаСоздания);
		Попытка
			СоздатьКаталог(АргументФайлаСоздания);
			ИтогФайлаСоздания = "ok";
		Исключение
			ИтогФайлаСоздания = "error";
		КонецПопытки;
		ПроверочныйФайлСоздания = Новый Файл(ПутьФайлаСоздания);
		СуществуетФайлСоздания = ПроверочныйФайлСоздания.Существует();
		Если СуществуетФайлСоздания Тогда
			ЭтоФайлСоздания = ПроверочныйФайлСоздания.ЭтоФайл();
		Иначе
			ЭтоФайлСоздания = Ложь;
		КонецЕсли;
		ИтогФайлаСоздания = ИтогФайлаСоздания + "|exists="
			+ ?(СуществуетФайлСоздания, "1", "0")
			+ "|file=" + ?(ЭтоФайлСоздания, "1", "0")
			+ "|string=" + СтрЗаменить(Строка(АргументФайлаСоздания), КореньФайлаСоздания, "<root>");
		Сообщить(ИдФайлаСоздания + Символ(9) + ИтогФайлаСоздания);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдФайлаСоздания + ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньФайлаСоздания <> "" Тогда
		Попытка
			УдалитьФайлы(КореньФайлаСоздания);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдФайлаСоздания + ":" + ИнформацияОбОшибке().Описание);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "create-directory-roots-1");
Попытка
	Сообщить("context.effective" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
Исключение
	Сообщить("context.effective_unavailable" + Символ(9) + "error");
КонецПопытки;
ПробаКорняСоздания("create.root.one", "/");
ПробаКорняСоздания("create.root.two", "//");
ПробаКорняСоздания("create.root.three", "///");
ПробаКорняСоздания("create.relative.dot", ".");
ПробаКорняСоздания("create.relative.dot_slash", "./");
ПробаКорняСоздания("create.relative.parent", "..");
ПробаКорняСоздания("create.relative.parent_slash", "../");
ПробаФайлаСоздания("create.file_object.new", "new");
ПробаФайлаСоздания("create.file_object.directory", "directory");
ПробаФайлаСоздания("create.file_object.regular", "regular");
Сообщить("file.end" + Символ(9) + "create-directory-roots-1");
