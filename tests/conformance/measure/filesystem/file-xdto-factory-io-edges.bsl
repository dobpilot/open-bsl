// Серверная проба операционного пути СоздатьФабрикуXDTO.

Функция СоздатьФабрикуXDTOКрая(ПутьФабрикиКрая)
	Попытка
		ФабрикаКрая = СоздатьФабрикуXDTO(ПутьФабрикиКрая);
		Возврат "ok";
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

Процедура ПробаФабрикиXDTOКрая(ИдФабрикиКрая, КодСимволаФабрикиКрая)
	КореньФабрикиКрая = "";
	Попытка
		КореньФабрикиКрая = ПолучитьИмяВременногоФайла(
			".file-xdto-factory-io-edges");
		СоздатьКаталог(КореньФабрикиКрая);
		БазовыйПутьФабрикиКрая = КореньФабрикиКрая + "/schema.xsd";
		ТекстСхемыФабрикиКрая =
			"<xs:schema xmlns:xs=""http://www.w3.org/2001/XMLSchema""/>";
		ДанныеСхемыФабрикиКрая = ПолучитьДвоичныеДанныеИзСтроки(
			ТекстСхемыФабрикиКрая, КодировкаТекста.UTF8, Ложь);
		ДанныеСхемыФабрикиКрая.Записать(БазовыйПутьФабрикиКрая);
		ИсходныйПутьФабрикиКрая = БазовыйПутьФабрикиКрая
			+ Символ(КодСимволаФабрикиКрая);
		Сообщить(ИдФабрикиКрая + Символ(9)
			+ СоздатьФабрикуXDTOКрая(ИсходныйПутьФабрикиКрая));
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдФабрикиКрая + ":"
			+ ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньФабрикиКрая <> "" Тогда
		Попытка
			УдалитьФайлы(КореньФабрикиКрая);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдФабрикиКрая);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-xdto-factory-io-edges-1");
Для Каждого КодФабрикиКрая Из СтрРазделить(
		"0|9|10|13|32|127|133|160|8203|65279", "|") Цикл
	ПробаФабрикиXDTOКрая("xdto.suffix." + КодФабрикиКрая,
		Число(КодФабрикиКрая));
КонецЦикла;
Сообщить("file.end" + Символ(9) + "file-xdto-factory-io-edges-1");
