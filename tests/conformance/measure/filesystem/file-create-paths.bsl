// Серверные пробы путей СоздатьКаталог. Непустые пути ограничены своим корнем.
// Числа/коллекции не проверяются: неявное Строка могло бы записать вне корня.
Функция ЭкранироватьИмяСоздания(ИмяСоздания)
	Возврат СтрЗаменить(СтрЗаменить(СтрЗаменить(ИмяСоздания, Символ(0), "<NUL>"), Символ(10), "<LF>"), Символ(9), "<TAB>");
КонецФункции

Процедура ПробаПутиСоздания(ИдСоздания, ХвостСоздания, ВызовСоздания = "СоздатьКаталог(АргументСоздания);")
	КореньСоздания = "";
	Попытка
		КореньСоздания = ПолучитьИмяВременногоФайла(".create-paths");
		СоздатьКаталог(КореньСоздания);
		ДанныеСоздания = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
		ДанныеСоздания.Записать(КореньСоздания + "/block");
		АргументСоздания = КореньСоздания + "/" + ХвостСоздания;
		Попытка
			Выполнить(ВызовСоздания);
			ИтогСоздания = "ok";
		Исключение
			ИтогСоздания = "error";
		КонецПопытки;
		ИменаСоздания = Новый ТаблицаЗначений;
		ИменаСоздания.Колонки.Добавить("ИмяПробы");
		Для Каждого ФайлСоздания Из НайтиФайлы(КореньСоздания, "*", Истина) Цикл
			СтрокаСоздания = ИменаСоздания.Добавить();
			СтрокаСоздания.ИмяПробы = ЭкранироватьИмяСоздания(Сред(ФайлСоздания.ПолноеИмя, СтрДлина(КореньСоздания) + 2));
		КонецЦикла;
		ИменаСоздания.Сортировать("ИмяПробы");
		Для Каждого СтрокаСоздания Из ИменаСоздания Цикл
			ИтогСоздания = ИтогСоздания + "|" + СтрокаСоздания.ИмяПробы;
		КонецЦикла;
		ФайлКонтроляСоздания = Новый Файл(КореньСоздания + "/block");
		ИтогСоздания = ИтогСоздания + "|bytes=" + Строка(ФайлКонтроляСоздания.Размер());
		Сообщить(ИдСоздания + Символ(9) + ИтогСоздания);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдСоздания + ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньСоздания <> "" Тогда
		Попытка
			УдалитьФайлы(КореньСоздания);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдСоздания + ":" + ИнформацияОбОшибке().Описание);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Процедура ПробаПустогоСоздания(ИдПустогоСоздания, АргументПустогоСоздания)
	Попытка
		СоздатьКаталог(АргументПустогоСоздания);
		ИтогПустогоСоздания = "ok";
	Исключение
		ИтогПустогоСоздания = "error";
	КонецПопытки;
	Сообщить(ИдПустогоСоздания + Символ(9) + ИтогПустогоСоздания);
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "create-paths-1");
Попытка
	Сообщить("context.effective" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
Исключение
	Сообщить("context.effective_unavailable" + Символ(9) + "error");
КонецПопытки;
