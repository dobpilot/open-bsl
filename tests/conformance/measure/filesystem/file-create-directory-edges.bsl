// Физический путь СоздатьКаталог на конечных управляющих символах.
// Каждый случай ограничен собственным временным корнем. Удаление базового
// имени после создания различает снятый суффикс и отдельное физическое имя.

Процедура ПробаКраяКаталога(ИдКраяКаталога, КодКраяКаталога)
	КореньКраяКаталога = "";
	Попытка
		КореньКраяКаталога = ПолучитьИмяВременногоФайла(".create-directory-edges");
		СоздатьКаталог(КореньКраяКаталога);
		БазовыйПутьКраяКаталога = КореньКраяКаталога + "/leaf";
		ИсходныйПутьКраяКаталога = БазовыйПутьКраяКаталога + Символ(КодКраяКаталога);
		Попытка
			СоздатьКаталог(ИсходныйПутьКраяКаталога);
			ИтогКраяКаталога = "create=ok";
		Исключение
			ИтогКраяКаталога = "create=error";
		КонецПопытки;
		Попытка
			УдалитьФайлы(БазовыйПутьКраяКаталога);
			ИтогКраяКаталога = ИтогКраяКаталога + "|delete=ok";
		Исключение
			ИтогКраяКаталога = ИтогКраяКаталога + "|delete=error";
		КонецПопытки;
		ИтогКраяКаталога = ИтогКраяКаталога + "|remaining="
			+ Строка(НайтиФайлы(КореньКраяКаталога, "*", Ложь).Количество());
		Сообщить(ИдКраяКаталога + Символ(9) + ИтогКраяКаталога);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдКраяКаталога + ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньКраяКаталога <> "" Тогда
		Попытка
			УдалитьФайлы(КореньКраяКаталога);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдКраяКаталога + ":" + ИнформацияОбОшибке().Описание);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "create-directory-edges-1");
Попытка
	Сообщить("context.effective" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
Исключение
	Сообщить("context.effective_unavailable" + Символ(9) + "error");
КонецПопытки;
Для Каждого КодКраяКаталога Из СтрРазделить("0|1|9|10|13|32|127|133|160|8203|65279", "|") Цикл
	ПробаКраяКаталога("create.suffix." + КодКраяКаталога, Число(КодКраяКаталога));
КонецЦикла;
Сообщить("file.end" + Символ(9) + "create-directory-edges-1");
