// Смешанная проба: создание на сервере, снимок клиента до следующего RPC.
// Клиент и сервер находятся на localhost и используют общее пространство файлов.
// @onec-server-without-context НаСервере

Асинх Процедура КлиентскийКонтекстПробы()
КонецПроцедуры

Функция СнимокКлиента(ПутиСнимка)
	ТекстСнимка = "";
	Для Каждого ПутьСнимка Из ПутиСнимка Цикл
		Если ТекстСнимка <> "" Тогда
			ТекстСнимка = ТекстСнимка + "|";
		КонецЕсли;
		ФайлСнимка = Новый Файл(ПутьСнимка);
		Если ФайлСнимка.Существует() Тогда
			ТекстСнимка = ТекстСнимка + "1:" + Строка(ФайлСнимка.Размер());
		Иначе
			ТекстСнимка = ТекстСнимка + "0";
		КонецЕсли;
	КонецЦикла;
	Возврат ТекстСнимка;
КонецФункции

Процедура ПовторныйСнимокНаСервере(ПутиСнимка, ИдентификаторСнимка)
	// Отдельное объявление необходимо для независимой серверной проверки.
	ТекстСнимка = "";
	Для Каждого ПутьСнимка Из ПутиСнимка Цикл
		Если ТекстСнимка <> "" Тогда
			ТекстСнимка = ТекстСнимка + "|";
		КонецЕсли;
		ФайлСнимка = Новый Файл(ПутьСнимка);
		Если ФайлСнимка.Существует() Тогда
			ТекстСнимка = ТекстСнимка + "1:" + Строка(ФайлСнимка.Размер());
		Иначе
			ТекстСнимка = ТекстСнимка + "0";
		КонецЕсли;
	КонецЦикла;
	Сообщить(ИдентификаторСнимка + Символ(9) + ТекстСнимка);
КонецПроцедуры

Функция СоздатьФайлыНаСервере(КонтрольныйПуть)
	Попытка
		Сообщить("context.effective" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
	Исключение
		Сообщить("context.effective_unavailable" + Символ(9) + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	ПутиФайловПробы = Новый Массив;
	ДанныеПробы = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
	ДанныеПробы.Записать(КонтрольныйПуть);
	ПутиФайловПробы.Добавить(КонтрольныйПуть);

	ЗакрытыйПотокПробы = Вычислить("ФайловыеПотоки.СоздатьВременныйФайл()");
	ЗакрытыйПутьПробы = ЗакрытыйПотокПробы.ИмяФайла;
	ЗакрытыйПотокПробы.Закрыть();
	Сообщить("lifetime.path.closed" + Символ(9) + ЗакрытыйПутьПробы);
	ФайлЗакрытогоПотока = Новый Файл(ЗакрытыйПутьПробы);
	Сообщить("lifetime.after_close" + Символ(9) + Строка(ФайлЗакрытогоПотока.Существует()));
	ПутиФайловПробы.Добавить(ЗакрытыйПутьПробы);

	ОсвобожденныйПотокПробы = Вычислить("ФайловыеПотоки.СоздатьВременныйФайл()");
	ОсвобожденныйПутьПробы = ОсвобожденныйПотокПробы.ИмяФайла;
	ОсвобожденныйПотокПробы = Неопределено;
	Сообщить("lifetime.path.released" + Символ(9) + ОсвобожденныйПутьПробы);
	ФайлОсвобожденногоПотока = Новый Файл(ОсвобожденныйПутьПробы);
	Сообщить("lifetime.after_release" + Символ(9) + Строка(ФайлОсвобожденногоПотока.Существует()));
	ПутиФайловПробы.Добавить(ОсвобожденныйПутьПробы);

	ОткрытыйПотокПробы = Вычислить("ФайловыеПотоки.СоздатьВременныйФайл()");
	ОткрытыйПутьПробы = ОткрытыйПотокПробы.ИмяФайла;
	Сообщить("lifetime.path.open" + Символ(9) + ОткрытыйПутьПробы);
	ПутиФайловПробы.Добавить(ОткрытыйПутьПробы);

	ВыданныйПутьПробы = ПолучитьИмяВременногоФайла(".lifetime");
	ДанныеПробы.Записать(ВыданныйПутьПробы);
	Сообщить("lifetime.path.name" + Символ(9) + ВыданныйПутьПробы);
	ПутиФайловПробы.Добавить(ВыданныйПутьПробы);
	ПовторныйСнимокНаСервере(ПутиФайловПробы, "lifetime.before_return");
	// Открытый поток остаётся локальным до выхода из этого вызова.
	Возврат ПутиФайловПробы;
КонецФункции

Сообщить("file.begin" + Символ(9) + "temp-return-1");
КонтрольныйКореньПробы = "";
Попытка
	КонтрольныйКореньПробы = ПолучитьИмяВременногоФайла(".lifetime-control");
	СоздатьКаталог(КонтрольныйКореньПробы);
	ПутиФайловПробы = СоздатьФайлыНаСервере(КонтрольныйКореньПробы + "/control.bin");
	// Сначала локальные чтения; даже Сообщить обёртки вызывает серверный RPC.
	СнимокПослеВозврата = СнимокКлиента(ПутиФайловПробы);
	Сообщить("lifetime.after_return" + Символ(9) + СнимокПослеВозврата);
	ПовторныйСнимокНаСервере(ПутиФайловПробы, "lifetime.next_call");
	СнимокПередВыходом = СнимокКлиента(ПутиФайловПробы);
	Сообщить("lifetime.before_exit" + Символ(9) + СнимокПередВыходом);
Исключение
	Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Если КонтрольныйКореньПробы <> "" Тогда
	Попытка
		УдалитьФайлы(КонтрольныйКореньПробы);
	Исключение
		Сообщить("file.cleanup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецЕсли;
// Четыре серверных временных файла не удаляются явно: наблюдается жизнь сеанса.
Сообщить("file.end" + Символ(9) + "temp-return-1");
Попытка
	Выполнить("ЗавершитьРаботуСистемы(Ложь);");
Исключение
	// В open-bsl завершением процесса управляет CLI, не платформа формы.
КонецПопытки;
