// Только лексический конструктор и свойства Файл; файлового I/O нет.
Функция ЭкранироватьПредставлениеФайла(Значение)
	Возврат СтрЗаменить(
		СтрЗаменить(
			СтрЗаменить(Строка(Значение), Символ(0), "<NUL>"),
			Символ(9), "<TAB>"),
		Символ(10), "<LF>");
КонецФункции

Процедура ПробаДополнительногоТипаФайла(ИдПробы, АргументПробы)
	Попытка
		ПредставлениеПробы = Строка(АргументПробы);
		ФайлПробы = Новый Файл(АргументПробы);
		Сообщить(ИдПробы + Символ(9)
			+ "ok|equals=" + ?(ФайлПробы.ПолноеИмя = ПредставлениеПробы, "1", "0")
			+ "|input=" + ЭкранироватьПредставлениеФайла(ПредставлениеПробы)
			+ "|full=" + ЭкранироватьПредставлениеФайла(ФайлПробы.ПолноеИмя)
			+ "|parent=" + ЭкранироватьПредставлениеФайла(ФайлПробы.Путь)
			+ "|name=" + ЭкранироватьПредставлениеФайла(ФайлПробы.Имя)
			+ "|base=" + ЭкранироватьПредставлениеФайла(ФайлПробы.ИмяБезРасширения)
			+ "|extension=" + ЭкранироватьПредставлениеФайла(ФайлПробы.Расширение));
	Исключение
		Сообщить(ИдПробы + Символ(9) + "error");
	КонецПопытки;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-constructor-more-types-1");
Попытка
	Сообщить("context.compatibility" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
Исключение
	Сообщить("context.compatibility" + Символ(9) + "unavailable");
КонецПопытки;

