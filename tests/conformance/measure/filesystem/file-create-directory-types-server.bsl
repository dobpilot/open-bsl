// Типы аргумента синхронного СоздатьКаталог на сервере. Перед каждым
// относительным представлением проверяется отсутствие и конечного пути, и
// первого компонента; существующий путь пропускается без изменения.

Функция ПредставлениеТипаСозданияНаСервере(ЗначениеТипаСоздания)
	Возврат СтрЗаменить(
		СтрЗаменить(
			СтрЗаменить(Строка(ЗначениеТипаСоздания), Символ(0), "<NUL>"),
			Символ(9), "<TAB>"),
		Символ(10), "<LF>");
КонецФункции

Функция ПервыйКомпонентСозданияНаСервере(ПредставлениеСоздания)
	ПозицияПрямогоРазделителя = СтрНайти(ПредставлениеСоздания, "/");
	ПозицияОбратногоРазделителя = СтрНайти(ПредставлениеСоздания, "\");
	Если ПозицияПрямогоРазделителя = 0 Тогда
		ПозицияРазделителя = ПозицияОбратногоРазделителя;
	ИначеЕсли ПозицияОбратногоРазделителя = 0 Тогда
		ПозицияРазделителя = ПозицияПрямогоРазделителя;
	Иначе
		ПозицияРазделителя = Мин(ПозицияПрямогоРазделителя, ПозицияОбратногоРазделителя);
	КонецЕсли;
	Если ПозицияРазделителя = 0 Тогда
		Возврат ПредставлениеСоздания;
	КонецЕсли;
	Возврат Лев(ПредставлениеСоздания, ПозицияРазделителя - 1);
КонецФункции

Процедура ПробаТипаСозданияНаСервере(ИдТипаСоздания, ЗначениеТипаСоздания)
	ПредставлениеСоздания = Строка(ЗначениеТипаСоздания);
	Если ПредставлениеСоздания = "" Тогда
		КонечныйФайлСоздания = Неопределено;
		КорневойФайлСоздания = Неопределено;
	Иначе
		ПервыйКомпонентСоздания = ПервыйКомпонентСозданияНаСервере(ПредставлениеСоздания);
		КонечныйФайлСоздания = Новый Файл(ПредставлениеСоздания);
		КорневойФайлСоздания = Новый Файл(ПервыйКомпонентСоздания);
		Если КонечныйФайлСоздания.Существует() Или КорневойФайлСоздания.Существует() Тогда
			Сообщить(ИдТипаСоздания + Символ(9) + "skip=preexisting|repr="
				+ ПредставлениеТипаСозданияНаСервере(ЗначениеТипаСоздания));
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Попытка
		СоздатьКаталог(ЗначениеТипаСоздания);
		ИтогТипаСоздания = "ok";
	Исключение
		ИтогТипаСоздания = "error";
	КонецПопытки;
	Если ПредставлениеСоздания = "" Тогда
		СуществуетТипаСоздания = Ложь;
	Иначе
		СуществуетТипаСоздания = КонечныйФайлСоздания.Существует();
	КонецЕсли;
	Сообщить(ИдТипаСоздания + Символ(9)
		+ "repr=" + ПредставлениеТипаСозданияНаСервере(ЗначениеТипаСоздания)
		+ "|result=" + ИтогТипаСоздания
		+ "|exists=" + ?(СуществуетТипаСоздания, "1", "0"));

	Если ПредставлениеСоздания <> "" Тогда
		Попытка
			Если КорневойФайлСоздания.Существует() Тогда
				УдалитьФайлы(ПервыйКомпонентСоздания);
			КонецЕсли;
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдТипаСоздания);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "create-directory-types-server-1");
Попытка
	Сообщить("context.effective" + Символ(9)
		+ Строка(Вычислить("Метаданные.РежимСовместимости")));
Исключение
	Сообщить("context.effective_unavailable" + Символ(9) + "error");
КонецПопытки;

ПробаТипаСозданияНаСервере("create.server.string", "open-bsl-create-directory-type-string-20260918");
ПробаТипаСозданияНаСервере("create.server.number", 17);
ПробаТипаСозданияНаСервере("create.server.true", Истина);
ПробаТипаСозданияНаСервере("create.server.false", Ложь);
ПробаТипаСозданияНаСервере("create.server.date", Дата(2020, 1, 15, 12, 34, 56));
ПробаТипаСозданияНаСервере("create.server.array", Новый Массив);
ПробаТипаСозданияНаСервере("create.server.structure", Новый Структура);
ПробаТипаСозданияНаСервере("create.server.map", Новый Соответствие);
ПробаТипаСозданияНаСервере("create.server.fixed_array", Новый ФиксированныйМассив(Новый Массив));
ПробаТипаСозданияНаСервере("create.server.fixed_structure", Новый ФиксированнаяСтруктура(Новый Структура));
ПробаТипаСозданияНаСервере("create.server.fixed_map", Новый ФиксированноеСоответствие(Новый Соответствие));
ПробаТипаСозданияНаСервере("create.server.value_table", Новый ТаблицаЗначений);
ПробаТипаСозданияНаСервере("create.server.value_list", Новый СписокЗначений);
ПробаТипаСозданияНаСервере("create.server.uuid", Новый УникальныйИдентификатор("00112233-4455-6677-8899-aabbccddeeff"));
ПробаТипаСозданияНаСервере("create.server.file", Новый Файл("inside"));
ПробаТипаСозданияНаСервере("create.server.binary", ПолучитьДвоичныеДанныеИзСтроки("AB", КодировкаТекста.UTF8, Ложь));
ПробаТипаСозданияНаСервере("create.server.enum", КодировкаТекста.UTF8);
ПробаТипаСозданияНаСервере("create.server.type", Тип("Строка"));
ПробаТипаСозданияНаСервере("create.server.undefined", Неопределено);
ПробаТипаСозданияНаСервере("create.server.null", Null);

Сообщить("file.end" + Символ(9) + "create-directory-types-server-1");
