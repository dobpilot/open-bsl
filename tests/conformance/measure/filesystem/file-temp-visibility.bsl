Процедура ПроверитьВидимостьВременного(ИдВидимости, АргументыВидимости)
    ПотокВидимости = Неопределено;
    Попытка
        ПотокВидимости = Вычислить("ФайловыеПотоки.СоздатьВременныйФайл(" + АргументыВидимости + ")");
        ПутьВидимости = Вычислить("ПотокВидимости.ИмяФайла");
        ФайлВидимости = Новый Файл(ПутьВидимости);
        Для Каждого РазмерТекстаВидимости Из СтрРазделить("1,8,8191,8192,8193", ",") Цикл
            РазмерВидимости = Число(РазмерТекстаВидимости);
            БуферВидимости = Новый БуферДвоичныхДанных(РазмерВидимости);
            БуферВидимости[0] = 65;
            БуферВидимости[РазмерВидимости - 1] = 90;
            ПотокВидимости.Перейти(0, ПозицияВПотоке.Начало);
            ПотокВидимости.Записать(БуферВидимости, 0, РазмерВидимости);
            РазмерФайлаВидимости = ФайлВидимости.Размер();
            Попытка
                ДанныеВидимости = Новый ДвоичныеДанные(ПутьВидимости);
                НезависимоеЧтениеВидимости = "read=" + Строка(ДанныеВидимости.Размер());
            Исключение
                ИнформацияВидимости = ИнформацияОбОшибке();
                НезависимоеЧтениеВидимости = "read_error|" + ИнформацияВидимости.Описание;
                Если ИнформацияВидимости.Причина <> Неопределено Тогда
                    НезависимоеЧтениеВидимости = НезависимоеЧтениеВидимости + "|cause="
                        + СтрЗаменить(ИнформацияВидимости.Причина.Описание, ПутьВидимости, "<temp>");
                КонецЕсли;
            КонецПопытки;
            РазмерПотокаВидимости = ПотокВидимости.Размер();
            ПотокВидимости.Перейти(0, ПозицияВПотоке.Начало);
            БуферЧтенияВидимости = Новый БуферДвоичныхДанных(РазмерВидимости);
            ПрочитаноВидимости = ПотокВидимости.Прочитать(БуферЧтенияВидимости, 0, РазмерВидимости);
            Сообщить(ИдВидимости + "." + РазмерТекстаВидимости + Символ(9)
                + Строка(РазмерФайлаВидимости) + "/" + Строка(РазмерПотокаВидимости)
                + "/" + Строка(ПрочитаноВидимости) + "/" + Строка(БуферЧтенияВидимости[0])
                + "/" + Строка(БуферЧтенияВидимости[РазмерВидимости - 1])
                + "|" + НезависимоеЧтениеВидимости);
        КонецЦикла;
        ПотокВидимости.Закрыть();
        Попытка
            ДанныеПослеЗакрытия = Новый ДвоичныеДанные(ПутьВидимости);
            ИтогПослеЗакрытия = "read=" + Строка(ДанныеПослеЗакрытия.Размер());
        Исключение
            ИтогПослеЗакрытия = "read_error|" + ИнформацияОбОшибке().Описание;
        КонецПопытки;
        Сообщить(ИдВидимости + ".closed" + Символ(9) + ИтогПослеЗакрытия);
    Исключение
        Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
    КонецПопытки;
    Если ПотокВидимости <> Неопределено Тогда
        Попытка ПотокВидимости.Закрыть(); Исключение КонецПопытки;
    КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "temp-visibility-1");
ПроверитьВидимостьВременного("temp.visibility.default", "");
ПроверитьВидимостьВременного("temp.visibility.explicit", "65535,8192");
ПроверитьВидимостьВременного("temp.visibility.zero", "0,0");
ПроверитьВидимостьВременного("temp.visibility.one", "1,1");
ПроверитьВидимостьВременного("temp.visibility.eight", "8,8192");
ПроверитьВидимостьВременного("temp.visibility.large", "65536,16384");
Сообщить("file.end" + Символ(9) + "temp-visibility-1");
