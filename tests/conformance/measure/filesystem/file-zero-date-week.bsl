// Точное значение `НачалоНедели` для файловых дат с нулевыми календарными полями.
// Меняет и удаляет только собственный временный файл.

Процедура ВывестиНачалоНедели(КлючНачалаНедели, ДатаНачалаНедели)
    НачалоНеделиДаты = НачалоНедели(ДатаНачалаНедели);
    Сообщить(КлючНачалаНедели + ".delta_empty" + Символ(9)
        + Строка(НачалоНеделиДаты - Дата(1, 1, 1)));
    Сообщить(КлючНачалаНедели + ".delta_source" + Символ(9)
        + Строка(НачалоНеделиДаты - ДатаНачалаНедели));
    Сообщить(КлючНачалаНедели + ".equal_empty" + Символ(9)
        + ?(НачалоНеделиДаты = Дата(1, 1, 1), "1", "0"));
    Сообщить(КлючНачалаНедели + ".equal_source" + Символ(9)
        + ?(НачалоНеделиДаты = ДатаНачалаНедели, "1", "0"));
КонецПроцедуры

Процедура ВывестиГраницу(КлючГраницы, Знач ИсходнаяДатаГраницы, Знач ДатаГраницы)
    Сообщить(КлючГраницы + ".delta_empty" + Символ(9) + Строка(ДатаГраницы - Дата(1, 1, 1)));
    Сообщить(КлючГраницы + ".delta_source" + Символ(9) + Строка(ДатаГраницы - ИсходнаяДатаГраницы));
КонецПроцедуры

Процедура ВывестиВсеГраницы(КлючГраницы, Знач ИсходнаяДатаГраницы)
    ВывестиГраницу(КлючГраницы + ".start_day", ИсходнаяДатаГраницы, НачалоДня(ИсходнаяДатаГраницы));
    ВывестиГраницу(КлючГраницы + ".end_day", ИсходнаяДатаГраницы, КонецДня(ИсходнаяДатаГраницы));
    ВывестиГраницу(КлючГраницы + ".start_week", ИсходнаяДатаГраницы, НачалоНедели(ИсходнаяДатаГраницы));
    ВывестиГраницу(КлючГраницы + ".start_month", ИсходнаяДатаГраницы, НачалоМесяца(ИсходнаяДатаГраницы));
    ВывестиГраницу(КлючГраницы + ".end_month", ИсходнаяДатаГраницы, КонецМесяца(ИсходнаяДатаГраницы));
    ВывестиГраницу(КлючГраницы + ".start_year", ИсходнаяДатаГраницы, НачалоГода(ИсходнаяДатаГраницы));
    ВывестиГраницу(КлючГраницы + ".end_year", ИсходнаяДатаГраницы, КонецГода(ИсходнаяДатаГраницы));
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "file-zero-date-week-1");
ПутьНачалаНедели = ПолучитьИмяВременногоФайла(".zero-date-week");
Попытка
    ДанныеНачалаНедели = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
    ДанныеНачалаНедели.Записать(ПутьНачалаНедели);
    ФайлНачалаНедели = Новый Файл(ПутьНачалаНедели);
    ФайлНачалаНедели.УстановитьВремяИзменения(Дата(1, 1, 1));
    ЛокальнаяДатаНачалаНедели = ФайлНачалаНедели.ПолучитьУниверсальноеВремяИзменения();
    ФайлНачалаНедели.УстановитьУниверсальноеВремяИзменения(Дата(1, 1, 1));
    УниверсальнаяДатаНачалаНедели = ФайлНачалаНедели.ПолучитьУниверсальноеВремяИзменения();
    ВывестиНачалоНедели("local", ЛокальнаяДатаНачалаНедели);
    ВывестиНачалоНедели("utc", УниверсальнаяДатаНачалаНедели);
    ВывестиВсеГраницы("local", ЛокальнаяДатаНачалаНедели);
    ВывестиВсеГраницы("utc", УниверсальнаяДатаНачалаНедели);
Исключение
    Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Попытка
    УдалитьФайлы(ПутьНачалаНедели);
Исключение
    Сообщить("file.cleanup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Сообщить("file.end" + Символ(9) + "file-zero-date-week-1");
