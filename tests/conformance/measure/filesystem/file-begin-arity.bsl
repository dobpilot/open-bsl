Функция ТекстОшибкиАрностиНачать(ИнформацияАрностиНачать)
	Пока ИнформацияАрностиНачать.Причина <> Неопределено Цикл
		ИнформацияАрностиНачать = ИнформацияАрностиНачать.Причина;
	КонецЦикла;
	ОписаниеАрностиНачать = СтрЗаменить(ИнформацияАрностиНачать.Описание, КореньАрностейНачать, "<root>");
	Возврат СтрЗаменить(СтрЗаменить(СтрЗаменить(ОписаниеАрностиНачать, Символ(13), "<CR>"), Символ(10), "<LF>"), Символ(9), "<TAB>");
КонецФункции

Процедура РезультатЧтенияАрностиНачать(Знач РезультатАрностиНачать, Знач ДанныеАрностиНачать) Экспорт
	Сообщить(ДанныеАрностиНачать.Ид + ".callback" + Символ(9) + "ok|argc=2|returned=" + ?(ДанныеАрностиНачать.Вернулся, "1", "0")
		+ "|type=" + Строка(ТипЗнч(РезультатАрностиНачать)));
	ДоставленоАрностейНачать = ДоставленоАрностейНачать + 1;
	Если ДанныеАрностиНачать.Валиден Тогда ВалидныхАрностейНачать = ВалидныхАрностейНачать + 1; КонецЕсли;
КонецПроцедуры

Процедура РезультатЗаписиАрностиНачать(Знач ДанныеАрностиНачать) Экспорт
	Сообщить(ДанныеАрностиНачать.Ид + ".callback" + Символ(9) + "ok|argc=1|returned=" + ?(ДанныеАрностиНачать.Вернулся, "1", "0"));
	ДоставленоАрностейНачать = ДоставленоАрностейНачать + 1;
	Если ДанныеАрностиНачать.Валиден Тогда ВалидныхАрностейНачать = ВалидныхАрностейНачать + 1; КонецЕсли;
КонецПроцедуры

Процедура ОшибкаОперацииАрностиНачать(Знач ОшибкаАрностиНачать, СтандартнаяОбработкаАрностиНачать, Знач ДанныеАрностиНачать) Экспорт
	Сообщить(ДанныеАрностиНачать.Ид + ".callback" + Символ(9) + "error|returned=" + ?(ДанныеАрностиНачать.Вернулся, "1", "0")
		+ "|standard=" + ?(СтандартнаяОбработкаАрностиНачать, "1", "0"));
	Сообщить(ДанныеАрностиНачать.Ид + ".callback.detail" + Символ(9) + ТекстОшибкиАрностиНачать(ОшибкаАрностиНачать));
	СтандартнаяОбработкаАрностиНачать = Ложь;
	ДоставленоАрностейНачать = ДоставленоАрностейНачать + 1;
КонецПроцедуры

Процедура ИзмеритьАрностьНачать(ИдМетодаАрностиНачать, ИмяМетодаАрностиНачать, РежимАрностиНачать, АргументМетодаАрностиНачать)
	ВариантыАрностиНачать = СтрРазделить(?(РежимАрностиНачать = 0, "valid,none,extra", "valid,none,extra,missing_value,bad_value"), ",");
	Для Каждого ВариантАрностиНачать Из ВариантыАрностиНачать Цикл
		ИдСлучаяАрностиНачать = "begin." + ИдМетодаАрностиНачать + "." + ВариантАрностиНачать;
		ПутьСлучаяАрностиНачать = КореньАрностейНачать + "/" + ИдСлучаяАрностиНачать;
		БайтыСлучаяАрностиНачать = ПолучитьДвоичныеДанныеИзСтроки("abc", КодировкаТекста.UTF8, Ложь);
		БайтыСлучаяАрностиНачать.Записать(ПутьСлучаяАрностиНачать);
		ФайлСлучаяАрностиНачать = Новый Файл(ПутьСлучаяАрностиНачать);
		ДанныеСлучаяАрностиНачать = Новый Структура("Ид,Вернулся,Валиден", ИдСлучаяАрностиНачать, Ложь, ВариантАрностиНачать = "valid");
		ИмяОбработчикаАрностиНачать = ?(РежимАрностиНачать = 1, "РезультатЗаписиАрностиНачать", "РезультатЧтенияАрностиНачать");
		Попытка
			ОписаниеСлучаяАрностиНачать = Вычислить("Новый ОписаниеОповещения(ИмяОбработчикаАрностиНачать, ЭтотОбъект, ДанныеСлучаяАрностиНачать, ""ОшибкаОперацииАрностиНачать"", ЭтотОбъект)");
		Исключение
			Сообщить(ИдСлучаяАрностиНачать + ".call" + Символ(9) + "constructor_error");
			Продолжить;
		КонецПопытки;
		АргументСлучаяАрностиНачать = ?(РежимАрностиНачать = 2, ПутьСлучаяАрностиНачать + ".after", АргументМетодаАрностиНачать);
		АргументыСлучаяАрностиНачать = "ОписаниеСлучаяАрностиНачать";
		Если РежимАрностиНачать <> 0 Тогда АргументыСлучаяАрностиНачать = АргументыСлучаяАрностиНачать + ", АргументСлучаяАрностиНачать"; КонецЕсли;
		Если ВариантАрностиНачать = "none" Тогда
			АргументыСлучаяАрностиНачать = "";
		ИначеЕсли ВариантАрностиНачать = "extra" Тогда
			АргументыСлучаяАрностиНачать = АргументыСлучаяАрностиНачать + ", 123";
		ИначеЕсли ВариантАрностиНачать = "missing_value" Тогда
			АргументыСлучаяАрностиНачать = "ОписаниеСлучаяАрностиНачать";
		ИначеЕсли ВариантАрностиНачать = "bad_value" Тогда
			АргументСлучаяАрностиНачать = Новый Массив;
		КонецЕсли;
		Попытка
			Выполнить("ФайлСлучаяАрностиНачать." + ИмяМетодаАрностиНачать + "(" + АргументыСлучаяАрностиНачать + ");");
			ДанныеСлучаяАрностиНачать.Вернулся = Истина;
			Если ВариантАрностиНачать <> "none" Тогда ОжидаетсяАрностейНачать = ОжидаетсяАрностейНачать + 1; КонецЕсли;
			Сообщить(ИдСлучаяАрностиНачать + ".call" + Символ(9) + "returned|path_changed=" + ?(ФайлСлучаяАрностиНачать.ПолноеИмя <> ПутьСлучаяАрностиНачать, "1", "0"));
		Исключение
			Сообщить(ИдСлучаяАрностиНачать + ".call" + Символ(9) + "error|path_changed=" + ?(ФайлСлучаяАрностиНачать.ПолноеИмя <> ПутьСлучаяАрностиНачать, "1", "0"));
			Сообщить(ИдСлучаяАрностиНачать + ".call.detail" + Символ(9) + ТекстОшибкиАрностиНачать(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Процедура ЗавершитьАрностиНачать() Экспорт
	ТиковАрностейНачать = ТиковАрностейНачать + 1;
	ГотовоАрностиНачать = ДоставленоАрностейНачать = ОжидаетсяАрностейНачать И ВалидныхАрностейНачать = 26;
	Если Не ГотовоАрностиНачать И ТиковАрностейНачать < 10 Тогда Возврат; КонецЕсли;
