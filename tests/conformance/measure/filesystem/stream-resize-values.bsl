Функция СнимокПотокаРазмера(ПотокПробы)
	Попытка
		СнимокПробы = Строка(ПотокПробы.Размер()) + ":" + Строка(ПотокПробы.ТекущаяПозиция());
		ПотокПробы.Перейти(0, ПозицияВПотоке.Начало);
		БуферЧтенияПробы = Новый БуферДвоичныхДанных(10);
		ПрочитаноПробы = ПотокПробы.Прочитать(БуферЧтенияПробы, 0, 10);
		СнимокПробы = СнимокПробы + ":";
		Для НомерБайтаПробы = 0 По ПрочитаноПробы - 1 Цикл
			СнимокПробы = СнимокПробы + Строка(БуферЧтенияПробы[НомерБайтаПробы]) + ",";
		КонецЦикла;
		Возврат СнимокПробы;
	Исключение
		Возврат "closed_or_unreadable";
	КонецПопытки;
КонецФункции

Процедура ПробаРазмераПотока(ВидПробы, ИмяМетодаПробы, ИдПробы, АргументыПробы, КакФункция = Ложь)
	ИмяФайлаПробы = "";
	ПотокПробы = Неопределено;
	Попытка
		БуферПробы = Новый БуферДвоичныхДанных(6);
		Для ИндексБайтаПробы = 0 По 5 Цикл
			БуферПробы[ИндексБайтаПробы] = ИндексБайтаПробы + 1;
		КонецЦикла;
		Если ВидПробы = "buffer" Тогда
			ПотокПробы = Новый ПотокВПамяти(БуферПробы);
		ИначеЕсли ВидПробы = "file" Или ВидПробы = "readonly" Тогда
			ИмяФайлаПробы = ПолучитьИмяВременногоФайла("tmp");
			ПотокПробы = ФайловыеПотоки.Создать(ИмяФайлаПробы);
		Иначе
			ПотокПробы = Новый ПотокВПамяти;
		КонецЕсли;
		Если ВидПробы <> "buffer" Тогда
			ПотокПробы.Записать(БуферПробы, 0, 6);
		КонецЕсли;
		Если ВидПробы = "readonly" Тогда
			ПотокПробы.Закрыть();
			ПотокПробы = ФайловыеПотоки.ОткрытьДляЧтения(ИмяФайлаПробы);
		КонецЕсли;
		ПотокПробы.Перейти(5, ПозицияВПотоке.Начало);
		Если ВидПробы = "closed" Тогда
			ПотокПробы.Закрыть();
		КонецЕсли;
		Попытка
			ТекстВызоваПробы = "ПотокПробы." + ИмяМетодаПробы + "(" + АргументыПробы + ")";
			Если КакФункция Тогда
				РезультатВызоваПробы = Вычислить(ТекстВызоваПробы);
			Иначе
				Выполнить(ТекстВызоваПробы + ";");
			КонецЕсли;
			СтатусПробы = "ok";
		Исключение
			СтатусПробы = "error";
		КонецПопытки;
		Сообщить(ВидПробы + "." + ИмяМетодаПробы + "." + ИдПробы + Символ(9) + СтатусПробы + "|" + СнимокПотокаРазмера(ПотокПробы));
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ВидПробы + "." + ИдПробы);
	КонецПопытки;
	Попытка
		Если ПотокПробы <> Неопределено Тогда
			ПотокПробы.Закрыть();
		КонецЕсли;
		Если ИмяФайлаПробы <> "" Тогда
			УдалитьФайлы(ИмяФайлаПробы);
		КонецЕсли;
	Исключение
		Сообщить("file.cleanup_error" + Символ(9) + ВидПробы + "." + ИдПробы);
	КонецПопытки;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "stream-resize-values-1");
Для Каждого ВидПотокаРазмера Из СтрРазделить("memory,buffer,file,readonly,closed", ",") Цикл
	Для Каждого МетодПотокаРазмера Из СтрРазделить("УстановитьРазмер,SetSize", ",") Цикл
		ПробаРазмераПотока(ВидПотокаРазмера, МетодПотокаРазмера, "zero", "0");
		ПробаРазмераПотока(ВидПотокаРазмера, МетодПотокаРазмера, "shrink", "2");
		ПробаРазмераПотока(ВидПотокаРазмера, МетодПотокаРазмера, "same", "6");
		ПробаРазмераПотока(ВидПотокаРазмера, МетодПотокаРазмера, "grow", "8");
		ПробаРазмераПотока(ВидПотокаРазмера, МетодПотокаРазмера, "negative", "-1");
		ПробаРазмераПотока(ВидПотокаРазмера, МетодПотокаРазмера, "fraction", "2.9");
		ПробаРазмераПотока(ВидПотокаРазмера, МетодПотокаРазмера, "string", """2""");
		ПробаРазмераПотока(ВидПотокаРазмера, МетодПотокаРазмера, "undefined", "Неопределено");
		ПробаРазмераПотока(ВидПотокаРазмера, МетодПотокаРазмера, "null", "Null");
		ПробаРазмераПотока(ВидПотокаРазмера, МетодПотокаРазмера, "boolean", "Истина");
		ПробаРазмераПотока(ВидПотокаРазмера, МетодПотокаРазмера, "arity0", "");
		ПробаРазмераПотока(ВидПотокаРазмера, МетодПотокаРазмера, "arity2", "2, 3");
		ПробаРазмераПотока(ВидПотокаРазмера, МетодПотокаРазмера, "expression", "2", Истина);
	КонецЦикла;
КонецЦикла;
Сообщить("file.end" + Символ(9) + "stream-resize-values-1");
