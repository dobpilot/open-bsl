// Матрица отбора специальных имён со звёздочкой. Каждый каталог содержит
// ровно одно имя, поэтому количество не зависит от порядка обхода.

Процедура ПробаОтбораSFile(КореньОтбораSFile, КаталогОтбораSFile,
		ИдОтбораSFile, МаскаОтбораSFile)
	Попытка
		РезультатОтбораSFile = НайтиФайлы(
			КореньОтбораSFile + "/" + КаталогОтбораSFile, МаскаОтбораSFile);
		ТекстОтбораSFile = Строка(РезультатОтбораSFile.Количество());
	Исключение
		ТекстОтбораSFile = "error";
	КонецПопытки;
	Сообщить(ИдОтбораSFile + Символ(9) + ТекстОтбораSFile);
КонецПроцедуры

Процедура МатрицаОтбораSFile(КореньОтбораSFile, КаталогОтбораSFile,
		ИдОтбораSFile, МаскаИмениОтбораSFile, ЭкранированнаяМаскаОтбораSFile,
		ВопросительнаяМаскаОтбораSFile)
	МаскаВопросовSFile = "";
	Для ДлинаВопросовSFile = 1 По 8 Цикл
		МаскаВопросовSFile = МаскаВопросовSFile + "?";
		ПробаОтбораSFile(КореньОтбораSFile, КаталогОтбораSFile,
			ИдОтбораSFile + ".q" + Строка(ДлинаВопросовSFile), МаскаВопросовSFile);
	КонецЦикла;
	ПробаОтбораSFile(КореньОтбораSFile, КаталогОтбораSFile,
		ИдОтбораSFile + ".all", "*");
	ПробаОтбораSFile(КореньОтбораSFile, КаталогОтбораSFile,
		ИдОтбораSFile + ".name", МаскаИмениОтбораSFile);
	ПробаОтбораSFile(КореньОтбораSFile, КаталогОтбораSFile,
		ИдОтбораSFile + ".literal", ЭкранированнаяМаскаОтбораSFile);
	ПробаОтбораSFile(КореньОтбораSFile, КаталогОтбораSFile,
		ИдОтбораSFile + ".question", ВопросительнаяМаскаОтбораSFile);
	ПробаОтбораSFile(КореньОтбораSFile, КаталогОтбораSFile,
		ИдОтбораSFile + ".wildq.left", "*?");
	ПробаОтбораSFile(КореньОтбораSFile, КаталогОтбораSFile,
		ИдОтбораSFile + ".wildq.right", "?*");
	ПробаОтбораSFile(КореньОтбораSFile, КаталогОтбораSFile,
		ИдОтбораSFile + ".wildq.two", "*??");
	ПробаОтбораSFile(КореньОтбораSFile, КаталогОтбораSFile,
		ИдОтбораSFile + ".wildq.middle", "?*?");
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "search-sfile-selection-1");
КореньОтбораSFile = "__OPEN_BSL_SFILE_SELECTION_ROOT__";
СвойКореньОтбораSFile = Лев(КореньОтбораSFile, 1) = "_";
Попытка
	Если СвойКореньОтбораSFile Тогда
		КореньОтбораSFile = ПолучитьИмяВременногоФайла(".search-sfile-selection");
		СоздатьКаталог(КореньОтбораSFile);
		ДанныеОтбораSFile = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
		СоздатьКаталог(КореньОтбораSFile + "/star");
		ДанныеОтбораSFile.Записать(КореньОтбораSFile + "/star/a*");
		СоздатьКаталог(КореньОтбораSFile + "/prefix");
		ДанныеОтбораSFile.Записать(КореньОтбораSFile + "/prefix/*a");
		СоздатьКаталог(КореньОтбораSFile + "/middle");
		ДанныеОтбораSFile.Записать(КореньОтбораSFile + "/middle/a*b");
		СоздатьКаталог(КореньОтбораSFile + "/double");
		ДанныеОтбораSFile.Записать(КореньОтбораSFile + "/double/a**");
		СоздатьКаталог(КореньОтбораSFile + "/only");
		ДанныеОтбораSFile.Записать(КореньОтбораSFile + "/only/*");
		СоздатьКаталог(КореньОтбораSFile + "/extension");
		ДанныеОтбораSFile.Записать(КореньОтбораSFile + "/extension/a*.txt");
		СоздатьКаталог(КореньОтбораSFile + "/tail3");
		ДанныеОтбораSFile.Записать(КореньОтбораSFile + "/tail3/ab*");
		СоздатьКаталог(КореньОтбораSFile + "/tail4");
		ДанныеОтбораSFile.Записать(КореньОтбораSFile + "/tail4/abc*");
		СоздатьКаталог(КореньОтбораSFile + "/leading3");
		ДанныеОтбораSFile.Записать(КореньОтбораSFile + "/leading3/*ab");
		СоздатьКаталог(КореньОтбораSFile + "/leading4");
		ДанныеОтбораSFile.Записать(КореньОтбораSFile + "/leading4/*abc");
		СоздатьКаталог(КореньОтбораSFile + "/inner4");
		ДанныеОтбораSFile.Записать(КореньОтбораSFile + "/inner4/ab*c");
		СоздатьКаталог(КореньОтбораSFile + "/only2");
		ДанныеОтбораSFile.Записать(КореньОтбораSFile + "/only2/**");
		СоздатьКаталог(КореньОтбораSFile + "/only3");
		ДанныеОтбораSFile.Записать(КореньОтбораSFile + "/only3/***");
	КонецЕсли;

	МатрицаОтбораSFile(КореньОтбораSFile, "star", "star", "a*", "a\*", "a?");
	МатрицаОтбораSFile(КореньОтбораSFile, "prefix", "prefix", "*a", "\*a", "?a");
	МатрицаОтбораSFile(КореньОтбораSFile, "middle", "middle", "a*b", "a\*b", "a?b");
	МатрицаОтбораSFile(КореньОтбораSFile, "double", "double", "a**", "a\*\*", "a??");
	МатрицаОтбораSFile(КореньОтбораSFile, "only", "only", "*", "\*", "?");
	МатрицаОтбораSFile(КореньОтбораSFile, "extension", "extension", "a*.txt", "a\*.txt", "a?.txt");
	МатрицаОтбораSFile(КореньОтбораSFile, "tail3", "tail3", "ab*", "ab\*", "ab?");
	МатрицаОтбораSFile(КореньОтбораSFile, "tail4", "tail4", "abc*", "abc\*", "abc?");
	МатрицаОтбораSFile(КореньОтбораSFile, "leading3", "leading3", "*ab", "\*ab", "?ab");
	МатрицаОтбораSFile(КореньОтбораSFile, "leading4", "leading4", "*abc", "\*abc", "?abc");
	МатрицаОтбораSFile(КореньОтбораSFile, "inner4", "inner4", "ab*c", "ab\*c", "ab?c");
	МатрицаОтбораSFile(КореньОтбораSFile, "only2", "only2", "**", "\*\*", "??");
	МатрицаОтбораSFile(КореньОтбораSFile, "only3", "only3", "***", "\*\*\*", "???");
Исключение
	Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;

Если СвойКореньОтбораSFile И КореньОтбораSFile <> "" Тогда
	Попытка
		УдалитьФайлы(КореньОтбораSFile);
	Исключение
		Сообщить("file.cleanup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецЕсли;
Сообщить("file.end" + Символ(9) + "search-sfile-selection-1");
