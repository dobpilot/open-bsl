// Наблюдение носителя через Файл; чтение metadata не изменяет временные файлы.
Процедура СнимокНосителя(ИдентификаторНосителя, ИмяНосителя)
	Попытка
		ФайлНосителя = Новый Файл(ИмяНосителя);
		Если ФайлНосителя.Существует() Тогда
			ТекстНосителя = "1|" + Строка(ФайлНосителя.Размер());
		Иначе
			ТекстНосителя = "0";
		КонецЕсли;
		Сообщить(ИдентификаторНосителя + ".disk" + Символ(9) + ТекстНосителя);
	Исключение
		Сообщить(ИдентификаторНосителя + ".disk" + Символ(9) + "error:" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецПроцедуры

// Пробы временного потока; имена носителя запрашиваются динамически.
Процедура СнимокВременногоПотока(ИдентификаторПотока, ПотокПробы)
	Сообщить(ИдентификаторПотока + ".state" + Символ(9) + Строка(ТипЗнч(ПотокПробы)) + "|" + Строка(ПотокПробы.Размер()) + "|" + Строка(ПотокПробы.ТекущаяПозиция()));
	Попытка
		ИмяНосителяПробы = Вычислить("ПотокПробы.ИмяФайла");
		СнимокНосителя(ИдентификаторПотока, ИмяНосителяПробы);
		Сообщить(ИдентификаторПотока + ".name" + Символ(9) + Строка(ИмяНосителяПробы));
	Исключение
		Сообщить(ИдентификаторПотока + ".name" + Символ(9) + "error");
	КонецПопытки;
	Попытка
		ИмяНосителяПробы = Вычислить("ПотокПробы.ПолучитьИмяФайла()");
		Сообщить(ИдентификаторПотока + ".getname" + Символ(9) + Строка(ИмяНосителяПробы));
	Исключение
		Сообщить(ИдентификаторПотока + ".getname" + Символ(9) + "error");
	КонецПопытки;
КонецПроцедуры

Процедура ПробаВременногоПотока(ИдентификаторПотока, ВыражениеПотока, ОбъемПотока)
	ПотокПробы = Неопределено;
	Попытка
		ПотокПробы = Вычислить(ВыражениеПотока);
		ИмяЗакрываемогоНосителя = Вычислить("ПотокПробы.ИмяФайла");
		СнимокВременногоПотока(ИдентификаторПотока + ".new", ПотокПробы);
		БуферПробыПотока = Новый БуферДвоичныхДанных(ОбъемПотока);
		БуферПробыПотока[0] = 65;
		БуферПробыПотока[ОбъемПотока - 1] = 90;
		ПотокПробы.Записать(БуферПробыПотока, 0, ОбъемПотока - 1);
		СнимокВременногоПотока(ИдентификаторПотока + ".before", ПотокПробы);
		ПотокПробы.Записать(БуферПробыПотока, ОбъемПотока - 1, 1);
		СнимокВременногоПотока(ИдентификаторПотока + ".after", ПотокПробы);
		ПотокПробы.Перейти(0, ПозицияВПотоке.Начало);
		БуферЧтенияПробы = Новый БуферДвоичныхДанных(ОбъемПотока);
		ПрочитаноПробы = ПотокПробы.Прочитать(БуферЧтенияПробы, 0, ОбъемПотока);
		Сообщить(ИдентификаторПотока + ".read" + Символ(9) + Строка(ПрочитаноПробы) + "|" + Строка(БуферЧтенияПробы[0]) + "|" + Строка(БуферЧтенияПробы[ОбъемПотока - 1]));
		ПотокПробы.Закрыть();
		СнимокНосителя(ИдентификаторПотока + ".closed", ИмяЗакрываемогоНосителя);
		Попытка
			РазмерЗакрытойПробы = ПотокПробы.Размер();
			Сообщить(ИдентификаторПотока + ".closed" + Символ(9) + Строка(РазмерЗакрытойПробы));
		Исключение
			Сообщить(ИдентификаторПотока + ".closed" + Символ(9) + "error");
		КонецПопытки;
	Исключение
		Сообщить(ИдентификаторПотока + ".error" + Символ(9) + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если ПотокПробы <> Неопределено Тогда
		Попытка
			ПотокПробы.Закрыть();
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "temp-storage-1");
ПробаВременногоПотока("tempstream.default", "ФайловыеПотоки.СоздатьВременныйФайл()", 65536);
ПробаВременногоПотока("tempstream.zero", "ФайловыеПотоки.СоздатьВременныйФайл(0)", 1);
ПробаВременногоПотока("tempstream.one", "ФайловыеПотоки.СоздатьВременныйФайл(1)", 2);
ПробаВременногоПотока("tempstream.eight", "ФайловыеПотоки.СоздатьВременныйФайл(8)", 9);
ПробаВременногоПотока("tempstream.buffer.zero", "ФайловыеПотоки.СоздатьВременныйФайл(8, 0)", 9);
Сообщить("file.end" + Символ(9) + "temp-storage-1");
