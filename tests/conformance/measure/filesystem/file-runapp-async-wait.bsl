// Клиентские пробы запуска: только завершающиеся true/false и безопасный exit.
// Нет записи файлов и пользовательских приложений; неизвестные вызовы — через Вычислить.
Асинх Функция ПробаЗапускаАсинх(ИдЗапускаАсинх, ВыражениеЗапускаАсинх)
	СтадияЗапускаАсинх = "call";
	ТипОбещанияЗапуска = "none";
	Попытка
		ОбещаниеЗапуска = Вычислить(ВыражениеЗапускаАсинх);
		ТипОбещанияЗапуска = Строка(ТипЗнч(ОбещаниеЗапуска));
		СтадияЗапускаАсинх = "await";
		РезультатЗапуска = Ждать ОбещаниеЗапуска;
		СтадияЗапускаАсинх = "await-again";
		ПовторЗапуска = Ждать ОбещаниеЗапуска;
		ВыводЗапуска = "ok|type=" + Строка(ТипЗнч(РезультатЗапуска))
			+ "|value=" + Строка(РезультатЗапуска)
			+ "|repeat=" + ?(ПовторЗапуска = РезультатЗапуска, "1", "0");
	Исключение
		ОшибкаЗапуска = ИнформацияОбОшибке();
		ВыводЗапуска = "error|stage=" + СтадияЗапускаАсинх + "|" + ОшибкаЗапуска.Описание;
		Если ОшибкаЗапуска.Причина <> Неопределено Тогда
			ВыводЗапуска = ВыводЗапуска + "|cause=" + ОшибкаЗапуска.Причина.Описание;
		КонецЕсли;
	КонецПопытки;
	Сообщить(ИдЗапускаАсинх + Символ(9) + "promise=" + ТипОбещанияЗапуска + "|" + ВыводЗапуска);
	Возврат Неопределено;
КонецФункции

Асинх Процедура ИзмеритьЗапускАсинх()
	Сообщить("file.begin" + Символ(9) + "runapp-async-wait-1");
	Попытка
		Сообщить("context.compatibility" + Символ(9) + Строка(Вычислить("Метаданные.РежимСовместимости")));
	Исключение
		Сообщить("context.compatibility" + Символ(9) + "unavailable");
	КонецПопытки;
	Ждать ПробаЗапускаАсинх("runasyncwait.true", "RunAppAsync(""/usr/bin/true"", """", Истина)");
	Ждать ПробаЗапускаАсинх("runasyncwait.false", "RunAppAsync(""/usr/bin/false"", """", Истина)");
	Ждать ПробаЗапускаАсинх("runasyncwait.empty", "RunAppAsync("""", """", Истина)");
	Ждать ПробаЗапускаАсинх("runasyncwait.missing", "RunAppAsync(""/open-bsl-no-such-program-20260916"", """", Истина)");
	Ждать ПробаЗапускаАсинх("runasyncwait.cwd_missing", "RunAppAsync(""/usr/bin/true"", ""/open-bsl-no-such-cwd-20260916"", Истина)");
	Ждать ПробаЗапускаАсинх("runasyncwait.quoted", "RunAppAsync(""""""/usr/bin/false"""""", """", Истина)");
	Ждать ПробаЗапускаАсинх("runasyncwait.shell_exit", "RunAppAsync(""exit 17"", """", Истина)");
	Ждать ПробаЗапускаАсинх("runasyncwait.shell_sequence", "RunAppAsync(""/usr/bin/true ; /usr/bin/false"", """", Истина)");
	Ждать ПробаЗапускаАсинх("runasyncwait.omitted_wait", "RunAppAsync(""/usr/bin/false"", """", )");
	Ждать ПробаЗапускаАсинх("runasyncwait.nul", "RunAppAsync(""/usr/bin/true"" + Символ(0) + ""ignored"", """", Истина)");
	Сообщить("file.end" + Символ(9) + "runapp-async-wait-1");
	Попытка
		Выполнить("ЗавершитьРаботуСистемы(Ложь);");
	Исключение
	КонецПопытки;
КонецПроцедуры

ИзмеритьЗапускАсинх();
