Перем ЗавершенныхОповещений;
Перем ЗапускОповещенийЗакончен;
Перем КореньОповещений;

// Асинх-объявление выбирает клиентскую оболочку измерителя; ожидание не имитируется.
Асинх Процедура КлиентскийКонтекстОповещений()
КонецПроцедуры

Процедура ЗавершитьОповещенияКогдаГотово()
	Если Не ЗапускОповещенийЗакончен Или ЗавершенныхОповещений <> 8 Тогда
		Возврат;
	КонецЕсли;
	Попытка
		УдалитьФайлы(КореньОповещений);
	Исключение
		Сообщить("file.cleanup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Сообщить("file.end" + Символ(9) + "file-callbacks-1");
	Попытка
		Выполнить("ЗавершитьРаботуСистемы(Ложь)");
	Исключение
	КонецПопытки;
КонецПроцедуры

Процедура РезультатФайловогоОповещения(Знач РезультатПробы, Знач ДанныеОповещения = Неопределено) Экспорт
	Попытка
		ЧислоАргументовОповещения = 2;
		Если ДанныеОповещения = Неопределено Тогда
			ДанныеОповещения = РезультатПробы;
			РезультатПробы = Неопределено;
			ЧислоАргументовОповещения = 1;
		КонецЕсли;
		ТипРезультатаПробы = ТипЗнч(РезультатПробы);
		Если ТипРезультатаПробы = Тип("Булево") Тогда
			ПредставлениеПробы = ?(РезультатПробы, "1", "0");
		ИначеЕсли ТипРезультатаПробы = Тип("Файл") Тогда
			ПредставлениеПробы = СтрЗаменить(РезультатПробы.ПолноеИмя, КореньОповещений, "<root>");
		Иначе
			ПредставлениеПробы = Строка(РезультатПробы);
		КонецЕсли;
		Сообщить(ДанныеОповещения.Ид + ".result" + Символ(9) + "returned="
			+ ?(ДанныеОповещения.Вернулся, "1", "0") + "|argc=" + Строка(ЧислоАргументовОповещения) + "|type=" + Строка(ТипРезультатаПробы) + "|value=" + ПредставлениеПробы);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	ЗавершенныхОповещений = ЗавершенныхОповещений + 1;
	ЗавершитьОповещенияКогдаГотово();
КонецПроцедуры

Процедура ОшибкаФайловогоОповещения(Знач ПервыйАргумент, ВторойАргумент = Неопределено, Знач ТретийАргумент = Неопределено) Экспорт
	Сообщить("callback.error.arguments" + Символ(9) + Строка(ТипЗнч(ПервыйАргумент))
		+ "|" + Строка(ТипЗнч(ВторойАргумент)) + "|" + Строка(ТипЗнч(ТретийАргумент)));
	Если ТипЗнч(ВторойАргумент) = Тип("Булево") Тогда
		Сообщить("callback.error.flag" + Символ(9) + ?(ВторойАргумент, "1", "0"));
		ВторойАргумент = Ложь;
	КонецЕсли;
	Попытка
		ДанныеОповещения = ?(ТретийАргумент = Неопределено, ВторойАргумент, ТретийАргумент);
		Сообщить(ДанныеОповещения.Ид + ".error" + Символ(9) + "returned="
			+ ?(ДанныеОповещения.Вернулся, "1", "0"));
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	ЗавершенныхОповещений = ЗавершенныхОповещений + 1;
	ЗавершитьОповещенияКогдаГотово();
КонецПроцедуры

Процедура НачатьФайловуюПробу(ИдОповещения, ПутьОповещения, МетодОповещения, ИнициализацияОповещения)
	Попытка
		ФайлОповещения = Новый Файл(ПутьОповещения);
		ДанныеОповещения = Новый Структура("Ид,Вернулся", ИдОповещения, Ложь);
		ПодпискаОповещения = Вычислить("Новый ОписаниеОповещения(""РезультатФайловогоОповещения"", ЭтотОбъект, ДанныеОповещения, ""ОшибкаФайловогоОповещения"", ЭтотОбъект)");
		Сообщить(ИдОповещения + ".call" + Символ(9) + "begin");
		Если ИнициализацияОповещения Тогда
			Выполнить("ФайлОповещения." + МетодОповещения + "(ПодпискаОповещения, КореньОповещений + ""/new"");");
		Иначе
			Выполнить("ФайлОповещения." + МетодОповещения + "(ПодпискаОповещения);");
		КонецЕсли;
		ДанныеОповещения.Вернулся = Истина;
		Сообщить(ИдОповещения + ".return" + Символ(9) + "ok|path=" + СтрЗаменить(ФайлОповещения.ПолноеИмя, КореньОповещений, "<root>"));
	Исключение
		Сообщить(ИдОповещения + ".call_error" + Символ(9) + ИнформацияОбОшибке().Описание);
		ЗавершенныхОповещений = ЗавершенныхОповещений + 1;
	КонецПопытки;
КонецПроцедуры

ЗавершенныхОповещений = 0;
ЗапускОповещенийЗакончен = Ложь;
КореньОповещений = ПолучитьИмяВременногоФайла(".callbacks");
Сообщить("file.begin" + Символ(9) + "file-callbacks-1");
Попытка
	СоздатьКаталог(КореньОповещений);
	ДанныеФайлаОповещения = ПолучитьДвоичныеДанныеИзСтроки("abc", КодировкаТекста.UTF8, Ложь);
	ДанныеФайлаОповещения.Записать(КореньОповещений + "/a");
	НачатьФайловуюПробу("callback.exists.ru", КореньОповещений + "/a", "НачатьПроверкуСуществования", Ложь);
	НачатьФайловуюПробу("callback.exists.en", КореньОповещений + "/missing", "BeginCheckingExistence", Ложь);
	НачатьФайловуюПробу("callback.size.ru", КореньОповещений + "/a", "НачатьПолучениеРазмера", Ложь);
	НачатьФайловуюПробу("callback.size.en", КореньОповещений + "/missing", "BeginGettingSize", Ложь);
	НачатьФайловуюПробу("callback.init.ru", КореньОповещений + "/a", "НачатьИнициализацию", Истина);
	НачатьФайловуюПробу("callback.init.en", КореньОповещений + "/a", "BeginInitialization", Истина);
	НачатьФайловуюПробу("callback.readonly.ru", КореньОповещений + "/a", "НачатьПолучениеТолькоЧтения", Ложь);
	НачатьФайловуюПробу("callback.isdir.en", КореньОповещений, "BeginCheckingIsDirectory", Ложь);
Исключение
	Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
	ЗавершенныхОповещений = 8;
КонецПопытки;
ЗапускОповещенийЗакончен = Истина;
ЗавершитьОповещенияКогдаГотово();
