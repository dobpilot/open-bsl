// Клиентские глобальные методы; изменяется только собственное временное дерево.
Асинх Функция ПробаГлобалАсинх(ИдентификаторПробы, ВыражениеПробы, КореньПробы)
	СтадияПробы = "call";
	ТипОбещанияПробы = "none";
	Попытка
		ОбещаниеПробы = Вычислить(ВыражениеПробы);
		ТипОбещанияПробы = Строка(ТипЗнч(ОбещаниеПробы));
		СтадияПробы = "await";
		РезультатПробы = Ждать ОбещаниеПробы;
		ВыводПробы = "ok|" + Строка(ТипЗнч(РезультатПробы)) + "|value=" + СтрЗаменить(Строка(РезультатПробы), КореньПробы, "<root>");
	Исключение
		ОшибкаПробы = ИнформацияОбОшибке();
		ВыводПробы = "error|stage=" + СтадияПробы + "|" + ОшибкаПробы.Описание;
		Если ОшибкаПробы.Причина <> Неопределено Тогда
			ВыводПробы = ВыводПробы + "|cause=" + СтрЗаменить(ОшибкаПробы.Причина.Описание, КореньПробы, "<root>");
		КонецЕсли;
	КонецПопытки;
	Сообщить(ИдентификаторПробы + Символ(9) + "promise=" + ТипОбещанияПробы + "|" + ВыводПробы);
	Возврат Неопределено;
КонецФункции

Асинх Процедура ИзмеритьГлобалАсинх()
	КореньГлобалПробы = ПолучитьИмяВременногоФайла(".async-globals");
	Сообщить("file.begin" + Символ(9) + "file-async-globals-1");
	Попытка
		СоздатьКаталог(КореньГлобалПробы + "/mask/nest.txt");
		ДанныеГлобалПробы = ПолучитьДвоичныеДанныеИзСтроки("x", КодировкаТекста.UTF8, Ложь);
		ДанныеГлобалПробы.Записать(КореньГлобалПробы + "/parent-file");
		ДанныеГлобалПробы.Записать(КореньГлобалПробы + "/mask/a.txt");
		ДанныеГлобалПробы.Записать(КореньГлобалПробы + "/mask/b.bin");
		ДанныеГлобалПробы.Записать(КореньГлобалПробы + "/mask/nest.txt/inside");
		Ждать ПробаГлобалАсинх("mkdir.async.new", "СоздатьКаталогАсинх(КореньПробы + ""/new"")", КореньГлобалПробы);
		Ждать ПробаГлобалАсинх("mkdir.async.existing", "CreateDirectoryAsync(КореньПробы + ""/new"")", КореньГлобалПробы);
		Ждать ПробаГлобалАсинх("mkdir.async.slash", "СоздатьКаталогАсинх(КореньПробы + ""/slash/"")", КореньГлобалПробы);
		Ждать ПробаГлобалАсинх("mkdir.async.dot", "СоздатьКаталогАсинх(КореньПробы + ""/new/../dot"")", КореньГлобалПробы);
		Ждать ПробаГлобалАсинх("mkdir.async.parentfile", "СоздатьКаталогАсинх(КореньПробы + ""/parent-file/child"")", КореньГлобалПробы);
		Ждать ПробаГлобалАсинх("mkdir.async.undefined", "СоздатьКаталогАсинх(Неопределено)", КореньГлобалПробы);
		Ждать ПробаГлобалАсинх("delete.async.mask", "УдалитьФайлыАсинх(КореньПробы + ""/mask"", ""*.txt"")", КореньГлобалПробы);
		Сообщить("delete.async.remaining" + Символ(9) + Строка(НайтиФайлы(КореньГлобалПробы + "/mask", "*").Количество()));
		Ждать ПробаГлобалАсинх("delete.async.direct", "DeleteFilesAsync(КореньПробы + ""/new"")", КореньГлобалПробы);
		ФайлУдаленнойПробы = Новый Файл(КореньГлобалПробы + "/new");
		Сообщить("delete.async.direct.exists" + Символ(9) + ?(ФайлУдаленнойПробы.Существует(), "1", "0"));
		Ждать ПробаГлобалАсинх("delete.async.missing", "УдалитьФайлыАсинх(КореньПробы + ""/missing"")", КореньГлобалПробы);
		Ждать ПробаГлобалАсинх("delete.async.undefined", "УдалитьФайлыАсинх(Неопределено)", КореньГлобалПробы);
		Ждать ПробаГлобалАсинх("tempdir.async.ru", "КаталогВременныхФайловАсинх()", КореньГлобалПробы);
		Ждать ПробаГлобалАсинх("tempdir.async.en", "TempFilesDirAsync()", КореньГлобалПробы);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Попытка
		УдалитьФайлы(КореньГлобалПробы);
	Исключение
		Сообщить("file.cleanup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Сообщить("file.end" + Символ(9) + "file-async-globals-1");
	Попытка
		Выполнить("ЗавершитьРаботуСистемы(Ложь)");
	Исключение
	КонецПопытки;
КонецПроцедуры

ИзмеритьГлобалАсинх();
