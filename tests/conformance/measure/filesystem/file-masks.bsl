// Порядок результатов не сортируется. Внешний runner подставляет собственный
// подготовленный scratch, чтобы запись 1С не нормализовала необычные имена.
Процедура ВыводМаски(КодПробы, ТекстПробы)
	Сообщить(КодПробы + Символ(9) + ТекстПробы);
КонецПроцедуры

Процедура ПробаМаски(КодПробы, КореньПробы, МаскаПробы)
	Попытка
		НайденноеПробы = Вычислить("НайтиФайлы(КореньПробы, МаскаПробы)");
		ТекстПробы = Строка(НайденноеПробы.Количество());
		Для Каждого ФайлПробы Из НайденноеПробы Цикл
			ТекстПробы = ТекстПробы + "|" + ФайлПробы.Имя;
		КонецЦикла;
	Исключение
		ТекстПробы = "error:" + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	ВыводМаски(КодПробы, ТекстПробы);
КонецПроцедуры

ВыводМаски("file.begin", "1");
КореньМасокПробы = "__OPEN_BSL_PROBE_ROOT__";
СвойКореньМасок = Лев(КореньМасокПробы, 1) = "_";
Попытка
	Если СвойКореньМасок Тогда
		КореньМасокПробы = ПолучитьИмяВременногоФайла(".masks");
		Выполнить("СоздатьКаталог(КореньМасокПробы);");
		ДанныеМасокПробы = ПолучитьДвоичныеДанныеИзСтроки("ABC", КодировкаТекста.UTF8, Ложь);
		Для Каждого ИмяМасокПробы Из СтрРазделить("a|Z|1|я|漢|😀|.hidden|a*|a?|a\b|[|[x]|-|]", "|") Цикл
			ДанныеМасокПробы.Записать(КореньМасокПробы + "/" + ИмяМасокПробы);
		КонецЦикла;
	КонецЕсли;
	ВыводМаски("file.scratch", КореньМасокПробы);
	ПробаМаски("mask.01", КореньМасокПробы, "?");
	ПробаМаски("mask.02", КореньМасокПробы, "??");
	ПробаМаски("mask.03", КореньМасокПробы, "???");
	ПробаМаски("mask.04", КореньМасокПробы, "????");
	ПробаМаски("mask.05", КореньМасокПробы, "[a-z]");
	ПробаМаски("mask.06", КореньМасокПробы, "[!a-z]");
	ПробаМаски("mask.07", КореньМасокПробы, "[^a-z]");
	ПробаМаски("mask.08", КореньМасокПробы, "[[:alpha:]]");
	ПробаМаски("mask.09", КореньМасокПробы, "[а-я]");
	ПробаМаски("mask.10", КореньМасокПробы, "[");
	ПробаМаски("mask.11", КореньМасокПробы, "\?");
	ПробаМаски("mask.12", КореньМасокПробы, "a\*");
	ПробаМаски("mask.13", КореньМасокПробы, "a*");
	ПробаМаски("mask.14", КореньМасокПробы, "*.*");
	ПробаМаски("mask.15", КореньМасокПробы, "*");
	ПробаМаски("mask.16", КореньМасокПробы, "[[]x]");
	ПробаМаски("mask.17", КореньМасокПробы, "[a-]");
	ПробаМаски("mask.18", КореньМасокПробы, "[z-a]");
	ПробаМаски("mask.19", КореньМасокПробы, "[[]");
	ПробаМаски("mask.20", КореньМасокПробы, "[]]");
Исключение
	ВыводМаски("file.setup_error", ИнформацияОбОшибке().Описание);
КонецПопытки;
Если СвойКореньМасок Тогда
	Попытка
		УдалитьФайлы(КореньМасокПробы);
		ВыводМаски("file.cleanup", "ok");
	Исключение
		ВыводМаски("file.cleanup_error", ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецЕсли;
ВыводМаски("file.end", "1");
