// Контракт двоичных данных: что платформа делает там, где здесь поведение
// пока ВЫБРАНО, а не измерено.
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-binary.bsl
//
// Правила те же, что у соседних контрактов: строка `МЕТКА<таб>ЗНАЧЕНИЕ`,
// скрипт исполняется И НАШИМ интерпретатором, сличение построчное. Строк
// `М()` здесь нет намеренно: реестру открытых вопросов этот файл ничего не
// должен — на единственный заведённый вопрос области строка уже стоит в
// `measure-all.bsl`, а правило реестра — ровно одна строка на ИД по ВСЕМ
// скриптам каталога. По той же причине здесь нет литералов из заглавной
// латиницы с точкой: сканер реестра читает такой литерал как ИД, где бы он
// ни стоял, а не только в аргументе `М()`.
//
// `.expected` у этого файла нет и быть не должно: контракт сличается
// вручную, а `.expected` втянул бы его в
// `conformance_fixtures_match_oracle_output` и покрасил бы известные
// расхождения в красное.
//
// ИМЯ ПЕРЕМЕННОЙ, СТОИВШЕЕ ДВУХ ПРОГОНОВ. Скрипт замеров исполняется в
// модуле УПРАВЛЯЕМОЙ ФОРМЫ, и имя, совпадающее со свойством формы,
// достаётся форме, а не телу процедуры. Строка `Ширина = "";` — это
// присваивание пустой строки ШИРИНЕ ФОРМЫ: платформа отвечает не ловимым
// исключением, а модальным окном, то есть пустым выводом и таймаутом в
// 180 секунд. Отсюда `ШиринаЗнаков` ниже и `Ширина40`/`Ширина5000` в
// `measure-all.bsl`. Проверено разностной пробой: тот же скрипт, где
// отличается ТОЛЬКО имя, отрабатывает и печатает все строки.
//
// МАШИНОЗАВИСИМАЯ СТРОКА — «байты Системная». Кодировка «Системная» идёт за
// локалью системы: на машине оракула (`ru_RU.UTF-8`) платформа дала
// UTF-8-байты `208 144 208 177`, а не кодовую страницу. На машине с другой
// локалью строка разойдётся с оракулом, и это смена исходных данных пробы,
// а не регрессия — та же оговорка, что у фикстуры `json-dates.expected` про
// часовой пояс. Соседняя «байты ANSI» от локали НЕ зависит: windows-1251
// платформа даёт и на UTF-8-системе.
//
// ЧЕГО ЗДЕСЬ НЕТ И ЧЕГО СЮДА НЕЛЬЗЯ ДОБАВЛЯТЬ. Ниже — пробы, которые
// уносят не свою строку, а ВЕСЬ сеанс: платформа не бросает исключение, а
// умирает молча, и `Попытка` такое не ловит. Каждая стоила прогона:
//
//   * запись в байт значения вне `0..255` и дробного (`Б[1] = 256`,
//     `Б[1] = 2.9`);
//   * мусор вместо порядка байтов (`Б.ПрочитатьЦелое16(0, 5)`);
//   * `Записать` на позиции у 2^64 (измерено отдельно, см. шапку
//     `measure-stream.bsl`: клиент снимается по SIGSEGV);
//   * конструктор буфера огромного размера — это попытка выделить на
//     платформе гигабайты.
//
// ПОЧЕМУ ЧЕРЕЗ `Вычислить`. Методов `Скопировать` и `ПолучитьСрез` у буфера
// здесь нет вовсе, а неизвестное имя метода наш резолвер отвергает НА ЭТАПЕ
// КОМПИЛЯЦИИ — прямая проба сломала бы не строку, а весь скрипт на нашей
// стороне. Внутри `Вычислить` фрагмент компилируется во время исполнения, и
// отказ становится ловимым. Приёмник пробы — переменная МОДУЛЯ (`Перем`
// ниже): локальных переменных вызывающей процедуры `Вычислить` в модуле
// формы не видит, а область модуля видит (якорь `SCOPE.MODULE_VARS_IN_EXEC`
// в `measure-all.bsl`).
//
// РАСХОЖДЕНИЯ С ПЛАТФОРМОЙ. Снято 08.08.2026, 8.3.27.2074. Каждая строка
// `diff` выписана здесь поимённо; чинить реализацию под них — отдельные
// задачи, эта только измеряет. Из одиннадцати строк разошлись пять:
//
//   1. «обход буфера»: платформа — `итераций 4, первый Число 208`, здесь —
//      `<ошибка>`. Обход буфера платформа ПРИНИМАЕТ и отдаёт байты числами;
//      у нас `collection_len` на буфере даёт ошибку (`bsl-rt/src/lib.rs`,
//      ветка `BslObject::BinaryBuffer`, где это и записано как незаведённое).
//   2. «буфер Скопировать»: платформа — `принято Буфер двоичных данных`,
//      здесь — `<ошибка>`. Метода нет.
//   3. «буфер ПолучитьСрез»: платформа — `принято Буфер двоичных данных`,
//      здесь — `<ошибка>`. Метода нет.
//   4. «байты Системная»: платформа — `[208 144 208 177]`, здесь —
//      `[192 225]`. Здесь «Системная» и ANSI сведены в одну windows-1251
//      (`bsl-rt/src/binbuf.rs`, `encoding_arg`), а у платформы «Системная»
//      идёт за локалью системы и на этой машине означает UTF-8. Про
//      машинозависимость — оговорка выше.
//   5. «разбор 5000 знаков»: платформа — `309 знаков, начало
//      839555017536731758113448, конец 033861619420`, здесь — `6021 знаков,
//      начало 398027684033796659235430, конец 663406309375`. Это тот же
//      ответ, что закрыл вопрос о ширине разбора в `measure-all.bsl`, но
//      показанный числом, а не длиной. Видно главное: за своим потолком
//      платформа не ошибается и не усекает разряды — она отдаёт ЧУЖОЕ
//      число, не равное ни точному значению (6021 знак), ни его хвосту, ни
//      его началу. Что это за число, проба не выясняет.
//
// Шесть сошедшихся строк: «обход двоичных данных» (`<ошибка>` с обеих
// сторон — не коллекция и у платформы), «байты ANSI», «буфер из числа»,
// «буфер сигнатура числом», «ЗаписатьJSON от данных», «ЗаписатьJSON от
// буфера».

Перем БуферПробы;
Перем ДанныеПробы;

Процедура П(Метка, Значение)
	Сообщить(Метка + Символ(9) + Значение);
КонецПроцедуры

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

// Побайтовый дамп буфера — тот же вид, что в фикстурах `binary-buffer` и
// `binary-strings`: у буфера `Размер` — СВОЙСТВО, а не метод.
Функция Дамп(Б)
	С = "";
	Для н = 0 По Б.Размер - 1 Цикл
		С = С + Ч(Б[н]) + " ";
	КонецЦикла;
	Возврат "[" + СокрЛП(С) + "]";
КонецФункции

// Проба выражения, которое у нас может не скомпилироваться. Печатается и
// ТИП результата: «принято» без типа не отличает буфер от строки.
Функция Проба(Выражение)
	Попытка
		Р = Вычислить(Выражение);
		Если ТипЗнч(Р) = Тип("Число") Тогда
			Возврат "принято Число " + Ч(Р);
		КонецЕсли;
		Возврат "принято " + Строка(ТипЗнч(Р));
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
КонецФункции

// Обход `Для Каждого`: сколько итераций и что приходит на первой. Печать
// самого элемента — во вложенной `Попытка`: если он не приводится к
// строке, потерять надо эту подробность, а не весь счёт итераций.
Функция Обход(Коллекция)
	Счёт = 0;
	ПервыйТип = "";
	ПервоеЗначение = "";
	Попытка
		Для Каждого Элемент Из Коллекция Цикл
			Если Счёт = 0 Тогда
				ПервыйТип = Строка(ТипЗнч(Элемент));
				Попытка
					ПервоеЗначение = Строка(Элемент);
				Исключение
					ПервоеЗначение = "<не печатается>";
				КонецПопытки;
			КонецЕсли;
			Счёт = Счёт + 1;
		КонецЦикла;
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат "итераций " + Ч(Счёт) + ", первый " + ПервыйТип + " " + ПервоеЗначение;
КонецФункции

Функция ВJSON(Значение)
	Попытка
		З = Новый ЗаписьJSON;
		З.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
		ЗаписатьJSON(З, Значение);
		Возврат "принято " + З.Закрыть();
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
КонецФункции

// «Аб» в UTF-8 без сигнатуры — четыре байта, `208 144 208 177`. Обе
// величины кладутся в переменные МОДУЛЯ: их читает `Вычислить` ниже.
БуферПробы = ПолучитьБуферДвоичныхДанныхИзСтроки("Аб", КодировкаТекста.UTF8, Ложь);
ДанныеПробы = ПолучитьДвоичныеДанныеИзСтроки("Аб", КодировкаТекста.UTF8, Ложь);

// --- обход коллекций -------------------------------------------------
// Платформа обход буфера принимает — а что отдаёт на итерации, байт или
// что-то ещё, не мерилось. У `ДвоичныеДанные` не мерилось и само согласие.

П("обход буфера", Обход(БуферПробы));
П("обход двоичных данных", Обход(ДанныеПробы));

// --- методы буфера, которых здесь нет ---------------------------------

П("буфер Скопировать", Проба("БуферПробы.Скопировать()"));
П("буфер ПолучитьСрез", Проба("БуферПробы.ПолучитьСрез(0, 2)"));

// --- кодировка «Системная» против ANSI --------------------------------
// Здесь обе сведены в windows-1251 (`bsl-rt/src/binbuf.rs`, `encoding_arg`),
// но измерена из них только ANSI. Про машинозависимость — шапка.

Рез = "<ошибка>";
Попытка
	СисБуфер = ПолучитьБуферДвоичныхДанныхИзСтроки("Аб", КодировкаТекста.Системная, Ложь);
	Рез = Дамп(СисБуфер);
Исключение
	Рез = "<ошибка>";
КонецПопытки;
П("байты Системная", Рез);

Рез = "<ошибка>";
Попытка
	АнсиБуфер = ПолучитьБуферДвоичныхДанныхИзСтроки("Аб", КодировкаТекста.ANSI, Ложь);
	Рез = Дамп(АнсиБуфер);
Исключение
	Рез = "<ошибка>";
КонецПопытки;
П("байты ANSI", Рез);

// --- негодные типы аргументов буферной функции ------------------------
// Четвёрка строка<->байты меряна фикстурой `binary-strings` только со
// стороны `ДвоичныеДанные`; у буферной эти два отказа не зафиксированы.

П("буфер из числа", Проба("ПолучитьБуферДвоичныхДанныхИзСтроки(5)"));
П("буфер сигнатура числом", Проба("ПолучитьБуферДвоичныхДанныхИзСтроки(""Аб"", КодировкаТекста.UTF8, 1)"));

// --- двоичное внутри JSON ----------------------------------------------
// Здесь оба вида уходят в «несериализуемые» (`bsl-rt/src/json.rs`,
// `needs_convert`), и без функции преобразования это ошибка. Не измерено.

П("ЗаписатьJSON от данных", ВJSON(ДанныеПробы));
П("ЗаписатьJSON от буфера", ВJSON(БуферПробы));

// --- спутник якоря по ширине разбора -----------------------------------
// `measure-all.bsl` спрашивает про ДЛИНУ десятичной записи и получает 309
// знаков на пяти тысячах знаков `F` (2^20000-1, у нас 6021 знак). Одна
// длина не говорит, ЧТО платформа отдала за своим потолком, — здесь видно
// само число с обоих концов.

ШиринаЗнаков = "";
Для Шаг = 1 По 5000 Цикл
	ШиринаЗнаков = ШиринаЗнаков + "F";
КонецЦикла;

Рез = "<ошибка>";
Попытка
	Разобрано = ЧислоИзШестнадцатеричнойСтроки("0x" + ШиринаЗнаков);
	ТекстЧисла = Ч(Разобрано);
	Рез = Ч(СтрДлина(ТекстЧисла)) + " знаков, начало " + Лев(ТекстЧисла, 24)
		+ ", конец " + Прав(ТекстЧисла, 12);
Исключение
	Рез = "<ошибка>";
КонецПопытки;
П("разбор 5000 знаков", Рез);
