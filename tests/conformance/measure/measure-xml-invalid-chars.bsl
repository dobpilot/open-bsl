// Контракт глобальной функции очистки XML-текста, используемой Connector.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + ?(Значение, "true", "false"));
КонецПроцедуры

Процедура П(Ид, Выражение)
	Результат = Истина;
	Попытка
		Результат = Вычислить(Выражение);
	Исключение
	КонецПопытки;
	М(Ид, Результат);
КонецПроцедуры

М("XML.INVALID.EMPTY", НайтиНедопустимыеСимволыXML(""));
М("XML.INVALID.TEXT", НайтиНедопустимыеСимволыXML("абв"));
М("XML.INVALID.WHITESPACE", НайтиНедопустимыеСимволыXML(Символ(9) + Символ(10) + Символ(13)));
М("XML.INVALID.NUL", НайтиНедопустимыеСимволыXML(Символ(0)));
М("XML.INVALID.CONTROL_1", НайтиНедопустимыеСимволыXML(Символ(1)));
М("XML.INVALID.CONTROL_31", НайтиНедопустимыеСимволыXML(Символ(31)));
М("XML.INVALID.FFFE", НайтиНедопустимыеСимволыXML(Символ(65534)));
М("XML.INVALID.FFFF", НайтиНедопустимыеСимволыXML(Символ(65535)));
М("XML.INVALID.EMOJI", НайтиНедопустимыеСимволыXML("😀"));
П("XML.INVALID.ENGLISH_ALIAS", "FindDisallowedXMLCharacters(""text"")");
