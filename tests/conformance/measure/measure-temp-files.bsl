// Контракт временных путей и файловой записи, которые использует Connector 2.6.0.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция БулевоСтрокой(Значение)
	Если Значение Тогда
		Возврат "true";
	КонецЕсли;
	Возврат "false";
КонецФункции

ПутьДанных = ПолучитьИмяВременногоФайла(".bin");
М("TEMPFILE.SUFFIX", БулевоСтрокой(Прав(ПутьДанных, 4) = ".bin"));
М("TEMPFILE.SEPARATOR", ПолучитьРазделительПути());

СостояниеДоЗаписи = "<нет>";
Попытка
	ДанныеДоЗаписи = Новый ДвоичныеДанные(ПутьДанных);
	СостояниеДоЗаписи = Строка(ДанныеДоЗаписи.Размер());
Исключение
КонецПопытки;
М("TEMPFILE.PRECREATED", СостояниеДоЗаписи);

ДанныеА = ПолучитьДвоичныеДанныеИзСтроки("A", КодировкаТекста.UTF8, Ложь);
ДанныеА.Записать(ПутьДанных);
М("BINARYDATA.WRITE.INITIAL",
	ПолучитьHexСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(ПутьДанных)));

ДанныеБВ = ПолучитьДвоичныеДанныеИзСтроки("BC", КодировкаТекста.UTF8, Ложь);
ДанныеБВ.Записать(ПутьДанных);
М("BINARYDATA.WRITE.OVERWRITE",
	ПолучитьHexСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(ПутьДанных)));

УдалитьФайлы(ПутьДанных);
СостояниеПослеУдаления = "<нет>";
Попытка
	ДанныеПослеУдаления = Новый ДвоичныеДанные(ПутьДанных);
	СостояниеПослеУдаления = Строка(ДанныеПослеУдаления.Размер());
Исключение
КонецПопытки;
М("DELETEFILES.FILE", СостояниеПослеУдаления);
ПовторноеУдаление = Истина;
Попытка
	УдалитьФайлы(ПутьДанных);
Исключение
	ПовторноеУдаление = Ложь;
КонецПопытки;
М("DELETEFILES.MISSING", БулевоСтрокой(ПовторноеУдаление));
КлассУдаления = "функция";
Попытка
	Выполнить("РезультатУдаления = УдалитьФайлы(ПутьДанных);");
Исключение
	КлассУдаления = "процедура";
КонецПопытки;
М("DELETEFILES.CALL_KIND", КлассУдаления);

// Архиватор создаёт дерево без дополнительной глобальной функции создания
// каталога. После рекурсивного удаления тот же путь должен стать пригоден
// для обычного файла архива.
ПутьИсточника = ПолучитьИмяВременногоФайла(".txt");
ПутьАрхива = ПолучитьИмяВременногоФайла(".zip");
ПутьДерева = ПолучитьИмяВременногоФайла();
ДанныеА.Записать(ПутьИсточника);
ПисательАрхива = Новый ЗаписьZipФайла(ПутьАрхива);
ПисательАрхива.Добавить(ПутьИсточника, РежимСохраненияПутейZIP.НеСохранятьПути);
ПисательАрхива.Записать();
ЧитательАрхива = Новый ЧтениеZipФайла(ПутьАрхива);
ЧитательАрхива.ИзвлечьВсе(ПутьДерева);
ЧитательАрхива.Закрыть();
УдалитьФайлы(ПутьДерева);

ДеревоУдалено = Ложь;
Попытка
	ПроверочныйАрхив = Новый ЗаписьZipФайла(ПутьДерева);
	ПроверочныйАрхив.Добавить(
		ПутьИсточника, РежимСохраненияПутейZIP.НеСохранятьПути);
	ПроверочныйАрхив.Записать();
	ДеревоУдалено = Истина;
Исключение
КонецПопытки;
М("DELETEFILES.TREE", БулевоСтрокой(ДеревоУдалено));

УдалитьФайлы(ПутьИсточника);
УдалитьФайлы(ПутьАрхива);
УдалитьФайлы(ПутьДерева);
