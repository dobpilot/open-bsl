// Замер верхнего края позиции в потоке: докуда `Перейти` доводит позицию и
// что при этом становится с размером.
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-stream.bsl
//
// Правила те же, что у соседних контрактов: строка `МЕТКА<таб>ЗНАЧЕНИЕ`,
// скрипт исполняется И НАШИМ интерпретатором, сличение построчное. Меток в
// виде ИД здесь нет намеренно: реестру открытых вопросов этот файл ничего
// не должен — край ИЗМЕРЕН, а не выбран рассуждением.
//
// ЧЕГО ЗДЕСЬ НЕТ И ЧЕГО СЮДА НЕЛЬЗЯ ДОБАВЛЯТЬ. Пробы `Записать` на позиции
// у 2^64. Платформа 8.3.27.2074 на ней НЕ бросает исключение, а ПАДАЕТ:
// клиент `1cv8` снимается сигналом SIGSEGV примерно через 18 секунд после
// старта, файл вывода остаётся пустым, и `Попытка` такое не ловит.
// Измерено 08.08.2026 отдельным прогоном: скрипт, отличающийся от этого
// только добавленным
//
//     Пам.Записать(Новый БуферДвоичныхДанных(4), 0, 4);
//
// после двух переходов ниже, роняет платформу; без этой строки тот же
// скрипт отрабатывает и печатает всё. Поэтому такая проба не может жить ни
// в одном скрипте замеров: она убивает не свою строку, а весь сеанс — и в
// `measure-all.bsl` ей тем более не место.
//
// Что из этого следует для реализации: копировать у платформы на этом краю
// нечего, и ловимая ошибка (`bsl-rt/src/stream.rs`, `write`) — не выбор
// между вариантами, а единственное поведение лучше падения.

Процедура П(Метка, Значение)
	Сообщить(Метка + Символ(9) + Значение);
КонецПроцедуры

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

// Уход за конец разрешён и размера не меняет (измерено, фикстура
// `binary-streams`), а смещение — обычное число: два перехода по
// 9223372036854775807 доводят позицию до 2^64 - 2.

Пам = Новый ПотокВПамяти;

Р = "";
Попытка
	Р = "принято " + Ч(Пам.Перейти(9223372036854775807, ПозицияВПотоке.Начало));
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("переход на 2^63-1 от начала", Р);

Р = "";
Попытка
	Р = "принято " + Ч(Пам.Перейти(9223372036854775807, ПозицияВПотоке.Текущая));
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("ещё столько же от текущей", Р);

П("позиция у края", Ч(Пам.ТекущаяПозиция()));
П("размер от переходов не вырос", Ч(Пам.Размер()));
