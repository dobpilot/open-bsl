// --- ПЯТЫЙ ЗАХОД: типы САМОЙ СХЕМЫ на чтении -------------------------------
//
// Составной тип схемы платформа читать отказалась («Отсутствует
// отображение для типа '{urn:test}RootType'»). Вопрос, который это
// оставило: а СВОЙ ПРОСТОЙ тип — ограничение `xs:string`, список,
// простое содержимое — она читает как его базовый тип или отвергает так же?

П("чт свой простой тип", Сбор("Попытка НовыйЧитатель(""<Code xmlns=""""urn:test"""">аб</Code>""); Р = Сер.ПрочитатьXML(Чтр); Соб = Строка(ТипЗнч(Р)) + "" ["" + Строка(Р) + ""]""; Исключение Соб = ОписаниеОшибки(); КонецПопытки;"));
П("чт свой списочный тип", Сбор("Попытка НовыйЧитатель(""<Codes xmlns=""""urn:test"""">1 2 3</Codes>""); Р = Сер.ПрочитатьXML(Чтр); Соб = Строка(ТипЗнч(Р)); Исключение Соб = ОписаниеОшибки(); КонецПопытки;"));
П("чт своё простое содержимое", Сбор("Попытка НовыйЧитатель(""<SimpContent xmlns=""""urn:test"""" su=""""х"""">12.5</SimpContent>""); Р = Сер.ПрочитатьXML(Чтр); Соб = Строка(ТипЗнч(Р)) + "" ["" + Строка(Р) + ""]""; Исключение Соб = ОписаниеОшибки(); КонецПопытки;"));
П("чт своим типом через xsi:type", Сбор("Попытка НовыйЧитатель(""<мой xmlns:t=""""urn:test"""" xmlns:xsi=""""http://www.w3.org/2001/XMLSchema-instance"""" xsi:type=""""t:Code"""">аб</мой>""); Р = Сер.ПрочитатьXML(Чтр); Соб = Строка(ТипЗнч(Р)) + "" ["" + Строка(Р) + ""]""; Исключение Соб = ОписаниеОшибки(); КонецПопытки;"));

// --- ШЕСТОЙ ЗАХОД: объявления при своём URI и оба `Неопределено` -----------
//
// Пробы дописаны В КОНЕЦ намеренно: номера строк снимка цитируются в коде
// и в разборе, вставка в середину сдвинула бы их все. Оба угла до сих пор
// решались рассуждением. Первый: объявляет ли платформа `xmlns:xsi`, когда
// пользовательский URI РАВЕН пространству экземпляров XML Schema, — во всех
// прежних строках снимка это объявление есть, но там URI был чужой.
// Второй: `Неопределено` СРАЗУ в обоих аргументах — соседи измерены
// порознь (имя `Неопределено` без URI даёт умолчание, имя `Неопределено`
// с URI — отказ «Несоответствие типов (параметр номер '4')»).

П("зап URI как у xsi", Сбор("Попытка НовыйПисатель(); Сер.ЗаписатьXML(Зпис, 42, ""мой"", ""http://www.w3.org/2001/XMLSchema-instance""); Соб = Зпис.Закрыть(); Исключение Соб = ОписаниеОшибки(); КонецПопытки;"));
П("зап имя и URI Неопределено", Сбор("Попытка НовыйПисатель(); Сер.ЗаписатьXML(Зпис, 42, Неопределено, Неопределено); Соб = Зпис.Закрыть(); Исключение Соб = ОписаниеОшибки(); КонецПопытки;"));
// Тот же URI, но со значением, которому нужен `xsi:nil`: если платформа и
// здесь не объявляет `xsi`, то префикс у пометки остаётся необъявленным —
// как у измеренного `<t:мой>` (строка 109).
П("зап URI как у xsi с nil", Сбор("Попытка НовыйПисатель(); Сер.ЗаписатьXML(Зпис, Неопределено, ""мой"", ""http://www.w3.org/2001/XMLSchema-instance""); Соб = Зпис.Закрыть(); Исключение Соб = ОписаниеОшибки(); КонецПопытки;"));
// Та же проба на втором уровне: порождённый префикс фабрики измерен как
// `d<глубина>p<номер>`, и здесь проверяется, что сериализатор считает
// глубину так же — по ДОКУМЕНТУ, включая элемент, открытый вызывающим.
П("зап URI как у xsi с nil внутри", Сбор("Попытка НовыйПисатель(); Зпис.ЗаписатьНачалоЭлемента(""об""); Сер.ЗаписатьXML(Зпис, Неопределено, ""мой"", ""http://www.w3.org/2001/XMLSchema-instance""); Зпис.ЗаписатьКонецЭлемента(); Соб = Зпис.Закрыть(); Исключение Соб = ОписаниеОшибки(); КонецПопытки;"));
