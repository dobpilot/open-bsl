// Контракт `СериализаторXDTO` на 8.3.27: конструктор, состав членов и
// формы записи значений BSL через фабрику, построенную из ФАЙЛА XSD.
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-xdto-serializer.bsl
//
// Правила те же, что у `measure-xdto.bsl` и `measure-xdto-io.bsl`: строка
// `МЕТКА<таб>ЗНАЧЕНИЕ`, всё рискованное — через `Вычислить`/`Выполнить`
// внутри `Попытка`, приёмники проб — переменные МОДУЛЯ, одна проба на
// строку.
//
// ИМЯ `Ф` ЗАНЯТО ОБВЯЗКОЙ ЗАМЕРОВ: генератор модуля формы держит в `Ф`
// свою `ЗаписьТекста`, поэтому фабрика здесь — `Фаб`, сериализатор — `Сер`,
// писатель — `Зпис`.
//
// ПОСТРОЧНОГО ПАРИТЕТА С ЭТИМ ИНТЕРПРЕТАТОРОМ ЗДЕСЬ НЕТ И НЕ ПЛАНИРУЕТСЯ:
// половина проб спрашивает про члены, которых у этой реализации нет вовсе
// (`XMLТип`, `ВозможностьЧтенияXML`, глобальный `СериализаторXDTO` над
// метаданными конфигурации), и они честно отвечают `<ошибка>` с обеих
// сторон только после реализации задачи. Снимок односторонний: он
// говорит, ЧТО должно получиться.
//
// ЗАЧЕМ ФАЙЛ СХЕМЫ. `СоздатьФабрикуXDTO` берёт только путь к XSD
// (измерено), а `Новый ФабрикаXDTO` — только `НаборСхемXML`. Путь к файлу
// работает по обе стороны, поэтому схема пишется во временный файл.

Перем Фаб;
Перем Сер;
Перем Соб;
Перем Чтр;
Перем Зпис;
Перем ОбП;
Перем ТипКорня;
Перем ТекстСхемы;
Перем ПутьСхемы;
Перем НСXSD;

Процедура П(Метка, Значение)
	Сообщить(Метка + Символ(9) + Значение);
КонецПроцедуры

Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Р = СтрЗаменить(Р, Символ(10), "<ПС>");
	Р = СтрЗаменить(Р, Символ(9), "<Т>");
	Возврат Р;
КонецФункции

// Проба ВЫРАЖЕНИЯ: тип результата и его строковое представление.
Функция Ч(Выражение)
	Попытка
		Р = Вычислить(Выражение);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Попытка
		Возврат Строка(ТипЗнч(Р)) + " [" + Видимо(Строка(Р)) + "]";
	Исключение
		Возврат Строка(ТипЗнч(Р)) + " <не печатается>";
	КонецПопытки;
КонецФункции

// Сбор в модульную переменную `Соб`.
Функция Сбор(Код)
	Попытка
		Соб = "";
		Выполнить(Код);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат Видимо(Соб);
КонецФункции

// Читатель над текстом — приёмник модульный, чтобы пробы `Вычислить`
// видели его по имени.
Процедура НовыйЧитатель(Текст)
	Чтр = Новый ЧтениеXML;
	Чтр.УстановитьСтроку(Текст);
КонецПроцедуры

// Писатель в строку — тот же приём.
Процедура НовыйПисатель()
	Зпис = Новый ЗаписьXML;
	Зпис.УстановитьСтроку();
КонецПроцедуры

// --- схема ----------------------------------------------------------------

НСXSD = "http://www.w3.org/2001/XMLSchema";

ТекстСхемы = "<?xml version=""1.0"" encoding=""UTF-8""?>"
	+ "<xs:schema xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:t=""urn:test"""
	+ " targetNamespace=""urn:test"" elementFormDefault=""qualified"""
	+ " attributeFormDefault=""unqualified"">"
	+ "<xs:element name=""root"" type=""t:RootType""/>"
	+ "<xs:simpleType name=""Code""><xs:restriction base=""xs:string""/></xs:simpleType>"
	+ "<xs:simpleType name=""Codes""><xs:list itemType=""xs:int""/></xs:simpleType>"
	+ "<xs:complexType name=""SimpContent""><xs:simpleContent>"
	+ "<xs:extension base=""xs:decimal""><xs:attribute name=""su"" type=""xs:string""/>"
	+ "</xs:extension></xs:simpleContent></xs:complexType>"
	+ "<xs:complexType name=""RootType""><xs:sequence>"
	+ "<xs:element name=""name"" type=""xs:string""/>"
	+ "<xs:element name=""num"" type=""xs:int"" minOccurs=""0""/>"
	+ "</xs:sequence>"
	+ "<xs:attribute name=""id"" type=""xs:int""/>"
	+ "</xs:complexType>"
	+ "</xs:schema>";

ПутьСхемы = "/tmp/open-bsl-measure-xdto-serializer.xsd";
Попытка
	Зпс = Новый ЗаписьТекста(ПутьСхемы);
	Зпс.Записать(ТекстСхемы);
	Зпс.Закрыть();
Исключение
КонецПопытки;

П("схема записана", Ч("ПутьСхемы"));
Попытка
	Фаб = СоздатьФабрикуXDTO(ПутьСхемы);
	ТипКорня = Фаб.Тип("urn:test", "RootType");
Исключение
КонецПопытки;
П("фабрика", Ч("Фаб"));
П("тип корня", Ч("ТипКорня"));

// --- конструктор ----------------------------------------------------------

П("сер новый без скобок", Ч("Новый СериализаторXDTO"));
П("сер новый пустые скобки", Ч("Новый СериализаторXDTO()"));
П("сер новый с фабрикой", Ч("Новый СериализаторXDTO(Фаб)"));
П("сер новый два аргумента", Ч("Новый СериализаторXDTO(Фаб, Фаб)"));
П("сер новый строкой", Ч("Новый СериализаторXDTO(""urn:test"")"));
П("сер новый числом", Ч("Новый СериализаторXDTO(5)"));
П("сер новый типом", Ч("Новый СериализаторXDTO(ТипКорня)"));
П("сер новый англ", Ч("Новый XDTOSerializer(Фаб)"));
П("сер тип по имени", Ч("Тип(""СериализаторXDTO"")"));
П("сер тип по имени англ", Ч("Тип(""XDTOSerializer"")"));

// Через `Выполнить`, а не прямым оператором: этот интерпретатор обязан
// исполнить весь скрипт, а неизвестный `Новый` он отвергает на РАЗБОРЕ, то
// есть ронял бы не пробу, а весь прогон.
Попытка
	Выполнить("Сер = Новый СериализаторXDTO(Фаб);");
Исключение
КонецПопытки;

П("сер ЗначениеЗаполнено", Ч("ЗначениеЗаполнено(Сер)"));
П("сер два не равны", Ч("Строка(Новый СериализаторXDTO(Фаб) = Новый СериализаторXDTO(Фаб))"));

// --- глобальный сериализатор конфигурации ---------------------------------

П("глоб сер", Ч("СериализаторXDTO"));
П("глоб сер фабрика", Ч("СериализаторXDTO.ФабрикаXDTO"));
П("глоб зап числа", Сбор("НовыйПисатель(); СериализаторXDTO.ЗаписатьXML(Зпис, 42); Соб = Зпис.Закрыть();"));
П("глоб зап строки", Сбор("НовыйПисатель(); СериализаторXDTO.ЗаписатьXML(Зпис, ""аб""); Соб = Зпис.Закрыть();"));
П("глоб зап массива", Сбор("НовыйПисатель(); М = Новый Массив; М.Добавить(1); М.Добавить(""аб""); СериализаторXDTO.ЗаписатьXML(Зпис, М); Соб = Зпис.Закрыть();"));
П("глоб зап структуры", Сбор("НовыйПисатель(); С = Новый Структура(""а,б"", 1, ""вг""); СериализаторXDTO.ЗаписатьXML(Зпис, С); Соб = Зпис.Закрыть();"));

// --- члены ----------------------------------------------------------------

П("сер ФабрикаXDTO", Ч("Сер.ФабрикаXDTO"));
П("сер XDTOFactory", Ч("Сер.XDTOFactory"));
П("сер фабрика та же", Ч("Строка(Сер.ФабрикаXDTO = Фаб)"));
П("сер фабрика на запись", Сбор("Сер.ФабрикаXDTO = Фаб; Соб = ""присвоено"";"));
П("сер посторонний член", Ч("Сер.Ерунда"));
П("сер XMLТип", Ч("Сер.XMLТип(Тип(""Строка""))"));
П("сер XMLТипЗнч", Ч("Сер.XMLТипЗнч(""аб"")"));
П("сер XMLЗначение", Ч("Сер.XMLЗначение(Тип(""Число""), ""42"")"));
П("сер XMLСтрока", Ч("Сер.XMLСтрока(42)"));
П("сер ЗаписатьJSON", Ч("Сер.ЗаписатьJSON(Новый ЗаписьJSON, 42)"));
П("сер ПрочитатьJSON", Ч("Сер.ПрочитатьJSON(Новый ЧтениеJSON)"));
П("сер ВозможностьЧтенияXML", Сбор("НовыйЧитатель(""<Число>42</Число>""); Чтр.Прочитать(); Соб = Строка(Сер.ВозможностьЧтенияXML(Чтр));"));

// --- ЗаписатьXML: арность --------------------------------------------------

П("зап без аргументов", Ч("Сер.ЗаписатьXML()"));
П("зап один аргумент", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис); Соб = Зпис.Закрыть();"));
П("зап три аргумента", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, 42, ""мой""); Соб = Зпис.Закрыть();"));
П("зап четыре аргумента", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, 42, ""мой"", ""urn:иное""); Соб = Зпис.Закрыть();"));
П("зап пять аргументов", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, 42, ""мой"", ""urn:иное"", ФормаXML.Элемент); Соб = Зпис.Закрыть();"));
П("зап шесть аргументов", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, 42, ""мой"", ""urn:иное"", ФормаXML.Элемент, ""лишний""); Соб = Зпис.Закрыть();"));
П("зап WriteXML англ", Сбор("НовыйПисатель(); Сер.WriteXML(Зпис, 42); Соб = Зпис.Закрыть();"));

// --- ЗаписатьXML: формы значений BSL ---------------------------------------

П("зап число", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, 42); Соб = Зпис.Закрыть();"));
П("зап число дробное", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, 12.50); Соб = Зпис.Закрыть();"));
П("зап число длинное", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, 1/3); Соб = Зпис.Закрыть();"));
П("зап число отрицательное", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, -0.25); Соб = Зпис.Закрыть();"));
П("зап строка", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, ""аб""); Соб = Зпис.Закрыть();"));
П("зап строка пустая", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, """"); Соб = Зпис.Закрыть();"));
П("зап строка с разметкой", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, ""<&>""""""); Соб = Зпис.Закрыть();"));
П("зап дата", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, Дата(2026, 8, 13)); Соб = Зпис.Закрыть();"));
П("зап дата со временем", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, Дата(2026, 8, 13, 10, 20, 30)); Соб = Зпис.Закрыть();"));
П("зап дата пустая", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, Дата(1, 1, 1)); Соб = Зпис.Закрыть();"));
П("зап булево истина", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, Истина); Соб = Зпис.Закрыть();"));
П("зап булево ложь", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, Ложь); Соб = Зпис.Закрыть();"));
П("зап неопределено", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, Неопределено); Соб = Зпис.Закрыть();"));
П("зап NULL", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, NULL); Соб = Зпис.Закрыть();"));
П("зап GUID", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, Новый УникальныйИдентификатор(""01234567-89ab-cdef-0123-456789abcdef"")); Соб = Зпис.Закрыть();"));
П("зап двоичные", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, Base64Значение(""0LDQsQ=="")); Соб = Зпис.Закрыть();"));
П("зап тип", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, Тип(""Строка"")); Соб = Зпис.Закрыть();"));
П("зап массив", Сбор("НовыйПисатель(); М = Новый Массив; М.Добавить(1); М.Добавить(""аб""); Сер.ЗаписатьXML(Зпис, М); Соб = Зпис.Закрыть();"));
П("зап структура", Сбор("НовыйПисатель(); С = Новый Структура(""а,б"", 1, ""вг""); Сер.ЗаписатьXML(Зпис, С); Соб = Зпис.Закрыть();"));
П("зап соответствие", Сбор("НовыйПисатель(); С = Новый Соответствие; С.Вставить(""а"", 1); Сер.ЗаписатьXML(Зпис, С); Соб = Зпис.Закрыть();"));
П("зап таблица значений", Сбор("НовыйПисатель(); Т = Новый ТаблицаЗначений; Т.Колонки.Добавить(""а""); Сер.ЗаписатьXML(Зпис, Т); Соб = Зпис.Закрыть();"));
П("зап объект XDTO", Сбор("НовыйПисатель(); ОбП = Фаб.Создать(ТипКорня); ОбП.name = ""аб""; ОбП.id = 7; Сер.ЗаписатьXML(Зпис, ОбП); Соб = Зпис.Закрыть();"));
П("зап значение XDTO", Сбор("НовыйПисатель(); Зн = Фаб.Создать(Фаб.Тип(НСXSD, ""int""), ""42""); Сер.ЗаписатьXML(Зпис, Зн); Соб = Зпис.Закрыть();"));
П("зап в открытый элемент", Сбор("НовыйПисатель(); Зпис.ЗаписатьНачалоЭлемента(""обёртка""); Сер.ЗаписатьXML(Зпис, 42); Зпис.ЗаписатьКонецЭлемента(); Соб = Зпис.Закрыть();"));
П("зап двух подряд", Сбор("НовыйПисатель(); Зпис.ЗаписатьНачалоЭлемента(""об""); Сер.ЗаписатьXML(Зпис, 42); Сер.ЗаписатьXML(Зпис, ""аб""); Зпис.ЗаписатьКонецЭлемента(); Соб = Зпис.Закрыть();"));

// --- ПрочитатьXML: арность и круг ------------------------------------------

П("чт без аргументов", Ч("Сер.ПрочитатьXML()"));
П("чт строкой", Ч("Сер.ПрочитатьXML(""<Число>42</Число>"")"));
П("чт три аргумента", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, 42); Т = Зпис.Закрыть(); НовыйЧитатель(Т); Соб = Строка(Сер.ПрочитатьXML(Чтр, Тип(""Число""), ""лишний""));"));
П("чт ReadXML англ", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, 42); Т = Зпис.Закрыть(); НовыйЧитатель(Т); Соб = Строка(Сер.ReadXML(Чтр));"));
П("круг число", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, 42); Т = Зпис.Закрыть(); НовыйЧитатель(Т); Р = Сер.ПрочитатьXML(Чтр); Соб = Строка(ТипЗнч(Р)) + "" ["" + Строка(Р) + ""]"";"));
П("круг число дробное", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, 12.50); Т = Зпис.Закрыть(); НовыйЧитатель(Т); Р = Сер.ПрочитатьXML(Чтр); Соб = Строка(ТипЗнч(Р)) + "" ["" + Формат(Р, ""ЧГ=0; ЧРД=."") + ""]"";"));
П("круг строка", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, ""аб""); Т = Зпис.Закрыть(); НовыйЧитатель(Т); Р = Сер.ПрочитатьXML(Чтр); Соб = Строка(ТипЗнч(Р)) + "" ["" + Строка(Р) + ""]"";"));
П("круг дата", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, Дата(2026, 8, 13, 10, 20, 30)); Т = Зпис.Закрыть(); НовыйЧитатель(Т); Р = Сер.ПрочитатьXML(Чтр); Соб = Строка(ТипЗнч(Р)) + "" ["" + Формат(Р, ""ДФ=""""гггг-ММ-дд ЧЧ:мм:сс"""""") + ""]"";"));
П("круг булево", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, Истина); Т = Зпис.Закрыть(); НовыйЧитатель(Т); Р = Сер.ПрочитатьXML(Чтр); Соб = Строка(ТипЗнч(Р)) + "" ["" + Строка(Р) + ""]"";"));
П("круг неопределено", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, Неопределено); Т = Зпис.Закрыть(); НовыйЧитатель(Т); Р = Сер.ПрочитатьXML(Чтр); Соб = Строка(ТипЗнч(Р)) + "" ["" + Строка(Р) + ""]"";"));
П("круг GUID", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, Новый УникальныйИдентификатор(""01234567-89ab-cdef-0123-456789abcdef"")); Т = Зпис.Закрыть(); НовыйЧитатель(Т); Р = Сер.ПрочитатьXML(Чтр); Соб = Строка(ТипЗнч(Р)) + "" ["" + Строка(Р) + ""]"";"));
П("круг двоичные", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, Base64Значение(""0LDQsQ=="")); Т = Зпис.Закрыть(); НовыйЧитатель(Т); Р = Сер.ПрочитатьXML(Чтр); Соб = Строка(ТипЗнч(Р)) + "" ["" + Строка(Р.Размер()) + ""]"";"));
П("круг объект XDTO", Сбор("НовыйПисатель(); ОбП = Фаб.Создать(ТипКорня); ОбП.name = ""аб""; ОбП.id = 7; Сер.ЗаписатьXML(Зпис, ОбП); Т = Зпис.Закрыть(); НовыйЧитатель(Т); Р = Сер.ПрочитатьXML(Чтр); Соб = Строка(ТипЗнч(Р)) + "" ["" + Строка(Р.name) + ""]"";"));
П("чт с типом BSL", Сбор("НовыйЧитатель(""<Число>42</Число>""); Р = Сер.ПрочитатьXML(Чтр, Тип(""Число"")); Соб = Строка(ТипЗнч(Р)) + "" ["" + Строка(Р) + ""]"";"));
П("чт с типом XDTO", Сбор("НовыйПисатель(); ОбП = Фаб.Создать(ТипКорня); ОбП.name = ""аб""; Сер.ЗаписатьXML(Зпис, ОбП); Т = Зпис.Закрыть(); НовыйЧитатель(Т); Р = Сер.ПрочитатьXML(Чтр, ТипКорня); Соб = Строка(ТипЗнч(Р));"));
П("чт позиция ТипУзла", Сбор("НовыйПисатель(); Сер.ЗаписатьXML(Зпис, 42); Т = Зпис.Закрыть(); НовыйЧитатель(Т); Сер.ПрочитатьXML(Чтр); Соб = Строка(Чтр.ТипУзла);"));
П("чт двух подряд", Сбор("НовыйПисатель(); Зпис.ЗаписатьНачалоЭлемента(""об""); Сер.ЗаписатьXML(Зпис, 42); Сер.ЗаписатьXML(Зпис, ""аб""); Зпис.ЗаписатьКонецЭлемента(); Т = Зпис.Закрыть(); НовыйЧитатель(Т); Чтр.Прочитать(); Чтр.Прочитать(); Р1 = Сер.ПрочитатьXML(Чтр); Р2 = Сер.ПрочитатьXML(Чтр); Соб = Строка(Р1) + ""|"" + Строка(Р2);"));
П("чт чужой элемент", Сбор("Попытка НовыйЧитатель(""<чужой xmlns=""""urn:иное""""/>""); Чтр.Прочитать(); Соб = Строка(ТипЗнч(Сер.ПрочитатьXML(Чтр))); Исключение Соб = ОписаниеОшибки(); КонецПопытки;"));

// --- ВТОРОЙ ЗАХОД ---------------------------------------------------------
//
// Первый заход показал: фабрика в конструкторе ОБЯЗАТЕЛЬНА, свойства
// `ФабрикаXDTO` у сериализатора НЕТ вовсе (справка врёт — прецедент
// `ФорматСериализацииДаты`), примитивы пишутся элементом с именем
// ЛОКАЛЬНОГО имени типа XML, а коллекции и экземпляры XDTO фабрика из XSD
// не пишет. Второй заход добирает тексты отказов, обратное чтение
// v8-форм и состав `XMLТип`/`XMLТипЗнч`/`ВозможностьЧтенияXML`.

// Текст отказа собирается тем же `Сбор`, что и всё прочее: своей функции
// с `ОписаниеОшибки()` в теле здесь быть не может — этот интерпретатор
// такого имени не знает и отверг бы ВЕСЬ скрипт на разборе.
П("оп зап массив прямо", Сбор("Попытка НовыйПисатель(); М = Новый Массив; М.Добавить(1); Сер.ЗаписатьXML(Зпис, М); Соб = ""нет ошибки""; Исключение Соб = ОписаниеОшибки(); КонецПопытки;"));
П("оп зап структура прямо", Сбор("Попытка НовыйПисатель(); С = Новый Структура(""""а"""", 1); Сер.ЗаписатьXML(Зпис, С); Соб = ""нет ошибки""; Исключение Соб = ОписаниеОшибки(); КонецПопытки;"));
П("оп зап объект XDTO", Сбор("Попытка НовыйПисатель(); ОбП = Фаб.Создать(ТипКорня); ОбП.name = ""аб""; Сер.ЗаписатьXML(Зпис, ОбП); Соб = ""нет ошибки""; Исключение Соб = ОписаниеОшибки(); КонецПопытки;"));
П("оп сер ФабрикаXDTO", Сбор("Попытка Соб = Строка(Сер.ФабрикаXDTO); Исключение Соб = ОписаниеОшибки(); КонецПопытки;"));
П("оп сер ЗначениеЗаполнено", Сбор("Попытка Соб = Строка(ЗначениеЗаполнено(Сер)); Исключение Соб = ОписаниеОшибки(); КонецПопытки;"));
П("оп чт три аргумента", Сбор("Попытка НовыйЧитатель(""<string xmlns=""""http://www.w3.org/2001/XMLSchema"""">аб</string>""); Соб = Строка(Сер.ПрочитатьXML(Чтр, Тип(""Строка""), ""лишний"")); Исключение Соб = ОписаниеОшибки(); КонецПопытки;"));
П("оп сер ЗаписатьJSON", Сбор("Попытка Зп = Новый ЗаписьJSON; Зп.УстановитьСтроку(); Сер.ЗаписатьJSON(Зп, 42); Соб = Зп.Закрыть(); Исключение Соб = ОписаниеОшибки(); КонецПопытки;"));
П("оп конструктор без фабрики", Сбор("Попытка Выполнить(""С2 = Новый СериализаторXDTO;""); Соб = ""нет ошибки""; Исключение Соб = ОписаниеОшибки(); КонецПопытки;"));

