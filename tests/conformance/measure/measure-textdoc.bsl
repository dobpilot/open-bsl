// Замеры `ТекстовыйДокумент`, снимаемые на 8.3.27.
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-textdoc.bsl
//
// Правила те же, что у соседних скриптов: строка `ИД<таб>ЗНАЧЕНИЕ`, скрипт
// исполняется И НАШИМ интерпретатором, отказ — маркером `<ошибка>`.
//
// Пробы написаны прямым кодом: тип разбирается обеими сторонами. Снимался
// замер иначе — через `Выполнить`, потому что до реализации `Новый
// ТекстовыйДокумент` наш резолвер отвергал на этапе компиляции и сорвал бы
// весь прогон.

Перем Ответ;

Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Р = СтрЗаменить(Р, Символ(10), "<ПС>");
	Р = СтрЗаменить(Р, Символ(9), "<Т>");
	Возврат Р;
КонецФункции

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Видимо(Строка(Значение)));
КонецПроцедуры

// Исполняет фрагмент, который обязан положить результат в `Ответ`.
Функция Код(Фрагмент)
	Ответ = "<ошибка>";
	Попытка
		Выполнить(Фрагмент);
	Исключение
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// Значение выражения либо `<ошибка>`.
Функция Проба(Выражение)
	Попытка
		Возврат Строка(Вычислить(Выражение));
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
КонецФункции


