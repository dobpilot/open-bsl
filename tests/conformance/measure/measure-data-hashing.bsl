// Контракт минимальной поверхности ХешированиеДанных для Connector.
// Динамические фрагменты позволяют запустить этот oracle в open-bsl до
// появления компонента: отсутствие типа становится ловимой ошибкой.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция БулевоСтрокой(Значение)
	Если Значение Тогда
		Возврат "true";
	КонецЕсли;
	Возврат "false";
КонецФункции

Функция ДинамическоеВыражение(Текст)
	Попытка
		Возврат Вычислить(Текст);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
КонецФункции

Функция ДинамическоеБулево(Текст)
	Результат = ДинамическоеВыражение(Текст);
	Если ТипЗнч(Результат) = Тип("Булево") Тогда
		Возврат БулевоСтрокой(Результат);
	КонецЕсли;
	Возврат Результат;
КонецФункции

М("CRYPTO.HASH.ENUM.MD5", ДинамическоеВыражение("Строка(ХешФункция.MD5)"));
М("CRYPTO.HASH.ENUM.SHA1", ДинамическоеВыражение("Строка(ХешФункция.SHA1)"));
М("CRYPTO.HASH.ENUM.SHA256", ДинамическоеВыражение("Строка(ХешФункция.SHA256)"));
М("CRYPTO.HASH.ENUM.ENGLISH_ALIAS",
	ДинамическоеБулево("HashFunction.MD5 = ХешФункция.MD5"));
М("CRYPTO.HASH.ENUM.TYPE",
	ДинамическоеВыражение("Строка(ТипЗнч(ХешФункция.MD5))"));

ТипОбъекта = "<ошибка>";
ТипСуммы = "<ошибка>";
Попытка
	Выполнить(
		"ХешТип = Новый ХешированиеДанных(ХешФункция.MD5); "
		+ "ХешТип.Добавить(Base64Значение(""YQ=="")); "
		+ "ТипОбъекта = Строка(ТипЗнч(ХешТип)); "
		+ "ТипСуммы = ТипЗнч(ХешТип.ХешСумма) = Тип(""ДвоичныеДанные"");");
Исключение
КонецПопытки;
М("CRYPTO.HASH.OBJECT.TYPE", ТипОбъекта);
Если ТипЗнч(ТипСуммы) = Тип("Булево") Тогда
	ТипСуммы = БулевоСтрокой(ТипСуммы);
КонецЕсли;
М("CRYPTO.HASH.SUM.TYPE", ТипСуммы);

АнглийскийКонструктор = "<ошибка>";
Попытка
	Выполнить(
		"ХешEnglish = Новый DataHashing(HashFunction.MD5); "
		+ "АнглийскийКонструктор = Строка(ТипЗнч(ХешEnglish));");
Исключение
КонецПопытки;
М("CRYPTO.HASH.CONSTRUCTOR.ENGLISH_ALIAS", АнглийскийКонструктор);

MD5ABC = "<ошибка>";
Попытка
	Выполнить(
		"ХешMD5 = Новый ХешированиеДанных(ХешФункция.MD5); "
		+ "ХешMD5.Добавить(Base64Значение(""YWJj"")); "
		+ "MD5ABC = ПолучитьHexСтрокуИзДвоичныхДанных(ХешMD5.ХешСумма);");
Исключение
КонецПопытки;
М("CRYPTO.HASH.MD5.ABC", MD5ABC);

SHA1ABC = "<ошибка>";
Попытка
	Выполнить(
		"ХешSHA1 = Новый ХешированиеДанных(ХешФункция.SHA1); "
		+ "ХешSHA1.Добавить(Base64Значение(""YWJj"")); "
		+ "SHA1ABC = ПолучитьHexСтрокуИзДвоичныхДанных(ХешSHA1.ХешСумма);");
Исключение
КонецПопытки;
М("CRYPTO.HASH.SHA1.ABC", SHA1ABC);

SHA256ABC = "<ошибка>";
Попытка
	Выполнить(
		"ХешSHA256 = Новый ХешированиеДанных(ХешФункция.SHA256); "
		+ "ХешSHA256.Добавить(Base64Значение(""YWJj"")); "
		+ "SHA256ABC = ПолучитьHexСтрокуИзДвоичныхДанных(ХешSHA256.ХешСумма);");
Исключение
КонецПопытки;
М("CRYPTO.HASH.SHA256.ABC", SHA256ABC);

ПовторнаяСумма = "<ошибка>";
ПродолженнаяСумма = "<ошибка>";
Попытка
	Выполнить(
		"ХешПродолжение = Новый ХешированиеДанных(ХешФункция.SHA256); "
		+ "ХешПродолжение.Добавить(Base64Значение(""YQ=="")); "
		+ "ПерваяСумма = ПолучитьHexСтрокуИзДвоичныхДанных(ХешПродолжение.ХешСумма); "
		+ "ВтораяСумма = ПолучитьHexСтрокуИзДвоичныхДанных(ХешПродолжение.ХешСумма); "
		+ "ПовторнаяСумма = ПерваяСумма + ""|"" + ВтораяСумма; "
		+ "ХешПродолжение.Добавить(Base64Значение(""YmM="")); "
		+ "ПродолженнаяСумма = ПолучитьHexСтрокуИзДвоичныхДанных(ХешПродолжение.ХешСумма);");
Исключение
КонецПопытки;
М("CRYPTO.HASH.SNAPSHOT.REPEATED", ПовторнаяСумма);
М("CRYPTO.HASH.SNAPSHOT.CONTINUE", ПродолженнаяСумма);
М("CRYPTO.DIGEST.NONCE_COUNT",
	БулевоСтрокой(Формат(1, "ЧЦ=8; ЧВН=; ЧГ=") = "00000001"));
