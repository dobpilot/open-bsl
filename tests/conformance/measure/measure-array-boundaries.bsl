// Верхняя граница массива для разбора заголовков Connector.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Пустой = Новый Массив;
М("ARRAY.UPPER_BOUND.EMPTY", Пустой.ВГраница());

Заполненный = Новый Массив;
Заполненный.Добавить("а");
Заполненный.Добавить("б");
Заполненный.Добавить("в");
М("ARRAY.UPPER_BOUND.THREE", Заполненный.ВГраница());
М("ARRAY.UPPER_BOUND.ENGLISH_ALIAS", Заполненный.UBound());
