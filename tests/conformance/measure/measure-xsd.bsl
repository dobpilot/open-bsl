Процедура П(Метка, Значение)
	Сообщить(Метка + Символ(9) + Значение);
КонецПроцедуры

Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Р = СтрЗаменить(Р, Символ(10), "<ПС>");
	Р = СтрЗаменить(Р, Символ(9), "<Т>");
	Возврат Р;
КонецФункции

// Проба ВЫРАЖЕНИЯ: тип результата и его строковое представление.
Функция Ч(Выражение)
	Попытка
		Р = Вычислить(Выражение);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Попытка
		Возврат Строка(ТипЗнч(Р)) + " [" + Видимо(Строка(Р)) + "]";
	Исключение
		Возврат Строка(ТипЗнч(Р)) + " <не печатается>";
	КонецПопытки;
КонецФункции

// Проба ОПЕРАТОРА: важен сам факт, что фрагмент принят.
Функция Оп(Код)
	Попытка
		Выполнить(Код);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат "ок";
КонецФункции

// Сбор в модульную переменную `Соб`.
Функция Сбор(Код)
	Попытка
		Соб = "";
		Выполнить(Код);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат Видимо(Соб);
КонецФункции

// Есть ли такое имя типа вообще.
Функция ЕстьТип(Имя)
	Попытка
		Р = Вычислить("Тип(""" + Имя + """)");
	Исключение
		Возврат "<нет>";
	КонецПопытки;
	Возврат Строка(Р);
КонецФункции

