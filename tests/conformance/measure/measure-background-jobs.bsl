// Контракт фоновых заданий и временного хранилища — оставшиеся вопросы
// реестра (`JOB.*`). Скрипт исполняется на обеих сторонах: на платформе —
// в серверной процедуре формы замеров, у open-bsl — обычным прогоном.
// Пробы, которым нужна цель в серверном общем модуле
// (`ЗамерыФоновыхЗаданийДвусторонние` из cfg-src-server — модуль с
// одним исходником для обеих сторон), обёрнуты в Попытка: без этого
// модуля строка отвечает текстом ошибки — это тоже ответ, а прогон не
// падает целиком. Исполняемость на open-bsl с тем же каталогом держит
// тест the_background_jobs_measure_script_runs_with_the_platform_catalog.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

// Порядок листинга и строгость границы отбора «Начало»: задание, у
// которого `Начало` РАВНО границе отбора, при строгом «после» не
// попадает в результат (у open-bsl — 0), при нестрогом — попадает.
Функция ПробаОтбораНачала()
	Попытка
		Задание = ФоновыеЗадания.Выполнить("ЗамерыФоновыхЗаданийДвусторонние.Пустая");
		Задание = Задание.ОжидатьЗавершенияВыполнения();
		Отбор = Новый Структура("Начало", Задание.Начало);
		Найденные = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
		// Счётчик неоднозначен: в базе могут жить чужие задания. Строгость
		// границы решает присутствие НАШЕГО задания с Начало = границе.
		НашеВошло = "нет";
		Для Каждого Найденное Из Найденные Цикл
			Если Найденное.УникальныйИдентификатор = Задание.УникальныйИдентификатор Тогда
				НашеВошло = "да";
			КонецЕсли;
		КонецЦикла;
		Возврат "равная граница содержит наше: " + НашеВошло;
	Исключение
		Возврат "ошибка: " + ИнформацияОбОшибке().Описание;
	КонецПопытки;
КонецФункции

М("JOB.LIST.FILTER_ORDER", ПробаОтбораНачала());

// Инициализация тела серверного модуля в сеансе задания: цель возвращает
// переменную, выставляемую телом модуля-СОСЕДА, которого сама не
// касается. «Неопределено» — ленивая инициализация (только затронутые
// модули), значение — eager всех модулей каталога.
Функция ПробаИнициализацииМодуля()
	Попытка
		Задание = ФоновыеЗадания.Выполнить("ЗамерыФоновыхЗаданийДвусторонние.СоседИнициализирован");
		Задание = Задание.ОжидатьЗавершенияВыполнения();
		Сообщения = Задание.ПолучитьСообщенияПользователю();
		Если Сообщения.Количество() = 0 Тогда
			Возврат "без сообщений";
		КонецЕсли;
		Возврат Сообщения[0].Текст;
	Исключение
		Возврат "ошибка: " + ИнформацияОбОшибке().Описание;
	КонецПопытки;
КонецФункции

М("JOB.MODULE.INIT", ПробаИнициализацииМодуля());

// Контроль чувствительности той же пробы: цель КАСАЕТСЯ соседа, и его
// тело обязано исполниться при первом обращении, а сообщение — попасть
// в историю задания. «Без сообщений» здесь означало бы, что тела общих
// модулей не исполняются вовсе и наблюдаемая пробы выше пуста.
Функция ПробаКасанияСоседа()
	Попытка
		Задание = ФоновыеЗадания.Выполнить("ЗамерыФоновыхЗаданийДвусторонние.КоснутьсяСоседа");
		Задание = Задание.ОжидатьЗавершенияВыполнения();
		Хвост = "; без сообщений";
		Сообщения = Задание.ПолучитьСообщенияПользователю();
		Если Сообщения.Количество() > 0 Тогда
			Хвост = "; " + Сообщения[0].Текст;
		КонецЕсли;
		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			Хвост = Хвост + "; ошибка задания: " + Задание.ИнформацияОбОшибке.Описание;
		КонецЕсли;
		Возврат Строка(Задание.Состояние) + Хвост;
	Исключение
		Возврат "ошибка: " + ИнформацияОбОшибке().Описание;
	КонецПопытки;
КонецФункции

М("JOB.MODULE.INIT.КАСАНИЕ", ПробаКасанияСоседа());

// Асинхронная цель: принимает ли `Выполнить` метод с модификатором
// `Асинх` и чем задание завершается.
Функция ПробаАсинхЦели()
	Попытка
		Задание = ФоновыеЗадания.Выполнить("ЗамерыФоновыхЗаданийДвусторонние.АсинхЦель");
		Задание = Задание.ОжидатьЗавершенияВыполнения();
		Хвост = "";
		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			Хвост = "; ошибка задания: " + Задание.ИнформацияОбОшибке.Описание;
		КонецЕсли;
		Возврат "принята, состояние " + Задание.Состояние + Хвост;
	Исключение
		Возврат "ошибка: " + ИнформацияОбОшибке().Описание;
	КонецПопытки;
КонецФункции

М("JOB.ASYNC.TARGET", ПробаАсинхЦели());

// Повторное использование удалённого адреса в СВОЁМ сеансе: запись по
// нему — ошибка (подтверждено Q78.OWN.DELETED.WRITE.ERROR), чтение —
// Неопределено; вопрос — оживает ли адрес после новой записи без адреса.
Функция ПробаЖизниАдреса()
	Попытка
		Адрес = ПоместитьВоВременноеХранилище("первое");
		УдалитьИзВременногоХранилища(Адрес);
		Ответ = "";
		Попытка
			ПоместитьВоВременноеХранилище("второе", Адрес);
			Ответ = "повторная запись прошла";
		Исключение
			Ответ = "повторная запись — ошибка";
		КонецПопытки;
		Чтение = ПолучитьИзВременногоХранилища(Адрес);
		Возврат Ответ + "; чтение " + ?(Чтение = Неопределено, "Неопределено", Строка(Чтение));
	Исключение
		Возврат "ошибка: " + ИнформацияОбОшибке().Описание;
	КонецПопытки;
КонецФункции

М("JOB.TEMP.LIFETIME", ПробаЖизниАдреса());

// Read-your-writes: задание-цель пишет по адресу вызывателя и тут же
// читает его — документация обещает «недоступны в фоновом сеансе».
Функция ПробаЧтенияСвоейЗаписи()
	Попытка
		Адрес = ПоместитьВоВременноеХранилище("исходное");
		ПараметрыВызова = Новый Массив;
		ПараметрыВызова.Добавить(Адрес);
		Задание = ФоновыеЗадания.Выполнить("ЗамерыФоновыхЗаданийДвусторонние.ПисатьИЧитать", ПараметрыВызова);
		Задание = Задание.ОжидатьЗавершенияВыполнения();
		Сообщения = Задание.ПолучитьСообщенияПользователю();
		Если Сообщения.Количество() = 0 Тогда
			Возврат "без сообщений";
		КонецЕсли;
		Возврат "задание прочитало: " + Сообщения[0].Текст;
	Исключение
		Возврат "ошибка: " + ИнформацияОбОшибке().Описание;
	КонецПопытки;
КонецФункции

М("JOB.TEMP.READ_YOUR_WRITES", ПробаЧтенияСвоейЗаписи());

// Staged delete: задание удаляет адрес вызывателя; публикуется ли
// удаление на terminal или данные вызывателя целы.
Функция ПробаУдаленияИзЗадания()
	Попытка
		Адрес = ПоместитьВоВременноеХранилище("хранимое");
		ПараметрыВызова = Новый Массив;
		ПараметрыВызова.Добавить(Адрес);
		Задание = ФоновыеЗадания.Выполнить("ЗамерыФоновыхЗаданийДвусторонние.УдалитьАдрес", ПараметрыВызова);
		Задание.ОжидатьЗавершенияВыполнения();
		Возврат "после terminal вызыватель видит " + ПолучитьИзВременногоХранилища(Адрес);
	Исключение
		Возврат "ошибка: " + ИнформацияОбОшибке().Описание;
	КонецПопытки;
КонецФункции

М("JOB.TEMP.STAGED_DELETE", ПробаУдаленияИзЗадания());

// Вложенная capability: цель-родитель передаёт СВОЙ исходный адрес
// дочернему заданию, и то пробует писать по адресу foreground-сеанса.
Функция ПробаВложеннойЗаписи()
	Попытка
		Адрес = ПоместитьВоВременноеХранилище("дедово");
		ПараметрыВызова = Новый Массив;
		ПараметрыВызова.Добавить(Адрес);
		Задание = ФоновыеЗадания.Выполнить("ЗамерыФоновыхЗаданийДвусторонние.РодительВнука", ПараметрыВызова);
		Задание.ОжидатьЗавершенияВыполнения();
		Возврат "после внука вызыватель видит " + ПолучитьИзВременногоХранилища(Адрес);
	Исключение
		Возврат "ошибка: " + ИнформацияОбОшибке().Описание;
	КонецПопытки;
КонецФункции

М("JOB.TEMP.NESTED_CAPABILITY", ПробаВложеннойЗаписи());

// Гонка закрытия вызывателя с terminal commit на платформе наблюдаема
// только между СЕАНСАМИ (закрыть свой сеанс изнутри пробы нельзя):
// пробуем прочитать адрес сеанса, которого больше нет, — форма адреса с
// чужим seanceId, — и фиксируем контракт чтения/записи.
Функция ПробаЗакрытогоПолучателя()
	Попытка
		Адрес = ПоместитьВоВременноеХранилище("живое");
		ЧужойАдрес = СтрЗаменить(Адрес, Сред(Адрес, СтрНайти(Адрес, "seanceId=") + 9),
			"00000000-0000-4000-8000-000000000000");
		Чтение = ПолучитьИзВременногоХранилища(ЧужойАдрес);
		Ответ = "чтение " + ?(Чтение = Неопределено, "Неопределено", Строка(Чтение));
		Попытка
			ПоместитьВоВременноеХранилище("поздняя", ЧужойАдрес);
			Ответ = Ответ + "; запись прошла";
		Исключение
			Ответ = Ответ + "; запись — ошибка";
		КонецПопытки;
		Возврат Ответ;
	Исключение
		Возврат "ошибка: " + ИнформацияОбОшибке().Описание;
	КонецПопытки;
КонецФункции

М("JOB.TEMP.CALLER_CLOSE_RACE", ПробаЗакрытогоПолучателя());
