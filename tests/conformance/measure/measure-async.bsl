// Контракт async-языка. На платформе генератор исполняет этот модуль на
// клиенте: серверный контекст не разрешает async-декларации. Последний
// динамический вызов завершает тестовую платформу; open-bsl его ловит как
// неизвестную функцию после того, как все проверки уже выведены.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Асинх Функция АсинхЛист(Знач Значение, Журнал)
	Журнал.Добавить("Л1");
	Возврат Значение;
КонецФункции

Асинх Функция АсинхРодитель(Журнал)
	Журнал.Добавить("Р1");
	ОбещаниеЛиста = АсинхЛист(41, Журнал);
	Журнал.Добавить("Р2");
	РезультатЛиста = Ждать ОбещаниеЛиста;
	Журнал.Добавить("Р3");
	Возврат РезультатЛиста + 1;
КонецФункции

Асинх Процедура АсинхИзменитьПараметр(Параметр)
	Параметр = 99;
КонецПроцедуры

Асинх Функция АсинхОшибкаВнутри()
	ВызватьИсключение "ошибка async";
КонецФункции

Асинх Процедура ИзмеритьAsync()
	ЖурналПорядка = Новый Массив;
	Обещание = АсинхРодитель(ЖурналПорядка);
	ЖурналПорядка.Добавить("Т");
	Результат = Ждать Обещание;
	М("ASYNC.START_ORDER", СтрСоединить(ЖурналПорядка, ""));
	М("ASYNC.PROMISE.TYPE", ТипЗнч(Обещание));
	М("ASYNC.AWAIT.RESULT", Результат);
	М("ASYNC.AWAIT.REPEATED", Ждать Обещание);

	ПараметрСнаружи = 1;
	АсинхИзменитьПараметр(ПараметрСнаружи);
	Ждать АсинхЛист(0, ЖурналПорядка);
	М("ASYNC.PARAM.BY_VALUE", ПараметрСнаружи);

	ГраницаОшибки = "нет ошибки";
	ОбещаниеОшибки = АсинхОшибкаВнутри();
	Попытка
		Ждать ОбещаниеОшибки;
	Исключение
		ГраницаОшибки = "ошибка у Ждать";
	КонецПопытки;
	М("ASYNC.ERROR.AT_AWAIT", ГраницаОшибки);

	М("ASYNC.AWAIT.NON_PROMISE", Ждать 1);

	Попытка
		Выполнить("ЗавершитьРаботуСистемы(Ложь)");
	Исключение
	КонецПопытки;
КонецПроцедуры

ИзмеритьAsync();
