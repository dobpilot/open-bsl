// Строковые предикаты, используемые Connector 2.6.0.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция БулевоСтрокой(Значение)
	Возврат ?(Значение, "true", "false");
КонецФункции

Процедура П(Ид, Выражение)
	Значение = "<ошибка>";
	Попытка
		Значение = Вычислить(Выражение);
		Если ТипЗнч(Значение) = Тип("Булево") Тогда
			Значение = БулевоСтрокой(Значение);
		КонецЕсли;
	Исключение
	КонецПопытки;
	М(Ид, Значение);
КонецПроцедуры

П("STRING.STARTS.EXACT", "СтрНачинаетсяС(""Abc"", ""Ab"")");
П("STRING.STARTS.CASE", "СтрНачинаетсяС(""Abc"", ""ab"")");
П("STRING.STARTS.EMPTY", "СтрНачинаетсяС(""Abc"", """")");
П("STRING.ENDS.EXACT", "СтрЗаканчиваетсяНа(""Abc"", ""bc"")");
П("STRING.ENDS.CASE", "СтрЗаканчиваетсяНа(""Abc"", ""BC"")");
П("STRING.ENDS.EMPTY", "СтрЗаканчиваетсяНа(""Abc"", """")");
