Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

БуферUTF8 = Новый БуферДвоичныхДанных(4);
ПотокЗаписиUTF8 = Новый ПотокВПамяти(БуферUTF8);
ЗаписьUTF8 = Новый ЗаписьДанных(ПотокЗаписиUTF8);
ЗаписьUTF8.ЗаписатьСимволы("Аб", "UTF-8");
ПотокUTF8 = Новый ПотокВПамяти(БуферUTF8);
ЧтениеUTF8 = Новый ЧтениеТекста(ПотокUTF8, КодировкаТекста.UTF8);
М("TEXTREADER.TYPE", Строка(ТипЗнч(ЧтениеUTF8)));
М("TEXTREADER.READ.UTF8", ЧтениеUTF8.Прочитать());
М("TEXTREADER.POSITION.AFTER_READ", ПотокUTF8.ТекущаяПозиция());
ЗначениеНаКонце = ЧтениеUTF8.Прочитать();
Если ЗначениеНаКонце = Неопределено Тогда
	РезультатКонца = "undefined";
Иначе
	РезультатКонца = "value";
КонецЕсли;
М("TEXTREADER.READ.EOF", РезультатКонца);
ЧтениеUTF8.Закрыть();

Результат = "доступен";
Попытка
	ПотокUTF8.Размер();
Исключение
	Результат = "закрыт";
КонецПопытки;
М("TEXTREADER.CLOSE.UNDERLYING", Результат);

Результат = "принято";
Попытка
	ЧтениеUTF8.Прочитать();
Исключение
	Результат = "ошибка";
КонецПопытки;
М("TEXTREADER.READ.AFTER_CLOSE", Результат);

Буфер1251 = Новый БуферДвоичныхДанных(2);
ПотокЗаписи1251 = Новый ПотокВПамяти(Буфер1251);
Запись1251 = Новый ЗаписьДанных(ПотокЗаписи1251);
Запись1251.ЗаписатьСимволы("Аб", "windows-1251");
Чтение1251 = Новый ЧтениеТекста(Новый ПотокВПамяти(Буфер1251), "windows-1251");
М("TEXTREADER.READ.STRING_ENCODING", Чтение1251.Прочитать());

БуферBOM = Новый БуферДвоичныхДанных(7);
ПотокЗаписиBOM = Новый ПотокВПамяти(БуферBOM);
ЗаписьBOM = Новый ЗаписьДанных(ПотокЗаписиBOM);
ЗаписьBOM.ЗаписатьБайт(239);
ЗаписьBOM.ЗаписатьБайт(187);
ЗаписьBOM.ЗаписатьБайт(191);
ЗаписьBOM.ЗаписатьСимволы("Аб", "UTF-8");
ЧтениеBOM = Новый ЧтениеТекста(Новый ПотокВПамяти(БуферBOM), "UTF-8");
М("TEXTREADER.READ.BOM", ЧтениеBOM.Прочитать());

Результат = "принято";
Попытка
	НеверноеЧтение = Новый ЧтениеТекста(Новый ПотокВПамяти, "нет-такой-кодировки");
Исключение
	Результат = "ошибка";
КонецПопытки;
М("TEXTREADER.INVALID_ENCODING", Результат);
