// Неявное строковое представление UUID в `СтрЗаменить` из Connector.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + ?(Значение, "true", "false"));
КонецПроцедуры

Идентификатор = Новый УникальныйИдентификатор("00000000-0000-4000-8000-000000000000");
БезДефисов = СтрЗаменить(Идентификатор, "-", "");
М("STRING.REPLACE.UUID.TYPE", ТипЗнч(БезДефисов) = Тип("Строка"));
М("STRING.REPLACE.UUID.VALUE", БезДефисов = "00000000000040008000000000000000");
М("STRING.LOWER.UUID.VALUE", НРег(Идентификатор) = "00000000-0000-4000-8000-000000000000");
М("STRING.UPPER.UUID.VALUE", ВРег(Идентификатор) = "00000000-0000-4000-8000-000000000000");
