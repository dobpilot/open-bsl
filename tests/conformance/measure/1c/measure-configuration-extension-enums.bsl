// Проба фиксирует строковые представления системных перечислений расширений
// конфигурации и исполняется одинаково на платформе и в open-bsl.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "configuration-extension-enums-1");

М("EXTENSIONS.SOURCE.DATABASE",
	Строка(ТипЗнч(ИсточникРасширенийКонфигурации.БазаДанных)) + ":"
