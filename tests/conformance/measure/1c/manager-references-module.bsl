Функция ПроверитьСсылки() Экспорт
    Пустая = ПустаяСсылка();
    Нулевая = ПолучитьСсылку(Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
    Идентификатор = Новый УникальныйИдентификатор("12345678-1234-4321-abcd-0123456789ab");
    Первая = ПолучитьСсылку(Идентификатор);
    Повторная = ПолучитьСсылку(Идентификатор);
    НоваяПервая = ПолучитьСсылку();
    НоваяВторая = ПолучитьСсылку();
    Результат = Новый Массив;
    Результат.Добавить(Строка(ТипЗнч(Пустая)));
    Результат.Добавить(Строка(Пустая.УникальныйИдентификатор()));
    Результат.Добавить(Пустая = Нулевая);
    Результат.Добавить(ЗначениеЗаполнено(Пустая));
    Результат.Добавить(Первая = Повторная);
    Результат.Добавить(Первая.УникальныйИдентификатор() = Идентификатор);
    Результат.Добавить(ЗначениеЗаполнено(Первая));
    Результат.Добавить(НоваяПервая <> НоваяВторая);
    Результат.Добавить(ЗначениеЗаполнено(НоваяПервая));
    Результат.Добавить(ТипЗнч(Пустая) = Тип("СправочникСсылка.ЗамерВременныхТаблиц"));
    Результат.Добавить(ТипЗнч(Пустая) = Тип("CatalogRef.ЗамерВременныхТаблиц"));
    Результат.Добавить(ТипЗнч(Пустая) = Тип("справочникссылка.замервременныхтаблиц"));
    Попытка
        ТипБезПрефикса = Тип("ЗамерВременныхТаблиц");
        Результат.Добавить("accepted");
    Исключение
        Результат.Добавить("rejected");
    КонецПопытки;
    Попытка
        ТипСПробелом = Тип("СправочникСсылка. ЗамерВременныхТаблиц");
        Результат.Добавить("accepted");
    Исключение
        Результат.Добавить("rejected");
    КонецПопытки;
    Возврат Результат;
КонецФункции
