# Минимальный справочник нужен пробам временных таблиц и ссылок менеджера.
# Запускайте её на отдельной `ONEC_IB`, чтобы состав остальных баз замеров
# не зависел от уже загруженных дополнительных объектов.
copy-tree tests/conformance/measure/1c/cfg-src-temp-tables
child Catalog ЗамерВременныхТаблиц
copy-tree tests/conformance/measure/1c/cfg-src-document-reference
child Document ЗамерДокумента
copy tests/conformance/measure/1c/document-fill-references.xml Documents/ЗамерДокумента.xml
mkdir Documents/ЗамерДокумента/Ext
copy tests/conformance/measure/1c/document-fill-references-module.bsl Documents/ЗамерДокумента/Ext/ObjectModule.bsl
