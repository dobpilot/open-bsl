// Полный состав системного перечисления ДополнительныйРежимОтображения.

Процедура М(Ид, Русское, Английское)
	Сообщить(Ид + Символ(9) + Строка(ТипЗнч(Русское)) + Символ(9)
		+ Строка(Русское) + Символ(9) + ?(Русское = Английское, "Yes", "No"));
КонецПроцедуры

М("ADDITIONAL_SHOW.DONT_USE", ДополнительныйРежимОтображения.НеИспользовать, AdditionalShowMode.DontUse);
М("ADDITIONAL_SHOW.IRRELEVANCE", ДополнительныйРежимОтображения.Неактуальность, AdditionalShowMode.Irrelevance);
