// Некорректный Base64 в строке и в двоичных данных.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Значение);
КонецПроцедуры

Функция ИзСтроки(Текст)
	Попытка
		Данные = ПолучитьДвоичныеДанныеИзBase64Строки(Текст);
		Возврат "[" + ПолучитьHexСтрокуИзДвоичныхДанных(Данные) + "]";
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

Функция ИзДанных(Текст)
	Попытка
		Вход = ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8);
		Данные = ПолучитьДвоичныеДанныеИзBase64ДвоичныхДанных(Вход);
		Возврат "[" + ПолучитьHexСтрокуИзДвоичныхДанных(Данные) + "]";
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

М("B64STR.VALID", ИзСтроки("QUJD"));
М("B64STR.SPACES", ИзСтроки("QU JD"));
М("B64STR.CRLF", ИзСтроки("QU" + Символы.ВК + Символы.ПС + "JD"));
М("B64STR.BAD_CHAR_MID", ИзСтроки("QU!D"));
М("B64STR.BAD_CHAR_AFTER", ИзСтроки("QUJD!QUJD"));
М("B64STR.TRUNCATED", ИзСтроки("QUJ"));
М("B64STR.PADDED", ИзСтроки("QQ=="));
М("B64STR.NO_PADDING", ИзСтроки("QQ"));
М("B64STR.EXTRA_PADDING", ИзСтроки("QQ==="));
М("B64STR.EMPTY", ИзСтроки(""));
М("B64BIN.VALID", ИзДанных("QUJD"));
М("B64BIN.SPACES", ИзДанных("QU JD"));
М("B64BIN.CRLF", ИзДанных("QU" + Символы.ВК + Символы.ПС + "JD"));
М("B64BIN.BAD_CHAR_MID", ИзДанных("QU!D"));
М("B64BIN.BAD_CHAR_AFTER", ИзДанных("QUJD!QUJD"));
М("B64BIN.TRUNCATED", ИзДанных("QUJ"));
М("B64BIN.PADDED", ИзДанных("QQ=="));
М("B64BIN.NO_PADDING", ИзДанных("QQ"));
М("B64BIN.EXTRA_PADDING", ИзДанных("QQ==="));
М("B64BIN.EMPTY", ИзДанных(""));
