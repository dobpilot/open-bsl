// Полная форма конструктора ПараметрыЗаписиXML.

НастройкиПоУмолчанию = Новый ПараметрыЗаписиXML;
РежимОтступаПоУмолчанию = "F";
Если НастройкиПоУмолчанию.Отступ Тогда РежимОтступаПоУмолчанию = "T"; КонецЕсли;
РежимАтрибутовПоУмолчанию = "F";
Если НастройкиПоУмолчанию.ОтступАтрибутов Тогда РежимАтрибутовПоУмолчанию = "T"; КонецЕсли;
Сообщить("DEFAULT" + Символ(9)
    + Строка(НастройкиПоУмолчанию.Кодировка) + ":"
    + Строка(НастройкиПоУмолчанию.Версия) + ":"
    + РежимОтступаПоУмолчанию + ":"
    + РежимАтрибутовПоУмолчанию + ":"
    + Строка(СтрДлина(НастройкиПоУмолчанию.СимволыОтступа)));

Попытка
    НастройкиПробы = Новый ПараметрыЗаписиXML("UTF-8", "1.0", Истина, Истина, "  ");
    РежимОтступаПробы = "F";
    Если НастройкиПробы.Отступ Тогда РежимОтступаПробы = "T"; КонецЕсли;
    РежимАтрибутовПробы = "F";
    Если НастройкиПробы.ОтступАтрибутов Тогда РежимАтрибутовПробы = "T"; КонецЕсли;
    Сообщить("SETTINGS" + Символ(9)
        + Строка(НастройкиПробы.Кодировка) + ":"
        + Строка(НастройкиПробы.Версия) + ":"
        + РежимОтступаПробы + ":"
        + РежимАтрибутовПробы + ":"
        + Строка(СтрДлина(НастройкиПробы.СимволыОтступа)));

    ПисательПробы = Новый ЗаписьXML;
    ПисательПробы.УстановитьСтроку(НастройкиПробы);
    ПисательПробы.ЗаписатьНачалоЭлемента("root");
    ПисательПробы.ЗаписатьАтрибут("a", "1");
    ПисательПробы.ЗаписатьАтрибут("b", "2");
    ПисательПробы.ЗаписатьНачалоЭлемента("child");
    ПисательПробы.ЗаписатьКонецЭлемента();
    ПисательПробы.ЗаписатьКонецЭлемента();
    ТекстПробы = ПисательПробы.Закрыть();
    Сообщить("XML" + Символ(9)
        + СтрЗаменить(СтрЗаменить(ТекстПробы, Символ(13), "<CR>"), Символ(10), "<LF>"));
Исключение
    Сообщить("SETTINGS_ERROR" + Символ(9) + ОписаниеОшибки());
КонецПопытки;

ВариантыОтступов = Новый Массив;
ВариантыОтступов.Добавить("");
ВариантыОтступов.Добавить(" ");
ВариантыОтступов.Добавить(Символ(9));
ВариантыОтступов.Добавить(Символ(10));
ВариантыОтступов.Добавить(Символ(13));
Для ИндексОтступа = 0 По ВариантыОтступов.Количество() - 1 Цикл
    Попытка
        НастройкиВарианта = Новый ПараметрыЗаписиXML(
            "UTF-8", "1.0", Истина, Истина, ВариантыОтступов[ИндексОтступа]);
        РезультатВарианта = "ACCEPTED";
    Исключение
        РезультатВарианта = "ERROR";
    КонецПопытки;
    Сообщить("CHARS." + Строка(ИндексОтступа) + Символ(9) + РезультатВарианта);
КонецЦикла;

Для НомерРежима = 1 По 2 Цикл
    ОтступПробы = НомерРежима = 1;
    ОтступАтрибутовПробы = НомерРежима = 2;
    НастройкиПробы = Новый ПараметрыЗаписиXML(
        "UTF-8", "1.0", ОтступПробы, ОтступАтрибутовПробы, "  ");
    ПисательПробы = Новый ЗаписьXML;
    ПисательПробы.УстановитьСтроку(НастройкиПробы);
    ПисательПробы.ЗаписатьНачалоЭлемента("root");
    ПисательПробы.ЗаписатьАтрибут("a", "1");
    ПисательПробы.ЗаписатьАтрибут("b", "2");
    ПисательПробы.ЗаписатьНачалоЭлемента("child");
    ПисательПробы.ЗаписатьКонецЭлемента();
    ПисательПробы.ЗаписатьКонецЭлемента();
    ТекстПробы = ПисательПробы.Закрыть();
    Сообщить("MODE." + Строка(НомерРежима) + Символ(9)
        + СтрЗаменить(СтрЗаменить(ТекстПробы, Символ(13), "<CR>"), Символ(10), "<LF>"));
КонецЦикла;

Попытка
    НастройкиНедопустимогоОтступа = Новый ПараметрыЗаписиXML(
        "UTF-8", "1.0", Истина, Истина, "x");
    Сообщить("INVALID_CHARS" + Символ(9) + "ACCEPTED");
Исключение
    Сообщить("INVALID_CHARS" + Символ(9) + "ERROR");
КонецПопытки;
