// Конструктор и изменяемые строковые свойства описания передаваемого файла.

ПустоеОписание = Новый ОписаниеПередаваемогоФайла;
Если ТипЗнч(ПустоеОписание) = Тип("ОписаниеПередаваемогоФайла") Тогда
    Сообщить("TYPE" + Символ(9) + "OK");
Иначе
    Сообщить("TYPE" + Символ(9) + "OTHER");
КонецЕсли;
Если ТипЗнч(ПустоеОписание.Имя) = Тип("Строка") Тогда
    Сообщить("DEFAULT_NAME_TYPE" + Символ(9) + "STRING");
Иначе
    Сообщить("DEFAULT_NAME_TYPE" + Символ(9) + "OTHER");
КонецЕсли;
Сообщить("DEFAULT_NAME" + Символ(9) + "[" + ПустоеОписание.Имя + "]");
Если ТипЗнч(ПустоеОписание.Хранение) = Тип("Строка") Тогда
    Сообщить("DEFAULT_LOCATION_TYPE" + Символ(9) + "STRING");
Иначе
    Сообщить("DEFAULT_LOCATION_TYPE" + Символ(9) + "OTHER");
КонецЕсли;
Сообщить("DEFAULT_LOCATION" + Символ(9) + "[" + ПустоеОписание.Хранение + "]");

ОписаниеСИменем = Новый ОписаниеПередаваемогоФайла("client.txt");
Сообщить("ONE_NAME" + Символ(9) + ОписаниеСИменем.Имя);
Сообщить("ONE_LOCATION" + Символ(9) + "[" + ОписаниеСИменем.Хранение + "]");

ОписаниеПолное = Новый ОписаниеПередаваемогоФайла("client.txt", "server-key");
Сообщить("TWO" + Символ(9) + ОписаниеПолное.Имя + "|" + ОписаниеПолное.Хранение);
ОписаниеПолное.Имя = "updated.txt";
ОписаниеПолное.Хранение = "updated-key";
Сообщить("UPDATED" + Символ(9) + ОписаниеПолное.Имя + "|" + ОписаниеПолное.Хранение);

ОписаниеАлиас = New TransferableFileDescription("alias.txt", "alias-key");
Сообщить("ALIAS" + Символ(9) + ОписаниеАлиас.Имя + "|" + ОписаниеАлиас.Хранение);

Попытка
    ПлохоеОписание = Новый ОписаниеПередаваемогоФайла(1);
    Если ТипЗнч(ПлохоеОписание.Имя) = Тип("Строка") Тогда
        РезультатПроверки = "STRING|" + ПлохоеОписание.Имя;
    Иначе
        РезультатПроверки = "OTHER";
    КонецЕсли;
Исключение
    РезультатПроверки = "ERR";
КонецПопытки;
Сообщить("BAD_NAME" + Символ(9) + РезультатПроверки);

Попытка
    ОписаниеПолное.Хранение = 1;
    Если ТипЗнч(ОписаниеПолное.Хранение) = Тип("Строка") Тогда
        РезультатПроверки = "STRING|" + ОписаниеПолное.Хранение;
    Иначе
        РезультатПроверки = "OTHER";
    КонецЕсли;
Исключение
    РезультатПроверки = "ERR";
КонецПопытки;
Сообщить("BAD_LOCATION_SET" + Символ(9) + РезультатПроверки);
