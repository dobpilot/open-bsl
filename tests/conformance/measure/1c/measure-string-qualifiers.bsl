// PLATFORM-ONLY: проба фиксирует платформенное значение, которого ещё нет в runtime.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "string-qualifiers-1");
КвалификаторыПоУмолчанию = Новый КвалификаторыСтроки;
М("STRING.QUALIFIERS.TYPE", ТипЗнч(КвалификаторыПоУмолчанию));
М("STRING.QUALIFIERS.DEFAULT.LENGTH", КвалификаторыПоУмолчанию.Длина);
М("STRING.QUALIFIERS.DEFAULT.ALLOWED", КвалификаторыПоУмолчанию.ДопустимаяДлина);
М("STRING.QUALIFIERS.ENUM.VARIABLE", ДопустимаяДлина.Переменная);
М("STRING.QUALIFIERS.ENUM.FIXED", ДопустимаяДлина.Фиксированная);
М("STRING.QUALIFIERS.ENUM.TYPE", ТипЗнч(ДопустимаяДлина.Переменная));

АнглийскиеИмена = "ERROR";
Попытка
	АнглийскийКвалификатор = Вычислить("New StringQualifiers(7, AllowedLength.Fixed)");
	Если АнглийскийКвалификатор.Length = 7
		И АнглийскийКвалификатор.AllowedLength = AllowedLength.Fixed Тогда
		АнглийскиеИмена = "OK";
	КонецЕсли;
Исключение
КонецПопытки;
М("STRING.QUALIFIERS.ENGLISH", АнглийскиеИмена);

КвалификаторыФиксированные = Новый КвалификаторыСтроки(50, ДопустимаяДлина.Фиксированная);
М("STRING.QUALIFIERS.EXPLICIT.LENGTH", КвалификаторыФиксированные.Длина);
М("STRING.QUALIFIERS.EXPLICIT.ALLOWED", КвалификаторыФиксированные.ДопустимаяДлина);

КвалификаторыСОднимАргументом = Новый КвалификаторыСтроки(12);
М("STRING.QUALIFIERS.ONE.LENGTH", КвалификаторыСОднимАргументом.Длина);
М("STRING.QUALIFIERS.ONE.ALLOWED", КвалификаторыСОднимАргументом.ДопустимаяДлина);

ОтрицательнаяДлина = "OK";
ЗначениеОтрицательнойДлины = "";
Попытка
	ПробаОтрицательнойДлины = Новый КвалификаторыСтроки(-1);
	ЗначениеОтрицательнойДлины = ПробаОтрицательнойДлины.Длина;
Исключение
	ОтрицательнаяДлина = "ERROR";
КонецПопытки;
М("STRING.QUALIFIERS.NEGATIVE", ОтрицательнаяДлина);
М("STRING.QUALIFIERS.NEGATIVE.VALUE", ЗначениеОтрицательнойДлины);

ДробнаяДлина = "OK";
ЗначениеДробнойДлины = "";
Попытка
	ПробаДробнойДлины = Новый КвалификаторыСтроки(1.5);
	ЗначениеДробнойДлины = ПробаДробнойДлины.Длина;
Исключение
	ДробнаяДлина = "ERROR";
КонецПопытки;
М("STRING.QUALIFIERS.FRACTION", ДробнаяДлина);
М("STRING.QUALIFIERS.FRACTION.VALUE", ЗначениеДробнойДлины);

НеверныйВидДлины = "OK";
Попытка
	ПробаНеверногоВида = Новый КвалификаторыСтроки(1, Неопределено);
Исключение
	НеверныйВидДлины = "ERROR";
КонецПопытки;
М("STRING.QUALIFIERS.WRONG.ALLOWED", НеверныйВидДлины);

ЗаписьДлины = "OK";
Попытка
	КвалификаторыФиксированные.Длина = 10;
Исключение
	ЗаписьДлины = "ERROR";
КонецПопытки;
М("STRING.QUALIFIERS.WRITE.LENGTH", ЗаписьДлины);

ЗаписьВида = "OK";
Попытка
	КвалификаторыФиксированные.ДопустимаяДлина = ДопустимаяДлина.Переменная;
Исключение
	ЗаписьВида = "ERROR";
КонецПопытки;
М("STRING.QUALIFIERS.WRITE.ALLOWED", ЗаписьВида);

М("file.end", "string-qualifiers-1");
