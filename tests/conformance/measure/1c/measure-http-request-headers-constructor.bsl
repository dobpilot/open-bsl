// Заголовки второго параметра конструктора HTTP-запроса.

ИсходныеЗаголовки = Новый Соответствие;
ИсходныеЗаголовки.Вставить("X-Test", "first");
ЗапросПробы = Новый HTTPЗапрос("/probe", ИсходныеЗаголовки);
Сообщить("RESOURCE" + Символ(9) + ЗапросПробы.АдресРесурса);
Сообщить("FIRST" + Символ(9) + ЗапросПробы.Заголовки.Получить("X-Test"));
ИсходныеЗаголовки.Вставить("X-Test", "changed");
Сообщить("ALIAS" + Символ(9) + ЗапросПробы.Заголовки.Получить("X-Test"));
ЗапросПробы.Заголовки.Вставить("X-Back", "seen");
Сообщить("BACK" + Символ(9) + ИсходныеЗаголовки.Получить("X-Back"));
