// Декодирование Base64 из двоичных данных для запуска модулей конфигурации.

ТекстыПроб = Новый Массив;
ТекстыПроб.Добавить("TWE=");
ТекстыПроб.Добавить("");
ТекстыПроб.Добавить("T?WE=");
ТекстыПроб.Добавить("TWE");
ТекстыПроб.Добавить(" TWE= ");
ТекстыПроб.Добавить("Ж");
ТекстыПроб.Добавить("TWE=Z");
ТекстыПроб.Добавить("TWE=?");
ТекстыПроб.Добавить("?TWE=");
ТекстыПроб.Добавить("TW?E=");
ТекстыПроб.Добавить("TWE=!");
ТекстыПроб.Добавить("TWE=.");
ТекстыПроб.Добавить("TWE=?Z");
ТекстыПроб.Добавить("TQ==?");
ТекстыПроб.Добавить("TQ==A");
ТекстыПроб.Добавить("TWE=Ж");
ТекстыПроб.Добавить("TWFu");
ТекстыПроб.Добавить("TWFu ");
ТекстыПроб.Добавить("TWFu?");
ТекстыПроб.Добавить("TWFuZ");
ТекстыПроб.Добавить("TWE==");
ТекстыПроб.Добавить("TWE===");

Для Каждого ТекстПробы Из ТекстыПроб Цикл
    ВходныеДанные = ПолучитьДвоичныеДанныеИзСтроки(
        ТекстПробы, КодировкаТекста.UTF8, Ложь);
    Попытка
        РезультатДекодирования = ПолучитьДвоичныеДанныеИзBase64ДвоичныхДанных(ВходныеДанные);
        ПредставлениеРезультата = Строка(РезультатДекодирования.Размер())
            + ":" + ПолучитьBase64СтрокуИзДвоичныхДанных(РезультатДекодирования);
    Исключение
        ПредставлениеРезультата = "ERROR";
    КонецПопытки;
    Сообщить("DECODE." + ТекстПробы + Символ(9) + ПредставлениеРезультата);
КонецЦикла;

КодыПробельныхСимволов = Новый Массив;
КодыПробельныхСимволов.Добавить(9);
КодыПробельныхСимволов.Добавить(10);
КодыПробельныхСимволов.Добавить(13);
КодыПробельныхСимволов.Добавить(32);
КодыПробельныхСимволов.Добавить(160);
Для Каждого КодСимвола Из КодыПробельныхСимволов Цикл
    Для Каждого ПоложениеПробела Из СтрРазделить("LEADING,INNER,TRAILING", ",") Цикл
        Если ПоложениеПробела = "LEADING" Тогда
            ТекстПробела = Символ(КодСимвола) + "TWE=";
        ИначеЕсли ПоложениеПробела = "INNER" Тогда
            ТекстПробела = "TW" + Символ(КодСимвола) + "E=";
        Иначе
            ТекстПробела = "TWE=" + Символ(КодСимвола);
        КонецЕсли;
        ВходныеДанные = ПолучитьДвоичныеДанныеИзСтроки(
            ТекстПробела, КодировкаТекста.UTF8, Ложь);
        РезультатДекодирования = ПолучитьДвоичныеДанныеИзBase64ДвоичныхДанных(ВходныеДанные);
        Сообщить("WHITESPACE." + Строка(КодСимвола) + "." + ПоложениеПробела
            + Символ(9) + Строка(РезультатДекодирования.Размер()));
    КонецЦикла;
КонецЦикла;
