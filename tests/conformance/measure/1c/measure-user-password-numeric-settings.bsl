// PLATFORM-ONLY: проба фиксирует чтение числовых настроек паролей.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "user-password-numeric-settings-1");
М("PASSWORD.MAX.PERIOD", Строка(ТипЗнч(ПолучитьМаксимальныйСрокДействияПаролейПользователей())) + "|" + Строка(ПолучитьМаксимальныйСрокДействияПаролейПользователей()));
М("PASSWORD.MIN.PERIOD", Строка(ТипЗнч(ПолучитьМинимальныйСрокДействияПаролейПользователей())) + "|" + Строка(ПолучитьМинимальныйСрокДействияПаролейПользователей()));
М("PASSWORD.REUSE.LIMIT", Строка(ТипЗнч(ПолучитьОграничениеПовторенияПаролейПользователейСредиПоследних())) + "|" + Строка(ПолучитьОграничениеПовторенияПаролейПользователейСредиПоследних()));
М("PASSWORD.EXPIRATION.NOTIFICATION", Строка(ТипЗнч(ПолучитьСрокПредупрежденияОбИстеченииСрокаДействияПаролейПользователей())) + "|" + Строка(ПолучитьСрокПредупрежденияОбИстеченииСрокаДействияПаролейПользователей()));

АнглийскиеИмена = "ERROR";
Попытка
	Если ТипЗнч(GetUserPasswordMaxEffectivePeriod()) = Тип("Число")
		И ТипЗнч(GetUserPasswordMinEffectivePeriod()) = Тип("Число")
		И ТипЗнч(GetUserPasswordReuseLimit()) = Тип("Число")
		И ТипЗнч(GetUserPasswordExpirationNotificationPeriod()) = Тип("Число") Тогда
		АнглийскиеИмена = "OK";
	КонецЕсли;
Исключение
КонецПопытки;
М("PASSWORD.NUMERIC.ENGLISH", АнглийскиеИмена);
М("file.end", "user-password-numeric-settings-1");
