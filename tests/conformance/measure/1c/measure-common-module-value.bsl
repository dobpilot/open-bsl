// PLATFORM-ONLY: проба фиксирует серверный общий модуль как значение.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция ДождатьсяЗавершения(Задание)
	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 30000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Свежее = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
			Задание.УникальныйИдентификатор);
		Если Свежее = Неопределено
			Или Свежее.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
			Возврат Свежее;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

М("file.begin", "common-module-value-1");
Задание = ФоновыеЗадания.Выполнить("ЗамерыЗначенияМодуля.Проверить");
Итог = ДождатьсяЗавершения(Задание);
М("MODULE.VALUE.JOB.STATE", Итог.Состояние);
М("MODULE.VALUE.JOB.ERROR.TYPE", ТипЗнч(Итог.ИнформацияОбОшибке));
М("file.end", "common-module-value-1");
