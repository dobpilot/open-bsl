// PLATFORM-ONLY: проба фиксирует достигнутую поверхность форматированной строки.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "formatted-string-1");

РезультатТипа = "ERROR";
Попытка
	ЗначениеФС = Вычислить("Новый ФорматированнаяСтрока()");
	РезультатТипа = Строка(ТипЗнч(ЗначениеФС));
Исключение
КонецПопытки;
М("FORMATTED.EMPTY.TYPE", РезультатТипа);

РезультатПустойСтроки = "ERROR";
Попытка
	РезультатПустойСтроки = Строка(Вычислить("Новый ФорматированнаяСтрока()"));
Исключение
КонецПопытки;
М("FORMATTED.EMPTY.STRING", РезультатПустойСтроки);

РезультатЗаполненности = "ERROR";
Попытка
	РезультатЗаполненности = ЗначениеЗаполнено(Вычислить("Новый ФорматированнаяСтрока()"));
Исключение
КонецПопытки;
М("FORMATTED.EMPTY.FILLED", РезультатЗаполненности);

РезультатСостава = "ERROR";
Попытка
	РезультатСостава = Строка(Вычислить("Новый ФорматированнаяСтрока(""а"", Новый ФорматированнаяСтрока(""одна""), ""б"")"));
Исключение
КонецПопытки;
М("FORMATTED.CONCAT", РезультатСостава);

РезультатЗаполненного = "ERROR";
Попытка
	РезультатЗаполненного = ЗначениеЗаполнено(Вычислить("Новый ФорматированнаяСтрока(""x"")"));
Исключение
КонецПопытки;
М("FORMATTED.FILLED", РезультатЗаполненного);

РезультатПустогоТекста = "ERROR";
Попытка
	РезультатПустогоТекста = Строка(ЗначениеЗаполнено(Вычислить("Новый ФорматированнаяСтрока("""")")))
		+ "|" + Строка(ЗначениеЗаполнено(Вычислить("Новый ФорматированнаяСтрока("" "")")));
Исключение
КонецПопытки;
М("FORMATTED.BLANK.FILLED", РезультатПустогоТекста);

РезультатСсылки = "ERROR";
Попытка
	РезультатСсылки = Строка(Вычислить("Новый ФорматированнаяСтрока(""ссылка"", , , , ""target"")"));
Исключение
КонецПопытки;
М("FORMATTED.STYLED.STRING", РезультатСсылки);

РезультатРавенства = "ERROR";
Попытка
	РезультатРавенства = Строка(Вычислить("Новый ФорматированнаяСтрока(""x"") = Новый ФорматированнаяСтрока(""x"")"))
		+ "|" + Строка(Вычислить("Новый ФорматированнаяСтрока(""x"") = Новый ФорматированнаяСтрока(""y"")"));
Исключение
КонецПопытки;
М("FORMATTED.EQUALITY", РезультатРавенства);

РезультатРавенстваСсылок = "ERROR";
Попытка
	РезультатРавенстваСсылок = Вычислить("Новый ФорматированнаяСтрока(""x"", , , , ""a"") = Новый ФорматированнаяСтрока(""x"", , , , ""b"")");
Исключение
КонецПопытки;
М("FORMATTED.LINK.EQUALITY", РезультатРавенстваСсылок);

Неверное = "ACCEPTED";
Попытка
	НеверноеЗначение = Вычислить("Новый ФорматированнаяСтрока(1)");
Исключение
	Неверное = "ERROR";
КонецПопытки;
М("FORMATTED.BAD.CONTENT", Неверное);

АнглийскоеИмя = "ERROR";
Попытка
	АнглийскоеИмя = Строка(Вычислить("Новый FormattedString(""ok"")"));
Исключение
КонецПопытки;
М("FORMATTED.ENGLISH", АнглийскоеИмя);

РезультатКартинки = "ERROR";
Попытка
	РезультатКартинки = Строка(Вычислить("Новый ФорматированнаяСтрока(БиблиотекаКартинок.ФорматированнаяСтрока)"));
Исключение
КонецПопытки;
М("FORMATTED.PICTURE.STRING", РезультатКартинки);
М("file.end", "formatted-string-1");
