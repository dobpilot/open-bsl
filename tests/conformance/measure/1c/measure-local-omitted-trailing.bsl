// Явно пустой последний слот обязательного параметра локальной функции.

Функция ПробаХвоста(Первый, Второй)
	Если Первый = 1 И Второй = Неопределено Тогда
		Возврат "PASS";
	КонецЕсли;
	Возврат "FAIL";
КонецФункции

Попытка
	Сообщить("TRAILING" + Символ(9) + ПробаХвоста(1, ));
Исключение
	Сообщить("ERROR" + Символ(9) + "YES");
КонецПопытки;
