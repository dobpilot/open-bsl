// PLATFORM-ONLY: изменяет и восстанавливает константу только собственной базы.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "session-transaction-rollback-data-1");
ИсходноеЗначениеПробы = Константы.ЗначениеОпцииПробы.Получить();
ПробаЗавершена = Ложь;
Попытка
	Константы.ЗначениеОпцииПробы.Установить(Ложь);
	НачатьТранзакцию();
	Константы.ЗначениеОпцииПробы.Установить(Истина);
	НачатьТранзакцию();
	ОтменитьТранзакцию();
	М("SESSION_TRANSACTION.DATA.ACTIVE_AFTER_INNER_ROLLBACK", ТранзакцияАктивна());
	ЧтениеПослеОткатаПробы = Ложь;
	Попытка
		ЗначениеПослеОткатаПробы = Константы.ЗначениеОпцииПробы.Получить();
		ЧтениеПослеОткатаПробы = Истина;
	Исключение
		ЧтениеПослеОткатаПробы = Ложь;
	КонецПопытки;
	М("SESSION_TRANSACTION.DATA.READ_AFTER_INNER_ROLLBACK", ЧтениеПослеОткатаПробы);
	ЗафиксироватьТранзакцию();
	М("SESSION_TRANSACTION.DATA.ACTIVE_AFTER_OUTER_COMMIT", ТранзакцияАктивна());
	М("SESSION_TRANSACTION.DATA.VALUE_AFTER_OUTER_COMMIT", Константы.ЗначениеОпцииПробы.Получить());
	ПробаЗавершена = Истина;
Исключение
	Если ТранзакцияАктивна() Тогда
		ОтменитьТранзакцию();
	КонецЕсли;
КонецПопытки;
М("SESSION_TRANSACTION.DATA.COMPLETE", ПробаЗавершена);
Константы.ЗначениеОпцииПробы.Установить(ИсходноеЗначениеПробы);
М("SESSION_TRANSACTION.DATA.RESTORED", Константы.ЗначениеОпцииПробы.Получить() = ИсходноеЗначениеПробы);
НачатьТранзакцию();
НачатьТранзакцию();
ОтменитьТранзакцию();
ПовторныйСтартПробы = Ложь;
Попытка
	НачатьТранзакцию();
	ПовторныйСтартПробы = Истина;
Исключение
	ПовторныйСтартПробы = Ложь;
КонецПопытки;
М("SESSION_TRANSACTION.DATA.BEGIN_AFTER_INNER_ROLLBACK", ПовторныйСтартПробы);
Пока ТранзакцияАктивна() Цикл
	ОтменитьТранзакцию();
КонецЦикла;
М("SESSION_TRANSACTION.DATA.FINAL_INACTIVE", Не ТранзакцияАктивна());
М("file.end", "session-transaction-rollback-data-1");
