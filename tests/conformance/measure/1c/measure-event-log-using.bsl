// PLATFORM-ONLY: проба фиксирует чтение включённых уровней журнала регистрации.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "event-log-using-1");

Уровни = ПолучитьИспользованиеЖурналаРегистрации();
М("EVENT.LOG.USING.TYPE", ТипЗнч(Уровни));
М("EVENT.LOG.USING.COUNT", Уровни.Количество());
М("EVENT.LOG.USING.NOTE", Уровни.Найти(УровеньЖурналаРегистрации.Примечание) <> Неопределено);
М("EVENT.LOG.USING.INFORMATION", Уровни.Найти(УровеньЖурналаРегистрации.Информация) <> Неопределено);
М("EVENT.LOG.USING.WARNING", Уровни.Найти(УровеньЖурналаРегистрации.Предупреждение) <> Неопределено);
М("EVENT.LOG.USING.ERROR", Уровни.Найти(УровеньЖурналаРегистрации.Ошибка) <> Неопределено);

АнглийскоеИмя = "ERROR";
Попытка
	EnglishLevels = GetEventLogUsing();
	Если TypeOf(EnglishLevels) = Type("Array") Тогда
		АнглийскоеИмя = "OK";
	КонецЕсли;
Исключение
КонецПопытки;
М("EVENT.LOG.USING.ENGLISH", АнглийскоеИмя);

М("file.end", "event-log-using-1");
