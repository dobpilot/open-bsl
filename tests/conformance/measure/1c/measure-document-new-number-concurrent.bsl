Попытка
    ФайлПервогоРезерваПробы = Новый Файл("/tmp/open-bsl-number-concurrent-096/first.ready");
    ФайлВторогоРезерваПробы = Новый Файл("/tmp/open-bsl-number-concurrent-096/second.ready");
    ПервыйРезервПробы = Не ФайлПервогоРезерваПробы.Существует();
    ОбъектРезерваПробы = Вычислить("Документы.ЗамерДокумента.СоздатьДокумент()");
    ОбъектРезерваПробы.УстановитьНовыйНомер();
    ИмяРезерваПробы = ?(ПервыйРезервПробы, "first", "second");
    СтрокаРезерваПробы = "document.number.concurrent." + ИмяРезерваПробы + "=[" + ОбъектРезерваПробы.Номер + "]";
    ДокументРезерваПробы = Новый ТекстовыйДокумент;
    ДокументРезерваПробы.УстановитьТекст(СтрокаРезерваПробы);
    ДокументРезерваПробы.Записать("/tmp/open-bsl-number-concurrent-096/" + ИмяРезерваПробы + ".ready");
    Если ПервыйРезервПробы Тогда
        ПределРезерваПробы = ТекущаяУниверсальнаяДатаВМиллисекундах() + 30000;
        Пока Не ФайлВторогоРезерваПробы.Существует() Цикл
            Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= ПределРезерваПробы Тогда
                ВызватьИсключение "second session did not reserve a number";
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Если ПервыйРезервПробы Тогда
        Сообщить("document.number.concurrent.first=[" + ОбъектРезерваПробы.Номер + "]");
    КонецЕсли;
Исключение
    Сообщить("document.number.concurrent.error=" + ОписаниеОшибки());
КонецПопытки;
