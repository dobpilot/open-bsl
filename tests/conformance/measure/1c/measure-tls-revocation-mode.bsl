// Режим проверки отзыва TLS-сертификата и третья позиция конструктора.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Процедура Член(Ид, Русское, Английское)
	М(Ид, Строка(ТипЗнч(Русское)) + Символ(9) + Строка(Русское)
		+ Символ(9) + ?(Русское = Английское, "Yes", "No"));
КонецПроцедуры

Процедура Свойство(Ид, Значение)
	Соединение = Новый ЗащищенноеСоединениеOpenSSL(
		Неопределено, Неопределено, Значение);
	М(Ид, Строка(ТипЗнч(Соединение.РежимПроверкиОтзываTLSСертификатаСервера))
		+ Символ(9) + Строка(Соединение.РежимПроверкиОтзываTLSСертификатаСервера));
КонецПроцедуры

Член("TLS_REVOCATION.AUTO", РежимПроверкиОтзываTLSСертификатаСервера.Авто,
	ServerTLSCertificateRevocationCheckMode.Auto);
Член("TLS_REVOCATION.DONT_CHECK", РежимПроверкиОтзываTLSСертификатаСервера.НеПроверять,
	ServerTLSCertificateRevocationCheckMode.DontCheck);
Член("TLS_REVOCATION.SOFT_FAIL", РежимПроверкиОтзываTLSСертификатаСервера.Нестрогий,
	ServerTLSCertificateRevocationCheckMode.SoftFail);
Член("TLS_REVOCATION.STRICT", РежимПроверкиОтзываTLSСертификатаСервера.Строгий,
	ServerTLSCertificateRevocationCheckMode.Strict);

ПоУмолчанию = Новый ЗащищенноеСоединениеOpenSSL;
М("TLS_REVOCATION.DEFAULT", Строка(ТипЗнч(
	ПоУмолчанию.РежимПроверкиОтзываTLSСертификатаСервера)) + Символ(9)
	+ Строка(ПоУмолчанию.РежимПроверкиОтзываTLSСертификатаСервера));

ЯвноНеопределено = Новый ЗащищенноеСоединениеOpenSSL(
	Неопределено, Неопределено, Неопределено);
М("TLS_REVOCATION.UNDEFINED", Строка(ТипЗнч(
	ЯвноНеопределено.РежимПроверкиОтзываTLSСертификатаСервера)) + Символ(9)
	+ Строка(ЯвноНеопределено.РежимПроверкиОтзываTLSСертификатаСервера));

Свойство("TLS_REVOCATION.PROPERTY.AUTO", РежимПроверкиОтзываTLSСертификатаСервера.Авто);
Свойство("TLS_REVOCATION.PROPERTY.DONT_CHECK", РежимПроверкиОтзываTLSСертификатаСервера.НеПроверять);
Свойство("TLS_REVOCATION.PROPERTY.SOFT_FAIL", РежимПроверкиОтзываTLSСертификатаСервера.Нестрогий);
Свойство("TLS_REVOCATION.PROPERTY.STRICT", РежимПроверкиОтзываTLSСертификатаСервера.Строгий);

НеверныйТип = "OK";
Попытка
	НеверноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(
		Неопределено, Неопределено, 1);
Исключение
	НеверныйТип = "ERROR";
КонецПопытки;
М("TLS_REVOCATION.INVALID_TYPE", НеверныйТип);

ЧетыреАргумента = "OK";
Попытка
	РезультатЧетырех = Вычислить("Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено, Неопределено, Неопределено)");
Исключение
	ЧетыреАргумента = "ERROR";
КонецПопытки;
М("TLS_REVOCATION.FOUR", ЧетыреАргумента);
