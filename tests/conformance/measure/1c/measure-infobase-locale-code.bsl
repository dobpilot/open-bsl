// PLATFORM-ONLY: локализация базы и локализация сеанса — разные источники.

Попытка
	Сообщить("INFOBASE" + Символ(9) + КодЛокализацииИнформационнойБазы() + Символ(9) + Строка(ТипЗнч(КодЛокализацииИнформационнойБазы())));
Исключение
	Сообщить("INFOBASE_ERROR" + Символ(9) + ОписаниеОшибки());
КонецПопытки;

Попытка
	Сообщить("CURRENT" + Символ(9) + ТекущийКодЛокализации() + Символ(9) + Строка(ТипЗнч(ТекущийКодЛокализации())));
Исключение
	Сообщить("CURRENT_ERROR" + Символ(9) + ОписаниеОшибки());
КонецПопытки;

Попытка
	Сообщить("ALIAS" + Символ(9) + ?(InfoBaseLocaleCode() = КодЛокализацииИнформационнойБазы(), "Yes", "No"));
Исключение
	Сообщить("ALIAS_ERROR" + Символ(9) + ОписаниеОшибки());
КонецПопытки;
