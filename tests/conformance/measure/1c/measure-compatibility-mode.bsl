// PLATFORM-ONLY: проба требует настоящего объекта Метаданные конфигурации.
// Она фиксирует тип, состав и представления режима совместимости.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция ОписаниеРежимаСовместимости(Имя)
	Попытка
		РежимыСовместимости = Метаданные.СвойстваОбъектов.РежимСовместимости;
		ЗначениеРежима = РежимыСовместимости[Имя];
		Возврат Строка(ТипЗнч(ЗначениеРежима)) + ":" + Строка(ЗначениеРежима);
	Исключение
		Возврат "ERROR:" + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

М("file.begin", "compatibility-mode-1");

