// PLATFORM-ONLY: проба фиксирует поведение пустой картинки без ввода-вывода.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "empty-picture-1");
Картинка1 = Новый Картинка();
Картинка2 = Новый Картинка();
М("PICTURE.EMPTY.TYPE", ТипЗнч(Картинка1));
М("PICTURE.EMPTY.STRING", "[" + Строка(Картинка1) + "]");
М("PICTURE.EMPTY.FILLED", ЗначениеЗаполнено(Картинка1));
М("PICTURE.EMPTY.EQUAL", Картинка1 = Картинка2);

АнглийскоеИмя = "ERROR";
Попытка
	Если ТипЗнч(New Picture()) = ТипЗнч(Картинка1) Тогда
		АнглийскоеИмя = "OK";
	КонецЕсли;
Исключение
КонецПопытки;
М("PICTURE.EMPTY.ENGLISH", АнглийскоеИмя);
М("file.end", "empty-picture-1");
