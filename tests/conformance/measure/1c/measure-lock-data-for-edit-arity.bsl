// PLATFORM-ONLY: недопустимый ключ позволяет проверить арность без блокировки.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция Проба(Команда)
	Попытка
		Выполнить(Команда);
		Возврат "OK";
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
КонецФункции

М("file.begin", "lock-data-for-edit-arity-1");
М("LOCK.EDIT.ZERO", Проба("ЗаблокироватьДанныеДляРедактирования()"));
М("LOCK.EDIT.ONE", Проба("ЗаблокироватьДанныеДляРедактирования(Неопределено)"));
М("LOCK.EDIT.TWO", Проба("ЗаблокироватьДанныеДляРедактирования(Неопределено, Неопределено)"));
М("LOCK.EDIT.THREE", Проба("ЗаблокироватьДанныеДляРедактирования(Неопределено, Неопределено, Неопределено)"));
М("LOCK.EDIT.FOUR", Проба("ЗаблокироватьДанныеДляРедактирования(Неопределено, Неопределено, Неопределено, Неопределено)"));
М("LOCK.EDIT.ENGLISH", Проба("LockDataForEdit(Undefined)"));
М("file.end", "lock-data-for-edit-arity-1");
