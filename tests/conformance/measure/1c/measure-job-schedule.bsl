// PLATFORM-ONLY: проба фиксирует объект-значение расписания без запуска заданий.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "job-schedule-1");
РасписаниеЗадания = Новый РасписаниеРегламентногоЗадания;
М("JOB.SCHEDULE.TYPE", ТипЗнч(РасписаниеЗадания));
М("JOB.SCHEDULE.DEFAULT.BEGIN_DATE.EMPTY", РасписаниеЗадания.ДатаНачала = Дата(1, 1, 1));
М("JOB.SCHEDULE.DEFAULT.END_DATE.EMPTY", РасписаниеЗадания.ДатаКонца = Дата(1, 1, 1));
М("JOB.SCHEDULE.DEFAULT.BEGIN_TIME.EMPTY", РасписаниеЗадания.ВремяНачала = Дата(1, 1, 1));
М("JOB.SCHEDULE.DEFAULT.END_TIME.EMPTY", РасписаниеЗадания.ВремяКонца = Дата(1, 1, 1));
М("JOB.SCHEDULE.DEFAULT.COMPLETION_TIME.EMPTY", РасписаниеЗадания.ВремяЗавершения = Дата(1, 1, 1));
М("JOB.SCHEDULE.DEFAULT.DAY_IN_MONTH", РасписаниеЗадания.ДеньВМесяце);
М("JOB.SCHEDULE.DEFAULT.WEEK_DAY_IN_MONTH", РасписаниеЗадания.ДеньНеделиВМесяце);
М("JOB.SCHEDULE.DEFAULT.COMPLETION_INTERVAL", РасписаниеЗадания.ИнтервалЗавершения);
М("JOB.SCHEDULE.DEFAULT.REPEAT_PAUSE", РасписаниеЗадания.ПаузаПовтора);
М("JOB.SCHEDULE.DEFAULT.WEEKS_PERIOD", РасписаниеЗадания.ПериодНедель);
М("JOB.SCHEDULE.DEFAULT.REPEAT_PERIOD_IN_DAY", РасписаниеЗадания.ПериодПовтораВТечениеДня);
М("JOB.SCHEDULE.DEFAULT.DAYS_REPEAT_PERIOD", РасписаниеЗадания.ПериодПовтораДней);
М("JOB.SCHEDULE.DEFAULT.WEEK_DAYS.COUNT", РасписаниеЗадания.ДниНедели.Количество());
М("JOB.SCHEDULE.DEFAULT.MONTHS.COUNT", РасписаниеЗадания.Месяцы.Количество());
М("JOB.SCHEDULE.DEFAULT.DETAILS.COUNT", РасписаниеЗадания.ДетальныеРасписанияДня.Количество());

РезультатЗаписи = "ERROR";
Попытка
	РасписаниеЗадания.ДатаНачала = '20240101';
	РасписаниеЗадания.ДатаКонца = '20241231';
	РасписаниеЗадания.ВремяНачала = '00010101090000';
	РасписаниеЗадания.ВремяКонца = '00010101180000';
	РасписаниеЗадания.ВремяЗавершения = '00010101190000';
	РасписаниеЗадания.ДеньВМесяце = 1;
	РасписаниеЗадания.ДеньНеделиВМесяце = 1;
	РасписаниеЗадания.ИнтервалЗавершения = 1;
	РасписаниеЗадания.ПаузаПовтора = 1;
	РасписаниеЗадания.ПериодНедель = 1;
	РасписаниеЗадания.ПериодПовтораВТечениеДня = 1;
	РасписаниеЗадания.ПериодПовтораДней = 1;
	РасписаниеЗадания.ДниНедели.Добавить(1);
	РасписаниеЗадания.Месяцы.Добавить(1);
	ДетальЗадания = Новый РасписаниеРегламентногоЗадания;
	ДетальЗадания.ВремяНачала = '00010101100000';
	РасписаниеЗадания.ДетальныеРасписанияДня.Добавить(ДетальЗадания);
	РезультатЗаписи = "OK";
Исключение
КонецПопытки;
М("JOB.SCHEDULE.WRITE", РезультатЗаписи);

ПроверкаПоУмолчанию = Новый РасписаниеРегламентногоЗадания;
РезультатПроверкиПоУмолчанию = "ERROR";
Попытка
	РезультатПроверкиПоУмолчанию = ПроверкаПоУмолчанию.ТребуетсяВыполнение('20240101120000');
Исключение
КонецПопытки;
М("JOB.SCHEDULE.EXECUTION.DEFAULT", РезультатПроверкиПоУмолчанию);
ПроверкаКаждыйДень = Новый РасписаниеРегламентногоЗадания;
ПроверкаКаждыйДень.ПериодПовтораДней = 1;
РезультатПроверкиКаждыйДень = "ERROR";
Попытка
	РезультатПроверкиКаждыйДень = ПроверкаКаждыйДень.ТребуетсяВыполнение('20240101120000', '20231231120000');
Исключение
КонецПопытки;
М("JOB.SCHEDULE.EXECUTION.DAILY", РезультатПроверкиКаждыйДень);

М("file.end", "job-schedule-1");
