// PLATFORM-ONLY: проба читает настройку события и записывает то же значение обратно.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "event-log-event-use-operations-1");

ИмяСобытия = "_$Access$_.Access";
Текущее = ПолучитьИспользованиеСобытияЖурналаРегистрации(ИмяСобытия);
М("EVENT.LOG.USE.GET.TYPE", ТипЗнч(Текущее));
М("EVENT.LOG.USE.GET.ENABLED.TYPE", ТипЗнч(Текущее.Использование));

РусскаяЗапись = "ERROR";
Попытка
	УстановитьИспользованиеСобытияЖурналаРегистрации(ИмяСобытия, Текущее);
	РусскаяЗапись = "OK";
Исключение
КонецПопытки;
М("EVENT.LOG.USE.SET.RUSSIAN", РусскаяЗапись);

АнглийскиеИмена = "ERROR";
Попытка
	English = GetEventLogEventUse(ИмяСобытия);
	SetEventLogEventUse(ИмяСобытия, English);
	Если ТипЗнч(English) = ТипЗнч(Текущее) Тогда
		АнглийскиеИмена = "OK";
	КонецЕсли;
Исключение
КонецПопытки;
М("EVENT.LOG.USE.OPERATIONS.ENGLISH", АнглийскиеИмена);

НеверноеИмя = "ACCEPTED";
Попытка
	ПолучитьИспользованиеСобытияЖурналаРегистрации(1);
Исключение
	НеверноеИмя = "ERROR";
КонецПопытки;
М("EVENT.LOG.USE.GET.BAD.NAME", НеверноеИмя);

НеверноеЗначение = "ACCEPTED";
Попытка
	УстановитьИспользованиеСобытияЖурналаРегистрации(ИмяСобытия, Истина);
Исключение
	НеверноеЗначение = "ERROR";
КонецПопытки;
М("EVENT.LOG.USE.SET.BAD.VALUE", НеверноеЗначение);

М("file.end", "event-log-event-use-operations-1");
