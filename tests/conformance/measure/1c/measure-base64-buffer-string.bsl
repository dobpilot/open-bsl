// Длина строк Base64 и границы переноса для буфера двоичных данных.

Для Каждого РазмерПробы Из СтрРазделить("0,1,47,48,49,93,94,95,96,97,143,144,145", ",") Цикл
    ТекстПробы = "";
    Для ИндексПробы = 1 По Число(РазмерПробы) Цикл
        ТекстПробы = ТекстПробы + "A";
    КонецЦикла;
    БуферПробы = ПолучитьБуферДвоичныхДанныхИзСтроки(ТекстПробы, "UTF-8");
    СтрокаBase64 = ПолучитьBase64СтрокуИзБуфераДвоичныхДанных(БуферПробы);
    Сообщить("SIZE." + РазмерПробы + Символ(9)
        + Строка(СтрДлина(СтрокаBase64)) + ":"
        + СтрЗаменить(СтрокаBase64, Символ(13) + Символ(10), "|"));
    Если СтрокаBase64 = GetBase64StringFromBinaryDataBuffer(БуферПробы) Тогда
        Сообщить("ALIAS." + РазмерПробы + Символ(9) + "PASS");
    Иначе
        Сообщить("ALIAS." + РазмерПробы + Символ(9) + "FAIL");
    КонецЕсли;
КонецЦикла;

Попытка
    ПолучитьBase64СтрокуИзБуфераДвоичныхДанных("не буфер");
    Сообщить("TYPE" + Символ(9) + "NO_ERROR");
Исключение
    Сообщить("TYPE" + Символ(9) + "ERROR");
КонецПопытки;
