// Положение картинки кнопки формы в серверном контексте.

Процедура ПроверитьЧлен(Ключ, Значение, Псевдоним)
    Если Значение = Псевдоним Тогда
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "PASS");
    Иначе
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "FAIL");
    КонецЕсли;
КонецПроцедуры

ПроверитьЧлен("AUTO", ПоложениеКартинкиКнопкиФормы.Авто, FormButtonPictureLocation.Auto);
ПроверитьЧлен("LEFT", ПоложениеКартинкиКнопкиФормы.Лево, FormButtonPictureLocation.Left);
ПроверитьЧлен("RIGHT", ПоложениеКартинкиКнопкиФормы.Право, FormButtonPictureLocation.Right);
Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(ПоложениеКартинкиКнопкиФормы.Авто)));
