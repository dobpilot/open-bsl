// Границы часа на обычной и пустой дате.

ДатаПроверки = Дата(2024, 2, 17, 13, 24, 35);
Сообщить("BEGIN" + Символ(9) + Строка(НачалоЧаса(ДатаПроверки)));
Сообщить("END" + Символ(9) + Строка(КонецЧаса(ДатаПроверки)));
Сообщить("BEGIN_ALIAS" + Символ(9) + Строка(BegOfHour(ДатаПроверки)));
Сообщить("END_ALIAS" + Символ(9) + Строка(EndOfHour(ДатаПроверки)));
Сообщить("EMPTY_BEGIN" + Символ(9) + Строка(НачалоЧаса(Дата(1, 1, 1))));
Сообщить("EMPTY_END" + Символ(9) + Строка(КонецЧаса(Дата(1, 1, 1))));
