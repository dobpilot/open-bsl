// PLATFORM-ONLY: проба фиксирует достигнутый серверный срез обработки ошибок.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "error-processing-1");
Настройки = ОбработкаОшибок.ПолучитьНастройкиПользователя();
М("ERROR.SETTINGS.TYPE", ТипЗнч(Настройки));
М("ERROR.SETTINGS.SEND", Настройки.ОтправлятьОтчетНаКлиенте);
М("ERROR.SETTINGS.SEND.TYPE", ТипЗнч(Настройки.ОтправлятьОтчетНаКлиенте));
М("ERROR.SETTINGS.ADDRESS", Настройки.АдресСервисаОбработкиОшибок);
М("ERROR.MODE.AUTO", РежимОтправкиИнформацииОбОшибке.Авто);
М("ERROR.MODE.DONT", РежимОтправкиИнформацииОбОшибке.НеОтправлять);
М("ERROR.MODE.ASK", РежимОтправкиИнформацииОбОшибке.СпрашиватьПользователя);
М("ERROR.MODE.SEND", РежимОтправкиИнформацииОбОшибке.Отправлять);
М("ERROR.MODE.ALIAS", РежимОтправкиИнформацииОбОшибке.Авто = ErrorReportingMode.Auto);
Попытка
	ВызватьИсключение "Пробная ошибка";
Исключение
	Ошибка = ИнформацияОбОшибке();
	М("ERROR.BRIEF.MATCH", ОбработкаОшибок.КраткоеПредставлениеОшибки(Ошибка) = КраткоеПредставлениеОшибки(Ошибка));
	М("ERROR.DETAIL.MATCH", ОбработкаОшибок.ПодробноеПредставлениеОшибки(Ошибка) = ПодробноеПредставлениеОшибки(Ошибка));
КонецПопытки;
М("file.end", "error-processing-1");
