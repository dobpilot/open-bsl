# Старые маркеры не должны выглядеть результатом нового запуска.
marker /tmp/open-bsl-transitive-args-096-parent.marker
marker /tmp/open-bsl-transitive-args-096-argument.marker

# Ошибочный дочерний модуль изолирован от остальных проб.
copy-tree tests/conformance/measure/1c/cfg-src-transitive-unused
child CommonModule ЗамерыТранзитивногоРодителя
child CommonModule ЗамерыТранзитивногоДочернего
copy tests/conformance/measure/1c/transitive-arguments-parent-module.bsl CommonModules/ЗамерыТранзитивногоРодителя/Ext/Module.bsl
copy tests/conformance/measure/1c/transitive-arguments-child-module.bsl CommonModules/ЗамерыТранзитивногоДочернего/Ext/Module.bsl
