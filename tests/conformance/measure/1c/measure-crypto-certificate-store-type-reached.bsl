// Типы хранилищ сертификатов, достигнутые в исходниках УНФ.

Процедура ПроверитьЧлен(Ключ, Значение, Псевдоним)
    Если Значение = Псевдоним Тогда
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "PASS");
    Иначе
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "FAIL");
    КонецЕсли;
КонецПроцедуры

ПроверитьЧлен("ROOT", ТипХранилищаСертификатовКриптографии.КорневыеСертификаты, CryptoCertificateStoreType.RootCertificates);
ПроверитьЧлен("PERSONAL", ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты, CryptoCertificateStoreType.PersonalCertificates);
ПроверитьЧлен("RECIPIENT", ТипХранилищаСертификатовКриптографии.СертификатыПолучателей, CryptoCertificateStoreType.RecipientCertificates);
Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(ТипХранилищаСертификатовКриптографии.КорневыеСертификаты)));
