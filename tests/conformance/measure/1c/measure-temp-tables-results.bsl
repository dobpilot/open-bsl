// PLATFORM-ONLY: форма результата помещения и уничтожения временной таблицы.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "temp-tables-results-3");
МенеджерТаблиц = Новый МенеджерВременныхТаблиц;

ТипПомещения = "ERROR";
СтрокПомещения = "ERROR";
КолонкаПомещения = "ERROR";
ЗначениеПомещения = "ERROR";
Попытка
	ЗапросПомещения = Новый Запрос("ВЫБРАТЬ 1 КАК Значение ПОМЕСТИТЬ ВТ");
	ЗапросПомещения.МенеджерВременныхТаблиц = МенеджерТаблиц;
	РезультатПомещения = ЗапросПомещения.Выполнить();
	ТипПомещения = ТипЗнч(РезультатПомещения);
	Попытка
		ТаблицаПомещения = РезультатПомещения.Выгрузить();
		СтрокПомещения = ТаблицаПомещения.Количество();
		Если СтрокПомещения > 0 Тогда
			КолонкаПомещения = ТаблицаПомещения.Колонки[0].Имя;
			ЗначениеПомещения = ТаблицаПомещения[0][0];
		КонецЕсли;
	Исключение
	КонецПопытки;
Исключение
КонецПопытки;
М("TEMP.RESULT.PUT.TYPE", ТипПомещения);
М("TEMP.RESULT.PUT.ROWS", СтрокПомещения);
М("TEMP.RESULT.PUT.COLUMN", КолонкаПомещения);
М("TEMP.RESULT.PUT.VALUE", ЗначениеПомещения);

ПрочитанноеЗначение = "ERROR";
Попытка
	ЗапросЧтения = Новый Запрос("ВЫБРАТЬ Значение ИЗ ВТ");
	ЗапросЧтения.МенеджерВременныхТаблиц = МенеджерТаблиц;
	РезультатЧтения = ЗапросЧтения.Выполнить();
	ВыборкаЧтения = РезультатЧтения.Выбрать();
	Если ВыборкаЧтения.Следующий() Тогда
		ПрочитанноеЗначение = ВыборкаЧтения.Значение;
	Иначе
		ПрочитанноеЗначение = "EMPTY";
	КонецЕсли;
Исключение
КонецПопытки;
М("TEMP.RESULT.READ.VALUE", ПрочитанноеЗначение);

ТипДобавления = "ERROR";
КоличествоДобавленных = "ERROR";
КоличествоПослеДобавления = "ERROR";
Попытка
	ЗапросДобавления = Новый Запрос("ВЫБРАТЬ 2 КАК Значение ДОБАВИТЬ ВТ");
	ЗапросДобавления.МенеджерВременныхТаблиц = МенеджерТаблиц;
	РезультатДобавления = ЗапросДобавления.Выполнить();
	ТипДобавления = ТипЗнч(РезультатДобавления);
	ТаблицаДобавления = РезультатДобавления.Выгрузить();
	КоличествоДобавленных = ТаблицаДобавления[0][0];
	ЗапросПослеДобавления = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ ВТ");
	ЗапросПослеДобавления.МенеджерВременныхТаблиц = МенеджерТаблиц;
	ВыборкаПослеДобавления = ЗапросПослеДобавления.Выполнить().Выбрать();
	Если ВыборкаПослеДобавления.Следующий() Тогда
		КоличествоПослеДобавления = ВыборкаПослеДобавления.Количество;
	КонецЕсли;
Исключение
КонецПопытки;
М("TEMP.RESULT.APPEND.TYPE", ТипДобавления);
М("TEMP.RESULT.APPEND.COUNT", КоличествоДобавленных);
М("TEMP.RESULT.APPEND.ROWS", КоличествоПослеДобавления);

ТипУдаления = "ERROR";
Попытка
	ЗапросУдаления = Новый Запрос("УНИЧТОЖИТЬ ВТ");
	ЗапросУдаления.МенеджерВременныхТаблиц = МенеджерТаблиц;
	РезультатУдаления = ЗапросУдаления.Выполнить();
	ТипУдаления = ТипЗнч(РезультатУдаления);
Исключение
КонецПопытки;
М("TEMP.RESULT.DROP.TYPE", ТипУдаления);

ИсходноеПослеИзменения = "ERROR";
ПомещенноеПослеИзменения = "ERROR";
ОшибкаСнимка = "";
Попытка
	ИсходнаяТаблица = Новый ТаблицаЗначений;
	ИсходнаяТаблица.Колонки.Добавить("Значение", Новый ОписаниеТипов("Число"));
	ИсходнаяСтрока = ИсходнаяТаблица.Добавить();
	ИсходнаяСтрока.Значение = 1;
	ЗапросСнимка = Новый Запрос("ВЫБРАТЬ Источник.Значение КАК Значение ПОМЕСТИТЬ ВТ2 ИЗ &ИсходнаяТаблица КАК Источник");
	ЗапросСнимка.МенеджерВременныхТаблиц = МенеджерТаблиц;
	ЗапросСнимка.УстановитьПараметр("ИсходнаяТаблица", ИсходнаяТаблица);
	ЗапросСнимка.Выполнить();
	ИсходнаяСтрока.Значение = 2;
	ИсходноеПослеИзменения = ИсходнаяСтрока.Значение;
	ЗапросСнимкаЧтение = Новый Запрос("ВЫБРАТЬ ВТ.Значение КАК Значение ИЗ ВТ2 КАК ВТ");
	ЗапросСнимкаЧтение.МенеджерВременныхТаблиц = МенеджерТаблиц;
	ВыборкаСнимка = ЗапросСнимкаЧтение.Выполнить().Выбрать();
	Если ВыборкаСнимка.Следующий() Тогда
		ПомещенноеПослеИзменения = ВыборкаСнимка.Значение;
	Иначе
		ПомещенноеПослеИзменения = "EMPTY";
	КонецЕсли;
Исключение
	ОшибкаСнимка = ОписаниеОшибки();
КонецПопытки;
М("TEMP.RESULT.SOURCE.AFTER.CHANGE", ИсходноеПослеИзменения);
М("TEMP.RESULT.PLACED.AFTER.CHANGE", ПомещенноеПослеИзменения);
М("TEMP.RESULT.SNAPSHOT.ERROR", ОшибкаСнимка);

ЗначениеБазыПослеИзменения = "ERROR";
ЗначениеВременнойПослеИзменения = "ERROR";
ОшибкаБазы = "";
Попытка
	ЭлементБазы = Справочники.ЗамерВременныхТаблиц.СоздатьЭлемент();
	ЭлементБазы.Наименование = "Before";
	ЭлементБазы.Записать();
	СсылкаБазы = ЭлементБазы.Ссылка;
	ЗапросБазы = Новый Запрос("ВЫБРАТЬ Источник.Наименование КАК Значение ПОМЕСТИТЬ ВТБаза ИЗ Справочник.ЗамерВременныхТаблиц КАК Источник ГДЕ Источник.Ссылка = &Ссылка");
	ЗапросБазы.МенеджерВременныхТаблиц = МенеджерТаблиц;
	ЗапросБазы.УстановитьПараметр("Ссылка", СсылкаБазы);
	ЗапросБазы.Выполнить();
	ЭлементБазы.Наименование = "After";
	ЭлементБазы.Записать();
	ЗапросПрямогоЧтения = Новый Запрос("ВЫБРАТЬ Источник.Наименование КАК Значение ИЗ Справочник.ЗамерВременныхТаблиц КАК Источник ГДЕ Источник.Ссылка = &Ссылка");
	ЗапросПрямогоЧтения.УстановитьПараметр("Ссылка", СсылкаБазы);
	ВыборкаБазы = ЗапросПрямогоЧтения.Выполнить().Выбрать();
	Если ВыборкаБазы.Следующий() Тогда
		ЗначениеБазыПослеИзменения = ВыборкаБазы.Значение;
	КонецЕсли;
	ЗапросЧтенияБазы = Новый Запрос("ВЫБРАТЬ ВТ.Значение КАК Значение ИЗ ВТБаза КАК ВТ");
	ЗапросЧтенияБазы.МенеджерВременныхТаблиц = МенеджерТаблиц;
	ВыборкаВременной = ЗапросЧтенияБазы.Выполнить().Выбрать();
	Если ВыборкаВременной.Следующий() Тогда
		ЗначениеВременнойПослеИзменения = ВыборкаВременной.Значение;
	КонецЕсли;
Исключение
	ОшибкаБазы = ОписаниеОшибки();
КонецПопытки;
М("TEMP.RESULT.DB.SOURCE.AFTER.CHANGE", ЗначениеБазыПослеИзменения);
М("TEMP.RESULT.DB.PLACED.AFTER.CHANGE", ЗначениеВременнойПослеИзменения);
М("TEMP.RESULT.DB.ERROR", ОшибкаБазы);

М("file.end", "temp-tables-results-3");
