// PLATFORM-ONLY: проба требует настоящего менеджера временных таблиц СУБД.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "temp-tables-manager-1");
МенеджерТаблиц = Новый МенеджерВременныхТаблиц;
ЗапросПробы = Новый Запрос("ВЫБРАТЬ 1 КАК Значение");
М("TEMP.TABLES.TYPE", ТипЗнч(МенеджерТаблиц));
М("TEMP.TABLES.QUERY.DEFAULT", ЗапросПробы.МенеджерВременныхТаблиц = Неопределено);
ЗапросПробы.МенеджерВременныхТаблиц = МенеджерТаблиц;
М("TEMP.TABLES.QUERY.ASSIGNED", ЗапросПробы.МенеджерВременныхТаблиц = МенеджерТаблиц);
РезультатВыполнения = "ERROR";
Попытка
	ЗапросПробы.Выполнить();
	РезультатВыполнения = "OK";
Исключение
КонецПопытки;
М("TEMP.TABLES.EXECUTE", РезультатВыполнения);
РезультатЗакрытия = "ERROR";
Попытка
	МенеджерТаблиц.Закрыть();
	РезультатЗакрытия = "OK";
Исключение
КонецПопытки;
М("TEMP.TABLES.CLOSE", РезультатЗакрытия);
РезультатПослеЗакрытия = "OK";
Попытка
	ЗапросПробы.Выполнить();
Исключение
	РезультатПослеЗакрытия = "ERROR";
КонецПопытки;
М("TEMP.TABLES.AFTER.CLOSE", РезультатПослеЗакрытия);
РезультатПовторногоЗакрытия = "ERROR";
Попытка
	МенеджерТаблиц.Закрыть();
	РезультатПовторногоЗакрытия = "OK";
Исключение
КонецПопытки;
М("TEMP.TABLES.CLOSE.TWICE", РезультатПовторногоЗакрытия);
ЗапросПослеЗакрытия = Новый Запрос("ВЫБРАТЬ 1 КАК Значение ПОМЕСТИТЬ ВременнаяТаблица");
РезультатНазначенияПослеЗакрытия = "ERROR";
Попытка
	ЗапросПослеЗакрытия.МенеджерВременныхТаблиц = МенеджерТаблиц;
	РезультатНазначенияПослеЗакрытия = "OK";
Исключение
КонецПопытки;
М("TEMP.TABLES.ASSIGN.AFTER.CLOSE", РезультатНазначенияПослеЗакрытия);
РезультатПомещенияПослеЗакрытия = "OK";
Попытка
	ЗапросПослеЗакрытия.Выполнить();
Исключение
	РезультатПомещенияПослеЗакрытия = "ERROR";
КонецПопытки;
М("TEMP.TABLES.PUT.AFTER.CLOSE", РезультатПомещенияПослеЗакрытия);
М("file.end", "temp-tables-manager-1");
