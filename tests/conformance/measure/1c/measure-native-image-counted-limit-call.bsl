    Для НомерНачальнойПробы = 1 По 0 Цикл
        КоллекцияПробы.Добавить(НомерНачальнойПробы);
        ПрямаяКоллекцияПробы.Добавить(НомерНачальнойПробы);
    КонецЦикла;
    СчетчикПробы = 99;
    СуммаПробы = 10;
