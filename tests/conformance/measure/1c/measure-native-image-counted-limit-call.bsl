Функция ПрямаяПроба(КоллекцияПробы, СчетчикПробы, СуммаПробы)
    СчетчикПробы = 0;
    Для СчетчикПробы = СчетчикПробы По КоллекцияПробы.Количество() - 1 Цикл
        СуммаПробы = СуммаПробы + СчетчикПробы;
        КоллекцияПробы.Добавить(СчетчикПробы);
    КонецЦикла;
    Возврат СуммаПробы;
КонецФункции

