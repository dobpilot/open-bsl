    ПрямойРезультатПробы = ПрямаяПроба(ПрямаяКоллекцияПробы, ПрямойСчетчикПробы, ПрямаяСуммаПробы);
    Сообщить("image.native.counted_limit.0.counter=" + Строка(СчетчикПробы));
    Сообщить("image.native.counted_limit.0.sum=" + Строка(СуммаПробы));
    Сообщить("image.native.counted_limit.0.count=" + Строка(КоллекцияПробы.Количество()));
    СовпалаПроба = РезультатПробы = ПрямойРезультатПробы И СчетчикПробы = ПрямойСчетчикПробы И СуммаПробы = ПрямаяСуммаПробы И КоллекцияПробы.Количество() = ПрямаяКоллекцияПробы.Количество();
