// Типы линий рисунка табличного документа в серверном контексте.

Процедура ПроверитьЧлен(Ключ, Значение, Псевдоним)
    Если Значение = Псевдоним Тогда
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "PASS");
    Иначе
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "FAIL");
    КонецЕсли;
КонецПроцедуры

ПроверитьЧлен("NONE", ТипЛинииРисункаТабличногоДокумента.НетЛинии, SpreadsheetDocumentDrawingLineType.None);
ПроверитьЧлен("SOLID", ТипЛинииРисункаТабличногоДокумента.Сплошная, SpreadsheetDocumentDrawingLineType.Solid);
ПроверитьЧлен("DASHED", ТипЛинииРисункаТабличногоДокумента.Пунктир, SpreadsheetDocumentDrawingLineType.Dashed);
ПроверитьЧлен("DOTTED", ТипЛинииРисункаТабличногоДокумента.Точечная, SpreadsheetDocumentDrawingLineType.Dotted);
ПроверитьЧлен("DASH_DOT", ТипЛинииРисункаТабличногоДокумента.ПунктирТочка, SpreadsheetDocumentDrawingLineType.DashDotted);
ПроверитьЧлен("DASH_DOT_DOT", ТипЛинииРисункаТабличногоДокумента.ПунктирТочкаТочка, SpreadsheetDocumentDrawingLineType.DashDottedDotted);
Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(ТипЛинииРисункаТабличногоДокумента.НетЛинии)));
