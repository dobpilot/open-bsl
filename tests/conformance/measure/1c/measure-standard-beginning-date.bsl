// PLATFORM-ONLY: проба фиксирует достигнутую стандартную дату начала и её перечисление.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "standard-beginning-date-1");
М("SBDV.THIS_DAY", ВариантСтандартнойДатыНачала.НачалоЭтогоДня);
М("SBDV.THIS_WEEK", ВариантСтандартнойДатыНачала.НачалоЭтойНедели);
М("SBDV.THIS_TEN_DAYS", ВариантСтандартнойДатыНачала.НачалоЭтойДекады);
М("SBDV.THIS_MONTH", ВариантСтандартнойДатыНачала.НачалоЭтогоМесяца);
М("SBDV.THIS_QUARTER", ВариантСтандартнойДатыНачала.НачалоЭтогоКвартала);
М("SBDV.THIS_HALF_YEAR", ВариантСтандартнойДатыНачала.НачалоЭтогоПолугодия);
М("SBDV.THIS_YEAR", ВариантСтандартнойДатыНачала.НачалоЭтогоГода);
М("SBDV.LAST_DAY", ВариантСтандартнойДатыНачала.НачалоПрошлогоДня);
М("SBDV.LAST_WEEK", ВариантСтандартнойДатыНачала.НачалоПрошлойНедели);
М("SBDV.LAST_TEN_DAYS", ВариантСтандартнойДатыНачала.НачалоПрошлойДекады);
М("SBDV.LAST_MONTH", ВариантСтандартнойДатыНачала.НачалоПрошлогоМесяца);
М("SBDV.LAST_QUARTER", ВариантСтандартнойДатыНачала.НачалоПрошлогоКвартала);
М("SBDV.LAST_HALF_YEAR", ВариантСтандартнойДатыНачала.НачалоПрошлогоПолугодия);
М("SBDV.LAST_YEAR", ВариантСтандартнойДатыНачала.НачалоПрошлогоГода);
М("SBDV.NEXT_DAY", ВариантСтандартнойДатыНачала.НачалоСледующегоДня);
М("SBDV.NEXT_WEEK", ВариантСтандартнойДатыНачала.НачалоСледующейНедели);
М("SBDV.NEXT_TEN_DAYS", ВариантСтандартнойДатыНачала.НачалоСледующейДекады);
М("SBDV.NEXT_MONTH", ВариантСтандартнойДатыНачала.НачалоСледующегоМесяца);
М("SBDV.NEXT_QUARTER", ВариантСтандартнойДатыНачала.НачалоСледующегоКвартала);
М("SBDV.NEXT_HALF_YEAR", ВариантСтандартнойДатыНачала.НачалоСледующегоПолугодия);
М("SBDV.NEXT_YEAR", ВариантСтандартнойДатыНачала.НачалоСледующегоГода);
М("SBDV.CUSTOM", ВариантСтандартнойДатыНачала.ПроизвольнаяДата);
М("SBDV.TYPE", ТипЗнч(ВариантСтандартнойДатыНачала.ПроизвольнаяДата));
М("SBDV.ENGLISH_ALIAS", StandardBeginningDateVariant.Custom);

ДатаПроверки = Дата(2024, 2, 3, 4, 5, 6);
ПоУмолчанию = Новый СтандартнаяДатаНачала();
М("SBD.DEFAULT.VARIANT", ПоУмолчанию.Вариант);
М("SBD.DEFAULT.DATE", Формат(ПоУмолчанию.Дата, "ДФ=yyyyMMddHHmmss"));
М("SBD.DEFAULT.STRING", Строка(ПоУмолчанию));
М("SBD.DEFAULT.TYPE", ТипЗнч(ПоУмолчанию));

ПоДате = Новый СтандартнаяДатаНачала(ДатаПроверки);
М("SBD.DATE.VARIANT", ПоДате.Вариант);
М("SBD.DATE.VALUE", Формат(ПоДате.Дата, "ДФ=yyyyMMddHHmmss"));

ПоВарианту = Новый СтандартнаяДатаНачала(ВариантСтандартнойДатыНачала.НачалоЭтогоДня);
М("SBD.VARIANT.VALUE", ПоВарианту.Вариант);
М("SBD.VARIANT.DATE", ПоВарианту.Дата = НачалоДня(ТекущаяДата()));

ПоВарианту.Дата = ДатаПроверки;
М("SBD.SET_DATE.VARIANT", ПоВарианту.Вариант);
М("SBD.SET_DATE.VALUE", Формат(ПоВарианту.Дата, "ДФ=yyyyMMddHHmmss"));
ПоВарианту.Вариант = ВариантСтандартнойДатыНачала.НачалоЭтогоМесяца;
М("SBD.SET_VARIANT.VALUE", ПоВарианту.Вариант);
М("SBD.SET_VARIANT.DATE", ПоВарианту.Дата = НачалоМесяца(ТекущаяДата()));
М("file.end", "standard-beginning-date-1");
