Перем ИтогиТелаПробы;

Функция ПрочитатьТело() Экспорт
    Возврат ИтогиТелаПробы;
КонецФункции

Функция ПрочитатьПризнак() Экспорт
    Возврат ПометкаУдаления;
КонецФункции

Функция ПроверитьЗначение(ИмяЗначения, ЗначениеПробы) Экспорт
    ПометкаУдаления = Истина;
    Попытка
        ПометкаУдаления = ЗначениеПробы;
        ИтогПробы = "accepted";
    Исключение
        ИтогПробы = "rejected";
    КонецПопытки;
    Возврат ИмяЗначения + "=" + ИтогПробы + ":value=" + ?(ПометкаУдаления, "YES", "NO");
КонецФункции

ИтогиТелаПробы = Новый Массив;
Попытка
    ИтогиТелаПробы.Добавить("read=" + ?(ПометкаУдаления, "YES", "NO"));
Исключение
    ИтогиТелаПробы.Добавить("read=rejected");
КонецПопытки;
Попытка
    ПометкаУдаления = Истина;
    ИтогиТелаПробы.Добавить("write=accepted");
Исключение
    ИтогиТелаПробы.Добавить("write=rejected");
КонецПопытки;
