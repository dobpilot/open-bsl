// Проверка строкового входа хеширования без изменения исходных баз.
Процедура М(Ид, Значение)
    Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры
М("HASH.STRING.BEGIN", "1");
Попытка
    ХешСтроки = Новый ХешированиеДанных(ХешФункция.SHA512);
    ХешСтроки.Добавить("abc");
    М("HASH.STRING.ASCII", ПолучитьHexСтрокуИзДвоичныхДанных(ХешСтроки.ХешСумма));
    ХешРусский = Новый ХешированиеДанных(ХешФункция.SHA512);
    ХешРусский.Добавить("Привет");
    М("HASH.STRING.CYRILLIC", ПолучитьHexСтрокуИзДвоичныхДанных(ХешРусский.ХешСумма));
    ХешДвоичный = Новый ХешированиеДанных(ХешФункция.SHA512);
    ХешДвоичный.Добавить(ПолучитьДвоичныеДанныеИзСтроки("Привет", КодировкаТекста.UTF8));
    М("HASH.STRING.UTF8", ПолучитьHexСтрокуИзДвоичныхДанных(ХешДвоичный.ХешСумма));
Исключение
    М("HASH.STRING.ERROR", ОписаниеОшибки());
КонецПопытки;
М("HASH.STRING.END", "1");
