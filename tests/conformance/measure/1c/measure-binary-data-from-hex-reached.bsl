// Преобразование Hex-строки в двоичные данные, достигнутое в УНФ.

Сообщить("UPPER" + Символ(9) + ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзHexСтроки("00ABFF")));
Сообщить("LOWER" + Символ(9) + ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзHexСтроки("00abff")));
Сообщить("EMPTY" + Символ(9) + ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзHexСтроки("")));

Попытка
    РезультатПроверки = ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзHexСтроки("F"));
Исключение
    РезультатПроверки = "ERROR";
КонецПопытки;
Сообщить("ODD" + Символ(9) + РезультатПроверки);

Попытка
    РезультатПроверки = ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзHexСтроки("0xFF"));
Исключение
    РезультатПроверки = "ERROR";
КонецПопытки;
Сообщить("PREFIX" + Символ(9) + РезультатПроверки);

Попытка
    РезультатПроверки = ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзHexСтроки("AB CD"));
Исключение
    РезультатПроверки = "ERROR";
КонецПопытки;
Сообщить("SPACE" + Символ(9) + РезультатПроверки);

Попытка
    РезультатПроверки = ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзHexСтроки("GG"));
Исключение
    РезультатПроверки = "ERROR";
КонецПопытки;
Сообщить("BAD" + Символ(9) + РезультатПроверки);

Попытка
    РезультатПроверки = ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзHexСтроки(1));
Исключение
    РезультатПроверки = "ERROR";
КонецПопытки;
Сообщить("TYPE" + Символ(9) + РезультатПроверки);

Сообщить("ALIAS" + Символ(9) + ?(ПолучитьHexСтрокуИзДвоичныхДанных(GetBinaryDataFromHexString("CAFE")) = "CAFE", "PASS", "FAIL"));

Сообщить("GAP" + Символ(9) + ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзHexСтроки("G1G2")));
Сообщить("PUNCT" + Символ(9) + ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзHexСтроки("A!B")));
Сообщить("CYRILLIC" + Символ(9) + ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзHexСтроки("AБB")));
Сообщить("FULLWIDTH" + Символ(9) + ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзHexСтроки("ＡＢ")));
Сообщить("NEWLINE" + Символ(9) + ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзHexСтроки("A" + Символ(10) + "B")));

Попытка
    РезультатПроверки = ПолучитьHexСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзHexСтроки("1GG"));
Исключение
    РезультатПроверки = "ERROR";
КонецПопытки;
Сообщить("ODD_WITH_JUNK" + Символ(9) + РезультатПроверки);

Сообщить("BUFFER_UPPER" + Символ(9) + ПолучитьHexСтрокуИзБуфераДвоичныхДанных(ПолучитьБуферДвоичныхДанныхИзHexСтроки("00ABFF")));
Сообщить("BUFFER_GAP" + Символ(9) + ПолучитьHexСтрокуИзБуфераДвоичныхДанных(ПолучитьБуферДвоичныхДанныхИзHexСтроки("G1G2")));
Сообщить("BUFFER_EMPTY" + Символ(9) + ПолучитьHexСтрокуИзБуфераДвоичныхДанных(ПолучитьБуферДвоичныхДанныхИзHexСтроки("GG")));

Попытка
    РезультатПроверки = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(ПолучитьБуферДвоичныхДанныхИзHexСтроки("0xFF"));
Исключение
    РезультатПроверки = "ERROR";
КонецПопытки;
Сообщить("BUFFER_ODD" + Символ(9) + РезультатПроверки);

Попытка
    РезультатПроверки = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(ПолучитьБуферДвоичныхДанныхИзHexСтроки(1));
Исключение
    РезультатПроверки = "ERROR";
КонецПопытки;
Сообщить("BUFFER_TYPE" + Символ(9) + РезультатПроверки);

Сообщить("BUFFER_ALIAS" + Символ(9) + ?(ПолучитьHexСтрокуИзБуфераДвоичныхДанных(GetBinaryDataBufferFromHexString("CAFE")) = "CAFE", "PASS", "FAIL"));
