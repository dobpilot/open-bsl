// PLATFORM-ONLY: проба фиксирует стандартные специальные хранилища и чтение отсутствующей настройки.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "special-settings-storages-1");
М("SETTINGS.REPORTS.TYPE", ТипЗнч(ХранилищеПользовательскихНастроекОтчетов));
М("SETTINGS.DYNAMIC.TYPE", ТипЗнч(ХранилищеПользовательскихНастроекДинамическихСписков));

АнглийскиеИмена = "ERROR";
Попытка
	Если ReportsUserSettingsStorage = ХранилищеПользовательскихНастроекОтчетов
		И DynamicListsUserSettingsStorage = ХранилищеПользовательскихНастроекДинамическихСписков Тогда
		АнглийскиеИмена = "OK";
	КонецЕсли;
Исключение
КонецПопытки;
М("SETTINGS.SPECIAL.ENGLISH", АнглийскиеИмена);

РезультатСписка = "ERROR";
Попытка
	СписокНастроек = ХранилищеПользовательскихНастроекОтчетов.ПолучитьСписок("open-bsl-нет-такого");
	РезультатСписка = Строка(ТипЗнч(СписокНастроек)) + "|" + Строка(СписокНастроек.Количество());
Исключение
КонецПопытки;
М("SETTINGS.GET_LIST.MISSING", РезультатСписка);

РезультатОписания = "ERROR";
Попытка
	ОписаниеНастройки = ХранилищеПользовательскихНастроекОтчетов.ПолучитьОписание("open-bsl-нет-такого");
	РезультатОписания = Строка(ТипЗнч(ОписаниеНастройки)) + "|"
		+ Строка(ОписаниеНастройки.КлючОбъекта) + "|" + Строка(ОписаниеНастройки.КлючНастроек);
Исключение
КонецПопытки;
М("SETTINGS.GET_DESCRIPTION.MISSING", РезультатОписания);
М("file.end", "special-settings-storages-1");
