// Конструктор фиксированной структуры с ключами и значениями.

Попытка
    ОдноПоле = Новый ФиксированнаяСтруктура("А", 10);
    Сообщить("ONE" + Символ(9) + Строка(ОдноПоле.Количество()) + ":" + Строка(ОдноПоле.А));
Исключение
    Сообщить("ONE" + Символ(9) + "ERROR:" + ОписаниеОшибки());
КонецПопытки;

Попытка
    ДваПоля = Новый ФиксированнаяСтруктура("А,Б", 10, 20);
    Сообщить("TWO" + Символ(9) + Строка(ДваПоля.Количество()) + ":" + Строка(ДваПоля.А) + ":" + Строка(ДваПоля.Б));
Исключение
    Сообщить("TWO" + Символ(9) + "ERROR:" + ОписаниеОшибки());
КонецПопытки;

Попытка
    БезЗначения = Новый ФиксированнаяСтруктура("А");
    Сообщить("OMITTED" + Символ(9) + Строка(БезЗначения.Количество()) + ":" + Строка(ТипЗнч(БезЗначения.А)));
Исключение
    Сообщить("OMITTED" + Символ(9) + "ERROR:" + ОписаниеОшибки());
КонецПопытки;
