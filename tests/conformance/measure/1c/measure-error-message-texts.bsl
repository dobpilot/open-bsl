// PLATFORM-ONLY: проверка формы конструктора и свойств текста сообщения об ошибке.

Попытка
    Объект0 = Вычислить("Новый ТекстыСообщенияОбОшибке()");
    Результат0 = "OK";
Исключение
    Результат0 = "ERROR";
КонецПопытки;
Сообщить("ARITY_0" + Символ(9) + Результат0);

Попытка
    Объект1 = Вычислить("Новый ТекстыСообщенияОбОшибке(""один"")");
    Результат1 = "OK";
Исключение
    Результат1 = "ERROR";
КонецПопытки;
Сообщить("ARITY_1" + Символ(9) + Результат1);

Попытка
    Объект2 = Вычислить("Новый ТекстыСообщенияОбОшибке(""без перезапуска"", ""с перезапуском"")");
    Результат2 = "OK";
Исключение
    Результат2 = "ERROR";
КонецПопытки;
Сообщить("ARITY_2" + Символ(9) + Результат2);

Попытка
    Объект3 = Вычислить("Новый ТекстыСообщенияОбОшибке(""один"", ""два"", ""три"")");
    Результат3 = "OK";
Исключение
    Результат3 = "ERROR";
КонецПопытки;
Сообщить("ARITY_3" + Символ(9) + Результат3);

Если Результат2 = "OK" Тогда
    Попытка
        Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(Объект2)));
        Сообщить("WITHOUT_RESTART" + Символ(9) + Объект2.RestartNotRequiredErrorText);
        Сообщить("WITH_RESTART" + Символ(9) + Объект2.RestartRequiredErrorText);
    Исключение
        Сообщить("PROPERTIES" + Символ(9) + "ERROR");
    КонецПопытки;
КонецЕсли;
