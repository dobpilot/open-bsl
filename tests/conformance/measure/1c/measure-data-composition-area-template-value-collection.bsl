// PLATFORM-ONLY: форма конструктора макета коллекции значений области компоновки данных.

Попытка
    Макет0 = Вычислить("Новый МакетКоллекцииЗначенийОбластиКомпоновкиДанных");
    Результат0 = "OK";
Исключение
    Результат0 = "ERROR";
КонецПопытки;
Сообщить("ARITY_0" + Символ(9) + Результат0);

Попытка
    Макет1 = Вычислить("Новый МакетКоллекцииЗначенийОбластиКомпоновкиДанных(1)");
    Результат1 = "OK";
Исключение
    Результат1 = "ERROR";
КонецПопытки;
Сообщить("ARITY_1" + Символ(9) + Результат1);

Попытка
    МакетАнгл = Вычислить("New DataCompositionAreaTemplateValueCollection");
    РезультатАнгл = "OK";
Исключение
    РезультатАнгл = "ERROR";
КонецПопытки;
Сообщить("EN_ALIAS" + Символ(9) + РезультатАнгл);

Если Результат0 = "OK" Тогда
    Попытка
        Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(Макет0)));
    Исключение
        Сообщить("TYPE" + Символ(9) + "ERROR");
    КонецПопытки;
КонецЕсли;
