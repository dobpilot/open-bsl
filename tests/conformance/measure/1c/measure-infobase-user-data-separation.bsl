// PLATFORM-ONLY: чтение разделения данных пользователя в собственной базе.
Процедура М(Ид, Значение)
    Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "infobase-user-data-separation-1");
Попытка
    ТекущийПользовательПробы = ПользователиИнформационнойБазы.ТекущийПользователь();
    РазделениеПользователяПробы = ТекущийПользовательПробы.РазделениеДанных;
    М("USER_DATA_SEPARATION.CURRENT_TYPE", ТипЗнч(РазделениеПользователяПробы));
    М("USER_DATA_SEPARATION.CURRENT_COUNT", РазделениеПользователяПробы.Количество());
    М("USER_DATA_SEPARATION.ENGLISH_TYPE", ТипЗнч(ТекущийПользовательПробы.DataSeparation));
    М("USER_DATA_SEPARATION.ENGLISH_COUNT", ТекущийПользовательПробы.DataSeparation.Count());
    М("USER_DATA_SEPARATION.ALIASES_EQUAL", ?(РазделениеПользователяПробы = ТекущийПользовательПробы.DataSeparation, "YES", "NO"));
    М("USER_DATA_SEPARATION.CURRENT_INTERNAL", ЗначениеВСтрокуВнутр(РазделениеПользователяПробы));
    НовыйПользовательПробы = ПользователиИнформационнойБазы.СоздатьПользователя();
    РазделениеНовогоПробы = НовыйПользовательПробы.РазделениеДанных;
    М("USER_DATA_SEPARATION.NEW_TYPE", ТипЗнч(РазделениеНовогоПробы));
    М("USER_DATA_SEPARATION.NEW_COUNT", РазделениеНовогоПробы.Количество());
Исключение
    М("USER_DATA_SEPARATION.ERROR", ОписаниеОшибки());
КонецПопытки;
М("file.end", "infobase-user-data-separation-1");
