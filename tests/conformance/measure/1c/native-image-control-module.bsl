// Собственный модуль для сопоставления исходника, образа и исполнения 1С.
Функция Арифметика(Знач Первый, Второй = 3) Экспорт
    Второй = Второй + 1;
    Возврат Первый * 2 + Второй;
КонецФункции

Процедура ИзменитьПараметр(Параметр) Экспорт
    Параметр = Параметр + 7;
КонецПроцедуры

Функция Ветвление(Знач ЧислоПробы) Экспорт
    Если ЧислоПробы < 0 Тогда
        Возврат -ЧислоПробы;
    ИначеЕсли ЧислоПробы = 0 Тогда
        Возврат 100;
    Иначе
        Возврат ЧислоПробы + 10;
    КонецЕсли;
КонецФункции

Функция Циклы() Экспорт
    СуммаПробы = 0;
    Для ИндексПробы = 1 По 3 Цикл
        СуммаПробы = СуммаПробы + ИндексПробы;
    КонецЦикла;
    Пока СуммаПробы < 10 Цикл
        СуммаПробы = СуммаПробы + 1;
    КонецЦикла;
    ЭлементыПробы = Новый Массив;
    ЭлементыПробы.Добавить(2);
    ЭлементыПробы.Добавить(5);
    Для Каждого ЭлементПробы Из ЭлементыПробы Цикл
        СуммаПробы = СуммаПробы + ЭлементПробы;
    КонецЦикла;
    Возврат СуммаПробы;
КонецФункции

Функция КороткоеВычисление() Экспорт
    СчетчикПробы = 0;
    РезультатПробы = Ложь И СчитатьВызов(СчетчикПробы);
    РезультатПробы = Истина Или СчитатьВызов(СчетчикПробы);
    РезультатПробы = Истина И СчитатьВызов(СчетчикПробы);
    Возврат СчетчикПробы;
КонецФункции

Функция СчитатьВызов(СчетчикПробы)
    СчетчикПробы = СчетчикПробы + 1;
    Возврат Истина;
КонецФункции

Функция ИсключениеПробы() Экспорт
    Попытка
        ВызватьИсключение "контрольный отказ";
    Исключение
        Возврат "поймано";
    КонецПопытки;
КонецФункции
