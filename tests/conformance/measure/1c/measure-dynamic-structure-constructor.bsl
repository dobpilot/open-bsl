// PLATFORM-ONLY: проба фиксирует вычисляемый список полей конструктора Структура.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "dynamic-structure-constructor-1");

ИменаПолей = "А, Б";
БезЗначений = Новый Структура(ИменаПолей);
М("STRUCT.DYNAMIC.COUNT", БезЗначений.Количество());
М("STRUCT.DYNAMIC.UNDEFINED", БезЗначений.А = Неопределено И БезЗначений.Б = Неопределено);

СоЗначениями = Новый Структура(ИменаПолей, 1, 2);
М("STRUCT.DYNAMIC.VALUES", СоЗначениями.А = 1 И СоЗначениями.Б = 2);

Исходная = Новый Структура("А,Б", 3, 4);
Копия = Новый Структура(Новый ФиксированнаяСтруктура(Исходная));
М("STRUCT.DYNAMIC.FIXED.COPY", Копия.А = 3 И Копия.Б = 4);

ОшибкаАрности = Ложь;
Попытка
	Неверная = Новый Структура(ИменаПолей, 1);
Исключение
	ОшибкаАрности = Истина;
КонецПопытки;
М("STRUCT.DYNAMIC.ARITY", ОшибкаАрности);
М("STRUCT.DYNAMIC.MISSING.VALUE", Неверная.А = 1 И Неверная.Б = Неопределено);

ОшибкаЛишнего = Ложь;
Попытка
	Лишнее = Новый Структура(ИменаПолей, 1, 2, 3);
Исключение
	ОшибкаЛишнего = Истина;
КонецПопытки;
М("STRUCT.DYNAMIC.EXTRA.ERROR", ОшибкаЛишнего);
М("STRUCT.DYNAMIC.EXTRA.IGNORED", Лишнее.Количество() = 2 И Лишнее.А = 1 И Лишнее.Б = 2);

Английская = New Structure(ИменаПолей, 5, 6);
М("STRUCT.DYNAMIC.ALIAS", Английская.А = 5 И Английская.Б = 6);
М("file.end", "dynamic-structure-constructor-1");
