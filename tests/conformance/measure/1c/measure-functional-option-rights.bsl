// PLATFORM-ONLY: чтение в аутентифицированном сеансе собственной базы.
Процедура М(Ид, Значение)
 Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры
Функция ПробаВыражения(ТекстПробы)
 Попытка
  ЗначениеПробы = Вычислить(ТекстПробы);
  Возврат Строка(ТипЗнч(ЗначениеПробы)) + ":" + Строка(ЗначениеПробы);
 Исключение
  Возврат "ERROR:" + ОписаниеОшибки();
 КонецПопытки;
КонецФункции
М("file.begin", "functional-option-rights-1");
М("FUNCTIONAL_OPTION.RIGHTS_USER", ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
М("FUNCTIONAL_OPTION.RIGHTS_READ", ПравоДоступа("Чтение", Метаданные.Константы.ЗначениеОпцииПробы));
М("FUNCTIONAL_OPTION.RIGHTS_DIRECT", ПробаВыражения("Константы.ЗначениеОпцииПробы.Получить()"));
М("FUNCTIONAL_OPTION.RIGHTS_NORMAL", ПробаВыражения("ПолучитьФункциональнуюОпцию(""ОпцияПробы"")"));
М("FUNCTIONAL_OPTION.RIGHTS_PRIVILEGED", ПробаВыражения("ПолучитьФункциональнуюОпцию(""ОпцияПробыПривилегированная"")"));
М("FUNCTIONAL_OPTION.RIGHTS_NORMAL_AFTER", ПробаВыражения("ПолучитьФункциональнуюОпцию(""ОпцияПробы"")"));
М("FUNCTIONAL_OPTION.RIGHTS_READ_AFTER", ПравоДоступа("Чтение", Метаданные.Константы.ЗначениеОпцииПробы));
М("file.end", "functional-option-rights-1");
