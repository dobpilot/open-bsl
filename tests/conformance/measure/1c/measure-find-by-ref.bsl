// PLATFORM-ONLY: проба фиксирует достигнутую форму поиска по ссылкам.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "find-by-ref-1");
ПустыеСсылки = Новый Массив;
Результат = НайтиПоСсылкам(ПустыеСсылки);
М("FIND.BY.REF.TYPE", ТипЗнч(Результат));
М("FIND.BY.REF.ROWS", Результат.Количество());
М("FIND.BY.REF.COLUMNS", Результат.Колонки.Количество());
ИменаКолонок = "";
Для Каждого Колонка Из Результат.Колонки Цикл
	Если ИменаКолонок <> "" Тогда
		ИменаКолонок = ИменаКолонок + ",";
	КонецЕсли;
	ИменаКолонок = ИменаКолонок + Колонка.Имя;
КонецЦикла;
М("FIND.BY.REF.COLUMN.NAMES", ИменаКолонок);

ЧетыреАргумента = "ERROR";
Попытка
	Результат4 = НайтиПоСсылкам(ПустыеСсылки, Неопределено, Неопределено, Неопределено);
	ЧетыреАргумента = Результат4.Количество();
Исключение
КонецПопытки;
М("FIND.BY.REF.FOUR.ARGS", ЧетыреАргумента);

АнглийскоеИмя = "ERROR";
Попытка
	АнглийскоеИмя = FindByRef(ПустыеСсылки).Количество();
Исключение
КонецПопытки;
М("FIND.BY.REF.ENGLISH", АнглийскоеИмя);

НеверныйТип = "OK";
Попытка
	НайтиПоСсылкам(Неопределено);
Исключение
	НеверныйТип = "ERROR";
КонецПопытки;
М("FIND.BY.REF.WRONG.TYPE", НеверныйТип);
М("file.end", "find-by-ref-1");
