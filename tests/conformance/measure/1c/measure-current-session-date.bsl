// PLATFORM-ONLY: проба сравнивает дату сеанса с локальной и универсальной датой.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "current-session-date-1");
ДатаСеанса = ТекущаяДатаСеанса();
УниверсальнаяДата = ТекущаяУниверсальнаяДата();
ТекущаяДатаКлиента = ТекущаяДата();
М("SESSION.DATE.TYPE", ТипЗнч(ДатаСеанса));
М("SESSION.DATE.VS.UTC", ДатаСеанса - УниверсальнаяДата);
М("SESSION.DATE.VS.CURRENT", ДатаСеанса - ТекущаяДатаКлиента);
М("SESSION.DATE.ENGLISH.TYPE", ТипЗнч(CurrentSessionDate()));
М("file.end", "current-session-date-1");
