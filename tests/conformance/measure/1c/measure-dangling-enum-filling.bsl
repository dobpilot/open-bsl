    ПробаЗначение = Метаданные.Документы.ЗамерДокумента.Реквизиты.СсылкаПробы.ЗначениеЗаполнения;
    Сообщить("dangling.enum.metadata.type=" + ?(ТипЗнч(ПробаЗначение) = Тип("ПеречислениеСсылка.ЗамерПеречисления"), "enum", "other"));
    Сообщить("dangling.enum.metadata.empty=" + ?(ПробаЗначение = Перечисления.ЗамерПеречисления.ПустаяСсылка(), "YES", "NO"));
