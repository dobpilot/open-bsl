// PLATFORM-ONLY: свойства общего реквизита и полный состав собственной конфигурации.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "common-attribute-metadata-properties-auto-1");
РеквизитПробы = Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1;
М("COMMON_ATTRIBUTE_METADATA.FULL_NAME", РеквизитПробы.ПолноеИмя());
М("COMMON_ATTRIBUTE_METADATA.SEPARATION_TYPE", ТипЗнч(РеквизитПробы.РазделениеДанных));
М("COMMON_ATTRIBUTE_METADATA.SEPARATION", РеквизитПробы.РазделениеДанных);
РезультатПробы = "0";
Если РеквизитПробы.РазделениеДанных = Метаданные.СвойстваОбъектов.РазделениеДанныхОбщегоРеквизита.НеИспользовать Тогда
	РезультатПробы = "1";
КонецЕсли;
М("COMMON_ATTRIBUTE_METADATA.SEPARATION_IDENTITY", РезультатПробы);
М("COMMON_ATTRIBUTE_METADATA.AUTO_TYPE", ТипЗнч(РеквизитПробы.АвтоИспользование));
М("COMMON_ATTRIBUTE_METADATA.AUTO", РеквизитПробы.АвтоИспользование);
РезультатПробы = "0";
Если РеквизитПробы.AutoUse = Метаданные.СвойстваОбъектов.АвтоИспользованиеОбщегоРеквизита.Использовать Тогда
	РезультатПробы = "1";
КонецЕсли;
М("COMMON_ATTRIBUTE_METADATA.AUTO_IDENTITY", РезультатПробы);
М("COMMON_ATTRIBUTE_METADATA.CONTENT_TYPE", ТипЗнч(РеквизитПробы.Состав));
М("COMMON_ATTRIBUTE_METADATA.CONTENT_COUNT", РеквизитПробы.Состав.Количество());
СоставПробы = "";
Для Каждого ЭлементПробы Из РеквизитПробы.Состав Цикл
	УсловиеПробы = "defined";
	Если ЭлементПробы.УсловноеРазделение = Неопределено Тогда
		УсловиеПробы = "undefined";
	КонецЕсли;
	СоставПробы = СоставПробы + ЭлементПробы.Метаданные.ПолноеИмя() + ":"
		+ Строка(ЭлементПробы.Использование) + ":" + УсловиеПробы + ";";
КонецЦикла;
М("COMMON_ATTRIBUTE_METADATA.CONTENT", СоставПробы);
М("COMMON_ATTRIBUTE_METADATA.USE_TYPE", ТипЗнч(Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Авто));
М("COMMON_ATTRIBUTE_METADATA.USE_AUTO", Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Авто);
М("COMMON_ATTRIBUTE_METADATA.USE_YES", Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Использовать);
М("COMMON_ATTRIBUTE_METADATA.USE_NO", Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.НеИспользовать);
М("COMMON_ATTRIBUTE_METADATA.SEPARATE", Метаданные.СвойстваОбъектов.РазделениеДанныхОбщегоРеквизита.Разделять);
М("COMMON_ATTRIBUTE_METADATA.AUTO_YES", Метаданные.СвойстваОбъектов.АвтоИспользованиеОбщегоРеквизита.Использовать);
М("file.end", "common-attribute-metadata-properties-auto-1");
