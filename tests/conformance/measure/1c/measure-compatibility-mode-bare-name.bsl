// Проба фиксирует, что тип режима совместимости доступен через метаданные,
// но не объявлен отдельным глобальным именем языка.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "compatibility-mode-bare-name-1");

Попытка
	ПромежуточноеЗначениеИмени = Вычислить("РежимСовместимости");
	РезультатГологоИмени = "AVAILABLE";
Исключение
	РезультатГологоИмени = "UNDEFINED";
КонецПопытки;
М("COMPATIBILITY.BARE_NAME", РезультатГологоИмени);

Попытка
	ПромежуточноеЗначениеЧлена = Вычислить("РежимСовместимости.НеИспользовать");
	РезультатЧлена = "AVAILABLE";
Исключение
	РезультатЧлена = "UNDEFINED";
КонецПопытки;
М("COMPATIBILITY.BARE_MEMBER", РезультатЧлена);

М("file.end", "compatibility-mode-bare-name-1");
