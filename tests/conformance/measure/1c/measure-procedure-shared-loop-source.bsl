Процедура ПрямаяПроба(Знач Остановить, Аргумент)
    Если НЕ Остановить Тогда
        Перейти ~НачалоПробы;
    КонецЕсли;
    Аргумент = 10;
    Возврат;
~ТелоПробы:
    Аргумент = Аргумент + 1;
    Перейти ~УсловиеПробы;
~НачалоПробы:
    Аргумент = 0;
~УсловиеПробы:
    Если Аргумент < 3 Тогда
        Перейти ~ТелоПробы;
    КонецЕсли;
КонецПроцедуры

// Нативная проба досрочного выхода из процедуры и ссылочного результата.
Попытка
    АргументПробы = 5;
    ПрямаяПроба(Истина, АргументПробы);
    Сообщить("image.native.procedure.shared_loop.stop=" + Строка(АргументПробы));
    АргументПробы = 5;
    ПрямаяПроба(Ложь, АргументПробы);
    Сообщить("image.native.procedure.shared_loop.continue=" + Строка(АргументПробы));
Исключение
    Сообщить("image.native.procedure.shared_loop.failure=" + ОписаниеОшибки());
КонецПопытки;
