# Общий реквизит проверяется отдельно от собственных реквизитов справочника.
copy-tree tests/conformance/measure/1c/cfg-src-temp-tables
mkdir CommonAttributes
mkdir Catalogs/ЗамерВременныхТаблиц/Ext
copy tests/conformance/measure/1c/catalog-owner-first.xml Catalogs/ВладелецПробы.xml
copy tests/conformance/measure/1c/common-attribute-runtime.xml CommonAttributes/НаименованиеЯзык1.xml
copy tests/conformance/measure/1c/common-attribute-metadata-separate.xml CommonAttributes/НаименованиеЯзык1.xml
mkdir SessionParameters
copy tests/conformance/measure/1c/common-attribute-metadata-ЗначениеРазделителяПробы.xml SessionParameters/ЗначениеРазделителяПробы.xml
copy tests/conformance/measure/1c/common-attribute-metadata-ИспользованиеРазделителяПробы.xml SessionParameters/ИспользованиеРазделителяПробы.xml
child SessionParameter ИспользованиеРазделителяПробы
child SessionParameter ЗначениеРазделителяПробы
mkdir Ext
copy tests/conformance/measure/1c/separator-use-session-module.bsl Ext/SessionModule.bsl
copy tests/conformance/measure/1c/separator-use-ordinary-parameter.xml SessionParameters/ОбычныйПараметрПробы.xml
child SessionParameter ОбычныйПараметрПробы
copy tests/conformance/measure/1c/common-attribute-runtime-module.bsl Catalogs/ЗамерВременныхТаблиц/Ext/ObjectModule.bsl
child CommonAttribute НаименованиеЯзык1
child Catalog ВладелецПробы
child Catalog ЗамерВременныхТаблиц
