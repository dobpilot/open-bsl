Процедура М(Ид, Значение)
    Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "account-type-1");
Попытка
    АктивныйПробы = Вычислить("ВидСчета.Активный");
    ПассивныйПробы = Вычислить("ВидСчета.Пассивный");
    СмешанныйПробы = Вычислить("ВидСчета.АктивноПассивный");
    ТекстТипаПробы = Строка(ТипЗнч(АктивныйПробы));
    АнглийскиеИменаПробы = "ERROR";
    Если Вычислить("AccountType.Active") = АктивныйПробы
        И Вычислить("accounttype.passive") = ПассивныйПробы
        И Вычислить("AccountType.ActivePassive") = СмешанныйПробы Тогда
        АнглийскиеИменаПробы = "OK";
    КонецЕсли;
Исключение
    АктивныйПробы = "ERROR";
    ПассивныйПробы = "ERROR";
    СмешанныйПробы = "ERROR";
    ТекстТипаПробы = "ERROR";
    АнглийскиеИменаПробы = "ERROR";
КонецПопытки;
М("ACCOUNT.TYPE.ACTIVE", АктивныйПробы);
М("ACCOUNT.TYPE.PASSIVE", ПассивныйПробы);
М("ACCOUNT.TYPE.ACTIVE_PASSIVE", СмешанныйПробы);
М("ACCOUNT.TYPE.TYPE", ТекстТипаПробы);
М("ACCOUNT.TYPE.ENGLISH", АнглийскиеИменаПробы);
М("file.end", "account-type-1");
