// Форма результата для сеанса, связанного с клиентом.

Экраны = ПолучитьИнформациюЭкрановКлиента();
Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(Экраны)));
Сообщить("COUNT" + Символ(9) + Строка(Экраны.Количество()));
Если Экраны.Количество() > 0 Тогда
	ЭкранПервый = Экраны[0];
	Сообщить("ITEM_TYPE" + Символ(9) + Строка(ТипЗнч(ЭкранПервый)));
	Сообщить("WIDTH_TYPE" + Символ(9) + Строка(ТипЗнч(ЭкранПервый.Ширина)));
	Сообщить("HEIGHT_TYPE" + Символ(9) + Строка(ТипЗнч(ЭкранПервый.Высота)));
	Сообщить("DPI_TYPE" + Символ(9) + Строка(ТипЗнч(ЭкранПервый.DPI)));
КонецЕсли;
