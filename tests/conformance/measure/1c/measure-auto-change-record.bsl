// PLATFORM-ONLY: проба фиксирует полное перечисление авторегистрации изменений.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "auto-change-record-1");
М("AUTO.CHANGE.RECORD.DENY", АвтоРегистрацияИзменений.Запретить);
М("AUTO.CHANGE.RECORD.ALLOW", АвтоРегистрацияИзменений.Разрешить);
М("AUTO.CHANGE.RECORD.TYPE", ТипЗнч(АвтоРегистрацияИзменений.Запретить));

АнглийскиеИмена = "ERROR";
Попытка
	Если AutoChangeRecord.Deny = АвтоРегистрацияИзменений.Запретить
		И AutoChangeRecord.Allow = АвтоРегистрацияИзменений.Разрешить Тогда
		АнглийскиеИмена = "OK";
	КонецЕсли;
Исключение
КонецПопытки;
М("AUTO.CHANGE.RECORD.ENGLISH", АнглийскиеИмена);
М("file.end", "auto-change-record-1");
