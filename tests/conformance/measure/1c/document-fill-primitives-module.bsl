Перем ИтогиТелаПробы;
Функция ПрочитатьРезультатыТела() Экспорт
    Возврат ИтогиТелаПробы;
КонецФункции
Функция Описать() Экспорт
    ТекстДатыПробы = "";
    Если ДатаПробы <> Дата(1, 1, 1) Тогда
        ТекстДатыПробы = Формат(ДатаПробы, "ДФ=yyyyMMddHHmmss");
    КонецЕсли;
    Возврат "[" + Строка(ФлагПробы) + "]:[" + ТекстДатыПробы + "]";
КонецФункции
ИтогиТелаПробы = Новый Массив;
Попытка
    ТекстДатыПробы = "";
    Если ДатаПробы <> Дата(1, 1, 1) Тогда
        ТекстДатыПробы = Формат(ДатаПробы, "ДФ=yyyyMMddHHmmss");
    КонецЕсли;
    РезультатТелаПробы = "[" + Строка(ФлагПробы) + "]:[" + ТекстДатыПробы + "]";
Исключение
    РезультатТелаПробы = "rejected";
КонецПопытки;
ИтогиТелаПробы.Добавить("initial=" + РезультатТелаПробы);
Попытка
    ФлагПробы = Истина;
    РезультатТелаПробы = "accepted";
Исключение
    РезультатТелаПробы = "rejected";
КонецПопытки;
ИтогиТелаПробы.Добавить("boolean.write=" + РезультатТелаПробы);
Попытка
    ДатаПробы = Дата(2026, 1, 2);
    РезультатТелаПробы = "accepted";
Исключение
