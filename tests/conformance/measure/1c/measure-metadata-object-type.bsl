// PLATFORM-ONLY: имена типов корня конфигурации и вложенных метаданных.
Процедура М(Ид, Значение)
    Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "metadata-object-type-1");
М("METADATA_OBJECT_TYPE.ROOT", ТипЗнч(Метаданные));
М("METADATA_OBJECT_TYPE.PROCESSOR", ТипЗнч(Метаданные.Обработки.Замеры));
Попытка
    РезультатПробы = ТипЗнч(Метаданные.Обработки.Замеры) = Тип("ОбъектМетаданных");
Исключение
    РезультатПробы = "ERROR:" + ОписаниеОшибки();
КонецПопытки;
М("METADATA_OBJECT_TYPE.RUSSIAN", РезультатПробы);
Попытка
    РезультатПробы = ТипЗнч(Метаданные.Обработки.Замеры) = Тип("MetadataObject");
Исключение
    РезультатПробы = "ERROR:" + ОписаниеОшибки();
КонецПопытки;
М("METADATA_OBJECT_TYPE.ENGLISH", РезультатПробы);
М("file.end", "metadata-object-type-1");
