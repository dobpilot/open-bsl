// Глобальная XMLЗначение: примитивы, пустая форма и ошибочный ввод.

Функция ТипПроверен(Проверяемое, ИмяТипа)
    Если ТипЗнч(Проверяемое) = Тип(ИмяТипа) Тогда
        Возврат "PASS";
    КонецЕсли;
    Возврат "FAIL";
КонецФункции

Попытка
    РезультатXML = XMLЗначение(Тип("Число"), "1.5");
    Сообщить("NUMBER" + Символ(9) + ТипПроверен(РезультатXML, "Число") + "|" + XMLСтрока(РезультатXML));
Исключение
    Сообщить("NUMBER" + Символ(9) + "<ошибка>");
КонецПопытки;

Попытка
    РезультатXML = XMLЗначение(Тип("Число"), "");
    Сообщить("EMPTY_NUMBER" + Символ(9) + ТипПроверен(РезультатXML, "Число") + "|" + XMLСтрока(РезультатXML));
Исключение
