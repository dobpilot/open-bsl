// Соединение буферов, разделитель, порядок байтов и ошибки аргументов.

Части = Новый Массив;
Части.Добавить(ПолучитьБуферДвоичныхДанныхИзHexСтроки("A1"));
Части.Добавить(ПолучитьБуферДвоичныхДанныхИзHexСтроки("B2"));
Разделитель = ПолучитьБуферДвоичныхДанныхИзHexСтроки("FF");

Сообщить("PLAIN" + Символ(9) + ПолучитьHexСтрокуИзБуфераДвоичныхДанных(СоединитьБуферыДвоичныхДанных(Части)));
Сообщить("SEPARATOR" + Символ(9) + ПолучитьHexСтрокуИзБуфераДвоичныхДанных(СоединитьБуферыДвоичныхДанных(Части, Разделитель)));
Сообщить("ORDER" + Символ(9) + Строка(СоединитьБуферыДвоичныхДанных(Части, Разделитель, ПорядокБайтов.BigEndian).ПорядокБайтов));
Сообщить("ORDER_DEFAULT" + Символ(9) + Строка(СоединитьБуферыДвоичныхДанных(Части).ПорядокБайтов));

Пустые = Новый Массив;
Сообщить("EMPTY" + Символ(9) + ПолучитьHexСтрокуИзБуфераДвоичныхДанных(СоединитьБуферыДвоичныхДанных(Пустые)));
Сообщить("EMPTY_ORDER" + Символ(9) + Строка(СоединитьБуферыДвоичныхДанных(Пустые).ПорядокБайтов));
Сообщить("ALIAS" + Символ(9) + ПолучитьHexСтрокуИзБуфераДвоичныхДанных(ConcatBinaryDataBuffers(Части)));

Попытка
    РезультатПроверки = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(СоединитьБуферыДвоичныхДанных(Части, Неопределено));
Исключение
    РезультатПроверки = "ERR";
КонецПопытки;
Сообщить("UNDEFINED_SEPARATOR" + Символ(9) + РезультатПроверки);

Попытка
    РезультатПроверки = Строка(СоединитьБуферыДвоичныхДанных(Части, Разделитель, Неопределено).ПорядокБайтов);
Исключение
    РезультатПроверки = "ERR";
КонецПопытки;
Сообщить("UNDEFINED_ORDER" + Символ(9) + РезультатПроверки);

ПервыйСДругимПорядком = ПолучитьБуферДвоичныхДанныхИзHexСтроки("A1");
ПервыйСДругимПорядком.ПорядокБайтов = ПорядокБайтов.BigEndian;
ЧастиСДругимПорядком = Новый Массив;
ЧастиСДругимПорядком.Добавить(ПервыйСДругимПорядком);
ЧастиСДругимПорядком.Добавить(ПолучитьБуферДвоичныхДанныхИзHexСтроки("B2"));
Сообщить("FIRST_ORDER" + Символ(9) + Строка(СоединитьБуферыДвоичныхДанных(ЧастиСДругимПорядком).ПорядокБайтов));

Попытка
    СоединитьБуферыДвоичныхДанных(Части, 1);
    РезультатПроверки = "OK";
Исключение
    РезультатПроверки = "ERR";
КонецПопытки;
Сообщить("BAD_SEPARATOR" + Символ(9) + РезультатПроверки);

ЧастиСПлохим = Новый Массив;
ЧастиСПлохим.Добавить(1);
Попытка
    СоединитьБуферыДвоичныхДанных(ЧастиСПлохим);
    РезультатПроверки = "OK";
Исключение
    РезультатПроверки = "ERR";
КонецПопытки;
Сообщить("BAD_PART" + Символ(9) + РезультатПроверки);

Попытка
    СоединитьБуферыДвоичныхДанных(Части, Разделитель, 1);
    РезультатПроверки = "OK";
Исключение
    РезультатПроверки = "ERR";
КонецПопытки;
Сообщить("BAD_ORDER" + Символ(9) + РезультатПроверки);
