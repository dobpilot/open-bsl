// PLATFORM-ONLY: проба фиксирует режим обновления предопределённых данных.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "infobase-predefined-data-update-1");
М("PREDEFINED.UPDATE.AUTO", ОбновлениеПредопределенныхДанных.Авто);
М("PREDEFINED.UPDATE.AUTO.UPDATE", ОбновлениеПредопределенныхДанных.ОбновлятьАвтоматически);
М("PREDEFINED.UPDATE.DONT.AUTO.UPDATE", ОбновлениеПредопределенныхДанных.НеОбновлятьАвтоматически);
М("PREDEFINED.UPDATE.TYPE", ТипЗнч(ОбновлениеПредопределенныхДанных.Авто));
М("PREDEFINED.UPDATE.ALIAS", ОбновлениеПредопределенныхДанных.Авто = PredefinedDataUpdate.Auto);

РезультатПоУмолчанию = "ERROR";
РезультатАвтоОбновления = "ERROR";
РезультатБезАвтоОбновления = "ERROR";
РезультатБезАргумента = "ERROR";
РезультатАнглийскогоИмени = "ERROR";
Попытка
	РезультатПоУмолчанию = ПолучитьОбновлениеПредопределенныхДанныхИнформационнойБазы();
Исключение
КонецПопытки;
Попытка
	УстановитьОбновлениеПредопределенныхДанныхИнформационнойБазы(
		ОбновлениеПредопределенныхДанных.ОбновлятьАвтоматически);
	РезультатАвтоОбновления = ПолучитьОбновлениеПредопределенныхДанныхИнформационнойБазы();
Исключение
КонецПопытки;
Попытка
	УстановитьОбновлениеПредопределенныхДанныхИнформационнойБазы(
		ОбновлениеПредопределенныхДанных.НеОбновлятьАвтоматически);
	РезультатБезАвтоОбновления = ПолучитьОбновлениеПредопределенныхДанныхИнформационнойБазы();
Исключение
КонецПопытки;
Попытка
	УстановитьОбновлениеПредопределенныхДанныхИнформационнойБазы();
	РезультатБезАргумента = ПолучитьОбновлениеПредопределенныхДанныхИнформационнойБазы();
Исключение
КонецПопытки;
Попытка
	SetInfoBasePredefinedDataUpdate(PredefinedDataUpdate.Auto);
	РезультатАнглийскогоИмени = GetInfoBasePredefinedData();
Исключение
КонецПопытки;
Попытка
	УстановитьОбновлениеПредопределенныхДанныхИнформационнойБазы(
		ОбновлениеПредопределенныхДанных.Авто);
Исключение
КонецПопытки;
М("PREDEFINED.UPDATE.DEFAULT", РезультатПоУмолчанию);
М("PREDEFINED.UPDATE.SET.AUTO.UPDATE", РезультатАвтоОбновления);
М("PREDEFINED.UPDATE.SET.DONT.AUTO.UPDATE", РезультатБезАвтоОбновления);
М("PREDEFINED.UPDATE.SET.OMITTED", РезультатБезАргумента);
М("PREDEFINED.UPDATE.SET.ENGLISH", РезультатАнглийскогоИмени);
М("file.end", "infobase-predefined-data-update-1");
