// PLATFORM-ONLY: привязки нового несохранённого пользователя к собственному разделителю.
Процедура М(Ид, Значение)
    Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "infobase-user-data-separation-values-1");
Попытка
    ПользовательРазделенияПробы = ПользователиИнформационнойБазы.СоздатьПользователя();
    СтруктураРазделенияПробы = Новый Структура("НаименованиеЯзык1", "own-separator-value");
    ПользовательРазделенияПробы.РазделениеДанных = СтруктураРазделенияПробы;
    НазначениеРазделенияПробы = "ACCEPTED";
Исключение
    НазначениеРазделенияПробы = "ERROR:" + ОписаниеОшибки();
КонецПопытки;
М("USER_DATA_SEPARATION_VALUES.ASSIGN", НазначениеРазделенияПробы);
Попытка
    ПолученноеРазделениеПробы = ПользовательРазделенияПробы.РазделениеДанных;
    М("USER_DATA_SEPARATION_VALUES.COUNT", ПолученноеРазделениеПробы.Количество());
    ЗначениеРазделенияПробы = Неопределено;
    М("USER_DATA_SEPARATION_VALUES.HAS_KEY", ?(ПолученноеРазделениеПробы.Свойство("НаименованиеЯзык1", ЗначениеРазделенияПробы), "YES", "NO"));
    М("USER_DATA_SEPARATION_VALUES.VALUE", ЗначениеРазделенияПробы);
    СтруктураРазделенияПробы.НаименованиеЯзык1 = "changed-source";
    ПолученноеПовторноПробы = ПользовательРазделенияПробы.РазделениеДанных;
    ЗначениеПовторноПробы = Неопределено;
    ПолученноеПовторноПробы.Свойство("НаименованиеЯзык1", ЗначениеПовторноПробы);
    М("USER_DATA_SEPARATION_VALUES.SOURCE_CHANGE", ЗначениеПовторноПробы);
Исключение
    М("USER_DATA_SEPARATION_VALUES.ERROR", ОписаниеОшибки());
КонецПопытки;
М("file.end", "infobase-user-data-separation-values-1");
