// Значение двусторонней печати, достигнутое в исходниках УНФ.

Если ТипДвустороннейПечати.Нет = DuplexPrintingType.None Тогда
    Сообщить("NONE" + Символ(9) + Строка(ТипДвустороннейПечати.Нет) + Символ(9) + "PASS");
Иначе
    Сообщить("NONE" + Символ(9) + Строка(ТипДвустороннейПечати.Нет) + Символ(9) + "FAIL");
КонецЕсли;
Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(ТипДвустороннейПечати.Нет)));
