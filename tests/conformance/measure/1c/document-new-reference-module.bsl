Перем ИтогиТелаПробы;

Функция ПрочитатьТело() Экспорт
    Возврат ИтогиТелаПробы;
КонецФункции

Функция ПроверитьЗначение(ИмяЗначения, ЗначениеПробы) Экспорт
    ЭталонПробы = Документы.ЗамерДокумента.ПолучитьСсылку(Новый УникальныйИдентификатор("11111111-1111-4111-8111-111111111111"));
    УстановитьСсылкуНового(ЭталонПробы);
    Попытка
        УстановитьСсылкуНового(ЗначениеПробы);
        ИтогПробы = "accepted";
    Исключение
        ИтогПробы = "rejected";
    КонецПопытки;
    ИтогСсылки = ПолучитьСсылкуНового();
    Возврат ИмяЗначения + "=" + ИтогПробы + ":empty=" + ?(ИтогСсылки.Пустая(), "YES", "NO") + ":retained=" + ?(ИтогСсылки = ЭталонПробы, "YES", "NO");
КонецФункции

ИтогиТелаПробы = Новый Массив;
Попытка
    ЗначениеТелаПробы = ПолучитьСсылкуНового();
    ИтогиТелаПробы.Добавить("get=accepted:empty=" + ?(ЗначениеТелаПробы.Пустая(), "YES", "NO"));
Исключение
    ИтогиТелаПробы.Добавить("get=rejected");
КонецПопытки;
Попытка
    УстановитьСсылкуНового(Документы.ЗамерДокумента.ПустаяСсылка());
    ИтогиТелаПробы.Добавить("set=accepted");
Исключение
    ИтогиТелаПробы.Добавить("set=rejected");
КонецПопытки;
