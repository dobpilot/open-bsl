// Виды цвета, достигнутые в исходниках УНФ и сверяемые с платформой.

Процедура ПроверитьЧлен(Ключ, Значение, Псевдоним)
    Если Значение = Псевдоним Тогда
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "PASS");
    Иначе
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "FAIL");
    КонецЕсли;
КонецПроцедуры

ПроверитьЧлен("ABSOLUTE", ВидЦвета.Абсолютный, ColorType.Absolute);
ПроверитьЧлен("STYLE", ВидЦвета.ЭлементСтиля, ColorType.StyleItem);
ПроверитьЧлен("WEB", ВидЦвета.WebЦвет, ColorType.WebColor);
ПроверитьЧлен("WINDOWS", ВидЦвета.WindowsЦвет, ColorType.WindowsColor);
ПроверитьЧлен("AUTO", ВидЦвета.АвтоЦвет, ColorType.AutoColor);
Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(ВидЦвета.Абсолютный)));
