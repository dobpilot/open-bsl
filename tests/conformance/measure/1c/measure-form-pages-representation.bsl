// Все члены и написания отображения страниц формы в серверном контексте.

Процедура ПроверитьЧлен(Ключ, Значение, Псевдоним)
    Если Значение = Псевдоним Тогда
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "PASS");
    Иначе
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "FAIL");
    КонецЕсли;
КонецПроцедуры

ПроверитьЧлен("AUTO", ОтображениеСтраницФормы.Авто, FormPagesRepresentation.Auto);
ПроверитьЧлен("NONE", ОтображениеСтраницФормы.Нет, FormPagesRepresentation.None);
ПроверитьЧлен("SWIPE", ОтображениеСтраницФормы.Пролистывание, FormPagesRepresentation.Swipe);
ПроверитьЧлен("TOP", ОтображениеСтраницФормы.ЗакладкиСверху, FormPagesRepresentation.TabsOnTop);
ПроверитьЧлен("BOTTOM", ОтображениеСтраницФормы.ЗакладкиСнизу, FormPagesRepresentation.TabsOnBottom);
ПроверитьЧлен("LEFT", ОтображениеСтраницФормы.ЗакладкиСлеваГоризонтально, FormPagesRepresentation.TabsOnLeftHorizontal);
ПроверитьЧлен("RIGHT", ОтображениеСтраницФормы.ЗакладкиСправаГоризонтально, FormPagesRepresentation.TabsOnRightHorizontal);
Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(ОтображениеСтраницФормы.Авто)));
