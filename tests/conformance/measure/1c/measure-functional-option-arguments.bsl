// PLATFORM-ONLY: чтение метаданных и константы отдельной базы замера.
Процедура Проверить(Ид, Выражение)
 Попытка
  ЗначениеПробы = Вычислить(Выражение);
  ОтветПробы = Строка(ТипЗнч(ЗначениеПробы)) + ":" + Строка(ЗначениеПробы);
 Исключение
  ОтветПробы = "ERROR";
 КонецПопытки;
 Сообщить(Ид + Символ(9) + ОтветПробы);
КонецПроцедуры
Сообщить("file.begin" + Символ(9) + "functional-option-arguments-1");
Проверить("FUNCTIONAL_OPTION.ARGUMENT_OMITTED", "ПолучитьФункциональнуюОпцию(""ОпцияПробы"")");
Проверить("FUNCTIONAL_OPTION.ARGUMENT_UNDEFINED", "ПолучитьФункциональнуюОпцию(""ОпцияПробы"", Неопределено)");
Проверить("FUNCTIONAL_OPTION.ARGUMENT_NUMBER", "ПолучитьФункциональнуюОпцию(""ОпцияПробы"", 1)");
Проверить("FUNCTIONAL_OPTION.ARGUMENT_STRING", "ПолучитьФункциональнуюОпцию(""ОпцияПробы"", ""строка"")");
Проверить("FUNCTIONAL_OPTION.ARGUMENT_ARRAY", "ПолучитьФункциональнуюОпцию(""ОпцияПробы"", Новый Массив)");
Проверить("FUNCTIONAL_OPTION.ARGUMENT_STRUCTURE", "ПолучитьФункциональнуюОпцию(""ОпцияПробы"", Новый Структура)");
Проверить("FUNCTIONAL_OPTION.ARGUMENT_FIXED_STRUCTURE", "ПолучитьФункциональнуюОпцию(""ОпцияПробы"", Новый ФиксированнаяСтруктура(Новый Структура))");
Проверить("FUNCTIONAL_OPTION.ARGUMENT_NAME_NUMBER", "ПолучитьФункциональнуюОпцию(1)");
Проверить("FUNCTIONAL_OPTION.ARGUMENT_NAME_UNDEFINED", "ПолучитьФункциональнуюОпцию(Неопределено)");
Сообщить("file.end" + Символ(9) + "functional-option-arguments-1");
