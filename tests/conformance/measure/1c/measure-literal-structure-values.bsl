// PLATFORM-ONLY: проба фиксирует неполный и избыточный список значений
// при литеральном списке полей конструктора Структура.

Перем Счетчик;

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция УвеличитьСчетчик()
	Счетчик = Счетчик + 1;
	Возврат 3;
КонецФункции

М("file.begin", "literal-structure-values-1");

Неполная = Новый Структура("А,Б,В,Г", 1);
М("STRUCT.LITERAL.MISSING", Неполная.А = 1
	И Неполная.Б = Неопределено
	И Неполная.В = Неопределено
	И Неполная.Г = Неопределено);

Счетчик = 0;
Лишняя = Новый Структура("А,Б", 1, 2, УвеличитьСчетчик());
М("STRUCT.LITERAL.EXTRA.COUNT", Лишняя.Количество());
М("STRUCT.LITERAL.EXTRA.VALUES", Лишняя.А = 1 И Лишняя.Б = 2);
М("STRUCT.LITERAL.EXTRA.EVALUATED", Счетчик);

М("file.end", "literal-structure-values-1");
