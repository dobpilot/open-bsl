// Подготовка записей только в отдельной базе нативного замера.
Попытка
    ГруппаПробы = Справочники.ЗамерВременныхТаблиц.СоздатьГруппу();
    ГруппаПробы.Код = "010";
    ГруппаПробы.Наименование = "Group";
    ГруппаПробы.УстановитьСсылкуНового(Справочники.ЗамерВременныхТаблиц.ПолучитьСсылку(Новый УникальныйИдентификатор("12345678-1234-4321-abcd-0123456789ab")));
    ГруппаПробы.Записать();
    ЭлементПробы = Справочники.ЗамерВременныхТаблиц.СоздатьЭлемент();
    ЭлементПробы.Код = "001";
    ЭлементПробы.Наименование = "Root";
    ЭлементПробы.Записать();
    ЭлементПробы = Справочники.ЗамерВременныхТаблиц.СоздатьЭлемент();
    ЭлементПробы.Код = "002";
    ЭлементПробы.Наименование = "Child";
    ЭлементПробы.Родитель = ГруппаПробы.Ссылка;
    ЭлементПробы.Записать();
Исключение
    Сообщить("selection.parent.setup.error=" + ОписаниеОшибки());
КонецПопытки;

// Начало проверяемого контракта выборки.
Попытка
    ВыборкаПробы = Вычислить("Справочники.ЗамерВременныхТаблиц.Выбрать()");
    ИтогПробы = "accepted";
    Пока ВыборкаПробы.Следующий() Цикл
        ИтогПробы = ИтогПробы + ":" + ВыборкаПробы.Наименование;
    КонецЦикла;
Исключение
    ИтогПробы = "rejected";
КонецПопытки;
Сообщить("selection.parent.all=" + ИтогПробы);

