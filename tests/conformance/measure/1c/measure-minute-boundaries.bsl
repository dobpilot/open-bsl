// Границы минуты на обычной и пустой дате.

ДатаПроверки = Дата(2024, 2, 17, 13, 24, 35);
Сообщить("BEGIN" + Символ(9) + Формат(НачалоМинуты(ДатаПроверки), "ДФ=yyyyMMddHHmmss"));
Сообщить("END" + Символ(9) + Формат(КонецМинуты(ДатаПроверки), "ДФ=yyyyMMddHHmmss"));
Сообщить("BEGIN_ALIAS" + Символ(9) + Формат(BegOfMinute(ДатаПроверки), "ДФ=yyyyMMddHHmmss"));
Сообщить("END_ALIAS" + Символ(9) + Формат(EndOfMinute(ДатаПроверки), "ДФ=yyyyMMddHHmmss"));
Сообщить("EMPTY_BEGIN" + Символ(9) + ?(НачалоМинуты(Дата(1, 1, 1)) = Дата(1, 1, 1), "EMPTY", "OTHER"));
Сообщить("EMPTY_END" + Символ(9) + Формат(КонецМинуты(Дата(1, 1, 1)), "ДФ=yyyyMMddHHmmss"));
