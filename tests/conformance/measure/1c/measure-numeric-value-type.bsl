// Полный состав и представления системного перечисления.

Для Каждого Вид Из ВидЧисловогоЗначения Цикл
	Сообщить("VALUE" + Символ(9) + Строка(Вид) + Символ(9) + Строка(ТипЗнч(Вид)));
КонецЦикла;
Сообщить("CARDINAL_ALIAS" + Символ(9) + Строка(NumericValueType.Cardinal = ВидЧисловогоЗначения.Количественное));
Сообщить("ORDINAL_ALIAS" + Символ(9) + Строка(NumericValueType.Ordinal = ВидЧисловогоЗначения.Порядковое));
