// PLATFORM-ONLY: недопустимый путь позволяет проверить арность без записи файла.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция Проба(Команда)
	Попытка
		Выполнить(Команда);
		Возврат "OK";
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
КонецФункции

М("file.begin", "text-writer-arity-1");
М("TEXT.WRITER.ZERO", Проба("Писатель = Новый ЗаписьТекста()"));
М("TEXT.WRITER.ONE", Проба("Писатель = Новый ЗаписьТекста(Неопределено)"));
М("TEXT.WRITER.TWO", Проба("Писатель = Новый ЗаписьТекста(Неопределено, Неопределено)"));
М("TEXT.WRITER.THREE", Проба("Писатель = Новый ЗаписьТекста(Неопределено, Неопределено, Неопределено)"));
М("TEXT.WRITER.FOUR", Проба("Писатель = Новый ЗаписьТекста(Неопределено, Неопределено, Неопределено, Неопределено)"));
М("TEXT.WRITER.FIVE", Проба("Писатель = Новый ЗаписьТекста(Неопределено, Неопределено, Неопределено, Неопределено, Неопределено)"));
М("TEXT.WRITER.SIX", Проба("Писатель = Новый ЗаписьТекста(Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Неопределено)"));
М("TEXT.WRITER.ENGLISH", Проба("Writer = New TextWriter(Undefined, Undefined)"));
М("file.end", "text-writer-arity-1");
