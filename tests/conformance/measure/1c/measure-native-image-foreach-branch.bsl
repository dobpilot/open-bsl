// Нативная проба ветвления внутри обхода массива.
Попытка
    МассивПробы = Новый Массив;
    МассивПробы.Добавить(1);
    МассивПробы.Добавить(2);
    МассивПробы.Добавить(3);
    СуммаПробы = 0;
    ЗамерыТранзитивногоРодителя.Проба(МассивПробы, СуммаПробы);
    Сообщить("image.native.foreach_branch.sum=" + Строка(СуммаПробы));
    Сообщить("image.native.foreach_branch.count=" + Строка(МассивПробы.Количество()));
    МассивПробы.Очистить();
    СуммаПробы = 10;
    ЗамерыТранзитивногоРодителя.Проба(МассивПробы, СуммаПробы);
    Сообщить("image.native.foreach_branch.empty=" + Строка(СуммаПробы));
Исключение
    Сообщить("image.native.foreach_branch.failure=" + ОписаниеОшибки());
КонецПопытки;
