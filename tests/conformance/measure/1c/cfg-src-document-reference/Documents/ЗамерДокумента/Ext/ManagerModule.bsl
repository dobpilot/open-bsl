Функция БулевоПробы(ЗначениеПробы)
    Если ЗначениеПробы Тогда Возврат "YES"; КонецЕсли;
    Возврат "NO";
КонецФункции

Функция ПроверитьСсылку() Экспорт
    СсылкаПробы = ПустаяСсылка();
    РезультатПробы = Новый Массив;
    РезультатПробы.Добавить(Строка(ТипЗнч(СсылкаПробы)));
    РезультатПробы.Добавить(Строка(СсылкаПробы.УникальныйИдентификатор()));
    РезультатПробы.Добавить(БулевоПробы(ЗначениеЗаполнено(СсылкаПробы)));
    РезультатПробы.Добавить(Строка(СсылкаПробы));
    РезультатПробы.Добавить(БулевоПробы(СсылкаПробы = EmptyRef()));
    РезультатПробы.Добавить(БулевоПробы(СсылкаПробы.Пустая()));
    РезультатПробы.Добавить(БулевоПробы(ТипЗнч(СсылкаПробы) = Тип("DocumentRef.ЗамерДокумента")));
    РезультатПробы.Добавить(БулевоПробы(ТипЗнч(СсылкаПробы) = Тип("ДокументСсылка.ЗамерДокумента")));
    РезультатПробы.Добавить(БулевоПробы(СсылкаПробы <> Справочники.ЗамерВременныхТаблиц.ПустаяСсылка()));
    РезультатПробы.Добавить(СсылкаПробы.Метаданные().Имя);
    Попытка
        ТипБезПрефиксаПробы = Тип("ЗамерДокумента");
        РезультатПробы.Добавить("accepted");
    Исключение
        РезультатПробы.Добавить("rejected");
    КонецПопытки;
    Возврат РезультатПробы;
КонецФункции
