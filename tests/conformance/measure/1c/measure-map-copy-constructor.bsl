// PLATFORM-ONLY: проба фиксирует конструктор Соответствия из фиксированного соответствия.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция ОшибкаКонструктора(Значение)
	Попытка
		Копия = Новый Соответствие(Значение);
		Возврат "OK";
	Исключение
		Возврат "ERR";
	КонецПопытки;
КонецФункции

Источник = Новый Соответствие;
Источник.Вставить("А", 1);
Фиксированный = Новый ФиксированноеСоответствие(Источник);
Копия = Новый Соответствие(Фиксированный);
Копия.Вставить("А", 2);
EnglishCopy = New Map(Фиксированный);

М("file.begin", "map-copy-constructor-1");
М("MAP.COPY.COUNT", Копия.Количество());
М("MAP.COPY.VALUE", Копия.Получить("А"));
М("MAP.COPY.SOURCE", Фиксированный.Получить("А"));
М("MAP.COPY.ENGLISH", EnglishCopy.Get("А"));
М("MAP.COPY.UNDEFINED", ОшибкаКонструктора(Неопределено));
М("MAP.COPY.MUTABLE", ОшибкаКонструктора(Источник));
М("file.end", "map-copy-constructor-1");
