// Собственный модуль для сопоставления исходника, образа и исполнения 1С.
Функция Арифметика(Знач Первый, Второй = 3) Экспорт
    Второй = Второй + 1;
    Возврат Первый * 2 + Второй;
КонецФункции

Процедура ИзменитьПараметр(Параметр) Экспорт
    Параметр = Параметр + 7;
КонецПроцедуры

Функция Ветвление(Знач ЧислоПробы) Экспорт
    Если ЧислоПробы < 0 Тогда
        Возврат -ЧислоПробы;
    ИначеЕсли ЧислоПробы = 0 Тогда
        Возврат 100;
    Иначе
        Возврат ЧислоПробы + 10;
    КонецЕсли;
КонецФункции

Функция Циклы() Экспорт
    СуммаПробы = 0;
    Для ИндексПробы = 1 По 3 Цикл
        СуммаПробы = СуммаПробы + ИндексПробы;
    КонецЦикла;
    Пока СуммаПробы < 10 Цикл
        СуммаПробы = СуммаПробы + 1;
    КонецЦикла;
    ЭлементыПробы = Новый Массив;
    ЭлементыПробы.Добавить(2);
    ЭлементыПробы.Добавить(5);
    Для Каждого ЭлементПробы Из ЭлементыПробы Цикл
        СуммаПробы = СуммаПробы + ЭлементПробы;
    КонецЦикла;
    Возврат СуммаПробы;
КонецФункции

Функция КороткоеВычисление() Экспорт
    СчетчикПробы = 0;
    РезультатПробы = Ложь И СчитатьВызов(СчетчикПробы);
    РезультатПробы = Истина Или СчитатьВызов(СчетчикПробы);
    РезультатПробы = Истина И СчитатьВызов(СчетчикПробы);
    Возврат СчетчикПробы;
КонецФункции

Функция СчитатьВызов(СчетчикПробы)
    СчетчикПробы = СчетчикПробы + 1;
    Возврат Истина;
КонецФункции

Функция ИсключениеПробы() Экспорт
    Попытка
        ВызватьИсключение "контрольный отказ";
    Исключение
        Возврат "поймано";
    КонецПопытки;
КонецФункции

// Дополнительные формы независимо написанного контрольного исходника.
Функция ПовторныеВызовы(СчетчикПробы) Экспорт
    ИзменитьИСчитать(СчетчикПробы, 2);
    ИзменитьИСчитать(СчетчикПробы, 3);
    МассивПробы = Новый Массив;
    МассивПробы.Добавить(СчетчикПробы);
    МассивПробы.Количество();
    МассивПробы.Количество();
    Возврат СчетчикПробы + МассивПробы.Количество();
КонецФункции

Функция ИзменитьИСчитать(СчетчикПробы, Знач ПриращениеПробы = 1)
    СчетчикПробы = СчетчикПробы + ПриращениеПробы;
    Возврат СчетчикПробы;
КонецФункции

Функция Конструкторы() Экспорт
    СтруктураПробы = Новый Структура("Первый,Второй", 2, 3);
    СтруктураПробы.Вставить("Третий", 4);
    МассивПробы = Новый Массив(2, 3);
    МассивПробы[0][1] = 7;
    МассивПробы[1][1] = 9;
    Возврат СтруктураПробы.Первый + СтруктураПробы.Второй + СтруктураПробы.Третий + МассивПробы[0][1] + МассивПробы[1][1];
КонецФункции

Функция Пропуски() Экспорт
    ПервыйПробы = 1;
    ПоследнийПробы = 8;
    РезультатПробы = СложитьПропуски(ПервыйПробы,,,,,,,ПоследнийПробы);
    Возврат РезультатПробы + ПервыйПробы + ПоследнийПробы;
КонецФункции

Функция СложитьПропуски(Первый = 1, Второй = 2, Третий = 3, Четвертый = 4, Пятый = 5, Шестой = 6, Седьмой = 7, Восьмой = 8)
    Первый = Первый + 10;
    Восьмой = Восьмой + 80;
    Возврат Первый + Второй + Третий + Четвертый + Пятый + Шестой + Седьмой + Восьмой;
КонецФункции

Функция ДополнительныеВозвраты(Знач ЧислоПробы) Экспорт
    Если ЧислоПробы < 0 Тогда
        Возврат -ЧислоПробы;
    ИначеЕсли ЧислоПробы = 0 Тогда
        Возврат 100;
    КонецЕсли;
    Возврат ?(ЧислоПробы > 4, ЧислоПробы, 10 / ЧислоПробы);
КонецФункции

Функция ВыходыИзЦиклов() Экспорт
    МассивПробы = Новый Массив;
    МассивПробы.Добавить(1);
    МассивПробы.Добавить(2);
    МассивПробы.Добавить(3);
    МассивПробы.Добавить(4);
    СуммаПробы = 0;
    Для Каждого ЭлементПробы Из МассивПробы Цикл
        Если ЭлементПробы = 2 Тогда
            Продолжить;
        КонецЕсли;
        Если ЭлементПробы = 4 Тогда
            Прервать;
        КонецЕсли;
        СуммаПробы = СуммаПробы + ЭлементПробы;
    КонецЦикла;
    СчетчикПробы = 3;
    Пока СчетчикПробы > 0 Цикл
        СчетчикПробы = СчетчикПробы - 1;
        Если СчетчикПробы = 1 Тогда
            Продолжить;
        КонецЕсли;
        Если СчетчикПробы = 0 Тогда
            Прервать;
        КонецЕсли;
        СуммаПробы = СуммаПробы + СчетчикПробы;
    КонецЦикла;
    Возврат СуммаПробы;
КонецФункции

Процедура ОшибкаСПродолжением(Знач НужнаОшибка, СледПробы, ОписаниеПробы) Экспорт
    СледПробы = 1;
    Попытка
        Если НужнаОшибка Тогда
            ВызватьИсключение "контрольная ошибка";
        КонецЕсли;
        СледПробы = 2;
    Исключение
        ОшибкаПробы = ИнформацияОбОшибке();
        ОписаниеПробы = ОшибкаПробы.Описание;
        СледПробы = 3;
    КонецПопытки;
    СледПробы = СледПробы + 10;
КонецПроцедуры

Функция ГраницаМетодом() Экспорт
    МассивПробы = Новый Массив;
    МассивПробы.Добавить(1);
    МассивПробы.Добавить(2);
    МассивПробы.Добавить(3);
    СуммаПробы = 0;
    Для СчетчикПробы = 0 По МассивПробы.Количество() - 1 Цикл
        СуммаПробы = СуммаПробы + СчетчикПробы;
        МассивПробы.Добавить(СчетчикПробы);
    КонецЦикла;
    Возврат СуммаПробы + МассивПробы.Количество();
КонецФункции
