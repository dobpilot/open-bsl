// Устаревшая `Найти`: пустая подстрока и нестроковые аргументы.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Значение);
КонецПроцедуры

Функция Н(Строка1, Подстрока)
	Попытка
		Возврат Строка(Найти(Строка1, Подстрока));
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

М("LEGACYFIND.EMPTY_NEEDLE", Н("абв", ""));
М("LEGACYFIND.EMPTY_BOTH", Н("", ""));
М("LEGACYFIND.EMPTY_HAYSTACK", Н("", "а"));
М("LEGACYFIND.FOUND", Н("абвб", "б"));
М("LEGACYFIND.CASE", Н("абв", "Б"));
М("LEGACYFIND.NUMBER", Н(12345, 3));
М("LEGACYFIND.UNDEFINED", Н(Неопределено, ""));
М("LEGACYFIND.THOUSANDS", Н(1000, Символ(160)));
М("LEGACYFIND.FRACTION", Н(1.5, "."));
М("LEGACYFIND.DATE", Н(Дата(2024, 1, 2), "2024"));
