// Проверяет оба значения системного перечисления и передачу в `Окр`.

Для Каждого Режим Из РежимОкругления Цикл
	Сообщить("VALUE" + Символ(9) + Строка(Режим) + Символ(9) + Строка(ТипЗнч(Режим)));
КонецЦикла;
Сообщить("DOWN" + Символ(9) + Строка(Окр(1.5, 0, РежимОкругления.Окр15как10)));
Сообщить("UP" + Символ(9) + Строка(Окр(1.5, 0, РежимОкругления.Окр15как20)));
Сообщить("ALIASES" + Символ(9) + Строка(RoundMode.Round15as10 = РежимОкругления.Окр15как10));
