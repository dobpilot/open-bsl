// Английские псевдонимы двух значений, которых нет в установленном синтакс-помощнике.

Попытка
    ЗначениеПроверки = Вычислить("SearchStringLocation.None");
    Если ЗначениеПроверки = ПоложениеСтрокиПоиска.Нет Тогда
        Сообщить("SEARCH_NONE" + Символ(9) + "PASS");
    Иначе
        Сообщить("SEARCH_NONE" + Символ(9) + "DIFFERENT");
    КонецЕсли;
Исключение
    Сообщить("SEARCH_NONE" + Символ(9) + "ERROR");
КонецПопытки;

Попытка
    ЗначениеПроверки = Вычислить("FormattedDocumentItemType.Text");
    Если ЗначениеПроверки = ТипЭлементаФорматированногоДокумента.Текст Тогда
        Сообщить("FORMATTED_TEXT" + Символ(9) + "PASS");
    Иначе
        Сообщить("FORMATTED_TEXT" + Символ(9) + "DIFFERENT");
    КонецЕсли;
Исключение
    Сообщить("FORMATTED_TEXT" + Символ(9) + "ERROR");
КонецПопытки;
