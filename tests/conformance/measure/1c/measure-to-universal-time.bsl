// Преобразование местного времени в UTC через фиксированную и именованную зоны.

Процедура ПроверитьУниверсальноеВремя(Имя, Условие)
	Если Условие Тогда
		Сообщить(Имя + Символ(9) + "PASS");
	Иначе
		Сообщить(Имя + Символ(9) + "FAIL");
	КонецЕсли;
КонецПроцедуры

ПроверитьУниверсальноеВремя("GMT", УниверсальноеВремя(Дата(2024, 1, 2, 12, 0, 0), "GMT+3") = Дата(2024, 1, 2, 9, 0, 0));
ПроверитьУниверсальноеВремя("ALIAS", УниверсальноеВремя(Дата(2024, 1, 2, 12, 0, 0), "GMT+3") = ToUniversalTime(Дата(2024, 1, 2, 12, 0, 0), "GMT+3"));
ПроверитьУниверсальноеВремя("DEFAULT", УниверсальноеВремя(Дата(2024, 1, 2, 12, 0, 0)) = УниверсальноеВремя(Дата(2024, 1, 2, 12, 0, 0), Неопределено));
ПроверитьУниверсальноеВремя("MOSCOW", УниверсальноеВремя(Дата(2024, 1, 2, 12, 0, 0), "Europe/Moscow") = Дата(2024, 1, 2, 9, 0, 0));
ПроверитьУниверсальноеВремя("FOLD", УниверсальноеВремя(Дата(2010, 10, 31, 2, 30, 0), "Europe/Moscow") = Дата(2010, 10, 30, 23, 30, 0));
ПроверитьУниверсальноеВремя("GAP", УниверсальноеВремя(Дата(2011, 3, 27, 2, 30, 0), "Europe/Moscow") = Дата(2011, 3, 26, 23, 30, 0));

Попытка
	УниверсальноеВремя(Дата(2024, 1, 2, 12, 0, 0), "Нет/ТакойЗоны");
	Сообщить("UNKNOWN" + Символ(9) + "FAIL");
Исключение
	Сообщить("UNKNOWN" + Символ(9) + "PASS");
КонецПопытки;

Попытка
	ПроверитьУниверсальноеВремя("STRING", УниверсальноеВремя("20240102120000", "GMT+3") = Дата(2024, 1, 2, 9, 0, 0));
Исключение
	Сообщить("STRING" + Символ(9) + "ERROR");
КонецПопытки;

Попытка
	УниверсальноеВремя(Неопределено, "GMT+3");
	Сообщить("UNDEFINED" + Символ(9) + "VALUE");
Исключение
	Сообщить("UNDEFINED" + Символ(9) + "ERROR");
КонецПопытки;
