Перем ИтогиТелаПробы;
Функция ПрочитатьРезультатыТела() Экспорт
    Возврат ИтогиТелаПробы;
КонецФункции
Функция Описать() Экспорт
    Если ТипЗнч(СоставнойПробы) = Тип("Неопределено") Тогда
        ТекстСоставногоПробы = "undefined";
    ИначеЕсли ТипЗнч(СоставнойПробы) = Тип("Строка") Тогда
        ТекстСоставногоПробы = "[" + СоставнойПробы + "]";
    ИначеЕсли ТипЗнч(СоставнойПробы) = Тип("СправочникСсылка.ЗамерВременныхТаблиц") Тогда
        ТекстСоставногоПробы = "ref:" + Строка(СоставнойПробы.УникальныйИдентификатор());
    Иначе
        ТекстСоставногоПробы = "other";
    КонецЕсли;
    Возврат Строка(ТипЗнч(СсылкаПробы) = Тип("СправочникСсылка.ЗамерВременныхТаблиц")) + ":" + Строка(СсылкаПробы.УникальныйИдентификатор()) + ":" + ТекстСоставногоПробы;
КонецФункции
ИтогиТелаПробы = Новый Массив;
Попытка
    РезультатТелаПробы = Строка(СсылкаПробы.Пустая()) + ":" + Строка(ТипЗнч(СоставнойПробы) = Тип("Неопределено"));
Исключение
    РезультатТелаПробы = "rejected";
КонецПопытки;
ИтогиТелаПробы.Добавить("initial=" + РезультатТелаПробы);
Попытка
    СсылкаПробы = Неопределено;
    РезультатТелаПробы = "accepted";
Исключение
    РезультатТелаПробы = "rejected";
КонецПопытки;
ИтогиТелаПробы.Добавить("reference.write=" + РезультатТелаПробы);
