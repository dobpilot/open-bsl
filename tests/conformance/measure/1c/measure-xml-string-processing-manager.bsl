// Контракт глобального менеджера обработки строк XML.

Процедура П(Ид, Выражение)
	Попытка
		Результат = Вычислить(Выражение);
		ИмяТипа = ?(ТипЗнч(Результат) = Тип("Число"), "NUMBER", Строка(ТипЗнч(Результат)));
		Сообщить(Ид + Символ(9) + "OK" + Символ(9)
			+ ИмяТипа + Символ(9) + Строка(Результат));
	Исключение
		Сообщить(Ид + Символ(9) + "ERROR");
	КонецПопытки;
КонецПроцедуры

П("XMLSP.TYPE", "ОбработкаСтрокиXML");
П("XMLSP.VALID", "ОбработкаСтрокиXML.НайтиНедопустимыеСимволыXML(""ABC"")");
П("XMLSP.INVALID", "ОбработкаСтрокиXML.НайтиНедопустимыеСимволыXML(""A"" + Символ(1) + ""B"")");
П("XMLSP.START.AT", "ОбработкаСтрокиXML.НайтиНедопустимыеСимволыXML(""A"" + Символ(1) + ""B"", 2)");
П("XMLSP.START.AFTER", "ОбработкаСтрокиXML.НайтиНедопустимыеСимволыXML(""A"" + Символ(1) + ""B"", 3)");
П("XMLSP.UTF16", "ОбработкаСтрокиXML.НайтиНедопустимыеСимволыXML(""😀"" + Символ(1))");
П("XMLSP.ZERO", "ОбработкаСтрокиXML.НайтиНедопустимыеСимволыXML()");
П("XMLSP.THREE", "ОбработкаСтрокиXML.НайтиНедопустимыеСимволыXML(""ABC"", 1, 1)");
П("XMLSP.ENGLISH", "XMLStringProcessing.FindDisallowedXMLCharacters(""A"" + Символ(1) + ""B"", 2)");
