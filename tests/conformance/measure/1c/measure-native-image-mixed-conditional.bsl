Процедура ПрямаяПроба(АргументПробы, СледПробы)
    КопияПробы = ?(АргументПробы > 0, 2, 3);
    Если АргументПробы > 0 Тогда
        СледПробы = КопияПробы;
    Иначе
        СледПробы = КопияПробы + 10;
    КонецЕсли;
КонецПроцедуры

Попытка
    АргументПробы = 3;
    СледПробы = 0;
    ПрямойАргументПробы = 3;
    ПрямойСледПробы = 0;
    ЗамерыТранзитивногоРодителя.Проба(АргументПробы, СледПробы);
    ПрямаяПроба(ПрямойАргументПробы, ПрямойСледПробы);
    Сообщить("image.native.mixed_conditional.positive.value=" + Строка(СледПробы));
    Сообщить("image.native.mixed_conditional.positive.argument=" + Строка(АргументПробы));
    Сообщить("image.native.mixed_conditional.positive.direct=" + Строка(?(СледПробы = ПрямойСледПробы И АргументПробы = ПрямойАргументПробы, 1, 0)));
Исключение
    Сообщить("image.native.mixed_conditional.positive.failure=" + ОписаниеОшибки());
КонецПопытки;
