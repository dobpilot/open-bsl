Перем ИтогиТелаРодителя;

Функция ИтогиТела() Экспорт
    Возврат ИтогиТелаРодителя;
КонецФункции

Функция ПрочитатьРодителя() Экспорт
    Возврат Родитель;
КонецФункции

ИтогиТелаРодителя = Новый Массив;
Попытка
    ПробаРодителя = Родитель;
    ИтогиТелаРодителя.Добавить("read=accepted;empty=" + Строка(ПробаРодителя.Пустая()));
Исключение
    ИтогиТелаРодителя.Добавить("read=rejected");
КонецПопытки;
Попытка
    Родитель = Справочники.ЗамерВременныхТаблиц.ПустаяСсылка();
    ИтогиТелаРодителя.Добавить("write=accepted");
Исключение
    ИтогиТелаРодителя.Добавить("write=rejected");
КонецПопытки;
