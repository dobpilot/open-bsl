// Типы рамок, достигнутые в серверных модулях УНФ.

Процедура ПроверитьЧлен(Ключ, Значение, Псевдоним)
    Если Значение = Псевдоним Тогда
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "PASS");
    Иначе
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "FAIL");
    КонецЕсли;
КонецПроцедуры

ПроверитьЧлен("NONE", ТипРамкиЭлементаУправления.БезРамки, ControlBorderType.WithoutBorder);
ПроверитьЧлен("SINGLE", ТипРамкиЭлементаУправления.Одинарная, ControlBorderType.Single);
ПроверитьЧлен("UNDERLINE", ТипРамкиЭлементаУправления.Подчеркивание, ControlBorderType.Underline);
Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(ТипРамкиЭлементаУправления.БезРамки)));
