# Минимальный справочник нужен пробам временных таблиц и ссылок менеджера.
# Запускайте её на отдельной `ONEC_IB`, чтобы состав остальных баз замеров
# не зависел от уже загруженных дополнительных объектов.
copy-tree tests/conformance/measure/1c/cfg-src-temp-tables
child Catalog ЗамерВременныхТаблиц
copy-tree tests/conformance/measure/1c/cfg-src-document-reference
child Document ЗамерДокумента
mkdir Catalogs/ЗамерВременныхТаблиц/Ext
copy tests/conformance/measure/1c/catalog-parent-module.bsl Catalogs/ЗамерВременныхТаблиц/Ext/ObjectModule.bsl
# Вторая ссылка нужна для проверки присваивания чужого типа справочника.
python tests/conformance/measure/1c/catalog-parent-foreign-reference.py
mkdir Catalogs/ЗамерВременныхТаблиц/Ext
copy tests/conformance/measure/1c/catalog-new-reference-module.bsl Catalogs/ЗамерВременныхТаблиц/Ext/ObjectModule.bsl
