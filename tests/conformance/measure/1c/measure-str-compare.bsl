// PLATFORM-ONLY: проба фиксирует достигнутую функцию сравнения строк.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "str-compare-1");
М("STR.COMPARE.EQUAL", СтрСравнить("Строка", "строка"));
М("STR.COMPARE.LESS", СтрСравнить("а", "б"));
М("STR.COMPARE.GREATER", СтрСравнить("б", "а"));
М("STR.COMPARE.PREFIX", СтрСравнить("а", "аа"));
М("STR.COMPARE.EMPTY.EQUAL", СтрСравнить("", ""));
М("STR.COMPARE.EMPTY.LESS", СтрСравнить("", "а"));
М("STR.COMPARE.YO", СтрСравнить("е", "ё"));
М("STR.COMPARE.LATIN.CYRILLIC", СтрСравнить("a", "а"));
М("STR.COMPARE.ENGLISH", StrCompare("Строка", "строка"));
М("STR.COMPARE.TYPE", ТипЗнч(СтрСравнить("а", "б")));

ЧислоСтрока = "ERROR";
Попытка
	ЧислоСтрока = СтрСравнить(1, "1");
Исключение
КонецПопытки;
М("STR.COMPARE.NUMBER.STRING", ЧислоСтрока);

НеопределеноПустая = "ERROR";
Попытка
	НеопределеноПустая = СтрСравнить(Неопределено, "");
Исключение
КонецПопытки;
М("STR.COMPARE.UNDEFINED.EMPTY", НеопределеноПустая);

МассивСтрока = "ERROR";
Попытка
	МассивСтрока = СтрСравнить(Новый Массив, "Массив");
Исключение
КонецПопытки;
М("STR.COMPARE.ARRAY.STRING", МассивСтрока);
М("file.end", "str-compare-1");
