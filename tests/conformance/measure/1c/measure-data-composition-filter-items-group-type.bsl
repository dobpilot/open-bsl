// Типы групп элементов отбора СКД в серверном контексте.

Процедура ПроверитьЧлен(Ключ, Значение, Псевдоним)
    Если Значение = Псевдоним Тогда
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "PASS");
    Иначе
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "FAIL");
    КонецЕсли;
КонецПроцедуры

ПроверитьЧлен("AND", ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ, DataCompositionFilterItemsGroupType.AndGroup);
ПроверитьЧлен("OR", ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли, DataCompositionFilterItemsGroupType.OrGroup);
ПроверитьЧлен("NOT", ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе, DataCompositionFilterItemsGroupType.NotGroup);
Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(DataCompositionFilterItemsGroupType.AndGroup)));
