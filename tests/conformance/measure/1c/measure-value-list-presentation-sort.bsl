// Порядок представлений списка значений на платформе.
Процедура М(Ид, Значение)
    Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры
Функция ПорядокПробы(СписокПробы)
    РезультатПробы = "";
    Для Каждого ЭлементПробы Из СписокПробы Цикл
        РезультатПробы = РезультатПробы + Строка(ЭлементПробы.Значение) + ",";
    КонецЦикла;
    Возврат РезультатПробы;
КонецФункции
Функция СортировкаПробы(ВызовПробы, БезПредставлений = Ложь)
    СписокПробы = Новый СписокЗначений;
    Если БезПредставлений Тогда
        СписокПробы.Добавить("b");
        СписокПробы.Добавить("A");
        СписокПробы.Добавить("a");
    Иначе
        СписокПробы.Добавить(1, "b");
        СписокПробы.Добавить(2, "A");
        СписокПробы.Добавить(3, "a");
        СписокПробы.Добавить(4, "B");
        СписокПробы.Добавить(5, "Ё");
        СписокПробы.Добавить(6, "Е");
        СписокПробы.Добавить(7, "ё");
        СписокПробы.Добавить(8, "я");
        СписокПробы.Добавить(9, "");
    КонецЕсли;
    Попытка
        Выполнить(ВызовПробы);
        Возврат ПорядокПробы(СписокПробы);
    Исключение
        Возврат "ERROR";
    КонецПопытки;
КонецФункции
Функция ПараПробы(ПервоеПробы, ВтороеПробы, ОбратныйПробы = Ложь)
    СписокПробы = Новый СписокЗначений;
    СписокПробы.Добавить(1, ПервоеПробы);
    СписокПробы.Добавить(2, ВтороеПробы);
    Попытка
        Если ОбратныйПробы Тогда
            Выполнить("СписокПробы.СортироватьПоПредставлению(НаправлениеСортировки.Убыв);");
        Иначе
            Выполнить("СписокПробы.СортироватьПоПредставлению();");
        КонецЕсли;
        Возврат ПорядокПробы(СписокПробы);
    Исключение
        Возврат "ERROR";
    КонецПопытки;
КонецФункции
М("VLIST.PRESENTATION.BEGIN", "1");
М("VLIST.PRESENTATION.DEFAULT", СортировкаПробы("СписокПробы.СортироватьПоПредставлению();", Ложь));
М("VLIST.PRESENTATION.ASC", СортировкаПробы("СписокПробы.СортироватьПоПредставлению(НаправлениеСортировки.Возр);", Ложь));
М("VLIST.PRESENTATION.DESC", СортировкаПробы("СписокПробы.СортироватьПоПредставлению(НаправлениеСортировки.Убыв);", Ложь));
М("VLIST.PRESENTATION.ALIAS", СортировкаПробы("СписокПробы.SortByPresentation(SortDirection.Asc);", Ложь));
М("VLIST.PRESENTATION.UNDEFINED", СортировкаПробы("СписокПробы.СортироватьПоПредставлению(Неопределено);", Ложь));
М("VLIST.PRESENTATION.INVALID", СортировкаПробы("СписокПробы.СортироватьПоПредставлению(1);", Ложь));
М("VLIST.PRESENTATION.MISSING", СортировкаПробы("СписокПробы.СортироватьПоПредставлению();", Истина));
М("VLIST.PRESENTATION.LATIN.CASE", ПараПробы("a", "A"));
М("VLIST.PRESENTATION.CYRILLIC.CASE", ПараПробы("е", "Е"));
М("VLIST.PRESENTATION.YO.CASE", ПараПробы("Ё", "ё"));
М("VLIST.PRESENTATION.YO.LOWER", ПараПробы("ё", "е"));
М("VLIST.PRESENTATION.YO.UPPER", ПараПробы("Ё", "Е"));
М("VLIST.PRESENTATION.YO.CROSS", ПараПробы("ё", "Е"));
М("VLIST.PRESENTATION.CYRILLIC.A", ПараПробы("а", "А"));
М("VLIST.PRESENTATION.CASE.BEFORE.NEXT", ПараПробы("е", "Ж"));
М("VLIST.PRESENTATION.EQUAL", ПараПробы("same", "same"));
М("VLIST.PRESENTATION.EQUAL.DESC", ПараПробы("same", "same", Истина));
М("VLIST.PRESENTATION.MIXED.CASE", ПараПробы("еA", "Еa"));
М("VLIST.PRESENTATION.MIXED.PREFIX", ПараПробы("Еa", "еB"));
М("VLIST.PRESENTATION.MIXED.YO", ПараПробы("ЁA", "Еz"));
М("VLIST.PRESENTATION.LATIN.NEXT", ПараПробы("a", "B"));
М("VLIST.PRESENTATION.MIXED.SUFFIX", ПараПробы("еz", "ЕA"));
М("VLIST.PRESENTATION.END", "1");

Попытка
    РезультатДопПробы = ПараПробы(1, "a");
Исключение
    РезультатДопПробы = "ERROR";
КонецПопытки;
М("VLIST.PRESENTATION.NUMBER", РезультатДопПробы);
Попытка
    РезультатДопПробы = ПараПробы(Неопределено, "a");
Исключение
    РезультатДопПробы = "ERROR";
КонецПопытки;
М("VLIST.PRESENTATION.UNDEFINED.KEY", РезультатДопПробы);
