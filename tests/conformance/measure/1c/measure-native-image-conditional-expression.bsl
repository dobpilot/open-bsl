Функция ПрямаяУсловнаяПроба(УсловиеПробы, ЧислительПробы, ЗнаменательПробы, ПриемникПробы)
    ПриемникПробы = ?(УсловиеПробы, ЧислительПробы, ЧислительПробы / ЗнаменательПробы);
    Возврат ПриемникПробы;
КонецФункции

Попытка
    ПриемникПробы = 99;
    РезультатПробы = ЗамерыТранзитивногоРодителя.Проба(Истина, 12, 0, ПриемникПробы);
    ПриемникПрямойПробы = 99;
    РезультатПрямойПробы = ПрямаяУсловнаяПроба(Истина, 12, 0, ПриемникПрямойПробы);
    Сообщить("image.native.conditional.yes.result=" + Строка(РезультатПробы));
    Сообщить("image.native.conditional.yes.target=" + Строка(ПриемникПробы));
    Сообщить("image.native.conditional.yes.direct=" + Строка(?(РезультатПробы = РезультатПрямойПробы И ПриемникПробы = ПриемникПрямойПробы, 1, 0)));
Исключение
    Сообщить("image.native.conditional.yes.failure=" + ОписаниеОшибки());
КонецПопытки;
Попытка
    ПриемникПробы = 99;
    РезультатПробы = ЗамерыТранзитивногоРодителя.Проба(Ложь, 12, 3, ПриемникПробы);
    ПриемникПрямойПробы = 99;
    РезультатПрямойПробы = ПрямаяУсловнаяПроба(Ложь, 12, 3, ПриемникПрямойПробы);
    Сообщить("image.native.conditional.no.result=" + Строка(РезультатПробы));
    Сообщить("image.native.conditional.no.target=" + Строка(ПриемникПробы));
    Сообщить("image.native.conditional.no.direct=" + Строка(?(РезультатПробы = РезультатПрямойПробы И ПриемникПробы = ПриемникПрямойПробы, 1, 0)));
Исключение
    Сообщить("image.native.conditional.no.failure=" + ОписаниеОшибки());
КонецПопытки;
