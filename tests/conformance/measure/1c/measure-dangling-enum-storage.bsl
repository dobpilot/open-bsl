// PLATFORM-ONLY: отсутствующее значение перечисления в настройке заполнения.
Попытка
    ПробаЗначение = Метаданные.Документы.ЗамерДокумента.Реквизиты.СсылкаПробы.ЗначениеЗаполнения;
    Сообщить("dangling.enum.metadata.type=" + ?(ТипЗнч(ПробаЗначение) = Тип("ПеречислениеСсылка.ЗамерПеречисления"), "enum", "other"));
    Сообщить("dangling.enum.metadata.empty=" + ?(ПробаЗначение = Перечисления.ЗамерПеречисления.ПустаяСсылка(), "YES", "NO"));
    Сообщить("dangling.enum.metadata.filled=" + ?(ЗначениеЗаполнено(ПробаЗначение), "YES", "NO"));
    Сообщить("dangling.enum.metadata.text=[" + Строка(ПробаЗначение) + "]");
Исключение
    Сообщить("dangling.enum.metadata.error=" + ОписаниеОшибки());
КонецПопытки;
Попытка
    ПробаОбъект = Документы.ЗамерДокумента.СоздатьДокумент();
    Сообщить("dangling.enum.creation.empty=" + ?(ПробаОбъект.СсылкаПробы = Перечисления.ЗамерПеречисления.ПустаяСсылка(), "YES", "NO"));
    ПробаОбъект.Заполнить(Неопределено);
    Сообщить("dangling.enum.fill.empty=" + ?(ПробаОбъект.СсылкаПробы = Перечисления.ЗамерПеречисления.ПустаяСсылка(), "YES", "NO"));
    Сообщить("dangling.enum.fill.text=[" + Строка(ПробаОбъект.СсылкаПробы) + "]");
Исключение
    Сообщить("dangling.enum.fill.error=" + ОписаниеОшибки());
КонецПопытки;

Попытка
    ПробаМетаданные = Новый Массив;
    ПробаМетаданные.Добавить(Метаданные.Перечисления.ЗамерПеречисления);
    ПробаХранение = ПолучитьСтруктуруХраненияБазыДанных(ПробаМетаданные, Истина);
    Для Каждого ПробаТаблица Из ПробаХранение Цикл
        Сообщить("dangling.enum.storage=" + ПробаТаблица.StorageTableName + ":" + ПробаТаблица.Metadata);
    КонецЦикла;
Исключение
    Сообщить("dangling.enum.storage.error=" + ОписаниеОшибки());
КонецПопытки;
