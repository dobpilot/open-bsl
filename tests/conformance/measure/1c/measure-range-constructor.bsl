// PLATFORM-ONLY: форма конструктора Диапазон и смысл пропущенных границ.

Попытка
    Диапазон0 = Вычислить("Новый Диапазон()");
    Результат0 = "OK";
Исключение
    Результат0 = "ERROR";
КонецПопытки;
Сообщить("ARITY_0" + Символ(9) + Результат0);

Попытка
    Диапазон1 = Вычислить("Новый Диапазон(1)");
    Результат1 = "OK";
Исключение
    Результат1 = "ERROR";
КонецПопытки;
Сообщить("ARITY_1" + Символ(9) + Результат1);

Попытка
    Диапазон2 = Вычислить("Новый Диапазон(1, 3)");
    Результат2 = "OK";
Исключение
    Результат2 = "ERROR";
КонецПопытки;
Сообщить("ARITY_2" + Символ(9) + Результат2);

Попытка
    Диапазон3 = Вычислить("Новый Диапазон(1, 2, 3)");
    Результат3 = "OK";
Исключение
    Результат3 = "ERROR";
КонецПопытки;
Сообщить("ARITY_3" + Символ(9) + Результат3);

Попытка
    ДиапазонАнгл = Вычислить("Новый Range(1, 3)");
    РезультатАнгл = "OK";
Исключение
    РезультатАнгл = "ERROR";
КонецПопытки;
Сообщить("EN_ALIAS" + Символ(9) + РезультатАнгл);

Попытка
    ДиапазонБезНачала = Вычислить("Новый Диапазон(, Дата(2024, 1, 31))");
    РезультатБезНачала = "OK";
Исключение
    РезультатБезНачала = "ERROR";
КонецПопытки;
Сообщить("OMIT_BEGIN" + Символ(9) + РезультатБезНачала);

Попытка
    ДиапазонБезКонца = Вычислить("Новый Диапазон(Дата(2024, 1, 1), )");
    РезультатБезКонца = "OK";
Исключение
    РезультатБезКонца = "ERROR";
КонецПопытки;
Сообщить("OMIT_END" + Символ(9) + РезультатБезКонца);

Если Результат2 = "OK" Тогда
    Попытка
        Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(Диапазон2)));
        Сообщить("BEGIN" + Символ(9) + Строка(Диапазон2.Начало));
        Сообщить("END" + Символ(9) + Строка(Диапазон2.Конец));
        Сообщить("EN_BEGIN" + Символ(9) + Строка(Диапазон2.Begin));
        Сообщить("EN_END" + Символ(9) + Строка(Диапазон2.End));
    Исключение
        Сообщить("PROPERTIES" + Символ(9) + "ERROR");
    КонецПопытки;
КонецЕсли;

Если РезультатБезНачала = "OK" Тогда
    Попытка
        Сообщить("OMITTED_BEGIN_TYPE" + Символ(9) + Строка(ТипЗнч(ДиапазонБезНачала.Начало)));
        Сообщить("OMITTED_END" + Символ(9) + Строка(ДиапазонБезНачала.Конец));
    Исключение
        Сообщить("OMITTED_PROPERTIES" + Символ(9) + "ERROR");
    КонецПопытки;
КонецЕсли;
