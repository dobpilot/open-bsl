// Литерал нулевой даты, достигнутый в модуле УНФ.

Попытка
    НулеваяДата = Вычислить("'00000000'");
    Сообщить("ACCEPT" + Символ(9) + "YES");
    Если НулеваяДата = '00010101' Тогда
        Сообщить("EMPTY" + Символ(9) + "PASS");
    Иначе
        Сообщить("EMPTY" + Символ(9) + "FAIL");
    КонецЕсли;
Исключение
    Сообщить("ACCEPT" + Символ(9) + "NO");
КонецПопытки;

Попытка
    СтроковаяНулеваяДата = Дата("00000000");
    Если СтроковаяНулеваяДата = '00010101' Тогда
        Сообщить("STRING" + Символ(9) + "EMPTY");
    Иначе
        Сообщить("STRING" + Символ(9) + "OTHER");
    КонецЕсли;
Исключение
    Сообщить("STRING" + Символ(9) + "ERROR");
КонецПопытки;
