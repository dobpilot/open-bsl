// Контроль SHA512 для достигнутого вызова оригинального demo.
Процедура М(Ид, Значение)
    Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры
М("SHA512.BEGIN", "1");
Попытка
    ХешПробы = Новый ХешированиеДанных(ХешФункция.SHA512);
    М("SHA512.EMPTY", ПолучитьHexСтрокуИзДвоичныхДанных(ХешПробы.ХешСумма));
    ХешПробы.Добавить(ПолучитьДвоичныеДанныеИзСтроки("a", КодировкаТекста.UTF8));
    СуммаПробы = ПолучитьHexСтрокуИзДвоичныхДанных(ХешПробы.ХешСумма);
    М("SHA512.REPEATED", ?(СуммаПробы = ПолучитьHexСтрокуИзДвоичныхДанных(ХешПробы.ХешСумма), "YES", "NO"));
    ХешПробы.Добавить(ПолучитьДвоичныеДанныеИзСтроки("bc", КодировкаТекста.UTF8));
    М("SHA512.INCREMENTAL", ПолучитьHexСтрокуИзДвоичныхДанных(ХешПробы.ХешСумма));
    ХешЦеликом = Новый DataHashing(HashFunction.SHA512);
    ХешЦеликом.Добавить(ПолучитьДвоичныеДанныеИзСтроки("abc", КодировкаТекста.UTF8));
    М("SHA512.ABC", ПолучитьHexСтрокуИзДвоичныхДанных(ХешЦеликом.HashSum));
Исключение
    М("SHA512.ERROR", ОписаниеОшибки());
КонецПопытки;
М("SHA512.END", "1");
