// Граница недели для середины недели и воскресенья.

Сообщить("MONDAY" + Символ(9) + Формат(КонецНедели(Дата(2024, 1, 1, 12, 34, 56)), "ДФ=yyyyMMddHHmmss"));
Сообщить("WEDNESDAY" + Символ(9) + Формат(КонецНедели(Дата(2024, 1, 3)), "ДФ=yyyyMMddHHmmss"));
Сообщить("SUNDAY" + Символ(9) + Формат(КонецНедели(Дата(2024, 1, 7, 23, 0, 0)), "ДФ=yyyyMMddHHmmss"));
Сообщить("LEAP" + Символ(9) + Формат(КонецНедели(Дата(2024, 2, 29)), "ДФ=yyyyMMddHHmmss"));
Сообщить("BEGIN_MONDAY" + Символ(9) + Формат(НачалоНедели(Дата(2024, 1, 1)), "ДФ=yyyyMMddHHmmss"));
Сообщить("BEGIN_SUNDAY" + Символ(9) + Формат(НачалоНедели(Дата(2024, 1, 7)), "ДФ=yyyyMMddHHmmss"));
Сообщить("DAY_MONDAY" + Символ(9) + Строка(ДеньНедели(Дата(2024, 1, 1))));
Сообщить("DAY_SUNDAY" + Символ(9) + Строка(ДеньНедели(Дата(2024, 1, 7))));
Попытка
    КонецМаксимальнойНедели = Формат(КонецНедели(Дата(9999, 12, 31)), "ДФ=yyyyMMddHHmmss");
Исключение
    КонецМаксимальнойНедели = "ERROR";
КонецПопытки;
Сообщить("MAX" + Символ(9) + КонецМаксимальнойНедели);
Попытка
    КонецПервойНедели = Формат(КонецНедели(Дата(1, 1, 1)), "ДФ=yyyyMMddHHmmss");
Исключение
    КонецПервойНедели = "ERROR";
КонецПопытки;
Сообщить("MIN" + Символ(9) + КонецПервойНедели);
Если НачалоНедели(Дата(1, 1, 1)) = Дата(1, 1, 1) Тогда
    Сообщить("BEGIN_MIN" + Символ(9) + "PASS");
Иначе
    Сообщить("BEGIN_MIN" + Символ(9) + "FAIL");
КонецЕсли;
