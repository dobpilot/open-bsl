// Члены перечисления и текущая скорость клиентского соединения.

Если СкоростьКлиентскогоСоединения.Низкая = ClientConnectionSpeed.Low Тогда
	Сообщить("LOW" + Символ(9) + "PASS");
Иначе
	Сообщить("LOW" + Символ(9) + "FAIL");
КонецЕсли;

Если СкоростьКлиентскогоСоединения.Обычная = ClientConnectionSpeed.Normal Тогда
	Сообщить("NORMAL" + Символ(9) + "PASS");
Иначе
	Сообщить("NORMAL" + Символ(9) + "FAIL");
КонецЕсли;

Сообщить("LOW_TEXT" + Символ(9) + Строка(СкоростьКлиентскогоСоединения.Низкая));
Сообщить("NORMAL_TEXT" + Символ(9) + Строка(СкоростьКлиентскогоСоединения.Обычная));
Сообщить("ROOT" + Символ(9) + Строка(СкоростьКлиентскогоСоединения));
Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(СкоростьКлиентскогоСоединения.Низкая)));

Если ПолучитьСкоростьКлиентскогоСоединения() = GetClientConnectionSpeed() Тогда
	Сообщить("ALIAS" + Символ(9) + "PASS");
Иначе
	Сообщить("ALIAS" + Символ(9) + "FAIL");
КонецЕсли;

Если ПолучитьСкоростьКлиентскогоСоединения() = СкоростьКлиентскогоСоединения.Низкая Тогда
	Сообщить("CURRENT" + Символ(9) + "LOW");
ИначеЕсли ПолучитьСкоростьКлиентскогоСоединения() = СкоростьКлиентскогоСоединения.Обычная Тогда
	Сообщить("CURRENT" + Символ(9) + "NORMAL");
Иначе
	Сообщить("CURRENT" + Символ(9) + "OTHER");
КонецЕсли;
