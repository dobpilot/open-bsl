// Старое и нынешнее русские имена ориентации подписей диаграммы.

Сообщить("ROOT" + Символ(9) + Строка(ОриентацияМетокДиаграммы));
Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(ОриентацияМетокДиаграммы.Авто)));
Сообщить("AUTO" + Символ(9) + Строка(ОриентацияМетокДиаграммы.Авто));
Сообщить("VERTICAL" + Символ(9) + Строка(ОриентацияМетокДиаграммы.Вертикально));
Сообщить("HORIZONTAL" + Символ(9) + Строка(ОриентацияМетокДиаграммы.Горизонтально));
Сообщить("ANGLE" + Символ(9) + Строка(ОриентацияМетокДиаграммы.ПроизвольныйУголНаклона));
Если ОриентацияМетокДиаграммы.Авто = ОриентацияПодписейДиаграммы.Авто
    И ОриентацияМетокДиаграммы.Вертикально = ОриентацияПодписейДиаграммы.Вертикально
    И ОриентацияМетокДиаграммы.Горизонтально = ОриентацияПодписейДиаграммы.Горизонтально
    И ОриентацияМетокДиаграммы.ПроизвольныйУголНаклона = ОриентацияПодписейДиаграммы.ПроизвольныйУголНаклона
    И ОриентацияМетокДиаграммы.Авто = ChartLabelsOrientation.Auto
    И ОриентацияМетокДиаграммы.Вертикально = ChartLabelsOrientation.Vertical
    И ОриентацияМетокДиаграммы.Горизонтально = ChartLabelsOrientation.Horizontal
    И ОриентацияМетокДиаграммы.ПроизвольныйУголНаклона = ChartLabelsOrientation.CustomAngle Тогда
    Сообщить("ALIASES" + Символ(9) + "PASS");
Иначе
    Сообщить("ALIASES" + Символ(9) + "FAIL");
КонецЕсли;
