// PLATFORM-ONLY: проба фиксирует пассивное значение параметра компоновки данных.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "data-composition-parameter-1");
ПараметрПериод = Новый ПараметрКомпоновкиДанных("Период");
ПараметрПериодКопия = Новый ПараметрКомпоновкиДанных("Период");
ПараметрПериодМалыми = Новый ПараметрКомпоновкиДанных("период");
ПараметрОрганизация = Новый ПараметрКомпоновкиДанных("Организация");

НулеваяФорма = "REJECTED";
Попытка
	НулеваяФорма = ТипЗнч(Вычислить("Новый ПараметрКомпоновкиДанных()"));
Исключение
КонецПопытки;
М("DCP.ZERO", НулеваяФорма);
М("DCP.NAMED.TYPE", ТипЗнч(ПараметрПериод));
М("DCP.NAMED.STRING", "[" + Строка(ПараметрПериод) + "]");
М("DCP.NAMED.FILLED", ЗначениеЗаполнено(ПараметрПериод));

ЗначениеСравнения = "ERROR";
Попытка
	ЗначениеСравнения = (ПараметрПериод = ПараметрПериодКопия);
Исключение
КонецПопытки;
М("DCP.EQUAL.SAME", ЗначениеСравнения);

ЗначениеСравнения = "ERROR";
Попытка
	ЗначениеСравнения = (ПараметрПериод = ПараметрПериодМалыми);
Исключение
КонецПопытки;
М("DCP.EQUAL.CASE", ЗначениеСравнения);

ЗначениеСравнения = "ERROR";
Попытка
	ЗначениеСравнения = (ПараметрПериод = ПараметрОрганизация);
Исключение
КонецПопытки;
М("DCP.EQUAL.OTHER", ЗначениеСравнения);

АнглийскоеИмя = "ERROR";
Попытка
	Если New DataCompositionParameter("Период") = ПараметрПериод Тогда
		АнглийскоеИмя = "OK";
	КонецЕсли;
Исключение
КонецПопытки;
М("DCP.ENGLISH", АнглийскоеИмя);
М("file.end", "data-composition-parameter-1");
