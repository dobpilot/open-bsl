// PLATFORM-ONLY: проба фиксирует достигнутую функцию подсчёта вхождений.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "str-occurrence-count-1");
М("STR.OCCURRENCE.REPEATED", СтрЧислоВхождений("абабаб", "аб"));
М("STR.OCCURRENCE.OVERLAP", СтрЧислоВхождений("аааа", "аа"));
М("STR.OCCURRENCE.OVERLAP.LONG", СтрЧислоВхождений("абабаба", "аба"));
М("STR.OCCURRENCE.EMPTY.HAYSTACK", СтрЧислоВхождений("", "а"));
М("STR.OCCURRENCE.EMPTY.NEEDLE", СтрЧислоВхождений("аб", ""));
М("STR.OCCURRENCE.CASE", СтрЧислоВхождений("АаА", "а"));
М("STR.OCCURRENCE.ENGLISH", StrOccurrenceCount("абаб", "аб"));
М("STR.OCCURRENCE.TYPE", ТипЗнч(СтрЧислоВхождений("аб", "а")));

ЧислоСтрока = "ERROR";
Попытка
	ЧислоСтрока = СтрЧислоВхождений(111, "1");
Исключение
КонецПопытки;
М("STR.OCCURRENCE.NUMBER.HAYSTACK", ЧислоСтрока);

СтрокаЧисло = "ERROR";
Попытка
	СтрокаЧисло = СтрЧислоВхождений("111", 1);
Исключение
КонецПопытки;
М("STR.OCCURRENCE.NUMBER.NEEDLE", СтрокаЧисло);

НеопределеноСтрока = "ERROR";
Попытка
	НеопределеноСтрока = СтрЧислоВхождений(Неопределено, "а");
Исключение
КонецПопытки;
М("STR.OCCURRENCE.UNDEFINED.HAYSTACK", НеопределеноСтрока);

МассивСтрока = "ERROR";
Попытка
	МассивСтрока = СтрЧислоВхождений(Новый Массив, "а");
Исключение
КонецПопытки;
М("STR.OCCURRENCE.ARRAY.HAYSTACK", МассивСтрока);
М("file.end", "str-occurrence-count-1");
