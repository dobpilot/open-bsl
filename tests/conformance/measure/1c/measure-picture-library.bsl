// PLATFORM-ONLY: проба фиксирует свойства значений стандартной библиотеки картинок.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "picture-library-1");
Картинка1 = БиблиотекаКартинок.Информация;
Картинка1Англ = PictureLib.Information;
Картинка2 = БиблиотекаКартинок.ДиалогИнформация;
М("PICTURE.TYPE", ТипЗнч(Картинка1));
М("PICTURE.STRING", Строка(Картинка1));
М("PICTURE.EQUAL.ALIAS", Картинка1 = Картинка1Англ);
М("PICTURE.EQUAL.DIFFERENT", Картинка1 = Картинка2);
М("PICTURE.FILLED", ЗначениеЗаполнено(Картинка1));
М("file.end", "picture-library-1");
