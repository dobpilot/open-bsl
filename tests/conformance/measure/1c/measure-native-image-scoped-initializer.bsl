// Нативная проверка результата закрытой функции и изменения параметра.
АргументПробы = 5;
Сообщить("image.native.local_function.enter=1");
Попытка
    РезультатПробы = ЗамерыТранзитивногоРодителя.Проба(АргументПробы);
    Сообщить("image.native.local_function.result=" + Строка(РезультатПробы));
    Сообщить("image.native.local_function.argument=" + Строка(АргументПробы));
Исключение
    Сообщить("image.native.local_function.failure=" + ОписаниеОшибки());
КонецПопытки;
Попытка
    РезультатВнешнейПробы = Вычислить("ЗамерыТранзитивногоРодителя.Изменить(АргументПробы)");
    Сообщить("image.native.local_function.private=CALLED");
Исключение
    Сообщить("image.native.local_function.private=ERROR");
КонецПопытки;
