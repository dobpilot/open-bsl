// Преобразование UTC в местное время через фиксированную и именованную зоны.

Процедура ПроверитьМестноеВремя(Имя, Условие)
    Если Условие Тогда
        Сообщить(Имя + Символ(9) + "PASS");
    Иначе
        Сообщить(Имя + Символ(9) + "FAIL");
    КонецЕсли;
КонецПроцедуры

ПроверитьМестноеВремя("GMT", МестноеВремя(Дата(2024, 1, 2, 9, 0, 0), "GMT+3") = Дата(2024, 1, 2, 12, 0, 0));
ПроверитьМестноеВремя("ALIAS", МестноеВремя(Дата(2024, 1, 2, 9, 0, 0), "GMT+3") = ToLocalTime(Дата(2024, 1, 2, 9, 0, 0), "GMT+3"));
ПроверитьМестноеВремя("DEFAULT", МестноеВремя(Дата(2024, 1, 2, 9, 0, 0)) = МестноеВремя(Дата(2024, 1, 2, 9, 0, 0), Неопределено));
ПроверитьМестноеВремя("MOSCOW", МестноеВремя(Дата(2024, 1, 2, 9, 0, 0), "Europe/Moscow") = Дата(2024, 1, 2, 12, 0, 0));

Попытка
    МестноеВремя(Дата(2024, 1, 2, 9, 0, 0), "Нет/ТакойЗоны");
    Сообщить("UNKNOWN" + Символ(9) + "FAIL");
Исключение
    Сообщить("UNKNOWN" + Символ(9) + "PASS");
КонецПопытки;

Попытка
    ПроверитьМестноеВремя("STRING", МестноеВремя("20240102090000", "GMT+3") = Дата(2024, 1, 2, 12, 0, 0));
Исключение
    Сообщить("STRING" + Символ(9) + "ERROR");
КонецПопытки;

Попытка
    МестноеВремя(Неопределено, "GMT+3");
    Сообщить("UNDEFINED" + Символ(9) + "VALUE");
Исключение
    Сообщить("UNDEFINED" + Символ(9) + "ERROR");
КонецПопытки;
