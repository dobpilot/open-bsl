// PLATFORM-ONLY: форма и тип результата списка допустимых часовых поясов.

Попытка
    Пояса = ПолучитьДопустимыеЧасовыеПояса();
    Результат0 = "OK:" + Строка(ТипЗнч(Пояса));
Исключение
    Результат0 = "ERROR:" + ОписаниеОшибки();
КонецПопытки;
Сообщить("ARITY_0" + Символ(9) + Результат0);

Попытка
    Пояса = Вычислить("ПолучитьДопустимыеЧасовыеПояса(1)");
    Результат1 = "OK";
Исключение
    Результат1 = "ERROR:" + ОписаниеОшибки();
КонецПопытки;
Сообщить("ARITY_1" + Символ(9) + Результат1);

Попытка
    ПоясаАнглийский = GetAvailableTimeZones();
    РезультатПсевдонима = "OK:" + Строка(ТипЗнч(ПоясаАнглийский));
Исключение
    РезультатПсевдонима = "ERROR:" + ОписаниеОшибки();
КонецПопытки;
Сообщить("ALIAS" + Символ(9) + РезультатПсевдонима);

Если Результат0 = "OK:Array" Тогда
    Сообщить("COUNT_POSITIVE" + Символ(9) + ?(Пояса.Количество() > 0, "Yes", "No"));
    Сообщить("MOSCOW" + Символ(9) + ?(Пояса.Найти("Europe/Moscow") <> Неопределено, "Yes", "No"));
КонецЕсли;
