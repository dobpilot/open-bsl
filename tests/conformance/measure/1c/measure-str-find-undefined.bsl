// Типы достигнутого вызова СтрНайти при запуске demo.
Процедура М(Ид, Значение)
    Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры
М("STRFIND.UNDEFINED.BEGIN", "1");
Попытка
    РезультатПробы = СтрНайти(Неопределено, "РежимОтладки");
Исключение
    РезультатПробы = "ERROR";
КонецПопытки;
М("STRFIND.UNDEFINED.TEXT", РезультатПробы);
Попытка
    РезультатПробы = СтрНайти("abc", Неопределено);
Исключение
    РезультатПробы = "ERROR";
КонецПопытки;
М("STRFIND.UNDEFINED.NEEDLE", РезультатПробы);
Попытка
    РезультатПробы = СтрНайти("abc", "");
Исключение
    РезультатПробы = "ERROR";
КонецПопытки;
М("STRFIND.COERCION.EMPTY.NEEDLE", РезультатПробы);
Попытка
