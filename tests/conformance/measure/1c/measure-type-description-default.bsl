// Значения по умолчанию от ОписаниеТипов.ПривестиЗначение().

Процедура Проверить(Ключ, Описание, ИмяТипа)
    Попытка
        РезультатПриведения = Описание.ПривестиЗначение();
        Если ТипЗнч(РезультатПриведения) = Тип(ИмяТипа) Тогда
            МеткаТипа = "PASS";
        ИначеЕсли ТипЗнч(РезультатПриведения) = Тип("Неопределено") Тогда
            МеткаТипа = "UNDEFINED";
        ИначеЕсли ТипЗнч(РезультатПриведения) = Тип("Число") Тогда
            МеткаТипа = "NUMBER";
        ИначеЕсли ТипЗнч(РезультатПриведения) = Тип("Строка") Тогда
            МеткаТипа = "STRING";
        Иначе
            МеткаТипа = "OTHER";
        КонецЕсли;
        Сообщить(Ключ + Символ(9) + МеткаТипа + "|" + XMLСтрока(РезультатПриведения));
    Исключение
        Сообщить(Ключ + Символ(9) + "<ошибка>");
    КонецПопытки;
КонецПроцедуры

Проверить("NUMBER", Новый ОписаниеТипов("Число"), "Число");
Проверить("STRING", Новый ОписаниеТипов("Строка"), "Строка");
Проверить("BOOLEAN", Новый ОписаниеТипов("Булево"), "Булево");
Проверить("DATE", Новый ОписаниеТипов("Дата"), "Дата");
Проверить("EMPTY", Новый ОписаниеТипов, "Неопределено");
Проверить("NUMBER_STRING", Новый ОписаниеТипов("Число,Строка"), "Число");
Проверить("STRING_NUMBER", Новый ОписаниеТипов("Строка,Число"), "Строка");
