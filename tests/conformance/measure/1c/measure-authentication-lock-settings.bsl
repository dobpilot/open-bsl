// PLATFORM-ONLY: проба фиксирует достигнутые настройки блокировки аутентификации.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "authentication-lock-settings-1");

М("AUTH.LOCK.MANAGER.TYPE", ТипЗнч(БлокировкаАутентификации));
Настройки = БлокировкаАутентификации.ПолучитьНастройки();
М("AUTH.LOCK.SETTINGS.TYPE", ТипЗнч(Настройки));
М("AUTH.LOCK.DURATION.TYPE", ТипЗнч(Настройки.ДлительностьБлокировки));
М("AUTH.LOCK.ATTEMPTS.TYPE", ТипЗнч(Настройки.МаксимальноеКоличествоНеуспешныхПопыток));
М("AUTH.LOCK.CODES.TYPE", ТипЗнч(Настройки.КодыДополненияИмениПользователя));

Настройки.ДлительностьБлокировки = 90;
Настройки.МаксимальноеКоличествоНеуспешныхПопыток = 7;
Настройки.КодыДополненияИмениПользователя = "x;y";
М("AUTH.LOCK.MUTATED", Строка(Настройки.ДлительностьБлокировки) + "|"
	+ Строка(Настройки.МаксимальноеКоличествоНеуспешныхПопыток) + "|"
	+ Настройки.КодыДополненияИмениПользователя);

АнглийскиеИмена = "ERROR";
Попытка
	English = AuthenticationLock.GetSettings();
	English.LockDuration = English.LockDuration;
	English.MaxUnsuccessfulAttemptsCount = English.MaxUnsuccessfulAttemptsCount;
	English.UserNameAdditionCodes = English.UserNameAdditionCodes;
	Если ТипЗнч(English) = ТипЗнч(Настройки) Тогда
		АнглийскиеИмена = "OK";
	КонецЕсли;
Исключение
КонецПопытки;
М("AUTH.LOCK.ENGLISH", АнглийскиеИмена);

НеверноеЧисло = "ACCEPTED";
Попытка
	Настройки.ДлительностьБлокировки = "90";
Исключение
	НеверноеЧисло = "ERROR";
КонецПопытки;
М("AUTH.LOCK.BAD.NUMBER", НеверноеЧисло);
М("AUTH.LOCK.BAD.NUMBER.VALUE", Строка(ТипЗнч(Настройки.ДлительностьБлокировки)) + "|" + Строка(Настройки.ДлительностьБлокировки));

НевернаяСтрока = "ACCEPTED";
Попытка
	Настройки.КодыДополненияИмениПользователя = 1;
Исключение
	НевернаяСтрока = "ERROR";
КонецПопытки;
М("AUTH.LOCK.BAD.STRING", НевернаяСтрока);
М("AUTH.LOCK.BAD.STRING.VALUE", Строка(ТипЗнч(Настройки.КодыДополненияИмениПользователя)) + "|" + Настройки.КодыДополненияИмениПользователя);

М("file.end", "authentication-lock-settings-1");
