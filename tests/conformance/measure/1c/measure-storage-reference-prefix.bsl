Попытка
    ИдентификаторПробы = Новый УникальныйИдентификатор("12345678-1234-4321-abcd-0123456789ab");
    СсылкаПробы = Вычислить("Справочники.ЗамерВременныхТаблиц.ПолучитьСсылку(ИдентификаторПробы)");
    ИсходныйТекстПробы = ЗначениеВСтрокуВнутр(СсылкаПробы);
    Сообщить("storage.prefix.source=" + ИсходныйТекстПробы);
    Если СтрНайти(ИсходныйТекстПробы, ",53:") = 0 Тогда
        ВызватьИсключение "Исходный префикс отличается от контрольного";
    КонецЕсли;
    ПрефиксыПробы = Новый Массив;
    ПрефиксыПробы.Добавить("0");
    ПрефиксыПробы.Добавить("8");
    ПрефиксыПробы.Добавить("53");
    ПрефиксыПробы.Добавить("54");
    ПрефиксыПробы.Добавить("999999");
    ПрефиксыПробы.Добавить("-1");
    ПрефиксыПробы.Добавить("text");
    ПрефиксыПробы.Добавить("");
    ПрефиксыПробы.Добавить("4294967296");
    ПрефиксыПробы.Добавить("+1");
    ПрефиксыПробы.Добавить("1.5");
    ПрефиксыПробы.Добавить("1e2");
    ПрефиксыПробы.Добавить("00053");
    Для Каждого ПрефиксПробы Из ПрефиксыПробы Цикл
        Попытка
            ИзмененныйТекстПробы = СтрЗаменить(ИсходныйТекстПробы, "53:", ПрефиксПробы + ":");
            ВосстановленноеПробы = ЗначениеИзСтрокиВнутр(ИзмененныйТекстПробы);
            РезультатПробы = Строка(ВосстановленноеПробы = СсылкаПробы) + ":" + Строка(ТипЗнч(ВосстановленноеПробы) = ТипЗнч(СсылкаПробы));
        Исключение
            РезультатПробы = "ERROR";
        КонецПопытки;
        Сообщить("storage.prefix." + ПрефиксПробы + "=" + РезультатПробы);
    КонецЦикла;
Исключение
    Сообщить("storage.prefix.setup=ERROR");
КонецПопытки;
