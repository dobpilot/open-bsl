// PLATFORM-ONLY: пропуски позиций у трёх ядровых приёмников `Вставить`.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "insert-omissions-1");

МассивПробы = Новый Массив;
МассивПробы.Добавить(10);
Результат = "OK";
Попытка
	МассивПробы.Вставить(, 20);
Исключение
	Результат = "ERROR";
КонецПопытки;
М("ARRAY.FIRST", Результат);

Результат = "OK";
Попытка
	МассивПробы.Вставить(0, );
Исключение
	Результат = "ERROR";
КонецПопытки;
Если МассивПробы[0] = Неопределено Тогда
	Результат = Результат + ":UNDEFINED";
Иначе
	Результат = Результат + ":OTHER";
КонецЕсли;
М("ARRAY.SECOND", Результат);

СоответствиеПробы = Новый Соответствие;
Результат = "OK";
Попытка
	СоответствиеПробы.Вставить(, 20);
Исключение
	Результат = "ERROR";
КонецПопытки;
М("MAP.FIRST", Результат);

Результат = "OK";
Попытка
	СоответствиеПробы.Вставить("К", );
Исключение
	Результат = "ERROR";
КонецПопытки;
Если СоответствиеПробы.Получить("К") = Неопределено Тогда
	Результат = Результат + ":UNDEFINED";
Иначе
	Результат = Результат + ":OTHER";
КонецЕсли;
М("MAP.SECOND", Результат);

СтруктураПробы = Новый Структура;
Результат = "OK";
Попытка
	СтруктураПробы.Вставить(, 20);
Исключение
	Результат = "ERROR";
КонецПопытки;
М("STRUCTURE.FIRST", Результат);

Результат = "OK";
Попытка
	СтруктураПробы.Вставить("К", );
Исключение
	Результат = "ERROR";
КонецПопытки;
Если СтруктураПробы.К = Неопределено Тогда
	Результат = Результат + ":UNDEFINED";
Иначе
	Результат = Результат + ":OTHER";
КонецЕсли;
М("STRUCTURE.SECOND", Результат);

М("file.end", "insert-omissions-1");
