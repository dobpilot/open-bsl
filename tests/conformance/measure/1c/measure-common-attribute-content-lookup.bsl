// PLATFORM-ONLY: варианты поиска в полном составе общего реквизита.
Процедура М(Ид, Значение)
    Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция ПробаПоиска(ВыражениеПробы)
    Попытка
        Возврат Строка(Вычислить(ВыражениеПробы));
    Исключение
        Возврат "error";
    КонецПопытки;
КонецФункции

М("file.begin", "common-attribute-content-lookup-3");
М("CONTENT_LOOKUP.SHORT_FOLDED", ПробаПоиска("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Find(""зАмЕрВрЕмЕнНыХтАбЛиЦ"").Metadata = Метаданные.Справочники.ЗамерВременныхТаблиц"));
М("CONTENT_LOOKUP.FULL_RUSSIAN", ПробаПоиска("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Find(""Справочник.ЗамерВременныхТаблиц"") = Неопределено"));
М("CONTENT_LOOKUP.FULL_ENGLISH", ПробаПоиска("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Find(""Catalog.ЗамерВременныхТаблиц"") = Неопределено"));
М("CONTENT_LOOKUP.EMPTY_STRING", ПробаПоиска("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Find("""") = Неопределено"));
М("CONTENT_LOOKUP.ABSENT_METADATA", ПробаПоиска("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Find(Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1) = Неопределено"));
М("CONTENT_LOOKUP.CONSTANT_METADATA", ПробаПоиска("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Find(Метаданные.Константы.ЗначениеОпцииПробы).Use"));
М("CONTENT_LOOKUP.CONTAINS_NUMBER", ПробаПоиска("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Contains(1)"));
М("CONTENT_LOOKUP.CONTAINS_BOOLEAN", ПробаПоиска("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Contains(Истина)"));
М("CONTENT_LOOKUP.CONTAINS_ABSENT_METADATA", ПробаПоиска("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Contains(Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1)"));
М("CONTENT_LOOKUP.TYPE_COLLECTION_RU", ПробаПоиска("Тип(""СоставОбщегоРеквизита"") = ТипЗнч(Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content)"));
М("CONTENT_LOOKUP.TYPE_COLLECTION_EN", ПробаПоиска("Тип(""CommonAttributeContent"") = ТипЗнч(Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content)"));
М("CONTENT_LOOKUP.TYPE_ITEM_RU", ПробаПоиска("Тип(""ЭлементСоставаОбщегоРеквизита"") = ТипЗнч(Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Find(Метаданные.Справочники.ЗамерВременныхТаблиц))"));
М("CONTENT_LOOKUP.TYPE_ITEM_EN", ПробаПоиска("Тип(""CommonAttributeContentItem"") = ТипЗнч(Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Find(Метаданные.Справочники.ЗамерВременныхТаблиц))"));
РавенствоЭлементовПробы = "missing";
Попытка
    Для Каждого ЭлементПробы Из Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content Цикл
        Если ЭлементПробы.Metadata = Метаданные.Справочники.ЗамерВременныхТаблиц Тогда
            РавенствоЭлементовПробы = Строка(ЭлементПробы = Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Find(ЭлементПробы.Metadata));
        КонецЕсли;
    КонецЦикла;
Исключение
    РавенствоЭлементовПробы = "error";
КонецПопытки;
М("CONTENT_LOOKUP.ITEM_IDENTITY", РавенствоЭлементовПробы);
ОшибкаАрностиПробы = "accepted";
Попытка
    Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Contains();
Исключение
    ОшибкаАрностиПробы = ОписаниеОшибки();
КонецПопытки;
М("CONTENT_LOOKUP.CONTAINS_EMPTY_REASON", ОшибкаАрностиПробы);
ОшибкаПоискаПробы = "accepted";
Попытка
    Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Find();
Исключение
    ОшибкаПоискаПробы = ОписаниеОшибки();
КонецПопытки;
М("CONTENT_LOOKUP.FIND_EMPTY_REASON", ОшибкаПоискаПробы);
М("file.end", "common-attribute-content-lookup-3");
