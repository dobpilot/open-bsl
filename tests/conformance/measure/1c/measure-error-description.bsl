// PLATFORM-ONLY: текст текущей ошибки внутри и вне обработчика.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция Проба(Выражение)
	Попытка
		Возврат Строка(Вычислить(Выражение));
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
КонецФункции

М("file.begin", "error-description-1");
М("ERROR.DESCRIPTION.OUTSIDE", Проба("ОписаниеОшибки()"));
М("ERROR.DESCRIPTION.ENGLISH", Проба("ErrorDescription()"));
М("ERROR.DESCRIPTION.ONE", Проба("ОписаниеОшибки(1)"));
Попытка
	ВызватьИсключение "маркер ошибки";
Исключение
	М("ERROR.DESCRIPTION.INSIDE", ОписаниеОшибки());
КонецПопытки;
М("ERROR.DESCRIPTION.AFTER", Проба("ОписаниеОшибки()"));
Попытка
	ВызватьИсключение "внешняя ошибка";
Исключение
	М("ERROR.DESCRIPTION.OUTER.BEFORE", ОписаниеОшибки());
	Попытка
		ВызватьИсключение "внутренняя ошибка";
	Исключение
		М("ERROR.DESCRIPTION.INNER", ОписаниеОшибки());
	КонецПопытки;
	М("ERROR.DESCRIPTION.OUTER.AFTER", ОписаниеОшибки());
КонецПопытки;
М("file.end", "error-description-1");
