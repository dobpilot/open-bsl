// Сквозное выравнивание элементов формы в серверном контексте.

Процедура ПроверитьЧлен(Ключ, Значение, Псевдоним)
    Если Значение = Псевдоним Тогда
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "PASS");
    Иначе
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "FAIL");
    КонецЕсли;
КонецПроцедуры

ПроверитьЧлен("AUTO", СквозноеВыравнивание.Авто, ThroughAlign.Auto);
ПроверитьЧлен("USE", СквозноеВыравнивание.Использовать, ThroughAlign.Use);
ПроверитьЧлен("DONT_USE", СквозноеВыравнивание.НеИспользовать, ThroughAlign.DontUse);
Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(СквозноеВыравнивание.Авто)));
