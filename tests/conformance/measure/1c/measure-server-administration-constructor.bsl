// Создание объекта не вызывает методов администрирования кластера.
Функция КонструкторПробы(ВыражениеПробы)
    Попытка
        ОбъектПробы = Вычислить(ВыражениеПробы);
        Возврат "OK:" + Строка(ТипЗнч(ОбъектПробы));
    Исключение
        Возврат "ERROR";
    КонецПопытки;
КонецФункции
Сообщить("ras.constructor.default=" + КонструкторПробы("Новый АдминистрированиеСервера()"));
Сообщить("ras.constructor.address=" + КонструкторПробы("Новый АдминистрированиеСервера(""127.0.0.1"")"));
Сообщить("ras.constructor.port=" + КонструкторПробы("Новый АдминистрированиеСервера(""127.0.0.1"", 1545)"));
Сообщить("ras.constructor.alias=" + КонструкторПробы("Новый ServerAdministration()"));
Сообщить("ras.constructor.too_many=" + КонструкторПробы("Новый АдминистрированиеСервера(""127.0.0.1"", 1545, 1)"));
