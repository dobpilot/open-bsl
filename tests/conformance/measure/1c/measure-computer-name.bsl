// Печатаем свойства сетевого имени, не раскрывая само имя машины.

Попытка
	ИмяИзРусскогоВызова = ИмяКомпьютера();
	ИмяИзАнглийскогоВызова = ComputerName();
	Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(ИмяИзРусскогоВызова)));
	Сообщить("NONEMPTY" + Символ(9) + Строка(СтрДлина(ИмяИзРусскогоВызова) > 0));
	Сообщить("ALIASES_EQUAL" + Символ(9) + Строка(ИмяИзРусскогоВызова = ИмяИзАнглийскогоВызова));
Исключение
	Сообщить("ERROR" + Символ(9) + "YES");
КонецПопытки;
