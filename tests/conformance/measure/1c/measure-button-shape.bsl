// Фигура кнопки в серверном контексте.

Процедура ПроверитьЧлен(Ключ, Значение, Псевдоним)
    Если Значение = Псевдоним Тогда
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "PASS");
    Иначе
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "FAIL");
    КонецЕсли;
КонецПроцедуры

ПроверитьЧлен("AUTO", ФигураКнопки.Авто, ButtonShape.Auto);
ПроверитьЧлен("USUAL", ФигураКнопки.Обычная, ButtonShape.Usual);
ПроверитьЧлен("OVAL", ФигураКнопки.Овал, ButtonShape.Oval);
Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(ФигураКнопки.Авто)));
