// PLATFORM-ONLY: проба записывает два служебных события в журнал одноразовой
// измерительной информационной базы.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "event-log-1");

М("EVENT_LOG.LEVEL.META", ТипЗнч(УровеньЖурналаРегистрации));
М("EVENT_LOG.LEVEL.NOTE", Строка(ТипЗнч(УровеньЖурналаРегистрации.Примечание))
	+ ":" + Строка(УровеньЖурналаРегистрации.Примечание));
М("EVENT_LOG.LEVEL.INFORMATION", Строка(ТипЗнч(УровеньЖурналаРегистрации.Информация))
	+ ":" + Строка(УровеньЖурналаРегистрации.Информация));
М("EVENT_LOG.LEVEL.WARNING", Строка(ТипЗнч(УровеньЖурналаРегистрации.Предупреждение))
	+ ":" + Строка(УровеньЖурналаРегистрации.Предупреждение));
М("EVENT_LOG.LEVEL.ERROR", Строка(ТипЗнч(УровеньЖурналаРегистрации.Ошибка))
	+ ":" + Строка(УровеньЖурналаРегистрации.Ошибка));
М("EVENT_LOG.TRANSACTION_MODE.META", ТипЗнч(РежимТранзакцииЗаписиЖурналаРегистрации));
М("EVENT_LOG.TRANSACTION_MODE.INDEPENDENT",
	Строка(ТипЗнч(РежимТранзакцииЗаписиЖурналаРегистрации.Независимая))
	+ ":" + Строка(РежимТранзакцииЗаписиЖурналаРегистрации.Независимая));
М("EVENT_LOG.TRANSACTION_MODE.TRANSACTIONAL",
	Строка(ТипЗнч(РежимТранзакцииЗаписиЖурналаРегистрации.Транзакционная))
	+ ":" + Строка(РежимТранзакцииЗаписиЖурналаРегистрации.Транзакционная));

РезультатМинимальногоВызова = "ok";
Попытка
	ЗаписьЖурналаРегистрации("open-bsl.measure.minimal");
Исключение
	РезультатМинимальногоВызова = "error:" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
КонецПопытки;
М("EVENT_LOG.WRITE.MINIMAL", РезультатМинимальногоВызова);

РезультатПятиАргументов = "ok";
Попытка
	WriteLogEvent("open-bsl.measure.error", EventLogLevel.Error, , , "probe comment");
Исключение
	РезультатПятиАргументов = "error:" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
КонецПопытки;
М("EVENT_LOG.WRITE.FIVE_ARGUMENTS", РезультатПятиАргументов);

РезультатШестиАргументов = "ok";
Попытка
	ЗаписьЖурналаРегистрации("open-bsl.measure.transaction", , , , ,
		РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
Исключение
	РезультатШестиАргументов = "error:" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
КонецПопытки;
М("EVENT_LOG.WRITE.SIX_ARGUMENTS", РезультатШестиАргументов);

М("file.end", "event-log-1");
