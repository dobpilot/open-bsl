// Подготовка записывает только отдельную файловую базу замера.
Попытка
    ЭлементПервыйПробы = Справочники.ЗамерВременныхТаблиц.СоздатьЭлемент();
    ЭлементПервыйПробы.Код = "002";
    ЭлементПервыйПробы.Наименование = "Alpha";
    ЭлементПервыйПробы.Записать();
    ЭлементВторойПробы = Справочники.ЗамерВременныхТаблиц.СоздатьЭлемент();
    ЭлементВторойПробы.Код = "001";
    ЭлементВторойПробы.Наименование = "Zulu";
    ЭлементВторойПробы.ПометкаУдаления = Истина;
    ЭлементВторойПробы.Записать();
Исключение
    Сообщить("selection.setup.error=" + ОписаниеОшибки());
КонецПопытки;

// Начало проверяемого контракта выборки.
Попытка
    ВыборкаПробы = Вычислить("Справочники.ЗамерВременныхТаблиц.Выбрать()");
    Сообщить("selection.before.code=[" + ВыборкаПробы.Код + "]");
    Сообщить("selection.before.description=[" + ВыборкаПробы.Наименование + "]");
    Сообщить("selection.before.code.type=" + ?(ТипЗнч(ВыборкаПробы.Код) = Тип("Неопределено"), "YES", "NO"));
    Сообщить("selection.before.description.type=" + ?(ТипЗнч(ВыборкаПробы.Наименование) = Тип("Неопределено"), "YES", "NO"));
    Сообщить("selection.before.deletion.type=" + ?(ТипЗнч(ВыборкаПробы.ПометкаУдаления) = Тип("Неопределено"), "YES", "NO"));
    Пока ВыборкаПробы.Следующий() Цикл
        Сообщить("selection.row=" + ВыборкаПробы.Код + ":" + ВыборкаПробы.Наименование + ":" + ?(ВыборкаПробы.ПометкаУдаления, "YES", "NO"));
        Сообщить("selection.row.ref=" + ?(ТипЗнч(ВыборкаПробы.Ссылка) = Тип("СправочникСсылка.ЗамерВременныхТаблиц") И Не ВыборкаПробы.Ссылка.Пустая(), "YES", "NO"));
    КонецЦикла;
    Сообщить("selection.after.description=[" + ВыборкаПробы.Description + "]");
    Сообщить("selection.after.again=" + ?(ВыборкаПробы.Next(), "YES", "NO"));
    Сообщить("selection.restart.description=[" + ВыборкаПробы.Description + "]");
    Сообщить("selection.restart.second=" + ?(ВыборкаПробы.Next(), "YES", "NO"));
    Сообщить("selection.restart.second.description=[" + ВыборкаПробы.Description + "]");
    Сообщить("selection.restart.end=" + ?(ВыборкаПробы.Next(), "YES", "NO"));
    Сообщить("selection.restart.again=" + ?(ВыборкаПробы.Next(), "YES", "NO"));
    Сообщить("selection.restart.again.description=[" + ВыборкаПробы.Description + "]");
    ВыборкаПробы = Справочники.ЗамерВременныхТаблиц.Выбрать(,,, "Наименование Убыв");
    Пока ВыборкаПробы.Следующий() Цикл
        Сообщить("selection.desc=" + ВыборкаПробы.Наименование);
    КонецЦикла;
    ВыборкаПробы = Справочники.ЗамерВременныхТаблиц.Выбрать(,,, "Наименование Wrong");
    Пока ВыборкаПробы.Следующий() Цикл
        Сообщить("selection.unknown.direction=" + ВыборкаПробы.Наименование);
    КонецЦикла;
    ВыборкаПробы = Справочники.ЗамерВременныхТаблиц.Выбрать(,, Новый Структура("Код", "002"));
    Пока ВыборкаПробы.Следующий() Цикл
        Сообщить("selection.filter=" + ВыборкаПробы.Наименование);
    КонецЦикла;
Исключение
    Сообщить("selection.error=" + ОписаниеОшибки());
КонецПопытки;
