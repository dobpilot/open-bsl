// PLATFORM-ONLY: доступность типа идентификатора без подключения сервиса.
Процедура М(Ид, Значение)
    Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "collaboration-conversation-type-1");
Попытка
    ТипРусскийПробы = Тип("ИдентификаторОбсужденияСистемыВзаимодействия");
    РезультатРусскийПробы = Строка(ТипРусскийПробы);
Исключение
    РезультатРусскийПробы = "ERROR:" + ОписаниеОшибки();
КонецПопытки;
М("COLLABORATION_CONVERSATION_TYPE.RUSSIAN", РезультатРусскийПробы);
Попытка
    ТипАнглийскийПробы = Тип("CollaborationSystemConversationID");
    РезультатАнглийскийПробы = Строка(ТипАнглийскийПробы);
    РезультатРавенствоПробы = ТипАнглийскийПробы = ТипРусскийПробы;
Исключение
    РезультатАнглийскийПробы = "ERROR:" + ОписаниеОшибки();
    РезультатРавенствоПробы = "ERROR";
КонецПопытки;
М("COLLABORATION_CONVERSATION_TYPE.ENGLISH", РезультатАнглийскийПробы);
М("COLLABORATION_CONVERSATION_TYPE.EQUAL", РезультатРавенствоПробы);
М("file.end", "collaboration-conversation-type-1");
