// Проба фиксирует минимальный линейный контракт `Запрос`, нужный
// конфигурационному runtime. Она не читает таблицы конфигурации и потому
// одинаково воспроизводима в одноразовой базе платформы.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "query-linear-result-1");

ЗапросПробы = Новый Запрос;
М("QUERY.TYPE", Строка(ТипЗнч(ЗапросПробы)));
М("QUERY.DEFAULT_TEXT", "[" + ЗапросПробы.Текст + "]");

ЗапросПробы.Текст = "ВЫБРАТЬ &Значение КАК Значение";
ЗапросПробы.УстановитьПараметр("Значение", 1);
ЗапросПробы.УстановитьПараметр("Значение", 42);
РезультатПробы = ЗапросПробы.Выполнить();

М("QUERY.RESULT.TYPE", Строка(ТипЗнч(РезультатПробы)));
М("QUERY.RESULT.EMPTY", РезультатПробы.Пустой());

ВыборкаПробы = РезультатПробы.Выбрать();
М("QUERY.SELECTION.TYPE", Строка(ТипЗнч(ВыборкаПробы)));
М("QUERY.SELECTION.NEXT_FIRST", ВыборкаПробы.Следующий());
М("QUERY.SELECTION.FIELD", ВыборкаПробы.Значение);
М("QUERY.SELECTION.GET", ВыборкаПробы.Получить(0));
М("QUERY.SELECTION.NEXT_END", ВыборкаПробы.Следующий());

ТаблицаПробы = РезультатПробы.Выгрузить();
М("QUERY.UNLOAD.TYPE", Строка(ТипЗнч(ТаблицаПробы)));
М("QUERY.UNLOAD.COUNT", ТаблицаПробы.Количество());
М("QUERY.UNLOAD.FIELD", ТаблицаПробы[0].Значение);

М("file.end", "query-linear-result-1");
