// PLATFORM-ONLY: прямой замер общего модуля как результата Вычислить.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция ДождатьсяЗавершения(Задание)
	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 30000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Свежее = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
			Задание.УникальныйИдентификатор);
		Если Свежее = Неопределено
			Или Свежее.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
			Возврат Свежее;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

М("file.begin", "dynamic-common-module-value-1");
Результат = "";
Попытка
	Задание = ФоновыеЗадания.Выполнить("ЗамерыДинамическогоМодуля.Проверить");
	Итог = ДождатьсяЗавершения(Задание);
	Если Итог = Неопределено Тогда
		Результат = "нет задания";
	ИначеЕсли Итог.ИнформацияОбОшибке = Неопределено Тогда
		Результат = Строка(Итог.Состояние) + "|ok";
	Иначе
		Результат = Строка(Итог.Состояние) + "|" + Итог.ИнформацияОбОшибке.Описание;
	КонецЕсли;
Исключение
	Результат = "ошибка: " + ОписаниеОшибки();
КонецПопытки;
М("DYNAMIC.MODULE.VALUE.PLATFORM", Результат);
М("file.end", "dynamic-common-module-value-1");
