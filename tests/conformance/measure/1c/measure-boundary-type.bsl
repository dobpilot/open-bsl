// Виды включения границы.

Сообщить("ROOT" + Символ(9) + Строка(ВидГраницы));
Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(ВидГраницы.Включая)));
Сообщить("INCLUDING" + Символ(9) + Строка(ВидГраницы.Включая));
Сообщить("EXCLUDING" + Символ(9) + Строка(ВидГраницы.Исключая));
Если ВидГраницы.Включая = BoundaryType.Including
    И ВидГраницы.Исключая = BoundaryType.Excluding Тогда
    Сообщить("ALIASES" + Символ(9) + "PASS");
Иначе
    Сообщить("ALIASES" + Символ(9) + "FAIL");
КонецЕсли;
