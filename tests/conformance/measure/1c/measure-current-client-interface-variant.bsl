Попытка
    АдресФоновойПробы = ПоместитьВоВременноеХранилище(Неопределено);
    ПараметрыФоновойПробы = Новый Массив;
    ПараметрыФоновойПробы.Добавить(АдресФоновойПробы);
    ЗаданиеФоновойПробы = ФоновыеЗадания.Выполнить(
        "ЗамерыФоновыхЗаданий.ВариантИнтерфейсаВХранилище", ПараметрыФоновойПробы);
    ЗаданиеФоновойПробы.ОжидатьЗавершенияВыполнения(30);
    СвежееЗаданиеПробы = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
        ЗаданиеФоновойПробы.УникальныйИдентификатор);
    Если СвежееЗаданиеПробы.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
        ПредставлениеФоновойПробы = ПолучитьИзВременногоХранилища(АдресФоновойПробы);
    Иначе
        ПредставлениеФоновойПробы = "ERROR";
    КонецЕсли;
Исключение
    ПредставлениеФоновойПробы = "ERROR";
КонецПопытки;
Сообщить("BACKGROUND" + Символ(9) + ПредставлениеФоновойПробы);

