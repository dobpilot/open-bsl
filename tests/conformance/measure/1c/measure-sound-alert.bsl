// Звуковые оповещения доставляемого уведомления в серверном контексте.

Процедура ПроверитьЧлен(Ключ, Значение, Псевдоним)
    Если Значение = Псевдоним Тогда
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "PASS");
    Иначе
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "FAIL");
    КонецЕсли;
КонецПроцедуры

ПроверитьЧлен("NONE", ЗвуковоеОповещение.Нет, SoundAlert.None);
ПроверитьЧлен("DEFAULT", ЗвуковоеОповещение.ПоУмолчанию, SoundAlert.Default);
Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(ЗвуковоеОповещение.Нет)));
