// PLATFORM-ONLY: поверхность состава общего реквизита в отдельной базе замера.
Процедура М(Ид, Значение)
 Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция ПробаСостава(ВыражениеПробы)
 Попытка
  Возврат Строка(Вычислить(ВыражениеПробы));
 Исключение
  Возврат "error";
 КонецПопытки;
КонецФункции

М("file.begin", "common-attribute-content-surface-1");
М("COMMON_CONTENT.TYPE", ПробаСостава("ТипЗнч(Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Состав)"));
М("COMMON_CONTENT.COUNT", ПробаСостава("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Count()"));
М("COMMON_CONTENT.INDEX", ПробаСостава("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Состав[0]"));
М("COMMON_CONTENT.GET", ПробаСостава("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Состав.Получить(0)"));
М("COMMON_CONTENT.FIND_OBJECT", ПробаСостава("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Состав.Найти(Метаданные.Справочники.ЗамерВременныхТаблиц).Метаданные.ПолноеИмя()"));
М("COMMON_CONTENT.FIND_FULL", ПробаСостава("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Состав.Найти(""Catalog.ЗамерВременныхТаблиц"").Метаданные.ПолноеИмя()"));
М("COMMON_CONTENT.FIND_SHORT", ПробаСостава("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Состав.Найти(""ЗамерВременныхТаблиц"") = Неопределено"));
М("COMMON_CONTENT.FIND_FOLDED", ПробаСостава("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Find(""cAtAlOg.замервременныхтаблиц"").Metadata.FullName()"));
М("COMMON_CONTENT.FIND_ABSENT", ПробаСостава("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Find(""Catalog.НетОбъекта"") = Неопределено"));
М("COMMON_CONTENT.FIND_EMPTY", ПробаСостава("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Find() = Неопределено"));
М("COMMON_CONTENT.FIND_UNDEFINED", ПробаСостава("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Find(Неопределено) = Неопределено"));
М("COMMON_CONTENT.FIND_NUMBER", ПробаСостава("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Find(1) = Неопределено"));
М("COMMON_CONTENT.CONTAINS_OBJECT", ПробаСостава("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Состав.Содержит(Метаданные.Справочники.ЗамерВременныхТаблиц)"));
М("COMMON_CONTENT.CONTAINS_FULL", ПробаСостава("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Contains(""Catalog.ЗамерВременныхТаблиц"")"));
М("COMMON_CONTENT.CONTAINS_SHORT", ПробаСостава("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Contains(""ЗамерВременныхТаблиц"")"));
М("COMMON_CONTENT.CONTAINS_ABSENT", ПробаСостава("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Contains(""Catalog.НетОбъекта"")"));
М("COMMON_CONTENT.CONTAINS_EMPTY", ПробаСостава("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Contains()"));
М("COMMON_CONTENT.CONTAINS_UNDEFINED", ПробаСостава("Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Content.Contains(Неопределено)"));
Попытка
 СоставПробы = Метаданные.ОбщиеРеквизиты.НаименованиеЯзык1.Состав;
 Для Каждого ЭлементПробы Из СоставПробы Цикл
  Если ЭлементПробы.Метаданные = Метаданные.Справочники.ЗамерВременныхТаблиц Тогда
   М("COMMON_CONTENT.ITEM_TYPE", ТипЗнч(ЭлементПробы));
   М("COMMON_CONTENT.ITEM_METADATA", ЭлементПробы.Metadata = ЭлементПробы.Метаданные);
   М("COMMON_CONTENT.ITEM_USE", ЭлементПробы.Use);
   М("COMMON_CONTENT.ITEM_CONDITION", ЭлементПробы.ConditionalSeparation = Метаданные.Константы.ЗначениеОпцииПробы);
   РезультатЗаписиПробы = "accepted";
   Попытка
    ЭлементПробы.Использование = Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Авто;
   Исключение
    РезультатЗаписиПробы = "error";
   КонецПопытки;
   М("COMMON_CONTENT.ITEM_WRITE", РезультатЗаписиПробы);
  КонецЕсли;
 КонецЦикла;
Исключение
 М("COMMON_CONTENT.ERROR", ОписаниеОшибки());
КонецПопытки;
М("file.end", "common-attribute-content-surface-1");
