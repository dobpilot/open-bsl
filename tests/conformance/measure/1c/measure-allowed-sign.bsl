// PLATFORM-ONLY: проба фиксирует полное перечисление допустимых знаков числа.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "allowed-sign-1");
М("ALLOWED.SIGN.ANY", ДопустимыйЗнак.Любой);
М("ALLOWED.SIGN.NONNEGATIVE", ДопустимыйЗнак.Неотрицательный);
М("ALLOWED.SIGN.TYPE", ТипЗнч(ДопустимыйЗнак.Любой));

АнглийскиеИмена = "ERROR";
Попытка
	Если AllowedSign.Any = ДопустимыйЗнак.Любой
		И AllowedSign.Nonnegative = ДопустимыйЗнак.Неотрицательный Тогда
		АнглийскиеИмена = "OK";
	КонецЕсли;
Исключение
КонецПопытки;
М("ALLOWED.SIGN.ENGLISH", АнглийскиеИмена);
М("file.end", "allowed-sign-1");
