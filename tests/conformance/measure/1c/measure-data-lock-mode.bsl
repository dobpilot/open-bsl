// PLATFORM-ONLY: проба фиксирует полное перечисление режимов блокировки данных.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "data-lock-mode-1");
М("DATA.LOCK.MODE.SHARED", РежимБлокировкиДанных.Разделяемый);
М("DATA.LOCK.MODE.EXCLUSIVE", РежимБлокировкиДанных.Исключительный);
М("DATA.LOCK.MODE.TYPE", ТипЗнч(РежимБлокировкиДанных.Разделяемый));

АнглийскиеИмена = "ERROR";
Попытка
	Если DataLockMode.Shared = РежимБлокировкиДанных.Разделяемый
		И DataLockMode.Exclusive = РежимБлокировкиДанных.Исключительный Тогда
		АнглийскиеИмена = "OK";
	КонецЕсли;
Исключение
КонецПопытки;
М("DATA.LOCK.MODE.ENGLISH", АнглийскиеИмена);
М("file.end", "data-lock-mode-1");
