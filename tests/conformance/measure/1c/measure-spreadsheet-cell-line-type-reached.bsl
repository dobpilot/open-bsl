// Виды линий ячеек, достигнутые в исходниках УНФ.

Процедура ПроверитьЧлен(Ключ, Значение, Псевдоним)
    Если Значение = Псевдоним Тогда
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "PASS");
    Иначе
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "FAIL");
    КонецЕсли;
КонецПроцедуры

ПроверитьЧлен("LARGE", ТипЛинииЯчейкиТабличногоДокумента.БольшойПунктир, SpreadsheetDocumentCellLineType.LargeDashed);
ПроверитьЧлен("DOUBLE", ТипЛинииЯчейкиТабличногоДокумента.Двойная, SpreadsheetDocumentCellLineType.Double);
ПроверитьЧлен("NONE", ТипЛинииЯчейкиТабличногоДокумента.НетЛинии, SpreadsheetDocumentCellLineType.None);
ПроверитьЧлен("THIN", ТипЛинииЯчейкиТабличногоДокумента.РедкийПунктир, SpreadsheetDocumentCellLineType.ThinDashed);
ПроверитьЧлен("SOLID", ТипЛинииЯчейкиТабличногоДокумента.Сплошная, SpreadsheetDocumentCellLineType.Solid);
ПроверитьЧлен("DOTTED", ТипЛинииЯчейкиТабличногоДокумента.Точечная, SpreadsheetDocumentCellLineType.Dotted);
Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(ТипЛинииЯчейкиТабличногоДокумента.Сплошная)));
