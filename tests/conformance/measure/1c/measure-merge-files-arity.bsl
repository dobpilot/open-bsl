Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция Проба(Команда)
	Попытка
		Выполнить(Команда);
		Возврат "OK";
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
КонецФункции

М("file.begin", "merge-files-arity-1");
М("MERGE.FILES.ZERO", Проба("ОбъединитьФайлы()"));
М("MERGE.FILES.ONE", Проба("ОбъединитьФайлы(Неопределено)"));
М("MERGE.FILES.TWO", Проба("ОбъединитьФайлы(Неопределено, Неопределено)"));
М("MERGE.FILES.THREE", Проба("ОбъединитьФайлы(Неопределено, Неопределено, Неопределено)"));
М("MERGE.FILES.ENGLISH", Проба("MergeFiles(Undefined, Undefined)"));
М("file.end", "merge-files-arity-1");
