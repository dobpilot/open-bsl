# Минимальный справочник нужен пробам временных таблиц и ссылок менеджера.
# Запускайте её на отдельной `ONEC_IB`, чтобы состав остальных баз замеров
# не зависел от уже загруженных дополнительных объектов.
copy-tree tests/conformance/measure/1c/cfg-src-temp-tables
child Catalog ЗамерВременныхТаблиц
mkdir Catalogs/ЗамерВременныхТаблиц/Ext
copy tests/conformance/measure/1c/catalog-predefined-items.xml Catalogs/ЗамерВременныхТаблиц/Ext/Predefined.xml
copy tests/conformance/measure/1c/catalog-predefined-manager.bsl Catalogs/ЗамерВременныхТаблиц/Ext/ManagerModule.bsl
sed Catalogs/ЗамерВременныхТаблиц.xml s|<PredefinedDataUpdate>Auto</PredefinedDataUpdate>|<PredefinedDataUpdate>DontAutoUpdate</PredefinedDataUpdate>|
