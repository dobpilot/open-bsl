// Число сеанса не выводим: проверяем только тип и отношение к объекту сеанса.

Попытка
	НомерСеанса = Вычислить("НомерСеансаИнформационнойБазы()");
	НомерИзОбъекта = Вычислить("ПолучитьТекущийСеансИнформационнойБазы().НомерСеанса");
	Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(НомерСеанса)));
	Сообщить("POSITIVE" + Символ(9) + Строка(НомерСеанса > 0));
	Сообщить("MATCHES_OBJECT" + Символ(9) + Строка(НомерСеанса = НомерИзОбъекта));
Исключение
	Сообщить("ERROR" + Символ(9) + "YES");
КонецПопытки;
