Функция ПрямаяУсловнаяПроба(УсловиеПробы, ЧислительПробы, ЗнаменательПробы)
    Возврат ?(УсловиеПробы, ЧислительПробы, ?(ЧислительПробы < 0, ЧислительПробы, ЧислительПробы / ЗнаменательПробы));
КонецФункции

Попытка
    РезультатПробы = ЗамерыТранзитивногоРодителя.Проба(Истина, 12, 0);
    РезультатПрямойПробы = ПрямаяУсловнаяПроба(Истина, 12, 0);
    Сообщить("image.native.conditional_return.outer.result=" + Строка(РезультатПробы));
    Сообщить("image.native.conditional_return.outer.direct=" + Строка(?(РезультатПробы = РезультатПрямойПробы, 1, 0)));
Исключение
    Сообщить("image.native.conditional_return.outer.failure=" + ОписаниеОшибки());
КонецПопытки;
