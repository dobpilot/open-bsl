Перем СостояниеЧастиПриИнициализации;
Перем ЧастьВТелеМодуля;

Функция СравнитьЧастьИзТела() Экспорт
    Возврат ЧастьВТелеМодуля = Запасы;
КонецФункции

Функция КоличествоЧастиИзТела() Экспорт
    Возврат ЧастьВТелеМодуля.Количество();
КонецФункции

Функция ПрочитатьСостояниеЧасти() Экспорт
    Возврат СостояниеЧастиПриИнициализации;
КонецФункции

Попытка
    ЧастьВТелеМодуля = Запасы;
    СостояниеЧастиПриИнициализации = "count:" + Строка(Запасы.Количество());
    Попытка
        Запасы.Добавить();
        СостояниеЧастиПриИнициализации = СостояниеЧастиПриИнициализации + ":add-ok";
    Исключение
        СостояниеЧастиПриИнициализации = СостояниеЧастиПриИнициализации + ":add-error";
    КонецПопытки;
Исключение
    СостояниеЧастиПриИнициализации = "count-error";
КонецПопытки;
