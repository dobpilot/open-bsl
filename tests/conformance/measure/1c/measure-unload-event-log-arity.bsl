// PLATFORM-ONLY: неверный тип приемника предотвращает выгрузку и фиксирует только арность.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Значение);
КонецПроцедуры

Функция КлассОшибки(Код)
	Попытка
		Выполнить(Код);
		Возврат "unexpected-success";
	Исключение
		ОшибкаВызова = ОписаниеОшибки();
		Если СтрНайти(ОшибкаВызова, "Not enough actual parameters") > 0 Тогда Возврат "too-few"; КонецЕсли;
		Если СтрНайти(ОшибкаВызова, "Too many actual parameters") > 0 Тогда Возврат "too-many"; КонецЕсли;
		Если СтрНайти(ОшибкаВызова, "Type mismatch (parameter number '1')") > 0 Тогда Возврат "receiver-type"; КонецЕсли;
		Возврат "other";
	КонецПопытки;
КонецФункции

М("file.begin", "unload-event-log-arity-1");
М("EVENTLOG.ZERO", КлассОшибки("ВыгрузитьЖурналРегистрации()"));
М("EVENTLOG.ONE", КлассОшибки("ВыгрузитьЖурналРегистрации(Неопределено)"));
М("EVENTLOG.TWO", КлассОшибки("ВыгрузитьЖурналРегистрации(Неопределено, Неопределено)"));
М("EVENTLOG.THREE", КлассОшибки("ВыгрузитьЖурналРегистрации(Неопределено, Неопределено, Неопределено)"));
М("EVENTLOG.FOUR", КлассОшибки("ВыгрузитьЖурналРегистрации(Неопределено, Неопределено, Неопределено, Неопределено)"));
М("EVENTLOG.FIVE", КлассОшибки("ВыгрузитьЖурналРегистрации(Неопределено, Неопределено, Неопределено, Неопределено, Неопределено)"));
М("EVENTLOG.SIX", КлассОшибки("ВыгрузитьЖурналРегистрации(Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Неопределено)"));
М("file.end", "unload-event-log-arity-1");
