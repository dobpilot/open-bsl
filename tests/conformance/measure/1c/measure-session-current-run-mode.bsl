// PLATFORM-ONLY: проба выполняется в одноразовой базе 1С, потому что её цель
// должна работать внутри настоящего фонового задания платформы.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "session-current-run-mode-1");

Попытка
	Адрес = ПоместитьВоВременноеХранилище(Неопределено);
	ПараметрыПробыРежима = Новый Массив;
	ПараметрыПробыРежима.Добавить(Адрес);
	Задание = ФоновыеЗадания.Выполнить(
		"ЗамерыФоновыхЗаданий.РежимЗапускаВХранилище", ПараметрыПробыРежима);
	Задание.ОжидатьЗавершенияВыполнения(30);
	СвежееЗаданиеПробыРежима = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
		Задание.УникальныйИдентификатор);
	Если СвежееЗаданиеПробыРежима.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		М("SESSION.CURRENT_RUN_MODE.BACKGROUND", ПолучитьИзВременногоХранилища(Адрес));
	Иначе
		М("SESSION.CURRENT_RUN_MODE.BACKGROUND", "ошибка: " + СвежееЗаданиеПробыРежима.ИнформацияОбОшибке.Описание);
	КонецЕсли;
Исключение
	М("SESSION.CURRENT_RUN_MODE.BACKGROUND", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

М("file.end", "session-current-run-mode-1");
