// Все варианты вида флажка в серверном контексте.

Процедура ПроверитьЧлен(Ключ, Значение, Псевдоним)
    Если Значение = Псевдоним Тогда
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "PASS");
    Иначе
        Сообщить(Ключ + Символ(9) + Строка(Значение) + Символ(9) + "FAIL");
    КонецЕсли;
КонецПроцедуры

ПроверитьЧлен("AUTO", ВидФлажка.Авто, CheckBoxType.Auto);
ПроверитьЧлен("BOX", ВидФлажка.Флажок, CheckBoxType.CheckBox);
ПроверитьЧлен("SWITCH", ВидФлажка.Выключатель, CheckBoxType.Switch);
ПроверитьЧлен("TUMBLER", ВидФлажка.Тумблер, CheckBoxType.Tumbler);
Сообщить("TYPE" + Символ(9) + Строка(ТипЗнч(ВидФлажка.Авто)));
