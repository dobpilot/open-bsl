// PLATFORM-ONLY: неверные пути позволяют проверить арность без копирования файлов.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция Проба(Команда)
	Попытка
		Выполнить(Команда);
		Возврат "OK";
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
КонецФункции

М("file.begin", "copy-file-arity-1");
М("COPY.FILE.ZERO", Проба("КопироватьФайл()"));
М("COPY.FILE.ONE", Проба("КопироватьФайл(Неопределено)"));
М("COPY.FILE.TWO", Проба("КопироватьФайл(Неопределено, Неопределено)"));
М("COPY.FILE.THREE", Проба("КопироватьФайл(Неопределено, Неопределено, Неопределено)"));
М("COPY.FILE.ENGLISH", Проба("CopyFile(Undefined, Undefined)"));
М("file.end", "copy-file-arity-1");
