// PLATFORM-ONLY: фоновая часть должна выполняться внутри настоящего
// фонового задания платформы.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "current-infobase-session-1");

ТекущийСеансПробы = ПолучитьТекущийСеансИнформационнойБазы();
М("SESSION.INFOBASE.TYPE", Строка(ТипЗнч(ТекущийСеансПробы)));
М("SESSION.INFOBASE.FOREGROUND_JOB",
	Строка(ТипЗнч(ТекущийСеансПробы.ПолучитьФоновоеЗадание())));

Попытка
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено);
	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(АдресРезультата);
	ЗаданиеПробы = ФоновыеЗадания.Выполнить(
		"ЗамерыФоновыхЗаданий.КонтекстСеансаВХранилище", ПараметрыЗадания);
	ЗаданиеПробы.ОжидатьЗавершенияВыполнения(30);
	СвежийСнимокЗадания = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
		ЗаданиеПробы.УникальныйИдентификатор);
	Если СвежийСнимокЗадания.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		М("SESSION.INFOBASE.BACKGROUND_JOB",
			ПолучитьИзВременногоХранилища(АдресРезультата));
	Иначе
		М("SESSION.INFOBASE.BACKGROUND_JOB",
			"ошибка: " + СвежийСнимокЗадания.ИнформацияОбОшибке.Описание);
	КонецЕсли;
Исключение
	М("SESSION.INFOBASE.BACKGROUND_JOB", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

М("file.end", "current-infobase-session-1");
