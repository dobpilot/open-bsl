// PLATFORM-ONLY: проба арности снятия блокировок без ранее установленных блокировок.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция Проба(Команда)
	Попытка
		Выполнить(Команда);
		Возврат "OK";
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
КонецФункции

М("file.begin", "unlock-data-for-edit-arity-1");
М("UNLOCK.EDIT.ZERO", Проба("РазблокироватьДанныеДляРедактирования()"));
М("UNLOCK.EDIT.ONE", Проба("РазблокироватьДанныеДляРедактирования(Неопределено)"));
М("UNLOCK.EDIT.TWO", Проба("РазблокироватьДанныеДляРедактирования(Неопределено, Неопределено)"));
М("UNLOCK.EDIT.THREE", Проба("РазблокироватьДанныеДляРедактирования(Неопределено, Неопределено, Неопределено)"));
М("UNLOCK.EDIT.ENGLISH", Проба("UnlockDataForEdit()"));
М("file.end", "unlock-data-for-edit-arity-1");
