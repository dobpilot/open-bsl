// PLATFORM-ONLY: проба фиксирует достигнутую форму конструктора до её поддержки runtime.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "qualified-type-description-1");
КвалификаторСтроки = Новый КвалификаторыСтроки(20, ДопустимаяДлина.Фиксированная);
ОписаниеСтроки = Новый ОписаниеТипов("Строка", Неопределено, КвалификаторСтроки);
М("QUALIFIED.TYPE.TYPE", ТипЗнч(ОписаниеСтроки));
М("QUALIFIED.TYPE.CONTAINS", ОписаниеСтроки.СодержитТип(Тип("Строка")));
М("QUALIFIED.TYPE.COUNT", ОписаниеСтроки.Типы().Количество());

АнглийскиеИмена = "ERROR";
Попытка
	EnglishDescription = New TypeDescription("String", Undefined, New StringQualifiers(7, AllowedLength.Fixed));
	Если EnglishDescription.ContainsType(Type("String")) Тогда
		АнглийскиеИмена = "OK";
	КонецЕсли;
Исключение
КонецПопытки;
М("QUALIFIED.TYPE.ENGLISH", АнглийскиеИмена);

НевернаяПозиция = "OK";
Попытка
	ПробаНевернойПозиции = Новый ОписаниеТипов("Строка", Неопределено, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя));
Исключение
	НевернаяПозиция = "ERROR";
КонецПопытки;
М("QUALIFIED.TYPE.WRONG.POSITION", НевернаяПозиция);

НеверныйТип = "OK";
Попытка
	ПробаНеверногоТипа = Новый ОписаниеТипов("Строка", Неопределено, 1);
Исключение
	НеверныйТип = "ERROR";
КонецПопытки;
М("QUALIFIED.TYPE.WRONG.VALUE", НеверныйТип);
М("file.end", "qualified-type-description-1");
