// Значения по умолчанию и запись семи флагов IMAP-сообщения.

Функция Ф(Значение)
    Если Значение = Неопределено Тогда
        Возврат "U";
    КонецЕсли;
    Если ТипЗнч(Значение) <> Тип("Булево") Тогда
        Возврат "X";
    КонецЕсли;
    Если Значение Тогда
        Возврат "T";
    КонецЕсли;
    Возврат "F";
КонецФункции

Сообщить("START" + Символ(9) + "OK");
Попытка
ФлагиПочты1 = Новый ФлагиИнтернетПочтовогоСообщения;
Сообщить("TYPE" + Символ(9) + ?(ТипЗнч(ФлагиПочты1) = Тип("ФлагиИнтернетПочтовогоСообщения"), "OK", "OTHER"));
Сообщить("TYPE_DISPLAY" + Символ(9) + Строка(ТипЗнч(ФлагиПочты1)));
Сообщить("DEFAULT" + Символ(9) + Ф(ФлагиПочты1.Новое) + Ф(ФлагиПочты1.Отвеченное) + Ф(ФлагиПочты1.Отмененное) + Ф(ФлагиПочты1.Пересланное) + Ф(ФлагиПочты1.Помеченное) + Ф(ФлагиПочты1.Прочитанное) + Ф(ФлагиПочты1.Удаленное));

ФлагиПочты1.Отвеченное = Истина;
ФлагиПочты1.Отмененное = Истина;
ФлагиПочты1.Пересланное = Истина;
ФлагиПочты1.Помеченное = Истина;
ФлагиПочты1.Прочитанное = Истина;
ФлагиПочты1.Удаленное = Истина;
Сообщить("SET" + Символ(9) + Ф(ФлагиПочты1.Новое) + Ф(ФлагиПочты1.Отвеченное) + Ф(ФлагиПочты1.Отмененное) + Ф(ФлагиПочты1.Пересланное) + Ф(ФлагиПочты1.Помеченное) + Ф(ФлагиПочты1.Прочитанное) + Ф(ФлагиПочты1.Удаленное));

Попытка
    ФлагиПочты1.Новое = Истина;
    Сообщить("NEW_READ_ONLY" + Символ(9) + "WRITABLE");
Исключение
    Сообщить("NEW_READ_ONLY" + Символ(9) + "ERROR");
КонецПопытки;

ФлагиПочты2 = New InternetMailMessageFlags;
ФлагиПочты2.Seen = Истина;
Сообщить("ALIAS" + Символ(9) + Ф(ФлагиПочты2.Прочитанное) + Ф(ФлагиПочты2.Новое));
Попытка
    ФлагиПочты2.Seen = 1;
    Сообщить("NUMERIC_SET" + Символ(9) + Ф(ФлагиПочты2.Seen));
Исключение
    Сообщить("NUMERIC_SET" + Символ(9) + "ERROR");
КонецПопытки;
Попытка
    ФлагиПочты2.Seen = Неопределено;
    Сообщить("UNDEFINED_SET" + Символ(9) + Ф(ФлагиПочты2.Seen));
Исключение
    Сообщить("UNDEFINED_SET" + Символ(9) + "ERROR");
КонецПопытки;
Попытка
    ФлагиПочты2.Seen = "Да";
    Сообщить("STRING_SET" + Символ(9) + Ф(ФлагиПочты2.Seen));
Исключение
    Сообщить("STRING_SET" + Символ(9) + "ERROR");
КонецПопытки;
Исключение
    Сообщить("ERROR" + Символ(9) + ОписаниеОшибки());
КонецПопытки;
