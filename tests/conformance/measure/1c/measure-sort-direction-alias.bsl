// Английские имена членов `НаправлениеСортировки`. Печатается только то,
// разрешилось ли имя и в какой член: представление зависит от языка сеанса.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Значение);
КонецПроцедуры

Функция В(Выражение)
	Попытка
		Значение = Вычислить(Выражение);
		Если Значение = НаправлениеСортировки.Возр Тогда
			Возврат "Возр";
		ИначеЕсли Значение = НаправлениеСортировки.Убыв Тогда
			Возврат "Убыв";
		КонецЕсли;
		Возврат "other";
	Исключение
		Возврат "error";
	КонецПопытки;
КонецФункции

М("SORTDIR.ASC", В("НаправлениеСортировки.Asc"));
М("SORTDIR.ASCENDING", В("НаправлениеСортировки.Ascending"));
М("SORTDIR.DESC", В("НаправлениеСортировки.Desc"));
М("SORTDIR.DESCENDING", В("НаправлениеСортировки.Descending"));
М("SORTDIR.EN_ASCENDING", В("SortDirection.Ascending"));
