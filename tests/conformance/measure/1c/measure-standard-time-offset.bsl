// PLATFORM-ONLY: проба фиксирует достигнутую функцию стандартного смещения времени.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Зима = Дата(2024, 1, 15, 12, 0, 0);
Лето = Дата(2024, 7, 15, 12, 0, 0);

М("file.begin", "standard-time-offset-1");
М("TIME.STANDARD.GMT.PLUS", СмещениеСтандартногоВремени("GMT+3", Зима));
М("TIME.STANDARD.GMT.MINUS", СмещениеСтандартногоВремени("GMT-05:30", Зима));
М("TIME.STANDARD.GMT.ZERO", СмещениеСтандартногоВремени("GMT+0", Зима));
М("TIME.STANDARD.NEWYORK.WINTER", СмещениеСтандартногоВремени("America/New_York", Зима));
М("TIME.STANDARD.NEWYORK.SUMMER", СмещениеСтандартногоВремени("America/New_York", Лето));
М("TIME.STANDARD.BERLIN.WINTER", СмещениеСтандартногоВремени("Europe/Berlin", Зима));
М("TIME.STANDARD.BERLIN.SUMMER", СмещениеСтандартногоВремени("Europe/Berlin", Лето));
М("TIME.STANDARD.UNDEFINED.ZONE", СмещениеСтандартногоВремени(Неопределено, Зима));
М("TIME.STANDARD.OMITTED.DATE", СмещениеСтандартногоВремени("GMT+3"));
М("TIME.STANDARD.UNDEFINED.DATE", СмещениеСтандартногоВремени("GMT+3", Неопределено));
М("TIME.STANDARD.OMITTED.ALL", СмещениеСтандартногоВремени());
М("TIME.STANDARD.ENGLISH", StandardTimeOffset("GMT+3", Зима));
М("TIME.STANDARD.TYPE", ТипЗнч(СмещениеСтандартногоВремени("GMT+3", Зима)));

НеизвестнаяЗона = "ERROR";
Попытка
	НеизвестнаяЗона = СмещениеСтандартногоВремени("Invalid/Zone", Зима);
Исключение
КонецПопытки;
М("TIME.STANDARD.UNKNOWN.ZONE", НеизвестнаяЗона);

НеверныйТипЗоны = "ERROR";
Попытка
	НеверныйТипЗоны = СмещениеСтандартногоВремени(1, Зима);
Исключение
КонецПопытки;
М("TIME.STANDARD.BAD.ZONE.TYPE", НеверныйТипЗоны);

НеверныйТипДаты = "ERROR";
Попытка
	НеверныйТипДаты = СмещениеСтандартногоВремени("GMT+3", "20240115");
Исключение
КонецПопытки;
М("TIME.STANDARD.BAD.DATE.TYPE", НеверныйТипДаты);

СтроковаяДата = "ERROR";
Попытка
	СтроковаяДата = СмещениеСтандартногоВремени("America/New_York", "20240715120000");
Исключение
КонецПопытки;
М("TIME.STANDARD.STRING.DATE", СтроковаяДата);

НевернаяСтроковаяДата = "ERROR";
Попытка
	НевернаяСтроковаяДата = СмещениеСтандартногоВремени("America/New_York", "not-a-date");
Исключение
КонецПопытки;
М("TIME.STANDARD.BAD.STRING.DATE", НевернаяСтроковаяДата);

ЧисловаяДата = "ERROR";
Попытка
	ЧисловаяДата = СмещениеСтандартногоВремени("America/New_York", 1);
Исключение
КонецПопытки;
М("TIME.STANDARD.NUMBER.DATE", ЧисловаяДата);

МассивДата = "ERROR";
Попытка
	МассивДата = СмещениеСтандартногоВремени("America/New_York", Новый Массив);
Исключение
КонецПопытки;
М("TIME.STANDARD.ARRAY.DATE", МассивДата);
М("file.end", "standard-time-offset-1");
