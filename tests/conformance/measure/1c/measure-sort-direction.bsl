// Оба значения перечисления сортировки и их официальные английские имена.

Если НаправлениеСортировки.Возр = SortDirection.Asc Тогда
	Сообщить("ASC" + Символ(9) + "PASS");
Иначе
	Сообщить("ASC" + Символ(9) + "FAIL");
КонецЕсли;

Если НаправлениеСортировки.Убыв = SortDirection.Desc Тогда
	Сообщить("DESC" + Символ(9) + "PASS");
Иначе
	Сообщить("DESC" + Символ(9) + "FAIL");
КонецЕсли;

Если НаправлениеСортировки.Возр <> НаправлениеСортировки.Убыв Тогда
	Сообщить("DISTINCT" + Символ(9) + "PASS");
Иначе
	Сообщить("DISTINCT" + Символ(9) + "FAIL");
КонецЕсли;

Сообщить("ASC_TEXT" + Символ(9) + Строка(НаправлениеСортировки.Возр));
Сообщить("DESC_TEXT" + Символ(9) + Строка(НаправлениеСортировки.Убыв));
