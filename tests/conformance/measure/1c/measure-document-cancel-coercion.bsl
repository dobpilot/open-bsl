// PLATFORM-ONLY: приведение `Отказ` в `ОбработкаПроверкиЗаполнения` к булеву.
Значения = Новый Структура;
Значения.Вставить("true", Истина);
Значения.Вставить("false", Ложь);
Значения.Вставить("one", 1);
Значения.Вставить("zero", 0);
Значения.Вставить("fraction", 2.5);
Значения.Вставить("string_true", "Истина");
Значения.Вставить("string_en", "true");
Значения.Вставить("string_other", "abc");
Значения.Вставить("string_empty", "");
Значения.Вставить("undefined", Неопределено);
Значения.Вставить("null", Null);
Значения.Вставить("array", Новый Массив);
Для Каждого Пара Из Значения Цикл
    Попытка
        ОбъектПробы = Документы.ЗамерДокумента.СоздатьДокумент();
        ОбъектПробы.УстановитьЗначение(Пара.Значение);
        Попытка
            Итог = ?(ОбъектПробы.ПроверитьЗаполнение(), "TRUE", "FALSE");
        Исключение
            Итог = "ERROR";
        КонецПопытки;
        Сообщить("cancel.check." + Пара.Ключ + "=" + Итог);
    Исключение
        Сообщить("cancel.setup." + Пара.Ключ + "=ERROR");
    КонецПопытки;
КонецЦикла;
