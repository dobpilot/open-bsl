// PLATFORM-ONLY: арность и неизвестный разделитель без изменения конфигурации.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция Проба(Выражение)
	Попытка
		Возврат Строка(Вычислить(Выражение));
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
КонецФункции

М("file.begin", "data-separation-safe-mode-getter-1");
М("DATA.SAFE.ZERO", Проба("БезопасныйРежимРазделенияДанных()"));
М("DATA.SAFE.UNKNOWN", Проба("БезопасныйРежимРазделенияДанных(""НеизвестныйРазделитель"")"));
М("DATA.SAFE.TWO", Проба("БезопасныйРежимРазделенияДанных(""НеизвестныйРазделитель"", Истина)"));
М("DATA.SAFE.ENGLISH", Проба("DataSeparationSafeMode(""UnknownSeparator"")"));
М("file.end", "data-separation-safe-mode-getter-1");
