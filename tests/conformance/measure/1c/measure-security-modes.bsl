// PLATFORM-ONLY: проба проверяет режимы безопасности серверного вызова.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция БезопасныйВнутренний()
	УстановитьБезопасныйРежим(Истина);
	Возврат БезопасныйРежим();
КонецФункции

Функция БезопасныйВложенный()
	УстановитьБезопасныйРежим(Истина);
	РежимДоВызова = БезопасныйРежим();
	РежимВызова = БезопасныйВнутренний();
	РежимПослеВызова = БезопасныйРежим();
	УстановитьБезопасныйРежим(Ложь);
	Возврат Строка(РежимДоВызова) + ":" + Строка(РежимВызова)
		+ ":" + Строка(РежимПослеВызова) + ":" + Строка(БезопасныйРежим());
КонецФункции

Функция ОтключитьБезопасныйРодителя()
	Попытка
		УстановитьБезопасныйРежим(Ложь);
		Возврат "NO_ERROR";
	Исключение
		Возврат "ERROR";
	КонецПопытки;
КонецФункции

Функция БезопасныйРодитель()
	УстановитьБезопасныйРежим(Истина);
	Результат = ОтключитьБезопасныйРодителя() + ":" + Строка(БезопасныйРежим());
	УстановитьБезопасныйРежим(Ложь);
	Возврат Результат;
КонецФункции

Функция БезопасныйСчетчик()
	УстановитьБезопасныйРежим(Истина);
	УстановитьБезопасныйРежим(Истина);
	УстановитьБезопасныйРежим(Ложь);
	ПослеОдногоОтключения = БезопасныйРежим();
	УстановитьБезопасныйРежим(Ложь);
	Возврат Строка(ПослеОдногоОтключения) + ":" + Строка(БезопасныйРежим());
КонецФункции

Процедура БезопасныйСИсключением()
	УстановитьБезопасныйРежим(Истина);
	ВызватьИсключение "безопасный";
КонецПроцедуры

Функция ПривилегированныйВнутренний()
	УстановитьПривилегированныйРежим(Истина);
	Возврат ПривилегированныйРежим();
КонецФункции

Функция ПривилегированныйВложенный()
	УстановитьПривилегированныйРежим(Истина);
	РежимДоВызова = ПривилегированныйРежим();
	РежимВызова = ПривилегированныйВнутренний();
	РежимПослеВызова = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Строка(РежимДоВызова) + ":" + Строка(РежимВызова)
		+ ":" + Строка(РежимПослеВызова) + ":" + Строка(ПривилегированныйРежим());
КонецФункции

Функция ОтключитьПривилегированныйРодителя()
	Попытка
		УстановитьПривилегированныйРежим(Ложь);
		Возврат "NO_ERROR";
	Исключение
		Возврат "ERROR";
	КонецПопытки;
КонецФункции

Функция ПривилегированныйРодитель()
	УстановитьПривилегированныйРежим(Истина);
	Результат = ОтключитьПривилегированныйРодителя() + ":"
		+ Строка(ПривилегированныйРежим());
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;
КонецФункции

Функция ПривилегированныйСчетчик()
	УстановитьПривилегированныйРежим(Истина);
	УстановитьПривилегированныйРежим(Истина);
	УстановитьПривилегированныйРежим(Ложь);
	ПослеОдногоОтключения = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Строка(ПослеОдногоОтключения) + ":"
		+ Строка(ПривилегированныйРежим());
КонецФункции

Процедура ПривилегированныйСИсключением()
	УстановитьПривилегированныйРежим(Истина);
	ВызватьИсключение "привилегированный";
КонецПроцедуры

Функция ПривилегированныйВБезопасном()
	УстановитьБезопасныйРежим(Истина);
	УстановитьПривилегированныйРежим(Истина);
	РезультатВБезопасном = ПривилегированныйРежим();
	УстановитьБезопасныйРежим(Ложь);
	РезультатПослеБезопасного = ПривилегированныйРежим();
	Возврат Строка(РезультатВБезопасном) + ":"
		+ Строка(РезультатПослеБезопасного);
КонецФункции

Функция ПодавлениеБезопасного()
	УстановитьБезопасныйРежим(Истина);
	УстановитьОтключениеБезопасногоРежима(Истина);
	ВоВремяПодавления = БезопасныйРежим();
	УстановитьОтключениеБезопасногоРежима(Ложь);
	ПослеПодавления = БезопасныйРежим();
	УстановитьБезопасныйРежим(Ложь);
	Возврат Строка(ВоВремяПодавления) + ":" + Строка(ПослеПодавления);
КонецФункции

Функция СчетчикПодавленияБезопасного()
	УстановитьБезопасныйРежим(Истина);
	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьОтключениеБезопасногоРежима(Ложь);
	ПослеОдногоВключения = БезопасныйРежим();
	УстановитьОтключениеБезопасногоРежима(Ложь);
	ПослеДвухВключений = БезопасныйРежим();
	УстановитьБезопасныйРежим(Ложь);
	Возврат Строка(ПослеОдногоВключения) + ":" + Строка(ПослеДвухВключений);
КонецФункции

Функция СнятьПодавлениеРодителя()
	Попытка
		УстановитьОтключениеБезопасногоРежима(Ложь);
		Возврат "NO_ERROR";
	Исключение
		Возврат "ERROR";
	КонецПопытки;
КонецФункции

Функция ПодавлениеБезопасногоРодителя()
	УстановитьБезопасныйРежим(Истина);
	УстановитьОтключениеБезопасногоРежима(Истина);
	Результат = СнятьПодавлениеРодителя() + ":" + Строка(БезопасныйРежим());
	УстановитьОтключениеБезопасногоРежима(Ложь);
	УстановитьБезопасныйРежим(Ложь);
	Возврат Результат;
КонецФункции

Функция ПодавлениеСВозвратом()
	УстановитьОтключениеБезопасногоРежима(Истина);
	Возврат БезопасныйРежим();
КонецФункции

Функция ЧтениеПодавленияВнутреннее()
	Возврат ПолучитьОтключениеБезопасногоРежима();
КонецФункции

Функция ЧтениеПодавленияРодителя()
	УстановитьОтключениеБезопасногоРежима(Истина);
	ДоСнятия = ПолучитьОтключениеБезопасногоРежима();
	ВоВложенном = ЧтениеПодавленияВнутреннее();
	УстановитьОтключениеБезопасногоРежима(Ложь);
	ПослеСнятия = ПолучитьОтключениеБезопасногоРежима();
	Возврат Строка(ДоСнятия) + ":" + Строка(ВоВложенном)
		+ ":" + Строка(ПослеСнятия);
КонецФункции

Процедура ПодавлениеСИсключением()
	УстановитьОтключениеБезопасногоРежима(Истина);
	ВызватьИсключение "подавление безопасного";
КонецПроцедуры

Функция РодительПослеВозвратаПодавления()
	УстановитьБезопасныйРежим(Истина);
	РезультатВложенного = ПодавлениеСВозвратом();
	РезультатРодителя = БезопасныйРежим();
	УстановитьБезопасныйРежим(Ложь);
	Возврат Строка(РезультатВложенного) + ":" + Строка(РезультатРодителя);
КонецФункции

Функция РодительПослеИсключенияПодавления()
	УстановитьБезопасныйРежим(Истина);
	Попытка
		ПодавлениеСИсключением();
	Исключение
		РезультатРодителя = БезопасныйРежим();
	КонецПопытки;
	УстановитьБезопасныйРежим(Ложь);
	Возврат РезультатРодителя;
КонецФункции

Функция ПривилегированныйПриПодавленномБезопасном()
	УстановитьБезопасныйРежим(Истина);
	УстановитьПривилегированныйРежим(Истина);
	УстановитьОтключениеБезопасногоРежима(Истина);
	Результат = Строка(БезопасныйРежим()) + ":" + Строка(ПривилегированныйРежим());
	УстановитьОтключениеБезопасногоРежима(Ложь);
	Результат = Результат + ":" + Строка(ПривилегированныйРежим());
	УстановитьБезопасныйРежим(Ложь);
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;
КонецФункции

М("file.begin", "security-modes-1");
М("SECURITY.SAFE.DEFAULT", БезопасныйРежим());
М("SECURITY.SAFE.NESTED", БезопасныйВложенный());
М("SECURITY.SAFE.PARENT_DISABLE", БезопасныйРодитель());
М("SECURITY.SAFE.COUNTER", БезопасныйСчетчик());
М("SECURITY.SAFE.AFTER_RETURN", БезопасныйРежим());
Попытка
	БезопасныйСИсключением();
Исключение
	РежимПослеИсключения = БезопасныйРежим();
КонецПопытки;
М("SECURITY.SAFE.AFTER_EXCEPTION", РежимПослеИсключения);
Попытка
	УстановитьБезопасныйРежим(Ложь);
	ЛишнееОтключениеБезопасного = "NO_ERROR";
Исключение
	ЛишнееОтключениеБезопасного = "ERROR";
КонецПопытки;
М("SECURITY.SAFE.EXCESS_DISABLE", ЛишнееОтключениеБезопасного);

М("SECURITY.PRIVILEGED.DEFAULT", ПривилегированныйРежим());
М("SECURITY.PRIVILEGED.NESTED", ПривилегированныйВложенный());
М("SECURITY.PRIVILEGED.PARENT_DISABLE", ПривилегированныйРодитель());
М("SECURITY.PRIVILEGED.COUNTER", ПривилегированныйСчетчик());
М("SECURITY.PRIVILEGED.AFTER_RETURN", ПривилегированныйРежим());
Попытка
	ПривилегированныйСИсключением();
Исключение
	РежимПослеПривилегированногоИсключения = ПривилегированныйРежим();
КонецПопытки;
М("SECURITY.PRIVILEGED.AFTER_EXCEPTION", РежимПослеПривилегированногоИсключения);
Попытка
	УстановитьПривилегированныйРежим(Ложь);
	ЛишнееОтключениеПривилегированного = "NO_ERROR";
Исключение
	ЛишнееОтключениеПривилегированного = "ERROR";
КонецПопытки;
М("SECURITY.PRIVILEGED.EXCESS_DISABLE", ЛишнееОтключениеПривилегированного);
М("SECURITY.PRIVILEGED.INSIDE_SAFE", ПривилегированныйВБезопасном());
М("SECURITY.PRIVILEGED.AFTER_SAFE", ПривилегированныйРежим());
Попытка
	РезультатПодавления = ПодавлениеБезопасного();
Исключение
	РезультатПодавления = "ERROR";
КонецПопытки;
М("SECURITY.SAFE_SUPPRESSION.BALANCED", РезультатПодавления);
Попытка
	РезультатСчетчикаПодавления = СчетчикПодавленияБезопасного();
Исключение
	РезультатСчетчикаПодавления = "ERROR";
КонецПопытки;
М("SECURITY.SAFE_SUPPRESSION.COUNTER", РезультатСчетчикаПодавления);
Попытка
	РезультатПодавленияРодителя = ПодавлениеБезопасногоРодителя();
Исключение
	РезультатПодавленияРодителя = "ERROR";
КонецПопытки;
М("SECURITY.SAFE_SUPPRESSION.PARENT_DISABLE", РезультатПодавленияРодителя);
Попытка
	РезультатВозвратаПодавления = ПодавлениеСВозвратом();
Исключение
	РезультатВозвратаПодавления = "ERROR";
КонецПопытки;
М("SECURITY.SAFE_SUPPRESSION.RETURN_VALUE", РезультатВозвратаПодавления);
М("SECURITY.SAFE_SUPPRESSION.AFTER_RETURN", БезопасныйРежим());
Попытка
	ПодавлениеСИсключением();
Исключение
	РежимПослеИсключенияПодавления = БезопасныйРежим();
КонецПопытки;
М("SECURITY.SAFE_SUPPRESSION.AFTER_EXCEPTION", РежимПослеИсключенияПодавления);
М("SECURITY.SAFE_SUPPRESSION.PARENT_AFTER_RETURN", РодительПослеВозвратаПодавления());
М("SECURITY.SAFE_SUPPRESSION.PARENT_AFTER_EXCEPTION", РодительПослеИсключенияПодавления());
Попытка
	УстановитьОтключениеБезопасногоРежима(Ложь);
	ЛишнееСнятиеПодавления = "NO_ERROR";
Исключение
	ЛишнееСнятиеПодавления = "ERROR";
КонецПопытки;
М("SECURITY.SAFE_SUPPRESSION.EXCESS_DISABLE", ЛишнееСнятиеПодавления);
Попытка
	РезультатПривилегированногоПодавления = ПривилегированныйПриПодавленномБезопасном();
Исключение
	РезультатПривилегированногоПодавления = "ERROR";
КонецПопытки;
М("SECURITY.SAFE_SUPPRESSION.PRIVILEGED", РезультатПривилегированногоПодавления);
М("SECURITY.SAFE_SUPPRESSION.GET.DEFAULT", ПолучитьОтключениеБезопасногоРежима());
М("SECURITY.SAFE_SUPPRESSION.GET.FRAME", ЧтениеПодавленияРодителя());
М("SECURITY.SAFE_SUPPRESSION.GET.TYPE", ТипЗнч(ПолучитьОтключениеБезопасногоРежима()));
М("SECURITY.SAFE_SUPPRESSION.GET.ENGLISH", GetSafeModeDisabled());
М("file.end", "security-modes-1");
