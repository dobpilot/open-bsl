// PLATFORM-ONLY: проба проверяет режимы безопасности серверного вызова.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция БезопасныйВнутренний()
	УстановитьБезопасныйРежим(Истина);
	Возврат БезопасныйРежим();
КонецФункции

Функция БезопасныйВложенный()
	УстановитьБезопасныйРежим(Истина);
	РежимДоВызова = БезопасныйРежим();
	РежимВызова = БезопасныйВнутренний();
	РежимПослеВызова = БезопасныйРежим();
	УстановитьБезопасныйРежим(Ложь);
	Возврат Строка(РежимДоВызова) + ":" + Строка(РежимВызова)
		+ ":" + Строка(РежимПослеВызова) + ":" + Строка(БезопасныйРежим());
КонецФункции

Функция ОтключитьБезопасныйРодителя()
	Попытка
		УстановитьБезопасныйРежим(Ложь);
		Возврат "NO_ERROR";
	Исключение
		Возврат "ERROR";
	КонецПопытки;
КонецФункции

Функция БезопасныйРодитель()
	УстановитьБезопасныйРежим(Истина);
	Результат = ОтключитьБезопасныйРодителя() + ":" + Строка(БезопасныйРежим());
	УстановитьБезопасныйРежим(Ложь);
	Возврат Результат;
КонецФункции

Функция БезопасныйСчетчик()
	УстановитьБезопасныйРежим(Истина);
	УстановитьБезопасныйРежим(Истина);
	УстановитьБезопасныйРежим(Ложь);
	ПослеОдногоОтключения = БезопасныйРежим();
	УстановитьБезопасныйРежим(Ложь);
	Возврат Строка(ПослеОдногоОтключения) + ":" + Строка(БезопасныйРежим());
КонецФункции

Процедура БезопасныйСИсключением()
	УстановитьБезопасныйРежим(Истина);
	ВызватьИсключение "безопасный";
КонецПроцедуры

Функция ПривилегированныйВнутренний()
	УстановитьПривилегированныйРежим(Истина);
	Возврат ПривилегированныйРежим();
КонецФункции

Функция ПривилегированныйВложенный()
	УстановитьПривилегированныйРежим(Истина);
	РежимДоВызова = ПривилегированныйРежим();
	РежимВызова = ПривилегированныйВнутренний();
	РежимПослеВызова = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Строка(РежимДоВызова) + ":" + Строка(РежимВызова)
		+ ":" + Строка(РежимПослеВызова) + ":" + Строка(ПривилегированныйРежим());
КонецФункции

Функция ОтключитьПривилегированныйРодителя()
	Попытка
		УстановитьПривилегированныйРежим(Ложь);
		Возврат "NO_ERROR";
	Исключение
		Возврат "ERROR";
	КонецПопытки;
КонецФункции

Функция ПривилегированныйРодитель()
	УстановитьПривилегированныйРежим(Истина);
	Результат = ОтключитьПривилегированныйРодителя() + ":"
		+ Строка(ПривилегированныйРежим());
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;
КонецФункции

Функция ПривилегированныйСчетчик()
	УстановитьПривилегированныйРежим(Истина);
	УстановитьПривилегированныйРежим(Истина);
	УстановитьПривилегированныйРежим(Ложь);
	ПослеОдногоОтключения = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Строка(ПослеОдногоОтключения) + ":"
		+ Строка(ПривилегированныйРежим());
КонецФункции

Процедура ПривилегированныйСИсключением()
	УстановитьПривилегированныйРежим(Истина);
	ВызватьИсключение "привилегированный";
КонецПроцедуры

Функция ПривилегированныйВБезопасном()
	УстановитьБезопасныйРежим(Истина);
	УстановитьПривилегированныйРежим(Истина);
	РезультатВБезопасном = ПривилегированныйРежим();
	УстановитьБезопасныйРежим(Ложь);
	РезультатПослеБезопасного = ПривилегированныйРежим();
	Возврат Строка(РезультатВБезопасном) + ":"
		+ Строка(РезультатПослеБезопасного);
КонецФункции

М("file.begin", "security-modes-1");
М("SECURITY.SAFE.DEFAULT", БезопасныйРежим());
М("SECURITY.SAFE.NESTED", БезопасныйВложенный());
М("SECURITY.SAFE.PARENT_DISABLE", БезопасныйРодитель());
М("SECURITY.SAFE.COUNTER", БезопасныйСчетчик());
М("SECURITY.SAFE.AFTER_RETURN", БезопасныйРежим());
Попытка
	БезопасныйСИсключением();
Исключение
	РежимПослеИсключения = БезопасныйРежим();
КонецПопытки;
М("SECURITY.SAFE.AFTER_EXCEPTION", РежимПослеИсключения);
Попытка
	УстановитьБезопасныйРежим(Ложь);
	ЛишнееОтключениеБезопасного = "NO_ERROR";
Исключение
	ЛишнееОтключениеБезопасного = "ERROR";
КонецПопытки;
М("SECURITY.SAFE.EXCESS_DISABLE", ЛишнееОтключениеБезопасного);

М("SECURITY.PRIVILEGED.DEFAULT", ПривилегированныйРежим());
М("SECURITY.PRIVILEGED.NESTED", ПривилегированныйВложенный());
М("SECURITY.PRIVILEGED.PARENT_DISABLE", ПривилегированныйРодитель());
М("SECURITY.PRIVILEGED.COUNTER", ПривилегированныйСчетчик());
М("SECURITY.PRIVILEGED.AFTER_RETURN", ПривилегированныйРежим());
Попытка
	ПривилегированныйСИсключением();
Исключение
	РежимПослеПривилегированногоИсключения = ПривилегированныйРежим();
КонецПопытки;
М("SECURITY.PRIVILEGED.AFTER_EXCEPTION", РежимПослеПривилегированногоИсключения);
Попытка
	УстановитьПривилегированныйРежим(Ложь);
	ЛишнееОтключениеПривилегированного = "NO_ERROR";
Исключение
	ЛишнееОтключениеПривилегированного = "ERROR";
КонецПопытки;
М("SECURITY.PRIVILEGED.EXCESS_DISABLE", ЛишнееОтключениеПривилегированного);
М("SECURITY.PRIVILEGED.INSIDE_SAFE", ПривилегированныйВБезопасном());
М("SECURITY.PRIVILEGED.AFTER_SAFE", ПривилегированныйРежим());
М("file.end", "security-modes-1");
