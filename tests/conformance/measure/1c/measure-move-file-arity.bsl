// PLATFORM-ONLY: неверные пути позволяют проверить арность без перемещения файлов.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция Проба(Команда)
	Попытка
		Выполнить(Команда);
		Возврат "OK";
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
КонецФункции

М("file.begin", "move-file-arity-1");
М("MOVE.FILE.ZERO", Проба("ПереместитьФайл()"));
М("MOVE.FILE.ONE", Проба("ПереместитьФайл(Неопределено)"));
М("MOVE.FILE.TWO", Проба("ПереместитьФайл(Неопределено, Неопределено)"));
М("MOVE.FILE.THREE", Проба("ПереместитьФайл(Неопределено, Неопределено, Неопределено)"));
М("MOVE.FILE.ENGLISH", Проба("MoveFile(Undefined, Undefined)"));
М("file.end", "move-file-arity-1");
