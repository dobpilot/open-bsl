// Шесть членов перечисления ХешФункция на платформе 8.3.27.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Процедура МБулево(Ид, Значение)
	Если Значение Тогда
		М(Ид, "YES");
	Иначе
		М(Ид, "NO");
	КонецЕсли;
КонецПроцедуры

М("HASH.CRC32", ХешФункция.CRC32);
М("HASH.MD5", ХешФункция.MD5);
М("HASH.PBKDF2SHA256", ХешФункция.PBKDF2SHA256);
М("HASH.SHA1", ХешФункция.SHA1);
М("HASH.SHA256", ХешФункция.SHA256);
М("HASH.SHA512", ХешФункция.SHA512);

МБулево("HASH.ALIAS.CRC32", ХешФункция.CRC32 = HashFunction.CRC32);
МБулево("HASH.ALIAS.PBKDF2SHA256", ХешФункция.PBKDF2SHA256 = HashFunction.PBKDF2SHA256);
МБулево("HASH.ALIAS.SHA512", ХешФункция.SHA512 = HashFunction.SHA512);
МБулево("HASH.TYPE.CRC32", ТипЗнч(ХешФункция.CRC32) = ТипЗнч(ХешФункция.MD5));
МБулево("HASH.TYPE.PBKDF2SHA256", ТипЗнч(ХешФункция.PBKDF2SHA256) = ТипЗнч(ХешФункция.MD5));
МБулево("HASH.TYPE.SHA512", ТипЗнч(ХешФункция.SHA512) = ТипЗнч(ХешФункция.MD5));
