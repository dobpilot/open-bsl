// PLATFORM-ONLY: форма вызова функции представления события журнала.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция Проба(Выражение)
	Попытка
		Результат = Вычислить(Выражение);
		Возврат "OK:" + Строка(ТипЗнч(Результат));
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
КонецФункции

М("file.begin", "event-log-event-presentation-1");
М("EVENT.PRESENTATION.ZERO", Проба("ПредставлениеСобытияЖурналаРегистрации()"));
М("EVENT.PRESENTATION.ONE", Проба("ПредставлениеСобытияЖурналаРегистрации(Неопределено)"));
М("EVENT.PRESENTATION.TWO", Проба("ПредставлениеСобытияЖурналаРегистрации(Неопределено, Неопределено)"));
М("EVENT.PRESENTATION.ENGLISH", Проба("EventLogEventPresentation(Undefined)"));
М("file.end", "event-log-event-presentation-1");
