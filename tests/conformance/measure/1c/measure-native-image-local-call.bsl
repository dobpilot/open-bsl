// Параметр собственного ассемблерного образа изменяется внутри функции.
АргументПробы = 5;
Сообщить("image.native.reference.enter=1");
Попытка
    РезультатПробы = ЗамерыТранзитивногоРодителя.Проба(АргументПробы);
