Перем ИтогиТелаПробы;
Функция ПрочитатьТело() Экспорт Возврат ИтогиТелаПробы; КонецФункции
Функция ПрочитатьИмя() Экспорт Возврат ИмяПредопределенныхДанных; КонецФункции
Функция ПроверитьИмя(Метка, ЗначениеПробы) Экспорт
    ИмяПредопределенныхДанных = "";
    Попытка
        ИмяПредопределенныхДанных = ЗначениеПробы;
        ИтогПробы = "accepted";
    Исключение
        ИтогПробы = "rejected";
    КонецПопытки;
    Возврат Метка + "=" + ИтогПробы + ":[" + ИмяПредопределенныхДанных + "]";
КонецФункции
ИтогиТелаПробы = Новый Массив;
Попытка
    ИтогиТелаПробы.Добавить("read=[" + ИмяПредопределенныхДанных + "]");
Исключение
    ИтогиТелаПробы.Добавить("read=rejected");
КонецПопытки;
Попытка
    ИмяПредопределенныхДанных = "Основной";
    ИтогиТелаПробы.Добавить("write=accepted");
Исключение
    ИтогиТелаПробы.Добавить("write=rejected");
КонецПопытки;
