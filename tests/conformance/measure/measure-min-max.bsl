// Встроенные `Мин`/`Макс`, используемые Connector.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Процедура П(Ид, Выражение)
	Значение = "<ошибка>";
	Попытка
		Значение = Вычислить(Выражение);
		Если ТипЗнч(Значение) = Тип("Булево") Тогда
			Значение = ?(Значение, "true", "false");
		ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
			Значение = Формат(Значение, "ДФ=гггг-ММ-дд ЧЧ:мм:сс");
		КонецЕсли;
	Исключение
	КонецПопытки;
	М(Ид, Значение);
КонецПроцедуры

Функция ВыражениеМин(Арность)
	Результат = "Мин(1";
	Для Номер = 2 По Арность Цикл
		Результат = Результат + ", 1";
	КонецЦикла;
	Возврат Результат + ")";
КонецФункции

П("MIN.NUMBER", "Мин(5, 3)");
П("MAX.BOOLEAN", "Макс(Ложь, Истина)");
П("MIN.STRING", "Мин(""б"", ""а"")");
П("MAX.DATE", "Макс(Дата(2024, 1, 1), Дата(2024, 1, 2)) = Дата(2024, 1, 2)");
П("MIN.ONE_ARGUMENT", "Мин(1)");
П("MIN.THREE_ARGUMENTS", "Мин(3, 1, 2)");
П("MAX.MIXED", "Макс(Истина, 2)");
П("MIN.TIE.BOOL_FIRST", "ТипЗнч(Мин(Истина, 1)) = Тип(""Булево"")");
П("MIN.TIE.NUMBER_FIRST", "ТипЗнч(Мин(1, Истина)) = Тип(""Число"")");

Оператором = "true";
Попытка
	Выполнить("Макс(1, 2);");
Исключение
	Оператором = "false";
КонецПопытки;
М("MAX.AS_STATEMENT", Оператором);

П("MIN.ARITY.10", ВыражениеМин(10));
П("MIN.ARITY.100", ВыражениеМин(100));
П("MIN.ARITY.255", ВыражениеМин(255));
П("MIN.ARITY.256", ВыражениеМин(256));
