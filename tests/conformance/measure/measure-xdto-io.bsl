// --- ЧЕТВЁРТЫЙ ЗАХОД: пустая лексика, порядок выбора, префиксы ------------
//
// `<t:num/>` при чтении С ТИПОМ дало ЧИСЛО 0, а не ошибку, — значит,
// пустая лексическая форма чем-то разбирается. Чем именно и для каких
// типов — ниже. Заодно снимается схема генерации префиксов (`d1p1`): по
// одному наблюдению правило не восстановить.

Функция ПустоеСвойство(Имя)
	Возврат Сбор("Попытка НовыйЧитатель(""<t:root xmlns:t=""""urn:test""""><t:name>а</t:name><t:" + Имя + "/></t:root>""); ОбП = Фаб.ПрочитатьXML(Чтр, ТипКорня); Соб = ""["" + Строка(ОбП." + Имя + ") + ""] "" + Строка(ТипЗнч(ОбП." + Имя + ")); Исключение Соб = ""<ошибка>""; КонецПопытки;");
КонецФункции

П("чв Создать пустой int", Ч("Фаб.Создать(Фаб.Тип(НСXSD, ""int""), """").Значение"));
П("чв Создать пустой date", Ч("Фаб.Создать(Фаб.Тип(НСXSD, ""date""), """").Значение"));
П("чв Создать пустой dbl", Ч("Фаб.Создать(Фаб.Тип(НСXSD, ""double""), """").Значение"));
П("чв пустое num", ПустоеСвойство("num"));
П("чв пустое dec", ПустоеСвойство("dec"));
П("чв пустое dbl", ПустоеСвойство("dbl"));
П("чв пустое when", ПустоеСвойство("when"));
П("чв пустое flag", ПустоеСвойство("flag"));
П("чв пустое bin", ПустоеСвойство("bin"));
