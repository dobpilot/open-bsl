П("пз запись списка", Сбор("НовыйПисатель(); НовыйОбъект(); ОбП.codes = ""1 2 3""; Фаб.ЗаписатьXML(Зпис, ОбП, ""к""); Соб = Зпис.Закрыть();"));
П("пз чтение объединения", Сбор("НовыйЧитатель(""<t:root xmlns:t=""""urn:test""""><t:name>а</t:name><t:either>7</t:either></t:root>""); ОбП = Фаб.ПрочитатьXML(Чтр, ТипКорня); Соб = ""["" + Строка(ОбП.either) + ""] "" + Строка(ТипЗнч(ОбП.either));"));
П("пз запись объединения", Сбор("НовыйПисатель(); НовыйОбъект(); ОбП.either = 7; Фаб.ЗаписатьXML(Зпис, ОбП, ""к""); Соб = Зпис.Закрыть();"));
П("пз множественное вразбивку", Сбор("Попытка НовыйЧитатель(""<t:root xmlns:t=""""urn:test""""><t:name>а</t:name><t:tag>1</t:tag><t:nested><t:in>в</t:in></t:nested><t:tag>2</t:tag></t:root>""); ОбП = Фаб.ПрочитатьXML(Чтр, ТипКорня); Соб = ""ок "" + Строка(ОбП.tag.Количество()); Исключение Соб = ""<ошибка>""; КонецПопытки;"));
П("пз пропуск необязательного", Сбор("Попытка НовыйЧитатель(""<t:root xmlns:t=""""urn:test""""><t:name>а</t:name><t:flag>true</t:flag></t:root>""); ОбП = Фаб.ПрочитатьXML(Чтр, ТипКорня); Соб = ""ок ["" + Строка(ОбП.flag) + ""]""; Исключение Соб = ""<ошибка>""; КонецПопытки;"));
П("пз префикс на глубине 3", Сбор("НовыйПисатель(); НовыйОбъект(); Зпис.ЗаписатьНачалоЭлемента(""о""); В = Фаб.Создать(ТипВнутр); В.in = ""вг""; В.qi = ""х""; ОбП.nested = В; Фаб.ЗаписатьXML(Зпис, ОбП); Зпис.ЗаписатьКонецЭлемента(); Соб = Зпис.Закрыть();"));

// --- открытые вопросы ------------------------------------------------------
//
// XDTO.IO.PREFIX: как нумеруется ВТОРОЙ порождённый префикс на одном
// элементе. Прямой пробы нет и быть не может: два префикса на одном
// элементе требуют типа с двумя квалифицированными атрибутами из РАЗНЫХ
// пространств имён, то есть межсхемной ссылки, а `СоздатьФабрикуXDTO`
// берёт ровно один файл XSD (измерено). Суррогат перепроверяет измеренного
// соседа — ПЕРВЫЙ префикс на второй глубине: пока он `d2p1`, продолжение
// «номер внутри элемента растёт с единицы» остаётся правдоподобным.
Р = Сбор("НовыйПисатель(); НовыйОбъект(); В = Фаб.Создать(ТипВнутр); В.in = ""вг""; В.qi = ""х""; ОбП.nested = В; Фаб.ЗаписатьXML(Зпис, ОбП, ""к""); Соб = ?(СтрНайти(Зпис.Закрыть(), ""d2p1"") > 0, ""d2p1"", ""иначе"");");
П("XDTO.IO.PREFIX", Р);
