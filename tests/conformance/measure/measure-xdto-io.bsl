// Контракт `ПрочитатьXML`/`ЗаписатьXML` ФАБРИКИ XDTO на 8.3.27: разбор
// документа в `ОбъектXDTO`/`ЗначениеXDTO` по типам схемы, обратная запись и
// лексические формы значений.
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-xdto-io.bsl
//
// Правила те же, что у `measure-xdto.bsl`: строка `МЕТКА<таб>ЗНАЧЕНИЕ`, всё
// рискованное — через `Вычислить`/`Выполнить` внутри `Попытка`, приёмники
// проб — переменные МОДУЛЯ, одна проба на строку.
//
// ИМЯ `Ф` ЗАНЯТО ОБВЯЗКОЙ ЗАМЕРОВ: генератор модуля формы держит в `Ф`
// свою `ЗаписьТекста`, поэтому фабрика здесь — `Фаб`, а писатель — `Зпис`.
//
// ПОСТРОЧНОГО ПАРИТЕТА С ЭТИМ ИНТЕРПРЕТАТОРОМ ЗДЕСЬ НЕ БЫЛО В МОМЕНТ
// ПЕРВОГО СНЯТИЯ: `ПрочитатьXML`/`ЗаписатьXML` у фабрики тогда не было
// вовсе, и все строки, идущие через них, давали `<ошибка>`. Снимок
// односторонний и в этом смысл: он говорит, ЧТО должно получиться.
//
// ЗАЧЕМ ФАЙЛ СХЕМЫ. `СоздатьФабрикуXDTO` берёт только путь к XSD
// (измерено), а `Новый ФабрикаXDTO` — только `НаборСхемXML`. Путь к файлу
// работает по обе стороны, поэтому схема пишется во временный файл.

Перем Фаб;
Перем Соб;
Перем Чтр;
Перем Зпис;
Перем ОбП;
Перем ЗнП;
Перем ТипКорня;
Перем ТипВнутр;
Перем ТекстСхемы;
Перем ПутьСхемы;
Перем ДокПолный;
Перем НСXSD;

Процедура П(Метка, Значение)
	Сообщить(Метка + Символ(9) + Значение);
КонецПроцедуры

Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Р = СтрЗаменить(Р, Символ(10), "<ПС>");
	Р = СтрЗаменить(Р, Символ(9), "<Т>");
	Возврат Р;
КонецФункции

// Проба ВЫРАЖЕНИЯ: тип результата и его строковое представление.
Функция Ч(Выражение)
	Попытка
		Р = Вычислить(Выражение);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Попытка
		Возврат Строка(ТипЗнч(Р)) + " [" + Видимо(Строка(Р)) + "]";
	Исключение
		Возврат Строка(ТипЗнч(Р)) + " <не печатается>";
	КонецПопытки;
КонецФункции

// Сбор в модульную переменную `Соб`.
Функция Сбор(Код)
	Попытка
		Соб = "";
		Выполнить(Код);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат Видимо(Соб);
КонецФункции

// Читатель над текстом — приёмник модульный, чтобы пробы `Вычислить`
// видели его по имени.
Процедура НовыйЧитатель(Текст)
	Чтр = Новый ЧтениеXML;
	Чтр.УстановитьСтроку(Текст);
КонецПроцедуры

// Писатель в строку — тот же приём.
Процедура НовыйПисатель()
	Зпис = Новый ЗаписьXML;
	Зпис.УстановитьСтроку();
КонецПроцедуры

// Свежий заполненный экземпляр корневого типа в `ОбП`.
Процедура НовыйОбъект()
	ОбП = Фаб.Создать(ТипКорня);
	ОбП.name = "аб";
	ОбП.id = 7;
КонецПроцедуры

// --- схема ----------------------------------------------------------------

НСXSD = "http://www.w3.org/2001/XMLSchema";

ТекстСхемы = "<?xml version=""1.0"" encoding=""UTF-8""?>"
	+ "<xs:schema xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:t=""urn:test"""
	+ " targetNamespace=""urn:test"" elementFormDefault=""qualified"""
	+ " attributeFormDefault=""unqualified"">"
	+ "<xs:element name=""root"" type=""t:RootType""/>"
	+ "<xs:element name=""точка"" type=""t:Inner""/>"
	+ "<xs:element name=""голый"" type=""xs:int""/>"
	+ "<xs:complexType name=""Inner""><xs:sequence>"
	+ "<xs:element name=""in"" type=""xs:string""/>"
	+ "</xs:sequence>"
	+ "<xs:attribute name=""qi"" type=""xs:string"" form=""qualified""/>"
	+ "</xs:complexType>"
	+ "<xs:complexType name=""InnerExt""><xs:complexContent>"
	+ "<xs:extension base=""t:Inner""><xs:sequence>"
	+ "<xs:element name=""more"" type=""xs:string""/>"
	+ "</xs:sequence></xs:extension></xs:complexContent></xs:complexType>"
	+ "<xs:complexType name=""RootType""><xs:sequence>"
	+ "<xs:element name=""name"" type=""xs:string""/>"
	+ "<xs:element name=""num"" type=""xs:int"" minOccurs=""0""/>"
	+ "<xs:element name=""dec"" type=""xs:decimal"" minOccurs=""0""/>"
	+ "<xs:element name=""dbl"" type=""xs:double"" minOccurs=""0""/>"
	+ "<xs:element name=""when"" type=""xs:date"" minOccurs=""0""/>"
	+ "<xs:element name=""stamp"" type=""xs:dateTime"" minOccurs=""0""/>"
	+ "<xs:element name=""hour"" type=""xs:time"" minOccurs=""0""/>"
	+ "<xs:element name=""flag"" type=""xs:boolean"" minOccurs=""0""/>"
	+ "<xs:element name=""bin"" type=""xs:base64Binary"" minOccurs=""0""/>"
	+ "<xs:element name=""hex"" type=""xs:hexBinary"" minOccurs=""0""/>"
	+ "<xs:element name=""tag"" type=""xs:string"" minOccurs=""0"" maxOccurs=""unbounded""/>"
	+ "<xs:element name=""nested"" type=""t:Inner"" minOccurs=""0""/>"
	+ "<xs:element name=""nilt"" type=""xs:int"" minOccurs=""0"" nillable=""true""/>"
	+ "<xs:element name=""uq"" type=""xs:string"" minOccurs=""0"" form=""unqualified""/>"
	+ "<xs:element name=""notype"" minOccurs=""0""/>"
	+ "<xs:element name=""codes"" type=""t:Codes"" minOccurs=""0""/>"
	+ "<xs:element name=""either"" type=""t:Either"" minOccurs=""0""/>"
	+ "<xs:element name=""anon"" minOccurs=""0""><xs:complexType><xs:sequence>"
	+ "<xs:element name=""ai"" type=""xs:string""/>"
	+ "</xs:sequence></xs:complexType></xs:element>"
	+ "</xs:sequence>"
	+ "<xs:attribute name=""id"" type=""xs:int""/>"
	+ "<xs:attribute name=""qa"" type=""xs:string"" form=""qualified""/>"
	+ "</xs:complexType>"
	+ "<xs:complexType name=""SimpContent""><xs:simpleContent>"
	+ "<xs:extension base=""xs:decimal"">"
	+ "<xs:attribute name=""su"" type=""xs:string""/>"
	+ "</xs:extension></xs:simpleContent></xs:complexType>"
	+ "<xs:simpleType name=""Codes""><xs:list itemType=""xs:int""/></xs:simpleType>"
	+ "<xs:simpleType name=""Either""><xs:union memberTypes=""xs:int xs:string""/></xs:simpleType>"
	+ "<xs:complexType name=""ChoiceType""><xs:choice minOccurs=""0"" maxOccurs=""unbounded"">"
	+ "<xs:element name=""ca"" type=""xs:string""/>"
	+ "<xs:element name=""cb"" type=""xs:string""/>"
	+ "</xs:choice></xs:complexType>"
	+ "</xs:schema>";

ПутьСхемы = "/tmp/open-bsl-measure-xdto-io.xsd";
Попытка
	Зпс = Новый ЗаписьТекста(ПутьСхемы);
	Зпс.Записать(ТекстСхемы);
	Зпс.Закрыть();
Исключение
КонецПопытки;

П("схема записана", Ч("ПутьСхемы"));
П("фабрика", Ч("СоздатьФабрикуXDTO(ПутьСхемы)"));
Попытка
	Фаб = СоздатьФабрикуXDTO(ПутьСхемы);
Исключение
КонецПопытки;
Попытка
	ТипКорня = Фаб.Тип("urn:test", "RootType");
	ТипВнутр = Фаб.Тип("urn:test", "Inner");
Исключение
КонецПопытки;
П("тип корня", Ч("ТипКорня"));

ДокПолный = "<t:root xmlns:t=""urn:test"" id=""7"">"
	+ "<t:name>аб</t:name>"
	+ "<t:num>42</t:num>"
	+ "<t:dec>12.50</t:dec>"
	+ "<t:when>2026-08-13</t:when>"
	+ "<t:stamp>2026-08-13T10:20:30</t:stamp>"
	+ "<t:flag>true</t:flag>"
	+ "<t:bin>0LDQsQ==</t:bin>"
	+ "<t:tag>один</t:tag><t:tag>два</t:tag>"
	+ "<t:nested><t:in>вг</t:in></t:nested>"
	+ "<uq>де</uq>"
	+ "</t:root>";

// --- ПрочитатьXML: имена, арность, откуда берётся тип ----------------------

П("чт имя есть", Ч("Строка(Фаб.ПрочитатьXML <> Неопределено)"));
П("чт без аргументов", Ч("Фаб.ПрочитатьXML()"));
П("чт строкой", Ч("Фаб.ПрочитатьXML(ДокПолный)"));
П("чт свежий читатель", Сбор("НовыйЧитатель(ДокПолный); Соб = Строка(ТипЗнч(Фаб.ПрочитатьXML(Чтр)));"));
П("чт после Прочитать", Сбор("НовыйЧитатель(ДокПолный); Чтр.Прочитать(); Соб = Строка(ТипЗнч(Фаб.ПрочитатьXML(Чтр)));"));
П("чт после ПерейтиКСодержимому", Сбор("НовыйЧитатель(ДокПолный); Чтр.ПерейтиКСодержимому(); Соб = Строка(ТипЗнч(Фаб.ПрочитатьXML(Чтр)));"));
П("чт с типом", Сбор("НовыйЧитатель(ДокПолный); Чтр.Прочитать(); Соб = Строка(ТипЗнч(Фаб.ПрочитатьXML(Чтр, ТипКорня)));"));
П("чт три аргумента", Сбор("НовыйЧитатель(ДокПолный); Чтр.Прочитать(); Соб = Строка(ТипЗнч(Фаб.ПрочитатьXML(Чтр, ТипКорня, ""лишний"")));"));
П("чт четыре аргумента", Сбор("НовыйЧитатель(ДокПолный); Чтр.Прочитать(); Соб = Строка(ТипЗнч(Фаб.ПрочитатьXML(Чтр, ТипКорня, ""л1"", ""л2"")));"));
П("чт ReadXML англ", Сбор("НовыйЧитатель(ДокПолный); Чтр.Прочитать(); Соб = Строка(ТипЗнч(Фаб.ReadXML(Чтр)));"));
П("чт тип строкой", Сбор("НовыйЧитатель(ДокПолный); Чтр.Прочитать(); Соб = Строка(ТипЗнч(Фаб.ПрочитатьXML(Чтр, ""RootType"")));"));
П("чт тип расширенным именем", Сбор("НовыйЧитатель(ДокПолный); Чтр.Прочитать(); Соб = Строка(ТипЗнч(Фаб.ПрочитатьXML(Чтр, Новый РасширенноеИмяXML(""urn:test"", ""RootType""))));"));

// --- ПрочитатьXML: что именно прочиталось ---------------------------------

П("чт свойство name", Сбор("НовыйЧитатель(ДокПолный); ОбП = Фаб.ПрочитатьXML(Чтр); Соб = ""["" + Строка(ОбП.name) + ""] "" + Строка(ТипЗнч(ОбП.name));"));
П("чт атрибут id", Сбор("НовыйЧитатель(ДокПолный); ОбП = Фаб.ПрочитатьXML(Чтр); Соб = ""["" + Строка(ОбП.id) + ""] "" + Строка(ТипЗнч(ОбП.id));"));
П("чт число num", Сбор("НовыйЧитатель(ДокПолный); ОбП = Фаб.ПрочитатьXML(Чтр); Соб = ""["" + Формат(ОбП.num, ""ЧГ=0; ЧРД=."") + ""]"";"));
П("чт дробное dec", Сбор("НовыйЧитатель(ДокПолный); ОбП = Фаб.ПрочитатьXML(Чтр); Соб = ""["" + Формат(ОбП.dec, ""ЧГ=0; ЧРД=."") + ""]"";"));
П("чт дата when", Сбор("НовыйЧитатель(ДокПолный); ОбП = Фаб.ПрочитатьXML(Чтр); Соб = ""["" + Формат(ОбП.when, ""ДФ=""""гггг-ММ-дд ЧЧ:мм:сс"""""") + ""] "" + Строка(ТипЗнч(ОбП.when));"));
П("чт момент stamp", Сбор("НовыйЧитатель(ДокПолный); ОбП = Фаб.ПрочитатьXML(Чтр); Соб = ""["" + Формат(ОбП.stamp, ""ДФ=""""гггг-ММ-дд ЧЧ:мм:сс"""""") + ""]"";"));
П("чт булево flag", Сбор("НовыйЧитатель(ДокПолный); ОбП = Фаб.ПрочитатьXML(Чтр); Соб = ""["" + Строка(ОбП.flag) + ""] "" + Строка(ТипЗнч(ОбП.flag));"));
П("чт двоичное bin", Сбор("НовыйЧитатель(ДокПолный); ОбП = Фаб.ПрочитатьXML(Чтр); Соб = Строка(ТипЗнч(ОбП.bin)) + "" "" + Строка(ОбП.bin.Размер());"));
П("чт множественное tag", Сбор("НовыйЧитатель(ДокПолный); ОбП = Фаб.ПрочитатьXML(Чтр); Соб = Строка(ТипЗнч(ОбП.tag)) + "" "" + Строка(ОбП.tag.Количество()) + "" ["" + Строка(ОбП.tag[0]) + ""|"" + Строка(ОбП.tag[1]) + ""]"";"));
П("чт вложенное nested", Сбор("НовыйЧитатель(ДокПолный); ОбП = Фаб.ПрочитатьXML(Чтр); Соб = Строка(ТипЗнч(ОбП.nested)) + "" ["" + Строка(ОбП.nested.in) + ""]"";"));
П("чт неквалифицированное uq", Сбор("НовыйЧитатель(ДокПолный); ОбП = Фаб.ПрочитатьXML(Чтр); Соб = ""["" + Строка(ОбП.uq) + ""]"";"));
П("чт пропущенное установлено", Сбор("НовыйЧитатель(ДокПолный); ОбП = Фаб.ПрочитатьXML(Чтр); Соб = Строка(ОбП.Установлено(""hour""));"));
П("чт прочитанное установлено", Сбор("НовыйЧитатель(ДокПолный); ОбП = Фаб.ПрочитатьXML(Чтр); Соб = Строка(ОбП.Установлено(""name""));"));
П("чт последовательность", Сбор("НовыйЧитатель(ДокПолный); ОбП = Фаб.ПрочитатьXML(Чтр); Соб = Строка(ТипЗнч(ОбП.Последовательность()));"));
П("чт Проверить", Сбор("НовыйЧитатель(ДокПолный); ОбП = Фаб.ПрочитатьXML(Чтр); ОбП.Проверить(); Соб = ""ок"";"));

// --- ПрочитатьXML: где остаётся читатель -----------------------------------

П("чт позиция ТипУзла", Сбор("НовыйЧитатель(ДокПолный); Фаб.ПрочитатьXML(Чтр); Соб = Строка(Чтр.ТипУзла);"));
П("чт позиция Прочитать", Сбор("НовыйЧитатель(ДокПолный); Фаб.ПрочитатьXML(Чтр); Соб = Строка(Чтр.Прочитать());"));
П("чт позиция имя", Сбор("НовыйЧитатель(ДокПолный); Фаб.ПрочитатьXML(Чтр); Соб = ""["" + Строка(Чтр.Имя) + ""]"";"));
П("чт двух подряд", Сбор("НовыйЧитатель(""<об xmlns=""""urn:test""""><t:root xmlns:t=""""urn:test"""" id=""""1""""><t:name>а</t:name></t:root><t:root xmlns:t=""""urn:test"""" id=""""2""""><t:name>б</t:name></t:root></об>""); Чтр.Прочитать(); Чтр.Прочитать(); О1 = Фаб.ПрочитатьXML(Чтр, ТипКорня); О2 = Фаб.ПрочитатьXML(Чтр, ТипКорня); Соб = Строка(О1.id) + ""|"" + Строка(О2.id);"));

// --- ПрочитатьXML: отказы и углы -------------------------------------------

П("чт чужой элемент", Сбор("НовыйЧитатель(""<чужой xmlns=""""urn:иное""""/>""); Соб = Строка(ТипЗнч(Фаб.ПрочитатьXML(Чтр)));"));
П("чт чужой элемент текст", Сбор("Попытка НовыйЧитатель(""<чужой xmlns=""""urn:иное""""/>""); Фаб.ПрочитатьXML(Чтр); Соб = ""нет ошибки""; Исключение Соб = ОписаниеОшибки(); КонецПопытки;"));
П("чт несоответствие типу", Сбор("Попытка НовыйЧитатель(""<чужой xmlns=""""urn:иное""""/>""); Фаб.ПрочитатьXML(Чтр, ТипКорня); Соб = ""нет ошибки""; Исключение Соб = ОписаниеОшибки(); КонецПопытки;"));
П("чт лишний элемент", Сбор("НовыйЧитатель(""<t:root xmlns:t=""""urn:test""""><t:name>а</t:name><t:чужое>б</t:чужое></t:root>""); Соб = Строка(ТипЗнч(Фаб.ПрочитатьXML(Чтр)));"));
П("чт лишний элемент текст", Сбор("Попытка НовыйЧитатель(""<t:root xmlns:t=""""urn:test""""><t:name>а</t:name><t:чужое>б</t:чужое></t:root>""); Фаб.ПрочитатьXML(Чтр); Соб = ""нет ошибки""; Исключение Соб = ОписаниеОшибки(); КонецПопытки;"));
П("чт лишний атрибут", Сбор("НовыйЧитатель(""<t:root xmlns:t=""""urn:test"""" чужой=""""1""""><t:name>а</t:name></t:root>""); Соб = Строка(ТипЗнч(Фаб.ПрочитатьXML(Чтр)));"));
П("чт битая лексика", Сбор("Попытка НовыйЧитатель(""<t:root xmlns:t=""""urn:test""""><t:name>а</t:name><t:num>ab</t:num></t:root>""); Фаб.ПрочитатьXML(Чтр); Соб = ""нет ошибки""; Исключение Соб = ОписаниеОшибки(); КонецПопытки;"));
П("чт недозаполненный", Сбор("НовыйЧитатель(""<t:root xmlns:t=""""urn:test""""/>""); ОбП = Фаб.ПрочитатьXML(Чтр); Соб = Строка(ТипЗнч(ОбП)) + "" "" + Строка(ОбП.Установлено(""name""));"));
П("чт пробелы между тегами", Сбор("НовыйЧитатель(""<t:root xmlns:t=""""urn:test""""> <t:name>а</t:name> </t:root>""); ОбП = Фаб.ПрочитатьXML(Чтр); Соб = ""["" + Строка(ОбП.name) + ""]"";"));
П("чт nil", Сбор("НовыйЧитатель(""<t:root xmlns:t=""""urn:test"""" xmlns:xsi=""""http://www.w3.org/2001/XMLSchema-instance""""><t:name>а</t:name><t:nilt xsi:nil=""""true""""/></t:root>""); ОбП = Фаб.ПрочитатьXML(Чтр); Соб = ""["" + Строка(ОбП.nilt) + ""] уст="" + Строка(ОбП.Установлено(""nilt""));"));
П("чт пустой элемент числа", Сбор("Попытка НовыйЧитатель(""<t:root xmlns:t=""""urn:test""""><t:name>а</t:name><t:num/></t:root>""); ОбП = Фаб.ПрочитатьXML(Чтр); Соб = ""["" + Строка(ОбП.num) + ""]""; Исключение Соб = ""<ошибка>""; КонецПопытки;"));
П("чт xsi:type наследника", Сбор("НовыйЧитатель(""<t:root xmlns:t=""""urn:test"""" xmlns:xsi=""""http://www.w3.org/2001/XMLSchema-instance""""><t:name>а</t:name><t:nested xsi:type=""""t:InnerExt""""><t:in>в</t:in><t:more>г</t:more></t:nested></t:root>""); ОбП = Фаб.ПрочитатьXML(Чтр); Соб = Строка(ОбП.nested.Тип()) + "" ["" + Строка(ОбП.nested.more) + ""]"";"));
П("чт простого типа", Сбор("НовыйЧитатель(""<t:голый xmlns:t=""""urn:test"""">42</t:голый>""); Р = Фаб.ПрочитатьXML(Чтр); Соб = Строка(ТипЗнч(Р)) + "" ["" + Строка(Р) + ""]"";"));
П("чт простого типа с типом", Сбор("НовыйЧитатель(""<число>42</число>""); Р = Фаб.ПрочитатьXML(Чтр, Фаб.Тип(НСXSD, ""int"")); Соб = Строка(ТипЗнч(Р)) + "" ["" + Строка(Р) + ""]"";"));
П("чт простого содержимого", Сбор("НовыйЧитатель(""<знач su=""""х"""">12.5</знач>""); Р = Фаб.ПрочитатьXML(Чтр, Фаб.Тип(""urn:test"", ""SimpContent"")); Соб = Строка(ТипЗнч(Р)) + "" ["" + Формат(Р.Получить(""__content""), ""ЧГ=0; ЧРД=."") + ""|"" + Строка(Р.su) + ""]"";"));
