// значение СПИСОЧНОГО простого типа и что делает порядок при чтении
// множественного свойства вразбивку.

П("пз значение с атрибутом", Сбор("Попытка НовыйЧитатель(""<число а=""""1"""">42</число>""); Р = Фаб.ПрочитатьXML(Чтр, Фаб.Тип(НСXSD, ""int"")); Соб = ""ок ["" + Строка(Р.Значение) + ""]""; Исключение Соб = ""<ошибка>""; КонецПопытки;"));
