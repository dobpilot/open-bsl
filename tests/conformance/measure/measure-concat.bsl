// Замеры приведения типов в операторе `+`, снимаемые на 8.3.27.
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-concat.bsl
//
// Правила те же, что у `measure-json.bsl` и `measure-xml.bsl`: строка
// `ИД<таб>ЗНАЧЕНИЕ`, скрипт исполняется И НАШИМ интерпретатором, отказ —
// стабильным маркером `<ошибка>`.
//
// ЗАЧЕМ. Платформа склеивает строку с числом и с `Неопределено`, а мы на
// этом падаем: `add` в `bsl_rt` ведёт любую нестроковую пару по ЧИСЛОВОМУ
// пути. Главный вопрос не «приводить ли», а ПО КАКИМ ПРАВИЛАМ: `Строка()`
// печатает `1000.5` как «1 000,5» — с разделителем групп, — и если
// конкатенация идёт через неё, то безобидное `"Сумма: " + 1000.5` тащит в
// текст неразрывный пробел. Поэтому рядом с каждым `"" + X` печатается
// `Строка(X)`: сравнение построчное, а не на глаз.
//
// РАЗДЕЛИТЕЛЬ ГРУПП НЕВИДИМ — это символ 160, а не пробел. `Видимо` его
// подменяет, иначе замер невозможно сверить.
//
// Вывод сходится с платформой построчно и целиком.

Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Р = СтрЗаменить(Р, Символ(10), "<ПС>");
	Р = СтрЗаменить(Р, Символ(9), "<Т>");
	Р = СтрЗаменить(Р, Символ(160), "<НП>");
	Возврат Р;
КонецФункции

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Видимо(Строка(Значение)));
КонецПроцедуры

// =====================================================================
// СТРОКА СЛЕВА: что становится с правым операндом
// =====================================================================
//
// Печатается пара «склейка | Строка(X)». Если половинки совпадут, правило
// приведения — это `Строка()`; если разойдутся, у конкатенации своё.

Р = "<ошибка>";
Попытка
	Р = "[" + 5 + "]";
Исключение
КонецПопытки;
М("CONCAT.RIGHT.INT", Р);

Р = "<ошибка>";
Попытка
	Р = "[" + 1000.5 + "] | [" + Строка(1000.5) + "]";
Исключение
КонецПопытки;
М("CONCAT.RIGHT.THOUSANDS", Р);

Р = "<ошибка>";
Попытка
	Р = "[" + 1000000 + "] | [" + Строка(1000000) + "]";
Исключение
КонецПопытки;
М("CONCAT.RIGHT.MILLION", Р);

Р = "<ошибка>";
Попытка
	Р = "[" + 1/3 + "] | [" + Строка(1/3) + "]";
Исключение
КонецПопытки;
М("CONCAT.RIGHT.THIRD", Р);

Р = "<ошибка>";
Попытка
	Р = "[" + (-2.5) + "] | [" + Строка(-2.5) + "]";
Исключение
КонецПопытки;
М("CONCAT.RIGHT.NEGATIVE", Р);

Р = "<ошибка>";
Попытка
	Р = "[" + 0 + "] | [" + Строка(0) + "]";
Исключение
КонецПопытки;
М("CONCAT.RIGHT.ZERO", Р);

Р = "<ошибка>";
Попытка
	Р = "[" + Истина + "] | [" + Строка(Истина) + "]";
Исключение
КонецПопытки;
М("CONCAT.RIGHT.TRUE", Р);

Р = "<ошибка>";
Попытка
	Р = "[" + Ложь + "] | [" + Строка(Ложь) + "]";
Исключение
КонецПопытки;
М("CONCAT.RIGHT.FALSE", Р);

Р = "<ошибка>";
Попытка
	Р = "[" + Неопределено + "] | [" + Строка(Неопределено) + "]";
Исключение
КонецПопытки;
М("CONCAT.RIGHT.UNDEFINED", Р);

Р = "<ошибка>";
Попытка
	Р = "[" + Null + "] | [" + Строка(Null) + "]";
Исключение
КонецПопытки;
М("CONCAT.RIGHT.NULL", Р);

Р = "<ошибка>";
Попытка
	Р = "[" + '20240115103000' + "] | [" + Строка('20240115103000') + "]";
Исключение
КонецПопытки;
М("CONCAT.RIGHT.DATE", Р);

Р = "<ошибка>";
Попытка
	Р = "[" + '00010101' + "] | [" + Строка('00010101') + "]";
Исключение
КонецПопытки;
М("CONCAT.RIGHT.EMPTY_DATE", Р);

Р = "<ошибка>";
Попытка
	Р = "[" + Новый Массив + "] | [" + Строка(Новый Массив) + "]";
Исключение
КонецПопытки;
М("CONCAT.RIGHT.ARRAY", Р);

Р = "<ошибка>";
Попытка
	Р = "[" + Новый Структура + "] | [" + Строка(Новый Структура) + "]";
Исключение
КонецПопытки;
М("CONCAT.RIGHT.STRUCTURE", Р);

Р = "<ошибка>";
Попытка
	Р = "[" + ТипЗнч(1) + "] | [" + Строка(ТипЗнч(1)) + "]";
Исключение
КонецПопытки;
М("CONCAT.RIGHT.TYPE", Р);

Р = "<ошибка>";
Попытка
	Р = "[" + ТипЗначенияJSON.Строка + "] | [" + Строка(ТипЗначенияJSON.Строка) + "]";
Исключение
КонецПопытки;
М("CONCAT.RIGHT.ENUM", Р);

// =====================================================================
// СТРОКА СПРАВА: приводится ли ЛЕВЫЙ операнд
// =====================================================================
//
// Здесь ожидание обратное: слева число, значит платформа скорее возьмётся
// за арифметику и потребует числа справа. Но проверить надо.

Р = "<ошибка>";
Попытка
	Р = 5 + "]";
Исключение
КонецПопытки;
М("CONCAT.LEFT.INT", Р);

Р = "<ошибка>";
Попытка
	Р = Истина + "]";
Исключение
КонецПопытки;
М("CONCAT.LEFT.TRUE", Р);

Р = "<ошибка>";
Попытка
	Р = Неопределено + "]";
Исключение
КонецПопытки;
М("CONCAT.LEFT.UNDEFINED", Р);

Р = "<ошибка>";
Попытка
	Р = '20240115103000' + "]";
Исключение
КонецПопытки;
М("CONCAT.LEFT.DATE", Р);

// Строка, ПОХОЖАЯ на число, слева: арифметика или склейка.
Р = "<ошибка>";
Попытка
	Р = "5" + 1;
Исключение
КонецПопытки;
М("CONCAT.LEFT.NUMERIC_STRING", Р);

// =====================================================================
// ПОРЯДОК ВЫЧИСЛЕНИЯ
// =====================================================================
//
// `+` левоассоциативен, поэтому в `1 + 2 + "х"` сначала складываются
// числа, а склейка случается только на втором шаге.

Р = "<ошибка>";
Попытка
	Р = 1 + 2 + "х";
Исключение
КонецПопытки;
М("CONCAT.ORDER.NUM_NUM_STR", Р);

Р = "<ошибка>";
Попытка
	Р = "х" + 1 + 2;
Исключение
КонецПопытки;
М("CONCAT.ORDER.STR_NUM_NUM", Р);

// =====================================================================
// ОСТАЛЬНЫЕ АРИФМЕТИЧЕСКИЕ ОПЕРАТОРЫ
// =====================================================================
//
// Приведение — свойство именно `+` или всей арифметики.

Р = "<ошибка>";
Попытка
	Р = "5" - 1;
Исключение
КонецПопытки;
М("CONCAT.OTHER.MINUS", Р);

Р = "<ошибка>";
Попытка
	Р = "5" * 2;
Исключение
КонецПопытки;
М("CONCAT.OTHER.TIMES", Р);

Р = "<ошибка>";
Попытка
	Р = "" + 5 - 1;
Исключение
КонецПопытки;
М("CONCAT.OTHER.CONCAT_THEN_MINUS", Р);

// =====================================================================
// ПУСТАЯ СТРОКА СЛЕВА — САМЫЙ ЧАСТЫЙ СПОСОБ ПРИВЕСТИ К СТРОКЕ
// =====================================================================

Р = "<ошибка>";
Попытка
	Р = "[" + ("" + 1000.5) + "]";
Исключение
КонецПопытки;
М("CONCAT.IDIOM.EMPTY_LEFT", Р);

Р = "<ошибка>";
Попытка
	Р = Строка(ТипЗнч("" + 5));
Исключение
КонецПопытки;
М("CONCAT.IDIOM.RESULT_TYPE", Р);

// =====================================================================
// СТРОКА В АРИФМЕТИКЕ: обратное направление приведения
// =====================================================================
//
// `"5" - 1` даёт 4 — значит у `-` и `*` строка приводится к ЧИСЛУ, тогда
// как у `+` строка слева, наоборот, тянет правый операнд к себе. Здесь
// выясняются границы этого приведения: что считается числом, а что нет.

Р = "<ошибка>";
Попытка
	Р = "5" / 2;
Исключение
КонецПопытки;
М("ARITH.STR.DIVIDE", Р);

Р = "<ошибка>";
Попытка
	Р = 1 - "5";
Исключение
КонецПопытки;
М("ARITH.STR.RIGHT_SIDE", Р);

Р = "<ошибка>";
Попытка
	Р = "абв" - 1;
Исключение
КонецПопытки;
М("ARITH.STR.NOT_A_NUMBER", Р);

Р = "<ошибка>";
Попытка
	Р = "" - 1;
Исключение
КонецПопытки;
М("ARITH.STR.EMPTY", Р);

Р = "<ошибка>";
Попытка
	Р = " 5 " - 1;
Исключение
КонецПопытки;
М("ARITH.STR.PADDED", Р);

// Дробная часть: у платформы разделитель запятая, а в исходном тексте
// программы — точка. Что понимает приведение — вопрос отдельный.
Р = "<ошибка>";
Попытка
	Р = "5.5" - 1;
Исключение
КонецПопытки;
М("ARITH.STR.DOT_DECIMAL", Р);

Р = "<ошибка>";
Попытка
	Р = "5,5" - 1;
Исключение
КонецПопытки;
М("ARITH.STR.COMMA_DECIMAL", Р);

// Разделитель групп внутри строки — то, что сама платформа и печатает.
Р = "<ошибка>";
Попытка
	Р = ("" + 1000.5) - 0.5;
Исключение
КонецПопытки;
М("ARITH.STR.ROUND_TRIP", Р);

Р = "<ошибка>";
Попытка
	Р = -"5";
Исключение
КонецПопытки;
М("ARITH.STR.UNARY_MINUS", Р);

// Нестроковые операнды в арифметике.
Р = "<ошибка>";
Попытка
	Р = Истина + 1;
Исключение
КонецПопытки;
М("ARITH.BOOL.PLUS", Р);

Р = "<ошибка>";
Попытка
	Р = Неопределено + 1;
Исключение
КонецПопытки;
М("ARITH.UNDEFINED.PLUS", Р);

// Дата плюс строка: у нас ветка даты перехватывает пару раньше, чем дошло
// бы до приведения, поэтому случай нужен отдельно.
Р = "<ошибка>";
Попытка
	Р = Строка('20240115103000' + "60");
Исключение
КонецПопытки;
М("ARITH.DATE.PLUS_STRING", Р);

// Число слева, ЧИСЛОВАЯ строка справа: без этого случая непонятно, что
// делать в `+`, — предыдущая проба брала «]», а он числом не притворяется.
Р = "<ошибка>";
Попытка
	Р = 5 + "3";
Исключение
КонецПопытки;
М("ARITH.NUM.PLUS_NUMERIC_STRING", Р);

Р = "<ошибка>";
Попытка
	Р = Истина + "3";
Исключение
КонецПопытки;
М("ARITH.BOOL.PLUS_NUMERIC_STRING", Р);

// Строка слева, булево справа — склейка обязана победить арифметику.
Р = "<ошибка>";
Попытка
	Р = "5" + Истина;
Исключение
КонецПопытки;
М("ARITH.STR.PLUS_BOOL", Р);

// =====================================================================
// ОБОБЩЕНИЕ: булево и строка в остальных операциях
// =====================================================================
//
// `Истина + 1` даёт 2, но распространяется ли это на вычитание, умножение
// и унарный минус — вопрос отдельный, и додумывать его нельзя.

Р = "<ошибка>";
Попытка
	Р = Истина - 1;
Исключение
КонецПопытки;
М("ARITH.BOOL.MINUS", Р);

Р = "<ошибка>";
