Р = "<ошибка>";
Попытка
	Р = -Истина;
Исключение
КонецПопытки;
М("ARITH.BOOL.UNARY_MINUS", Р);

// Остаток от деления: оператор `%` разбирается наравне с `*` и `/`.
Р = "<ошибка>";
Попытка
	Р = "7" % 2;
Исключение
КонецПопытки;
М("ARITH.STR.MODULO", Р);

Р = "<ошибка>";
Попытка
	Р = "" + ("5" > 1);
Исключение
КонецПопытки;
М("ARITH.STR.COMPARE_GREATER", Р);

Р = "<ошибка>";
Попытка
	Р = "" + ("5" = 5);
Исключение
КонецПопытки;
М("ARITH.STR.COMPARE_EQUAL", Р);

Р = "<ошибка>";
Попытка
	Р = "" + (Истина = 1);
Исключение
КонецПопытки;
М("ARITH.BOOL.COMPARE_EQUAL", Р);

