// Замеры контракта файловой пары внутреннего формата (`ЗначениеВФайл` /
// `ЗначениеИзФайла`), снимаемые на 8.3.27.
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-vfile.bsl
//
// Правила те же, что у соседних контрактов: строка `ИД<таб>ЗНАЧЕНИЕ`,
// скрипт исполняется И НАШИМ интерпретатором, сличение построчное. Все ИД
// — под-замеры вопроса `VSTR.FORMAT`.
//
// Байтовое устройство файла (UTF-8 с BOM, переводы строк CRLF даже внутри
// строковых значений) отсюда не видно — оно измерено побайтовым сравнением
// файлов обеих сторон и закреплено юнитом
// `file_pair_matches_the_platform_byte_for_byte_and_round_trips` в
// `bsl-rt/src/vstr.rs`. Здесь — семантика: дорога значения через файл и
// ошибки.
//
// СТРОКИ, КОТОРЫЕ СХОДИТЬСЯ НЕ ОБЯЗАНЫ:
//   VSTR.FORMAT.FILE.BADDIR — запись в несуществующий каталог платформа
//   МОЛЧА проглатывает (файл не создаётся, ошибки нет — измерено), здесь
//   это ошибка: молчаливая потеря данных хуже несовместимости.
//
// Путь фиксированный во временном каталоге: сеанс замеров локальный, обе
// стороны работают на одной машине.

Функция Путь(Имя)
	Возврат "/tmp/open-bsl-measure-vfile-" + Имя + ".txt";
КонецФункции

Процедура П(Метка, Значение)
	Сообщить(Метка + Символ(9) + Значение);
КонецПроцедуры

// Значение с «неудобной» строкой: кавычка и перевод строки внутри.
Таблица = Новый ТаблицаЗначений;
Таблица.Колонки.Добавить("Имя");
Таблица.Колонки.Добавить("Возраст", Новый ОписаниеТипов("Число"));
Стр = Таблица.Добавить();
Стр.Имя = "а""б" + Символ(10) + "в";
Стр.Возраст = 7;

Р = "";
Попытка
	ЗначениеВФайл(Путь("rt"), Таблица);
	Обратно = ЗначениеИзФайла(Путь("rt"));
	Если ЗначениеВСтрокуВнутр(Обратно) = ЗначениеВСтрокуВнутр(Таблица) Тогда
		Р = "Ок " + Формат(СтрДлина(Обратно[0].Имя), "ЧГ=0");
	Иначе
		Р = "изменилось";
	КонецЕсли;
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("VSTR.FORMAT.FILE.RT", Р);

// Перевод строки внутри значения переживает дорогу (CRLF-нормализация).
Р = "";
Попытка
	ЗначениеВФайл(Путь("lf"), "а" + Символ(10) + "б");
	Прочитано = ЗначениеИзФайла(Путь("lf"));
	Если Прочитано = "а" + Символ(10) + "б" Тогда
		Р = "Ок " + Формат(СтрДлина(Прочитано), "ЧГ=0");
	Иначе
		Р = "изменилось: " + Формат(СтрДлина(Прочитано), "ЧГ=0") + " симв.";
	КонецЕсли;
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("VSTR.FORMAT.FILE.LF", Р);

// Ссылка объекта базы через файл (текст — из конфигурации измерительной
// базы, см. measure-vstr.bsl).
Р = "";
Попытка
	СсылкаТекст = "{""#"",c0c2cbee-990e-410d-9c63-b5222c1dacba,53:866e48f17f20bbba11f190e0bddf9004}";
	ЗначениеВФайл(Путь("ref"), ЗначениеИзСтрокиВнутр(СсылкаТекст));
	Если ЗначениеВСтрокуВнутр(ЗначениеИзФайла(Путь("ref"))) = СсылкаТекст Тогда
		Р = "Ок";
	Иначе
		Р = "изменилось";
	КонецЕсли;
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("VSTR.FORMAT.FILE.REF", Р);

// Ошибки: несуществующий файл, пустой файл, мусор.
Р = "";
Попытка
	Х = ЗначениеИзФайла(Путь("нет-такого"));
	Р = "принято";
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("VSTR.FORMAT.FILE.MISSING", Р);

Р = "";
Попытка
	Пустой = Новый ЗаписьТекста(Путь("empty"));
	Пустой.Закрыть();
	Х = ЗначениеИзФайла(Путь("empty"));
	Р = "принято";
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("VSTR.FORMAT.FILE.EMPTY", Р);

Р = "";
Попытка
	Мусор = Новый ЗаписьТекста(Путь("garbage"));
	Мусор.Записать("не формат");
	Мусор.Закрыть();
	Х = ЗначениеИзФайла(Путь("garbage"));
	Р = "принято";
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("VSTR.FORMAT.FILE.GARBAGE", Р);

// Сознательное расхождение: платформа молчит, мы — ошибка (см. шапку).
Р = "";
Попытка
	ЗначениеВФайл("/tmp/open-bsl-нет-каталога/файл.txt", 1);
	Р = "принято";
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("VSTR.FORMAT.FILE.BADDIR", Р);
