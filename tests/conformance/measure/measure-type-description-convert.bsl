// Преобразование Retry-After в Connector 2.6.0: целое число и
// нормализованная RFC7231-дата из 14 цифр.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция БулевоСтрокой(Значение)
	Если Значение Тогда
		Возврат "true";
	КонецЕсли;
	Возврат "false";
КонецФункции

ОписаниеЧисла = Новый ОписаниеТипов("Число");
М("HTTP.TYPECONV.DESCRIPTION.TYPE", БулевоСтрокой(
	ТипЗнч(ОписаниеЧисла) = Тип("ОписаниеТипов")));
М("HTTP.TYPECONV.NUMBER.POSITIVE", ОписаниеЧисла.ПривестиЗначение("123"));
М("HTTP.TYPECONV.NUMBER.NEGATIVE", ОписаниеЧисла.ПривестиЗначение("-42"));

НегодноеЧисло = "<ошибка>";
Попытка
	НегодноеЧисло = ОписаниеЧисла.ПривестиЗначение("abc");
Исключение
КонецПопытки;
М("HTTP.TYPECONV.NUMBER.INVALID", НегодноеЧисло);

М("HTTP.TYPECONV.DATEPART.DISPLAY", ЧастиДаты.ДатаВремя);
М("HTTP.TYPECONV.DATEPART.TYPE", БулевоСтрокой(
	ТипЗнч(ЧастиДаты.ДатаВремя) = Тип("DateFractions")));
КвалификаторДаты = Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя);
М("HTTP.TYPECONV.DATEQUAL.TYPE", БулевоСтрокой(
	ТипЗнч(КвалификаторДаты) = Тип("КвалификаторыДаты")));
ОписаниеДаты = Новый ОписаниеТипов(
	"Дата", Неопределено, Неопределено, КвалификаторДаты);
ДатаИзСтроки = ОписаниеДаты.ПривестиЗначение("20241106123456");
М("HTTP.TYPECONV.DATE.EXACT", БулевоСтрокой(
	ДатаИзСтроки = Дата(2024, 11, 6, 12, 34, 56)));
М("HTTP.TYPECONV.DATE.TYPE", БулевоСтрокой(
	ТипЗнч(ДатаИзСтроки) = Тип("Дата")));

НегоднаяДата = "<ошибка>";
Попытка
	НегоднаяДата = ОписаниеДаты.ПривестиЗначение("20240230010203");
Исключение
КонецПопытки;
М("HTTP.TYPECONV.DATE.INVALID", БулевоСтрокой(
	НегоднаяДата = Дата(1, 1, 1)));
