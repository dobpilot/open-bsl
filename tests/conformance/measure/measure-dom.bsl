// Контракт подсистемы DOM на чтение: `ПостроительDOM`, `ДокументDOM` и
// модель узлов, снятая на 8.3.27.
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-dom.bsl
//
// Правила те же, что у `measure-binbuf.bsl`: строка `МЕТКА<таб>ЗНАЧЕНИЕ`,
// скрипт исполняется И НАШИМ интерпретатором, сличение построчное. Строк
// `М()` здесь нет намеренно: реестру открытых вопросов этот файл ничего не
// должен, а `.expected` у него нет и быть не должно — контракт сличается
// вручную.
//
// ПОЧЕМУ ВСЁ ЧЕРЕЗ `Вычислить` И `Выполнить`. Неизвестное имя типа или
// метода наш резолвер отвергает НА ЭТАПЕ КОМПИЛЯЦИИ: прямой вызов сломал
// бы не строку, а весь скрипт на нашей стороне — так и было, пока этой
// подсистемы здесь не существовало. Внутри `Вычислить`/`Выполнить`
// фрагмент компилируется во время исполнения, и отказ становится ловимым.
// Приёмники проб — переменные МОДУЛЯ (`Перем` ниже): локальных переменных
// вызывающей процедуры фрагмент в модуле формы не видит, а область модуля
// видит (якорь `SCOPE.MODULE_VARS_IN_EXEC` в `measure-all.bsl`).
//
// ЧЕГО ЗДЕСЬ НЕТ И ПОЧЕМУ — ПОВТОРНОГО `Прочитать` С ТЕМ ЖЕ ЧИТАТЕЛЕМ.
// Проба
//
//   Д1 = П1.Прочитать(Ч1); Д2 = П1.Прочитать(Ч1);
//
// УБИВАЕТ ПЛАТФОРМУ: прогон снимается по таймауту, вывода нет вообще,
// причём разностный прогон, отличающийся только этой строкой, проходит
// штатно. Держать такую строку в контракте нельзя — она уносит весь
// сеанс, а не одну пробу. Наш ответ на этот случай (исчерпанный читатель
// даёт пустой документ) описан в шапке `bsl-rt/src/dom.rs` как
// сознательное расхождение: измерить платформу здесь невозможно в
// принципе.
//
// ИЗМЕРЕНО 12.08.2026 на 8.3.27.2130.

Перем Док;
Перем Э;
Перем Узел;
Перем Атр;
Перем Соб;
Перем ИсточникXML;

Процедура П(Метка, Значение)
	Сообщить(Метка + Символ(9) + Значение);
КонецПроцедуры

Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Р = СтрЗаменить(Р, Символ(10), "<ПС>");
	Р = СтрЗаменить(Р, Символ(9), "<Т>");
	Возврат Р;
КонецФункции

// Проба ВЫРАЖЕНИЯ: тип результата и его строковое представление.
Функция Ч(Выражение)
	Попытка
		Р = Вычислить(Выражение);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Попытка
		Возврат Строка(ТипЗнч(Р)) + " [" + Видимо(Строка(Р)) + "]";
	Исключение
		Возврат Строка(ТипЗнч(Р)) + " <не печатается>";
	КонецПопытки;
КонецФункции

// Проба ОПЕРАТОРА: важен сам факт, что фрагмент принят.
Функция Оп(Код)
	Попытка
		Выполнить(Код);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат "ок";
КонецФункции

// Сбор в модульную переменную `Соб`.
Функция Сбор(Код)
	Попытка
		Соб = "";
		Выполнить(Код);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат Видимо(Соб);
КонецФункции

// Разбор произвольного текста и дамп детей ДОКУМЕНТА.
Функция ДампДок(Текст)
	Попытка
		ИсточникXML = Текст;
		Соб = "";
		Выполнить("П1 = Новый ПостроительDOM; Ч1 = Новый ЧтениеXML; Ч1.УстановитьСтроку(ИсточникXML); Д = П1.Прочитать(Ч1);
			|Для н = 0 По Д.ДочерниеУзлы.Количество() - 1 Цикл У = Д.ДочерниеУзлы[н]; Соб = Соб + Строка(У.ТипУзла) + "":"" + У.ИмяУзла + ""=["" + Строка(У.ЗначениеУзла) + ""] ""; КонецЦикла;");
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат Видимо(Соб);
КонецФункции

// Разбор и дамп детей КОРНЕВОГО ЭЛЕМЕНТА вместе с его содержимым.
Функция ДампКорня(Текст)
	Попытка
		ИсточникXML = Текст;
		Соб = "";
		Выполнить("П1 = Новый ПостроительDOM; Ч1 = Новый ЧтениеXML; Ч1.УстановитьСтроку(ИсточникXML); Д = П1.Прочитать(Ч1); К = Д.ЭлементДокумента;
			|Для н = 0 По К.ДочерниеУзлы.Количество() - 1 Цикл У = К.ДочерниеУзлы[н]; Соб = Соб + Строка(У.ТипУзла) + "":"" + У.ИмяУзла + ""=["" + Строка(У.ЗначениеУзла) + ""] ""; КонецЦикла;
			|Соб = Соб + ""| содержимое=["" + Строка(К.ТекстовоеСодержимое) + ""]"";");
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
	Возврат Видимо(Соб);
КонецФункции

