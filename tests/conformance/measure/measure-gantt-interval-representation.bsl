Сообщить("gantt.ROOT" + Символ(9) + Строка(ОтображениеИнтервалаДиаграммыГанта));
Сообщить("gantt.TYPE" + Символ(9) + Строка(ТипЗнч(ОтображениеИнтервалаДиаграммыГанта.Плоский)));
Сообщить("gantt.Flat" + Символ(9) + Строка(ОтображениеИнтервалаДиаграммыГанта.Плоский));
Сообщить("gantt.ThreeDimensional" + Символ(9) + Строка(ОтображениеИнтервалаДиаграммыГанта.Объемный));
Сообщить("gantt.Rhomb" + Символ(9) + Строка(ОтображениеИнтервалаДиаграммыГанта.Ромб));
Сообщить("gantt.Gradient" + Символ(9) + Строка(ОтображениеИнтервалаДиаграммыГанта.Градиент));
Если ОтображениеИнтервалаДиаграммыГанта.Плоский = GanttChartIntervalRepresentation.Flat
    И ОтображениеИнтервалаДиаграммыГанта.Объемный = GanttChartIntervalRepresentation.ThreeDimensional
    И ОтображениеИнтервалаДиаграммыГанта.Ромб = GanttChartIntervalRepresentation.Rhomb
    И ОтображениеИнтервалаДиаграммыГанта.Градиент = GanttChartIntervalRepresentation.Gradient Тогда
    Сообщить("gantt.ALIASES" + Символ(9) + "PASS");
Иначе
    Сообщить("gantt.ALIASES" + Символ(9) + "FAIL");
КонецЕсли;
Если отображениеинтерваладиаграммыганта.плоский = GanttChartIntervalRepresentation.Flat Тогда
    Сообщить("gantt.FOLDED" + Символ(9) + "PASS");
Иначе
