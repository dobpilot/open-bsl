Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("CHARS.LF", КодСимвола(Символы.ПС));
М("CHARS.CR", КодСимвола(Символы.ВК));

Результат = "ошибка";
Попытка
	Результат = КодСимвола(Chars.LF);
Исключение
КонецПопытки;
М("CHARS.ENGLISH.LF", Результат);

Результат = "ошибка";
