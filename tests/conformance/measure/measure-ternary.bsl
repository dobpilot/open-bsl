// Замеры тернарного `?(Условие, Тогда, Иначе)`, снимаемые на 8.3.27.
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/measure/measure-ternary.bsl
//
// Правила те же, что у соседних скриптов: строка `ИД<таб>ЗНАЧЕНИЕ`, скрипт
// исполняется И НАШИМ интерпретатором, отказ — маркером `<ошибка>`.
//
// ЗАЧЕМ. Главный вопрос — ЛЕНИВОСТЬ. Если платформа вычисляет обе ветви, то
// `?(Знач <> Неопределено, Знач.Поле, "")` обязано падать, и такой оборот
// в коде 1С не встречался бы; если ленива — это короткое замыкание, и
// компилировать `?()` надо переходами, а не тремя вычисленными регистрами.
// Догадка тут стоила бы дорого: неверная реализация ломает не выражение, а
// целый способ писать защитные проверки.
//
// ПРО `Вычислить`. Пробы на ЧИСЛО АРГУМЕНТОВ остались в нём намеренно: у
// платформы неверная арность `?()` — ошибка компиляции, и написанная прямо
// в тексте она сорвала бы весь прогон, а не одну строку. Остальные пробы
// написаны прямо: оператор разбирается обеими сторонами.
//
// Делитель берётся как `Число("0")`, а не литералом: константу платформа
// вправе свернуть на этапе компиляции, и тогда проба мерила бы сворачивание,
// а не ленивость.

Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Р = СтрЗаменить(Р, Символ(10), "<ПС>");
	Р = СтрЗаменить(Р, Символ(9), "<Т>");
	Р = СтрЗаменить(Р, Символ(160), "<НП>");
	Возврат Р;
КонецФункции

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Видимо(Строка(Значение)));
КонецПроцедуры

Функция Проба(Выражение)
	Попытка
		Возврат Строка(Вычислить(Выражение));
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
КонецФункции

// =====================================================================
// ЛЕНИВОСТЬ
// =====================================================================
//
// Невыбранная ветвь заведомо падает делением на ноль. Уцелел результат —
// значит она не вычислялась.

Р = "<ошибка>";
Попытка
	Р = ?(Истина, "ок", 1 / Число("0"));
Исключение
КонецПопытки;
М("TERNARY.LAZY_TRUE", Р);
Р = "<ошибка>";
Попытка
	Р = ?(Ложь, 1 / Число("0"), "ок");
Исключение
КонецПопытки;
М("TERNARY.LAZY_FALSE", Р);

// Обе ветви годные — обычный случай, для сверки с ленивыми.
Р = "<ошибка>";
Попытка
	Р = ?(Истина, "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.PLAIN_TRUE", Р);
Р = "<ошибка>";
Попытка
	Р = ?(Ложь, "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.PLAIN_FALSE", Р);

// =====================================================================
// УСЛОВИЕ
// =====================================================================
//
// В BSL условия строго булевы: `Если 1 Тогда` — ошибка. Распространяется
// ли это на `?()`, и не смягчает ли дело приведение типов (число к булеву
// платформа в арифметике приводит, а вот в условии — вопрос).

Р = "<ошибка>";
Попытка
	Р = ?(1, "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.CONDITION_NUMBER", Р);
Р = "<ошибка>";
Попытка
	Р = ?(0, "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.CONDITION_ZERO", Р);
Р = "<ошибка>";
Попытка
	Р = ?("Истина", "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.CONDITION_STRING", Р);
Р = "<ошибка>";
Попытка
	Р = ?(Неопределено, "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.CONDITION_UNDEFINED", Р);
Р = "<ошибка>";
Попытка
	Р = ?(2 > 1, "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.CONDITION_EXPR", Р);

// =====================================================================
// ВЕТВИ И ВЛОЖЕНИЕ
// =====================================================================

// Типы ветвей могут не совпадать: тип результата — у выбранной.
Р = "<ошибка>";
Попытка
	Р = Строка(ТипЗнч(?(Истина, 5, "строка")));
Исключение
КонецПопытки;
М("TERNARY.TYPE_OF_RESULT", Р);
Р = "<ошибка>";
Попытка
	Р = Строка(ТипЗнч(?(Ложь, 5, "строка")));
Исключение
КонецПопытки;
М("TERNARY.TYPE_OF_RESULT_ELSE", Р);

Р = "<ошибка>";
Попытка
	Р = ?(Истина, ?(Ложь, "а", "б"), "в");
Исключение
КонецПопытки;
М("TERNARY.NESTED_IN_THEN", Р);
Р = "<ошибка>";
Попытка
	Р = ?(Ложь, "а", ?(Истина, "б", "в"));
Исключение
КонецПопытки;
М("TERNARY.NESTED_IN_ELSE", Р);
Р = "<ошибка>";
Попытка
	Р = ?(?(Истина, Истина, Ложь), "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.NESTED_IN_CONDITION", Р);

// Внутри выражения: результат обязан склеиваться дальше как обычное
// значение.
Р = "<ошибка>";
Попытка
	Р = "[" + ?(Истина, 1, 2) + "]";
Исключение
КонецПопытки;
М("TERNARY.INSIDE_EXPRESSION", Р);
Р = "<ошибка>";
Попытка
	Р = СтрДлина(?(Истина, "абвг", ""));
Исключение
КонецПопытки;
М("TERNARY.AS_ARGUMENT", Р);

// Ветвь как вызов функции — заодно ещё одна проверка ленивости, теперь на
// стороне значения, а не ошибки.
Р = "<ошибка>";
Попытка
	Р = ?(Истина, СтрДлина("абв"), СтрДлина("аб"));
Исключение
КонецПопытки;
М("TERNARY.CALL_IN_BRANCH", Р);

// =====================================================================
// ЧИСЛО АРГУМЕНТОВ
// =====================================================================
//
// Ожидается ровно три. Меньше и больше — отдельными пробами: у платформы
// это ошибка компиляции фрагмента, и она тоже ловится `Вычислить`.

М("TERNARY.ARITY_TWO", Проба("?(Истина, ""да"")"));
М("TERNARY.ARITY_FOUR", Проба("?(Истина, ""да"", ""нет"", ""лишнее"")"));
М("TERNARY.ARITY_ONE", Проба("?(Истина)"));

// =====================================================================
// ЧТО ИМЕННО СЧИТАЕТСЯ УСЛОВИЕМ
// =====================================================================
//
// Число условием работает (1 — да, 0 — нет), и строка тоже. Значит либо
// условие приводится к булеву как в `Булево()`, либо непустая строка
// истинна сама по себе. Разницу видно на «Ложь» и на мусоре.

Р = "<ошибка>";
Попытка
	Р = ?("Ложь", "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.CONDITION_FALSE_WORD", Р);
Р = "<ошибка>";
Попытка
	Р = ?("абв", "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.CONDITION_WORD_OTHER", Р);
Р = "<ошибка>";
Попытка
	Р = ?("", "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.CONDITION_EMPTY_STRING", Р);
Р = "<ошибка>";
Попытка
	Р = ?("0", "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.CONDITION_STRING_ZERO", Р);
Р = "<ошибка>";
Попытка
	Р = ?("1", "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.CONDITION_STRING_ONE", Р);
Р = "<ошибка>";
Попытка
	Р = ?(-1, "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.CONDITION_NEGATIVE", Р);
Р = "<ошибка>";
Попытка
	Р = ?(0.5, "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.CONDITION_FRACTION", Р);
Р = "<ошибка>";
Попытка
	Р = ?('20240115', "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.CONDITION_DATE", Р);
Р = "<ошибка>";
Попытка
	Р = ?('00010101', "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.CONDITION_EMPTY_DATE", Р);
Р = "<ошибка>";
Попытка
	Р = ?(Новый Массив, "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.CONDITION_ARRAY", Р);
Р = "<ошибка>";
Попытка
	Р = ?(Null, "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.CONDITION_NULL", Р);

// =====================================================================
// ТО ЖЕ САМОЕ У ОБЫЧНОГО `Если`
// =====================================================================
//
// Если `Если` строг, а `?()` нет — это разные правила в одном языке, и
// знать об этом надо точно. Здесь `Если` пишется прямо: он разбирается
// обеими сторонами.

Р = "<ошибка>";
Попытка
	Если 1 Тогда
		Р = "да";
	Иначе
		Р = "нет";
	КонецЕсли;
Исключение
КонецПопытки;
М("COND.IF_NUMBER_ONE", Р);

Р = "<ошибка>";
Попытка
	Если 0 Тогда
		Р = "да";
	Иначе
		Р = "нет";
	КонецЕсли;
Исключение
КонецПопытки;
М("COND.IF_NUMBER_ZERO", Р);

Р = "<ошибка>";
Попытка
	Если "абв" Тогда
		Р = "да";
	Иначе
		Р = "нет";
	КонецЕсли;
Исключение
КонецПопытки;
М("COND.IF_STRING", Р);

Р = "<ошибка>";
Попытка
	Если Неопределено Тогда
		Р = "да";
	Иначе
		Р = "нет";
	КонецЕсли;
Исключение
КонецПопытки;
М("COND.IF_UNDEFINED", Р);

// Отрицание и логические связки на нечисловом условии.
Р = "<ошибка>";
Попытка
	Р = Строка(Не 1);
Исключение
КонецПопытки;
М("COND.NOT_NUMBER", Р);

Р = "<ошибка>";
Попытка
	Р = Строка(1 И Истина);
Исключение
КонецПопытки;
М("COND.AND_NUMBER", Р);

Р = "<ошибка>";
Попытка
	Р = Строка(0 ИЛИ Истина);
Исключение
КонецПопытки;
М("COND.OR_NUMBER", Р);

// Цикл `Пока` — третье место с условием.
Р = "<ошибка>";
Попытка
	Счёт = 0;
	Пока Счёт < 3 Цикл
		Счёт = Счёт + 1;
	КонецЦикла;
	Р = Строка(Счёт);
Исключение
КонецПопытки;
М("COND.WHILE_NORMAL", Р);

// Строка условием принимается ТОЛЬКО словами «Истина»/«Ложь» — «абв», «0»
// и «1» отвергнуты. Осталось выяснить регистр, пробелы и английские
// написания: от этого зависит, чем приводить строку в реализации.

Р = "<ошибка>";
Попытка
	Р = ?("истина", "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.CONDITION_LOWER", Р);
Р = "<ошибка>";
Попытка
	Р = ?("ИСТИНА", "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.CONDITION_UPPER", Р);
Р = "<ошибка>";
Попытка
	Р = ?(" Истина ", "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.CONDITION_PADDED", Р);
Р = "<ошибка>";
Попытка
	Р = ?("Да", "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.CONDITION_YES_WORD", Р);
Р = "<ошибка>";
Попытка
	Р = ?("True", "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.CONDITION_TRUE_WORD", Р);
// Проба `Строка(Булево("Истина"))` здесь была и убрана: встроенной
// функции `Булево` у нас пока нет вовсе, а правило приведения условия и
// без неё измерено двумя десятками проб напрямую.

Р = "<ошибка>";
Попытка
	Если "Истина" Тогда
		Р = "да";
	Иначе
		Р = "нет";
	КонецЕсли;
Исключение
КонецПопытки;
М("COND.IF_STRING_TRUE", Р);

Р = "<ошибка>";
Попытка
	Р = Строка(Не "Ложь");
Исключение
КонецПопытки;
М("COND.NOT_STRING", Р);

// Набор принимаемых слов целиком: он и будет таблицей в реализации.
Р = "<ошибка>";
Попытка
	Р = ?("Нет", "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.WORD_NO", Р);
Р = "<ошибка>";
Попытка
	Р = ?("False", "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.WORD_FALSE_EN", Р);
Р = "<ошибка>";
Попытка
	Р = ?("ложь", "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.WORD_LOZH_LOWER", Р);
Р = "<ошибка>";
Попытка
	Р = ?("нет", "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.WORD_NO_LOWER", Р);
Р = "<ошибка>";
Попытка
	Р = ?("yes", "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.WORD_YES_EN", Р);
Р = "<ошибка>";
Попытка
	Р = ?("no", "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.WORD_NO_EN", Р);
Р = "<ошибка>";
Попытка
	Р = ?("Y", "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.WORD_Y", Р);
Р = "<ошибка>";
Попытка
	Р = ?("true", "да", "нет");
Исключение
КонецПопытки;
М("TERNARY.WORD_TRUE_LOWER", Р);

// Логические связки на числе: результат — то, что осталось в регистре, и
// стоит проверить, что платформа отдаёт именно булево.
Р = "<ошибка>";
Попытка
	Р = Строка(1 И 1);
Исключение
КонецПопытки;
М("COND.AND_BOTH_NUMBERS", Р);

Р = "<ошибка>";
Попытка
	Р = Строка(Истина И 1);
Исключение
КонецПопытки;
М("COND.AND_BOOL_NUMBER", Р);
