// Одноразовая СЪЁМКА образца PDF С ВЛОЖЕНИЯМИ с реальной платформы 8.3.27.
//
// Скрипт не является замером в смысле `open_questions.rs`: он ничего не
// сверяет построчно и исполняется ТОЛЬКО платформой — как соседний
// `capture-platform-pdf.bsl`. Его дело — сложить файл, вложения в который
// положила САМА платформа, чтобы наш читатель разбирался с настоящим
// чужим контейнером, а не с тем, что мы же и написали.
//
// Прогон:
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/pdf/capture-platform-attachments.bsl
//
// ПРОИСХОЖДЕНИЕ СНЯТОГО ФАЙЛА (он лежит рядом, `attach-platform.pdf`, и
// закоммичен вместе со скриптом): 1С:Предприятие 8.3.27.2130, Linux
// x86-64, 15 августа 2026 года, той самой командой выше. Вывод прогона —
// в `capture-platform-attachments.platform.txt`.
//
// Пересъёмка даст ДРУГИЕ БАЙТЫ, и не только из-за `/ID`: платформа пишет
// в каждое вложение `/Params` с `/CreationDate` и `/ModDate` по часам
// машины. Поэтому файл снят один раз и закоммичен; эталон конформанса
// `pdf-attachments.expected` снят с платформы уже по НЕМУ.
//
// Что в файле, кроме одной страницы табличного документа:
//
//   * «накладная.txt» — кириллица и в имени, и в содержимом, тип
//     `text/plain`, связь не указана;
//   * «данные.bin» — латиница, `application/octet-stream`, связь
//     `ТипСвязиВложенияPDF.Данные`;
//   * «источник.xml» — `application/xml`, связь
//     `ТипСвязиВложенияPDF.Источник`.
//
// Каждая проба — в Попытка: необработанное исключение в модуле формы
// платформа показывает модальным окном, то есть немым таймаутом в 180 с.

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

ПутьОснова = "/tmp/open-bsl-attach-base.pdf";
ПутьВыход = "tests/conformance/pdf/attach-platform.pdf";

// Основа — обычный табличный документ, записанный в PDF: своего способа
// создать документ с нуля у «ДокументPDF» нет (измерено — `Записать` у
// непрочитанного документа кончается ошибкой).
Попытка
	ТабДок = Новый ТабличныйДокумент;
	ОбластьЯчейки = ТабДок.Область(1, 1, 1, 1);
	ОбластьЯчейки.Текст = "Накладная № 7";
	ОбластьЯчейки = ТабДок.Область(2, 1, 2, 1);
	ОбластьЯчейки.Текст = "Товар";
	ОбластьЯчейки = ТабДок.Область(2, 2, 2, 2);
	ОбластьЯчейки.Текст = "Гвоздь строительный";
	ТабДок.Записать(ПутьОснова, ТипФайлаТабличногоДокумента.PDF);
	П("основа", "да");
Исключение
	П("основа", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

Попытка
	Док = Новый ДокументPDF;
	Док.Прочитать(ПутьОснова);
	П("прочитана основа", "страниц " + Строка(Док.Страницы.Количество()));

	Док.Вложения.Добавить("накладная.txt",
		ПолучитьДвоичныеДанныеИзСтроки("Привет, вложение!"), "text/plain");
	Док.Вложения.Добавить("данные.bin",
		ПолучитьДвоичныеДанныеИзСтроки("0123456789"), "application/octet-stream",
		ТипСвязиВложенияPDF.Данные);
	Док.Вложения.Добавить("источник.xml",
		ПолучитьДвоичныеДанныеИзСтроки("<a>текст</a>"), "application/xml",
		ТипСвязиВложенияPDF.Источник);
	П("вложений добавлено", Строка(Док.Вложения.Количество()));

	Док.Записать(ПутьВыход);
	П("запись", "да");
Исключение
	П("запись", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

Попытка
	ФайлPDF = Новый Файл(ПутьВыход);
	П("существует", ФайлPDF.Существует());
	П("полное имя", ФайлPDF.ПолноеИмя);
	П("размер", ФайлPDF.Размер());
Исключение
	П("файл", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

// Перечитываем снятый файл ЕЮ ЖЕ: в выводе останется то, что платформа
// сама считает содержимым этого контейнера.
Попытка
	Обратно = Новый ДокументPDF;
	Обратно.Прочитать(ПутьВыход);
	П("перечитано вложений", Строка(Обратно.Вложения.Количество()));
	Для Каждого Вл Из Обратно.Вложения Цикл
		П("вложение", "[" + Вл.ИмяФайла + "] [" + Вл.ТипСодержимого + "] ["
			+ Строка(Вл.ТипСвязи) + "] ["
			+ ПолучитьСтрокуИзДвоичныхДанных(Вл.Содержимое, "UTF-8") + "]");
	КонецЦикла;
Исключение
	П("перечитано", "ошибка: " + ОписаниеОшибки());
КонецПопытки;
