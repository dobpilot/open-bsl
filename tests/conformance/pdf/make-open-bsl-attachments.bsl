// Сборка ДВУХ файлов НАШИМ писателем — обратная сторона круговой сверки.
//
// Соседний `capture-platform-attachments.bsl` снимает файл, вложения в
// который положила платформа: она кладёт — мы читаем. Здесь наоборот: мы
// кладём — платформа читает. Оба файла лежат в дереве, и оба читает
// `tests/conformance/measure/measure-pdf-attachments.bsl` — обеими
// сторонами сразу, построчным диффом.
//
// Скрипт исполняется ЭТИМ интерпретатором (не платформой) и целиком
// воспроизводим:
//
//   cargo run -p bsl-cli -- tests/conformance/pdf/make-open-bsl-attachments.bsl
//
// ПРОИСХОЖДЕНИЕ обоих файлов — этот скрипт, open-bsl, 15 августа 2026
// года. Вывод детерминирован до байта: `/ID` наш писатель не пишет вовсе,
// `/CreationDate` и `/ModDate` (их пишет платформа) — тоже, а deflate
// здесь свой и от часов не зависит. Значит, перезапуск скрипта обязан
// дать те же байты, и расхождение — это дефект, а не «просто другой
// прогон».
//
// Файлов два, потому что вопросов два, и оба про то, что лежит ПОД
// нашим инкрементальным обновлением:
//
//   * `attach-open-bsl.pdf` — основа с классической таблицей `xref`. Её
//     писала САМА платформа: это `platform-simple.pdf`, снятый задачей о
//     чтении PDF. То есть в этом файле нижние 8045 байт — платформенные,
//     а хвост — наш;
//   * `attach-open-bsl-xrefstream.pdf` — основа с XREF-ПОТОКОМ и
//     объектным потоком `/ObjStm` (PDF 1.5). Такую основу платформа не
//     пишет, поэтому она собрана байтами: те же 490 байт, что стоят в
//     `measure-pdf-read.bsl` под именем `ШестнПоток` (две страницы,
//     каталог и дерево страниц — внутри `/ObjStm`). Вопрос, ради
//     которого файл существует: возьмёт ли платформа классическую
//     секцию `xref` с `/Prev`, указывающим на xref-ПОТОК. Смешивать их
//     спецификация прямо не разрешает, и ответ измерен — берёт.

Функция Материализовать(Путь, Шестнадцатеричный)
	Буфер = Новый БуферДвоичныхДанных(СтрДлина(Шестнадцатеричный) / 2);
	Для Сч = 0 По Буфер.Размер - 1 Цикл
		Буфер[Сч] = ЧислоИзШестнадцатеричнойСтроки("0x" + Сред(Шестнадцатеричный, Сч * 2 + 1, 2));
	КонецЦикла;
	Поток = ФайловыеПотоки.Создать(Путь);
	Поток.Записать(Буфер, 0, Буфер.Размер);
	Поток.Закрыть();
	Возврат Путь;
КонецФункции

// --- 1. Поверх классической таблицы платформы ----------------------------

Док = Новый ДокументPDF;
Док.Прочитать("tests/conformance/pdf/platform-simple.pdf");
Док.Вложения.Добавить("накладная.txt",
	ПолучитьДвоичныеДанныеИзСтроки("Привет, вложение!"), "text/plain");
Док.Вложения.Добавить("данные.bin",
	ПолучитьДвоичныеДанныеИзСтроки("0123456789"), "application/octet-stream",
	ТипСвязиВложенияPDF.Данные);
Док.Вложения.Добавить("источник.xml",
	ПолучитьДвоичныеДанныеИзСтроки("<a>текст</a>"), "application/xml",
	ТипСвязиВложенияPDF.Источник);
Док.Записать("tests/conformance/pdf/attach-open-bsl.pdf");
Сообщить("attach-open-bsl.pdf: вложений " + Док.Вложения.Количество());

