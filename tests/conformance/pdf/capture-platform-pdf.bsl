// Одноразовая СЪЁМКА образца PDF с реальной платформы 8.3.27.
//
// Скрипт не является замером в смысле `open_questions.rs`: он ничего не
// сверяет построчно и исполняется ТОЛЬКО платформой. Его дело — собрать
// простой табличный документ с кириллицей, латиницей и цифрами и записать
// его `ТипФайлаТабличногоДокумента.PDF` в дерево, чтобы полученный файл
// можно было разобрать руками и увидеть, КАК платформа решает вопрос
// шрифтов и кодировок. Тот же файл служит входной фикстурой задаче чтения
// PDF.
//
// Прогон:
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/pdf/capture-platform-pdf.bsl
//
// ПРОИСХОЖДЕНИЕ СНЯТОГО ФАЙЛА (он лежит рядом, `platform-simple.pdf`, и
// закоммичен вместе со скриптом): 1С:Предприятие 8.3.27.2130, Linux x86-64,
// 14 августа 2026 года, той самой командой выше. Вывод прогона — в
// `capture-platform-pdf.platform.txt`: 8045 байт, первая строка `%PDF-1.7`.
// Заново снимать файл незачем: он не эталон поведения нашего писателя, а
// образец ЧУЖОГО решения, и его разбор записан в обзоре `bsl-rt/src/pdf.rs`.
// Пересъёмка на другой машине к тому же даст ДРУГИЕ байты — платформа
// встраивает подмножество того шрифта, который нашла в системе.
//
// Путь записи РЕЛЯТИВНЫЙ: раннер переходит в корень репозитория перед
// запуском платформы, файловая база держит «сервер» в том же процессе, и
// текущий каталог у него тот же. Скрипт печатает полное имя записанного
// файла — если платформа однажды решит иначе, это будет видно сразу, а не
// по отсутствию файла. Печатать `ТекущийКаталог()` не выходит: в
// серверном контексте этой функции нет, и модуль формы просто не
// компилируется (проверено — немой пустой вывод).
//
// Каждая проба — в Попытка: необработанное исключение в модуле формы
// платформа показывает модальным окном, то есть немым таймаутом в 180 с.

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

ПутьPDF = "tests/conformance/pdf/platform-simple.pdf";

Попытка
	ТабДок = Новый ТабличныйДокумент;

	ОбластьЯчейки = ТабДок.Область(1, 1, 1, 1);
	ОбластьЯчейки.Текст = "Накладная № 7";

	ОбластьЯчейки = ТабДок.Область(2, 1, 2, 1);
	ОбластьЯчейки.Текст = "Товар";
	ОбластьЯчейки = ТабДок.Область(2, 2, 2, 2);
	ОбластьЯчейки.Текст = "Цена";

	ОбластьЯчейки = ТабДок.Область(3, 1, 3, 1);
	ОбластьЯчейки.Текст = "Гвоздь строительный";
	ОбластьЯчейки = ТабДок.Область(3, 2, 3, 2);
	ОбластьЯчейки.Текст = "123.45";

	ОбластьЯчейки = ТабДок.Область(4, 1, 4, 1);
	ОбластьЯчейки.Текст = "Latin ASCII text";
	ОбластьЯчейки = ТабДок.Область(4, 2, 4, 2);
	ОбластьЯчейки.Текст = "67890";

	ТабДок.Записать(ПутьPDF, ТипФайлаТабличногоДокумента.PDF);
	П("запись", "да");
Исключение
	П("запись", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

Попытка
	ФайлPDF = Новый Файл(ПутьPDF);
	П("существует", ФайлPDF.Существует());
	П("полное имя", ФайлPDF.ПолноеИмя);
	П("размер", ФайлPDF.Размер());
Исключение
	П("файл", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

// Первые байты — чтобы в снятом выводе была видна и сигнатура, и версия
// формата, которую выбрала платформа, без разбора самого файла.
Попытка
	ЧтениеБайтов = Новый ЧтениеДанных(ПутьPDF);
	ПерваяСтрока = ЧтениеБайтов.ПрочитатьСтроку("UTF-8", Символы.ПС);
	ЧтениеБайтов.Закрыть();
	П("первая строка", ПерваяСтрока);
Исключение
	П("первая строка", "ошибка: " + ОписаниеОшибки());
КонецПопытки;
