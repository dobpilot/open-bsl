// СЪЁМКА РАСКЛАДКИ: как платформа 8.3.27 кладёт табличный документ на
// страницу PDF.
//
// Как и `capture-platform-pdf.bsl`, это не замер в смысле
// `open_questions.rs`: скрипт исполняется ТОЛЬКО платформой и ничего не
// сверяет построчно. Его дело — выдать набор файлов, в каждом из которых
// изменено РОВНО ОДНО свойство раскладки, чтобы разность координат в
// контент-потоке отвечала на вопрос об одной величине, а не о их сумме.
//
// Прогон:
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/pdf/capture-platform-pdf-layout.bsl
//
// Разбор снятых файлов (потоки страниц сжаты `FlateDecode`):
//
//   python3 tests/conformance/pdf/dump-pdf-streams.py \
//       tests/conformance/pdf/probe-grid.pdf
//
// ПРОИСХОЖДЕНИЕ ФАЙЛОВ рядом (`probe-*.pdf`, закоммичены вместе со
// скриптом): 1С:Предприятие 8.3.27.2130, Linux x86-64, 14 августа 2026
// года, той самой командой выше. Вывод прогона —
// `capture-platform-pdf-layout.platform.txt`. Пересъёмка на другой машине
// даст другие байты: платформа встраивает подмножество того шрифта,
// который нашла в системе, — но ГЕОМЕТРИЯ (`re`, `Td`, `/MediaBox`) от
// шрифта не зависит, и разбирается именно она.
//
// Числа, ради которых снимался каждый файл, выписаны в обзоре модуля
// `crates/bsl-rt/src/spreadsheet_pdf.rs`.
//
// Каждая проба — в Попытка: необработанное исключение в модуле формы
// платформа показывает модальным окном, то есть немым таймаутом в 180 с.
// Локальные переменные намеренно названы длинно (`ЗначПолеСлева`, а не
// `ПолеСлева`): короткое имя свойства формы присвоилось бы САМОЙ ФОРМЕ.

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

// Сетка, одинаковая во всех геометрических пробах: три колонки, четыре
// строки, короткий текст в каждой ячейке. Меняется только то, что проба
// задаёт сверху.
Функция СобратьСетку()
	Док = Новый ТабличныйДокумент;
	Для Стр = 1 По 4 Цикл
		Для Кол = 1 По 3 Цикл
			Обл = Док.Область(Стр, Кол, Стр, Кол);
			Обл.Текст = "R" + Стр + "C" + Кол;
		КонецЦикла;
	КонецЦикла;
	Возврат Док;
КонецФункции

Процедура Записать(Док, Имя)
	Путь = "tests/conformance/pdf/" + Имя;
	Попытка
		Док.Записать(Путь, ТипФайлаТабличногоДокумента.PDF);
		Ф = Новый Файл(Путь);
		П(Имя, "" + Ф.Существует() + ", " + Ф.Размер());
	Исключение
		П(Имя, "ошибка: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// --- 1. Написания и умолчания API ---------------------------------------

Попытка
	П("PDF строкой", Строка(ТипФайлаТабличногоДокумента.PDF));
Исключение
	П("PDF строкой", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

Попытка
	П("PDF тип", Строка(ТипЗнч(ТипФайлаТабличногоДокумента.PDF)));
Исключение
	П("PDF тип", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

Попытка
	П("PDF англ", Вычислить("Строка(SpreadsheetDocumentFileType.PDF)"));
Исключение
	П("PDF англ", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

Попытка
	Пустой = Новый ТабличныйДокумент;
	П("умолч ШиринаКолонки", Пустой.Область(1, 1, 1, 1).ШиринаКолонки);
	П("умолч ВысотаСтроки", Пустой.Область(1, 1, 1, 1).ВысотаСтроки);
Исключение
	П("умолч сетка", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

Попытка
	Пустой = Новый ТабличныйДокумент;
	ЗначПолеСлева = Пустой.ПолеСлева;
	ЗначПолеСправа = Пустой.ПолеСправа;
	ЗначПолеСверху = Пустой.ПолеСверху;
	ЗначПолеСнизу = Пустой.ПолеСнизу;
	П("умолч поля", "" + ЗначПолеСлева + " " + ЗначПолеСправа + " "
		+ ЗначПолеСверху + " " + ЗначПолеСнизу);
	П("умолч поле тип", Строка(ТипЗнч(ЗначПолеСлева)));
Исключение
	П("умолч поля", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

Попытка
	Пустой = Новый ТабличныйДокумент;
	П("умолч ориентация", Строка(Пустой.ОриентацияСтраницы));
	П("умолч ориентация тип", Строка(ТипЗнч(Пустой.ОриентацияСтраницы)));
Исключение
	П("умолч ориентация", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

Попытка
	П("ориентация члены", Строка(ОриентацияСтраницы.Портрет) + " / "
		+ Строка(ОриентацияСтраницы.Ландшафт));
Исключение
	П("ориентация члены", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

Попытка
	П("ориентация англ", Вычислить("Строка(PageOrientation.Landscape)"));
Исключение
	П("ориентация англ", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

Попытка
	П("ориентация метатип", Строка(ТипЗнч(ОриентацияСтраницы)));
Исключение
	П("ориентация метатип", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

Попытка
	Пустой = Новый ТабличныйДокумент;
	П("умолч РазмерСтраницы", Строка(Пустой.РазмерСтраницы));
Исключение
	П("умолч РазмерСтраницы", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

// --- 2. Файлы: по одному изменённому свойству ---------------------------

// Опорная сетка: из неё берутся начало координат, умолчания ширины и
// высоты и кегль, которым платформа рисует текст.
Попытка
	Записать(СобратьСетку(), "probe-grid.pdf");
Исключение
	П("probe-grid.pdf", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

// Ширины колонок: вторая узкая, третья широкая. Первая оставлена
// умолчанием — она и есть контроль.
Попытка
	Док = СобратьСетку();
	Док.Область(1, 2, 1, 2).ШиринаКолонки = 5;
	Док.Область(1, 3, 1, 3).ШиринаКолонки = 40;
	Записать(Док, "probe-colwidth.pdf");
Исключение
	П("probe-colwidth.pdf", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

// Высоты строк: вторая низкая, третья высокая.
Попытка
	Док = СобратьСетку();
	Док.Область(2, 1, 2, 1).ВысотаСтроки = 10;
	Док.Область(3, 1, 3, 1).ВысотаСтроки = 40;
	Записать(Док, "probe-rowheight.pdf");
Исключение
	П("probe-rowheight.pdf", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

// Объединение двух ячеек по горизонтали и двух по вертикали.
Попытка
	Док = СобратьСетку();
	Док.Область(1, 1, 1, 2).Объединить();
	Док.Область(3, 1, 4, 1).Объединить();
	Записать(Док, "probe-merge.pdf");
Исключение
	П("probe-merge.pdf", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

// Шрифты: полужирный, курсив и другой кегль — по одному на строку;
// четвёртая строка получает тот же шрифт БЕЗ начертаний и служит
// контролем (разница с `probe-grid.pdf` — цена самого задания шрифта).
Попытка
	Док = СобратьСетку();
	Док.Область(1, 1, 1, 1).Шрифт = Новый Шрифт("Arial", 10, Истина);
	Док.Область(2, 1, 2, 1).Шрифт = Новый Шрифт("Arial", 10, Ложь, Истина);
	Док.Область(3, 1, 3, 1).Шрифт = Новый Шрифт("Arial", 14);
	Док.Область(4, 1, 4, 1).Шрифт = Новый Шрифт("Arial", 10);
	Записать(Док, "probe-font.pdf");
Исключение
	П("probe-font.pdf", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

// Рамки: каждая сторона в СВОЕЙ ячейке, чтобы отрезки не слипались.
Попытка
	Док = СобратьСетку();
	Тонкая = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	Док.Область(1, 1, 1, 1).ГраницаСлева = Тонкая;
	Док.Область(2, 1, 2, 1).ГраницаСверху = Тонкая;
	Док.Область(3, 1, 3, 1).ГраницаСправа = Тонкая;
	Док.Область(4, 1, 4, 1).ГраницаСнизу = Тонкая;
	Записать(Док, "probe-border.pdf");
Исключение
	П("probe-border.pdf", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

// Выравнивание: по горизонтали в первой строке, по вертикали во второй,
// которой задана большая высота — иначе разницы не увидеть.
Попытка
	Док = СобратьСетку();
	Док.Область(1, 1, 1, 1).ГоризонтальноеПоложение
		= ГоризонтальноеПоложение.Лево;
	Док.Область(1, 2, 1, 2).ГоризонтальноеПоложение
		= ГоризонтальноеПоложение.Центр;
	Док.Область(1, 3, 1, 3).ГоризонтальноеПоложение
		= ГоризонтальноеПоложение.Право;
	Док.Область(2, 1, 2, 1).ВысотаСтроки = 40;
	Док.Область(2, 1, 2, 1).ВертикальноеПоложение = ВертикальноеПоложение.Верх;
	Док.Область(2, 2, 2, 2).ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	Док.Область(2, 3, 2, 3).ВертикальноеПоложение = ВертикальноеПоложение.Низ;
	Записать(Док, "probe-align.pdf");
Исключение
	П("probe-align.pdf", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

// Ландшафт: та же сетка, изменена только ориентация.
Попытка
	Док = СобратьСетку();
	Док.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Записать(Док, "probe-landscape.pdf");
Исключение
	П("probe-landscape.pdf", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

// Поля страницы: все четыре разные, чтобы каждое опознавалось по своей
// разности. Значения — в тех единицах, в которых их принимает платформа;
// какие это единицы, и отвечает файл.
Попытка
	Док = СобратьСетку();
	Док.ПолеСлева = 30;
	Док.ПолеСправа = 10;
	Док.ПолеСверху = 25;
	Док.ПолеСнизу = 5;
	П("поля прочитались", "" + Док.ПолеСлева + " " + Док.ПолеСправа + " "
		+ Док.ПолеСверху + " " + Док.ПолеСнизу);
	Записать(Док, "probe-margins.pdf");
Исключение
	П("probe-margins.pdf", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

// Разбиение на страницы: сколько строк умолчательной высоты платформа
// кладёт на A4 и что при этом становится с /MediaBox.
Попытка
	Док = Новый ТабличныйДокумент;
	Для Стр = 1 По 120 Цикл
		Обл = Док.Область(Стр, 1, Стр, 1);
		Обл.Текст = "строка " + Стр;
	КонецЦикла;
	Записать(Док, "probe-pages.pdf");
Исключение
	П("probe-pages.pdf", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

// Пустой документ: пишется ли файл вовсе и что в нём.
Попытка
	Записать(Новый ТабличныйДокумент, "probe-empty.pdf");
Исключение
	П("probe-empty.pdf", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

// Тот же документ, что в `capture-platform-pdf.bsl`, но с колонками,
// заведомо широкими для ЛЮБОГО из двух шрифтов: у платформы Arial, у нас
// моноширинный Courier на 20% шире, и в колонке шириной 9 знаков наш
// текст физически налезает на соседнюю. Извлекатель текста (poppler) на
// такое налезание отвечает другим порядком чтения — не потерей текста, а
// именно порядком, — поэтому построчная сверка извлечения идёт по ЭТОМУ
// файлу, где ни одна ячейка из своей колонки не выходит.
Попытка
	Док = Новый ТабличныйДокумент;
	Док.Область(1, 1, 1, 1).ШиринаКолонки = 24;
	Док.Область(1, 2, 1, 2).ШиринаКолонки = 12;
	Док.Область(1, 1, 1, 1).Текст = "Накладная № 7";
	Док.Область(2, 1, 2, 1).Текст = "Товар";
	Док.Область(2, 2, 2, 2).Текст = "Цена";
	Док.Область(3, 1, 3, 1).Текст = "Гвоздь строительный";
	Док.Область(3, 2, 3, 2).Текст = "123.45";
	Док.Область(4, 1, 4, 1).Текст = "Latin ASCII text";
	Док.Область(4, 2, 4, 2).Текст = "67890";
	Записать(Док, "probe-fit.pdf");
Исключение
	П("probe-fit.pdf", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

// Числовая ячейка при выравнивании по умолчанию: у платформы это `Авто`, и
// вопрос в том, отъезжает ли число вправо само. Первая строка — настоящее
// значение, вторая — просто похожий на число текст.
Попытка
	Док = СобратьСетку();
	Обл = Док.Область(1, 1, 1, 1);
	Обл.СодержитЗначение = Истина;
	Обл.Значение = 42;
	Док.Область(2, 1, 2, 1).Текст = "1234";
	Записать(Док, "probe-numeric.pdf");
Исключение
	П("probe-numeric.pdf", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

// Толщина и вид линии: толстая сплошная, точечная и двойная — каждая в
// своей строке, все слева, чтобы отрезки не слипались.
Попытка
	Док = СобратьСетку();
	Док.Область(1, 1, 1, 1).ГраницаСлева
		= Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);
	Док.Область(2, 1, 2, 1).ГраницаСлева
		= Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Точечная, 1);
	Док.Область(3, 1, 3, 1).ГраницаСлева
		= Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Двойная, 1);
	Записать(Док, "probe-line.pdf");
Исключение
	П("probe-line.pdf", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

// Число БЕЗ текста: в предыдущей пробе значение легло в ячейку, где текст
// уже был, и в файл ушёл текст. Здесь ячейка получает только значение.
Попытка
	Док = Новый ТабличныйДокумент;
	Обл = Док.Область(1, 1, 1, 1);
	Обл.СодержитЗначение = Истина;
	Обл.Значение = 42;
	Док.Область(1, 2, 1, 2).Текст = "хвост";
	Док.Область(2, 1, 2, 1).Текст = "1234";
	Док.Область(2, 2, 2, 2).Текст = "хвост";
	Записать(Док, "probe-number.pdf");
Исключение
	П("probe-number.pdf", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

// Документ ШИРЕ печатной области: рвёт ли платформа его на страницы по
// горизонтали и в каком порядке они идут.
Попытка
	Док = Новый ТабличныйДокумент;
	Для Кол = 1 По 20 Цикл
		Обл = Док.Область(1, Кол, 1, Кол);
		Обл.Текст = "к" + Кол;
		Обл = Док.Область(2, Кол, 2, Кол);
		Обл.Текст = "" + Кол * 100;
	КонецЦикла;
	Записать(Док, "probe-wide.pdf");
Исключение
	П("probe-wide.pdf", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

// Документ, не помещающийся НИ по ширине, НИ по высоте: в каком порядке
// платформа выкладывает страницы — сначала вправо или сначала вниз. В
// каждой ячейке номер строки и колонки, по ним и опознаётся страница.
Попытка
	Док = Новый ТабличныйДокумент;
	Для Стр = 1 По 90 Цикл
		Для Кол = 1 По 20 Цикл
			Обл = Док.Область(Стр, Кол, Стр, Кол);
			Обл.Текст = "" + Стр + "." + Кол;
		КонецЦикла;
	КонецЦикла;
	Записать(Док, "probe-big.pdf");
Исключение
	П("probe-big.pdf", "ошибка: " + ОписаниеОшибки());
КонецПопытки;

// Поля страницы в MXL: получают ли они свою пару в списке параметров
// страницы (там, где лежат ориентация с идентификатором 1 и масштаб
// печати с 2) и с какими идентификаторами. Файл пишется во временный
// каталог, а снятая с платформы копия лежит рядом со скриптом —
// `probe-margins.mxl`, 1085 байт: в ней и видны пары
// `6 -> 3300, 7 -> 3100, 8 -> 3400, 9 -> 3200` при полях 33, 31, 34 и
// 32 мм, то есть сотые доли миллиметра в порядке «сверху, слева, снизу,
// справа». Без закоммиченной копии проверить это было бы нечем.
Попытка
	Док = СобратьСетку();
	Док.ПолеСлева = 31;
	Док.ПолеСправа = 32;
	Док.ПолеСверху = 33;
	Док.ПолеСнизу = 34;
	ПутьMXL = "/tmp/open-bsl-pdf-probe-margins.mxl";
	Док.Записать(ПутьMXL, ТипФайлаТабличногоДокумента.MXL);
	ФайлMXL = Новый Файл(ПутьMXL);
