// Клиент серверной базы: порядок без часов и внешних приложений.
// Трасса накапливается в памяти; Сообщить вызывается после ожиданий.
Перем ТрассаДинамики;

Асинх Функция ЗадачаДинамики(ОшибкаДинамики, УступитьДинамики) Экспорт
    ТрассаДинамики = ТрассаДинамики + "start;";
    Если УступитьДинамики Тогда
        Ждать 0;
        ТрассаДинамики = ТрассаДинамики + "resumed;";
    КонецЕсли;
    Если ОшибкаДинамики Тогда
        ТрассаДинамики = ТрассаДинамики + "raise;";
        ВызватьИсключение "ошибка динамической задачи";
    КонецЕсли;
    ТрассаДинамики = ТрассаДинамики + "return;";
    Возврат 17;
КонецФункции

Асинх Процедура ПроцедураДинамики()
    ТрассаДинамики = ТрассаДинамики + "start;";
    Ждать 0;
    ТрассаДинамики = ТрассаДинамики + "resumed;";
КонецПроцедуры

Асинх Функция ПроверитьОбещаниеДинамики(ИдДинамики, РежимДинамики, ОшибкаДинамики, УступитьДинамики)
    ТрассаДинамики = "";
    СтадияДинамики = "call";
    Попытка
        Если РежимДинамики = 0 Тогда
            ОбещаниеДинамики = ЗадачаДинамики(ОшибкаДинамики, УступитьДинамики);
        ИначеЕсли РежимДинамики = 1 Тогда
            ОбещаниеДинамики = Вычислить("ЗадачаДинамики(ОшибкаДинамики, УступитьДинамики)");
        ИначеЕсли РежимДинамики = 2 Тогда
            ОбещаниеДинамики = Вычислить("Вычислить(""ЗадачаДинамики(ОшибкаДинамики, УступитьДинамики)"")");
        Иначе
            ОбещаниеДинамики = Вычислить("ЭтотОбъект.ЗадачаДинамики(ОшибкаДинамики, УступитьДинамики)");
        КонецЕсли;
        ТрассаДинамики = ТрассаДинамики + "caller;";
        СтадияДинамики = "await";
        РезультатДинамики = Ждать ОбещаниеДинамики;
        ТрассаДинамики = ТрассаДинамики + "value=" + Строка(РезультатДинамики) + ";";
        СтадияДинамики = "repeat";
        ПовторДинамики = Ждать ОбещаниеДинамики;
        ТрассаДинамики = ТрассаДинамики + "repeat=" + Строка(ПовторДинамики) + ";";
    Исключение
        ТрассаДинамики = ТрассаДинамики + "caught=" + СтадияДинамики + ";";
        Если СтадияДинамики = "await" Тогда
            Попытка
                Ждать ОбещаниеДинамики;
                ТрассаДинамики = ТрассаДинамики + "repeat-lost;";
            Исключение
                ТрассаДинамики = ТрассаДинамики + "repeat-error;";
            КонецПопытки;
        КонецЕсли;
    КонецПопытки;
    Сообщить(ИдДинамики + Символ(9) + ТрассаДинамики);
    Возврат Неопределено;
КонецФункции

Асинх Функция ПроверитьПроцедуруДинамики(ИдДинамики, ДинамическиПробы)
    ТрассаДинамики = "";
    Если ДинамическиПробы Тогда
        Выполнить("ПроцедураДинамики();");
    Иначе
        ПроцедураДинамики();
    КонецЕсли;
    ТрассаДинамики = ТрассаДинамики + "caller;";
    Ждать 0;
    ТрассаДинамики = ТрассаДинамики + "caller-resumed;";
    Сообщить(ИдДинамики + Символ(9) + ТрассаДинамики);
    Возврат Неопределено;
КонецФункции

Асинх Процедура ИзмеритьКонтекстДинамики()
    Сообщить("file.begin" + Символ(9) + "dynamic-async-context-1");
    Попытка
        Ждать ПроверитьОбещаниеДинамики("dynamic.async.direct.ready", 0, Ложь, Ложь);
        Ждать ПроверитьОбещаниеДинамики("dynamic.async.direct.pending", 0, Ложь, Истина);
        Ждать ПроверитьОбещаниеДинамики("dynamic.async.direct.error.ready", 0, Истина, Ложь);
        Ждать ПроверитьОбещаниеДинамики("dynamic.async.direct.error.pending", 0, Истина, Истина);
        Ждать ПроверитьОбещаниеДинамики("dynamic.async.eval.ready", 1, Ложь, Ложь);
        Ждать ПроверитьОбещаниеДинамики("dynamic.async.eval.pending", 1, Ложь, Истина);
        Ждать ПроверитьОбещаниеДинамики("dynamic.async.eval.error.ready", 1, Истина, Ложь);
        Ждать ПроверитьОбещаниеДинамики("dynamic.async.eval.error.pending", 1, Истина, Истина);
        Ждать ПроверитьОбещаниеДинамики("dynamic.async.nested.ready", 2, Ложь, Ложь);
        Ждать ПроверитьОбещаниеДинамики("dynamic.async.nested.pending", 2, Ложь, Истина);
        Ждать ПроверитьОбещаниеДинамики("dynamic.async.nested.error.ready", 2, Истина, Ложь);
        Ждать ПроверитьОбещаниеДинамики("dynamic.async.nested.error.pending", 2, Истина, Истина);
        Ждать ПроверитьОбещаниеДинамики("dynamic.async.reference.ready", 3, Ложь, Ложь);
        Ждать ПроверитьОбещаниеДинамики("dynamic.async.reference.pending", 3, Ложь, Истина);
        Ждать ПроверитьОбещаниеДинамики("dynamic.async.reference.error.ready", 3, Истина, Ложь);
        Ждать ПроверитьОбещаниеДинамики("dynamic.async.reference.error.pending", 3, Истина, Истина);
        Ждать ПроверитьПроцедуруДинамики("dynamic.async.procedure.direct", Ложь);
        Ждать ПроверитьПроцедуруДинамики("dynamic.async.procedure.execute", Истина);
    Исключение
        Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
    КонецПопытки;
    Сообщить("file.end" + Символ(9) + "dynamic-async-context-1");
    Попытка
        Выполнить("ЗавершитьРаботуСистемы(Ложь);");
    Исключение
    КонецПопытки;
КонецПроцедуры

ИзмеритьКонтекстДинамики();
