// Приведение типов в арифметике и склейке, остаток от деления и равенство
// разнотипных значений. Ожидаемый вывод снят с 8.3.27 — см.
// tests/conformance/measure/measure-concat.bsl и measure-equality.bsl.

// --- Строка слева: правый операнд приводится через Строка() ------------

Сообщить("[" + 5 + "]");
// Разделитель групп — НЕразрывный пробел, он тут и окажется.
Сообщить("[" + 1000.5 + "]");
Сообщить("[" + 1/3 + "]");
Сообщить("[" + Истина + "][" + Ложь + "]");
Сообщить("[" + Неопределено + "][" + Null + "]");
Сообщить("[" + '20240115103000' + "]");
Сообщить("[" + Новый Массив + "][" + Новый Структура + "]");
Сообщить("[" + ТипЗнч(1) + "]");

// Склейка побеждает арифметику, даже когда обе стороны похожи на числа.
Сообщить("5" + 1);
Сообщить("5" + Истина);
// Левоассоциативность: от строки склейка идёт до конца, а до неё считается
// арифметика.
Сообщить("х" + 1 + 2);

// --- Арифметика тянет операнды к числу --------------------------------

Сообщить("5" - 1);
Сообщить("5" * 2);
Сообщить("5" / 2);
Сообщить(1 - "5");
Сообщить(5 + "3");
// Разбор строки тот же, что у Число(): пробелы, точка или запятая,
// разделители групп.
Сообщить(" 5 " - 1);
Сообщить("5.5" - 1);
Сообщить("5,5" - 1);
Сообщить(("" + 1000.5) - 0.5);
Сообщить(-"5");
// Булево — единица и ноль.
Сообщить(Истина + 1);
Сообщить(Ложь + 1);
Сообщить(Истина - 1);
Сообщить(Истина * 2);
Сообщить(-Истина);
// Дата плюс числовая строка — сдвиг на секунды.
Сообщить('20240115103000' + "60");

// Приведение не безгранично.
Попытка
	Сообщить("абв" - 1);
Исключение
	Сообщить("нечисловая строка -> <ошибка>");
КонецПопытки;

Попытка
	Сообщить(Неопределено + 1);
Исключение
	Сообщить("Неопределено -> <ошибка>");
КонецПопытки;

Попытка
	Сообщить(5 + "]");
Исключение
	Сообщить("число плюс нечисловая строка -> <ошибка>");
КонецПопытки;

// --- Остаток от деления -----------------------------------------------

Сообщить(7 % 2);
// Знак результата — по делимому.
Сообщить(-7 % 2);
Сообщить(7 % -2);
Сообщить(-7 % -2);
// Дробные операнды допустимы.
Сообщить(7.5 % 2);
Сообщить(7 % 2.5);
Сообщить(0 % 5);
// Приоритет наравне с умножением и делением, левоассоциативность.
Сообщить(2 + 6 % 4);
Сообщить(10 % 3 * 2);
Сообщить(100 / 10 % 3);
// Точная арифметика без потери разрядов.
Сообщить(Pow(10, 30) % 7);
Сообщить("7" % 2);

Попытка
	Сообщить(7 % 0);
Исключение
	Сообщить("остаток на ноль -> <ошибка>");
КонецПопытки;

// --- Равенство --------------------------------------------------------

// Булево с числом сравнивается численно, а не по истинности.
Сообщить("" + (Истина = 1) + "|" + (Ложь = 0) + "|" + (Истина = 2) + "|" + (1 = Истина));
// Строка не приводится никак.
Сообщить("" + ("5" = 5) + "|" + ("Да" = Истина) + "|" + ("" = Неопределено));
Сообщить("" + (Null = Неопределено) + "|" + (0 = Неопределено) + "|" + (1 = 1.0));

// У коллекций равенство — тождество объекта.
А = Новый Массив;
Б = Новый Массив;
Сообщить("" + (А = Б) + "|" + (А = А));

// А ключи Соответствие живут по СТРОГОМУ отношению: булево и единица —
// разные ключи, хотя оператор = считает их равными.
С = Новый Соответствие;
С.Вставить(Истина, "по булеву");
С.Вставить(1, "по числу");
Сообщить("" + С.Количество() + "|" + С.Получить(Истина) + "|" + С.Получить(1));
