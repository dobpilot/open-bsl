// Пропущенная позиция в вызове пользовательской функции (`Ф(1, , 3)`) —
// НЕ значение, а свойство места вызова: параметр берёт объявленное
// умолчание. Отсюда и то, что проверяет фикстура: пропуск отличается от
// явно переданного `Неопределено`, не сдвигает нумерацию соседей и не
// мешает параметру без `Знач` остаться ссылкой на переменную вызывающего.

Функция Хвост(а, б = 100)
	Возврат Строка(а) + "/" + Строка(б);
КонецФункции

Функция Середина(а, б = 100, в = 200)
	Возврат Строка(а) + "/" + Строка(б) + "/" + Строка(в);
КонецФункции

Функция ЗначСУмолчанием(Знач а, Знач б = 100)
	б = б + 1;
	Возврат Строка(а) + "/" + Строка(б);
КонецФункции

// ИЗМЕРЕНО: обязательный параметр ПОСЛЕ необязательного платформа
// принимает, и пропуск позиции между ними не сдвигает нумерацию соседей —
// «в» остаётся третьим и остаётся ссылкой на переменную вызывающего.
Процедура ПоСсылкеРядомСПропуском(а, б = 100, в)
	в = Строка(а) + "/" + Строка(б);
КонецПроцедуры

Процедура МеняетПараметр(а, б = 100)
	а = а + б;
КонецПроцедуры

Сообщить(Хвост(1, ));
Сообщить(Хвост(1, 5));
Сообщить(Хвост(1, Неопределено));
Сообщить(Середина(1, , 3));
Сообщить(Середина(1, ,));
Сообщить(Середина(1, 2, 3));
Сообщить(ЗначСУмолчанием(1, ));

// Опущенный ХВОСТОВОЙ необязательный аргумент БЕЗ явной запятой — измерено
// (CALL.OMITTED_TRAILING): платформа берёт умолчание, `Хвост(1)` = «1/100».
// Форма `Ф(1)` при `Ф(а, б = 100)` — самая обычная в прикладном коде.
Сообщить(Хвост(1));
Сообщить(Середина(1));
Сообщить(Середина(1, 2));

Пусто = Неопределено;
Сообщить(Хвост(1, Пусто));

Итог = "не тронуто";
ПоСсылкеРядомСПропуском(1, , Итог);
Сообщить(Итог);

Счётчик = 7;
МеняетПараметр(Счётчик, );
Сообщить(Строка(Счётчик));

// Тот же набор через Вычислить — фрагмент обязан знать умолчания вызываемой
// функции модуля (has_default доезжает до SnippetSignature, а не заглушка):
// пропущенная позиция и опущенный хвостовой берут умолчание так же, как в
// статике.
Сообщить(Вычислить("Хвост(1, )"));
Сообщить(Вычислить("Хвост(1)"));
Сообщить(Вычислить("Середина(1)"));
Сообщить(Вычислить("Середина(1, 2)"));
