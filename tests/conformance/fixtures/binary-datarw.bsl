// --- ГРАНИЦА КОЛИЧЕСТВА 2^32 --------------------------------------------------------------
// `ПрочитатьВБуферДвоичныхДанных` и `ПрочитатьСимволы` количество не меньше
// 2^32 ОТВЕРГАЮТ, а `Прочитать` то же количество принимает и отдаёт «сколько
// есть» — асимметрия измерена разведкой над файлом, и здесь она проверяется
// над обоими носителями сразу. После отвергнутой пробы тем же читателем
// читается байт: отказ идёт по аргументу и позицию двигать не должен.
//
// ПРОБЫ НА «2^32 - 1» ЗДЕСЬ БЫТЬ НЕ ДОЛЖНО, как и любого другого количества
// ниже границы, но больше носителя: платформа такое значение принимает и за
// 180 с не отвечает, так что прогон ушёл бы в таймаут вместе с эталоном.
// Ровно поэтому само число здесь не написано даже в комментарии, а
// проверяется оно только юнит-тестом `the_bound_is_exactly_at_2_32_not_below`
// в `bsl-rt/src/datarw.rs`.

ПотГ1 = СвежийПоток();
ЧтГ1 = Новый ЧтениеДанных(ПотГ1);
Р = "";
Попытка
	БуфГ1 = ЧтГ1.ПрочитатьВБуферДвоичныхДанных(4294967296);
	Р = "принято, размер " + Ч(БуфГ1.Размер);
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("память: ПрочитатьВБуферДвоичныхДанных(2^32)", Р);
Р = "";
Попытка
	Врм = ЧтГ1.ПрочитатьБайт();
	Р = Показ(Врм);
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("память: байт после отвергнутого буфера", Р);

ПотГ2 = СвежийПоток();
ЧтГ2 = Новый ЧтениеДанных(ПотГ2);
Р = "";
Попытка
