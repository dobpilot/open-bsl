// --- ФАЙЛ ---------------------------------------------------------------------------
// Файл нормализуется `ФайловыеПотоки.Создать` (этот режим обрезает —
// измерено), а не тем, что его якобы обрезает писатель: писатель существующий
// файл сохраняет.
ИмяФ = "/tmp/open-bsl-datarw-fixture.bin";
ПотНорм = ФайловыеПотоки.Создать(ИмяФ);
ПотНорм.Закрыть();

ЗапФ = Новый ЗаписьДанных(ИмяФ);
ЗапФ.ЗаписатьСимволы("Аб");
ЗапФ.ЗаписатьБайт(10);
ЗапФ.Закрыть();

ЧтФ = Новый ЧтениеДанных(ИмяФ);
РезФ = ЧтФ.Прочитать(0);
П("файл: размер прочитанного", Ч(РезФ.Размер));
БуфФ = РезФ.ПолучитьБуферДвоичныхДанных();
П("файл: байты", Дамп(БуфФ));

// Огромное количество над ФАЙЛОМ отдаёт «сколько есть» — то же, что над
// памятью: измерено разведкой, что `Прочитать(35184372088832)` над
// шестнадцатибайтовым файлом даёт 16, а не ошибку и не смерть сеанса.
ЧтФБ = Новый ЧтениеДанных(ИмяФ);
РезФБ = ЧтФБ.Прочитать(35184372088832);
П("файл: Прочитать(2^45) даёт сколько есть", Ч(РезФБ.Размер));

// ПОВТОРНОЕ ОТКРЫТИЕ ФАЙЛА ПИСАТЕЛЕМ: существующий файл не обрезается,
// позиция ставится в 0, запись ложится ПОВЕРХ.
ИмяП = "/tmp/open-bsl-datarw-fixture-reopen.bin";
ПотНорм2 = ФайловыеПотоки.Создать(ИмяП);
ПотНорм2.Закрыть();

ЗапП1 = Новый ЗаписьДанных(ИмяП);
ЗапП1.ЗаписатьСимволы("ABCDEFGH");
ЗапП1.Закрыть();
ЧтП1 = Новый ЧтениеДанных(ИмяП);
РезП1 = ЧтП1.Прочитать(0);
П("повтор: размер после первой записи", Ч(РезП1.Размер));
БуфП1 = РезП1.ПолучитьБуферДвоичныхДанных();
П("повтор: байты после первой записи", Дамп(БуфП1));
ЧтП1.Закрыть();

ЗапП2 = Новый ЗаписьДанных(ИмяП);
ЗапП2.ЗаписатьБайт(90);
ЗапП2.Закрыть();
ЧтП2 = Новый ЧтениеДанных(ИмяП);
РезП2 = ЧтП2.Прочитать(0);
П("повтор: размер после второй записи", Ч(РезП2.Размер));
БуфП2 = РезП2.ПолучитьБуферДвоичныхДанных();
П("повтор: байты после второй записи", Дамп(БуфП2));
ЧтП2.Закрыть();

Р = "";
Попытка
	ЧтНет = Новый ЧтениеДанных("/tmp/open-bsl-datarw-нет-такого-файла.bin");
