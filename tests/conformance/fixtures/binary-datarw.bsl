	Р = "принято, символов " + Ч(СтрДлина(СтрГ2));
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("память: ПрочитатьСимволы(2^32)", Р);
Р = "";
Попытка
	Врм = ЧтГ2.ПрочитатьБайт();
