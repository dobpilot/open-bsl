// Контракт `ЧтениеДанных`, `ЗаписьДанных` и `РезультатЧтенияДанных`:
// источники конструктора, отсутствие собственного буфера, сверка позиции
// целевого потока (чередование), порядок байтов, разделитель строк,
// кодировки, край источника и результат чтения.
//
// Эталон снимается ТОЛЬКО платформой:
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/fixtures/binary-datarw.bsl
//   diff tests/conformance/fixtures/binary-datarw.expected \
//        tests/conformance/fixtures/binary-datarw.platform.txt
//
// Пути фиксированы во временном каталоге, и ПОВТОРЯЕМОСТЬ ПРОГОНА — забота
// самой фикстуры: `Новый ЗаписьДанных(<существующий файл>)` файл НЕ обрезает
// (измерено), поэтому каждый файловый путь начинается с нормализации уже
// измеренным `ФайловыеПотоки.Создать(Путь)` + `Закрыть()`. Без неё остаток от
// прошлого прогона сделал бы вывод другим.
//
// ЧЕГО ЗДЕСЬ СОЗНАТЕЛЬНО НЕТ.
//
// 1. Текстов сообщений об ошибках: у платформы и у этой реализации они
//    разные, поэтому всякая неудача печатается как «<ошибка>». Сам текст
//    платформы для чередования снят разведкой и приведён дословно в шапке
//    `bsl-rt/src/datarw.rs`.
// 2. Ошибок АРНОСТИ (`Новый ЧтениеДанных`, `Новый ЧтениеДанных(п,1,2,3,4,5)`).
//    Платформа отвергает их, но здесь их ловит резолвер — это ошибка
//    компиляции, а не перехватываемое `Попыткой` исключение, и весь скрипт
//    из-за неё не запустился бы.
// 3. Методов, которых у платформы НЕТ (`ЕстьДанныеДляЧтения`,
//    `ОчиститьБуфер`, `ПолучитьЦелевойПоток`, `ЗакрытьИПолучитьЦелевойПоток`,
//    `ПропуститьДоРазделителя`, `ПрочитатьВДвоичныеДанные`, `ПрочитатьВСтроку`,
//    `ЗаписатьСтрокуСРазделителем`): их отсутствие проверено разведкой на
//    платформе, а вызов несуществующего имени здесь — снова ошибка резолвера.
//
// Два правила письма, каждое стоит впустую потраченного прогона: метод
// нельзя звать на результате вызова (нужна промежуточная переменная), а
// всякая проба, способная бросить, обязана быть в `Попытка`. Третье правило
// стоило прогона на платформе отдельно: имя переменной не должно совпадать с
// ключевым словом (`Знач`, `И`).

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

// Число либо «Неопределено»: край источника отдаёт именно его.
Функция Показ(В)
	Если В = Неопределено Тогда
		Возврат "Неопределено";
	КонецЕсли;
	Возврат Формат(В, "ЧН=0; ЧГ=0");
КонецФункции

// Побайтовый дамп буфера.
Функция Дамп(Б)
	С = "";
	Для н = 0 По Б.Размер - 1 Цикл
		С = С + Ч(Б[н]) + " ";
	КонецЦикла;
	Возврат СокрЛП(С);
КонецФункции

// Коды символов строки: разделители и BOM иначе не видно.
Функция Коды(С)
	Р = "";
	Для к = 1 По СтрДлина(С) Цикл
		Р = Р + Ч(КодСимвола(С, к)) + " ";
	КонецЦикла;
	Возврат "[" + СокрЛП(Р) + "]";
КонецФункции

// Поток из шестнадцати байтов 65..80 («A».."P»).
Функция СвежийПоток()
	Б = Новый БуферДвоичныхДанных(16);
	Для н = 0 По 15 Цикл
		Б[н] = н + 65;
	КонецЦикла;
	Пот = Новый ПотокВПамяти;
	Пот.Записать(Б, 0, 16);
	Пот.Перейти(0, ПозицияВПотоке.Начало);
	Возврат Пот;
КонецФункции

// --- типы ---------------------------------------------------------------
П("тип читателя", Строка(Тип("ЧтениеДанных")));
П("тип писателя", Строка(Тип("ЗаписьДанных")));
П("тип результата", Строка(Тип("РезультатЧтенияДанных")));
П("тип по-английски", Строка(Тип("DataReader")));
П("типы читателя и писателя различны", Строка(Тип("ЧтениеДанных") = Тип("ЗаписьДанных")));

Пот = СвежийПоток();
Чт = Новый ЧтениеДанных(Пот);
П("значение читателя печатается", Строка(Чт));
П("ТипЗнч читателя", Строка(ТипЗнч(Чт)));
П("ТипЗнч совпадает с Тип", Строка(ТипЗнч(Чт) = Тип("ЧтениеДанных")));

Зап = Новый ЗаписьДанных(Новый ПотокВПамяти);
П("значение писателя печатается", Строка(Зап));

// --- умолчания свойств ----------------------------------------------------
П("читатель ПорядокБайтов", Строка(Чт.ПорядокБайтов));
П("читатель КодировкаТекста", Строка(Чт.КодировкаТекста));
П("читатель РазделительСтрок", Коды(Чт.РазделительСтрок));
П("писатель ПорядокБайтов", Строка(Зап.ПорядокБайтов));
П("писатель КодировкаТекста", Строка(Зап.КодировкаТекста));
П("писатель РазделительСтрок", Коды(Зап.РазделительСтрок));

// --- СОБСТВЕННОГО БУФЕРА НЕТ ----------------------------------------------
// Позиция целевого потока идёт байт в байт за читателем: упреждающего
// чтения у платформы нет.
П("позиция потока после конструктора", Ч(Пот.ТекущаяПозиция()));
Б1 = Чт.ПрочитатьБайт();
П("первый байт", Показ(Б1));
П("позиция потока после первого байта", Ч(Пот.ТекущаяПозиция()));
Б2 = Чт.ПрочитатьБайт();
П("второй байт", Показ(Б2));
П("позиция потока после второго байта", Ч(Пот.ТекущаяПозиция()));

ПотЗ = Новый ПотокВПамяти;
ЗапБ = Новый ЗаписьДанных(ПотЗ);
ЗапБ.ЗаписатьБайт(65);
П("размер целевого сразу после ЗаписатьБайт", Ч(ПотЗ.Размер()));
П("позиция целевого сразу после ЗаписатьБайт", Ч(ПотЗ.ТекущаяПозиция()));

// --- ЧЕРЕДОВАНИЕ ------------------------------------------------------------
// Прямой `Перейти` на целевом потоке между операциями читателя — ошибка.
ПотЧ = СвежийПоток();
ЧтЧ = Новый ЧтениеДанных(ПотЧ);
ПервыйЧ = ЧтЧ.ПрочитатьБайт();
П("чередование: байт до Перейти", Показ(ПервыйЧ));
ПотЧ.Перейти(5, ПозицияВПотоке.Начало);
Р = "";
Попытка
	Врм = ЧтЧ.ПрочитатьБайт();
	Р = "принято " + Показ(Врм);
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("чередование: чтение после чужого Перейти", Р);

// Возврат позиции на ожидаемую ЛЕЧИТ читателя — ошибка не залипает.
ПотЧ.Перейти(1, ПозицияВПотоке.Начало);
Р = "";
Попытка
	Врм = ЧтЧ.ПрочитатьБайт();
	Р = "принято " + Показ(Врм);
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("чередование: после возврата позиции", Р);

// Переход НА ТУ ЖЕ позицию чередованием не считается.
ПотС = СвежийПоток();
ЧтС = Новый ЧтениеДанных(ПотС);
ПотС.Перейти(0, ПозицияВПотоке.Начало);
Р = "";
Попытка
	Врм = ЧтС.ПрочитатьБайт();
	Р = "принято " + Показ(Врм);
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("переход на ту же позицию", Р);

// У писателя то же самое, и отвергнутая запись НИЧЕГО не пишет.
ПотП = Новый ПотокВПамяти;
ЗапП = Новый ЗаписьДанных(ПотП);
ЗапП.ЗаписатьБайт(65);
РазмДо = ПотП.Размер();
ПотП.Перейти(0, ПозицияВПотоке.Начало);
Р = "";
Попытка
	ЗапП.ЗаписатьЦелое32(1234567);
	Р = "принято";
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("чередование писателя: запись", Р);
П("размер до отвергнутой записи", Ч(РазмДо));
П("размер после отвергнутой записи", Ч(ПотП.Размер()));
ПотП.Перейти(1, ПозицияВПотоке.Начало);
Р = "";
Попытка
	ЗапП.ЗаписатьБайт(66);
	Р = "принято, размер " + Ч(ПотП.Размер());
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("писатель после возврата позиции", Р);

// --- ПОРЯДОК БАЙТОВ ----------------------------------------------------------
// Байты 65 66: little-endian даёт 16961, big-endian 16706.
ПотЦ = СвежийПоток();
ЧтЦ = Новый ЧтениеДанных(ПотЦ);
П("целое16 по умолчанию", Показ(ЧтЦ.ПрочитатьЦелое16()));

ПотЦ2 = СвежийПоток();
ЧтЦ2 = Новый ЧтениеДанных(ПотЦ2);
П("целое16 явным BigEndian", Показ(ЧтЦ2.ПрочитатьЦелое16(ПорядокБайтов.BigEndian)));

// СВОЙСТВО у читателя меняет только геттер: чтение идёт порядком из
// конструктора.
ПотЦ3 = СвежийПоток();
ЧтЦ3 = Новый ЧтениеДанных(ПотЦ3);
ЧтЦ3.ПорядокБайтов = ПорядокБайтов.BigEndian;
П("читатель: свойство после присваивания", Строка(ЧтЦ3.ПорядокБайтов));
П("читатель: целое16 после присваивания свойства", Показ(ЧтЦ3.ПрочитатьЦелое16()));

ПотЦ4 = СвежийПоток();
ЧтЦ4 = Новый ЧтениеДанных(ПотЦ4, "UTF-8", ПорядокБайтов.BigEndian);
П("читатель: целое16 при BigEndian из конструктора", Показ(ЧтЦ4.ПрочитатьЦелое16()));

П("целое32 по умолчанию", Показ(ЧтЦ.ПрочитатьЦелое32()));

// У ПИСАТЕЛЯ то же свойство живое.
БуфЗ = Новый БуферДвоичныхДанных(8);
ПотБ = Новый ПотокВПамяти(БуфЗ);
ЗапЦ = Новый ЗаписьДанных(ПотБ);
ЗапЦ.ЗаписатьЦелое16(258);
П("писатель: целое16 по умолчанию", Дамп(БуфЗ));

БуфЗ2 = Новый БуферДвоичныхДанных(8);
ПотБ2 = Новый ПотокВПамяти(БуфЗ2);
ЗапЦ2 = Новый ЗаписьДанных(ПотБ2);
ЗапЦ2.ПорядокБайтов = ПорядокБайтов.BigEndian;
ЗапЦ2.ЗаписатьЦелое16(258);
П("писатель: целое16 после присваивания свойства", Дамп(БуфЗ2));

БуфЗ3 = Новый БуферДвоичныхДанных(8);
ПотБ3 = Новый ПотокВПамяти(БуфЗ3);
ЗапЦ3 = Новый ЗаписьДанных(ПотБ3);
ЗапЦ3.ЗаписатьЦелое16(258, ПорядокБайтов.BigEndian);
П("писатель: целое16 явным BigEndian", Дамп(БуфЗ3));

// --- ТЕКСТ И РАЗДЕЛИТЕЛЬ -------------------------------------------------------
// Сигнатуры в поток нет, а каждый перевод строки разворачивается в ВК+ПС.
БуфТ = Новый БуферДвоичныхДанных(16);
ПотТ = Новый ПотокВПамяти(БуфТ);
ЗапТ = Новый ЗаписьДанных(ПотТ);
ЗапТ.ЗаписатьСимволы("Аб");
П("байты ЗаписатьСимволы(Аб)", Дамп(БуфТ));

БуфТ2 = Новый БуферДвоичныхДанных(16);
ПотТ2 = Новый ПотокВПамяти(БуфТ2);
ЗапТ2 = Новый ЗаписьДанных(ПотТ2);
ЗапТ2.ЗаписатьСимволы("A" + Символ(10) + "B");
П("байты ЗаписатьСимволы(A ПС B)", Дамп(БуфТ2));

БуфТ3 = Новый БуферДвоичныхДанных(16);
ПотТ3 = Новый ПотокВПамяти(БуфТ3);
ЗапТ3 = Новый ЗаписьДанных(ПотТ3);
ЗапТ3.ЗаписатьСтроку("AB");
П("байты ЗаписатьСтроку(AB)", Дамп(БуфТ3));

БуфТ4 = Новый БуферДвоичныхДанных(16);
ПотТ4 = Новый ПотокВПамяти(БуфТ4);
ЗапТ4 = Новый ЗаписьДанных(ПотТ4);
ЗапТ4.РазделительСтрок = "!";
ЗапТ4.ЗаписатьСтроку("AB");
П("байты ЗаписатьСтроку при разделителе !", Дамп(БуфТ4));

БуфТ5 = Новый БуферДвоичныхДанных(16);
ПотТ5 = Новый ПотокВПамяти(БуфТ5);
ЗапТ5 = Новый ЗаписьДанных(ПотТ5);
ЗапТ5.ЗаписатьСтроку("AB", "UTF-8", "!");
П("байты ЗаписатьСтроку с разделителем аргументом", Дамп(БуфТ5));

БуфТ6 = Новый БуферДвоичныхДанных(16);
ПотТ6 = Новый ПотокВПамяти(БуфТ6);
ЗапТ6 = Новый ЗаписьДанных(ПотТ6);
ЗапТ6.ЗаписатьСимволы("Аб", "windows-1251");
П("байты ЗаписатьСимволы(Аб, windows-1251)", Дамп(БуфТ6));

БуфТ7 = Новый БуферДвоичныхДанных(16);
ПотТ7 = Новый ПотокВПамяти(БуфТ7);
ЗапТ7 = Новый ЗаписьДанных(ПотТ7);
ЗапТ7.КодировкаТекста = "windows-1251";
ЗапТ7.ЗаписатьСимволы("Аб");
П("байты после присваивания КодировкаТекста", Дамп(БуфТ7));

// --- ЧТЕНИЕ ТЕКСТА ---------------------------------------------------------------
// Количество у `ПрочитатьСимволы` — в СИМВОЛАХ, а не в байтах.
БуфЧ = Новый БуферДвоичныхДанных(16);
ПотЧт = Новый ПотокВПамяти(БуфЧ);
ЗапЧт = Новый ЗаписьДанных(ПотЧт);
ЗапЧт.ЗаписатьСимволы("АБВГ");
ПотЧт2 = Новый ПотокВПамяти(БуфЧ);
ЧтТ = Новый ЧтениеДанных(ПотЧт2);
П("ПрочитатьСимволы(2) над кириллицей", ЧтТ.ПрочитатьСимволы(2));
П("позиция потока после двух символов", Ч(ПотЧт2.ТекущаяПозиция()));

ПотЧт3 = Новый ПотокВПамяти(БуфТ6);
ЧтТ2 = Новый ЧтениеДанных(ПотЧт3, "windows-1251");
П("круг windows-1251", ЧтТ2.ПрочитатьСимволы(2));

// Разделитель поглощается и в результат не входит; обратного перевода
// ВК+ПС в ПС при чтении нет.
ПотР = СвежийПоток();
ЧтР = Новый ЧтениеДанных(ПотР);
П("ПрочитатьСтроку при пустом разделителе", ЧтР.ПрочитатьСтроку());

ПотР2 = СвежийПоток();
ЧтР2 = Новый ЧтениеДанных(ПотР2);
ЧтР2.РазделительСтрок = "F";
П("строка 1 при разделителе F", ЧтР2.ПрочитатьСтроку());
П("строка 2 при разделителе F", ЧтР2.ПрочитатьСтроку());

ПотР3 = СвежийПоток();
ЧтР3 = Новый ЧтениеДанных(ПотР3, "UTF-8", ПорядокБайтов.LittleEndian, "CD");
П("строка 1 при разделителе CD", ЧтР3.ПрочитатьСтроку());
П("строка 2 при разделителе CD", ЧтР3.ПрочитатьСтроку());

ПотР4 = Новый ПотокВПамяти(БуфТ3);
ЧтР4 = Новый ЧтениеДанных(ПотР4);
ЧтР4.РазделительСтрок = Символ(10);
СтрокаКруг = ЧтР4.ПрочитатьСтроку();
П("круг ЗаписатьСтроку -> ПрочитатьСтроку", Коды(СтрокаКруг));

// --- КРАЙ ИСТОЧНИКА --------------------------------------------------------------
ПустПот = Новый ПотокВПамяти;
ЧтПуст = Новый ЧтениеДанных(ПустПот);
П("ПрочитатьБайт на пустом", Показ(ЧтПуст.ПрочитатьБайт()));
П("ПрочитатьСимволы на пустом", "[" + ЧтПуст.ПрочитатьСимволы(4) + "]");
П("ПрочитатьСтроку на пустом", "[" + ЧтПуст.ПрочитатьСтроку() + "]");
РезПуст = ЧтПуст.Прочитать(4);
П("Прочитать(4) на пустом: размер", Ч(РезПуст.Размер));
БуфПуст = ЧтПуст.ПрочитатьВБуферДвоичныхДанных(4);
П("ПрочитатьВБуферДвоичныхДанных на пустом: размер", Ч(БуфПуст.Размер));

// Неполное целое — `Неопределено`, и позиция при этом ОТКАТЫВАЕТСЯ.
ПотК = СвежийПоток();
ЧтК = Новый ЧтениеДанных(ПотК);
ПропК = ЧтК.Пропустить(13);
П("Пропустить(13) вернуло", Ч(ПропК));
П("позиция после Пропустить(13)", Ч(ПотК.ТекущаяПозиция()));
П("целое32 при трёх оставшихся байтах", Показ(ЧтК.ПрочитатьЦелое32()));
П("позиция после неудачного целого", Ч(ПотК.ТекущаяПозиция()));
П("следующий байт после неудачного целого", Показ(ЧтК.ПрочитатьБайт()));

// `Пропустить` ПЕРЕВОДИТ позицию, а не вычитывает байты.
ПотП2 = СвежийПоток();
ЧтП2 = Новый ЧтениеДанных(ПотП2);
ПропП2 = ЧтП2.Пропустить(100);
П("Пропустить(100) вернуло", Ч(ПропП2));
П("позиция потока после Пропустить(100)", Ч(ПотП2.ТекущаяПозиция()));
П("размер потока после Пропустить(100)", Ч(ПотП2.Размер()));

// Массовые чтения отдают СКОЛЬКО ЕСТЬ, а ноль значит «всё».
ПотМ = СвежийПоток();
ЧтМ = Новый ЧтениеДанных(ПотМ);
РезМ = ЧтМ.Прочитать(100);
П("Прочитать(100) при 16 байтах: размер", Ч(РезМ.Размер));

ПотМ2 = СвежийПоток();
ЧтМ2 = Новый ЧтениеДанных(ПотМ2);
РезМ2 = ЧтМ2.Прочитать(0);
П("Прочитать(0) при 16 байтах: размер", Ч(РезМ2.Размер));

ПотМ3 = СвежийПоток();
ЧтМ3 = Новый ЧтениеДанных(ПотМ3);
П("ПрочитатьСимволы(0) при 16 байтах", ЧтМ3.ПрочитатьСимволы(0));

// --- РЕЗУЛЬТАТ ЧТЕНИЯ --------------------------------------------------------------
ПотРез = СвежийПоток();
ЧтРез = Новый ЧтениеДанных(ПотРез);
