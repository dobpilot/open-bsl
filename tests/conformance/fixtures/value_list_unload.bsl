// Независимый массив значений списка на платформе.
Процедура М(ИдПробы, ЗначениеПробы)
    Сообщить(ИдПробы + Символ(9) + Строка(ЗначениеПробы));
КонецПроцедуры
М("VLIST.UNLOAD.BEGIN", "1");
СписокПробы = Новый СписокЗначений;
МассивПробы = Неопределено;
Попытка
    Выполнить("МассивПробы = СписокПробы.ВыгрузитьЗначения();");
    М("VLIST.UNLOAD.EMPTY", МассивПробы.Количество());
    СписокПробы.Добавить("первое", "другое представление");
    СписокПробы.Добавить(17, "число");
    СписокПробы.Добавить(Неопределено);
    Выполнить("МассивПробы = СписокПробы.UnloadValues();");
    М("VLIST.UNLOAD.TYPE", ?(ТипЗнч(МассивПробы) = Тип("Массив"), "YES", "NO"));
    М("VLIST.UNLOAD.COUNT", МассивПробы.Количество());
    М("VLIST.UNLOAD.ORDER", МассивПробы[0] + "|" + Строка(МассивПробы[1]));
    М("VLIST.UNLOAD.UNDEFINED", ?(МассивПробы[2] = Неопределено, "YES", "NO"));
    МассивПробы[0] = "изменено";
    М("VLIST.UNLOAD.INDEPENDENT", СписокПробы[0].Значение);
    ВложенныйПробы = Новый Структура("Ключ", "до");
    СписокПробы.Добавить(ВложенныйПробы);
    Выполнить("МассивПробы = СписокПробы.ВыгрузитьЗначения();");
    МассивПробы[3].Ключ = "после";
    М("VLIST.UNLOAD.SHARED.VALUE", СписокПробы[3].Значение.Ключ);
Исключение
    М("VLIST.UNLOAD.ERROR", ОписаниеОшибки());
КонецПопытки;
М("VLIST.UNLOAD.END", "1");
