// JSON: сценарии из статьи «Средства работы с JSON» на wonderland.v8.1c.ru.
//
// Эталон снят с реальной 8.3.27 тем же run-on-1c.sh, что и замеры.
// Подробный разбор контракта — в tests/conformance/measure/measure-json.bsl
// и в обзоре модуля bsl_rt::json; здесь — то, как этим пользуются.

// --- Сериализация объекта из статьи -------------------------------------
Человек = Новый Структура;
Человек.Вставить("Фамилия", "Иванов");
Человек.Вставить("Имя", "Иван");
Человек.Вставить("Отчество", "Иванович");
Человек.Вставить("Возраст", 42);
Человек.Вставить("Женат", Истина);
Телефоны = Новый Массив;
Телефоны.Добавить("+7 900 000-00-01");
Телефоны.Добавить("+7 900 000-00-02");
Человек.Вставить("Телефоны", Телефоны);

Запись = Новый ЗаписьJSON;
Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
ЗаписатьJSON(Запись, Человек);
ТекстJSON = Запись.Закрыть();
Сообщить(ТекстJSON);

// --- Десериализация обратно ---------------------------------------------
Чтение = Новый ЧтениеJSON;
Чтение.УстановитьСтроку(ТекстJSON);
Обратно = ПрочитатьJSON(Чтение);
Сообщить(Обратно.Фамилия + " " + Обратно.Имя + ", " + Строка(Обратно.Возраст));
Сообщить(Строка(ТипЗнч(Обратно.Телефоны)) + " из " + Строка(Обратно.Телефоны.Количество()));
Сообщить(Обратно.Телефоны[0]);

// --- Массив объектов, как в примере с двумя людьми -----------------------
Чтение = Новый ЧтениеJSON;
Чтение.УстановитьСтроку("[{""имя"":""Иван"",""возраст"":30},{""имя"":""Пётр"",""возраст"":25}]");
Люди = ПрочитатьJSON(Чтение);
Для Каждого Человек Из Люди Цикл
	Сообщить(Человек.имя + ": " + Строка(Человек.возраст));
КонецЦикла;

// --- Потоковое чтение: собрать только имена свойств верхнего уровня ------
Чтение = Новый ЧтениеJSON;
Чтение.УстановитьСтроку("{""а"":1,""б"":{""в"":2},""г"":[3,4]}");
Имена = "";
Глубина = 0;
Пока Чтение.Прочитать() Цикл
	Тип = Чтение.ТипТекущегоЗначения;
	Если Тип = ТипЗначенияJSON.НачалоОбъекта ИЛИ Тип = ТипЗначенияJSON.НачалоМассива Тогда
		Глубина = Глубина + 1;
	ИначеЕсли Тип = ТипЗначенияJSON.КонецОбъекта ИЛИ Тип = ТипЗначенияJSON.КонецМассива Тогда
		Глубина = Глубина - 1;
	ИначеЕсли Тип = ТипЗначенияJSON.ИмяСвойства И Глубина = 1 Тогда
		Имена = Имена + Чтение.ТекущееЗначение + " ";
	КонецЕсли;
КонецЦикла;
Сообщить("свойства верхнего уровня: " + Имена);

// --- Потоковая запись вручную -------------------------------------------
Запись = Новый ЗаписьJSON;
Запись.УстановитьСтроку();
Запись.ЗаписатьНачалоМассива();
Запись.ЗаписатьЗначение(1);
Запись.ЗаписатьЗначение("два");
Запись.ЗаписатьЗначение(Истина);
Запись.ЗаписатьНачалоОбъекта();
Запись.ЗаписатьИмяСвойства("вложенное");
Запись.ЗаписатьЗначение("значение");
Запись.ЗаписатьКонецОбъекта();
Запись.ЗаписатьКонецМассива();
Сообщить(СтрЗаменить(Запись.Закрыть(), Символ(10), "|"));

// --- Пропуск неинтересной части документа -------------------------------
// Пропустить проглатывает значение ЦЕЛИКОМ и встаёт на следующий элемент —
// не на закрывающую скобку пропущенного. Отсюда и порядок вызовов ниже:
// лишнего Прочитать после него не нужно, иначе имя проскочит мимо.
Чтение = Новый ЧтениеJSON;
Чтение.УстановитьСтроку("{""большое"":[1,2,3,4,5],""нужное"":7}");
Чтение.Прочитать();
Чтение.Прочитать();
Чтение.Прочитать();
Чтение.Пропустить();
Сообщить("после пропуска: " + Строка(Чтение.ТипТекущегоЗначения) + " " + Чтение.ТекущееЗначение);
Чтение.Прочитать();
Сообщить("нужное = " + Строка(Чтение.ТекущееЗначение));

// --- Соответствие вместо структуры --------------------------------------
Чтение = Новый ЧтениеJSON;
Чтение.УстановитьСтроку("{""ключ с пробелом"":1}");
Соотв = ПрочитатьJSON(Чтение, Истина);
Сообщить(Строка(ТипЗнч(Соотв)) + ": " + Строка(Соотв.Получить("ключ с пробелом")));

// --- Даты ----------------------------------------------------------------
Чтение = Новый ЧтениеJSON;
Чтение.УстановитьСтроку("{""Создан"":""2024-03-04T05:06:07"",""Текст"":""2024-03-04T05:06:07""}");
ИменаДат = Новый Массив;
ИменаДат.Добавить("Создан");
Документ = ПрочитатьJSON(Чтение, Истина, ИменаДат);
Сообщить(Строка(ТипЗнч(Документ.Получить("Создан"))) + " / " + Строка(ТипЗнч(Документ.Получить("Текст"))));

Запись = Новый ЗаписьJSON;
Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
ЗаписатьJSON(Запись, Новый Структура("Создан", Дата(2024, 3, 4, 5, 6, 7)));
Сообщить(Запись.Закрыть());
