// Общий модуль фикстуры use-modules: экспортная переменная, экспортная
// функция и побочный эффект тела — порядок его вывода доказывает
// нележивую (eager) инициализацию расширения //@используй.
Перем Счётчик Экспорт;

Функция Удвоить(Знач х) Экспорт
	Счётчик = Счётчик + 1;
	Возврат х * 2;
КонецФункции

Счётчик = 10;
Сообщить("модуль инициализирован");
