// Смок транзита внутреннего формата: значение -> строка -> значение ->
// строка (и та же дорога через файл) обязаны быть тождественными.
// Эталон vstr-transit-smoke.expected СНЯТ С ПЛАТФОРМЫ 8.3.27 прогоном
// этого же файла.
//
// Чтобы проверить СОБСТВЕННУЮ выгрузку (в том числе с конфиденциальными
// данными), скопируйте скрипт и подставьте путь в `ЗначениеИзФайла`:
// в вывод попадают только вердикты, содержимое данных — никогда.

Функция Вердикт(Метка, Ожидалось, Получено)
	Если Ожидалось = Получено Тогда
		Возврат Метка + ": Ок";
	КонецЕсли;
	Возврат Метка + ": РАЗОШЁЛСЯ (" + Формат(СтрДлина(Ожидалось), "ЧГ=0")
		+ " -> " + Формат(СтрДлина(Получено), "ЧГ=0") + " симв.)";
КонецФункции

// Представительное значение: скаляры всех видов, вложенные коллекции,
// таблица с типизированной колонкой и пропуском Неопределено.
Таблица = Новый ТаблицаЗначений;
Таблица.Колонки.Добавить("Имя");
Таблица.Колонки.Добавить("Возраст", Новый ОписаниеТипов("Число"));
Таблица.Колонки.Добавить("Хвост");
Стр = Таблица.Добавить();
Стр.Имя = "а""б" + Символ(10) + "в";
Стр.Возраст = 7;

Карта = Новый Соответствие;
Карта.Вставить("к", '20240506070809');

Значение = Новый Массив;
Значение.Добавить(0.1);
Значение.Добавить("строка");
Значение.Добавить(Истина);
Значение.Добавить(Неопределено);
Значение.Добавить(NULL);
Значение.Добавить(Тип("Строка"));
Значение.Добавить(Новый Структура("Поле", 3));
Значение.Добавить(Карта);
Значение.Добавить(Таблица);

// Строковый транзит.
Строкой = ЗначениеВСтрокуВнутр(Значение);
Сообщить(Вердикт("строковый транзит", Строкой, ЗначениеВСтрокуВнутр(ЗначениеИзСтрокиВнутр(Строкой))));

// Файловый транзит.
Путь = "/tmp/open-bsl-vstr-smoke.txt";
ЗначениеВФайл(Путь, Значение);
Сообщить(Вердикт("файловый транзит", Строкой, ЗначениеВСтрокуВнутр(ЗначениеИзФайла(Путь))));

// Виды, которые эта реализация не материализует, — ссылка объекта базы,
// УникальныйИдентификатор, СписокЗначений (строки сняты с платформы), —
// обязаны переживать транзит без изменений.
Литералы = Новый Массив;
Литералы.Добавить("{""#"",c0c2cbee-990e-410d-9c63-b5222c1dacba,53:866e48f17f20bbba11f190e0bddf9004}");
Литералы.Добавить("{""#"",fc01b5df-97fe-449b-83d4-218a090e681e,12345678-9abc-def0-1234-56789abcdef0}");
Номер = 0;
Для Каждого Литерал Из Литералы Цикл
	Номер = Номер + 1;
	Сообщить(Вердикт("литерал " + Формат(Номер, "ЧГ=0"), Литерал, ЗначениеВСтрокуВнутр(ЗначениеИзСтрокиВнутр(Литерал))));
КонецЦикла;

// Таблица с квалификаторами типов колонок (строка снята с платформы) —
// квалификаторы обязаны пережить дорогу.
Квалифицированная = "{""#"",acf6192e-81ca-46ef-93a6-5a6968b78663," + Символ(10)
	+ "{9," + Символ(10) + "{1," + Символ(10) + "{0,""Ч""," + Символ(10)
	+ "{""Pattern""," + Символ(10) + "{""N"",10,2,0}" + Символ(10) + "},"""",0}"
	+ Символ(10) + "}," + Символ(10) + "{2,1,0,0," + Символ(10) + "{1,0},0,-1},"
	+ Символ(10) + "{0,0}" + Символ(10) + "}" + Символ(10) + "}";
Сообщить(Вердикт("квалификаторы", Квалифицированная, ЗначениеВСтрокуВнутр(ЗначениеИзСтрокиВнутр(Квалифицированная))));
