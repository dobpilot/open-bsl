// Фабрика XDTO: оба конструктора, поиск типа, создание значения и
// экземпляра объекта.
//
// Эталон снят с платформы 8.3.27:
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/fixtures/xdto-factory.bsl
//
// Два конструктора НЕ взаимозаменяемы, и это измерено: файл XSD берёт
// только `СоздатьФабрикуXDTO`, набор схем — только `Новый ФабрикаXDTO`.
// Поэтому схема здесь и пишется во временный файл, и разбирается в набор:
// фикстура самодостаточна на обеих сторонах и задевает оба пути.
//
// Печатается только то, что у платформы и у этой реализации совпадает
// дословно. Ошибочные случаи печатаются ФАКТОМ («ошибка»), а не текстом:
// тексты исключений у платформы свои. Арность нигде не нарушается
// намеренно: неверное число аргументов — это ошибка КОМПИЛЯЦИИ, и она
// снесла бы всю фикстуру вместо одной строки.

Перем Фаб;
Перем Наб;

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

Функция ИсточникСхемы()
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>"
		+ "<xs:schema xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:t=""urn:test"""
		+ " targetNamespace=""urn:test"" elementFormDefault=""qualified"">"
		+ "<xs:element name=""root"" type=""t:RootType""/>"
		+ "<xs:simpleType name=""Code"">"
		+ "<xs:restriction base=""xs:string""><xs:minLength value=""2""/>"
		+ "</xs:restriction></xs:simpleType>"
		+ "<xs:complexType name=""RootType""><xs:sequence>"
		+ "<xs:element name=""name"" type=""xs:string""/>"
		+ "<xs:element name=""code"" type=""t:Code"" minOccurs=""0""/>"
		+ "</xs:sequence>"
		+ "<xs:attribute name=""id"" type=""xs:int"" use=""required""/>"
		+ "</xs:complexType>"
		+ "<xs:complexType name=""AbstrType"" abstract=""true""><xs:sequence>"
		+ "<xs:element name=""x"" type=""xs:string""/></xs:sequence></xs:complexType>"
		+ "</xs:schema>";
КонецФункции

НС = "http://www.w3.org/2001/XMLSchema";
Путь = "/tmp/open-bsl-xdto-factory.xsd";
Зп = Новый ЗаписьТекста(Путь);
Зп.Записать(ИсточникСхемы());
Зп.Закрыть();

// --- конструктор от файла XSD ---------------------------------------------

Фаб = СоздатьФабрикуXDTO(Путь);
П("фабрика", Строка(Фаб));
П("тип фабрики", Строка(ТипЗнч(Фаб)));
П("две фабрики от одного файла равны", Строка(СоздатьФабрикуXDTO(Путь) = Фаб));
П("фабрика равна себе", Строка(Фаб = Фаб));

// --- поиск типа -----------------------------------------------------------

Тип1 = Фаб.Тип("urn:test", "RootType");
П("тип парой", Строка(Тип1));
П("тип парой это", Строка(ТипЗнч(Тип1)));
П("тип расширенным именем", Строка(Фаб.Тип(Новый РасширенноеИмяXML("urn:test", "RootType"))));
П("два обращения равны", Строка(Фаб.Тип("urn:test", "RootType") = Тип1));
П("тип значения", Строка(ТипЗнч(Фаб.Тип("urn:test", "Code"))));
П("встроенный тип", Строка(Фаб.Тип(НС, "string")));
П("неизвестное имя", "[" + Строка(Фаб.Тип("urn:test", "НетТакого")) + "]");
П("чужой URI", "[" + Строка(Фаб.Тип("urn:нет", "RootType")) + "]");
// Объявление глобального ЭЛЕМЕНТА типом не является.
П("глобальный элемент", "[" + Строка(Фаб.Тип("urn:test", "root")) + "]");

Попытка
	Т2 = Фаб.Тип("RootType");
	П("тип одной строкой", "ок");
Исключение
	П("тип одной строкой", "ошибка");
КонецПопытки;

// --- создание значения ----------------------------------------------------

Знч = Фаб.Создать(Фаб.Тип("urn:test", "Code"), "AB");
П("значение это", Строка(ТипЗнч(Знч)));
П("значение", Строка(Знч.Значение));
П("лексическое значение", Знч.ЛексическоеЗначение);
Цел = Фаб.Создать(Фаб.Тип(НС, "int"), "-42");
П("целое значение", Строка(Цел.Значение));
П("целое это", Строка(ТипЗнч(Цел.Значение)));
П("значение без лексики", "[" + Строка(Фаб.Создать(Фаб.Тип(НС, "int"))) + "]");

Попытка
	Плохое = Фаб.Создать(Фаб.Тип(НС, "int"), "ерунда");
	П("негодная лексика", "ок");
Исключение
	П("негодная лексика", "ошибка");
КонецПопытки;

// --- создание экземпляра объекта ------------------------------------------

Об = Фаб.Создать(Тип1);
П("объект", Строка(Об));
П("объект это", Строка(ТипЗнч(Об)));
П("тип объекта", Строка(Об.Тип()));
П("тип объекта тот же", Строка(Об.Тип() = Тип1));
П("два объекта равны", Строка(Фаб.Создать(Тип1) = Фаб.Создать(Тип1)));

Попытка
	Об2 = Фаб.Создать(Тип1, "аб");
	П("объект с лексикой", "ок");
Исключение
	П("объект с лексикой", "ошибка");
КонецПопытки;

Попытка
	Об3 = Фаб.Создать(Фаб.Тип("urn:test", "AbstrType"));
	П("объект абстрактного типа", "ок");
Исключение
	П("объект абстрактного типа", "ошибка");
КонецПопытки;

// --- конструктор от набора схем -------------------------------------------

Пост = Новый ПостроительDOM;
Чт = Новый ЧтениеXML;
Чт.УстановитьСтроку(ИсточникСхемы());
ПостСхем = Новый ПостроительСхемXML;
Сх = ПостСхем.СоздатьСхемуXML(Пост.Прочитать(Чт));
Наб = Новый НаборСхемXML;
Наб.Добавить(Сх);

ФабН = Новый ФабрикаXDTO(Наб);
П("фабрика от набора", Строка(ТипЗнч(ФабН)));
П("тип от набора", Строка(ФабН.Тип("urn:test", "RootType")));
П("свойство от набора", Строка(ФабН.Тип("urn:test", "RootType").Свойства.Получить("name")));
П("значение от набора", ФабН.Создать(ФабН.Тип("urn:test", "Code"), "CD").ЛексическоеЗначение);

// Фабрика без набора знает встроенные типы и не знает наших.
ФабП = Новый ФабрикаXDTO;
П("пустая фабрика встроенный", Строка(ФабП.Тип(НС, "string")));
П("пустая фабрика свой тип", "[" + Строка(ФабП.Тип("urn:test", "RootType")) + "]");

Попытка
	ФабX = Новый ФабрикаXDTO(Путь);
	П("новый от пути", "ок");
Исключение
	П("новый от пути", "ошибка");
КонецПопытки;

Попытка
	ФабY = СоздатьФабрикуXDTO("/нет/такого/файла.xsd");
	П("файла нет", "ок");
Исключение
	П("файла нет", "ошибка");
КонецПопытки;

// --- глобальная ФабрикаXDTO -----------------------------------------------
// У платформы это фабрика КОНФИГУРАЦИИ: она есть, но типов нашей схемы не
// знает — `Тип` отдаёт `Неопределено`. У этой реализации конфигурации нет
// вовсе, и обращение к глобальному имени — ловимая ошибка. Печатается
// поэтому один факт, верный на ОБЕИХ сторонах и по разным причинам: своего
// типа через глобальную фабрику не достать.

Достали = "нет";
Попытка
	Если ФабрикаXDTO.Тип("urn:test", "RootType") <> Неопределено Тогда
		Достали = "да";
	КонецЕсли;
Исключение
	Достали = "нет";
КонецПопытки;
П("глобальная фабрика знает наш тип", Достали);
