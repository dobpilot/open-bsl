// `ПрочитатьXML`/`ЗаписатьXML` фабрики XDTO: разбор документа в
// `ОбъектXDTO`/`ЗначениеXDTO` по типам схемы, обратная запись и круг.
//
// Эталон снят с платформы 8.3.27:
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/fixtures/xdto-xml-io.bsl
//
// Обвязка та же, что у `xdto-factory` и `xdto-instances`: схема пишется во
// временный файл и фабрика строится по нему. Ошибочные случаи печатаются
// ФАКТОМ («ошибка»), а не текстом исключения: у платформы он многострочный
// и с координатами в документе.
//
// ЧЕГО ЗДЕСЬ НЕТ И ПОЧЕМУ.
//
// * Чтение БЕЗ второго аргумента. Платформа в этом случае разбирает
//   документ в ОТКРЫТОЕ содержимое `anyType`: свойства заводятся по ходу
//   разбора, значения остаются строками («12.50», «true»), а посторонний
//   элемент ошибкой не считается. Открытого содержимого в этой реализации
//   нет, и вызов без типа отвечает отказом — см. шапку `bsl-rt/src/xdto.rs`.
// * Свойство СПИСОЧНОГО простого типа отдаётся платформой как
//   `ФиксированныйМассив`, а здесь как `Массив` (расхождение описано у
//   `value_from_lexical_at`), поэтому у `codes` печатается длина и
//   записанная лексическая форма, но не тип.
// * Фасеты: платформа проверяет по ним лексическую форму, здесь они только
//   хранятся, поэтому в схеме фикстуры фасетов нет.

Перем Фаб;
Перем ТипКорня;
Перем ТипВнутр;
Перем ДокПолный;
Перем НСXSD;

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

// Переводы строки и табуляции в записанном XML — видимыми, иначе
// построчное сличение с платформой ничего не покажет.
Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Р = СтрЗаменить(Р, Символ(10), "<ПС>");
	Возврат СтрЗаменить(Р, Символ(9), "<Т>");
КонецФункции

Функция ИсточникСхемы()
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>"
		+ "<xs:schema xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:t=""urn:test"""
		+ " targetNamespace=""urn:test"" elementFormDefault=""qualified"""
		+ " attributeFormDefault=""unqualified"">"
		+ "<xs:simpleType name=""Codes""><xs:list itemType=""xs:int""/></xs:simpleType>"
		+ "<xs:complexType name=""Inner""><xs:sequence>"
		+ "<xs:element name=""in"" type=""xs:string""/>"
		+ "</xs:sequence>"
		+ "<xs:attribute name=""qi"" type=""xs:string"" form=""qualified""/>"
		+ "</xs:complexType>"
		+ "<xs:complexType name=""InnerExt""><xs:complexContent>"
		+ "<xs:extension base=""t:Inner""><xs:sequence>"
		+ "<xs:element name=""more"" type=""xs:string""/>"
		+ "</xs:sequence></xs:extension></xs:complexContent></xs:complexType>"
		+ "<xs:complexType name=""RootType""><xs:sequence>"
		+ "<xs:element name=""name"" type=""xs:string""/>"
		+ "<xs:element name=""num"" type=""xs:int"" minOccurs=""0""/>"
		+ "<xs:element name=""dec"" type=""xs:decimal"" minOccurs=""0""/>"
		+ "<xs:element name=""when"" type=""xs:date"" minOccurs=""0""/>"
		+ "<xs:element name=""stamp"" type=""xs:dateTime"" minOccurs=""0""/>"
		+ "<xs:element name=""hour"" type=""xs:time"" minOccurs=""0""/>"
		+ "<xs:element name=""flag"" type=""xs:boolean"" minOccurs=""0""/>"
		+ "<xs:element name=""bin"" type=""xs:base64Binary"" minOccurs=""0""/>"
		+ "<xs:element name=""hex"" type=""xs:hexBinary"" minOccurs=""0""/>"
		+ "<xs:element name=""codes"" type=""t:Codes"" minOccurs=""0""/>"
		+ "<xs:element name=""tag"" type=""xs:string"" minOccurs=""0"" maxOccurs=""unbounded""/>"
		+ "<xs:element name=""nested"" type=""t:Inner"" minOccurs=""0""/>"
		+ "<xs:element name=""nilt"" type=""xs:int"" minOccurs=""0"" nillable=""true""/>"
		+ "<xs:element name=""uq"" type=""xs:string"" minOccurs=""0"" form=""unqualified""/>"
		+ "<xs:element name=""notype"" minOccurs=""0""/>"
		+ "</xs:sequence>"
		+ "<xs:attribute name=""id"" type=""xs:int""/>"
		+ "<xs:attribute name=""qa"" type=""xs:string"" form=""qualified""/>"
		+ "</xs:complexType>"
		+ "<xs:complexType name=""ChoiceType""><xs:choice minOccurs=""0"" maxOccurs=""unbounded"">"
		+ "<xs:element name=""ca"" type=""xs:string""/>"
		+ "<xs:element name=""cb"" type=""xs:string""/>"
		+ "</xs:choice></xs:complexType>"
		+ "</xs:schema>";
КонецФункции

// Разбор текста указанным типом.
Функция Чит(Текст, Тип)
	Ч = Новый ЧтениеXML;
	Ч.УстановитьСтроку(Текст);
	Возврат Фаб.ПрочитатьXML(Ч, Тип);
КонецФункции

// Тот же разбор, но интересен только исход.
Функция Исход(Текст, Тип)
	Попытка
		Ч = Новый ЧтениеXML;
		Ч.УстановитьСтроку(Текст);
		Фаб.ПрочитатьXML(Ч, Тип);
	Исключение
		Возврат "ошибка";
	КонецПопытки;
	Возврат "прочитано";
КонецФункции

Функция Зап(Что)
	З = Новый ЗаписьXML;
	З.УстановитьСтроку();
	Фаб.ЗаписатьXML(З, Что);
	Возврат Видимо(З.Закрыть());
КонецФункции

Функция ЗапИменем(Что, Имя)
	З = Новый ЗаписьXML;
	З.УстановитьСтроку();
	Фаб.ЗаписатьXML(З, Что, Имя);
	Возврат Видимо(З.Закрыть());
КонецФункции

Функция ЗапИменемУРИ(Что, Имя, УРИ)
	З = Новый ЗаписьXML;
	З.УстановитьСтроку();
	Фаб.ЗаписатьXML(З, Что, Имя, УРИ);
	Возврат Видимо(З.Закрыть());
КонецФункции

// Заполненный экземпляр корневого типа — приёмник проб на запись.
Функция Образец()
	О = Фаб.Создать(ТипКорня);
	О.name = "аб";
	О.id = 7;
	Возврат О;
КонецФункции

НСXSD = "http://www.w3.org/2001/XMLSchema";
Путь = "/tmp/open-bsl-xdto-xml-io.xsd";
Зп = Новый ЗаписьТекста(Путь);
Зп.Записать(ИсточникСхемы());
Зп.Закрыть();

Фаб = СоздатьФабрикуXDTO(Путь);
ТипКорня = Фаб.Тип("urn:test", "RootType");
ТипВнутр = Фаб.Тип("urn:test", "Inner");

ДокПолный = "<t:root xmlns:t=""urn:test"" id=""7"">"
	+ "<t:name>аб</t:name>"
	+ "<t:num>42</t:num>"
	+ "<t:dec>12.50</t:dec>"
	+ "<t:when>2026-08-13</t:when>"
	+ "<t:stamp>2026-08-13T10:20:30</t:stamp>"
	+ "<t:hour>10:20:30</t:hour>"
	+ "<t:flag>true</t:flag>"
	+ "<t:bin>0LDQsQ==</t:bin>"
	+ "<t:hex>D0B2D0B3</t:hex>"
	+ "<t:codes>1 2 3</t:codes>"
	+ "<t:tag>один</t:tag><t:tag>два</t:tag>"
	+ "<t:nested t:qi=""х""><t:in>вг</t:in></t:nested>"
	+ "<uq>де</uq>"
	+ "</t:root>";

// --- чтение с типом: во что превращаются лексические формы -----------------

Об = Чит(ДокПолный, ТипКорня);
П("объект", Строка(ТипЗнч(Об)));
П("тип объекта", Строка(Об.Тип()));
П("строка", "[" + Строка(Об.name) + "] " + Строка(ТипЗнч(Об.name)));
П("атрибут", "[" + Строка(Об.id) + "] " + Строка(ТипЗнч(Об.id)));
П("целое", "[" + Строка(Об.num) + "] " + Строка(ТипЗнч(Об.num)));
П("дробное", "[" + Строка(Об.dec) + "] " + Строка(ТипЗнч(Об.dec)));
П("дата", "[" + Строка(Об.when) + "] " + Строка(ТипЗнч(Об.when)));
П("момент", "[" + Строка(Об.stamp) + "]");
П("время суток", "[" + Строка(Об.hour) + "]");
П("булево", "[" + Строка(Об.flag) + "] " + Строка(ТипЗнч(Об.flag)));
П("base64", Строка(ТипЗнч(Об.bin)) + " " + Строка(Об.bin.Размер()));
П("hex", Строка(ТипЗнч(Об.hex)) + " " + Строка(Об.hex.Размер()));
П("список", Строка(Об.codes.Количество()));
П("множественное", Строка(ТипЗнч(Об.tag)) + " " + Строка(Об.tag.Количество())
	+ " [" + Строка(Об.tag[0]) + "|" + Строка(Об.tag[1]) + "]");
П("вложенное", Строка(Об.nested.Тип()) + " [" + Строка(Об.nested.in) + "]");
П("вложенный атрибут", "[" + Строка(Об.nested.qi) + "]");
П("неквалифицированное", "[" + Строка(Об.uq) + "]");
П("пропущенное", "[" + Строка(Об.hour = Неопределено) + "]");
П("не встретилось", Строка(Об.Установлено("nilt")));
П("встретилось", Строка(Об.Установлено("name")));
П("свойств у типа", Строка(Об.Свойства().Количество()));
П("последовательность", Строка(Об.Последовательность()));
П("владелец вложенного", Строка(Об.nested.Владелец() = Об));

// --- чтение: пробелы, комментарии, сущности, пустые элементы ---------------

П("пробелы между тегами", "[" + Строка(Чит("<t:root xmlns:t=""urn:test""> <t:name> аб </t:name> </t:root>", ТипКорня).name) + "]");
П("комментарий внутри", "[" + Строка(Чит("<t:root xmlns:t=""urn:test""><!--к--><t:name>аб</t:name></t:root>", ТипКорня).name) + "]");
П("секция CDATA", "[" + Строка(Чит("<t:root xmlns:t=""urn:test""><t:name><![CDATA[аб]]></t:name></t:root>", ТипКорня).name) + "]");
П("ссылки на сущности", "[" + Строка(Чит("<t:root xmlns:t=""urn:test""><t:name>&lt;&amp;&gt;</t:name></t:root>", ТипКорня).name) + "]");
П("объявление XML", "[" + Строка(Чит("<?xml version=""1.0""?><t:root xmlns:t=""urn:test""><t:name>аб</t:name></t:root>", ТипКорня).name) + "]");
П("пустой элемент строки", "[" + Строка(Чит("<t:root xmlns:t=""urn:test""><t:name/></t:root>", ТипКорня).name) + "]");
П("пустой элемент числа", "[" + Строка(Чит("<t:root xmlns:t=""urn:test""><t:name>а</t:name><t:num/></t:root>", ТипКорня).num) + "]");
П("булево единицей", "[" + Строка(Чит("<t:root xmlns:t=""urn:test""><t:name>а</t:name><t:flag>1</t:flag></t:root>", ТипКорня).flag) + "]");

// --- чтение: xsi:nil и xsi:type -------------------------------------------

ОбНил = Чит("<t:root xmlns:t=""urn:test"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"">"
	+ "<t:name>а</t:name><t:nilt xsi:nil=""true""/></t:root>", ТипКорня);
П("nil значение", "[" + Строка(ОбНил.nilt) + "] " + Строка(ТипЗнч(ОбНил.nilt)));
П("nil установлено", Строка(ОбНил.Установлено("nilt")));
П("nil обратно", ЗапИменем(ОбНил, "к"));

ОбТип = Чит("<t:root xmlns:t=""urn:test"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"">"
	+ "<t:name>а</t:name><t:nested xsi:type=""t:InnerExt""><t:in>в</t:in><t:more>г</t:more></t:nested></t:root>", ТипКорня);
П("xsi:type префиксом", Строка(ОбТип.nested.Тип()) + " [" + Строка(ОбТип.nested.more) + "]");
ОбТип2 = Чит("<root xmlns=""urn:test"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"">"
	+ "<name>а</name><nested xsi:type=""InnerExt""><in>в</in><more>г</more></nested></root>", ТипКорня);
П("xsi:type умолчанием", Строка(ОбТип2.nested.Тип()));
// Неизвестное имя типа платформа ИГНОРИРУЕТ и читает объявленным типом.
ОбТип3 = Чит("<точка xmlns=""urn:test"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" xsi:type=""НетТакого"">"
	+ "<in>в</in></точка>", ТипВнутр);
П("xsi:type неизвестный", Строка(ОбТип3.Тип()));
// А на самом читаемом элементе `xsi:type` не действует вовсе.
ОбТип4 = Чит("<точка xmlns=""urn:test"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" xsi:type=""InnerExt"">"
	+ "<in>в</in></точка>", ТипВнутр);
П("xsi:type на корне", Строка(ОбТип4.Тип()));

// --- чтение: свойство типа anyType ----------------------------------------

П("anyType текстом", "[" + Строка(Чит("<t:root xmlns:t=""urn:test""><t:name>а</t:name><t:notype>5</t:notype></t:root>", ТипКорня).notype) + "] "
	+ Строка(ТипЗнч(Чит("<t:root xmlns:t=""urn:test""><t:name>а</t:name><t:notype>5</t:notype></t:root>", ТипКорня).notype)));
ОбЛюбой = Чит("<t:root xmlns:t=""urn:test"" xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"">"
	+ "<t:name>а</t:name><t:notype xsi:type=""xs:decimal"">5</t:notype></t:root>", ТипКорня);
П("anyType с xsi:type", "[" + Строка(ОбЛюбой.notype) + "] " + Строка(ТипЗнч(ОбЛюбой.notype)));

// --- чтение: отказы --------------------------------------------------------

П("лишний элемент", Исход("<t:root xmlns:t=""urn:test""><t:name>а</t:name><t:чужое>б</t:чужое></t:root>", ТипКорня));
П("лишний атрибут", Исход("<t:root xmlns:t=""urn:test"" чужой=""1""><t:name>а</t:name></t:root>", ТипКорня));
П("битая лексика", Исход("<t:root xmlns:t=""urn:test""><t:name>а</t:name><t:num>ab</t:num></t:root>", ТипКорня));
П("обратный порядок", Исход("<t:root xmlns:t=""urn:test""><t:num>42</t:num><t:name>а</t:name></t:root>", ТипКорня));
П("повтор одиночного", Исход("<t:root xmlns:t=""urn:test""><t:name>а</t:name><t:name>б</t:name></t:root>", ТипКорня));
П("множественное вразбивку", Исход("<t:root xmlns:t=""urn:test""><t:name>а</t:name><t:tag>1</t:tag>"
	+ "<t:nested><t:in>в</t:in></t:nested><t:tag>2</t:tag></t:root>", ТипКорня));
П("текст в составном", Исход("<t:root xmlns:t=""urn:test"">мусор<t:name>а</t:name></t:root>", ТипКорня));
П("нет обязательного", Исход("<t:root xmlns:t=""urn:test""/>", ТипКорня));
П("чужой элемент", Исход("<чужой xmlns=""urn:иное""/>", ТипКорня));
П("пропуск необязательного", Исход("<t:root xmlns:t=""urn:test""><t:name>а</t:name><t:flag>true</t:flag></t:root>", ТипКорня));
П("дата со временем", Исход("<t:root xmlns:t=""urn:test""><t:name>а</t:name><t:when>2026-08-13T10:20:30</t:when></t:root>", ТипКорня));
П("атрибут у значения", Исход("<число а=""1"">42</число>", Фаб.Тип(НСXSD, "int")));

// --- чтение: где остаётся читатель -----------------------------------------

ЧтДва = Новый ЧтениеXML;
ЧтДва.УстановитьСтроку("<об xmlns:t=""urn:test""><t:root id=""1""><t:name>а</t:name></t:root>"
	+ "<t:root id=""2""><t:name>б</t:name></t:root><хвост/></об>");
ЧтДва.Прочитать();
ЧтДва.Прочитать();
Первый = Фаб.ПрочитатьXML(ЧтДва, ТипКорня);
П("позиция после первого", Строка(ЧтДва.ТипУзла) + " [" + ЧтДва.Имя + "]");
Второй = Фаб.ПрочитатьXML(ЧтДва, ТипКорня);
П("два подряд", Строка(Первый.id) + "|" + Строка(Второй.id));
П("позиция после второго", Строка(ЧтДва.ТипУзла) + " [" + ЧтДва.Имя + "]");

ЧтОдин = Новый ЧтениеXML;
ЧтОдин.УстановитьСтроку(ДокПолный);
Фаб.ПрочитатьXML(ЧтОдин, ТипКорня);
П("позиция после корня", Строка(ЧтОдин.ТипУзла));
П("читатель исчерпан", Строка(ЧтОдин.Прочитать()));

// --- чтение значений простых типов ----------------------------------------

ЗнЦел = Чит("<число>42</число>", Фаб.Тип(НСXSD, "int"));
П("значение", Строка(ТипЗнч(ЗнЦел)) + " [" + Строка(ЗнЦел.Значение) + "] лексика=[" + ЗнЦел.ЛексическоеЗначение + "]");
ЗнДата = Чит("<д>2026-08-13</д>", Фаб.Тип(НСXSD, "date"));
П("значение даты", Строка(ТипЗнч(ЗнДата.Значение)) + " лексика=[" + ЗнДата.ЛексическоеЗначение + "]");
П("значение битое", Исход("<число>ab</число>", Фаб.Тип(НСXSD, "int")));

// --- запись: имя элемента и пространства имён ------------------------------

П("запись объекта", Зап(Образец()));
П("запись с именем", ЗапИменем(Образец(), "мой"));
П("запись с именем и URI", ЗапИменемУРИ(Образец(), "мой", "urn:иное"));
П("запись недозаполненного", ЗапИменем(Фаб.Создать(ТипКорня), "к"));

ОбАтр = Образец();
ОбАтр.qa = "де";
П("квалифицированный атрибут", ЗапИменем(ОбАтр, "к"));
П("тот же атрибут с чужим URI", ЗапИменемУРИ(ОбАтр, "к", "urn:иное"));

ОбУк = Образец();
ОбУк.uq = "де";
П("неквалифицированный элемент", ЗапИменем(ОбУк, "к"));

ОбГл = Образец();
Вн = Фаб.Создать(ТипВнутр);
Вн.in = "вг";
Вн.qi = "х";
ОбГл.nested = Вн;
П("префикс в глубине", ЗапИменем(ОбГл, "к"));

// --- запись: лексические формы ---------------------------------------------

ОбЛекс = Образец();
ОбЛекс.when = Дата(2026, 8, 13, 10, 20, 30);
П("дата отбрасывает время", ЗапИменем(ОбЛекс, "к"));
ОбЛекс = Образец();
ОбЛекс.stamp = Дата(2026, 8, 13);
П("момент всегда с секундами", ЗапИменем(ОбЛекс, "к"));
ОбЛекс = Образец();
ОбЛекс.hour = Дата(1, 1, 1, 10, 20, 30);
П("время суток", ЗапИменем(ОбЛекс, "к"));
ОбЛекс = Образец();
ОбЛекс.dec = 12.50;
П("хвостовой ноль срезан", ЗапИменем(ОбЛекс, "к"));
ОбЛекс = Образец();
ОбЛекс.dec = -0.25;
П("отрицательное дробное", ЗапИменем(ОбЛекс, "к"));
ОбЛекс = Образец();
ОбЛекс.dec = 1/3;
П("деление на три", ЗапИменем(ОбЛекс, "к"));
ОбЛекс = Образец();
ОбЛекс.flag = Ложь;
