// Контракт блочных операций `БуферДвоичныхДанных`: `ПолучитьСрез`,
// `Записать` и `Скопировать`. Главное здесь — что срез это ОКНО в тот же
// массив байтов, а не копия: правка с любой стороны видна с другой.
// Соседняя фикстура `binary-buffer` покрывает всё остальное у буфера.
//
// Эталон снимается ТОЛЬКО платформой:
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/fixtures/binary-buffer-slice.bsl
//   diff tests/conformance/fixtures/binary-buffer-slice.expected \
//        tests/conformance/fixtures/binary-buffer-slice.platform.txt
//
// ЧЕГО ЗДЕСЬ СОЗНАТЕЛЬНО НЕТ — `Записать` ЗА КОНЕЦ ПРИЁМНИКА. Диапазон
// приёмника платформа не проверяет: `Записать(9, Буф4)` в буфер из восьми
// байтов не бросает исключения, ничего в буфер не кладёт и роняет клиент
// по SIGSEGV на завершении работы — эталон в таком прогоне не снимается
// вовсе. Мера и разностные пробы — в шапке
// `tests/conformance/measure/measure-binbuf.bsl`; здесь остаётся только
// то, что платформа переживает. Единственный оставшийся выход за край —
// «записать не помещается» ниже: два байта мимо четырёхбайтового буфера
// платформа пережила, а у нас запись обрезается по размеру приёмника, и
// видимый результат совпадает.
//
// Правило письма, стоящее прогона (то же, что в `binary-buffer`): метод
// нельзя звать на результате вызова — нужна промежуточная переменная.

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

Функция Дамп(Б)
	С = "";
	Для н = 0 По Б.Размер - 1 Цикл
		С = С + Ч(Б[н]) + " ";
	КонецЦикла;
	Возврат "[" + СокрЛП(С) + "]";
КонецФункции

Функция Восемь()
	Б = Новый БуферДвоичныхДанных(8);
	Для н = 0 По 7 Цикл
		Б[н] = 10 + н;
	КонецЦикла;
	Возврат Б;
КонецФункции

Функция Четыре()
	Б = Новый БуферДвоичныхДанных(4);
	Для н = 0 По 3 Цикл
		Б[н] = 200 + н;
	КонецЦикла;
	Возврат Б;
КонецФункции

// --- ПолучитьСрез: что отдаёт -------------------------------------------

Буфер = Восемь();
Срез = Буфер.ПолучитьСрез(2, 3);
П("срез 2 3", Дамп(Срез));
П("размер среза", Ч(Срез.Размер));
П("тип среза", Строка(ТипЗнч(Срез)));

Срез = Буфер.ПолучитьСрез(5);
П("срез до конца", Дамп(Срез));

// Ноль в количестве — «до конца», как и у `Инвертировать`.
Срез = Буфер.ПолучитьСрез(3, 0);
П("срез длины ноль", Дамп(Срез));

Срез = Буфер.ПолучитьСрез(0, 0);
П("срез 0 0", Дамп(Срез));

// Дробная ПОЗИЦИЯ усекается, дробная ДЛИНА отвергается.
Срез = Буфер.ПолучитьСрез(1.9, 2);
П("срез дробной позиции", Дамп(Срез));

Внешний = Буфер.ПолучитьСрез(2, 4);
Внутренний = Внешний.ПолучитьСрез(1, 2);
П("срез среза", Дамп(Внутренний));

// --- ПолучитьСрез: окно, а не копия -------------------------------------

Буфер = Восемь();
Срез = Буфер.ПолучитьСрез(2, 3);
Буфер[2] = 99;
П("срез после правки источника", Дамп(Срез));
Срез[0] = 77;
П("источник после правки среза", Дамп(Буфер));

// Порядок байтов наследуется, но дальше у каждого свой.
Буфер = Новый БуферДвоичныхДанных(4, ПорядокБайтов.BigEndian);
Срез = Буфер.ПолучитьСрез(0, 2);
П("порядок у среза", Строка(Срез.ПорядокБайтов));
Срез.ПорядокБайтов = ПорядокБайтов.LittleEndian;
П("порядок источника после правки среза", Строка(Буфер.ПорядокБайтов));

// Окно — полноценный буфер, и позиции в нём считаются от его начала.
Буфер = Восемь();
Срез = Буфер.ПолучитьСрез(2, 2);
Срез.ЗаписатьЦелое16(0, 258);
П("запись целого в срез", Дамп(Буфер));

// --- ПолучитьСрез: границы ----------------------------------------------

Р = "";
Попытка
	Х = Буфер.ПолучитьСрез(8);
	Р = "принято " + Дамп(Х);
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("срез с позиции размера", Р);

Р = "";
Попытка
	Х = Буфер.ПолучитьСрез(6, 4);
	Р = "принято " + Дамп(Х);
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("срез за концом", Р);

Р = "";
Попытка
	Х = Буфер.ПолучитьСрез(0, 2.5);
	Р = "принято " + Дамп(Х);
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("срез дробной длины", Р);

Р = "";
Попытка
	Х = Буфер.ПолучитьСрез(-1, 2);
	Р = "принято " + Дамп(Х);
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("срез отрицательной позиции", Р);

// --- Записать ------------------------------------------------------------

Приёмник = Новый БуферДвоичныхДанных(8);
Приёмник.Записать(2, Четыре());
П("записать с позиции 2", Дамп(Приёмник));

// Третий аргумент — СКОЛЬКО байтов брать, считая от начала источника.
Приёмник = Новый БуферДвоичныхДанных(8);
Приёмник.Записать(0, Восемь(), 5);
П("записать пять байтов", Дамп(Приёмник));

// Ноль здесь снова «весь источник», а не «ничего».
Приёмник = Новый БуферДвоичныхДанных(8);
Приёмник.Записать(0, Четыре(), 0);
П("записать количество ноль", Дамп(Приёмник));

// Дробная позиция усекается.
Приёмник = Новый БуферДвоичныхДанных(8);
Приёмник.Записать(1.9, Четыре());
П("записать в дробную позицию", Дамп(Приёмник));

// Источник — срез САМОГО приёмника: массив байтов один, копирование
// обязано это пережить.
Буфер = Восемь();
Голова = Буфер.ПолучитьСрез(0, 4);
Буфер.Записать(4, Голова);
П("записать в себя", Дамп(Буфер));

Приёмник = Новый БуферДвоичныхДанных(4);
Приёмник.Записать(2, Четыре());
П("записать не помещается", Дамп(Приёмник));

Р = "";
Попытка
	Приёмник = Новый БуферДвоичныхДанных(8);
	Приёмник.Записать(0, Четыре(), 100);
	Р = "принято " + Дамп(Приёмник);
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("записать больше источника", Р);

Р = "";
Попытка
	Приёмник = Новый БуферДвоичныхДанных(8);
	Приёмник.Записать(-1, Четыре());
	Р = "принято " + Дамп(Приёмник);
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("записать в отрицательную позицию", Р);

Р = "";
Попытка
	Приёмник = Новый БуферДвоичныхДанных(8);
	Приёмник.Записать(0, 5);
	Р = "принято " + Дамп(Приёмник);
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("записать число вместо буфера", Р);

Р = "";
Попытка
	Приёмник = Новый БуферДвоичныхДанных(8);
	Приёмник.Записать(0, Четыре(), 2, 1);
	Р = "принято " + Дамп(Приёмник);
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("записать четыре аргумента", Р);

// --- Скопировать ---------------------------------------------------------

Буфер = Восемь();
Копия = Буфер.Скопировать();
Буфер[0] = 99;
П("копия после правки источника", Дамп(Копия));

Буфер = Новый БуферДвоичныхДанных(4, ПорядокБайтов.BigEndian);
Копия = Буфер.Скопировать();
П("порядок у копии", Строка(Копия.ПорядокБайтов));

Буфер = Восемь();
Срез = Буфер.ПолучитьСрез(2, 3);
Копия = Срез.Скопировать();
Буфер[2] = 99;
П("копия среза", Дамп(Копия));

Р = "";
Попытка
	Х = Буфер.Скопировать(2);
	Р = "принято " + Дамп(Х);
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("копия с аргументом", Р);
