// «УникальныйИдентификатор»: конструкторы, печать, равенство, тип.
//
// Эталон снят с платформы 8.3.27:
//   ./tests/conformance/measure/1c/run-on-1c.sh tests/conformance/fixtures/uuid.bsl
//
// Случайная часть значений в вывод не попадает: у случайного
// идентификатора печатаются только структурные свойства (длина, дефисы,
// цифра версии, множество варианта), а всё воспроизводимое строится из
// фиксированной строки. Ошибки печатаются фактом, а не текстом.

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

Эталон = "ABCDEF12-3456-7890-ABCD-EF1234567890";

// --- разбор строки и печать -----------------------------------------------

Ид = Новый УникальныйИдентификатор(Эталон);
С = Строка(Ид);
П("круг из верхнего регистра", С);
П("строка равна НРег исходной", Строка(С = НРег(Эталон)));

// --- тип ------------------------------------------------------------------

П("тип значения", Строка(ТипЗнч(Ид)));
П("тип по русскому имени", Строка(Тип("УникальныйИдентификатор") = ТипЗнч(Ид)));
Попытка
	П("тип по имени UUID", Строка(Тип("UUID") = ТипЗнч(Ид)));
Исключение
	П("тип по имени UUID", "ошибка");
КонецПопытки;

// --- равенство ------------------------------------------------------------

П("два разбора одной строки равны", Строка(Новый УникальныйИдентификатор(Эталон) = Ид));
П("идентификатор равен себе", Строка(Ид = Ид));
П("идентификатор не равен своей строке", Строка(Ид = С));
П("разные строки не равны", Строка(Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000001") = Ид));

// --- заполненность --------------------------------------------------------

Нулевой = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
П("нулевой заполнен", Строка(ЗначениеЗаполнено(Нулевой)));
П("ненулевой заполнен", Строка(ЗначениеЗаполнено(Ид)));
П("строка нулевого", Строка(Нулевой));

// --- случайный конструктор ------------------------------------------------

Случайный = Новый УникальныйИдентификатор;
СС = Строка(Случайный);
П("длина случайного", Строка(СтрДлина(СС)));
П("дефисы на местах", Строка((Сред(СС, 9, 1) = "-") И (Сред(СС, 14, 1) = "-") И (Сред(СС, 19, 1) = "-") И (Сред(СС, 24, 1) = "-")));
П("цифра версии", Сред(СС, 15, 1));
П("вариант из 89ab", Строка(СтрНайти("89ab", Сред(СС, 20, 1)) > 0));
П("нижний регистр", Строка(СС = НРег(СС)));
П("два случайных различны", Строка(Новый УникальныйИдентификатор = Новый УникальныйИдентификатор));

// --- негодные формы конструктора ------------------------------------------

Попытка
	Ф1 = Новый УникальныйИдентификатор("{" + НРег(Эталон) + "}");
	П("фигурные скобки", "ок: " + Строка(Ф1));
Исключение
	П("фигурные скобки", "ошибка");
КонецПопытки;
Попытка
	Ф2 = Новый УникальныйИдентификатор(СтрЗаменить(Эталон, "-", ""));
	П("без дефисов", "ок: " + Строка(Ф2));
Исключение
	П("без дефисов", "ошибка");
КонецПопытки;
Попытка
	Ф3 = Новый УникальныйИдентификатор("ерунда");
	П("мусор", "ок: " + Строка(Ф3));
Исключение
	П("мусор", "ошибка");
КонецПопытки;
Попытка
	Ф4 = Новый УникальныйИдентификатор(Ид);
	П("конструктор от УИД", "ок: " + Строка(Ф4));
Исключение
	П("конструктор от УИД", "ошибка");
КонецПопытки;
