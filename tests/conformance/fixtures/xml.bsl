// Чтение и запись XML. Ожидаемый вывод снят с 8.3.27 — см.
// tests/conformance/measure/measure-xml.bsl.

Функция Разделитель(Накопленное)
	Если Накопленное = "" Тогда
		Возврат "";
	Иначе
		Возврат " | ";
	КонецЕсли;
КонецФункции

Функция Дамп(Текст)
	Ч = Новый ЧтениеXML;
	Ч.УстановитьСтроку(Текст);
	Р = "";
	Пока Ч.Прочитать() Цикл
		Р = Р + Разделитель(Р) + Строка(Ч.ТипУзла) + " [" + Ч.Имя + "]=[" + Ч.Значение + "]";
	КонецЦикла;
	Ч.Закрыть();
	Возврат Р;
КонецФункции

// --- Чтение -----------------------------------------------------------

Сообщить(Дамп("<к>текст</к>"));
Сообщить(Дамп("<а><б>1</б><в>2</в></а>"));
// Пустой элемент неотличим от пары тегов.
Сообщить(Дамп("<а/>"));
Сообщить(Дамп("<а></а>"));
// Объявление и комментарий узлами не отдаются, инструкция обработки — да.
Сообщить(Дамп("<?xml version=""1.0"" encoding=""UTF-8""?><а/>"));
Сообщить(Дамп("<а><!-- сюда --></а>"));
Сообщить(Дамп("<а><?целевой данные?></а>"));
// Комментарий текст разрывает, а секция CDATA — вливается в него.
Сообщить(Дамп("<а>раз<!--к-->два</а>"));
Сообщить(Дамп("<а>раз<![CDATA[два]]>три</а>"));
Сообщить(Дамп("<а><![CDATA[<не разметка>]]></а>"));
// Сущности и ссылки на символы.
Сообщить(Дамп("<а>&amp;&lt;&gt;&quot;&apos;</а>"));
Сообщить(Дамп("<а>&#65;&#x42;</а>"));
// Пробельный узел выбрасывается, пробел вокруг значащего текста — нет.
Сообщить(Дамп("<а>  <б/>  </а>"));
Сообщить(Дамп("<а> т </а>"));

// Имя, префикс и пространство имён.
Ч = Новый ЧтениеXML;
Ч.УстановитьСтроку("<п:а xmlns:п=""http://прим"">т</п:а>");
Ч.Прочитать();
Сообщить(Ч.Имя + "|" + Ч.ЛокальноеИмя + "|" + Ч.Префикс + "|" + Ч.URIПространстваИмен);

// Атрибуты: количество, доступ по индексу и по имени, обход курсором.
Ч = Новый ЧтениеXML;
Ч.УстановитьСтроку("<а х=""1"" у=""два"">т</а>");
Ч.Прочитать();
Сообщить(Строка(Ч.КоличествоАтрибутов()) + "|" + Ч.ИмяАтрибута(0) + "|" + Ч.ЗначениеАтрибута(0)
	+ "|" + Ч.ЗначениеАтрибута("у") + "|" + Строка(ТипЗнч(Ч.ЗначениеАтрибута("нету"))));

Ч = Новый ЧтениеXML;
Ч.УстановитьСтроку("<а х=""1"" у=""два""/>");
Ч.Прочитать();
Р = "";
Пока Ч.ПрочитатьАтрибут() Цикл
	Р = Р + Разделитель(Р) + Строка(Ч.ТипУзла) + " [" + Ч.Имя + "]=[" + Ч.Значение + "]";
КонецЦикла;
Сообщить(Р);

// Пропуск: на начале элемента — до его конца, на тексте — до конца родителя.
Ч = Новый ЧтениеXML;
Ч.УстановитьСтроку("<а><б><в>1</в></б><г/></а>");
Ч.Прочитать();
Ч.Прочитать();
Ч.Пропустить();
Сообщить(Строка(Ч.ТипУзла) + " [" + Ч.Имя + "]");

Ч = Новый ЧтениеXML;
Ч.УстановитьСтроку("<а>т<б/></а>");
Ч.Прочитать();
Ч.Прочитать();
Ч.Пропустить();
Сообщить(Строка(Ч.ТипУзла) + " [" + Ч.Имя + "]");

// До первого чтения узла нет, за концом документа чтение просто отвечает Нет.
Ч = Новый ЧтениеXML;
Ч.УстановитьСтроку("<а/>");
Сообщить(Строка(Ч.ТипУзла));
Ч.Прочитать();
Ч.Прочитать();
Сообщить(Строка(Ч.Прочитать()));

// Битая разметка — ошибка.
Попытка
	Сообщить(Дамп("<а><б></а>"));
Исключение
	Сообщить("битый: <ошибка>");
КонецПопытки;

Попытка
	Сообщить(Дамп(""));
Исключение
	Сообщить("пустой: <ошибка>");
КонецПопытки;

// --- Запись -----------------------------------------------------------

З = Новый ЗаписьXML;
З.УстановитьСтроку();
З.ЗаписатьНачалоЭлемента("а");
З.ЗаписатьНачалоЭлемента("б");
З.ЗаписатьТекст("т");
З.ЗаписатьКонецЭлемента();
З.ЗаписатьКонецЭлемента();
Сообщить(З.Закрыть());

// Объявление, атрибуты, схлопывание пустого элемента.
З = Новый ЗаписьXML;
З.УстановитьСтроку();
З.ЗаписатьОбъявлениеXML();
З.ЗаписатьНачалоЭлемента("а");
З.ЗаписатьАтрибут("х", "1");
З.ЗаписатьКонецЭлемента();
Сообщить(З.Закрыть());

// Экранирование: в тексте и в атрибуте наборы разные.
З = Новый ЗаписьXML;
З.УстановитьСтроку();
З.ЗаписатьНачалоЭлемента("а");
З.ЗаписатьАтрибут("х", "&<>""'");
З.ЗаписатьТекст("&<>""'");
З.ЗаписатьКонецЭлемента();
Сообщить(З.Закрыть());

// Смешанное содержимое: перед элементом отступ есть, перед текстом нет.
З = Новый ЗаписьXML;
З.УстановитьСтроку();
З.ЗаписатьНачалоЭлемента("а");
З.ЗаписатьТекст("т");
З.ЗаписатьНачалоЭлемента("б");
З.ЗаписатьКонецЭлемента();
З.ЗаписатьТекст("у");
З.ЗаписатьКонецЭлемента();
Сообщить(З.Закрыть());

// Комментарий, инструкция обработки, секция CDATA и запись без обработки.
З = Новый ЗаписьXML;
З.УстановитьСтроку();
З.ЗаписатьНачалоЭлемента("а");
З.ЗаписатьКомментарий("к");
З.ЗаписатьИнструкциюОбработки("целевой", "данные");
З.ЗаписатьСекциюCDATA("<не разметка>");
З.ЗаписатьКонецЭлемента();
Сообщить(З.Закрыть());

З = Новый ЗаписьXML;
З.УстановитьСтроку();
З.ЗаписатьНачалоЭлемента("а");
З.ЗаписатьБезОбработки("<сырое/>");
З.ЗаписатьКонецЭлемента();
Сообщить(З.Закрыть());

// Без отступа — весь документ в одну строку.
З = Новый ЗаписьXML;
З.УстановитьСтроку(Новый ПараметрыЗаписиXML("UTF-8", "1.0", Ложь));
З.ЗаписатьОбъявлениеXML();
З.ЗаписатьНачалоЭлемента("а");
З.ЗаписатьНачалоЭлемента("б");
З.ЗаписатьКонецЭлемента();
З.ЗаписатьКонецЭлемента();
Сообщить(З.Закрыть());

// Пустой текст элемент не раскрывает.
З = Новый ЗаписьXML;
З.УстановитьСтроку();
З.ЗаписатьНачалоЭлемента("а");
З.ЗаписатьТекст("");
З.ЗаписатьКонецЭлемента();
Сообщить(З.Закрыть());

// Нарушения структуры.
Попытка
	З = Новый ЗаписьXML;
	З.УстановитьСтроку();
	З.ЗаписатьКонецЭлемента();
	Сообщить(З.Закрыть());
Исключение
	Сообщить("лишний конец: <ошибка>");
КонецПопытки;

Попытка
	З = Новый ЗаписьXML;
	З.УстановитьСтроку();
	З.ЗаписатьНачалоЭлемента("а");
	З.ЗаписатьТекст("т");
	З.ЗаписатьАтрибут("х", "1");
	Сообщить(З.Закрыть());
Исключение
	Сообщить("атрибут после текста: <ошибка>");
КонецПопытки;

// Незакрытый элемент не дописывается, второй Закрыть отдаёт пустую строку.
З = Новый ЗаписьXML;
З.УстановитьСтроку();
З.ЗаписатьНачалоЭлемента("а");
Сообщить("[" + З.Закрыть() + "]");

З = Новый ЗаписьXML;
З.УстановитьСтроку();
З.ЗаписатьНачалоЭлемента("а");
З.ЗаписатьКонецЭлемента();
Первый = З.Закрыть();
Сообщить("[" + Первый + "][" + З.Закрыть() + "]");

// Круговой прогон.
З = Новый ЗаписьXML;
З.УстановитьСтроку();
З.ЗаписатьНачалоЭлемента("а");
З.ЗаписатьАтрибут("х", "1");
З.ЗаписатьТекст("т&т");
З.ЗаписатьКонецЭлемента();
Текст = З.Закрыть();
Сообщить(Текст);
Сообщить(Дамп(Текст));
