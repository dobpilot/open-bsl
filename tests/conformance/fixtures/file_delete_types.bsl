// Каждый случай ограничен отдельным временным каталогом.
Процедура ПробаТипаУдаления(ИдентификаторУдаления, МаскаУдаления)
	КореньУдаления = "";
	Попытка
		КореньУдаления = ПолучитьИмяВременногоФайла(".delete-types");
		СоздатьКаталог(КореньУдаления + "/data");
		ДанныеУдаления = ПолучитьДвоичныеДанныеИзСтроки("x", КодировкаТекста.UTF8, Ложь);
		ДанныеУдаления.Записать(КореньУдаления + "/data/keep.bin");
		ИмяМаскиУдаления = Строка(МаскаУдаления);
		Если ИмяМаскиУдаления <> "" Тогда
			ДанныеУдаления.Записать(КореньУдаления + "/data/" + ИмяМаскиУдаления);
		КонецЕсли;
		Попытка
			УдалитьФайлы(КореньУдаления + "/data", МаскаУдаления);
			ИтогУдаления = "ok";
		Исключение
			ИтогУдаления = "error";
		КонецПопытки;
		КаталогПроверкиУдаления = Новый Файл(КореньУдаления + "/data");
		СоседПроверкиУдаления = Новый Файл(КореньУдаления + "/data/keep.bin");
		ЦельПроверкиУдаления = Новый Файл(КореньУдаления + "/data/" + ИмяМаскиУдаления);
		Сообщить(ИдентификаторУдаления + Символ(9) + ИтогУдаления
			+ "|root=" + ?(КаталогПроверкиУдаления.Существует(), "1", "0")
			+ "|keep=" + ?(СоседПроверкиУдаления.Существует(), "1", "0")
			+ "|target=" + ?(ЦельПроверкиУдаления.Существует(), "1", "0"));
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдентификаторУдаления + ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньУдаления <> "" Тогда
		Попытка
			УдалитьФайлы(КореньУдаления);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдентификаторУдаления + ":" + ИнформацияОбОшибке().Описание);
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "delete-types-1");
ПробаТипаУдаления("delete.type.number", 17);
ПробаТипаУдаления("delete.type.zero", 0);
ПробаТипаУдаления("delete.type.true", Истина);
ПробаТипаУдаления("delete.type.false", Ложь);
ПробаТипаУдаления("delete.type.null", Null);
ПробаТипаУдаления("delete.type.undefined", Неопределено);
ПробаТипаУдаления("delete.type.empty", "");
ПробаТипаУдаления("delete.type.array", Новый Массив);
ПробаТипаУдаления("delete.type.structure", Новый Структура);
Сообщить("file.end" + Символ(9) + "delete-types-1");
