// Oracle: filesystem/file-constructor.platform.txt; локализуемые представления проверяются через Строка.
Функция ЭкранироватьПутьПробы(ТекстПутиПробы)
	Возврат СтрЗаменить(СтрЗаменить(СтрЗаменить(ТекстПутиПробы, Символ(0), "<NUL>"), Символ(10), "<LF>"), Символ(9), "<TAB>");
КонецФункции

Процедура ПробаКонструктораФайла(ИдКонструктора, ВыражениеКонструктора, АргументКонструктора)
	ЛокализуемаяПроба = ИдКонструктора = "ctor.boolean" Или ИдКонструктора = "ctor.date" Или ИдКонструктора = "ctor.array" Или ИдКонструктора = "ctor.structure";
	СтадияКонструктора = "construct";
	Попытка
		ФайлКонструктораПробы = Вычислить(ВыражениеКонструктора);
		СтадияКонструктора = "properties";
		ВыводКонструктора = "ok|full=" + ЭкранироватьПутьПробы(ФайлКонструктораПробы.ПолноеИмя) + "|parent=" + ЭкранироватьПутьПробы(ФайлКонструктораПробы.Путь) + "|name=" + ЭкранироватьПутьПробы(ФайлКонструктораПробы.Имя) + "|base=" + ЭкранироватьПутьПробы(ФайлКонструктораПробы.ИмяБезРасширения) + "|extension=" + ЭкранироватьПутьПробы(ФайлКонструктораПробы.Расширение);
		Если ЛокализуемаяПроба Тогда
			ВыводКонструктора = "ok|full_equals_string=" + ?(ФайлКонструктораПробы.ПолноеИмя = Строка(АргументКонструктора), "1", "0");
		КонецЕсли;
	Исключение
		ОшибкаКонструктора = ИнформацияОбОшибке();
		ВыводКонструктора = "error|stage=" + СтадияКонструктора + "|" + ОшибкаКонструктора.Описание;
		Если ОшибкаКонструктора.Причина <> Неопределено Тогда
			ВыводКонструктора = ВыводКонструктора + "|cause=" + ОшибкаКонструктора.Причина.Описание;
		КонецЕсли;
	КонецПопытки;
	Если Не ЛокализуемаяПроба Тогда
		ВыводКонструктора = ВыводКонструктора + "|input_string=" + ЭкранироватьПутьПробы(Строка(АргументКонструктора));
	КонецЕсли;
	Сообщить(ИдКонструктора + Символ(9) + ВыводКонструктора);
КонецПроцедуры

