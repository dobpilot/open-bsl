// Тернарный `?(Условие, Тогда, Иначе)` и приведение условия. Ожидаемый
// вывод снят с 8.3.27 — см. tests/conformance/measure/measure-ternary.bsl.

// --- Ленивость ---------------------------------------------------------
// Невыбранная ветвь заведомо падает. Уцелел результат — значит она не
// исполнялась. Делитель через Число("0"): литеральный ноль компилятор
// вправе свернуть.

Сообщить(?(Истина, "ок", 1 / Число("0")));
Сообщить(?(Ложь, 1 / Число("0"), "ок"));

Проверяемое = Неопределено;
Сообщить(?(Проверяемое <> Неопределено, "есть", "пусто"));

// --- Ветви и вложение --------------------------------------------------

Сообщить(?(Истина, "да", "нет"));
Сообщить(?(Ложь, "да", "нет"));
Сообщить(?(Истина, ?(Ложь, "а", "б"), "в"));
Сообщить(?(Ложь, "а", ?(Истина, "б", "в")));
Сообщить(?(?(Истина, Истина, Ложь), "да", "нет"));

// Тип результата — у выбранной ветви.
Сообщить(Строка(ТипЗнч(?(Истина, 5, "строка"))));
Сообщить(Строка(ТипЗнч(?(Ложь, 5, "строка"))));

// Результат работает дальше как обычное значение.
Сообщить("[" + ?(Истина, 1, 2) + "]");
Сообщить(СтрДлина(?(Истина, "абвг", "")));

// --- Приведение условия ------------------------------------------------
// Правило одно на весь язык: ?(), Если, Пока, И, ИЛИ, Не.

Сообщить(?(1, "да", "нет"));
Сообщить(?(0, "да", "нет"));
Сообщить(?(-1, "да", "нет"));
Сообщить(?(0.5, "да", "нет"));

// Строка — только словами, регистр не важен, пробелы обрезаются.
Сообщить(?("Истина", "да", "нет"));
Сообщить(?("истина", "да", "нет"));
Сообщить(?(" Ложь ", "да", "нет"));
Сообщить(?("Да", "да", "нет"));
Сообщить(?("True", "да", "нет"));
Сообщить(?("Нет", "да", "нет"));
Сообщить(?("False", "да", "нет"));

Если 1 Тогда
	Сообщить("Если 1 -> да");
Иначе
	Сообщить("Если 1 -> нет");
КонецЕсли;

Если "Истина" Тогда
	Сообщить("Если строкой -> да");
КонецЕсли;

Сообщить(Не 1);
Сообщить(Не "Ложь");

// И/ИЛИ отдают БУЛЕВО, а не последний вычисленный операнд.
Сообщить(1 И 1);
Сообщить(Истина И 1);
Сообщить(0 ИЛИ Истина);

// --- Что условием не является ------------------------------------------

Попытка
	Сообщить(?(Неопределено, "да", "нет"));
Исключение
	Сообщить("Неопределено -> <ошибка>");
КонецПопытки;

Попытка
	Сообщить(?("абв", "да", "нет"));
Исключение
	Сообщить("мусорная строка -> <ошибка>");
КонецПопытки;

Попытка
	Сообщить(?("", "да", "нет"));
Исключение
	Сообщить("пустая строка -> <ошибка>");
КонецПопытки;

Попытка
	Сообщить(?("1", "да", "нет"));
Исключение
	Сообщить("строка «1» -> <ошибка>");
КонецПопытки;

Попытка
	Сообщить(?(Новый Массив, "да", "нет"));
Исключение
	Сообщить("массив -> <ошибка>");
КонецПопытки;

Попытка
	Сообщить(?('20240115', "да", "нет"));
Исключение
	Сообщить("дата -> <ошибка>");
КонецПопытки;
