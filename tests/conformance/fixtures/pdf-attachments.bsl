// Вложения PDF: чтение того, что положила в файл САМА платформа, правка
// коллекции и круг «прочитать — изменить — записать — перечитать».
//
// ОТКУДА ВХОДНОЙ ФАЙЛ. Это `tests/conformance/pdf/attach-platform.pdf`,
// снятый с 8.3.27 скриптом `capture-platform-attachments.bsl`
// (происхождение записано в его шапке): страница табличного документа и
// три вложения, одно с кириллицей и в имени, и в содержимом. Здесь он
// лежит шестнадцатеричной строкой и материализуется во временный файл —
// как в `pdf-read.bsl` и по той же причине: конформанс-раннер запускает
// фикстуру из каталога крейта, а платформенный — из корня репозитория,
// и относительному пути в дереве не сойтись сразу с обоими. Байты те же:
// строка ниже получена из закоммиченного файла.
//
// Эталон `.expected` снят С ПЛАТФОРМЫ прогоном ЭТОЙ фикстуры:
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/fixtures/pdf-attachments.bsl
//
// Записанный круг уходит во временный файл: у платформы и у нас разные
// писатели (она пересобирает документ целиком, мы дописываем
// инкрементальное обновление), поэтому сверяются не байты, а то, что из
// файла читается обратно. Вторую половину круговой сверки — платформа
// читает файл, собранный НАШИМ писателем, — делает
// `measure-pdf-attachments.bsl`: там относительные пути работают, потому
// что обе стороны запускаются из корня репозитория.

Функция Байты(Данные)
	Возврат ПолучитьСтрокуИзДвоичныхДанных(Данные, "UTF-8");
КонецФункции

Функция Материализовать(Путь, Шестнадцатеричный)
	Буфер = Новый БуферДвоичныхДанных(СтрДлина(Шестнадцатеричный) / 2);
	Для Сч = 0 По Буфер.Размер - 1 Цикл
		Буфер[Сч] = ЧислоИзШестнадцатеричнойСтроки("0x" + Сред(Шестнадцатеричный, Сч * 2 + 1, 2));
	КонецЦикла;
	Поток = ФайловыеПотоки.Создать(Путь);
	Поток.Записать(Буфер, 0, Буфер.Размер);
	Поток.Закрыть();
	Возврат Путь;
КонецФункции

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

Процедура Обход(Метка, Коллекция)
	Для Каждого Вложение Из Коллекция Цикл
		Сообщить(Метка + ": [" + Вложение.ИмяФайла + "] [" + Вложение.ТипСодержимого
			+ "] [" + Строка(Вложение.ТипСвязи) + "] [" + Байты(Вложение.Содержимое) + "]");
	КонецЦикла;
