// Контракт чтения архивов ZIP из встроенного языка: `ЧтениеZipФайла` и
// `ЧтениеФайлаАрхива`, коллекция элементов, свойства элемента (включая
// пары `Исходное*`), поиск, распаковка обоими режимами восстановления
// путей и отказ на зашифрованной записи.
//
// Эталон снимается ТОЛЬКО платформой:
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/fixtures/zip-read.bsl
//   diff tests/conformance/fixtures/zip-read.expected \
//        tests/conformance/fixtures/zip-read.platform.txt
//
// ВХОДНЫЕ АРХИВЫ материализуются из шестнадцатеричных строк ниже в
// фиксированные пути во временном каталоге: обе стороны бегут на одной
// машине (образец — `binary-data.bsl`). Те же байты лежат в дереве рядом
// с этим файлом — `zip-read.zip` и `zip-read-enc.zip`, — чтобы их можно
// было открыть посторонним инструментом. Происхождение (python3 3.14,
// `zipfile`, даты всех записей выставлены в 1980-01-01, иначе байты
// зависели бы от времени сборки):
//
//   text = ("Товар;Цена\n"
//           + "".join(f"Гвоздь-{i%3};{i*7}\n" for i in range(12))).encode()
//   noise = bytes(((i * 97 + 13) & 0xFF) for i in range(24))
//   def info(name, method):
//       zi = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
//       zi.compress_type = method
//       return zi
//   with zipfile.ZipFile("zip-read.zip", "w") as zf:
//       zf.writestr(info("накладная.txt", zipfile.ZIP_DEFLATED), text)
//       zf.writestr(info("шум.bin", zipfile.ZIP_STORED), noise)
//       zf.writestr(info("папка/", zipfile.ZIP_STORED), b"")
//       zf.writestr(info("папка/вложенный.txt", zipfile.ZIP_STORED), "внутри".encode())
//       zf.writestr(info("отчёт:2026.txt", zipfile.ZIP_STORED), "двоеточие".encode())
//       zf.writestr(info("дубль.txt", zipfile.ZIP_STORED), "первый".encode())
//       zf.writestr(info("дубль.txt", zipfile.ZIP_STORED), "второй".encode())
//
// У второго архива одна запись `секрет.txt`, собранная тем же способом, и
// в ней РУКАМИ выставлен бит 0 общих флагов (шифрование) — и в локальном
// заголовке, и в каталоге. Расшифровки нет ни у одной стороны: платформа
// отвечает «Некорректный пароль», эта реализация — «запись зашифрована»,
// поэтому все пробы по нему печатают только `<ошибка>`.
//
// Три правила письма, каждое стоит впустую потраченного прогона: метод
// нельзя звать на результате вызова (нужна промежуточная переменная),
// всякая проба, способная бросить, обязана быть в `Попытка` (иначе
// платформа показывает модальное окно и прогон висит до таймаута), а
// текст чужой ошибки печатать нельзя — он у сторон разный.

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Р = СтрЗаменить(Р, Символ(10), "<ПС>");
	Возврат Р;
КонецФункции

// Байты из шестнадцатеричной строки в файл: другого способа положить
// заранее известные байты на диск у обеих сторон нет.
Функция Материализовать(Путь, Шестнадцатеричный)
	Буфер = Новый БуферДвоичныхДанных(СтрДлина(Шестнадцатеричный) / 2);
	Для Сч = 0 По Буфер.Размер - 1 Цикл
		Буфер[Сч] = ЧислоИзШестнадцатеричнойСтроки("0x" + Сред(Шестнадцатеричный, Сч * 2 + 1, 2));
	КонецЦикла;
	Поток = ФайловыеПотоки.Создать(Путь);
	Поток.Записать(Буфер, 0, Буфер.Размер);
	Поток.Закрыть();
	Возврат Путь;
КонецФункции

// Содержимое распакованного файла — текстом, с видимыми переводами строк.
Функция Прочитать(Путь)
	Попытка
		ДД = Новый ДвоичныеДанные(Путь);
		Возврат Видимо(ПолучитьСтрокуИзДвоичныхДанных(ДД));
	Исключение
		Возврат "<нет файла>";
	КонецПопытки;
КонецФункции

// Что нашёл `Найти` — именем, а не типом: у платформы разрешение дублей и
// подстановка недопустимых знаков меняют `Имя`, и важно, КАКАЯ запись
// отозвалась.
Функция Найденное(Коллекция, Имя)
	Найдено = Коллекция.Найти(Имя);
	Если Найдено = Неопределено Тогда
		Возврат "<нет>";
	КонецЕсли;
	Возврат Найдено.ПолноеИмя + " (исх " + Найдено.ИсходноеПолноеИмя + ")";
КонецФункции

Функция Размер(Путь)
	Попытка
		ДД = Новый ДвоичныеДанные(Путь);
		Возврат Ч(ДД.Размер());
	Исключение
		Возврат "<нет файла>";
	КонецПопытки;
КонецФункции

// Все свойства одного элемента одной строкой.
Функция Опиши(Элемент)
	Р = "полное=" + Элемент.ПолноеИмя;
	Р = Р + " имя=" + Элемент.Имя;
	Р = Р + " путь=" + Элемент.Путь;
	Р = Р + " база=" + Элемент.ИмяБезРасширения;
	Р = Р + " расш=" + Элемент.Расширение;
	Р = Р + " исх=" + Элемент.ИсходноеПолноеИмя;
	Р = Р + " исхИмя=" + Элемент.ИсходноеИмя;
	Р = Р + " исхПуть=" + Элемент.ИсходныйПуть;
	Р = Р + " исхБаза=" + Элемент.ИсходноеИмяБезРасширения;
	Р = Р + " исхРасш=" + Элемент.ИсходноеРасширение;
	Р = Р + " разм=" + Ч(Элемент.РазмерНесжатого);
	Р = Р + " сжат=" + Ч(Элемент.РазмерСжатого);
	Р = Р + " шифр=" + Строка(Элемент.Зашифрован);
	Р = Р + " дата=" + Формат(Элемент.ВремяИзменения, "ДФ='гггг-ММ-дд ЧЧ:мм:сс'");
	Возврат Р;
КонецФункции

