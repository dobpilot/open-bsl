// `Перем` на уровне модуля: область модуля, запись из процедур, затенение.
//
// .expected снят прогоном на реальной 1С 8.3.27 (см.
// tests/conformance/measure/1c/run-on-1c.sh), а НЕ выводом этого
// интерпретатора.

Перем Счётчик;
Перем Имя;

// --- Процедура видит переменную модуля и пишет в неё -------------------
Процедура Увеличить()
	Счётчик = Счётчик + 1;
КонецПроцедуры

Функция Прочитать()
	Возврат Счётчик;
КонецФункции

Счётчик = 10;
Увеличить();
Увеличить();
Сообщить(Строка(Счётчик));                  // видно снаружи
Сообщить(Строка(Прочитать()));              // и изнутри — та же ячейка

// --- Запись видна между вызовами разных процедур -----------------------
Процедура Обнулить()
	Счётчик = 0;
КонецПроцедуры
Обнулить();
Увеличить();
Сообщить(Строка(Прочитать()));

// --- Явная локальная `Перем` затеняет модульную ------------------------
Функция СвояЛокальная()
	Перем Счётчик;
	Счётчик = 777;
	Возврат Счётчик;
КонецФункции
Имя = "до";
Сообщить(Строка(СвояЛокальная()));
Сообщить(Строка(Счётчик));                  // модульная цела

// --- Параметр с именем модульной затеняет её ---------------------------
Функция ЧерезПараметр(Счётчик)
	Счётчик = Счётчик * 2;
	Возврат Счётчик;
КонецФункции
Сообщить(Строка(ЧерезПараметр(4)));
Сообщить(Строка(Счётчик));                  // модульная не тронута

// --- Неявное присваивание внутри процедуры: модульная или новая local? --
Процедура ПрисвоитьИмя()
	Имя = "изменено";
КонецПроцедуры
ПрисвоитьИмя();
Сообщить(Имя);

// --- Модульная переменная в цикле и в вызове из вызова -----------------
Процедура УвеличитьНесколькоРаз(Сколько)
	Для Ном = 1 По Сколько Цикл
		Увеличить();
	КонецЦикла;
КонецПроцедуры
Счётчик = 0;
УвеличитьНесколькоРаз(5);
Сообщить(Строка(Счётчик));

// --- Необъявленная модульная переменная до присваивания ----------------
Перем Пустая;
Сообщить(Строка(ТипЗнч(Пустая)));

// --- Область модуля видна фрагменту `Выполнить`/`Вычислить` ------------
// Здесь фрагмент запускается ВНУТРИ функции: у него свой стек, и модульные
// значения попадают туда отдельным блоком (Program::module_base).
Процедура ПишетФрагментом()
	Выполнить("Имя = Имя + "" +фрагмент""");
КонецПроцедуры

Функция ЧитаетФрагментом()
	Возврат Вычислить("Имя");
КонецФункции

Функция ФрагментВидитЛокальную()
	Перем Имя;
	Имя = "локальная";
	Выполнить("Имя = Имя + ""!""");
	Возврат Имя;
КонецФункции

Имя = "начало";
ПишетФрагментом();
Сообщить(Имя);
Сообщить(ЧитаетФрагментом());
Сообщить(ФрагментВидитЛокальную());
Сообщить(Имя);                              // локальная фрагмента не задела модульную
