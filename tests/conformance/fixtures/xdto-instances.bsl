// Экземпляры XDTO: хранилище свойств `ОбъектXDTO`, `СписокXDTO`
// множественного свойства, `ПоследовательностьXDTO` и `ЗначениеXDTO`.
//
// Эталон снят с платформы 8.3.27:
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/fixtures/xdto-instances.bsl
//
// Обвязка та же, что у `xdto-factory`: схема пишется во временный файл и
// фабрика строится по нему. Печатается только то, что у платформы и у этой
// реализации совпадает дословно, ошибочные случаи — ФАКТОМ («ошибка»), а
// не текстом исключения.
//
// ЧЕГО ЗДЕСЬ НЕТ И ПОЧЕМУ. Значения, нарушающие ФАСЕТ (образец, длину,
// перечисление, число разрядов дробной части), платформа при записи
// отвергает, а эта реализация пропускает — фасеты она пока только хранит,
// см. шапку `bsl-rt/src/xdto.rs`. Поэтому в схеме фикстуры фасетов нет
// вовсе, а `Целое = 1.5` не пробуется. По той же причине нет свойства
// СПИСОЧНОГО типа: платформа отдаёт `ФиксированныйМассив`, здесь —
// `Массив`.

Перем Фаб;
Перем Об;

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

Функция ИсточникСхемы()
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>"
		+ "<xs:schema xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:t=""urn:test"""
		+ " targetNamespace=""urn:test"" elementFormDefault=""qualified"">"
		+ "<xs:complexType name=""Inner""><xs:sequence>"
		+ "<xs:element name=""значение"" type=""xs:string""/>"
		+ "</xs:sequence></xs:complexType>"
		+ "<xs:complexType name=""RootType""><xs:sequence>"
		+ "<xs:element name=""name"" type=""xs:string""/>"
		+ "<xs:element name=""num"" type=""xs:int"" minOccurs=""0""/>"
		+ "<xs:element name=""when"" type=""xs:date"" minOccurs=""0""/>"
		+ "<xs:element name=""def"" type=""xs:int"" default=""7"" minOccurs=""0""/>"
		+ "<xs:element name=""tags"" type=""xs:string"" minOccurs=""0"" maxOccurs=""unbounded""/>"
		+ "<xs:element name=""nested"" type=""t:Inner""/>"
		+ "</xs:sequence>"
		+ "<xs:attribute name=""id"" type=""xs:int"" use=""required""/>"
		+ "</xs:complexType>"
		+ "<xs:complexType name=""ChoiceType""><xs:choice minOccurs=""0"">"
		+ "<xs:element name=""ca"" type=""xs:string""/>"
		+ "<xs:element name=""cb"" type=""xs:string"" maxOccurs=""3""/>"
		+ "</xs:choice><xs:attribute name=""cat"" type=""xs:string""/></xs:complexType>"
		+ "</xs:schema>";
КонецФункции

НС = "http://www.w3.org/2001/XMLSchema";
Путь = "/tmp/open-bsl-xdto-instances.xsd";
Зп = Новый ЗаписьТекста(Путь);
Зп.Записать(ИсточникСхемы());
Зп.Закрыть();

Фаб = СоздатьФабрикуXDTO(Путь);
ТипКорня = Фаб.Тип("urn:test", "RootType");
Об = Фаб.Создать(ТипКорня);

// --- свежий экземпляр -----------------------------------------------------

П("объект", Строка(Об));
П("объект это", Строка(ТипЗнч(Об)));
П("незаполненное свойство", "[" + Строка(Об.name) + "]");
П("незаполненное это", Строка(ТипЗнч(Об.name)));
// `default="7"` подставляется уже при чтении, но заполненным свойство от
// этого не становится.
П("свойство с умолчанием", Строка(Об.def));
П("умолчание это", Строка(ТипЗнч(Об.def)));
П("умолчание установлено", Строка(Об.Установлено("def")));
П("иным регистром", "[" + Строка(Об.NAME) + "]");
П("множественное это", Строка(ТипЗнч(Об.tags)));
П("множественное пусто", Строка(Об.tags.Количество()));
П("вложенное незаполнено", "[" + Строка(Об.nested) + "]");

// --- запись и обратное чтение ---------------------------------------------

Об.name = "аб";
П("запись строки", Об.name);
Об.name = 5;
П("число в строку", Об.name + " " + Строка(ТипЗнч(Об.name)));
Об.name = Истина;
П("булево в строку", Об.name);
Об.NAME = "вг";
П("запись иным регистром", Об.name);
Об.num = "42";
П("строка в число", Строка(Об.num) + " " + Строка(ТипЗнч(Об.num)));
Об.num = 43;
П("число в число", Строка(Об.num));
Об.when = Дата(2026, 8, 13);
П("дата в дату", Строка(Об.when) + " " + Строка(ТипЗнч(Об.when)));
Об.when = "2026-08-14";
П("строка в дату", Строка(Об.when));
Об.def = 1;
П("поверх умолчания", Строка(Об.def) + " установлено=" + Строка(Об.Установлено("def")));
Об.id = 10;
П("атрибут", Строка(Об.id));
// Значение XDTO пишется своим ЗНАЧЕНИЕМ, даже когда его тип другой.
Об.num = Фаб.Создать(Фаб.Тип(НС, "string"), "44");
П("значение XDTO в число", Строка(Об.num) + " " + Строка(ТипЗнч(Об.num)));

Попытка
	Об.name = Неопределено;
	П("Неопределено в свойство", "ок");
Исключение
	П("Неопределено в свойство", "ошибка");
КонецПопытки;

Попытка
	Об.num = Истина;
	П("булево в число", "ок");
Исключение
	П("булево в число", "ошибка");
КонецПопытки;

Попытка
	Об.tags = "аб";
	П("присваивание в множественное", "ок");
Исключение
	П("присваивание в множественное", "ошибка");
КонецПопытки;

Попытка
	Об.нетТакогоСвойства = 1;
	П("запись постороннего имени", "ок");
Исключение
	П("запись постороннего имени", "ошибка");
КонецПопытки;

Попытка
	Х = Об.нетТакогоСвойства;
	П("чтение постороннего имени", "ок");
Исключение
	П("чтение постороннего имени", "ошибка");
КонецПопытки;

// --- множественное свойство -----------------------------------------------

Спс = Об.tags;
Спс.Добавить("один");
// Список — окно в объект, а не снимок: добавление видно через свойство.
П("список через переменную", Строка(Об.tags.Количество()));
П("два чтения равны", Строка(Об.tags = Об.tags));
П("владелец списка", Строка(Спс.Владелец = Об));
Об.tags.Добавить("два");
Об.tags.Добавить(3);
П("список", Строка(Об.tags));
П("количество", Строка(Об.tags.Количество()));
П("по индексу", Об.tags[0] + " " + Строка(ТипЗнч(Об.tags[0])));
П("Получить", Об.tags.Получить(2) + " " + Строка(ТипЗнч(Об.tags.Получить(2))));

Соб = "";
Для Каждого Тег Из Об.tags Цикл
	Соб = Соб + "[" + Тег + "]";
КонецЦикла;
П("обход", Соб);

Об.tags.Установить(0, "первый");
П("Установить", Об.tags[0]);
Об.tags.Вставить(0, "нулевой");
П("Вставить", Об.tags[0] + " всего=" + Строка(Об.tags.Количество()));
Об.tags.Удалить(0);
П("Удалить", Об.tags[0] + " всего=" + Строка(Об.tags.Количество()));
П("множественное установлено", Строка(Об.Установлено("tags")));

Попытка
	Х = Об.tags[9];
	П("индекс за границей", "ок");
Исключение
	П("индекс за границей", "ошибка");
КонецПопытки;

Попытка
	Об.tags.Добавить(Неопределено);
	П("Добавить Неопределено", "ок");
Исключение
	П("Добавить Неопределено", "ошибка");
КонецПопытки;

// --- члены экземпляра -----------------------------------------------------

П("Получить именем", Строка(Об.Получить("name")));
Об.Установить("name", "де");
П("Установить именем", Об.name);
Свв = ТипКорня.Свойства.Получить("name");
П("Получить свойством", Строка(Об.Получить(Свв)));
П("Установлено до сброса", Строка(Об.Установлено(Свв)));
Об.Сбросить(Свв);
П("после сброса", "[" + Строка(Об.name) + "] установлено=" + Строка(Об.Установлено("name")));
Об.Сбросить("def");
П("сброс умолчания", Строка(Об.def) + " установлено=" + Строка(Об.Установлено("def")));
П("Свойства методом", Строка(Об.Свойства().Количество()));
П("Свойства как у типа", Строка(Об.Свойства().Количество() = ТипКорня.Свойства.Количество()));
П("владелец отдельного", "[" + Строка(Об.Владелец()) + "]");
// `ПолучитьСписок` отдаёт тот же список, что и чтение свойства.
Об.ПолучитьСписок("tags").Добавить("через метод");
П("ПолучитьСписок общий", Строка(Об.tags.Количество()));

Попытка
	Х = Об.Получить("tags");
	П("Получить множественного", "ок");
Исключение
	П("Получить множественного", "ошибка");
КонецПопытки;

Попытка
	Х = Об.ПолучитьСписок("name");
	П("ПолучитьСписок одиночного", "ок");
Исключение
	П("ПолучитьСписок одиночного", "ошибка");
КонецПопытки;

Попытка
	Х = Об.Установлено("нетТакого");
	П("Установлено постороннего", "ок");
Исключение
	П("Установлено постороннего", "ошибка");
КонецПопытки;

// --- вложенный объект и проверка ------------------------------------------

Вл = Фаб.Создать(ТипКорня.Свойства.Получить("nested").Тип);
Об.nested = Вл;
П("вложенное это", Строка(ТипЗнч(Об.nested)));
П("вложенное тождество", Строка(Об.nested = Вл));
П("владелец вложенного", Строка(Вл.Владелец() = Об));
Об.nested.значение = "внутри";
П("запись во вложенное", Вл.значение);

Попытка
	Об.nested = Фаб.Создать(Фаб.Тип("urn:test", "ChoiceType"));
	П("посторонний тип в свойство", "ок");
Исключение
	П("посторонний тип в свойство", "ошибка");
КонецПопытки;

Пустой = Фаб.Создать(ТипКорня);
Попытка
	Пустой.Проверить();
	П("проверка пустого", "ок");
Исключение
	П("проверка пустого", "ошибка");
КонецПопытки;

Об.name = "полное";
Об.id = 11;
Попытка
	Об.Проверить();
	П("проверка заполненного", "ок");
Исключение
	П("проверка заполненного", "ошибка");
КонецПопытки;

Об.nested.значение = "";
Вл2 = Фаб.Создать(ТипКорня.Свойства.Получить("nested").Тип);
Об.nested = Вл2;
Попытка
	Об.Проверить();
	П("проверка с пустым вложенным", "ок");
Исключение
	П("проверка с пустым вложенным", "ошибка");
КонецПопытки;

// --- последовательность ---------------------------------------------------

П("последовательность упорядоченного", "[" + Строка(Об.Последовательность()) + "]");
Выб = Фаб.Создать(Фаб.Тип("urn:test", "ChoiceType"));
Посл = Выб.Последовательность();
П("последовательность", Строка(Посл));
П("последовательность это", Строка(ТипЗнч(Посл)));
П("пустая последовательность", Строка(Посл.Количество()));
Выб.cb.Добавить("аб");
Выб.ca = "вг";
Выб.cat = "атрибут";
Выб.cb.Добавить("де");
П("после заполнения", Строка(Посл.Количество()));

Соб = "";
Для К = 0 По Посл.Количество() - 1 Цикл
	Соб = Соб + "[" + Строка(Посл.ПолучитьСвойство(К)) + "=" + Строка(Посл.ПолучитьЗначение(К)) + "]";
КонецЦикла;
П("порядок", Соб);

Выб.ca = "же";
П("повторная запись", Строка(Посл.Количество()) + " " + Строка(Посл.ПолучитьЗначение(1)));
П("владелец последовательности", Строка(Посл.Владелец = Выб));
П("две последовательности равны", Строка(Выб.Последовательность() = Посл));
Посл.Добавить(Выб.Тип().Свойства.Получить("ca"), "зи");
П("Добавить свойством", Строка(Посл.Количество()) + " ca=" + Выб.ca);
Посл.Очистить();
П("после очистки", Строка(Посл.Количество()) + " ca=[" + Строка(Выб.ca) + "] cat=" + Выб.cat);

Попытка
	Посл.Добавить(Выб.Тип().Свойства.Получить("cat"), "к");
	П("Добавить атрибут", "ок");
Исключение
	П("Добавить атрибут", "ошибка");
КонецПопытки;

// --- ЗначениеXDTO ---------------------------------------------------------

Знч = Фаб.Создать(Фаб.Тип(НС, "int"), "42");
П("значение", Строка(Знч.Значение) + " " + Строка(ТипЗнч(Знч.Значение)));
П("лексическое значение", Знч.ЛексическоеЗначение);
П("тип значения", Строка(Знч.Тип()));

Попытка
	Знч.Значение = 5;
	П("запись в значение", "ок");
Исключение
	П("запись в значение", "ошибка");
КонецПопытки;

Попытка
	Знч.ЛексическоеЗначение = "5";
	П("запись в лексическое", "ок");
Исключение
	П("запись в лексическое", "ошибка");
КонецПопытки;
