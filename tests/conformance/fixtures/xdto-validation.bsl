// Проверка значений XDTO по фасетам: перечисление, длины, границы и
// разряды — на создании значения, на записи свойства, на наполнении списка
// и на чтении документа.
//
// Эталон снят с платформы 8.3.27:
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/fixtures/xdto-validation.bsl
//
// Каждый вид фасета — СВОЙ тип: по отказу должно быть видно, какой именно
// фасет сработал, а у типа с двумя фасетами сразу этого не видно.
//
// ФАСЕТА `pattern` ЗДЕСЬ НЕТ НАМЕРЕННО. Движка регулярных выражений в
// дереве нет, и проверка по образцу отвечает честной ошибкой «не
// поддерживается» — то есть отвергает и то, что платформа принимает. Это
// сознательное расхождение (см. шапку `crates/bsl-rt/src/xdto.rs` и
// `tests/conformance/measure/measure-xdto-validation.bsl`), и в построчную
// фикстуру ему нельзя. По той же причине нет и `xs:Name`/`xs:NCName`:
// их образцы платформа проверяет, а здесь они пропускаются.
//
// Печатается ФАКТ «принято/отвергнуто», а не текст исключения: тексты
// ошибок у платформы свои. Арность нигде не нарушается: неверное число
// аргументов — ошибка компиляции, она снесла бы всю фикстуру.

Перем Фаб;

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

Функция ИсточникСхемы()
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>"
		+ "<xs:schema xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:t=""urn:v"""
		+ " targetNamespace=""urn:v"" elementFormDefault=""qualified"""
		+ " attributeFormDefault=""unqualified"">"
		+ "<xs:simpleType name=""Col""><xs:restriction base=""xs:string"">"
		+ "<xs:enumeration value=""red""/><xs:enumeration value=""green""/>"
		+ "</xs:restriction></xs:simpleType>"
		+ "<xs:simpleType name=""Len""><xs:restriction base=""xs:string"">"
		+ "<xs:minLength value=""2""/><xs:maxLength value=""5""/>"
		+ "</xs:restriction></xs:simpleType>"
		+ "<xs:simpleType name=""Len2""><xs:restriction base=""t:Len"">"
		+ "<xs:maxLength value=""3""/></xs:restriction></xs:simpleType>"
		+ "<xs:simpleType name=""Fix""><xs:restriction base=""xs:string"">"
		+ "<xs:length value=""3""/></xs:restriction></xs:simpleType>"
		+ "<xs:simpleType name=""Rng""><xs:restriction base=""xs:decimal"">"
		+ "<xs:minInclusive value=""0""/><xs:maxExclusive value=""100""/>"
		+ "</xs:restriction></xs:simpleType>"
		+ "<xs:simpleType name=""Dig""><xs:restriction base=""xs:decimal"">"
		+ "<xs:totalDigits value=""4""/><xs:fractionDigits value=""2""/>"
		+ "</xs:restriction></xs:simpleType>"
		+ "<xs:simpleType name=""Lst""><xs:list itemType=""t:Len""/></xs:simpleType>"
		+ "<xs:complexType name=""T""><xs:sequence>"
		+ "<xs:element name=""el"" type=""t:Len"" minOccurs=""0""/>"
		+ "<xs:element name=""ml"" type=""t:Len"" minOccurs=""0"" maxOccurs=""unbounded""/>"
		+ "<xs:element name=""rg"" type=""t:Rng"" minOccurs=""0""/>"
		+ "<xs:element name=""ip"" type=""xs:int"" minOccurs=""0""/>"
		+ "<xs:element name=""ls"" type=""t:Lst"" minOccurs=""0""/>"
		+ "</xs:sequence>"
		+ "<xs:attribute name=""ac"" type=""t:Col""/>"
		+ "</xs:complexType>"
		+ "</xs:schema>";
КонецФункции

// Создание значения своего типа: принято или отвергнуто.
Функция Соз(Имя, Лексика)
	Попытка
		Знч = Фаб.Создать(Фаб.Тип("urn:v", Имя), Лексика);
	Исключение
		Возврат "отвергнуто";
	КонецПопытки;
	Возврат "принято";
КонецФункции

// То же от встроенного типа XML Schema — там фасеты наследуются по
// цепочке `int` -> `long` -> `integer` -> `decimal`.
Функция СозВст(Имя, Лексика)
	Попытка
		Знч = Фаб.Создать(Фаб.Тип("http://www.w3.org/2001/XMLSchema", Имя), Лексика);
	Исключение
		Возврат "отвергнуто";
	КонецПопытки;
	Возврат "принято";
КонецФункции

Путь = "/tmp/open-bsl-xdto-validation.xsd";
Зп = Новый ЗаписьТекста(Путь);
Зп.Записать(ИсточникСхемы());
Зп.Закрыть();
Фаб = СоздатьФабрикуXDTO(Путь);
ТипТ = Фаб.Тип("urn:v", "T");

// --- перечисление ---------------------------------------------------------

П("перечисление red", Соз("Col", "red"));
П("перечисление green", Соз("Col", "green"));
П("перечисление чужое", Соз("Col", "синий"));
П("перечисление регистр", Соз("Col", "RED"));
П("перечисление пустое", Соз("Col", ""));

// --- длины ----------------------------------------------------------------

П("длина по нижней", Соз("Len", "аб"));
П("длина внутри", Соз("Len", "абв"));
П("длина по верхней", Соз("Len", "абвгд"));
П("длина короче", Соз("Len", "а"));
П("длина длиннее", Соз("Len", "абвгде"));
П("длина пустая", Соз("Len", ""));
П("длина ровно", Соз("Fix", "абв"));
П("длина ровно короче", Соз("Fix", "аб"));
П("длина ровно длиннее", Соз("Fix", "абвг"));
П("длина наследованная нижняя", Соз("Len2", "а"));
П("длина своя верхняя", Соз("Len2", "абвг"));
П("длина между ними", Соз("Len2", "абв"));

// --- границы --------------------------------------------------------------

П("граница включающая по себе", Соз("Rng", "0"));
П("граница внутри", Соз("Rng", "99.5"));
П("граница ниже", Соз("Rng", "-1"));
П("граница исключающая по себе", Соз("Rng", "100"));

// --- разряды --------------------------------------------------------------

П("разряды внутри", Соз("Dig", "12.34"));
П("разряды целым", Соз("Dig", "1234"));
П("разряды хвостовой ноль", Соз("Dig", "1.200"));
П("разряды всего больше", Соз("Dig", "12345"));
П("разряды дробных больше", Соз("Dig", "1.234"));

// --- наследование у встроенных типов ---------------------------------------

П("встроенный в диапазоне", СозВст("int", "42"));
П("встроенный выше диапазона", СозВст("int", "3000000000"));
П("встроенный ниже диапазона", СозВст("int", "-3000000000"));
П("встроенный байт выше", СозВст("byte", "200"));
П("встроенный без знака ниже", СозВст("unsignedByte", "-1"));
П("встроенный положительный ноль", СозВст("positiveInteger", "0"));
П("встроенный целое дробью", СозВст("integer", "1.5"));
П("встроенный десятичное дробью", СозВст("decimal", "1.5"));

// --- список ---------------------------------------------------------------

П("список элементов годных", Соз("Lst", "аб вг"));
П("список с негодным элементом", Соз("Lst", "аб в"));

// --- запись свойства ------------------------------------------------------

Об = Фаб.Создать(ТипТ);
Попытка
	Об.ac = "red";
	П("запись атрибута годного", "принято");
Исключение
	П("запись атрибута годного", "отвергнуто");
КонецПопытки;

Попытка
	Об.ac = "синий";
	П("запись атрибута чужого", "принято");
Исключение
	П("запись атрибута чужого", "отвергнуто");
КонецПопытки;

Попытка
	Об.el = "аб";
	П("запись элемента годного", "принято");
Исключение
	П("запись элемента годного", "отвергнуто");
КонецПопытки;

Попытка
	Об.el = "а";
	П("запись элемента короткого", "принято");
Исключение
	П("запись элемента короткого", "отвергнуто");
КонецПопытки;

// Значение приводится к лексической форме ДО проверки: число 42 даёт
// строку из двух символов, а число 5 — из одного, и она уже коротка.
Попытка
	Об.el = 42;
	П("запись числом длинным", "принято");
Исключение
	П("запись числом длинным", "отвергнуто");
КонецПопытки;

Попытка
	Об.el = 5;
	П("запись числом коротким", "принято");
Исключение
	П("запись числом коротким", "отвергнуто");
КонецПопытки;

Попытка
	Об.rg = 500;
	П("запись вне границ", "принято");
Исключение
	П("запись вне границ", "отвергнуто");
КонецПопытки;

Попытка
	Об.ip = 1.5;
	П("запись дроби в целое", "принято");
Исключение
	П("запись дроби в целое", "отвергнуто");
КонецПопытки;

Попытка
	Об.Установить("ac", "синий");
	П("Установить чужое", "принято");
Исключение
	П("Установить чужое", "отвергнуто");
КонецПопытки;

П("после отказов атрибут", Строка(Об.ac));
П("после отказов элемент", Строка(Об.el));

// --- список свойства ------------------------------------------------------

Попытка
	Об.ml.Добавить("аб");
	П("Добавить годное", "принято");
Исключение
	П("Добавить годное", "отвергнуто");
КонецПопытки;

Попытка
	Об.ml.Добавить("а");
	П("Добавить короткое", "принято");
Исключение
	П("Добавить короткое", "отвергнуто");
КонецПопытки;

Попытка
	Об.ml.Установить(0, "в");
	П("Установить короткое", "принято");
Исключение
	П("Установить короткое", "отвергнуто");
КонецПопытки;

Попытка
	Об.ml.Вставить(0, "г");
	П("Вставить короткое", "принято");
Исключение
	П("Вставить короткое", "отвергнуто");
КонецПопытки;

П("в списке осталось", Строка(Об.ml.Количество()));
П("в списке первое", Строка(Об.ml[0]));

// --- чтение документа -----------------------------------------------------

Функция Прочитать(Текст)
	Чт = Новый ЧтениеXML;
	Чт.УстановитьСтроку(Текст);
	Попытка
		Р = Фаб.ПрочитатьXML(Чт, Фаб.Тип("urn:v", "T"));
	Исключение
		Возврат "отвергнуто";
	КонецПопытки;
	Возврат "принято";
КонецФункции

П("чтение валидного", Прочитать("<т xmlns=""urn:v"" ac=""red""><el>аб</el></т>"));
П("чтение чужого перечисления", Прочитать("<т xmlns=""urn:v"" ac=""синий""/>"));
П("чтение короткой длины", Прочитать("<т xmlns=""urn:v""><el>а</el></т>"));
П("чтение вне границ", Прочитать("<т xmlns=""urn:v""><rg>500</rg></т>"));
П("чтение вне диапазона целого", Прочитать("<т xmlns=""urn:v""><ip>3000000000</ip></т>"));
П("чтение списка с негодным", Прочитать("<т xmlns=""urn:v""><ls>аб в</ls></т>"));
П("чтение множественного негодного", Прочитать("<т xmlns=""urn:v""><ml>аб</ml><ml>в</ml></т>"));

// Прочитанное валидное значение доступно как обычно.
Чт2 = Новый ЧтениеXML;
Чт2.УстановитьСтроку("<т xmlns=""urn:v"" ac=""green""><el>абв</el><rg>7</rg></т>");
Об2 = Фаб.ПрочитатьXML(Чт2, ТипТ);
П("прочитанный атрибут", Строка(Об2.ac));
П("прочитанный элемент", Строка(Об2.el));
П("прочитанное число", Строка(Об2.rg));
