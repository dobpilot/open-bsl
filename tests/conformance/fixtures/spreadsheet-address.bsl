// Строковая адресация областей. Отдельная фикстура, потому что этот путь
// уже давал расхождение: `Область("R5:R5")` раздувала документ до 65535
// колонок, а числовой путь работал верно. Числа и строка обязаны совпадать.

Функция Образец()
	Док = Новый ТабличныйДокумент;
	Док.Область(1, 1, 1, 1).Текст = "R1C1";
	Док.Область(1, 2, 1, 2).Текст = "R1C2";
	Док.Область(1, 3, 1, 3).Текст = "R1C3";
	Док.Область(2, 1, 2, 1).Текст = "R2C1";
	Док.Область(2, 3, 2, 3).Текст = "R2C3";
	Док.Область(3, 2, 3, 2).Текст = "R3C2";
	Возврат Док;
КонецФункции

Док = Образец();
Сообщить("размер: " + Строка(Док.ВысотаТаблицы) + "x" + Строка(Док.ШиринаТаблицы));

// Чтение одной ячейки: два пути обязаны дать одно и то же.
Сообщить("числом: " + Док.Область(2, 3, 2, 3).Текст);
Сообщить("строкой: " + Док.Область("R2C3").Текст);

// Прямоугольник.
О = Док.ПолучитьОбласть("R1C1:R2C3");
Сообщить("прямоугольник: " + Строка(О.ВысотаТаблицы) + "x" + Строка(О.ШиринаТаблицы)
	+ " [" + О.Область(1, 1, 1, 1).Текст + "][" + О.Область(2, 3, 2, 3).Текст + "]");

// Целая строка и целая колонка.
Стр = Док.ПолучитьОбласть("R2");
Сообщить("строка: " + Строка(Стр.ВысотаТаблицы) + "x" + Строка(Стр.ШиринаТаблицы)
	+ " [" + Стр.Область(1, 1, 1, 1).Текст + "][" + Стр.Область(1, 3, 1, 3).Текст + "]");
Кол = Док.ПолучитьОбласть("C2");
Сообщить("колонка: " + Строка(Кол.ВысотаТаблицы) + "x" + Строка(Кол.ШиринаТаблицы)
	+ " [" + Кол.Область(1, 1, 1, 1).Текст + "][" + Кол.Область(3, 1, 3, 1).Текст + "]");

// Диапазоны строк и колонок.
Стр2 = Док.ПолучитьОбласть("R1:R2");
Сообщить("строки: " + Строка(Стр2.ВысотаТаблицы) + "x" + Строка(Стр2.ШиринаТаблицы));
Кол2 = Док.ПолучитьОбласть("C2:C3");
Сообщить("колонки: " + Строка(Кол2.ВысотаТаблицы) + "x" + Строка(Кол2.ШиринаТаблицы));

// Запись через строковый адрес.
Запись = Образец();
Запись.Область("R3C3").Текст = "через строку";
Сообщить("записано: " + Запись.Область(3, 3, 3, 3).Текст
	+ " размер " + Строка(Запись.ВысотаТаблицы) + "x" + Строка(Запись.ШиринаТаблицы));

// Объединение целых строк не должно раздувать документ.
Слияние = Образец();
Слияние.Область("R2:R3").Объединить();
Сообщить("после слияния строк: " + Строка(Слияние.ВысотаТаблицы) + "x" + Строка(Слияние.ШиринаТаблицы));

Слияние2 = Образец();
Слияние2.Область("C1:C2").Объединить();
Сообщить("после слияния колонок: " + Строка(Слияние2.ВысотаТаблицы) + "x" + Строка(Слияние2.ШиринаТаблицы));

// Объединение прямоугольником строковым адресом.
Слияние3 = Образец();
Слияние3.Область("R1C1:R1C3").Объединить();
Сообщить("после слияния прямоугольником: [" + Слияние3.Область(1, 1, 1, 1).Текст
	+ "][" + Слияние3.Область(1, 2, 1, 2).Текст + "]");
