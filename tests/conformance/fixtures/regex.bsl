П("просмотр вперёд", Тр(СтрНайтиПоРегулярномуВыражению("аб", "а(?=б)")));
П("просмотр вперёд промах", Тр(СтрНайтиПоРегулярномуВыражению("ав", "а(?=б)")));
П("захват в просмотре", Гр(СтрНайтиПоРегулярномуВыражению("аб", "а(?=(б))")));
П("отрицательный просмотр", Тр(СтрНайтиПоРегулярномуВыражению("ав", "а(?!б)")));
П("просмотр назад", Тр(СтрНайтиПоРегулярномуВыражению("аб", "(?<=а)б")));
П("просмотр назад ограниченный", Тр(СтрНайтиПоРегулярномуВыражению("аааб", "(?<=а{1,3})б")));
