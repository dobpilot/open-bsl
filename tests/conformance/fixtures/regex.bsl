П("дотолл снятие", Тр(СтрНайтиПоРегулярномуВыражению("а" + Символ(10) + "б", "(?s)а(?-s:.)б")));
П("снятие регистра", Тр(СтрНайтиПоРегулярномуВыражению("АБ", "(?i)а(?-i:б)")));
П("многострочная группа", Всё(СтрНайтиВсеПоРегулярномуВыражению("а" + Символ(10) + "б", "(?m:^.)")));

// --- притяжательные кванторы и атомарные группы ------------------------------

П("притяжательная звезда", Тр(СтрНайтиПоРегулярномуВыражению("аа", "а*+а")));
П("притяжательный диапазон", Тр(СтрНайтиПоРегулярномуВыражению("ааа", "а{1,2}+а")));
П("атомарная группа", Тр(СтрНайтиПоРегулярномуВыражению("абв", "(?>а|аб)в")));
П("квантор на атомарную", Тр(СтрНайтиПоРегулярномуВыражению("аб", "(?>а)+б")));

// --- операции над множествами в классе ---------------------------------------

П("пересечение", Всё(СтрНайтиВсеПоРегулярномуВыражению("абв", "[а-в&&[^б]]")));
П("вложенный класс", Всё(СтрНайтиВсеПоРегулярномуВыражению("авг", "[[аб]в]")));
П("не разность", Всё(СтрНайтиВсеПоРегулярномуВыражению("аб-", "[а-я-[б]]")));
П("пересечение со свёрткой", Тр(СтрНайтиПоРегулярномуВыражению("Б", "(?i)[а-в&&[^б]]")));

