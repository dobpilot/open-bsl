КонецПопытки;
П("часть -1", Р);

Р = "";
Попытка
	Части = РазделитьДвоичныеДанные(ДД, 2.5);
	Р = "принято " + Ч(Части.Количество());
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("часть дробная", Р);

Р = "";
Попытка
