	Р = "принято " + Ч(Части.Количество());
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("часть строкой", Р);

Р = "";
Попытка
	Части = РазделитьДвоичныеДанные("не двоичные данные", 2);
	Р = "принято " + Ч(Части.Количество());
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("разбить не данные", Р);

Р = "";
Попытка
	Склеенные = СоединитьДвоичныеДанные(ДД);
	Р = "принято " + Ч(Склеенные.Размер());
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("склеить не массив", Р);

Р = "";
Попытка
	Плохой = Новый Массив;
	Плохой.Добавить(ДД);
	Плохой.Добавить("строка");
	Склеенные = СоединитьДвоичныеДанные(Плохой);
	Р = "принято " + Ч(Склеенные.Размер());
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("склеить со строкой", Р);

Р = "";
Попытка
	Плохой = Новый Массив;
	Плохой.Добавить(ДД);
	Плохой.Добавить(Неопределено);
	Склеенные = СоединитьДвоичныеДанные(Плохой);
	Р = "принято " + Ч(Склеенные.Размер());
Исключение
