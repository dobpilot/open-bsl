// Контракт типа `ДвоичныеДанные`: конструктор из файла, `Размер()`,
// `РазделитьДвоичныеДанные`/`СоединитьДвоичныеДанные`, строковое
// представление и краевые случаи.
//
// Эталон снимается ТОЛЬКО платформой:
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/fixtures/binary-data.bsl
//   diff tests/conformance/fixtures/binary-data.expected \
//        tests/conformance/fixtures/binary-data.platform.txt
//
// Пути фиксированы во временном каталоге: обе стороны бегут на одной
// машине (образец — `measure-vfile.bsl`). Файлы пишутся `ЗаписьТекста`, а
// она начинает файл с BOM `EF BB BF` (измерено), поэтому размер файла на
// три байта больше числа записанных ASCII-символов — это видно в каждой
// строке ниже и так и задумано: одна и та же дорога у обеих сторон.
//
// Два правила письма, каждое стоит впустую потраченного прогона:
// метод нельзя звать на результате вызова (`Ф(...).Метод()` не
// компилируется — нужна промежуточная переменная), а всякая проба,
// способная бросить, обязана быть в `Попытка`, иначе платформа показывает
// модальное окно и прогон висит до таймаута.

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

Функция Записать(Имя, Текст)
	Путь = "/tmp/open-bsl-binary-data-" + Имя + ".bin";
	З = Новый ЗаписьТекста(Путь);
	З.Записать(Текст);
	З.Закрыть();
	Возврат Путь;
КонецФункции

Функция Повтор(Знак, Сколько)
	С = "";
	Для н = 1 По Сколько Цикл
		С = С + Знак;
	КонецЦикла;
	Возврат С;
КонецФункции

// 10 символов + BOM = 13 байт.
Десять = Записать("десять", "0123456789");
// 13 символов + BOM = 16 байт: кратно четырём, для проверки ровного
// разбиения без хвоста.
Шестнадцать = Записать("шестнадцать", "0123456789abc");
Другой = Записать("другой", "9876543210");

ДД = Новый ДвоичныеДанные(Десять);
Ровно = Новый ДвоичныеДанные(Шестнадцать);

П("размер", Ч(ДД.Размер()));
П("тип", Строка(ТипЗнч(ДД)));
П("строка", Строка(ДД));
П("заполнено", Строка(ЗначениеЗаполнено(ДД)));

// --- разбиение --------------------------------------------------------

// Хвост короче: 13 = 5 + 5 + 3.
Части = РазделитьДвоичныеДанные(ДД, 5);
П("по 5 частей", Ч(Части.Количество()));
П("по 5 размеры", Ч(Части[0].Размер()) + "," + Ч(Части[1].Размер()) + "," + Ч(Части[2].Размер()));
П("по 5 тип части", Строка(ТипЗнч(Части[0])));

Части = РазделитьДвоичныеДанные(ДД, 3);
Последняя = Части[Части.Количество() - 1];
П("по 3 частей", Ч(Части.Количество()));
П("по 3 последняя", Ч(Последняя.Размер()));

// Точная кратность: 16 = 4 + 4 + 4 + 4, лишней пустой части нет.
Части = РазделитьДвоичныеДанные(Ровно, 4);
Последняя = Части[Части.Количество() - 1];
П("кратно частей", Ч(Части.Количество()));
П("кратно последняя", Ч(Последняя.Размер()));

// Размер части больше целого — не ошибка, отдаётся одна часть целиком.
Части = РазделитьДвоичныеДанные(ДД, 100);
Первая = Части[0];
П("больше целого частей", Ч(Части.Количество()));
П("больше целого размер", Ч(Первая.Размер()));

// Где у размера части верхняя граница. Десять миллиардов платформа
// принимает — значит, счётчик у неё шире 32 бит; дальше проверяются
// ровно края знакового 64-битного целого, потому что реализация приводит
// размер именно к нему.
Р = "";
Попытка
	Части = РазделитьДвоичныеДанные(ДД, 10000000000);
	Р = Ч(Части.Количество());
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("размер части 10^10", Р);

Р = "";
Попытка
	Части = РазделитьДвоичныеДанные(ДД, 9223372036854775807);
	Р = Ч(Части.Количество());
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("размер части 2^63-1", Р);

Р = "";
Попытка
	Части = РазделитьДвоичныеДанные(ДД, 9223372036854775808);
	Р = Ч(Части.Количество());
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("размер части 2^63", Р);

Р = "";
Попытка
	Части = РазделитьДвоичныеДанные(ДД, 18446744073709551615);
	Р = Ч(Части.Количество());
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("размер части 2^64-1", Р);

Р = "";
Попытка
	Части = РазделитьДвоичныеДанные(ДД, 18446744073709551616);
	Р = Ч(Части.Количество());
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("размер части 2^64", Р);

Р = "";
Попытка
	Части = РазделитьДвоичныеДанные(ДД, 10000000000000000000000000);
	Р = Ч(Части.Количество());
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("размер части 10^25", Р);

// --- склейка ----------------------------------------------------------

Части = РазделитьДвоичныеДанные(ДД, 3);
Целое = СоединитьДвоичныеДанные(Части);
П("склейка размер", Ч(Целое.Размер()));
П("склейка равна исходной", Строка(Целое = ДД));

Пара = Новый Массив;
Пара.Добавить(ДД);
Пара.Добавить(Ровно);
Склеенные = СоединитьДвоичныеДанные(Пара);
П("склейка двух", Ч(Склеенные.Размер()));

Пустые = СоединитьДвоичныеДанные(Новый Массив);
П("пустой массив размер", Ч(Пустые.Размер()));
П("пустые заполнено", Строка(ЗначениеЗаполнено(Пустые)));
П("пустые строка", "[" + Строка(Пустые) + "]");

Р = "";
Попытка
	Части = РазделитьДвоичныеДанные(Пустые, 5);
	Р = Ч(Части.Количество());
	Для Каждого Часть Из Части Цикл
		Р = Р + " " + Строка(ТипЗнч(Часть)) + " " + Ч(Часть.Размер());
	КонецЦикла;
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("разбиение пустых", Р);

// --- равенство --------------------------------------------------------

Копия = Новый ДвоичныеДанные(Десять);
Иные = Новый ДвоичныеДанные(Другой);
П("равны из одного файла", Строка(Копия = ДД));
П("равны из разных файлов", Строка(Иные = ДД));

// --- строковое представление длинных данных ---------------------------
//
// 252/253/254 символа плюс BOM дают 255/256/257 байт. Печатается длина
// представления: у 255 байт это 255*3-1 = 764 символа, у 256 — 767, а
// как только представление обрезается, к нему добавляется многоточие
// (+3 символа). Где именно проходит граница обрезания — говорит платформа,
// а не эта реализация.

Граница255 = Новый ДвоичныеДанные(Записать("б255", Повтор("A", 252)));
Граница256 = Новый ДвоичныеДанные(Записать("б256", Повтор("A", 253)));
Граница257 = Новый ДвоичныеДанные(Записать("б257", Повтор("A", 254)));

П("255 размер", Ч(Граница255.Размер()));
П("255 длина строки", Ч(СтрДлина(Строка(Граница255))));
П("255 хвост", Прав(Строка(Граница255), 5));
П("256 длина строки", Ч(СтрДлина(Строка(Граница256))));
П("256 хвост", Прав(Строка(Граница256), 5));
П("257 длина строки", Ч(СтрДлина(Строка(Граница257))));
П("257 хвост", Прав(Строка(Граница257), 5));

// --- ошибки -----------------------------------------------------------

Р = "";
Попытка
	Нет = Новый ДвоичныеДанные("/tmp/open-bsl-binary-data-нет-такого.bin");
	Р = "принято " + Ч(Нет.Размер());
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("нет файла", Р);

Р = "";
Попытка
	Части = РазделитьДвоичныеДанные(ДД, 0);
	Р = "принято " + Ч(Части.Количество());
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("часть 0", Р);

Р = "";
Попытка
