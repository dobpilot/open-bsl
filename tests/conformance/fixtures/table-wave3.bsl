// ТаблицаЗначений, волна 3: Скопировать, СкопироватьКолонки,
// ВыгрузитьКолонку, ЗагрузитьКолонку, Сдвинуть, Индекс, Свернуть.
//
// БЕЗ .expected НАМЕРЕННО. Открытых вопросов здесь пять, и все они
// перечислены в bsl_rt::open_questions с теми же ИД: TABLE.COLLAPSE.*
// (судьба прочих колонок, порядок строк, нечисловые в сумме),
// TABLE.LOAD_COLUMN.LENGTH_MISMATCH и TABLE.MOVE.OUT_OF_RANGE. Короткие
// пробы по ним есть в measure-all.bsl; здесь то же самое в развёрнутом
// виде — прогон фикстуры целиком даёт эталон построчно.

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧГ=0; ЧРД=.");
КонецФункции

Т = Новый ТаблицаЗначений;
Т.Колонки.Добавить("имя");
Т.Колонки.Добавить("цена");
С1 = Т.Добавить(); С1.имя = "груша";  С1.цена = 30;
С2 = Т.Добавить(); С2.имя = "яблоко"; С2.цена = 10;
С3 = Т.Добавить(); С3.имя = "дыня";   С3.цена = 20;

// --- Скопировать ------------------------------------------------------
К = Т.Скопировать();
Сообщить(Ч(К.Количество()));
Сообщить(Ч(К.Колонки.Количество()));
К[0].цена = 999;
Сообщить(Ч(Т[0].цена));                    // 30: копия независима
Сообщить(Ч(К[0].цена));                    // 999

// Только выбранные колонки.
КК = Т.Скопировать(Неопределено, "имя");
Сообщить(Ч(КК.Колонки.Количество()));
Попытка
	Сообщить(Ч(КК[0].цена));
	Сообщить("колонка цена уцелела");
Исключение
	Сообщить("нет колонки цена");
КонецПопытки;

// Только выбранные строки, порядок — порядок массива.
Строки = Новый Массив;
Строки.Добавить(С3);
Строки.Добавить(С1);
КС = Т.Скопировать(Строки);
Сообщить(КС[0].имя + "," + КС[1].имя);     // дыня,груша

// --- СкопироватьКолонки -----------------------------------------------
П = Т.СкопироватьКолонки();
Сообщить(Ч(П.Количество()));               // 0
Сообщить(Ч(П.Колонки.Количество()));       // 2
П.Добавить().имя = "новая";
Сообщить(П[0].имя);

// --- ВыгрузитьКолонку / ЗагрузитьКолонку ------------------------------
М = Т.ВыгрузитьКолонку("цена");
Сообщить(Ч(М.Количество()));
Сообщить(Ч(М[0]) + "," + Ч(М[1]) + "," + Ч(М[2]));

Новые = Новый Массив;
Новые.Добавить(1);
Новые.Добавить(2);
Новые.Добавить(3);
Т.ЗагрузитьКолонку(Новые, "цена");
Сообщить(Ч(Т.Итог("цена")));               // 6

// ЗАМЕР: массив короче таблицы. Здесь — хвост остаётся прежним, число
// строк не меняется.
Короткий = Новый Массив;
Короткий.Добавить(100);
Попытка
	Т.ЗагрузитьКолонку(Короткий, "цена");
	Сообщить(Ч(Т.Количество()) + ":" + Ч(Т[0].цена) + "," + Ч(Т[1].цена) + "," + Ч(Т[2].цена));
Исключение
	Сообщить("ЗагрузитьКолонку короче таблицы — ошибка");
КонецПопытки;

// --- Индекс и Сдвинуть -------------------------------------------------
Сообщить(Ч(Т.Индекс(С1)));                 // 0
Сообщить(Ч(Т.Индекс(С3)));                 // 2
Т.Сдвинуть(С1, 2);
Сообщить(Ч(Т.Индекс(С1)));                 // 2 — живая строка пережила сдвиг
Сообщить(Т[0].имя + "," + Т[1].имя + "," + Т[2].имя);
Т.Сдвинуть(2, -2);                          // тот же сдвиг по индексу, обратно
Сообщить(Т[0].имя + "," + Т[1].имя + "," + Т[2].имя);

// ЗАМЕР: сдвиг за границу — ошибка или зажатие.
Попытка
	Т.Сдвинуть(0, -1);
	Сообщить("сдвиг за границу принят: " + Т[0].имя);
Исключение
	Сообщить("сдвиг за границу — ошибка");
КонецПопытки;

// --- Свернуть ----------------------------------------------------------
// Колонка `прочее` не входит НИ В ОДИН из двух списков, а в суммируемой
// колонке одной из групп лежит текст — три открытых вопроса на одних
// данных.
СВ = Новый ТаблицаЗначений;
СВ.Колонки.Добавить("группа");
СВ.Колонки.Добавить("сумма");
СВ.Колонки.Добавить("прочее");
Г1 = СВ.Добавить(); Г1.группа = "б"; Г1.сумма = 10;      Г1.прочее = "х";
Г2 = СВ.Добавить(); Г2.группа = "а"; Г2.сумма = 1;       Г2.прочее = "у";
Г3 = СВ.Добавить(); Г3.группа = "б"; Г3.сумма = 20;      Г3.прочее = "z";
Г4 = СВ.Добавить(); Г4.группа = "а"; Г4.сумма = "текст"; Г4.прочее = "ц";

СВ.Свернуть("группа", "сумма");
Сообщить(Ч(СВ.Количество()));              // 2 группы
Сообщить(Ч(СВ.Колонки.Количество()));      // ЗАМЕР: 2 или 3

// ЗАМЕР: порядок строк — первое вхождение (б, а) или сортировка (а, б).
Рез = "";
Для Каждого С Из СВ Цикл
	Рез = Рез + С.группа + "=" + Ч(С.сумма) + ";";
КонецЦикла;
Сообщить(Рез);

// ЗАМЕР: уцелела ли колонка вне обоих списков.
Попытка
	Сообщить("прочее=" + Строка(СВ[0].прочее));
Исключение
	Сообщить("колонка прочее удалена");
КонецПопытки;

// Свёрнутая строка сохраняет идентичность первой строки группы.
Сообщить(Ч(Г1.сумма));                     // 30
Попытка
	Сообщить(Ч(Г3.сумма));
	Сообщить("слитая строка ещё жива");
Исключение
	Сообщить("слитая строка недействительна");
КонецПопытки;

// Свернуть без суммирования — только уникальные ключи.
У = Новый ТаблицаЗначений;
У.Колонки.Добавить("к");
У.Добавить().к = 1;
У.Добавить().к = 2;
У.Добавить().к = 1;
У.Свернуть("к");
Сообщить(Ч(У.Количество()));               // 2
