// Каждый случай ограничен отдельным временным каталогом.
Асинх Функция ПробаТипаУдаления(ИдентификаторУдаления, МаскаУдаления, ИмяМетодаУдаления)
	КореньУдаления = "";
	Попытка
		КореньУдаления = ПолучитьИмяВременногоФайла(".delete-types");
		СоздатьКаталог(КореньУдаления + "/data");
		ДанныеУдаления = ПолучитьДвоичныеДанныеИзСтроки("x", КодировкаТекста.UTF8, Ложь);
		ДанныеУдаления.Записать(КореньУдаления + "/data/keep.bin");
		ИмяМаскиУдаления = Строка(МаскаУдаления);
		Если ИмяМаскиУдаления <> "" Тогда
			ДанныеУдаления.Записать(КореньУдаления + "/data/" + ИмяМаскиУдаления);
		КонецЕсли;
		СтадияУдаления = "call";
		Попытка
			ОбещаниеУдаления = Вычислить(ИмяМетодаУдаления + "(КореньУдаления + ""/data"", МаскаУдаления)");
			ПризнакОбещанияУдаления = ТипЗнч(ОбещаниеУдаления) = Тип("Обещание");
			СтадияУдаления = "await";
			РезультатУдаления = Ждать ОбещаниеУдаления;
			ИтогУдаления = "ok|promise=" + ?(ПризнакОбещанияУдаления, "1", "0")
				+ "|undefined=" + ?(РезультатУдаления = Неопределено, "1", "0");
		Исключение
			ИтогУдаления = "error|stage=" + СтадияУдаления;
		КонецПопытки;
		КаталогПроверкиУдаления = Новый Файл(КореньУдаления + "/data");
		СоседПроверкиУдаления = Новый Файл(КореньУдаления + "/data/keep.bin");
		ЦельПроверкиУдаления = Новый Файл(КореньУдаления + "/data/" + ИмяМаскиУдаления);
		Сообщить(ИдентификаторУдаления + Символ(9) + ИтогУдаления
			+ "|root=" + ?(КаталогПроверкиУдаления.Существует(), "1", "0")
			+ "|keep=" + ?(СоседПроверкиУдаления.Существует(), "1", "0")
			+ "|target=" + ?(ЦельПроверкиУдаления.Существует(), "1", "0"));
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИдентификаторУдаления + ":" + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Если КореньУдаления <> "" Тогда
		Попытка
			УдалитьФайлы(КореньУдаления);
		Исключение
			Сообщить("file.cleanup_error" + Символ(9) + ИдентификаторУдаления + ":" + ИнформацияОбОшибке().Описание);
		КонецПопытки;
	КонецЕсли;
    Возврат Неопределено;
КонецФункции

Асинх Процедура ИзмеритьМаскиУдаленияАсинх()
	Сообщить("file.begin" + Символ(9) + "delete-async-types-1");
	Ждать ПробаТипаУдаления("delete.async.ru.number", 17, "УдалитьФайлыАсинх");
	Ждать ПробаТипаУдаления("delete.async.ru.zero", 0, "УдалитьФайлыАсинх");
	Ждать ПробаТипаУдаления("delete.async.ru.true", Истина, "УдалитьФайлыАсинх");
	Ждать ПробаТипаУдаления("delete.async.ru.false", Ложь, "УдалитьФайлыАсинх");
	Ждать ПробаТипаУдаления("delete.async.ru.null", Null, "УдалитьФайлыАсинх");
	Ждать ПробаТипаУдаления("delete.async.ru.undefined", Неопределено, "УдалитьФайлыАсинх");
	Ждать ПробаТипаУдаления("delete.async.ru.empty", "", "УдалитьФайлыАсинх");
	Ждать ПробаТипаУдаления("delete.async.ru.array", Новый Массив, "УдалитьФайлыАсинх");
	Ждать ПробаТипаУдаления("delete.async.ru.structure", Новый Структура, "УдалитьФайлыАсинх");
	Ждать ПробаТипаУдаления("delete.async.en.number", 17, "DeleteFilesAsync");
	Ждать ПробаТипаУдаления("delete.async.en.zero", 0, "DeleteFilesAsync");
	Ждать ПробаТипаУдаления("delete.async.en.true", Истина, "DeleteFilesAsync");
	Ждать ПробаТипаУдаления("delete.async.en.false", Ложь, "DeleteFilesAsync");
	Ждать ПробаТипаУдаления("delete.async.en.null", Null, "DeleteFilesAsync");
	Ждать ПробаТипаУдаления("delete.async.en.undefined", Неопределено, "DeleteFilesAsync");
	Ждать ПробаТипаУдаления("delete.async.en.empty", "", "DeleteFilesAsync");
	Ждать ПробаТипаУдаления("delete.async.en.array", Новый Массив, "DeleteFilesAsync");
	Ждать ПробаТипаУдаления("delete.async.en.structure", Новый Структура, "DeleteFilesAsync");
	Сообщить("file.end" + Символ(9) + "delete-async-types-1");
	Попытка
		Выполнить("ЗавершитьРаботуСистемы(Ложь)");
	Исключение
	КонецПопытки;
КонецПроцедуры

ИзмеритьМаскиУдаленияАсинх();
