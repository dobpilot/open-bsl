// Выполнить/Вычислить: область видимости, значения, ошибки.
//
// БЕЗ .expected НАМЕРЕННО — эталон снимается прогоном на реальной 1С.
// Здесь замеряется НЕ арифметика, а СЕМАНТИКА ОБЛАСТИ ВИДИМОСТИ: что
// именно фрагмент видит, что может изменить и что переживает вызов.

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧГ=0; ЧРД=.");
КонецФункции

// --- Верхний уровень: чтение и запись существующих переменных ---------
Х = 1;
Выполнить("Х = Х + 41");
Сообщить(Ч(Х));                                 // 42

Сообщить(Ч(Вычислить("2 + 2 * 10")));           // 22 — выражение, не оператор
А = 6;
Б = 7;
Сообщить(Ч(Вычислить("А * Б")));                // фрагмент видит переменные

// --- Внутри функции: своя область видимости, не верхнего уровня -------
Функция ВидитСвоиЛокальные()
	М = 5;
	Выполнить("М = М * 2");
	Возврат М;
КонецФункции
Сообщить(Ч(ВидитСвоиЛокальные()));              // 10

// ЗАМЕР: переменная с тем же именем есть и снаружи, и внутри функции.
// Фрагмент обязан видеть ЛОКАЛЬНУЮ, а не внешнюю.
Н = 100;
Функция ЧьюНВидитФрагмент()
	Н = 5;
	Возврат Вычислить("Н");
КонецФункции
Сообщить(Ч(ЧьюНВидитФрагмент()));               // 5, а не 100
Сообщить(Ч(Н));                                 // внешняя не тронута: 100

// --- Параметры ---------------------------------------------------------
Функция ВидитПараметрПоЗначению(Знач П)
	Возврат Вычислить("П * 2");
КонецФункции
Сообщить(Ч(ВидитПараметрПоЗначению(21)));       // 42

// ЗАМЕР: параметр БЕЗ Знач передаётся по ссылке. Запись из фрагмента
// обязана быть видна вызывающему так же, как запись из обычного кода.
Процедура МеняетПараметрПоСсылке(П)
	Выполнить("П = П + 1");
КонецПроцедуры
Ц = 41;
МеняетПараметрПоСсылке(Ц);
Сообщить(Ч(Ц));                                 // 42 или 41?

// --- Новые имена, объявленные самим фрагментом -------------------------
// ЗАМЕР: переживает ли переменная, впервые созданная внутри Выполнить,
// сам вызов. Здесь — НЕТ (расширить статически размеченный кадр нечем),
// поэтому обращение к ней ниже должно упасть и попасться в Попытка.
Выполнить("НоваяПеременная = 7");
Попытка
	Сообщить(Ч(Вычислить("НоваяПеременная")));
Исключение
	Сообщить("новое имя не пережило вызов");
КонецПопытки;

// --- Ошибка компиляции фрагмента — обычное исключение ------------------
Попытка
	Выполнить("это ((( не код");
	Сообщить("не сработало");
Исключение
	Сообщить("ошибка компиляции поймана");
КонецПопытки;

// --- Фрагмент в цикле: каждый раз видит текущее состояние --------------
Сумма = 0;
Для Ном = 1 По 5 Цикл
	Выполнить("Сумма = Сумма + Ном");
КонецЦикла;
Сообщить(Ч(Сумма));                             // 15

// --- Фрагмент, меняющий коллекцию --------------------------------------
М = Новый Массив;
Выполнить("М.Добавить(1); М.Добавить(2)");
Сообщить(Ч(М.Количество()));                    // 2
