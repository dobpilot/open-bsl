// ТекстовыйДокумент и его макеты. Ожидаемый вывод снят с 8.3.27 — см.
// tests/conformance/measure/measure-textdoc.bsl.

Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Р = СтрЗаменить(Р, Символ(10), "<ПС>");
	Возврат Р;
КонецФункции

// --- Модель строк ------------------------------------------------------
// Пустой текст — ноль строк, а один перевод строки — одна.

Д = Новый ТекстовыйДокумент;
Сообщить("[" + Д.ПолучитьТекст() + "] " + Д.КоличествоСтрок());

Д.УстановитьТекст("раз" + Символ(10) + "два");
Сообщить(Видимо(Д.ПолучитьТекст()) + " " + Д.КоличествоСтрок());

Д.УстановитьТекст("раз" + Символ(10));
Сообщить("хвостовой перевод: " + Д.КоличествоСтрок());
Д.УстановитьТекст(Символ(10));
Сообщить("только перевод: " + Д.КоличествоСтрок());
Д.УстановитьТекст("");
Сообщить("пустой: " + Д.КоличествоСтрок());

// ВК остаётся в тексте, но в строке его не видно.
Д.УстановитьТекст("раз" + Символ(13) + Символ(10) + "два");
Сообщить(Видимо(Д.ПолучитьТекст()) + " | строка 1 = [" + Д.ПолучитьСтроку(1) + "]");

// --- Строки по номерам -------------------------------------------------
// Номера 1-based, выход за границы — не ошибка.

Д = Новый ТекстовыйДокумент;
Д.УстановитьТекст("раз" + Символ(10) + "два");
Сообщить(Д.ПолучитьСтроку(1) + "|" + Д.ПолучитьСтроку(2)
	+ "|[" + Д.ПолучитьСтроку(0) + "]|[" + Д.ПолучитьСтроку(5) + "]");

Д = Новый ТекстовыйДокумент;
Д.ДобавитьСтроку("раз");
Д.ДобавитьСтроку("два");
Сообщить(Видимо(Д.ПолучитьТекст()) + " " + Д.КоличествоСтрок());

Д.УстановитьТекст("раз" + Символ(10) + "три");
Д.ВставитьСтроку(2, "два");
Сообщить(Видимо(Д.ПолучитьТекст()));
Д.ЗаменитьСтроку(1, "ноль");
Сообщить(Видимо(Д.ПолучитьТекст()));
Д.УдалитьСтроку(1);
Сообщить(Видимо(Д.ПолучитьТекст()));

// Вставка за концом ведёт себя как ДобавитьСтроку, замена и удаление — нет.
Д = Новый ТекстовыйДокумент;
Д.УстановитьТекст("раз");
Д.ЗаменитьСтроку(9, "девять");
Д.УдалитьСтроку(9);
Сообщить("после промахов: " + Видимо(Д.ПолучитьТекст()));
Д.ВставитьСтроку(9, "девять");
Сообщить("после вставки за концом: " + Видимо(Д.ПолучитьТекст()));

Д.Очистить();
Сообщить("после Очистить: [" + Д.ПолучитьТекст() + "] " + Д.КоличествоСтрок());

// --- Макет: области ----------------------------------------------------
// Область отдаётся ВМЕСТЕ с маркерами и обрывается на следующей директиве.

Макет = Новый ТекстовыйДокумент;
Макет.УстановитьТекст("до" + Символ(10) + "#Область Тело" + Символ(10)
	+ "внутри" + Символ(10) + "#КонецОбласти" + Символ(10) + "после");
Сообщить("[" + Видимо(Макет.ПолучитьОбласть("Тело").ПолучитьТекст()) + "]");
Сообщить("строк в области: " + Макет.ПолучитьОбласть("Тело").КоличествоСтрок());

// Текст переустановить МОЖНО, но разметка областей уже заморожена первым
// ПолучитьОбласть: новая область в переустановленном тексте не найдётся.
Макет.УстановитьТекст("#Область Другая" + Символ(10) + "иное" + Символ(10) + "#КонецОбласти");
Сообщить("текст после переустановки: [" + Макет.ПолучитьТекст() + "]");
Попытка
	Сообщить(Макет.ПолучитьОбласть("Другая").ПолучитьТекст());
Исключение
	Сообщить("новая область после переустановки -> <ошибка>");
КонецПопытки;

// Поэтому каждый следующий пример берёт СВЕЖИЙ документ.
// Регистр не важен ни у имени, ни у директивы.
Макет2 = Новый ТекстовыйДокумент;
Макет2.УстановитьТекст("#область Шапка" + Символ(10) + "привет" + Символ(10) + "#конецобласти");
Сообщить("[" + Видимо(Макет2.ПолучитьОбласть("шапка").ПолучитьТекст()) + "]");

// Вложения нет: внешняя область обрывается перед внутренней.
Макет3 = Новый ТекстовыйДокумент;
Макет3.УстановитьТекст("#Область Внешняя" + Символ(10) + "а" + Символ(10)
	+ "#Область Внутренняя" + Символ(10) + "б" + Символ(10)
	+ "#КонецОбласти" + Символ(10) + "#КонецОбласти");
Сообщить("внешняя: [" + Видимо(Макет3.ПолучитьОбласть("Внешняя").ПолучитьТекст()) + "]");
Сообщить("внутренняя: [" + Видимо(Макет3.ПолучитьОбласть("Внутренняя").ПолучитьТекст()) + "]");

Попытка
	Сообщить(Макет3.ПолучитьОбласть("НетТакой").ПолучитьТекст());
Исключение
	Сообщить("нет области -> <ошибка>");
КонецПопытки;

// --- Макет: вывод и параметры ------------------------------------------
// Вывести срезает маркеры и подставляет [Параметр] в поле фиксированной
// ширины: значение дополняется пробелами или обрезается.

Макет = Новый ТекстовыйДокумент;
Макет.УстановитьТекст("#Область Строка" + Символ(10) + "[Товар] [Сумма]" + Символ(10) + "#КонецОбласти");

Результат = Новый ТекстовыйДокумент;
Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Товар = "гвозди";
Область.Параметры.Сумма = 1000.5;
Результат.Вывести(Область);

Область2 = Макет.ПолучитьОбласть("Строка");
Область2.Параметры.Товар = "оченьдлинноенаименование";
Результат.Вывести(Область2);

// Незаданный параметр — пробелы.
Результат.Вывести(Макет.ПолучитьОбласть("Строка"));
Сообщить("[" + Видимо(Результат.ПолучитьТекст()) + "] строк: " + Результат.КоличествоСтрок());

// ПолучитьТекст параметров не подставляет.
Сообщить("[" + Видимо(Область.ПолучитьТекст()) + "]");

// Имя, которого в макете нет, задать нельзя.
Попытка
	Область.Параметры.НетТакого = "х";
	Сообщить("установлен");
Исключение
	Сообщить("чужое имя -> <ошибка>");
КонецПопытки;

// Вывод документа, не полученного через ПолучитьОбласть, даёт пусто.
Обычный = Новый ТекстовыйДокумент;
Обычный.УстановитьТекст("кусок");
Приёмник = Новый ТекстовыйДокумент;
Приёмник.Вывести(Обычный);
Сообщить("обычный документ: [" + Приёмник.ПолучитьТекст() + "]");

// --- Файлы -------------------------------------------------------------

Путь = "/tmp/open-bsl-fixture-textdoc.txt";
Д = Новый ТекстовыйДокумент;
Д.УстановитьТекст("раз" + Символ(10) + "два");
Д.Записать(Путь);
Ч = Новый ТекстовыйДокумент;
Ч.Прочитать(Путь);
Сообщить("[" + Видимо(Ч.ПолучитьТекст()) + "] " + Ч.КоличествоСтрок());

Попытка
	Ч.Прочитать("/tmp/open-bsl-нет-такого-файла.txt");
	Сообщить("прочитан");
Исключение
	Сообщить("нет файла -> <ошибка>");
КонецПопытки;
