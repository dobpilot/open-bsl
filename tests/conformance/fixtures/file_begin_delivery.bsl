Перем СобытияДоставки;
Перем ФайлДоставки;
Перем ВозвратДоставки;

Асинх Процедура КлиентскаяПробаДоставки()
КонецПроцедуры

Процедура ПроверитьОкончаниеДоставки()
    Если СобытияДоставки.Количество() <> 6 Тогда Возврат; КонецЕсли;
    Для Каждого КлючДоставки Из СтрРазделить("init.ru,init.en,hidden,readonly,time,utc", ",") Цикл
        Сообщить("delivery." + КлючДоставки + Символ(9) + СобытияДоставки[КлючДоставки]);
    КонецЦикла;
    Сообщить("file.end" + Символ(9) + "file-begin-delivery-1");
    Попытка Выполнить("ЗавершитьРаботуСистемы(Ложь);"); Исключение КонецПопытки;
КонецПроцедуры

Процедура РезультатДоставки(Знач ЗначениеДоставки, Знач ДанныеДоставки) Экспорт
    СобытияДоставки.Вставить(ДанныеДоставки,
        ?(ЗначениеДоставки = ФайлДоставки, "same", "different")
        + "|" + ЗначениеДоставки.ПолноеИмя + "|returned=" + ?(ВозвратДоставки, "1", "0"));
    ПроверитьОкончаниеДоставки();
КонецПроцедуры

Процедура НеожиданныйУспехДоставки(Знач ДанныеДоставки) Экспорт
    СобытияДоставки.Вставить(ДанныеДоставки, "unexpected success");
    ПроверитьОкончаниеДоставки();
КонецПроцедуры

Процедура ОшибкаДоставки(Знач ИнформацияДоставки, СтандартнаяДоставки, Знач ДанныеДоставки) Экспорт
    СобытияДоставки.Вставить(ДанныеДоставки,
        "error|" + Строка(ТипЗнч(ИнформацияДоставки))
        + "|standard=" + ?(СтандартнаяДоставки, "1", "0")
        + "|returned=" + ?(ВозвратДоставки, "1", "0"));
    СтандартнаяДоставки = Ложь;
    ПроверитьОкончаниеДоставки();
КонецПроцедуры

Функция ОписаниеОшибкиДоставки(КлючДоставки)
    Возврат Новый ОписаниеОповещения("НеожиданныйУспехДоставки", ЭтотОбъект, КлючДоставки, "ОшибкаДоставки", ЭтотОбъект);
КонецФункции

Сообщить("file.begin" + Символ(9) + "file-begin-delivery-1");
СобытияДоставки = Новый Соответствие;
ВозвратДоставки = Ложь;
ФайлДоставки = Новый Файл("initial");
Попытка
    ФайлДоставки.НачатьИнициализацию(Новый ОписаниеОповещения("РезультатДоставки", ЭтотОбъект, "init.ru"), "first");
    ФайлДоставки.BeginInitialization(Новый NotifyDescription("РезультатДоставки", ThisObject, "init.en"), "second");
    ФайлДоставки.НачатьУстановкуНевидимости(ОписаниеОшибкиДоставки("hidden"), Новый Массив);
    ФайлДоставки.BeginSettingReadOnly(ОписаниеОшибкиДоставки("readonly"), Новый Массив);
    ФайлДоставки.НачатьУстановкуВремениИзменения(ОписаниеОшибкиДоставки("time"), Новый Массив);
    ФайлДоставки.BeginSettingModificationUniversalTime(ОписаниеОшибкиДоставки("utc"), Новый Массив);
    Сообщить("delivery.return" + Символ(9) + ФайлДоставки.ПолноеИмя + "|count=" + Строка(СобытияДоставки.Количество()));
    ВозвратДоставки = Истина;
Исключение
    Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
    Сообщить("file.end" + Символ(9) + "file-begin-delivery-1");
    Попытка Выполнить("ЗавершитьРаботуСистемы(Ложь);"); Исключение КонецПопытки;
КонецПопытки;
