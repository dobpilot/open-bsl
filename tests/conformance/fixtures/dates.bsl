// Даты: конструкторы, компоненты, границы периодов, арифметика, формат.
//
// БЕЗ .expected НАМЕРЕННО — эталон снимается прогоном на реальной 1С (см.
// tests/conformance.rs: фикстура без пары просто пропускается). Числа
// печатаются в канонической форме, чтобы отличать расхождение семантики от
// расхождения форматирования.

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧГ=0; ЧРД=.");
КонецФункции

// --- Представление по умолчанию (ЗАМЕР: печатается ли время всегда) ---
Сообщить(Строка(Дата(2024, 1, 15, 10, 30, 0)));
Сообщить(Строка(Дата(2024, 1, 15)));           // время нулевое: печатается?
Сообщить(Строка('00010101'));                  // пустая дата: пусто или 01.01.0001?
Сообщить(Строка(ТипЗнч(Дата(2024, 1, 15))));

// --- Литерал и конструктор должны совпадать ---------------------------
Сообщить('20240115103000' = Дата(2024, 1, 15, 10, 30, 0));
Сообщить('20240115' = Дата(2024, 1, 15));
Сообщить(Дата("20240115103000") = '20240115103000');

// --- Компоненты -------------------------------------------------------
Д = Дата(2024, 2, 29, 13, 45, 30);
Сообщить(Ч(Год(Д)));
Сообщить(Ч(Месяц(Д)));
Сообщить(Ч(День(Д)));
Сообщить(Ч(Час(Д)));
Сообщить(Ч(Минута(Д)));
Сообщить(Ч(Секунда(Д)));
Сообщить(Ч(ДеньНедели(Дата(2024, 1, 15))));    // ЗАМЕР: пн = 1 или 0
Сообщить(Ч(ДеньНедели(Дата(2024, 1, 21))));    // воскресенье

// --- Арифметика -------------------------------------------------------
Сообщить(Ч(Дата(2024, 1, 15) - Дата(2024, 1, 14)));   // 86400?
Сообщить(Строка(Дата(2024, 1, 14) + 86400));
Сообщить(Строка(Дата(2024, 1, 15) - 86400));
Сообщить(Ч(Дата(2025, 1, 1) - Дата(2024, 1, 1)));     // високосный год

// --- Границы периодов -------------------------------------------------
Сообщить(Строка(НачалоДня(Дата(2024, 2, 17, 13, 45, 30))));
Сообщить(Строка(КонецДня(Дата(2024, 2, 17))));        // 23:59:59 или 00:00 след. дня
Сообщить(Строка(НачалоМесяца(Дата(2024, 2, 17))));
Сообщить(Строка(КонецМесяца(Дата(2024, 2, 17))));     // високосный февраль
Сообщить(Строка(НачалоГода(Дата(2024, 7, 4))));
Сообщить(Строка(КонецГода(Дата(2024, 7, 4))));
Сообщить(Строка(НачалоНедели(Дата(2024, 1, 17))));    // ЗАМЕР: неделя с пн или вс

// --- ДобавитьМесяц ----------------------------------------------------
Сообщить(Строка(ДобавитьМесяц(Дата(2024, 1, 31), 1)));  // ЗАМЕР: 29.02 или ошибка
Сообщить(Строка(ДобавитьМесяц(Дата(2023, 1, 31), 1)));  // невисокосный: 28.02?
Сообщить(Строка(ДобавитьМесяц(Дата(2024, 1, 15), -1)));
Сообщить(Строка(ДобавитьМесяц(Дата(2024, 12, 15), 1))); // переход через год

// --- Формат: ДФ и ДЛФ -------------------------------------------------
Сообщить(Формат(Дата(2024, 1, 15), "ДФ='дд.ММ.гггг'"));
Сообщить(Формат(Дата(2024, 1, 15, 9, 5, 0), "ДФ='ММ/мм'"));  // месяц против минуты
Сообщить(Формат(Дата(2024, 1, 15), "ДФ='д МММ гггг'"));
Сообщить(Формат(Дата(2024, 1, 15), "ДФ='д ММММ гггг'"));
Сообщить(Формат(Дата(2024, 1, 15), "ДФ='дддд'"));      // название дня недели
Сообщить(Формат(Дата(2024, 1, 15, 0, 0, 0), "ДФ='чч'"));  // 12-часовой: полночь
Сообщить(Формат(Дата(2024, 1, 15, 0, 0, 0), "ДФ='ЧЧ'"));  // 24-часовой
Сообщить(Формат(Дата(2024, 1, 15), "ДЛФ=Д"));
Сообщить(Формат(Дата(2024, 1, 15), "ДЛФ=ДД"));
Сообщить(Формат(Дата(2024, 1, 15, 10, 30, 0), "ДЛФ=В"));

// --- ЗначениеЗаполнено на датах ---------------------------------------
Сообщить(ЗначениеЗаполнено('00010101'));       // измерено: Ложь
Сообщить(ЗначениеЗаполнено(Дата(2024, 1, 15)));
