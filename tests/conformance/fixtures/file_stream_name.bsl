Процедура ИмяОбычногоПотока(ИдИмени, ПутьИмени, КореньИмени)
    ПотокИмени = Неопределено;
    Попытка
        ПотокИмени = Новый ФайловыйПоток(ПутьИмени, РежимОткрытияФайла.Создать);
        ИмяДоЗакрытия = Вычислить("ПотокИмени.ИмяФайла");
        Попытка
            Выполнить("ПотокИмени.FileName = ""other"";");
            ОтказЗаписиИмени = "writable";
        Исключение
            ОтказЗаписиИмени = "readonly";
        КонецПопытки;
        ПотокИмени.Закрыть();
        ИмяПослеЗакрытия = Вычислить("ПотокИмени.FileName");
        Сообщить(ИдИмени + Символ(9) + СтрЗаменить(ИмяДоЗакрытия, КореньИмени, "<root>")
            + "|same=" + ?(ИмяДоЗакрытия = ИмяПослеЗакрытия, "1", "0") + "|" + ОтказЗаписиИмени);
    Исключение
        Сообщить(ИдИмени + Символ(9) + "error|" + ИнформацияОбОшибке().Описание);
    КонецПопытки;
    Если ПотокИмени <> Неопределено Тогда
        Попытка ПотокИмени.Закрыть(); Исключение КонецПопытки;
    КонецЕсли;
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "stream-name-1");
КореньИмениПотока = ПолучитьИмяВременногоФайла(".stream-name");
Попытка
    СоздатьКаталог(КореньИмениПотока + "/nested");
    ИмяОбычногоПотока("stream.name.plain", КореньИмениПотока + "/plain", КореньИмениПотока);
    ИмяОбычногоПотока("stream.name.dot", КореньИмениПотока + "/./dot", КореньИмениПотока);
    ИмяОбычногоПотока("stream.name.parent", КореньИмениПотока + "/nested/../parent", КореньИмениПотока);
    ИмяОбычногоПотока("stream.name.slashes", КореньИмениПотока + "//slashes", КореньИмениПотока);
    ИмяОбычногоПотока("stream.name.space", КореньИмениПотока + "/space ", КореньИмениПотока);
    ПотокБезИмени = Новый ПотокВПамяти;
    Попытка
        ИмяПотокаВПамяти = Вычислить("ПотокБезИмени.ИмяФайла");
        Сообщить("stream.name.memory" + Символ(9) + Строка(ИмяПотокаВПамяти));
    Исключение
        Сообщить("stream.name.memory" + Символ(9) + "error");
    КонецПопытки;
Исключение
    Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Попытка УдалитьФайлы(КореньИмениПотока); Исключение Сообщить("file.cleanup_error" + Символ(9) + ИнформацияОбОшибке().Описание); КонецПопытки;
Сообщить("file.end" + Символ(9) + "stream-name-1");
