Асинх Функция ПроверитьАргументИнициализации(ИдПробы, ЗначениеПробы)
	ОжидаемыйПуть = Строка(ЗначениеПробы);
	ФайлПробы = Новый Файл("before.txt");
	ОбещаниеПробы = ФайлПробы.ИнициализироватьАсинх(ЗначениеПробы);
	ПутьПослеВызова = ФайлПробы.ПолноеИмя;
	РезультатПробы = Ждать ОбещаниеПробы;
	Сообщить(ИдПробы + Символ(9)
		+ "immediate=" + ?(ПутьПослеВызова = ОжидаемыйПуть, "1", "0")
		+ "|result_path=" + ?(РезультатПробы.ПолноеИмя = ОжидаемыйПуть, "1", "0")
		+ "|same=" + ?(РезультатПробы = ФайлПробы, "1", "0"));
	Возврат Неопределено;
КонецФункции

Асинх Процедура ПроверитьАргументыИнициализации()
	СтруктураПробы = Новый Структура("Поле", 1);
	СоответствиеПробы = Новый Соответствие;
	СоответствиеПробы.Вставить("ключ", 1);
	ДвоичныеДанныеПробы = ПолучитьДвоичныеДанныеИзСтроки("AB", КодировкаТекста.UTF8, Ложь);

	Ждать ПроверитьАргументИнициализации("init.structure", СтруктураПробы);
	Ждать ПроверитьАргументИнициализации("init.map", СоответствиеПробы);
	Ждать ПроверитьАргументИнициализации("init.file", Новый Файл("nested/name.txt"));
	Ждать ПроверитьАргументИнициализации("init.type", Тип("Строка"));
	Ждать ПроверитьАргументИнициализации("init.enum", КодировкаТекста.UTF8);
	Ждать ПроверитьАргументИнициализации("init.binary", ДвоичныеДанныеПробы);
	Ждать ПроверитьАргументИнициализации("init.buffer", Новый БуферДвоичныхДанных(2));
	Ждать ПроверитьАргументИнициализации("init.uuid", Новый УникальныйИдентификатор("01234567-89ab-cdef-0123-456789abcdef"));
	Ждать ПроверитьАргументИнициализации("init.type_description", Новый ОписаниеТипов("Строка"));
КонецПроцедуры

ПроверитьАргументыИнициализации();
