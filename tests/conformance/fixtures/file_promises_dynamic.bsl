// Оба измерителя вызывают файловые методы через Вычислить на клиенте 1С.
Асинх Процедура ПроверитьДинамическиеФайловыеОбещания()
	КореньДинамическихФайлов = ПолучитьИмяВременногоФайла(".dynamic-files");
	Попытка
		ПутьДинамическогоКаталога = Ждать Вычислить("СоздатьКаталогАсинх(КореньДинамическихФайлов + ""/new"")");
		Сообщить(?(ПутьДинамическогоКаталога = КореньДинамическихФайлов + "/new", "new", "bad"));
		ОбещаниеДинамическогоФайла = Вычислить("НайтиФайлыАсинх(КореньДинамическихФайлов)");
		НайденныеДинамическиеФайлы = Ждать ОбещаниеДинамическогоФайла;
		Сообщить(НайденныеДинамическиеФайлы.Количество());
		ДинамическийВременныйКаталог = Ждать Вычислить("КаталогВременныхФайловАсинх()");
		Сообщить(?(ДинамическийВременныйКаталог = КаталогВременныхФайлов(), "tempdir", "bad"));
		РезультатДинамическогоУдаления = Ждать Вычислить("УдалитьФайлыАсинх(КореньДинамическихФайлов + ""/new"")");
		Сообщить(?(РезультатДинамическогоУдаления = Неопределено, "undefined", "bad"));
		Сообщить(НайтиФайлы(КореньДинамическихФайлов + "/new").Количество());
		СтадияДинамическогоФайла = "call";
		Попытка
			ОбещаниеДинамическогоФайла = Вычислить("СоздатьКаталогАсинх(Неопределено)");
			СтадияДинамическогоФайла = "await";
			РезультатДинамическойОшибки = Ждать ОбещаниеДинамическогоФайла;
			Сообщить("bad");
		Исключение
			Сообщить(СтадияДинамическогоФайла);
		КонецПопытки;
	Исключение
		УдалитьФайлы(КореньДинамическихФайлов);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьФайлы(КореньДинамическихФайлов);
КонецПроцедуры

ПроверитьДинамическиеФайловыеОбещания();
