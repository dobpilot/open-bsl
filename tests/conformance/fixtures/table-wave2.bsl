// ТаблицаЗначений, волна 2: Найти, НайтиСтроки, Сортировать, Итог.
//
// БЕЗ .expected НАМЕРЕННО. Здесь два по-настоящему неизмеренных места —
// КОЛЛАЦИЯ (порядок строк при сортировке) и поведение Итог на нечисловой
// колонке; остальное печатается рядом, чтобы один прогон на платформе
// закрыл всё сразу.

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧГ=0; ЧРД=.");
КонецФункции

Т = Новый ТаблицаЗначений;
Т.Колонки.Добавить("имя");
Т.Колонки.Добавить("цена");
С1 = Т.Добавить(); С1.имя = "груша";  С1.цена = 30;
С2 = Т.Добавить(); С2.имя = "яблоко"; С2.цена = 10;
С3 = Т.Добавить(); С3.имя = "дыня";   С3.цена = 20;

// --- Найти ------------------------------------------------------------
Сообщить(Ч(Т.Найти("дыня").цена));
Сообщить(Т.Найти("нет такого") = Неопределено);   // Неопределено или ошибка
Сообщить(Т.Найти(20, "цена").имя);
Сообщить(Т.Найти(20, "имя") = Неопределено);      // не та колонка — не нашли

// --- НайтиСтроки ------------------------------------------------------
Сообщить(Ч(Т.НайтиСтроки(Новый Структура("имя", "дыня")).Количество()));
Сообщить(Ч(Т.НайтиСтроки(Новый Структура("имя,цена", "дыня", 20)).Количество()));
Сообщить(Ч(Т.НайтиСтроки(Новый Структура("имя", "нет")).Количество()));

// --- Итог -------------------------------------------------------------
Сообщить(Ч(Т.Итог("цена")));

// ЗАМЕР: Итог по нечисловой колонке — 0, ошибка или пропуск нечисловых
Т2 = Новый ТаблицаЗначений;
Т2.Колонки.Добавить("К");
Т2.Добавить().К = "текст";
Сообщить(Ч(Т2.Итог("К")));
Т2.Добавить().К = 5;
Сообщить(Ч(Т2.Итог("К")));                        // смешанная колонка

// --- Сортировать: направления ----------------------------------------
Т.Сортировать("цена");
Для Каждого С Из Т Цикл Сообщить(С.имя); КонецЦикла;
Т.Сортировать("цена Убыв");
Для Каждого С Из Т Цикл Сообщить(С.имя); КонецЦикла;

// ЗАМЕР ГЛАВНЫЙ: КОЛЛАЦИЯ. Как 1С реально упорядочивает строки —
// где стоит `ё` относительно `е`, что с регистром, как соотносятся
// кириллица, латиница и цифры. Наша реализация сравнивает по ВРег, затем
// по исходному виду (см. bsl_rt::table::collate) — это заведомо
// приближение, заменяемое в одной функции.
ТЗ = Новый ТаблицаЗначений;
ТЗ.Колонки.Добавить("С");
Для Каждого З Из СтрРазделить("яблоко,Яблоко,ёлка,Ель,zebra,Апельсин,10,2", ",") Цикл
	ТЗ.Добавить().С = З;
КонецЦикла;
ТЗ.Сортировать("С");
Для Каждого С Из ТЗ Цикл Сообщить(С.С); КонецЦикла;

// --- Устойчивость сортировки -----------------------------------------
Т3 = Новый ТаблицаЗначений;
Т3.Колонки.Добавить("группа");
Т3.Колонки.Добавить("ном");
А = Т3.Добавить(); А.группа = 1; А.ном = 1;
Б = Т3.Добавить(); Б.группа = 2; Б.ном = 2;
В = Т3.Добавить(); В.группа = 1; В.ном = 3;
Г = Т3.Добавить(); Г.группа = 2; Г.ном = 4;
Т3.Сортировать("группа");
Для Каждого С Из Т3 Цикл Сообщить(Ч(С.ном)); КонецЦикла;   // 1,3,2,4 при устойчивой
