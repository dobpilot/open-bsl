// XPath над деревом DOM: вычисление выражения, разыменователь пространств
// имён, четыре вида результата и обход узлов.
//
// Эталон снят с платформы 8.3.27:
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/fixtures/xdto-xpath.bsl
//
// Документ составной: два пространства имён (префиксное `urn:к` и
// умолчательное `urn:по`), атрибуты с префиксом и без, комментарий,
// инструкция обработки и смешанное содержимое. Печатается только то, что у
// платформы и у этой реализации совпадает дословно; ошибочные случаи —
// ФАКТОМ («ошибка»), а не текстом исключения.
//
// ЧЕГО ЗДЕСЬ НЕТ И ПОЧЕМУ — всё, что в `measure-xpath.bsl` помечено как
// сознательное расхождение: длина снимка (у платформы сломана), ось
// `namespace::` (здесь не поддержана), `ЧисловоеЗначение` от `NaN` и
// бесконечности (у платформы там мусор) и одинарный `/` перед
// нелатинским именем (дефект разборщика платформы). Обоснования — в шапке
// `bsl-rt/src/xpath.rs`, измеренные значения — в
// `tests/conformance/measure/measure-xpath.platform.txt`.

Перем Док;
Перем Э;
Перем Раз;

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

Функция ОписаниеУзла(У)
	Если У.ТипУзла = ТипУзлаDOM.Атрибут Тогда
		Возврат "@" + У.ИмяУзла + "=" + У.Значение;
	ИначеЕсли У.ЗначениеУзла = Неопределено Тогда
		Возврат У.ИмяУзла;
	Иначе
		Возврат У.ИмяУзла + "[" + Строка(У.ЗначениеУзла) + "]";
	КонецЕсли;
КонецФункции

// Узлы результата, перечисленные через пробел.
Функция Узлы(Выражение)
	Попытка
		Р = Док.ВычислитьВыражениеXPath(Выражение, Док, Раз);
	Исключение
		Возврат "ошибка";
	КонецПопытки;
	С = "";
	У = Р.ПолучитьСледующий();
	Пока У <> Неопределено Цикл
		С = С + ?(С = "", "", " ") + ОписаниеУзла(У);
		У = Р.ПолучитьСледующий();
	КонецЦикла;
	Возврат "[" + С + "]";
КонецФункции

// Скалярный результат: вид и значение.
Функция Скаляр(Выражение)
	Попытка
		Р = Док.ВычислитьВыражениеXPath(Выражение, Док, Раз);
	Исключение
		Возврат "ошибка";
	КонецПопытки;
	Попытка
		Если Р.ТипРезультата = ТипРезультатаDOMXPath.Число Тогда
			Возврат "число " + Строка(Р.ЧисловоеЗначение);
		ИначеЕсли Р.ТипРезультата = ТипРезультатаDOMXPath.Строка Тогда
			Возврат "строка [" + Р.СтроковоеЗначение + "]";
		ИначеЕсли Р.ТипРезультата = ТипРезультатаDOMXPath.Булево Тогда
			Возврат "булево " + Строка(Р.БулевоЗначение);
		Иначе
			Возврат "узловой " + Строка(Р.ТипРезультата);
		КонецЕсли;
	Исключение
		Возврат "ошибка чтения";
	КонецПопытки;
КонецФункции

Источник = "<к:каталог xmlns:к=""urn:к"" xmlns=""urn:по"" версия=""3"">"
	+ "<!--шапка-->"
	+ "<к:товар код=""1"" вес=""2""><имя>яблоко</имя><цена>10</цена></к:товар>"
	+ "<к:товар код=""2""><имя>груша</имя><цена>20</цена></к:товар>"
	+ "<прочее к:метка=""м"">хвост</прочее>"
	+ "<?пи данные?></к:каталог>";

Построитель = Новый ПостроительDOM;
Чтение = Новый ЧтениеXML;
Чтение.УстановитьСтроку(Источник);
Док = Построитель.Прочитать(Чтение);
Э = Док.ЭлементДокумента;
Раз = Док.СоздатьРазыменовательПИ(Э);

П("разыменователь", Строка(Раз));
П("тип разыменователя", Строка(ТипЗнч(Раз)));
П("к", Строка(Раз.НайтиURIПространстваИмен("к")));
П("умолчание", Строка(Раз.НайтиURIПространстваИмен("xmlns")));
П("неизвестный префикс", Строка(Раз.НайтиURIПространстваИмен("нет")));
П("предопределённый xml", Строка(Раз.НайтиURIПространстваИмен("xml")));

// --- выборка узлов ---------------------------------------------------------

П("товары", Узлы("//к:товар"));
П("товары с кодами", Узлы("//к:товар/@код"));
П("все элементы", Узлы("//*"));
П("имя без префикса", Узлы("//цена"));
П("по локальному имени", Узлы("//*[local-name()='цена']"));
П("атрибуты корня", Узлы("/*/@*"));
П("атрибут с префиксом", Узлы("//*[local-name()='прочее']/@к:метка"));
П("текстовые узлы", Узлы("//*[local-name()='имя']/text()"));
П("комментарий", Узлы("//comment()"));
П("инструкция обработки", Узлы("//processing-instruction()"));
П("предок цены", Узлы("//*[local-name()='цена']/ancestor::*"));
П("соседи имени", Узлы("//*[local-name()='имя']/following-sibling::*"));
П("объединение", Узлы("//*[local-name()='имя'] | //*[local-name()='цена']"));
П("родитель атрибута", Узлы("//к:товар/@код/.."));
П("пусто", Узлы("//неттакого"));

// --- предикаты ---------------------------------------------------------------

П("первый товар", Узлы("//к:товар[1]/@код"));
П("последний товар", Узлы("//к:товар[last()]/@код"));
П("по позиции", Узлы("//к:товар[position()=2]/@код"));
П("по атрибуту", Узлы("//к:товар[@код='2']/@вес"));
П("по наличию атрибута", Узлы("//к:товар[@вес]/@код"));
П("по отсутствию атрибута", Узлы("//к:товар[not(@вес)]/@код"));
П("по вложенному значению", Узлы("//к:товар[*[local-name()='цена']='10']/@код"));
П("нулевая позиция", Узлы("//к:товар[0]"));
П("в скобках", Узлы("(//к:товар)[last()]/@код"));
П("обратная ось", Узлы("//к:товар[2]/preceding::*[1]"));

// --- скалярные результаты ------------------------------------------------------

П("количество элементов", Скаляр("count(//*)"));
П("количество товаров", Скаляр("count(//к:товар)"));
П("сумма цен", Скаляр("sum(//*[local-name()='цена'])"));
П("строка первого кода", Скаляр("string(//к:товар/@код)"));
П("склейка документа", Скаляр("string(/)"));
П("локальное имя", Скаляр("local-name(//к:товар)"));
П("полное имя", Скаляр("name(//к:товар)"));
П("пространство имён", Скаляр("namespace-uri(//к:товар)"));
П("пространство по умолчанию", Скаляр("namespace-uri(//*[local-name()='цена'])"));
П("сравнение", Скаляр("count(//к:товар) > 1"));
П("набор со строкой", Скаляр("//*[local-name()='цена'] = '10'"));
П("логика", Скаляр("count(//*) > 3 and count(//нет) = 0"));
П("арифметика", Скаляр("(2 + 3) * 4 - 7 div 2"));
П("остаток", Скаляр("-7 mod 2"));
П("округление вверх на середине", Скаляр("round(-2.5)"));
П("строки", Скаляр("concat(substring-before('а-б', '-'), '/', normalize-space('  в   г '))"));
П("дробь строкой", Скаляр("string(1 div 3)"));
П("длина дроби", Скаляр("string-length(string(1 div 3))"));
П("разделитель дроби", Скаляр("contains(string(1 div 3), ',')"));

// --- виды результата -------------------------------------------------------------

П("вид по умолчанию", Скаляр("//к:товар"));
Снимок = Док.ВычислитьВыражениеXPath("//к:товар", Док, Раз, ТипРезультатаDOMXPath.УпорядоченныйСнимокУзлов);
П("вид снимка", Строка(Снимок.ТипРезультата));
П("узел снимка 0", ОписаниеУзла(Снимок.ЭлементСнимка(0)));
П("узел снимка 1", ОписаниеУзла(Снимок.ЭлементСнимка(1)));
П("узел снимка 2", Строка(Снимок.ЭлементСнимка(2)));
Первый = Док.ВычислитьВыражениеXPath("//к:товар", Док, Раз, ТипРезультатаDOMXPath.ПервыйУпорядоченныйУзел);
П("вид первого узла", Строка(Первый.ТипРезультата));
П("первый узел", ОписаниеУзла(Первый.SingleNodeValue));
П("пустой первый узел", Строка(Док.ВычислитьВыражениеXPath("//нет", Док, Раз, ТипРезультатаDOMXPath.ПервыйУпорядоченныйУзел).SingleNodeValue));
П("состояние итератора", Строка(Док.ВычислитьВыражениеXPath("//*", Док, Раз).НеверноеСостояниеИтератора));

// --- отдельное выражение и тождество узлов ------------------------------------------

Выражение = Док.СоздатьВыражениеXPath("count(//*)", Раз);
П("тип выражения", Строка(ТипЗнч(Выражение)));
П("вычисление выражения", Строка(Выражение.Вычислить(Док).ЧисловоеЗначение));
П("повторное вычисление", Строка(Выражение.Вычислить(Э.ДочерниеУзлы[1]).ЧисловоеЗначение));
П("узел тот же", Строка(Э.ДочерниеУзлы[1] = Док.ВычислитьВыражениеXPath("//к:товар", Док, Раз).ПолучитьСледующий()));
П("документ тот же", Строка(Док = Док.ВычислитьВыражениеXPath("/", Док, Раз).ПолучитьСледующий()));

// --- контекстный узел ------------------------------------------------------------------

Товар = Э.ДочерниеУзлы[1];
П("от элемента", Строка(Док.ВычислитьВыражениеXPath("name(.)", Товар, Раз).СтроковоеЗначение));
П("от элемента родитель", Строка(Док.ВычислитьВыражениеXPath("name(..)", Товар, Раз).СтроковоеЗначение));
П("от атрибута", Строка(Док.ВычислитьВыражениеXPath("string(.)", Э.Атрибуты[2], Раз).СтроковоеЗначение));
П("от комментария", Строка(Док.ВычислитьВыражениеXPath("string(.)", Э.ПервыйДочерний, Раз).СтроковоеЗначение));
П("от текста", Строка(Док.ВычислитьВыражениеXPath("name(..)", Э.ДочерниеУзлы[3].ПервыйДочерний, Раз).СтроковоеЗначение));

// --- итератор — снимок ---------------------------------------------------------------------

Обход = Док.ВычислитьВыражениеXPath("//к:товар", Док, Раз);
Первый2 = Обход.ПолучитьСледующий();
Новый2 = Док.СоздатьЭлемент("urn:к", "к:товар");
Э.ДобавитьДочерний(Новый2);
П("итератор до мутации", ОписаниеУзла(Первый2));
П("итератор после мутации", ОписаниеУзла(Обход.ПолучитьСледующий()));
П("итератор исчерпан", Строка(Обход.ПолучитьСледующий()));
П("свежая выборка видит новый узел", Скаляр("count(//к:товар)"));

// --- ошибки ------------------------------------------------------------------------------

П("негодный синтаксис", Узлы("//[[["));
П("неизвестная функция", Узлы("нетфункции()"));
П("несуществующая ось", Узлы("нетоси::*"));
П("переменная", Узлы("$х"));
П("неизвестный префикс", Узлы("//нет:товар"));
П("пустое выражение", Узлы(""));
П("позиция вне предиката", Узлы("position()"));
П("объединение с числом", Узлы("//к:товар | 5"));

Попытка
	Ошибка = Док.СоздатьВыражениеXPath("//[[[", Раз);
	П("негодное при создании", "принято");
Исключение
	П("негодное при создании", "ошибка");
КонецПопытки;

Попытка
	Позднее = Док.СоздатьВыражениеXPath("//нет:а", Раз);
	П("неизвестный префикс при создании", "принято");
Исключение
	П("неизвестный префикс при создании", "ошибка");
КонецПопытки;

Попытка
	Р = Позднее.Вычислить(Док);
	П("неизвестный префикс при вычислении", "принято");
Исключение
	П("неизвестный префикс при вычислении", "ошибка");
КонецПопытки;
