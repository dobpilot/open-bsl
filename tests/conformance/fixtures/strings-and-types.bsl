// Строковые функции, ЗначениеЗаполнено и ТипЗнч/Тип.
//
// БЕЗ .expected НАМЕРЕННО: эталон снимается прогоном ЭТОГО ЖЕ файла на
// реальной 1С, а не выводом нашей реализации (раннер такие фикстуры
// пропускает — см. tests/conformance.rs). Числовые результаты печатаются в
// канонической форме `Формат(x, "ЧГ=0; ЧРД=.")`, чтобы расхождение в
// семантике нельзя было спутать с расхождением в локали форматирования.

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧГ=0; ЧРД=.");
КонецФункции

// --- Индексация: код-юниты UTF-16, с единицы -------------------------
Сообщить(Ч(СтрНайти("абвгд", "вг")));          // 3 при индексации с единицы
Сообщить(Ч(СтрНайти("абвгд", "яя")));          // 0 — не найдено
Сообщить(Ч(СтрНайти("абвгд", "")));            // пустая подстрока: 0 или 1?
Сообщить(Сред("абвгд", СтрНайти("абвгд", "вг"), 2));

// --- Замена, разбиение, склейка --------------------------------------
Сообщить(СтрЗаменить("а-б-в", "-", "+"));
Сообщить(СтрЗаменить("ааа", "аа", "б"));       // перекрытие: "ба" или "бб"?
Сообщить(Ч(СтрРазделить("а,,б", ",").Количество()));  // пустые куски входят?
Сообщить(СтрСоединить(СтрРазделить("а,,б", ","), ","));
Сообщить(Ч(СтрРазделить("абв", "").Количество()));    // пустой разделитель

// --- Обрезка, строки текста ------------------------------------------
Сообщить("[" + СокрЛ("  а  ") + "]");
Сообщить("[" + СокрП("  а  ") + "]");
ПС = Символ(10);
Сообщить(Ч(СтрЧислоСтрок("а" + ПС + "б" + ПС + "в")));
Сообщить(Ч(СтрЧислоСтрок("")));                // пустой текст: 0 или 1 строка?
Сообщить(СтрПолучитьСтроку("а" + ПС + "б", 2));
Сообщить("[" + СтрПолучитьСтроку("а", 9) + "]");  // вне диапазона: пусто или ошибка?

// --- Шаблон -----------------------------------------------------------
Сообщить(СтрШаблон("%1 и %2", "раз", "два"));
Сообщить(СтрШаблон("100%%"));                  // экранирование процента
Сообщить(СтрШаблон("[%2]", "раз"));            // значения нет: пусто или ошибка?
Сообщить(СтрШаблон("№%1", 7));                 // число: как приводится

// --- Символ / КодСимвола ---------------------------------------------
Сообщить(Ч(КодСимвола(Символ(160))));          // 160 (NBSP, уже измерено)
Сообщить(Ч(КодСимвола("абв")));                // позиция по умолчанию — 1?
Сообщить(Ч(КодСимвола("абв", 2)));
Сообщить(Ч(СтрДлина(Символ(128512))));         // вне BMP: 1 или 2 код-юнита?
Сообщить(Ч(КодСимвола(Символ(128512))));       // 128512 или 55357 (суррогат)?

// --- ЗначениеЗаполнено ------------------------------------------------
Сообщить(ЗначениеЗаполнено(Неопределено));
Сообщить(ЗначениеЗаполнено(NULL));
Сообщить(ЗначениеЗаполнено(""));
Сообщить(ЗначениеЗаполнено(0));
Сообщить(ЗначениеЗаполнено("   "));            // СПОРНО: пробелы — пусто или нет
Сообщить(ЗначениеЗаполнено(Ложь));             // СПОРНО: булево всегда заполнено?
Сообщить(ЗначениеЗаполнено(Новый Массив));     // СПОРНО
Сообщить(ЗначениеЗаполнено(Новый Структура));  // СПОРНО
Сообщить(ЗначениеЗаполнено(Новый Соответствие));  // СПОРНО

// --- ТипЗнч / Тип -----------------------------------------------------
Сообщить(Строка(ТипЗнч(1)));
Сообщить(Строка(ТипЗнч("а")));
Сообщить(Строка(ТипЗнч(Истина)));
Сообщить(Строка(ТипЗнч(Неопределено)));
Сообщить(Строка(ТипЗнч(Новый Массив)));
Сообщить(Строка(ТипЗнч(Новый Соответствие)));
Сообщить(Строка(ТипЗнч(ТипЗнч(1))));           // тип типа
Сообщить(ТипЗнч(Новый Массив) = Тип("Массив"));
Сообщить(ТипЗнч(1) = ТипЗнч(2));
