// Контракт побитовых и «числовых» глобальных функций: `ПобитовоеИ`/`Или`/
// `Не`/`ИНе`/`ИсключительноеИли`, `ПобитовыйСдвигВлево`/`Вправо`,
// `ПроверитьБит`, `ПроверитьПоБитовойМаске`, `УстановитьБит`,
// `ЧислоИзШестнадцатеричнойСтроки`, `ЧислоИзДвоичнойСтроки`.
//
// Эталон снимается ТОЛЬКО платформой:
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/fixtures/binary-bitops.bsl
//   diff tests/conformance/fixtures/binary-bitops.expected \
//        tests/conformance/fixtures/binary-bitops.platform.txt
//
// ЧТО ВЫЯСНИЛА РАЗВЕДКА, прежде чем эта фикстура была написана (четыре
// прогона отдельными пробниками, чтобы не жечь эталон):
//
//   * Весь краевой класс здесь ЛОВИТСЯ `Попыткой` — ни один негодный
//     операнд сеанс не уносит, в отличие от записи в байт буфера. Поэтому
//     краевые пробы стоят прямо в фикстуре, а не вынесены в комментарий.
//   * `Вычислить` в модуле формы НЕ ВИДИТ локальных переменных вызывающей
//     процедуры («Переменная не определена»). Отсюда правило секции
//     английских написаний: внутри `Вычислить` — только литералы.
//   * Текст ошибки платформы и наш не совпадают и совпасть не могут,
//     поэтому всякий отказ печатается одним словом «ошибка».
//
// Ошибки не угаданы, а измерены: операнд побитовых — целое 0..4294967295
// («Недопустимое значение аргумента» на -1, на 1.5 и на 2^32; «Несоответствие
// типов» на строке), номер бита — 0..31, величина сдвига — 0..31 (32 и 33
// именно ОШИБКА, а не нулевой результат).
//
// Два правила письма, каждое стоит впустую потраченного прогона: метод
// нельзя звать на результате вызова (нужна промежуточная переменная), а
// всякая проба, способная бросить, обязана быть в `Попытка`.

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

// Обёртки: имена `И`, `Или`, `Не` — КЛЮЧЕВЫЕ СЛОВА, функцию так не назвать,
// поэтому все с приставкой.

Функция БитИ(А, Б)
	Попытка
		Возврат Ч(ПобитовоеИ(А, Б));
	Исключение
		Возврат "ошибка";
	КонецПопытки;
КонецФункции

Функция БитИли(А, Б)
	Попытка
		Возврат Ч(ПобитовоеИли(А, Б));
	Исключение
		Возврат "ошибка";
	КонецПопытки;
КонецФункции

Функция БитНе(А)
	Попытка
		Возврат Ч(ПобитовоеНе(А));
	Исключение
		Возврат "ошибка";
	КонецПопытки;
КонецФункции

Функция БитИНе(А, Б)
	Попытка
		Возврат Ч(ПобитовоеИНе(А, Б));
	Исключение
		Возврат "ошибка";
	КонецПопытки;
КонецФункции

Функция БитИск(А, Б)
	Попытка
		Возврат Ч(ПобитовоеИсключительноеИли(А, Б));
	Исключение
		Возврат "ошибка";
	КонецПопытки;
КонецФункции

Функция СдвигВлево(А, С)
	Попытка
		Возврат Ч(ПобитовыйСдвигВлево(А, С));
	Исключение
		Возврат "ошибка";
	КонецПопытки;
КонецФункции

Функция СдвигВправо(А, С)
	Попытка
		Возврат Ч(ПобитовыйСдвигВправо(А, С));
	Исключение
		Возврат "ошибка";
	КонецПопытки;
КонецФункции

Функция Бит(А, Н)
	Попытка
		Возврат Строка(ПроверитьБит(А, Н));
	Исключение
		Возврат "ошибка";
	КонецПопытки;
КонецФункции

Функция Маска(А, М)
	Попытка
		Возврат Строка(ПроверитьПоБитовойМаске(А, М));
	Исключение
		Возврат "ошибка";
	КонецПопытки;
КонецФункции

Функция Уст(А, Н, З)
	Попытка
		Возврат Ч(УстановитьБит(А, Н, З));
	Исключение
		Возврат "ошибка";
	КонецПопытки;
КонецФункции

Функция Шестн(С)
	Попытка
		Возврат Ч(ЧислоИзШестнадцатеричнойСтроки(С));
	Исключение
		Возврат "ошибка";
	КонецПопытки;
КонецФункции

Функция Двоич(С)
	Попытка
		Возврат Ч(ЧислоИзДвоичнойСтроки(С));
	Исключение
		Возврат "ошибка";
	КонецПопытки;
КонецФункции

// Проба ИМЕНИ: только литералы внутри — `Вычислить` на платформе не видит
// локальных переменных.
Функция Проба(Выражение)
	Попытка
		Р = Вычислить(Выражение);
	Исключение
		Возврат "нет";
	КонецПопытки;
	Если ТипЗнч(Р) = Тип("Число") Тогда
		Возврат "принято " + Ч(Р);
	КонецЕсли;
	Возврат "принято " + Строка(Р);
КонецФункции

// --- таблица значений пяти побитовых над четырьмя опорными операндами ------

Опорные = Новый Массив;
Опорные.Добавить(0);
Опорные.Добавить(1);
Опорные.Добавить(2147483648);
Опорные.Добавить(4294967295);

Для Каждого А Из Опорные Цикл
	Для Каждого Б Из Опорные Цикл
		Пара = Ч(А) + " " + Ч(Б);
		П("И " + Пара, БитИ(А, Б));
		П("ИЛИ " + Пара, БитИли(А, Б));
		П("ИНЕ " + Пара, БитИНе(А, Б));
		П("ИСКЛ " + Пара, БитИск(А, Б));
	КонецЦикла;
КонецЦикла;

Для Каждого А Из Опорные Цикл
	П("НЕ " + Ч(А), БитНе(А));
КонецЦикла;

// --- сдвиги ----------------------------------------------------------------

Сдвиги = Новый Массив;
Сдвиги.Добавить(0);
Сдвиги.Добавить(1);
Сдвиги.Добавить(31);
Сдвиги.Добавить(32);
Сдвиги.Добавить(33);

Для Каждого С Из Сдвиги Цикл
	П("ВЛЕВО 1 " + Ч(С), СдвигВлево(1, С));
	П("ВПРАВО 2147483648 " + Ч(С), СдвигВправо(2147483648, С));
	П("ВЛЕВО 4294967295 " + Ч(С), СдвигВлево(4294967295, С));
	П("ВПРАВО 4294967295 " + Ч(С), СдвигВправо(4294967295, С));
КонецЦикла;

// Старшие биты, вытесненные влево, теряются — не переполнение.
П("влево 2147483648 на 1", СдвигВлево(2147483648, 1));
П("влево 3 на 31", СдвигВлево(3, 31));

// --- ПроверитьБит ----------------------------------------------------------

П("бит 0 у 1", Бит(1, 0));
П("бит 0 у 2", Бит(2, 0));
П("бит 31 у 2147483648", Бит(2147483648, 31));
П("бит 31 у 2147483647", Бит(2147483647, 31));
П("бит 31 у 4294967295", Бит(4294967295, 31));
П("бит 0 у 0", Бит(0, 0));
П("бит 32 у 1", Бит(1, 32));
П("бит -1 у 1", Бит(1, -1));
П("бит 1.5 у 1", Бит(1, 1.5));

// --- ПроверитьПоБитовойМаске: совпадает целиком, частично, никак ----------

П("маска 12 и 12", Маска(12, 12));
П("маска 12 и 8", Маска(12, 8));
П("маска 12 и 4", Маска(12, 4));
П("маска 12 и 5", Маска(12, 5));
П("маска 12 и 3", Маска(12, 3));
П("маска 12 и 0", Маска(12, 0));
П("маска 0 и 0", Маска(0, 0));
П("маска 0 и 1", Маска(0, 1));
П("маска 4294967295 и 2147483648", Маска(4294967295, 2147483648));

// --- УстановитьБит ---------------------------------------------------------

П("уст бит 0 в Истина", Уст(0, 0, Истина));
П("уст бит 0 в Ложь", Уст(1, 0, Ложь));
П("уст бит 31 в Истина", Уст(0, 31, Истина));
П("уст бит 0 в Ложь у 4294967295", Уст(4294967295, 0, Ложь));
П("уст бит 0 в Истина у 1", Уст(1, 0, Истина));
П("уст бит 32", Уст(0, 32, Истина));
П("уст значение числом", Уст(0, 0, 1));
П("уст значение строкой", Уст(0, 0, "Истина"));

// Третий аргумент ОБЯЗАТЕЛЕН — вызов с двумя не компилируется, поэтому
// проверяется только через `Вычислить`.
П("уст без третьего", Проба("УстановитьБит(0, 0)"));

// --- разбор шестнадцатеричной строки --------------------------------------

П("шестн 0x0", Шестн("0x0"));
П("шестн 0xFF", Шестн("0xFF"));
П("шестн 0xff", Шестн("0xff"));
П("шестн 0XFF", Шестн("0XFF"));
П("шестн 0xFFFFFFFF", Шестн("0xFFFFFFFF"));
П("шестн 0x00000001", Шестн("0x00000001"));
П("шестн FF", Шестн("FF"));
П("шестн 0x", Шестн("0x"));
П("шестн пусто", Шестн(""));
П("шестн с пробелами", Шестн(" 0xFF "));
П("шестн 0xGG", Шестн("0xGG"));
П("шестн -0x1", Шестн("-0x1"));
П("шестн из числа", Проба("ЧислоИзШестнадцатеричнойСтроки(255)"));

// Шире 32 бит функция принимает — это ИЗМЕРЕНО, а не выведено.
П("шестн 0x100000000", Шестн("0x100000000"));
П("шестн 0xFFFFFFFFFF", Шестн("0xFFFFFFFFFF"));
П("шестн 16 F", Шестн("0xFFFFFFFFFFFFFFFF"));
П("шестн 17 знаков", Шестн("0x1FFFFFFFFFFFFFFFF"));

// Где кончается точность платформы — вопрос замера, а не рассуждения:
// 24, 31 и 32 знака F дают 29, 38 и 39 десятичных цифр.
П("шестн 24 F", Шестн("0xFFFFFFFFFFFFFFFFFFFFFFFF"));
П("шестн 31 F", Шестн("0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF"));
П("шестн 32 F", Шестн("0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF"));
П("шестн 40 F", Шестн("0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF"));

// --- разбор двоичной строки ------------------------------------------------

П("двоич 0b0", Двоич("0b0"));
П("двоич 0b1", Двоич("0b1"));
П("двоич 0b1010", Двоич("0b1010"));
П("двоич 0B1010", Двоич("0B1010"));
П("двоич 1010", Двоич("1010"));
П("двоич 0b0000000000001010", Двоич("0b0000000000001010"));
П("двоич 0b", Двоич("0b"));
П("двоич пусто", Двоич(""));
П("двоич 0b2", Двоич("0b2"));
П("двоич с пробелами", Двоич(" 0b1010 "));
П("двоич из числа", Проба("ЧислоИзДвоичнойСтроки(1010)"));
П("двоич 32 единицы", Двоич("0b11111111111111111111111111111111"));
П("двоич 33 единицы", Двоич("0b111111111111111111111111111111111"));
П("двоич 64 единицы", Двоич("0b1111111111111111111111111111111111111111111111111111111111111111"));

// --- негодные операнды побитовых -------------------------------------------

П("И с 2^32", БитИ(4294967296, 1));
П("И с -1", БитИ(-1, 1));
П("И с 1.5", БитИ(1.5, 1));
П("И со строкой", Проба("ПобитовоеИ(""1"", 1)"));
П("И с Неопределено", Проба("ПобитовоеИ(Неопределено, 1)"));
П("НЕ с -1", БитНе(-1));
П("НЕ с 2^32", БитНе(4294967296));
П("ИЛИ с 2^32 вторым", БитИли(1, 4294967296));
П("ИСКЛ с дробным вторым", БитИск(1, 0.5));
П("ИНЕ с -1 вторым", БитИНе(1, -1));
П("маска с -1", Маска(-1, 1));
П("уст с -1", Уст(-1, 0, Истина));
П("влево с -1 сдвигом", СдвигВлево(1, -1));
П("влево с дробным операндом", СдвигВлево(1.5, 1));
П("вправо с -1 сдвигом", СдвигВправо(1, -1));

// --- английские написания: приняты ровно те, что подтвердил замер ----------

П("BitwiseAnd", Проба("BitwiseAnd(12, 10)"));
П("BitwiseOr", Проба("BitwiseOr(12, 10)"));
П("BitwiseNot", Проба("BitwiseNot(0)"));
П("BitwiseAndNot", Проба("BitwiseAndNot(12, 10)"));
П("BitwiseXor", Проба("BitwiseXor(12, 10)"));
П("BitwiseShiftLeft", Проба("BitwiseShiftLeft(1, 1)"));
П("BitwiseShiftRight", Проба("BitwiseShiftRight(2, 1)"));
П("CheckBit", Проба("CheckBit(1, 0)"));
П("CheckByBitMask", Проба("CheckByBitMask(12, 8)"));
П("SetBit", Проба("SetBit(0, 0, Истина)"));
П("NumberFromHexString", Проба("NumberFromHexString(""0xFF"")"));
П("NumberFromBinaryString", Проба("NumberFromBinaryString(""0b1010"")"));

// Отвергнутые кандидаты: перечислены затем же, зачем принятые, — чтобы имя,
// которого у платформы нет, не завелось у нас по недосмотру.
П("BitwiseInvert", Проба("BitwiseInvert(0)"));
П("BitwiseExclusiveOr", Проба("BitwiseExclusiveOr(12, 10)"));
П("BitShiftLeft", Проба("BitShiftLeft(1, 1)"));
П("BitShiftRight", Проба("BitShiftRight(2, 1)"));
П("BitTest", Проба("BitTest(1, 0)"));
П("TestBit", Проба("TestBit(1, 0)"));
П("CheckBitMask", Проба("CheckBitMask(12, 8)"));
П("TestByBitMask", Проба("TestByBitMask(12, 8)"));
П("BitMaskTest", Проба("BitMaskTest(12, 8)"));
П("NumberFromHexStr", Проба("NumberFromHexStr(""0xFF"")"));
П("NumberFromBinString", Проба("NumberFromBinString(""0b1010"")"));
П("УстановитьЗначениеБита", Проба("УстановитьЗначениеБита(0, 0, Истина)"));
П("ПолучитьЧислоИзДвоичнойСтроки", Проба("ПолучитьЧислоИзДвоичнойСтроки(""0b1010"")"));
П("ЧислоИзШестнадцатиричнойСтроки", Проба("ЧислоИзШестнадцатиричнойСтроки(""0xFF"")"));

// --- тип результата ---------------------------------------------------------

Р = ПобитовоеИ(12, 10);
П("тип результата побитовой", Строка(ТипЗнч(Р)));
Б = ПроверитьБит(1, 0);
П("тип результата ПроверитьБит", Строка(ТипЗнч(Б)));
Ш = ЧислоИзШестнадцатеричнойСтроки("0xFF");
П("тип результата разбора", Строка(ТипЗнч(Ш)));
