// Контракт четвёрки преобразований строка<->байты:
// `ПолучитьДвоичныеДанныеИзСтроки`, `ПолучитьБуферДвоичныхДанныхИзСтроки` и
// обратные к ним `ПолучитьСтрокуИзДвоичныхДанных`,
// `ПолучитьСтрокуИзБуфераДвоичныхДанных`.
//
// Эталон снимается ТОЛЬКО платформой:
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/fixtures/binary-strings.bsl
//   diff tests/conformance/fixtures/binary-strings.expected \
//        tests/conformance/fixtures/binary-strings.platform.txt
//
// КАК ЗДЕСЬ ПЕЧАТАЮТСЯ ЗНАЧЕНИЯ. `ДвоичныеДанные` платформа сама печатает
// шестнадцатеричным дампом, поэтому они идут через `Строка`. Буфер —
// побайтовым дампом-помощником, как в `binary-buffer.bsl`. А вот
// РАСКОДИРОВАННАЯ строка печатается КОДАМИ СИМВОЛОВ, а не собой: ровно тем
// и различаются «BOM снят» и «BOM оставлен ведущим U+FEFF», и ровно это
// глазом в выводе не видно.
//
// Правило письма, стоящее впустую потраченного прогона: метод нельзя звать
// на результате вызова (нужна промежуточная переменная), а всякая проба,
// способная бросить, обязана быть в `Попытка`. Вложенные вызовы ФУНКЦИЙ
// при этом законны — ограничение только на методы.
//
// Внутри `Вычислить` — только литералы: в модуле формы `Вычислить` не видит
// локальных переменных вызывающей процедуры (измерено).

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

// Коды символов: единственный способ увидеть ведущий U+FEFF и U+FFFD.
Функция Коды(С)
	Р = "";
	Для н = 1 По СтрДлина(С) Цикл
		Р = Р + Ч(КодСимвола(С, н)) + " ";
	КонецЦикла;
	Возврат "[" + СокрЛП(Р) + "]";
КонецФункции

Функция Дамп(Б)
	С = "";
	Для н = 0 По Б.Размер - 1 Цикл
		С = С + Ч(Б[н]) + " ";
	КонецЦикла;
	Возврат "[" + СокрЛП(С) + "]";
КонецФункции

Функция ВБайты(С, Кодировка, СBOM)
	Попытка
		Возврат Строка(ПолучитьДвоичныеДанныеИзСтроки(С, Кодировка, СBOM));
	Исключение
		Возврат "ошибка";
	КонецПопытки;
КонецФункции

Функция ВБуфер(С, Кодировка, СBOM)
	Попытка
		Б = ПолучитьБуферДвоичныхДанныхИзСтроки(С, Кодировка, СBOM);
	Исключение
		Возврат "ошибка";
	КонецПопытки;
	Возврат Дамп(Б);
КонецФункции

Функция ИзБайтов(Д, Кодировка)
	Попытка
		С = ПолучитьСтрокуИзДвоичныхДанных(Д, Кодировка);
	Исключение
		Возврат "ошибка";
	КонецПопытки;
	Возврат Ч(СтрДлина(С)) + " " + Коды(С);
КонецФункции

Функция ИзБуфера(Б, Кодировка)
	Попытка
		С = ПолучитьСтрокуИзБуфераДвоичныхДанных(Б, Кодировка);
	Исключение
		Возврат "ошибка";
	КонецПопытки;
	Возврат Ч(СтрДлина(С)) + " " + Коды(С);
КонецФункции

Функция Проба(Выражение)
	Попытка
		Р = Вычислить(Выражение);
	Исключение
		Возврат "нет";
	КонецПопытки;
	Если ТипЗнч(Р) = Тип("Число") Тогда
		Возврат "принято " + Ч(Р);
	КонецЕсли;
	Возврат "принято " + Строка(Р);
КонецФункции

Кир = "Аб";
Аск = "A";

// --- прямое преобразование: кодировка членом перечисления -----------------

П("умолчание кириллица", Строка(ПолучитьДвоичныеДанныеИзСтроки(Кир)));
П("умолчание ASCII", Строка(ПолучитьДвоичныеДанныеИзСтроки(Аск)));
П("умолчание пустая", Строка(ПолучитьДвоичныеДанныеИзСтроки("")));

П("UTF8 без BOM", ВБайты(Кир, КодировкаТекста.UTF8, Ложь));
П("UTF8 с BOM", ВБайты(Кир, КодировкаТекста.UTF8, Истина));
П("UTF16 без BOM", ВБайты(Кир, КодировкаТекста.UTF16, Ложь));
П("UTF16 с BOM", ВБайты(Кир, КодировкаТекста.UTF16, Истина));
П("ANSI без BOM", ВБайты(Кир, КодировкаТекста.ANSI, Ложь));
П("ANSI с BOM", ВБайты(Кир, КодировкаТекста.ANSI, Истина));
П("OEM без BOM", ВБайты(Кир, КодировкаТекста.OEM, Ложь));

П("UTF8 ASCII без BOM", ВБайты(Аск, КодировкаТекста.UTF8, Ложь));
П("UTF8 ASCII с BOM", ВБайты(Аск, КодировкаТекста.UTF8, Истина));
П("UTF16 ASCII с BOM", ВБайты(Аск, КодировкаТекста.UTF16, Истина));

// Третий аргумент опущен — умолчание ДобавлятьBOM выясняет замер.
П("UTF8 без третьего", Проба("ПолучитьДвоичныеДанныеИзСтроки(""Аб"", КодировкаТекста.UTF8)"));
П("UTF16 без третьего", Проба("ПолучитьДвоичныеДанныеИзСтроки(""Аб"", КодировкаТекста.UTF16)"));
П("ANSI без третьего", Проба("ПолучитьДвоичныеДанныеИзСтроки(""Аб"", КодировкаТекста.ANSI)"));

// --- та же кодировка, заданная СТРОКОЙ -------------------------------------

П("строка UTF-8", ВБайты(Кир, "UTF-8", Ложь));
П("строка UTF-8 с BOM", ВБайты(Кир, "UTF-8", Истина));
П("строка UTF-16", ВБайты(Кир, "UTF-16", Ложь));
П("строка UTF-16 с BOM", ВБайты(Кир, "UTF-16", Истина));
П("строка UTF-16LE", ВБайты(Кир, "UTF-16LE", Ложь));
П("строка UTF-16BE", ВБайты(Кир, "UTF-16BE", Ложь));
П("строка windows-1251", ВБайты(Кир, "windows-1251", Ложь));
П("строка cp866", ВБайты(Кир, "cp866", Ложь));
П("строка KOI8-R", ВБайты(Кир, "KOI8-R", Ложь));
П("строка неизвестная", ВБайты(Кир, "нет-такой-кодировки", Ложь));

// --- прямое преобразование в БУФЕР -----------------------------------------

П("буфер умолчание", Дамп(ПолучитьБуферДвоичныхДанныхИзСтроки(Кир)));
П("буфер UTF8 без BOM", ВБуфер(Кир, КодировкаТекста.UTF8, Ложь));
П("буфер UTF8 с BOM", ВБуфер(Кир, КодировкаТекста.UTF8, Истина));
П("буфер UTF16 с BOM", ВБуфер(Кир, КодировкаТекста.UTF16, Истина));
П("буфер UTF16 без BOM", ВБуфер(Кир, КодировкаТекста.UTF16, Ложь));
П("буфер ANSI", ВБуфер(Кир, КодировкаТекста.ANSI, Ложь));
П("буфер строкой", ВБуфер(Кир, "windows-1251", Ложь));
П("буфер пустая строка", ВБуфер("", КодировкаТекста.UTF8, Ложь));
П("буфер порядок байтов", Строка(ПолучитьБуферДвоичныхДанныхИзСтроки(Кир).ПорядокБайтов));

// --- обратное преобразование из ДвоичныеДанные -----------------------------

БезBOM = ПолучитьДвоичныеДанныеИзСтроки(Кир, КодировкаТекста.UTF8, Ложь);
СBOM = ПолучитьДвоичныеДанныеИзСтроки(Кир, КодировкаТекста.UTF8, Истина);
Ш16БезBOM = ПолучитьДвоичныеДанныеИзСтроки(Кир, КодировкаТекста.UTF16, Ложь);
Ш16СBOM = ПолучитьДвоичныеДанныеИзСтроки(Кир, КодировкаТекста.UTF16, Истина);
Анси = ПолучитьДвоичныеДанныеИзСтроки(Кир, КодировкаТекста.ANSI, Ложь);

П("обратно UTF8 без BOM", ИзБайтов(БезBOM, КодировкаТекста.UTF8));
П("обратно UTF8 С BOM", ИзБайтов(СBOM, КодировкаТекста.UTF8));
П("обратно UTF16 без BOM", ИзБайтов(Ш16БезBOM, КодировкаТекста.UTF16));
П("обратно UTF16 С BOM", ИзБайтов(Ш16СBOM, КодировкаТекста.UTF16));
П("обратно ANSI", ИзБайтов(Анси, КодировкаТекста.ANSI));
П("обратно строкой UTF-8", ИзБайтов(БезBOM, "UTF-8"));
П("обратно чужой кодировкой", ИзБайтов(Анси, КодировкаТекста.UTF8));
П("обратно UTF8 как UTF16", ИзБайтов(БезBOM, КодировкаТекста.UTF16));

// Кодировка опущена — умолчание выясняет замер.
П("обратно без кодировки", Проба("ПолучитьСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзСтроки(""Аб"", КодировкаТекста.UTF8, Ложь))"));
П("обратно без кодировки с BOM", Проба("ПолучитьСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзСтроки(""Аб"", КодировкаТекста.UTF8, Истина))"));

// Оборванный многобайтовый хвост: половина двухбайтовой буквы.
Части = РазделитьДвоичныеДанные(БезBOM, 3);
Обрыв = Части[0];
П("обрыв дамп", Строка(Обрыв));
П("обрыв UTF8", ИзБайтов(Обрыв, КодировкаТекста.UTF8));

// --- обратное преобразование из БУФЕРА -------------------------------------

БуфБезBOM = ПолучитьБуферДвоичныхДанныхИзСтроки(Кир, КодировкаТекста.UTF8, Ложь);
БуфСBOM = ПолучитьБуферДвоичныхДанныхИзСтроки(Кир, КодировкаТекста.UTF8, Истина);
Буф16СBOM = ПолучитьБуферДвоичныхДанныхИзСтроки(Кир, КодировкаТекста.UTF16, Истина);
БуфАнси = ПолучитьБуферДвоичныхДанныхИзСтроки(Кир, КодировкаТекста.ANSI, Ложь);

П("буфер обратно UTF8", ИзБуфера(БуфБезBOM, КодировкаТекста.UTF8));
П("буфер обратно UTF8 С BOM", ИзБуфера(БуфСBOM, КодировкаТекста.UTF8));
П("буфер обратно UTF16 С BOM", ИзБуфера(Буф16СBOM, КодировкаТекста.UTF16));
П("буфер обратно ANSI", ИзБуфера(БуфАнси, КодировкаТекста.ANSI));
П("буфер обратно строкой", ИзБуфера(БуфБезBOM, "UTF-8"));
П("буфер обратно чужой", ИзБуфера(БуфАнси, КодировкаТекста.UTF8));

// Оборванный хвост в буфере: три байта из четырёх.
Обрезок = Новый БуферДвоичныхДанных(3);
Обрезок[0] = БуфБезBOM[0];
Обрезок[1] = БуфБезBOM[1];
Обрезок[2] = БуфБезBOM[2];
П("буфер обрыв дамп", Дамп(Обрезок));
П("буфер обрыв UTF8", ИзБуфера(Обрезок, КодировкаТекста.UTF8));

Пустой = Новый БуферДвоичныхДанных(0);
П("буфер пустой обратно", ИзБуфера(Пустой, КодировкаТекста.UTF8));

П("буфер обратно без кодировки", Проба("ПолучитьСтрокуИзБуфераДвоичныхДанных(ПолучитьБуферДвоичныхДанныхИзСтроки(""Аб"", КодировкаТекста.UTF8, Ложь))"));

// --- негодные аргументы -----------------------------------------------------

П("из числа", Проба("ПолучитьДвоичныеДанныеИзСтроки(5)"));
П("из Неопределено", Проба("ПолучитьДвоичныеДанныеИзСтроки(Неопределено)"));
П("обратно из строки", Проба("ПолучитьСтрокуИзДвоичныхДанных(""Аб"")"));
П("обратно из числа", Проба("ПолучитьСтрокуИзДвоичныхДанных(5)"));
П("буфер обратно из данных", Проба("ПолучитьСтрокуИзБуфераДвоичныхДанных(ПолучитьДвоичныеДанныеИзСтроки(""Аб""))"));
П("данные обратно из буфера", Проба("ПолучитьСтрокуИзДвоичныхДанных(ПолучитьБуферДвоичныхДанныхИзСтроки(""Аб""))"));
П("BOM числом", Проба("ПолучитьДвоичныеДанныеИзСтроки(""Аб"", КодировкаТекста.UTF8, 1)"));
П("кодировка числом", Проба("ПолучитьДвоичныеДанныеИзСтроки(""Аб"", 5)"));

// --- английские написания ---------------------------------------------------

П("GetBinaryDataFromString", Проба("GetBinaryDataFromString(""A"")"));
П("GetBinaryDataBufferFromString", Проба("GetBinaryDataBufferFromString(""A"")"));
П("GetStringFromBinaryData", Проба("GetStringFromBinaryData(GetBinaryDataFromString(""A""))"));
П("GetStringFromBinaryDataBuffer", Проба("GetStringFromBinaryDataBuffer(GetBinaryDataBufferFromString(""A""))"));
П("GetStringFromBinaryDataBuff", Проба("GetStringFromBinaryDataBuff(GetBinaryDataBufferFromString(""A""))"));
П("BinaryDataFromString", Проба("BinaryDataFromString(""A"")"));

// --- тип результата ----------------------------------------------------------

Т1 = ПолучитьДвоичныеДанныеИзСтроки(Аск);
П("тип прямого", Строка(ТипЗнч(Т1)));
Т2 = ПолучитьБуферДвоичныхДанныхИзСтроки(Аск);
П("тип буферного", Строка(ТипЗнч(Т2)));
Т3 = ПолучитьСтрокуИзДвоичныхДанных(Т1, КодировкаТекста.UTF8);
П("тип обратного", Строка(ТипЗнч(Т3)));
