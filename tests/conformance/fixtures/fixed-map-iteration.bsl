// PLATFORM-ONLY: обход неизменяемого снимка соответствия.
Процедура М(Ид, Значение)
    Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

М("file.begin", "fixed-map-iteration-1");
ИсходноеСоответствиеПробы = Новый Соответствие;
ПустойСнимокПробы = Новый ФиксированноеСоответствие(ИсходноеСоответствиеПробы);
ЧислоПарПробы = 0;
Для Каждого ПараПробы Из ПустойСнимокПробы Цикл
    ЧислоПарПробы = ЧислоПарПробы + 1;
КонецЦикла;
М("FIXED_MAP_ITERATION.EMPTY", ЧислоПарПробы);
ИсходноеСоответствиеПробы.Вставить("alpha", 17);
ИсходноеСоответствиеПробы.Вставить("beta", 23);
СнимокСоответствияПробы = Новый ФиксированноеСоответствие(ИсходноеСоответствиеПробы);
ИсходноеСоответствиеПробы.Вставить("alpha", 99);
ИсходноеСоответствиеПробы.Вставить("gamma", 31);
ЧислоПарПробы = 0;
СуммаПарПробы = 0;
СодержимоеПарПробы = Новый Соответствие;
Для Каждого ПараПробы Из СнимокСоответствияПробы Цикл
    ЧислоПарПробы = ЧислоПарПробы + 1;
    СуммаПарПробы = СуммаПарПробы + ПараПробы.Значение;
    СодержимоеПарПробы.Вставить(ПараПробы.Ключ, ПараПробы.Значение);
    ТипПарыПробы = ТипЗнч(ПараПробы);
КонецЦикла;
М("FIXED_MAP_ITERATION.COUNT", ЧислоПарПробы);
М("FIXED_MAP_ITERATION.SUM", СуммаПарПробы);
М("FIXED_MAP_ITERATION.ALPHA", СодержимоеПарПробы.Получить("alpha"));
М("FIXED_MAP_ITERATION.BETA", СодержимоеПарПробы.Получить("beta"));
М("FIXED_MAP_ITERATION.PAIR_TYPE", ?(ТипПарыПробы = Тип("КлючИЗначение"), "YES", "NO"));
Попытка
    ПараПробы.Значение = 42;
    ЗаписьПарыПробы = "ACCEPTED";
Исключение
    ЗаписьПарыПробы = "REFUSED";
КонецПопытки;
М("FIXED_MAP_ITERATION.WRITE", ЗаписьПарыПробы);
М("file.end", "fixed-map-iteration-1");
