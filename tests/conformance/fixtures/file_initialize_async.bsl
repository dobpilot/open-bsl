// Oracle: filesystem/file-initialize-identity.platform.txt. Представление зависит от языка.
Процедура СравнитьФайлыПробы(ИдСравнения, ЛевыйФайлПробы, ПравыйФайлПробы)
	Попытка
		ВыводСравнения = ?(ЛевыйФайлПробы = ПравыйФайлПробы, "1", "0");
	Исключение
		ВыводСравнения = "error|" + ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Сообщить(ИдСравнения + Символ(9) + ВыводСравнения);
КонецПроцедуры

Асинх Функция ПробаТипаИнициализации(ИдТипаПробы, ЗначениеТипаПробы)
	ФайлТипаПробы = Новый Файл("before.txt");
	СтадияТипаПробы = "call";
	ТипОбещанияПробы = "none";
	Попытка
		ОбещаниеТипаПробы = Вычислить("ФайлТипаПробы.InitializeAsync(ЗначениеТипаПробы)");
		ТипОбещанияПробы = Строка(ТипЗнч(ОбещаниеТипаПробы));
		СтадияТипаПробы = "await";
		РезультатТипаПробы = Ждать ОбещаниеТипаПробы;
		ВыводТипаПробы = "ok|string_equal=" + ?(РезультатТипаПробы.ПолноеИмя = Строка(ЗначениеТипаПробы), "1", "0") + "|receiver_equal=" + ?(РезультатТипаПробы.ПолноеИмя = ФайлТипаПробы.ПолноеИмя, "1", "0");
	Исключение
		ОшибкаТипаПробы = ИнформацияОбОшибке();
		ВыводТипаПробы = "error|stage=" + СтадияТипаПробы + "|" + ОшибкаТипаПробы.Описание;
		Если ОшибкаТипаПробы.Причина <> Неопределено Тогда
			ВыводТипаПробы = ВыводТипаПробы + "|cause=" + ОшибкаТипаПробы.Причина.Описание;
		КонецЕсли;
	КонецПопытки;
	Если ТипОбещанияПробы <> "Promise" И ТипОбещанияПробы <> "Обещание" Тогда ВызватьИсключение "ожидалось обещание"; КонецЕсли;
	Сообщить(ИдТипаПробы + Символ(9) + ВыводТипаПробы);
	Возврат Неопределено;
КонецФункции

Асинх Процедура ИзмеритьТождествоИнициализации()
	Сообщить("file.begin" + Символ(9) + "file-initialize-identity-1");
	Попытка
		ИсходныйФайлПробы = Новый Файл("alpha/a.txt");
		ПсевдонимПробы = ИсходныйФайлПробы;
		ПервоеОбещаниеПробы = Вычислить("ИсходныйФайлПробы.ИнициализироватьАсинх(""beta/b.txt"")");
		ВтороеОбещаниеПробы = Вычислить("ИсходныйФайлПробы.InitializeAsync(""gamma/c.bin"")");
		Сообщить("init.before_await" + Символ(9) + ИсходныйФайлПробы.ПолноеИмя);
		ПервыйРезультатПробы = Ждать ПервоеОбещаниеПробы;
		ВторойРезультатПробы = Ждать ВтороеОбещаниеПробы;
		Сообщить("init.first_result" + Символ(9) + ПервыйРезультатПробы.ПолноеИмя);
		Сообщить("init.second_result" + Символ(9) + ВторойРезультатПробы.ПолноеИмя);
		СравнитьФайлыПробы("init.first_equals_receiver", ПервыйРезультатПробы, ИсходныйФайлПробы);
		СравнитьФайлыПробы("init.second_equals_receiver", ВторойРезультатПробы, ИсходныйФайлПробы);
		НезависимыйФайлПробы = Новый Файл("gamma/c.bin");
		СравнитьФайлыПробы("init.independent_same_path", ИсходныйФайлПробы, НезависимыйФайлПробы);
		ТретьеОбещаниеПробы = Вычислить("ПервыйРезультатПробы.InitializeAsync(""delta/d.dat"")");
		Сообщить("init.receiver_after_result_call" + Символ(9) + ИсходныйФайлПробы.ПолноеИмя);
		Сообщить("init.alias_after_result_call" + Символ(9) + ПсевдонимПробы.ПолноеИмя);
		ТретийРезультатПробы = Ждать ТретьеОбещаниеПробы;
		СравнитьФайлыПробы("init.third_equals_receiver", ТретийРезультатПробы, ИсходныйФайлПробы);
		ПовторПробы = Ждать ПервоеОбещаниеПробы;
		Сообщить("init.repeated_first" + Символ(9) + ПовторПробы.ПолноеИмя);
		Сообщить("init.parts" + Символ(9) + ИсходныйФайлПробы.Путь + "|" + ИсходныйФайлПробы.Имя + "|" + ИсходныйФайлПробы.ИмяБезРасширения + "|" + ИсходныйФайлПробы.Расширение);
		Ждать ПробаТипаИнициализации("init.type.boolean", Истина);
		Ждать ПробаТипаИнициализации("init.type.null", Null);
		Ждать ПробаТипаИнициализации("init.type.date", Дата(2020, 1, 2, 3, 4, 5));
		Ждать ПробаТипаИнициализации("init.type.array", Новый Массив);
	Исключение
		Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
	КонецПопытки;
	Сообщить("file.end" + Символ(9) + "file-initialize-identity-1");
	Попытка
		Выполнить("ЗавершитьРаботуСистемы(Ложь)");
	Исключение
	КонецПопытки;
КонецПроцедуры

ИзмеритьТождествоИнициализации();
