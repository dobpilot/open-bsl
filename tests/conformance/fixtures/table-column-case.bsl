// Регистр имён колонок ТаблицыЗначений: доступ к полю строки по имени
// обязан быть регистронезависимым и для кириллицы, и для латиницы —
// эталон снят с реальной 8.3.27. До исправления эта реализация
// сворачивала регистр только у ASCII, и «Стр.колонка» не находила
// колонку «Колонка».
Т = Новый ТаблицаЗначений;
Т.Колонки.Добавить("Колонка");
Т.Колонки.Добавить("Column");
Стр = Т.Добавить();

Стр.колонка = 1;
Стр.КОЛОНКА = Стр.кОлОнКа + 1;
Сообщить(Стр.Колонка);

Стр.column = 7;
Сообщить(Стр.COLUMN);

// Перенос одноимённых свойств между строками не зависит от регистра
// колонок приёмника.
Т2 = Новый ТаблицаЗначений;
Т2.Колонки.Добавить("КОЛОНКА");
Т2.Колонки.Добавить("column");
Стр2 = Т2.Добавить();
ЗаполнитьЗначенияСвойств(Стр2, Стр);
Сообщить(Стр2.колонка);
Сообщить(Стр2.Column);
