// ТабличныйДокумент: то, что уже реализовано и потому сверяется с платформой.

Док = Новый ТабличныйДокумент;
Сообщить(Строка(ТипЗнч(Док)));
Сообщить("пустой: " + Строка(Док.ВысотаТаблицы) + "x" + Строка(Док.ШиринаТаблицы));

Док.Область(1, 1, 1, 1).Текст = "шапка";
Док.Область(2, 1, 2, 1).Текст = "строка1";
Док.Область(2, 2, 2, 2).Текст = "цена1";
Док.Область(3, 1, 3, 1).Текст = "строка2";
Док.Область(3, 2, 3, 2).Текст = "цена2";
Сообщить("заполнен: " + Строка(Док.ВысотаТаблицы) + "x" + Строка(Док.ШиринаТаблицы));
Сообщить("ячейка: " + Док.Область(2, 2, 2, 2).Текст);

// Область — ССЫЛКА: правка через неё видна в документе.
Обл = Док.Область(1, 1, 1, 1);
Обл.Текст = "заголовок";
Сообщить("через ссылку: " + Док.Область(1, 1, 1, 1).Текст);

// Присваивание текста области из нескольких ячеек кладёт его в каждую.
Док.Область(4, 1, 4, 2).Текст = "итого";
Сообщить("в обе: [" + Док.Область(4, 1, 4, 1).Текст + "][" + Док.Область(4, 2, 4, 2).Текст + "]");

// ПолучитьОбласть — КОПИЯ: правка на исходный не влияет.
Копия = Док.ПолучитьОбласть(2, 1, 2, 2);
Сообщить("копия: " + Строка(Копия.ВысотаТаблицы) + "x" + Строка(Копия.ШиринаТаблицы));
Копия.Область(1, 1, 1, 1).Текст = "изменено";
Сообщить("в копии: " + Копия.Область(1, 1, 1, 1).Текст);
Сообщить("в исходном: " + Док.Область(2, 1, 2, 1).Текст);

// Вывести наращивает приёмник вниз.
Приёмник = Новый ТабличныйДокумент;
Приёмник.Вывести(Док.ПолучитьОбласть(1, 1, 1, 2));
Приёмник.Вывести(Док.ПолучитьОбласть(2, 1, 2, 2));
Приёмник.Вывести(Док.ПолучитьОбласть(2, 1, 2, 2));
Сообщить("вывод: " + Строка(Приёмник.ВысотаТаблицы) + "x" + Строка(Приёмник.ШиринаТаблицы));
Сообщить("строки: [" + Приёмник.Область(1, 1, 1, 1).Текст + "][" + Приёмник.Область(2, 1, 2, 1).Текст
	+ "][" + Приёмник.Область(3, 2, 3, 2).Текст + "]");

// Объединение: накрытые ячейки теряют текст.
Слитый = Новый ТабличныйДокумент;
Слитый.Область(1, 1, 1, 1).Текст = "первая";
Слитый.Область(1, 2, 1, 2).Текст = "вторая";
Слитый.Область(1, 3, 1, 3).Текст = "третья";
Слитый.Область(1, 1, 1, 3).Объединить();
Сообщить("после объединения: [" + Слитый.Область(1, 1, 1, 1).Текст + "]["
	+ Слитый.Область(1, 2, 1, 2).Текст + "][" + Слитый.Область(1, 3, 1, 3).Текст + "]");
Сообщить("размер слитого: " + Строка(Слитый.ВысотаТаблицы) + "x" + Строка(Слитый.ШиринаТаблицы));

// Именованная область: имя читается обратно и находится по имени.
Именованный = Новый ТабличныйДокумент;
Именованный.Область(1, 1, 1, 1).Текст = "по имени";
Именованный.Область(1, 1, 1, 1).Имя = "Заголовок";
Сообщить("имя: " + Именованный.Область(1, 1, 1, 1).Имя);
Сообщить("по имени: " + Именованный.ПолучитьОбласть("Заголовок").Область(1, 1, 1, 1).Текст);

// Запись и чтение: файл переживает круговорот вместе с именем области.
Путь = "/tmp/open-bsl-conformance-spreadsheet.mxl";
Именованный.Область(2, 1, 2, 2).Текст = "строка";
Именованный.Записать(Путь, ТипФайлаТабличногоДокумента.MXL);
Прочитанный = Новый ТабличныйДокумент;
Прочитанный.Прочитать(Путь);
Сообщить("из файла: " + Строка(Прочитанный.ВысотаТаблицы) + "x" + Строка(Прочитанный.ШиринаТаблицы));
Сообщить("из файла A1: " + Прочитанный.Область(1, 1, 1, 1).Текст);
Сообщить("из файла имя: " + Прочитанный.ПолучитьОбласть("Заголовок").Область(1, 1, 1, 1).Текст);

// Ячейки со значением: текст отдаёт представление, а не пустоту.
Значения = Новый ТабличныйДокумент;
Ячейка = Значения.Область(1, 1, 1, 1);
Ячейка.СодержитЗначение = Истина;
Ячейка.Значение = 42;
Сообщить("число: [" + Ячейка.Текст + "] содержит: " + Строка(Ячейка.СодержитЗначение));
Дробное = Значения.Область(2, 1, 2, 1);
Дробное.СодержитЗначение = Истина;
Дробное.Значение = 1000.5;
Сообщить("дробное: [" + Дробное.Текст + "]");
Датой = Значения.Область(3, 1, 3, 1);
Датой.СодержитЗначение = Истина;
Датой.Значение = Дата(2026, 8, 2);
Сообщить("дата: [" + Датой.Текст + "]");

// Очистить сбрасывает размеры.
Док.Очистить();
Сообщить("после очистки: " + Строка(Док.ВысотаТаблицы) + "x" + Строка(Док.ШиринаТаблицы));
