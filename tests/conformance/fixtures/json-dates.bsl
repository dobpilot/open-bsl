// JSON: даты и настройки сериализации (глава 16.2, этап 0 —
// docs/std-library-plan.md). Эталон снимается с реальной 8.3.27 на ЭТОЙ ЖЕ
// машине (run-on-1c.sh) — часть проб (`ЛокальнаяДатаСоСмещением`,
// `УниверсальнаяДата`) зависит от часового пояса МАШИНЫ (см. crate
// bsl_rt::tz), так что при переносе на другую машину/зону .expected
// перестанет совпадать не из-за расхождения в реализации, а из-за смены
// исходных данных пробы — это ожидаемо и не повод чинить код.

Функция НаборВариантов()
	Р = Новый Массив;
	Р.Добавить(ВариантЗаписиДатыJSON.ЛокальнаяДата);
	Р.Добавить(ВариантЗаписиДатыJSON.ЛокальнаяДатаСоСмещением);
	Р.Добавить(ВариантЗаписиДатыJSON.УниверсальнаяДата);
	Возврат Р;
КонецФункции

// --- ЗаписатьДатуJSON: три формата, три варианта записи -------------------
Д = Дата(2014, 5, 10, 13, 14, 15);
Сообщить(ЗаписатьДатуJSON(Д, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДата));
Сообщить(ЗаписатьДатуJSON(Д, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДатаСоСмещением));
Сообщить(ЗаписатьДатуJSON(Д, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата));
Сообщить(ЗаписатьДатуJSON(Д, ФорматДатыJSON.JavaScript, ВариантЗаписиДатыJSON.УниверсальнаяДата));
Сообщить(ЗаписатьДатуJSON(Д, ФорматДатыJSON.Microsoft, ВариантЗаписиДатыJSON.УниверсальнаяДата));

// Умолчание варианта записи — без третьего аргумента.
Сообщить(ЗаписатьДатуJSON(Д, ФорматДатыJSON.ISO));

// Пустая дата — граничный случай: перевод в UTC вычитанием смещения
// машины может уйти ниже 0001-01-01 (восточные зоны, положительное
// смещение). ИЗМЕРЕНО: платформа клампит результат к полу диапазона
// (0001-01-01T00:00:00Z), а не ошибается.
Сообщить(ЗаписатьДатуJSON(Дата(1, 1, 1), ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата));

// Дата ВБЛИЗИ пола, но не равная ему, — тот же кламп-механизм ещё не
// подтверждён замером на не-крайнем значении.
Попытка
	Сообщить(ЗаписатьДатуJSON(Дата(1, 1, 1, 0, 30, 0), ФорматДатыJSON.ISO,
		ВариантЗаписиДатыJSON.УниверсальнаяДата));
Исключение
	Сообщить("<ошибка>");
КонецПопытки;

// Не-ISO формат с не-универсальным вариантом — платформа отвергает
// (JSON.WRITE_DATE.NON_ISO_LOCAL_ERROR).
Попытка
	Сообщить("принято: " + ЗаписатьДатуJSON(Д, ФорматДатыJSON.Microsoft, ВариантЗаписиДатыJSON.ЛокальнаяДата));
Исключение
	Сообщить("<ошибка>");
КонецПопытки;

// --- ПрочитатьДатуJSON: разбор всех трёх форматов --------------------------
Сообщить(ПрочитатьДатуJSON("2014-05-10T13:14:15", ФорматДатыJSON.ISO));
Сообщить(ПрочитатьДатуJSON("2014-05-10T09:14:15Z", ФорматДатыJSON.ISO));
Сообщить(ПрочитатьДатуJSON("2014-05-10T13:14:15+04:00", ФорматДатыJSON.ISO));
Сообщить(ПрочитатьДатуJSON("new Date(1411464940000)", ФорматДатыJSON.JavaScript));
// Microsoft — ИЗМЕРЕНО: единственная принимаемая форма БЕЗ обратных косых.
Сообщить(ПрочитатьДатуJSON("/Date(1411464940000)/", ФорматДатыJSON.Microsoft));

// Написание С обратными косыми — ИЗМЕРЕНО: платформа его ОТВЕРГАЕТ
// (до замера здесь предполагалось обратное, и без Попытка эта строка
// уронила весь прогон фикстуры). Остаётся как регрессия факта отклонения.
Попытка
	Сообщить(ПрочитатьДатуJSON("\/Date(1411464940000)\/", ФорматДатыJSON.Microsoft));
Исключение
	Сообщить("<ошибка>");
КонецПопытки;

// Битое представление — исключение (JSON.READ_DATE.BAD_FORMAT_TEXT).
Попытка
	Сообщить("принято: " + Строка(ПрочитатьДатуJSON("совсем не дата", ФорматДатыJSON.ISO)));
Исключение
	Сообщить("<ошибка>");
КонецПопытки;

// Круговой прогон: запись и обратное чтение обязаны совпасть с исходной
// датой на каждом варианте записи.
Для Каждого Вариант Из НаборВариантов() Цикл
	Строка_ = ЗаписатьДатуJSON(Д, ФорматДатыJSON.ISO, Вариант);
	Обратно = ПрочитатьДатуJSON(Строка_, ФорматДатыJSON.ISO);
	Сообщить(Строка_ + " -> " + Строка(Обратно) + " (совпало: " + Строка(Обратно = Д) + ")");
КонецЦикла;

// --- ЗаписатьЗначениеJSON/ПрочитатьЗначениеJSON ----------------------------
Значение = Новый Структура("а, б, в", 1, "текст", Истина);
СтрокаЗначения = ЗаписатьЗначениеJSON(Значение);
Сообщить(СтрокаЗначения);
Обратно = ПрочитатьЗначениеJSON(СтрокаЗначения);
Сообщить(Строка(ТипЗнч(Обратно)) + ": " + Строка(Обратно.а) + "|" + Обратно.б + "|" + Строка(Обратно.в));

Сообщить(ЗаписатьЗначениеJSON("простая строка"));
Сообщить(ЗаписатьЗначениеJSON(42));
Сообщить(ЗаписатьЗначениеJSON(Неопределено));

Массив1 = Новый Массив;
Массив1.Добавить(1);
Массив1.Добавить(2);
Сообщить(ЗаписатьЗначениеJSON(Массив1));

// Соответствие: ПЛАТФОРМА БРОСАЕТ исключение (второй прогон оборвался
// ровно на этой строке без Попытка) — вопреки таблице сериализуемых типов
// из статьи 16.2.1. Проба оставлена в Попытка как регрессия факта.
Соотв = Новый Соответствие;
Соотв.Вставить("ключ", "значение");
Попытка
	Сообщить(ЗаписатьЗначениеJSON(Соотв));
Исключение
	Сообщить("<ошибка>");
КонецПопытки;

// Дата — исключение, даже вложенная.
Попытка
	Сообщить("принято: " + ЗаписатьЗначениеJSON(Дата(2024, 1, 1)));
Исключение
	Сообщить("<ошибка>");
КонецПопытки;

Попытка
	Вложенная = Новый Структура("д", Дата(2024, 1, 1));
	Сообщить("принято: " + ЗаписатьЗначениеJSON(Вложенная));
Исключение
	Сообщить("<ошибка>");
КонецПопытки;

// Пустая строка и мусор — поведение НЕ ИЗМЕНЯЛОСЬ (не измерено), здесь
// только снимок: сейчас пустая строка тихо даёт Неопределено (нет ни
// одного события в разборщике), а "мусор" — исключение, как и в
// ЧтениеJSON.Прочитать() на том же вводе.
Попытка
	Сообщить("пусто: " + Строка(ТипЗнч(ПрочитатьЗначениеJSON(""))));
Исключение
	Сообщить("<ошибка>");
КонецПопытки;

Попытка
	Сообщить("мусор: " + Строка(ПрочитатьЗначениеJSON("мусор")));
Исключение
	Сообщить("<ошибка>");
КонецПопытки;

// --- НастройкиСериализацииJSON: даты внутри ЗаписатьJSON -------------------
// ИЗМЕРЕНО: имена свойств — ФорматСериализацииДаты (С «ы»! статья 16.2.3.2
// приводит ФорматСериализацииДат без «ы» — это опечатка статьи, платформа
// её отвергает), ВариантЗаписиДаты, СериализовыватьМассивыКакОбъекты (см.
// JSON.SETTINGS.PROPERTY_NAMES в measure-json.bsl). Обёртки Попытка
// оставлены — не потому что имена под вопросом, а по общему правилу
// фикстуры: живой прогон когда-то уже падал именно здесь.
Попытка
	НС = Новый НастройкиСериализацииJSON;
	Сообщить(Строка(НС.ФорматСериализацииДаты) + "|" + Строка(НС.ВариантЗаписиДаты)
		+ "|" + Строка(НС.СериализовыватьМассивыКакОбъекты));
Исключение
	Сообщить("<ошибка>");
КонецПопытки;

Попытка
	НС = Новый НастройкиСериализацииJSON;
	НС.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
	НС.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.УниверсальнаяДата;
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Новый Структура("д", Д), НС);
	Сообщить(Запись.Закрыть());
Исключение
	Сообщить("<ошибка>");
КонецПопытки;

// Microsoft + УниверсальнаяДата вложенно: документ ИЗМЕРЕН отдельно
// (без НастройкиСериализацииJSON) как "/Date(...)/" — без обратных косых;
// какой вид дата примет ВНУТРИ документа через ЗаписатьJSON, эта проба
// теперь и снимает.
Попытка
	НС3 = Новый НастройкиСериализацииJSON;
	НС3.ФорматСериализацииДаты = ФорматДатыJSON.Microsoft;
	НС3.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.УниверсальнаяДата;
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Новый Структура("д", Д), НС3);
	Сообщить(Запись.Закрыть());
Исключение
	Сообщить("<ошибка>");
КонецПопытки;

// --- СериализовыватьМассивыКакОбъекты --------------------------------------
Попытка
	НС2 = Новый НастройкиСериализацииJSON;
	НС2.СериализовыватьМассивыКакОбъекты = Истина;
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Массив1, НС2);
	Сообщить(Запись.Закрыть());
Исключение
	Сообщить("<ошибка>");
КонецПопытки;

// --- ЗаписьJSON.ПроверятьСтруктуру -----------------------------------------
Запись = Новый ЗаписьJSON;
Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
Сообщить(Строка(Запись.ПроверятьСтруктуру));

// С проверкой (умолчание): значение в открытом объекте БЕЗ имени
// свойства — ошибка.
Попытка
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьЗначение(1);
	Сообщить("принято: " + Запись.Закрыть());
Исключение
	Сообщить("<ошибка>");
КонецПопытки;

// ИЗМЕРЕНО: без проверки та же последовательность ВСЁ РАВНО ошибка —
// ПроверятьСтруктуру = Ложь не снимает именно эту проверку (до замера
// здесь ожидался успех). Что она снимает — JSON.WRITE.CHECK_STRUCTURE_OFF
// в measure-json.bsl.
Попытка
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	Запись.ПроверятьСтруктуру = Ложь;
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьЗначение(1);
	Запись.ЗаписатьКонецОбъекта();
	Сообщить("принято: " + Запись.Закрыть());
Исключение
	Сообщить("<ошибка>");
КонецПопытки;

// --- ПрочитатьJSON: четвёртый аргумент (ОжидаемыйФорматДаты) --------------
// Рабочий пример из статьи (16.2.3.3.2): значение свойства из
// ИменаСвойствСоЗначениямиДата разбирается СТРОГО под заданный формат.
Ч = Новый ЧтениеJSON;
Ч.УстановитьСтроку("{""создано"":""new Date(1411464940000)""}");
ИменаДат2 = Новый Массив;
ИменаДат2.Добавить("создано");
Прочитанное = ПрочитатьJSON(Ч, Ложь, ИменаДат2, ФорматДатыJSON.JavaScript);
Сообщить(Строка(ТипЗнч(Прочитанное.создано)) + ": " + Строка(Прочитанное.создано));

// Тот же пример, но значение свойства — ЧИСЛО, а не строка формата
// JavaScript: не разбирается ни под один формат (все три кодируют момент
// строкой) — исключение (JSON.READ_DATE.BAD_FORMAT_TEXT).
Попытка
	Ч = Новый ЧтениеJSON;
	Ч.УстановитьСтроку("{""создано"":1411464940000}");
	Прочитанное = ПрочитатьJSON(Ч, Ложь, ИменаДат2, ФорматДатыJSON.JavaScript);
	Сообщить("принято: " + Строка(Прочитанное.создано));
Исключение
	Сообщить("<ошибка>");
КонецПопытки;

// ИЗМЕРЕНО: без четвёртого аргумента платформа тоже НЕ прощает
// неразобравшееся значение — исключение (до замера здесь ожидался тихий
// фолбэк в строку, и живой прогон падал ровно на этой пробе без Попытка).
// Формат по умолчанию — ISO (см. `parse_json_date`, старый парсер без
// сдвига зоны).
Попытка
	Ч = Новый ЧтениеJSON;
	Ч.УстановитьСтроку("{""создано"":""не дата вовсе""}");
	Прочитанное = ПрочитатьJSON(Ч, Ложь, ИменаДат2);
	Сообщить("принято: " + Строка(ТипЗнч(Прочитанное.создано)) + ": " + Прочитанное.создано);
Исключение
	Сообщить("<ошибка>");
КонецПопытки;

// --- Полные арности ПрочитатьJSON/ЗаписатьJSON: имя функции БЕЗ модуля --
// ИЗМЕРЕНО: без МодульФункции... платформа функцию не ищет вовсе, поэтому
// одно только имя ничего не меняет — значение сериализуется и читается как
// обычно. Сами колбэки живут в фикстуре json-callbacks.
Попытка
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, 1, Неопределено, "ИмяФункции");
	Сообщить("принято: " + Запись.Закрыть());
Исключение
	Сообщить("<ошибка>");
КонецПопытки;

Попытка
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку("1");
	// Пятая позиция (после ОжидаемыйФорматДаты) — имя функции
	// восстановления, а не четвёртая. Четвёртую здесь обязательно
	// ПРОПУСКАТЬ, а не передавать Неопределено: ИЗМЕРЕНО, что явное
	// Неопределено в ОжидаемыйФорматДаты платформа отвергает как
	// «Несоответствие типов (параметр номер '4')» — различие, которое этот
	// интерпретатор не воспроизводит (см. optional_date_format_from_arg).
	Сообщить("принято: " + Строка(ПрочитатьJSON(Чтение, Ложь, , , "ИмяФункции")));
Исключение
	Сообщить("<ошибка>");
КонецПопытки;
