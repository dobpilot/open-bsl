// Инструкции препроцессора: условная компиляция и области.
//
// Эталон снят с платформы 8.3.27:
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/fixtures/preproc.bsl
//
// ЧЕГО ЗДЕСЬ СОЗНАТЕЛЬНО НЕТ. Символы `Клиент`,
// `ТолстыйКлиентУправляемоеПриложение` и `ВнешнееСоединение`: их значения
// у нас и у стенда РАЗНЫЕ, и это выбор контекста развёртывания, а не
// расхождение в поведении препроцессора (разбор — в
// `docs/bsl-preproc.md`). Фикстура на них зафиксировала бы разницу
// контекстов вместо механики, поэтому проверяются только те имена, на
// которых обе стороны сходятся: `Сервер`, `НаСервере`, `НаКлиенте`,
// `ТонкийКлиент`, `ВебКлиент`.

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

#Область Условия

Рез1 = "выключено";
#Если Сервер Тогда
Рез1 = "включено";
#КонецЕсли
П("истинное условие", Рез1);

Рез2 = "выключено";
#Если ТонкийКлиент Тогда
Рез2 = "включено";
#КонецЕсли
П("ложное условие", Рез2);

Рез3 = "ничего";
#Если ВебКлиент Тогда
Рез3 = "веб";
#ИначеЕсли НаСервере Тогда
Рез3 = "иначеесли";
#Иначе
Рез3 = "иначе";
#КонецЕсли
П("цепочка ветвей", Рез3);

Рез4 = "ничего";
#Если ВебКлиент Тогда
Рез4 = "веб";
#ИначеЕсли НаКлиенте Тогда
Рез4 = "клиентская";
#Иначе
Рез4 = "иначе";
#КонецЕсли
П("выбор последней ветви", Рез4);

#КонецОбласти

#Область Операции

Рез5 = "нет";
#Если Сервер И НЕ ТонкийКлиент Тогда
Рез5 = "да";
#КонецЕсли
П("И с отрицанием", Рез5);

Рез6 = "нет";
#Если ВебКлиент ИЛИ НаСервере Тогда
Рез6 = "да";
#КонецЕсли
П("ИЛИ", Рез6);

Рез7 = "нет";
#Если НЕ (ТонкийКлиент ИЛИ ВебКлиент) Тогда
Рез7 = "да";
#КонецЕсли
П("скобки под отрицанием", Рез7);

Рез8 = "нет";
#Если НеизвестныйСимволКоторогоНет Тогда
Рез8 = "да";
#Иначе
Рез8 = "нет, символ ложен";
#КонецЕсли
П("неизвестный символ", Рез8);

#КонецОбласти

#Область Прочее

Рез9 = "нет";
#Если Сервер Тогда
#Если НаКлиенте Тогда
Рез9 = "внутренняя";
#Иначе
Рез9 = "вложенность работает";
#КонецЕсли
#КонецЕсли
П("вложенность", Рез9);

#если сЕрВеР тогда
Рез10 = "регистр не важен";
#конецесли
П("регистр директив и символов", Рез10);

#If Server Then
Рез11 = "английские формы";
#Else
Рез11 = "нет";
#EndIf
П("английские формы", Рез11);

// Директива режет выражение, а не только оператор.
Рез12 = "а"
#Если Сервер Тогда
+ "б"
#КонецЕсли
;
П("разрез выражения", Рез12);

Рез13 = "нет";
#Если Сервер Тогда // комментарий после директивы
Рез13 = "да";
#КонецЕсли
П("комментарий после директивы", Рез13);

#КонецОбласти
