// JSON: функции преобразования и восстановления (глава 16.2, задача
// json-callbacks). Эталон снят прогоном на РЕАЛЬНОЙ 8.3.27 этой же машины
//
//     ./tests/conformance/measure/1c/run-on-1c.sh tests/conformance/fixtures/json-callbacks.bsl
//
// и скопирован в .expected без единой правки. От часового пояса машины
// вывод не зависит: дата здесь одна и печатается только её ТИП.
//
// Позиция МодульФункцииПреобразования/Восстановления: платформа ищет колбэк
// в МОДУЛЕ, и модуль формы попадает туда через ЭтотОбъект, которого в этом
// интерпретаторе нет вовсе — здесь функция всегда ищется в модуле
// исполняемого скрипта, и значимо лишь то, что позиция НЕ Неопределено
// (ИЗМЕРЕНО: с Неопределено платформа не ищет функцию ни разу). Отсюда
// МодульКолбэков() ниже: Вычислить внутри Попытка — обычный приём фикстур
// для конструкции, которой на одной из сторон не существует.

Перем Счетчик;

Функция МодульКолбэков()
	Попытка
		Возврат Вычислить("ЭтотОбъект");
	Исключение
		Возврат Истина;
	КонецПопытки;
КонецФункции

Функция ИмяИли(Свойство)
	Если Свойство = Неопределено Тогда
		Возврат "<нет>";
	КонецЕсли;
	Возврат Строка(Свойство);
КонецФункции

Функция НеСериализуемое()
	Возврат Новый ТаблицаЗначений;
КонецФункции

Функция ПустойМассив()
	Возврат Новый Массив;
КонецФункции

Функция МассивИз(А)
	Р = Новый Массив;
	Р.Добавить(А);
	Возврат Р;
КонецФункции

// --- Колбэки ---------------------------------------------------------------

Функция Преобразовать(Свойство, Значение, ДопПар, Отказ) Экспорт
	// Тип значения здесь намеренно НЕ печатается: представление
	// Строка(ТипЗнч(ТаблицаЗначений)) у платформы и у этого интерпретатора
	// разное («Таблица значений» против «ТаблицаЗначений»), а к колбэкам
	// это отношения не имеет.
	Сообщить("  преобразование: свойство=" + ИмяИли(Свойство)
		+ " доп=" + Строка(ДопПар)
		+ " отказ=" + Строка(Отказ));
	Возврат "<преобразовано>";
КонецФункции

Функция ПреобразоватьСОтказом(Свойство, Значение, ДопПар, Отказ) Экспорт
	Отказ = Истина;
	Возврат "<в документ попасть не должно>";
КонецФункции

Функция ПреобразоватьВНеопределено(Свойство, Значение, ДопПар, Отказ) Экспорт
	Возврат Неопределено;
КонецФункции

Функция ПреобразоватьВНесериализуемое(Свойство, Значение, ДопПар, Отказ) Экспорт
	Счетчик = Счетчик + 1;
	Возврат НеСериализуемое();
КонецФункции

// Счётчик ограничивает глубину: без него платформа и этот интерпретатор
// уходили бы в бесконечный обход возвращаемых контейнеров.
Функция ПреобразоватьВКонтейнер(Свойство, Значение, ДопПар, Отказ) Экспорт
	Счетчик = Счетчик + 1;
	Если Счетчик > 3 Тогда
		Возврат "<хватит>";
	КонецЕсли;
	Возврат Новый Структура("вложенное", НеСериализуемое());
КонецФункции

Функция ПреобразоватьМалоПараметров(Свойство, Значение) Экспорт
	Возврат "<два параметра>";
КонецФункции

Функция ПреобразоватьСИсключением(Свойство, Значение, ДопПар, Отказ) Экспорт
	ВызватьИсключение "изнутри функции преобразования";
КонецФункции

Функция Восстановить(Свойство, Значение, ДопПар) Экспорт
	Сообщить("  восстановление: свойство=" + ИмяИли(Свойство)
		+ " тип=" + Строка(ТипЗнч(Значение))
		+ " доп=" + Строка(ДопПар));
	Возврат Значение;
КонецФункции

Функция ВосстановитьМетка(Свойство, Значение, ДопПар) Экспорт
	Возврат "<" + ИмяИли(Свойство) + ">";
КонецФункции

Функция ВосстановитьМалоПараметров(Свойство, Значение) Экспорт
	Возврат Значение;
КонецФункции

Функция ВосстановитьСИсключением(Свойство, Значение, ДопПар) Экспорт
	ВызватьИсключение "изнутри функции восстановления";
КонецФункции

// --- Помощники -------------------------------------------------------------

Функция ВСтроку(Значение)
	З = Новый ЗаписьJSON;
	З.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(З, Значение);
	Возврат З.Закрыть();
КонецФункции

Функция Записать(Значение, Имя)
	Попытка
		З = Новый ЗаписьJSON;
		З.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
		ЗаписатьJSON(З, Значение, , Имя, МодульКолбэков(), "ДОП");
		Возврат З.Закрыть();
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
КонецФункции

Функция ЗаписатьСНастройками(Значение, Имя, Настройки)
	Попытка
		З = Новый ЗаписьJSON;
		З.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
		ЗаписатьJSON(З, Значение, Настройки, Имя, МодульКолбэков(), "ДОП");
		Возврат З.Закрыть();
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
КонецФункции

// Пустой массив в позиции ИменаСвойствДляФункцииВосстановления ИЗМЕРЕН как
// равносильный отсутствию фильтра, поэтому он передаётся всегда.
Функция Прочитать(Текст, Имя, Фильтр)
	Попытка
		Ч = Новый ЧтениеJSON;
		Ч.УстановитьСтроку(Текст);
		Р = ПрочитатьJSON(Ч, Ложь, , , Имя, МодульКолбэков(), "ДОП", Фильтр);
		Возврат ВСтроку(Р);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
КонецФункции

Функция ПрочитатьСДатами(Текст, ИменаДат, Имя, Фильтр)
	Попытка
		Ч = Новый ЧтениеJSON;
		Ч.УстановитьСтроку(Текст);
		Р = ПрочитатьJSON(Ч, Ложь, ИменаДат, , Имя, МодульКолбэков(), "ДОП", Фильтр);
		Возврат Строка(ТипЗнч(Р.создано));
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
КонецФункции

Счетчик = 0;

// --- Где зовётся функция преобразования ------------------------------------
Сообщить("=== функция преобразования: позиции ===");

Сообщить("1 верхний уровень: " + Записать(НеСериализуемое(), "Преобразовать"));

М = Новый Массив;
М.Добавить(1);
М.Добавить(НеСериализуемое());
Сообщить("2 элемент массива: " + Записать(М, "Преобразовать"));

С = Новый Структура;
С.Вставить("Первое", 1);
С.Вставить("Второе", НеСериализуемое());
Сообщить("3 свойство структуры: " + Записать(С, "Преобразовать"));

Соотв = Новый Соответствие;
Соотв.Вставить("Ключ", НеСериализуемое());
Сообщить("4 значение соответствия: " + Записать(Соотв, "Преобразовать"));

Вложенная = Новый Структура("Внешнее", Новый Структура("Внутреннее", МассивИз(НеСериализуемое())));
Сообщить("5 вложенная структура: " + Записать(Вложенная, "Преобразовать"));

// Лень вызова: то, что платформа умеет сама, до функции не доходит.
Сообщить("6 всё сериализуемо: " + Записать(Новый Структура("а", 1), "Преобразовать"));
Сообщить("7 дата: " + Записать(Новый Структура("д", Дата(2014, 5, 10)), "Преобразовать"));

// СериализовыватьМассивыКакОбъекты: индекс приходит ИМЕНЕМ свойства.
Наст = Новый НастройкиСериализацииJSON;
Наст.СериализовыватьМассивыКакОбъекты = Истина;
Сообщить("8 массив как объект: " + ЗаписатьСНастройками(М, "Преобразовать", Наст));

// --- Отказ ------------------------------------------------------------------
Сообщить("=== Отказ ===");

Сообщить("9 свойство структуры: " + Записать(С, "ПреобразоватьСОтказом"));

М3 = Новый Массив;
М3.Добавить(1);
М3.Добавить(НеСериализуемое());
М3.Добавить(3);
Сообщить("10 элемент массива: " + Записать(М3, "ПреобразоватьСОтказом"));

Соотв2 = Новый Соответствие;
Соотв2.Вставить("к1", НеСериализуемое());
Сообщить("11 значение соответствия: " + Записать(Соотв2, "ПреобразоватьСОтказом"));

Сообщить("12 верхний уровень: [" + Записать(НеСериализуемое(), "ПреобразоватьСОтказом") + "]");

// --- Что делает возвращённое значение ---------------------------------------
Сообщить("=== результат функции преобразования ===");

Счетчик = 0;
Сообщить("13 снова несериализуемое: "
	+ Записать(Новый Структура("а", НеСериализуемое()), "ПреобразоватьВНесериализуемое")
	+ " (вызовов: " + Строка(Счетчик) + ")");

Счетчик = 0;
Сообщить("14 контейнер с несериализуемым: "
	+ Записать(Новый Структура("а", НеСериализуемое()), "ПреобразоватьВКонтейнер")
	+ " (вызовов: " + Строка(Счетчик) + ")");

Сообщить("15 Неопределено: "
	+ Записать(Новый Структура("а", НеСериализуемое()), "ПреобразоватьВНеопределено"));

// --- Ошибки вызова ----------------------------------------------------------
Сообщить("=== ошибки вызова функции преобразования ===");

Сообщить("16 нет такой функции: "
	+ Записать(Новый Структура("а", НеСериализуемое()), "НетТакойФункции"));
Сообщить("17 не то число параметров: "
	+ Записать(Новый Структура("а", НеСериализуемое()), "ПреобразоватьМалоПараметров"));
Сообщить("18 исключение изнутри: "
	+ Записать(Новый Структура("а", НеСериализуемое()), "ПреобразоватьСИсключением"));

// --- Порядок обхода функции восстановления ----------------------------------
// Это и есть таблица из статьи: функция зовётся для КАЖДОГО значения
// документа, дети раньше родителя, корень — последним.
Сообщить("=== функция восстановления: порядок обхода ===");

Док = "{""чис"":1,""стр"":""т"",""лог"":true,""нул"":null,"
	+ """об"":{""вчис"":2,""вмас"":[7,8]},"
	+ """мас"":[3,""ф"",false,null,{""мчис"":4},[5,6]]}";
Сообщить("19 итог: " + Прочитать(Док, "Восстановить", ПустойМассив()));

Сообщить("20 массив сверху: " + Прочитать("[1,""т"",{""в"":2}]", "Восстановить", ПустойМассив()));
Сообщить("21 скаляр сверху: " + Прочитать("42", "Восстановить", ПустойМассив()));
Сообщить("22 пустой объект: " + Прочитать("{}", "Восстановить", ПустойМассив()));
Сообщить("23 пустой массив: " + Прочитать("[]", "Восстановить", ПустойМассив()));

// --- Фильтр имён -------------------------------------------------------------
Сообщить("=== ИменаСвойствДляФункцииВосстановления ===");

Док2 = "{""а"":1,""б"":2,""в"":{""б"":3,""г"":4}}";
Сообщить("24 фильтр [б]: " + Прочитать(Док2, "ВосстановитьМетка", МассивИз("б")));
Сообщить("25 фильтр [Б] (регистр): " + Прочитать(Док2, "ВосстановитьМетка", МассивИз("Б")));
Сообщить("26 фильтр пустой: " + Прочитать(Док2, "ВосстановитьМетка", ПустойМассив()));

// --- Восстановление и ИменаСвойствСоЗначениямиДата ---------------------------
Сообщить("=== восстановление против списка дат ===");

ДокД = "{""создано"":""2014-05-10T13:14:15"",""прочее"":1}";
Сообщить("27 без функции: " + ПрочитатьСДатами(ДокД, МассивИз("создано"), "", ПустойМассив()));
Сообщить("28 функция мимо: "
	+ ПрочитатьСДатами(ДокД, МассивИз("создано"), "ВосстановитьМетка", МассивИз("прочее")));
Сообщить("29 функция по свойству: "
	+ ПрочитатьСДатами(ДокД, МассивИз("создано"), "ВосстановитьМетка", МассивИз("создано")));

// --- Ошибки вызова функции восстановления -------------------------------------
Сообщить("=== ошибки вызова функции восстановления ===");

Сообщить("30 нет такой функции: " + Прочитать("{""а"":1}", "НетТакойФункции", ПустойМассив()));
Сообщить("31 не то число параметров: "
	+ Прочитать("{""а"":1}", "ВосстановитьМалоПараметров", ПустойМассив()));
Сообщить("32 исключение изнутри: "
	+ Прочитать("{""а"":1}", "ВосстановитьСИсключением", ПустойМассив()));
