Б = Два(12, 12);
Б.ЗаписатьПобитовоеИНе(0, Два(10, 10));
П("побитовое ИНе", Дамп(Б));

// Смещение, пустая маска и маска ровно до конца.
Б = Два(12, 12);
Б.ЗаписатьПобитовоеИ(1, Один(10));
П("И со смещением", Дамп(Б));
Б.ЗаписатьПобитовоеИ(0, Пустой);
П("И пустой маской", Дамп(Б));
Б = Два(12, 12);
Б.ЗаписатьПобитовоеИ(0, Два(10, 10));
П("И маской до конца", Дамп(Б));

// --- Инвертировать --------------------------------------------------------

Б = Два(12, 10);
Б.Инвертировать();
П("инверсия целиком", Дамп(Б));

Б = Четыре(1, 2, 3, 4);
Б.Инвертировать(1);
П("инверсия с позиции", Дамп(Б));

Б = Четыре(1, 2, 3, 4);
Б.Инвертировать(0, 2);
П("инверсия отрезка", Дамп(Б));

// Количество = 0 означает «до конца», а не «ничего».
Б = Четыре(1, 2, 3, 4);
Б.Инвертировать(1, 0);
П("инверсия нулевой длины", Дамп(Б));

Б = Четыре(1, 2, 3, 4);
Б.Инвертировать(0, 4);
П("инверсия ровно до конца", Дамп(Б));

// --- равенство ------------------------------------------------------------
