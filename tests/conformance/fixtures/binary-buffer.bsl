// Контракт типа `БуферДвоичныхДанных`: конструктор, индексация, свойства
// `Размер` и `ПорядокБайтов`, целые 16/32/64 в обоих порядках байтов,
// `Разделить`/`Соединить`, побитовые методы, `Инвертировать` и краевые
// случаи.
//
// Эталон снимается ТОЛЬКО платформой:
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/fixtures/binary-buffer.bsl
//   diff tests/conformance/fixtures/binary-buffer.expected \
//        tests/conformance/fixtures/binary-buffer.platform.txt
//
// ЧЕГО ЗДЕСЬ СОЗНАТЕЛЬНО НЕТ. Записи в байт значения вне 0..255 и записи
// дробного значения (`Б[1] = 256`, `Б[1] = 2.9`), а также мусора вместо
// аргумента порядка байтов (`Б.ПрочитатьЦелое16(0, 5)`). Платформа на них
// не бросает перехватываемое исключение, а МОЛЧА УНОСИТ СЕАНС: `Попытка`
// вокруг не помогает (проверено и через `Выполнить`, и прямой Попыткой),
// прогон замеров висит до таймаута и эталон не снимается вовсе. Отказ сам
// по себе наблюдаем — значение не принимается, — и реализация отвечает на
// него обычной ловимой ошибкой; воспроизводить гибель сеанса незачем.
//
// Восьмибитных `ПрочитатьЦелое8`/`ЗаписатьЦелое8` у платформы НЕТ ни в
// каком написании (проверено перебором вместе с `ПрочитатьБайт` и
// `ПолучитьБайт`) — один байт берётся индексом или `Получить`.
//
// Два правила письма, каждое стоит впустую потраченного прогона: метод
// нельзя звать на результате вызова (нужна промежуточная переменная), а
// всякая проба, способная бросить, обязана быть в `Попытка`.

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

// Побайтовый дамп — заодно проверяет индексацию на чтение.
Функция Дамп(Б)
	С = "";
	Для н = 0 По Б.Размер - 1 Цикл
		С = С + Ч(Б[н]) + " ";
	КонецЦикла;
	Возврат СокрЛП(С);
КонецФункции

// Буфер из четырёх байтов с заданным содержимым.
Функция Четыре(А, Б, В, Г)
	Р = Новый БуферДвоичныхДанных(4);
	Р[0] = А;
	Р[1] = Б;
	Р[2] = В;
	Р[3] = Г;
	Возврат Р;
КонецФункции

Функция Один(А)
	Р = Новый БуферДвоичныхДанных(1);
	Р[0] = А;
	Возврат Р;
КонецФункции

Функция Два(А, Б)
	Р = Новый БуферДвоичныхДанных(2);
	Р[0] = А;
	Р[1] = Б;
	Возврат Р;
КонецФункции

// Разбиение с печатью числа частей и содержимого каждой.
Функция Раскрой(Б, Разделитель)
	Части = Б.Разделить(Разделитель);
	Р = Ч(Части.Количество());
	Для Каждого Часть Из Части Цикл
		Р = Р + " [" + Дамп(Часть) + "]";
	КонецЦикла;
	Возврат Р;
КонецФункции

// --- тип, конструктор, строковое представление ----------------------------

Буф = Новый БуферДвоичныхДанных(4);
П("тип", Строка(ТипЗнч(Буф)));
П("строка значения", Строка(Буф));
П("размер", Ч(Буф.Размер));
П("нулевой дамп", Дамп(Буф));
П("заполнено", Строка(ЗначениеЗаполнено(Буф)));

Пустой = Новый БуферДвоичныхДанных(0);
П("пустой размер", Ч(Пустой.Размер));
П("пустой дамп", "[" + Дамп(Пустой) + "]");
П("пустой заполнен", Строка(ЗначениеЗаполнено(Пустой)));

// --- перечисление ПорядокБайтов -------------------------------------------

П("LE строка", Строка(ПорядокБайтов.LittleEndian));
П("BE строка", Строка(ПорядокБайтов.BigEndian));
П("LE тип", Строка(ТипЗнч(ПорядокБайтов.LittleEndian)));
П("порядок по умолчанию", Строка(Буф.ПорядокБайтов));
П("LE = LE", Строка(ПорядокБайтов.LittleEndian = ПорядокБайтов.LittleEndian));
П("LE = BE", Строка(ПорядокБайтов.LittleEndian = ПорядокБайтов.BigEndian));

СBE = Новый БуферДвоичныхДанных(4, ПорядокБайтов.BigEndian);
П("конструктор с BE", Строка(СBE.ПорядокБайтов));
Буф.ПорядокБайтов = ПорядокБайтов.BigEndian;
П("порядок после записи", Строка(Буф.ПорядокБайтов));
Буф.ПорядокБайтов = ПорядокБайтов.LittleEndian;
П("порядок возвращён", Строка(Буф.ПорядокБайтов));

// --- индексация -----------------------------------------------------------

Буф = Четыре(10, 11, 12, 13);
П("дамп", Дамп(Буф));
П("чтение [0]", Ч(Буф[0]));
П("чтение [3]", Ч(Буф[3]));
П("тип элемента", Строка(ТипЗнч(Буф[0])));
// Дробный индекс платформа принимает и отбрасывает дробную часть.
П("индекс 1.5", Ч(Буф[1.5]));
П("индекс 1.9", Ч(Буф[1.9]));
П("индекс 0.9", Ч(Буф[0.9]));
П("индекс 3.9", Ч(Буф[3.9]));
П("Получить(2)", Ч(Буф.Получить(2)));
П("Получить(0.5)", Ч(Буф.Получить(0.5)));
Буф.Установить(1, 99);
П("после Установить", Дамп(Буф));
Буф[1] = 255;
П("после записи 255", Дамп(Буф));

// --- целые 16/32/64 -------------------------------------------------------

Ц = Новый БуферДвоичныхДанных(8);
Ц.ЗаписатьЦелое16(0, 258);
П("Ц16 LE дамп", Дамп(Ц));
П("Ц16 LE чтение", Ч(Ц.ПрочитатьЦелое16(0)));
Ц.ЗаписатьЦелое16(2, 258, ПорядокБайтов.BigEndian);
П("Ц16 BE дамп", Дамп(Ц));
П("Ц16 BE чтение", Ч(Ц.ПрочитатьЦелое16(2, ПорядокБайтов.BigEndian)));
П("Ц16 BE прочтён как LE", Ч(Ц.ПрочитатьЦелое16(2, ПорядокБайтов.LittleEndian)));

Ц = Новый БуферДвоичныхДанных(8);
Ц.ЗаписатьЦелое32(0, 16909060);
П("Ц32 LE дамп", Дамп(Ц));
П("Ц32 LE чтение", Ч(Ц.ПрочитатьЦелое32(0)));
Ц.ЗаписатьЦелое32(4, 16909060, ПорядокБайтов.BigEndian);
П("Ц32 BE дамп", Дамп(Ц));
П("Ц32 BE чтение", Ч(Ц.ПрочитатьЦелое32(4, ПорядокБайтов.BigEndian)));

Ц = Новый БуферДвоичныхДанных(8);
Ц.ЗаписатьЦелое64(0, 72623859790382856);
П("Ц64 LE дамп", Дамп(Ц));
П("Ц64 LE чтение", Ч(Ц.ПрочитатьЦелое64(0)));
Ц.ЗаписатьЦелое64(0, 72623859790382856, ПорядокБайтов.BigEndian);
П("Ц64 BE дамп", Дамп(Ц));

// Целые БЕЗЗНАКОВЫЕ: восемь FF — это 2^64-1, а не -1.
Ф = Новый БуферДвоичныхДанных(8);
Для н = 0 По 7 Цикл
	Ф[н] = 255;
КонецЦикла;
П("Ц16 из FFFF", Ч(Ф.ПрочитатьЦелое16(0)));
П("Ц32 из FFFFFFFF", Ч(Ф.ПрочитатьЦелое32(0)));
П("Ц64 из FF*8", Ч(Ф.ПрочитатьЦелое64(0)));

// Верхний край записи — принимается.
Ц = Новый БуферДвоичныхДанных(8);
Ц.ЗаписатьЦелое16(0, 65535);
П("Ц16 = 65535", Дамп(Ц));
Ц.ЗаписатьЦелое32(4, 4294967295);
П("Ц32 = макс", Дамп(Ц));

// Собственный порядок буфера — значение по умолчанию для методов.
Св = Новый БуферДвоичныхДанных(4);
Св.ПорядокБайтов = ПорядокБайтов.BigEndian;
Св.ЗаписатьЦелое16(0, 258);
П("порядок буфера действует", Дамп(Св));
П("и на чтение тоже", Ч(Св.ПрочитатьЦелое16(0)));

// --- Разделить ------------------------------------------------------------

Ш = Новый БуферДвоичныхДанных(7);
Ш[0] = 1; Ш[1] = 2; Ш[2] = 0; Ш[3] = 3; Ш[4] = 4; Ш[5] = 0; Ш[6] = 5;
П("раскрой по 0", Раскрой(Ш, Один(0)));
П("раскрой по отсутствующему", Раскрой(Ш, Один(99)));
П("раскрой в начале", Раскрой(Четыре(0, 1, 2, 3), Один(0)));
П("раскрой в конце", Раскрой(Четыре(1, 2, 3, 0), Один(0)));
П("раскрой подряд", Раскрой(Четыре(1, 0, 0, 2), Один(0)));
П("раскрой только разделители", Раскрой(Два(0, 0), Один(0)));
П("раскрой буфер равен разделителю", Раскрой(Один(0), Один(0)));
П("раскрой пустого", Раскрой(Пустой, Один(0)));
П("раскрой разделитель длиннее", Раскрой(Один(1), Два(1, 2)));
П("раскрой многобайтовым", Раскрой(Четыре(1, 0, 0, 2), Два(0, 0)));
П("раскрой перекрытие", Раскрой(Один(0), Два(0, 0)));

// Часть — самостоятельный буфер и наследует порядок байтов источника.
Исх = Четыре(1, 2, 0, 3);
Исх.ПорядокБайтов = ПорядокБайтов.BigEndian;
Части = Исх.Разделить(Один(0));
Первая = Части[0];
П("тип части", Строка(ТипЗнч(Первая)));
П("порядок части", Строка(Первая.ПорядокБайтов));

// --- Соединить ------------------------------------------------------------

Лев = Два(1, 2);
Прав = Два(3, 4);
Сцепка = Лев.Соединить(Прав);
П("склейка", Дамп(Сцепка));
П("склейка размер", Ч(Сцепка.Размер));
П("левый не вырос", Ч(Лев.Размер));
П("склейка с пустым", Ч(Лев.Соединить(Пустой).Размер));
Сам = Лев.Соединить(Лев);
П("склейка сам с собой", Дамп(Сам));
Лев.ПорядокБайтов = ПорядокБайтов.BigEndian;
СцепкаBE = Лев.Соединить(Прав);
П("порядок склейки от левого", Строка(СцепкаBE.ПорядокБайтов));
П("склейка двух пустых", Ч(Пустой.Соединить(Пустой).Размер));

// --- побитовые ------------------------------------------------------------

Б = Два(12, 12);
Б.ЗаписатьПобитовоеИ(0, Два(10, 10));
П("побитовое И", Дамп(Б));

Б = Два(12, 12);
Б.ЗаписатьПобитовоеИли(0, Два(3, 3));
П("побитовое Или", Дамп(Б));

Б = Два(12, 12);
Б.ЗаписатьПобитовоеИсключительноеИли(0, Два(10, 10));
