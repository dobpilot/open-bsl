Перем НаблюденияВидовДоставки;
Перем ВозвращенВызовВидовДоставки;
Перем ЗавершенаПробаВидовДоставки;
Перем ТикиВидовДоставки;
Перем ФайлВидовДоставки;

Процедура ЗавершитьВидыДоставки(Принудительно = Ложь)
    Если ЗавершенаПробаВидовДоставки Тогда Возврат; КонецЕсли;
    Если Не Принудительно И НаблюденияВидовДоставки.Количество() <> 6 Тогда Возврат; КонецЕсли;
    ЗавершенаПробаВидовДоставки = Истина;
    Для Каждого КлючВидаДоставки Из СтрРазделить("function,async.function.before,async.function.after,async.procedure.before,async.procedure.after,error.function", ",") Цикл
        ЗначениеВидаДоставки = НаблюденияВидовДоставки[КлючВидаДоставки];
        Сообщить("kind." + КлючВидаДоставки + Символ(9) + ?(ЗначениеВидаДоставки = Неопределено, "missing", ЗначениеВидаДоставки));
    КонецЦикла;
    Сообщить("file.end" + Символ(9) + "file-begin-handler-kinds-1");
    Попытка Выполнить("ЗавершитьРаботуСистемы(Ложь);"); Исключение КонецПопытки;
КонецПроцедуры

Процедура ТаймерВидовДоставки() Экспорт
    ТикиВидовДоставки = ТикиВидовДоставки + 1;
    Если ТикиВидовДоставки >= 20 Тогда ЗавершитьВидыДоставки(Истина); КонецЕсли;
КонецПроцедуры

Функция УспехФункцииДоставки(Знач РезультатВидаДоставки, Знач КлючВидаДоставки) Экспорт
    НаблюденияВидовДоставки.Вставить(КлючВидаДоставки,
        ?(РезультатВидаДоставки = ФайлВидовДоставки, "same", "different")
        + "|returned=" + ?(ВозвращенВызовВидовДоставки, "1", "0"));
    ЗавершитьВидыДоставки();
    Возврат 99;
КонецФункции

Асинх Функция УспехАсинхФункцииДоставки(Знач РезультатВидаДоставки, Знач КлючВидаДоставки) Экспорт
    НаблюденияВидовДоставки.Вставить(КлючВидаДоставки + ".before",
        ?(РезультатВидаДоставки = ФайлВидовДоставки, "same", "different")
        + "|returned=" + ?(ВозвращенВызовВидовДоставки, "1", "0"));
    Попытка
        СуществуетПослеОжидания = Ждать ФайлВидовДоставки.СуществуетАсинх();
        НаблюденияВидовДоставки.Вставить(КлючВидаДоставки + ".after", "await=" + ?(СуществуетПослеОжидания, "1", "0"));
    Исключение
        НаблюденияВидовДоставки.Вставить(КлючВидаДоставки + ".after", "error:" + ИнформацияОбОшибке().Описание);
    КонецПопытки;
    ЗавершитьВидыДоставки();
    Возврат 99;
КонецФункции

Асинх Процедура УспехАсинхПроцедурыДоставки(Знач РезультатВидаДоставки, Знач КлючВидаДоставки) Экспорт
    НаблюденияВидовДоставки.Вставить(КлючВидаДоставки + ".before",
        ?(РезультатВидаДоставки = ФайлВидовДоставки, "same", "different")
        + "|returned=" + ?(ВозвращенВызовВидовДоставки, "1", "0"));
    Попытка
        СуществуетПослеОжидания = Ждать ФайлВидовДоставки.СуществуетАсинх();
        НаблюденияВидовДоставки.Вставить(КлючВидаДоставки + ".after", "await=" + ?(СуществуетПослеОжидания, "1", "0"));
    Исключение
        НаблюденияВидовДоставки.Вставить(КлючВидаДоставки + ".after", "error:" + ИнформацияОбОшибке().Описание);
    КонецПопытки;
    ЗавершитьВидыДоставки();
КонецПроцедуры

Функция ОшибкаФункцииДоставки(Знач ИнформацияВидаДоставки, СтандартнаяВидаДоставки, Знач КлючВидаДоставки) Экспорт
    НаблюденияВидовДоставки.Вставить(КлючВидаДоставки,
        Строка(ТипЗнч(ИнформацияВидаДоставки)) + "|standard=" + ?(СтандартнаяВидаДоставки, "1", "0")
        + "|returned=" + ?(ВозвращенВызовВидовДоставки, "1", "0"));
    СтандартнаяВидаДоставки = Ложь;
    ЗавершитьВидыДоставки();
    Возврат 99;
КонецФункции

Сообщить("file.begin" + Символ(9) + "file-begin-handler-kinds-1");
НаблюденияВидовДоставки = Новый Соответствие;
ВозвращенВызовВидовДоставки = Ложь;
ЗавершенаПробаВидовДоставки = Ложь;
ТикиВидовДоставки = 0;
ФайлВидовДоставки = Новый Файл("/open-bsl-handler-kinds-no-file-20260917");
Попытка
    ФайлВидовДоставки.НачатьИнициализацию(Новый ОписаниеОповещения("УспехФункцииДоставки", ЭтотОбъект, "function"), ФайлВидовДоставки.ПолноеИмя);
    ФайлВидовДоставки.BeginInitialization(Новый NotifyDescription("УспехАсинхФункцииДоставки", ЭтотОбъект, "async.function"), ФайлВидовДоставки.ПолноеИмя);
    ФайлВидовДоставки.НачатьИнициализацию(Новый ОписаниеОповещения("УспехАсинхПроцедурыДоставки", ЭтотОбъект, "async.procedure"), ФайлВидовДоставки.ПолноеИмя);
    ОписаниеОшибкиВидаДоставки = Новый ОписаниеОповещения("УспехФункцииДоставки", ЭтотОбъект, "error.function", "ОшибкаФункцииДоставки", ЭтотОбъект);
    ФайлВидовДоставки.НачатьУстановкуНевидимости(ОписаниеОшибкиВидаДоставки, Новый Массив);
    Сообщить("kind.return" + Символ(9) + Строка(НаблюденияВидовДоставки.Количество()));
    ВозвращенВызовВидовДоставки = Истина;
    Попытка Выполнить("ПодключитьОбработчикОжидания(""ТаймерВидовДоставки"", 1);"); Исключение КонецПопытки;
Исключение
    Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
    ЗавершитьВидыДоставки(Истина);
КонецПопытки;
