// Контракт потоков: `ПотокВПамяти`, `ФайловыйПоток`, менеджер
// `ФайловыеПотоки`, навигация (`Перейти`/`ТекущаяПозиция`/`Размер`),
// признаки доступности и перечисления `РежимОткрытияФайла`,
// `ДоступКФайлу`, `ПозицияВПотоке`.
//
// Эталон снимается ТОЛЬКО платформой:
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/fixtures/binary-streams.bsl
//   diff tests/conformance/fixtures/binary-streams.expected \
//        tests/conformance/fixtures/binary-streams.platform.txt
//
// Пути фиксированы во временном каталоге: обе стороны бегут на одной
// машине (образец — `binary-data.bsl`). Файлы заводятся `ЗаписьТекста`, а
// она начинает файл с BOM `EF BB BF` (измерено), поэтому «десять символов»
// это тринадцать байтов, и байты 187/191 в дампах начала файла — хвост
// того же BOM.
//
// ЧЕГО ЗДЕСЬ СОЗНАТЕЛЬНО НЕТ.
//
// 1. Режимов на ОТСУТСТВУЮЩЕМ файле. Удалить файл из BSL этой реализации
//    нечем, поэтому второй прогон фикстуры видел бы уже созданные первым
//    файлы и печатал бы другое. Полная таблица «режим x доступ» на
//    отсутствующем файле снята разведочным прогоном и живёт юнит-тестами
//    `bsl-rt/src/stream.rs`: `Открыть` и `Обрезать` требуют существующего
//    файла, `Создать`/`СоздатьНовый`/`ОткрытьИлиСоздать`/`Дописать` его
//    заводят, а `ДоступКФайлу.Чтение` несовместим с любым созданием.
// 2. Ошибок АРНОСТИ (`Новый ПотокВПамяти(16, 32)`, `Поток.Перейти(0)`).
//    Платформа отвергает их, но здесь их ловит резолвер — это ошибка
//    компиляции, а не перехватываемое `Попыткой` исключение, и весь
//    скрипт из-за неё не запустился бы.
//
// Два правила письма, каждое стоит впустую потраченного прогона: метод
// нельзя звать на результате вызова (нужна промежуточная переменная), а
// всякая проба, способная бросить, обязана быть в `Попытка`.

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

// Побайтовый дамп буфера.
Функция Дамп(Б)
	С = "";
	Для н = 0 По Б.Размер - 1 Цикл
		С = С + Ч(Б[н]) + " ";
	КонецЦикла;
	Возврат СокрЛП(С);
КонецФункции

Функция Четыре(А, Б, В, Г)
	Р = Новый БуферДвоичныхДанных(4);
	Р[0] = А;
	Р[1] = Б;
	Р[2] = В;
	Р[3] = Г;
	Возврат Р;
КонецФункции

// Файл из десяти символов; с BOM это тринадцать байтов.
Функция Завести(Имя)
	Путь = "/tmp/open-bsl-streams-" + Имя + ".bin";
	З = Новый ЗаписьТекста(Путь);
	З.Записать("0123456789");
	З.Закрыть();
	Возврат Путь;
КонецФункции

Процедура Опиши(Метка, Поток)
	П(Метка, "разм " + Ч(Поток.Размер())
		+ " поз " + Ч(Поток.ТекущаяПозиция())
		+ " зап " + Строка(Поток.ДоступнаЗапись)
		+ " чт " + Строка(Поток.ДоступноЧтение)
		+ " смещ " + Строка(Поток.ДоступноИзменениеПозиции));
КонецПроцедуры

// Одна клетка таблицы «режим x доступ» на заведомо существующем файле.
Процедура Клетка(Метка, Имя, Режим, СДоступом, Доступ)
	Путь = Завести(Имя);
	Р = "";
	Попытка
		Если СДоступом Тогда
			Поток = Новый ФайловыйПоток(Путь, Режим, Доступ);
		Иначе
			Поток = Новый ФайловыйПоток(Путь, Режим);
		КонецЕсли;
		Р = "разм " + Ч(Поток.Размер())
			+ " поз " + Ч(Поток.ТекущаяПозиция())
			+ " зап " + Строка(Поток.ДоступнаЗапись)
			+ " чт " + Строка(Поток.ДоступноЧтение);
		Поток.Закрыть();
	Исключение
		Р = "<ошибка>";
	КонецПопытки;
	П(Метка, Р);
КонецПроцедуры

// Имя типа, если оно вообще разрешимо.
Функция ИмяТипа(Имя)
	Попытка
		Возврат Строка(Тип(Имя));
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
КонецФункции

