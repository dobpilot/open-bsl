Перем ОбщийПараметрПробы;

Процедура ИзменитьСОшибкойПробы(ПараметрПробы)
    ПараметрПробы = 77;
    ВызватьИсключение "ожидаемая ошибка пробы";
КонецПроцедуры

Процедура ПробаОшибкиАргументов()
    ЛокальныйПараметрПробы = 1;
    Попытка
        ИзменитьСОшибкойПробы(ЛокальныйПараметрПробы);
    Исключение
    КонецПопытки;
    Сообщить("argument.local.error" + Символ(9) + Строка(ЛокальныйПараметрПробы));
    ОбщийПараметрПробы = 1;
    Попытка
        ИзменитьСОшибкойПробы(ОбщийПараметрПробы);
    Исключение
    КонецПопытки;
    Сообщить("argument.module.error" + Символ(9) + Строка(ОбщийПараметрПробы));
КонецПроцедуры

Процедура ПроверитьОбщийПараметр(ПараметрПробы)
    ПараметрПробы = 31;
    Сообщить("argument.module.inside" + Символ(9) + Строка(ОбщийПараметрПробы));
КонецПроцедуры

Процедура ПроверитьДваПараметра(ПервыйПараметрПробы, ВторойПараметрПробы)
    ПервыйПараметрПробы = 41;
    Сообщить("argument.module.alias" + Символ(9) + Строка(ВторойПараметрПробы));
    ВторойПараметрПробы = 42;
КонецПроцедуры

Процедура ПробаВидимостиАргументов()
    ОбщийПараметрПробы = 1;
    ПроверитьОбщийПараметр(ОбщийПараметрПробы);
    Сообщить("argument.module.after" + Символ(9) + Строка(ОбщийПараметрПробы));
    ОбщийПараметрПробы = 1;
    ПроверитьДваПараметра(ОбщийПараметрПробы, ОбщийПараметрПробы);
    Сообщить("argument.module.alias_after" + Символ(9) + Строка(ОбщийПараметрПробы));
КонецПроцедуры

Сообщить("file.begin" + Символ(9) + "module-reference-arguments-1");
Попытка
    ПробаОшибкиАргументов();
    ПробаВидимостиАргументов();
Исключение
    Сообщить("file.setup_error" + Символ(9) + ИнформацияОбОшибке().Описание);
КонецПопытки;
Сообщить("file.end" + Символ(9) + "module-reference-arguments-1");
