// Повтор имени поля в конструкторе структуры: литерал и вычисляемый список.

Процедура М(Ид, Значение)
	Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры

Функция ОтметитьЗначение(Число, Порядок)
	Порядок.Добавить(Число);
	Возврат Число;
КонецФункции

РезультатЛитерала = "error";
Попытка
	СтруктураЛитерала = Новый Структура("Поле,поле", 1, 2);
	РезультатЛитерала = Строка(СтруктураЛитерала.Количество()) + ":" + Строка(СтруктураЛитерала.Поле);
Исключение
КонецПопытки;
М("STRUCTURE.DUPLICATE.LITERAL", РезультатЛитерала);

РезультатВычисляемого = "error";
Попытка
	ИменаДубль = "Поле,поле";
	СтруктураВычисляемая = Новый Структура(ИменаДубль, 1, 2);
	РезультатВычисляемого = Строка(СтруктураВычисляемая.Количество()) + ":" + Строка(СтруктураВычисляемая.Поле);
Исключение
КонецПопытки;
М("STRUCTURE.DUPLICATE.COMPUTED", РезультатВычисляемого);

РезультатБезЗначений = "error";
Попытка
	СтруктураБезЗначений = Новый Структура("Поле,поле");
	РезультатБезЗначений = Строка(СтруктураБезЗначений.Количество()) + ":" + Строка(СтруктураБезЗначений.Поле);
Исключение
КонецПопытки;
М("STRUCTURE.DUPLICATE.NO_VALUES", РезультатБезЗначений);

РезультатПорядка = "error";
Попытка
	СтруктураПорядка = Новый Структура("А,Б,а", 1, 2, 3);
	ИменаПоПорядку = "";
	Для Каждого Пара Из СтруктураПорядка Цикл
		ИменаПоПорядку = ИменаПоПорядку + Пара.Ключ;
	КонецЦикла;
	РезультатПорядка = ИменаПоПорядку + ":" + Строка(СтруктураПорядка.А) + ":" + Строка(СтруктураПорядка.Б);
Исключение
КонецПопытки;
М("STRUCTURE.DUPLICATE.ORDER", РезультатПорядка);

РезультатВставки = "error";
Попытка
	СтруктураВставки = Новый Структура("А", 1);
	СтруктураВставки.Вставить("а", 2);
	Для Каждого Пара Из СтруктураВставки Цикл
		РезультатВставки = Пара.Ключ + ":" + Строка(Пара.Значение);
	КонецЦикла;
Исключение
КонецПопытки;
М("STRUCTURE.DUPLICATE.INSERT_SPELLING", РезультатВставки);

РезультатФиксированной = "error";
Попытка
	ИсходнаяСтруктура = Новый Структура("А,а", 1, 2);
	ФиксированнаяКопия = Новый ФиксированнаяСтруктура(ИсходнаяСтруктура);
	ОбратнаяКопия = Новый Структура(ФиксированнаяКопия);
	Для Каждого Пара Из ОбратнаяКопия Цикл
		РезультатФиксированной = Пара.Ключ + ":" + Строка(Пара.Значение);
	КонецЦикла;
Исключение
КонецПопытки;
М("STRUCTURE.DUPLICATE.FIXED_COPY", РезультатФиксированной);

РезультатСериализации = "error";
Попытка
	ИсходнаяСтруктура = Новый Структура("А,а", 1, 2);
	КопияИзСтроки = ЗначениеИзСтрокиВнутр(ЗначениеВСтрокуВнутр(ИсходнаяСтруктура));
	Для Каждого Пара Из КопияИзСтроки Цикл
		РезультатСериализации = Пара.Ключ + ":" + Строка(Пара.Значение);
	КонецЦикла;
Исключение
КонецПопытки;
М("STRUCTURE.DUPLICATE.SERIALIZED_COPY", РезультатСериализации);

РезультатИзоляции = "error";
Попытка
	ПерваяСтруктура = Новый Структура("А", 1);
	ВтораяСтруктура = Новый Структура("А", 2);
	ПерваяСтруктура.Вставить("а", 3);
	Для Каждого Пара Из ВтораяСтруктура Цикл
		РезультатИзоляции = Пара.Ключ + ":" + Строка(Пара.Значение);
	КонецЦикла;
Исключение
КонецПопытки;
М("STRUCTURE.DUPLICATE.ISOLATION", РезультатИзоляции);

РезультатВычислений = "error";
Попытка
	ПорядокВычислений = Новый Массив;
	СтруктураВычислений = Новый Структура("А,а", ОтметитьЗначение(1, ПорядокВычислений), ОтметитьЗначение(2, ПорядокВычислений));
	РезультатВычислений = Строка(ПорядокВычислений[0]) + Строка(ПорядокВычислений[1]) + ":" + Строка(СтруктураВычислений.А);
Исключение
КонецПопытки;
М("STRUCTURE.DUPLICATE.EVALUATION", РезультатВычислений);
