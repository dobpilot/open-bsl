// Oracle: measure/filesystem/file-async-client.platform.txt, find.async.*.
Асинх Процедура ПроверитьАсинхронныйПоиск()
	КореньАсинхПоиска = ПолучитьИмяВременногоФайла(".async-find");
	Попытка
		СоздатьКаталог(КореньАсинхПоиска);
		ДанныеАсинхПоиска = ПолучитьДвоичныеДанныеИзСтроки("abc", КодировкаТекста.UTF8, Ложь);
		ДанныеАсинхПоиска.Записать(КореньАсинхПоиска + "/a.txt");
		ДанныеАсинхПоиска.Записать(КореньАсинхПоиска + "/b.txt");
		ОбещаниеАсинхПоиска = НайтиФайлыАсинх(КореньАсинхПоиска);
		ИмяТипаАсинхПоиска = Строка(ТипЗнч(ОбещаниеАсинхПоиска));
		// Измеренный сеанс печатает Promise, русская локаль — Обещание.
		Сообщить(?(ИмяТипаАсинхПоиска = "Promise" Или ИмяТипаАсинхПоиска = "Обещание", "promise", "bad"));
		РезультатАсинхПоиска = Ждать ОбещаниеАсинхПоиска;
		Сообщить(РезультатАсинхПоиска.Количество());
		Сообщить(?(ТипЗнч(РезультатАсинхПоиска[0]) = Тип("Файл"), "file", "bad"));
		РезультатАсинхПоиска = Ждать НайтиФайлыАсинх(КореньАсинхПоиска, "*.txt");
		Сообщить(РезультатАсинхПоиска.Количество());
		РезультатАсинхПоиска = Ждать FindFilesAsync(КореньАсинхПоиска, "*.txt");
		Сообщить(РезультатАсинхПоиска.Количество());
		РезультатАсинхПоиска = Ждать НайтиФайлыАсинх(КореньАсинхПоиска + "/missing");
		Сообщить(РезультатАсинхПоиска.Количество());
		СтадияАсинхПоиска = "call";
		Попытка
			ОбещаниеАсинхПоиска = НайтиФайлыАсинх(КореньАсинхПоиска, "*.txt", Неопределено);
			СтадияАсинхПоиска = "await";
			РезультатАсинхПоиска = Ждать ОбещаниеАсинхПоиска;
			Сообщить("bad");
		Исключение
			Сообщить(СтадияАсинхПоиска);
		КонецПопытки;
	Исключение
		УдалитьФайлы(КореньАсинхПоиска);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьФайлы(КореньАсинхПоиска);
КонецПроцедуры

ПроверитьАсинхронныйПоиск();
