// Внутренний формат значений: сквозная фикстура для conformance-прогона.
//
// Эталон vstr.expected СНЯТ С ПЛАТФОРМЫ 8.3.27 прогоном этого же файла
// (./tests/conformance/measure/1c/run-on-1c.sh tests/conformance/fixtures/vstr.bsl)
// — здесь только пробы, в которых наша сериализация совпадает с платформой
// побайтово. Порядок пар многоключевого Соответствия намеренно оставлен
// контракту measure-vstr.bsl: его платформа диктует внутренней
// хеш-таблицей, и сходиться он не обязан.

Функция Экр(С)
	С2 = СтрЗаменить(С, Символ(13), "<CR>");
	С2 = СтрЗаменить(С2, Символ(10), "<LF>");
	С2 = СтрЗаменить(С2, Символ(9), "<TAB>");
	Возврат С2;
КонецФункции

Процедура П(Метка, Значение)
	Сообщить(Метка + Символ(9) + Экр(Значение));
КонецПроцедуры

Функция ВС(З)
	Попытка
		Возврат ЗначениеВСтрокуВнутр(З);
	Исключение
		Возврат "<ошибка>";
	КонецПопытки;
КонецФункции

// --- Скаляры ---------------------------------------------------------------
П("VSTR.FORMAT.N.0",        ВС(0));
П("VSTR.FORMAT.N.NEG",      ВС(-42));
П("VSTR.FORMAT.N.PI",       ВС(3.14));
П("VSTR.FORMAT.N.FRAC",     ВС(0.1));
П("VSTR.FORMAT.N.BIG",      ВС(Pow(10, 30)));
П("VSTR.FORMAT.N.TIE",      ВС(1 / 268435456));
П("VSTR.FORMAT.S.EMPTY",    ВС(""));
П("VSTR.FORMAT.S.QUOTE",    ВС("а""б"));
П("VSTR.FORMAT.S.BRACE",    ВС("а{б}в,г"));
П("VSTR.FORMAT.S.LF",       ВС("а" + Символ(10) + "б"));
П("VSTR.FORMAT.S.TAB",      ВС("а" + Символ(9) + "б"));
П("VSTR.FORMAT.B.TRUE",     ВС(Истина));
П("VSTR.FORMAT.B.FALSE",    ВС(Ложь));
П("VSTR.FORMAT.D.EMPTY",    ВС('00010101'));
П("VSTR.FORMAT.D.DATETIME", ВС('20240506070809'));
П("VSTR.FORMAT.U",          ВС(Неопределено));
П("VSTR.FORMAT.L",          ВС(NULL));

// --- Тип как значение ------------------------------------------------------
П("VSTR.FORMAT.T.STRING",    ВС(Тип("Строка")));
П("VSTR.FORMAT.T.NUMBER",    ВС(Тип("Число")));
П("VSTR.FORMAT.T.DATE",      ВС(Тип("Дата")));
П("VSTR.FORMAT.T.BOOLEAN",   ВС(Тип("Булево")));
П("VSTR.FORMAT.T.ARRAY",     ВС(Тип("Массив")));
П("VSTR.FORMAT.T.STRUCTURE", ВС(Тип("Структура")));
П("VSTR.FORMAT.T.MAP",       ВС(Тип("Соответствие")));

// --- Коллекции -------------------------------------------------------------
ПустойМассив = Новый Массив;
П("VSTR.FORMAT.ARR.EMPTY", ВС(ПустойМассив));

ПростойМассив = Новый Массив;
ПростойМассив.Добавить(1);
ПростойМассив.Добавить("а");
П("VSTR.FORMAT.ARR.SIMPLE", ВС(ПростойМассив));

Вложенный = Новый Массив;
Вложенный.Добавить(ПростойМассив);
Вложенный.Добавить(2);
П("VSTR.FORMAT.ARR.NESTED", ВС(Вложенный));

П("VSTR.FORMAT.STRUCT.EMPTY", ВС(Новый Структура));
П("VSTR.FORMAT.STRUCT.TWO",   ВС(Новый Структура("Азбука, Б", 1, "х")));

П("VSTR.FORMAT.MAP.EMPTY", ВС(Новый Соответствие));
Одиночное = Новый Соответствие;
Одиночное.Вставить("к", 5);
П("VSTR.FORMAT.MAP.ONE", ВС(Одиночное));

// --- Повторные вхождения (ссылочная целостность) ----------------------------
// Измерено: платформа разворачивает повторы в копии; пробы фиксируют это.
Внутренний = Новый Массив;
Внутренний.Добавить(7);
Дважды = Новый Массив;
Дважды.Добавить(Внутренний);
Дважды.Добавить(Внутренний);
П("VSTR.FORMAT.REF.TWICE", ВС(Дважды));

Обёртка = Новый Массив;
Обёртка.Добавить(Внутренний);
Уровни = Новый Массив;
Уровни.Добавить(Обёртка);
Уровни.Добавить(Внутренний);
П("VSTR.FORMAT.REF.LEVELS", ВС(Уровни));

// --- Обратный путь ---------------------------------------------------------
Р = "";
Попытка
	Обратно = ЗначениеИзСтрокиВнутр(ВС(Дважды));
	Обратно[0].Добавить(99);
	// «1» = повторы прочитаны копиями (изменение первого не видно во
	// втором) — так ведёт себя платформа.
	Р = Формат(Обратно[1].Количество(), "ЧГ=0");
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("VSTR.FORMAT.RT.IDENTITY", Р);

Р = "";
Попытка
	Др = ЗначениеИзСтрокиВнутр(ВС(0.1));
	Р = Формат(Др, "ЧГ=0; ЧРД=.") + "|" + ТипЗнч(Др);
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("VSTR.FORMAT.RT.FRAC", Р);

Р = "";
Попытка
	Дт = ЗначениеИзСтрокиВнутр(ВС('20240506070809'));
	// Дата после обратного чтения сериализуется в ту же строку — и тип,
	// и значение пережили дорогу туда-обратно.
	Р = ВС(Дт) + "|" + ТипЗнч(Дт);
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("VSTR.FORMAT.RT.DATE", Р);

Р = "";
Попытка
	Стр = ЗначениеИзСтрокиВнутр(ВС(Новый Структура("Поле", 3)));
	Р = Формат(Стр.Поле, "ЧГ=0") + "|" + ТипЗнч(Стр);
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("VSTR.FORMAT.RT.STRUCT", Р);

// Плотная запись без переводов строк обязана читаться так же.
Р = "";
Попытка
	Плотно = ЗначениеИзСтрокиВнутр("{""S"",""плотно""}");
	Р = Плотно;
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("VSTR.FORMAT.RT.DENSE", Р);

// Двойная сериализация — экранирование сериализации внутри строки.
П("VSTR.FORMAT.NESTED", ВС(ВС("а""б")));

// Мусор — ошибка на обеих сторонах.
Р = "";
Попытка
	Х = ЗначениеИзСтрокиВнутр("не формат");
	Р = "принято";
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("VSTR.FORMAT.ERR.GARBAGE", Р);

// --- ТаблицаЗначений --------------------------------------------------------
ТЗ = Новый ТаблицаЗначений;
ТЗ.Колонки.Добавить("Имя");
ТЗ.Колонки.Добавить("Возраст", Новый ОписаниеТипов("Число"));
Стр1 = ТЗ.Добавить();
Стр1.Имя = "Аня";
Стр1.Возраст = 7;
Стр2 = ТЗ.Добавить();
Стр2.Имя = "Боря";
Стр2.Возраст = 9;
П("VSTR.FORMAT.VT.TWO", ВС(ТЗ));

П("VSTR.FORMAT.VT.EMPTY", ВС(Новый ТаблицаЗначений));

// Пропуски: хвостовое Неопределено отброшено, внутреннее — явным {"U"}.
ПропускиТЗ = Новый ТаблицаЗначений;
ПропускиТЗ.Колонки.Добавить("А");
ПропускиТЗ.Колонки.Добавить("Б");
ПропускиТЗ.Колонки.Добавить("В");
СтрП = ПропускиТЗ.Добавить();
СтрП.А = 1;
СтрП.В = 3;
П("VSTR.FORMAT.VT.GAPS", ВС(ПропускиТЗ));

// Обратный путь ТЗ: содержимое и Неопределено в середине выживают.
Р = "";
Попытка
	ОбрТЗ = ЗначениеИзСтрокиВнутр(ВС(ПропускиТЗ));
	Р = ТипЗнч(ОбрТЗ) + "|" + Строка(ОбрТЗ[0].А) + "|" + Строка(ОбрТЗ[0].Б) + "|" + Строка(ОбрТЗ[0].В);
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("VSTR.FORMAT.VT.RT", Р);

// --- Ссылки объектов базы ---------------------------------------------------
// Формат снят на конфигурации измерительной базы (справочник «Тестовый»,
// документ «ТестовыйДокумент», перечисление «Цвета»): вид ссылки —
// {"#",<uuid типа>,<код класса>:<32 hex>}. Наша сторона хранит ссылку
// непрозрачно; транзит на обеих сторонах обязан вернуть строку байт в байт.
СсылкаТекст = "{""#"",c0c2cbee-990e-410d-9c63-b5222c1dacba,53:866e48f17f20bbba11f190e0bddf9004}";
Р = "";
Попытка
	Если ЗначениеВСтрокуВнутр(ЗначениеИзСтрокиВнутр(СсылкаТекст)) = СсылкаТекст Тогда
		Р = "Ок";
	Иначе
		Р = "изменился";
	КонецЕсли;
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("VSTR.FORMAT.REF.TRANSIT", Р);

ТипСсылкиТекст = "{""T"",67ca3817-4032-4140-ba35-d1324b0d84ed}";
Р = "";
Попытка
	Если ЗначениеВСтрокуВнутр(ЗначениеИзСтрокиВнутр(ТипСсылкиТекст)) = ТипСсылкиТекст Тогда
		Р = "Ок";
	Иначе
		Р = "изменился";
	КонецЕсли;
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("VSTR.FORMAT.REF.TYPE", Р);

// --- Составной тип ----------------------------------------------------------
// Порядок задания не влияет: платформа пишет буквы канонически (B,S,D,N) —
// измерено на всех перестановках; обе пробы обязаны дать одну строку.
СоставнаяТЗ1 = Новый ТаблицаЗначений;
СоставнаяТЗ1.Колонки.Добавить("К", Новый ОписаниеТипов("Число,Строка"));
П("VSTR.FORMAT.CMP.NS", ВС(СоставнаяТЗ1));

СоставнаяТЗ2 = Новый ТаблицаЗначений;
СоставнаяТЗ2.Колонки.Добавить("К", Новый ОписаниеТипов("Строка,Число"));
П("VSTR.FORMAT.CMP.SN", ВС(СоставнаяТЗ2));

// Значение ОписаниеТипов само по себе.
П("VSTR.FORMAT.CMP.VALUE", ВС(Новый ОписаниеТипов("Число,Строка")));
П("VSTR.FORMAT.CMP.EMPTY", ВС(Новый ОписаниеТипов("")));

// Обратный путь: тип и состав выживают.
Р = "";
Попытка
	ОбрОписание = ЗначениеИзСтрокиВнутр(ВС(Новый ОписаниеТипов("Число,Строка")));
	Р = ТипЗнч(ОбрОписание) + "|" + ВС(ОбрОписание);
Исключение
	Р = "<ошибка>";
КонецПопытки;
П("VSTR.FORMAT.CMP.RT", Р);
