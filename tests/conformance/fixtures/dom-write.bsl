Исходный = "<?xml version=""1.0""?>
	|<к:каталог xmlns:к=""urn:каталог"" xmlns=""urn:товар"" версия=""1"">
	|	<товар ид=""1""><имя>Стол</имя><цена>1200</цена></товар>
