// DOM на запись: создание узлов у ДокументDOM, мутация разобранного дерева
// и круговой рейс XML -> DOM -> XML через ЗаписьDOM.
//
// Эталон снят на 8.3.27 (dom-write.platform.txt) — не сгенерирован этой
// реализацией.

Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Р = СтрЗаменить(Р, Символ(10), "<ПС>");
	Р = СтрЗаменить(Р, Символ(9), "<Т>");
	Возврат Р;
КонецФункции

Функция ВXML(Узел)
	Писатель = Новый ЗаписьDOM;
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	Писатель.Записать(Узел, Запись);
	Возврат Запись.Закрыть();
КонецФункции

Процедура ПечатьДерева(Узел, Уровень)
	Отступ = "";
	Для н = 1 По Уровень Цикл
		Отступ = Отступ + "  ";
	КонецЦикла;
	Строчка = Отступ + Строка(Узел.ТипУзла) + " «" + Узел.ИмяУзла + "»";
	Строчка = Строчка + " лок=«" + Узел.ЛокальноеИмя + "» префикс=«" + Узел.Префикс
		+ "» URI=«" + Узел.URIПространстваИмен + "»";
	Строчка = Строчка + " значение=«" + Видимо(Строка(Узел.ЗначениеУзла)) + "»";
	Сообщить(Строчка);
	Если Узел.ЕстьАтрибуты() Тогда
		Для Каждого Атрибут Из Узел.Атрибуты Цикл
			Сообщить(Отступ + "  @ «" + Атрибут.ИмяУзла + "» = «" + Атрибут.Значение
				+ "» лок=«" + Атрибут.ЛокальноеИмя + "» URI=«" + Атрибут.URIПространстваИмен + "»");
		КонецЦикла;
	КонецЕсли;
	Для Каждого Ребёнок Из Узел.ДочерниеУзлы Цикл
		ПечатьДерева(Ребёнок, Уровень + 1);
	КонецЦикла;
КонецПроцедуры

