Замена = Дерево.СоздатьЭлемент("замена");
Старый = Корень.ЗаменитьДочерний(Замена, Первый);
Сообщить("замена вернула старый узел: «" + Старый.ИмяУзла + "» ид «"
	+ Строка(Старый.ПолучитьАтрибут("ид")) + "», родитель " + Строка(Старый.РодительскийУзел));

Корень.УстановитьАтрибут("версия", "3");
