// Контракт ЗАПИСИ табличного документа в PDF: `Записать(Путь,
// ТипФайлаТабличногоДокумента.PDF)`, свойства страницы (ориентация и
// четыре поля) и то, что получившийся файл — действительно PDF.
//
// Эталон снимается ТОЛЬКО платформой:
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/fixtures/pdf-write.bsl
//   diff tests/conformance/fixtures/pdf-write.expected \
//        tests/conformance/fixtures/pdf-write.platform.txt
//
// ЧЕГО ЗДЕСЬ НЕТ И ПОЧЕМУ:
//
//   * размер файла — платформа встраивает подмножество системного шрифта,
//     мы опираемся на базовые четырнадцать, и совпасть эти числа не
//     обязаны ни при какой раскладке; сравнивается сигнатура, а число
//     страниц НАШЕГО файла платформа читает своим `ДокументPDF` в
//     `tests/conformance/measure/measure-pdf-write.bsl`;
//   * текст ЧУЖОЙ ошибки — он у сторон разный, печатается только сам факт
//     отказа;
//   * форматы, которые платформа умеет, а мы нет (ODS, HTML, DOCX и
//     прочие члены перечисления): платформа записала бы их молча, и
//     строка вышла бы разной не из-за ошибки в реализации, а из-за
//     объёма. Отказ на неподдержанном типе проверен юнит-тестом
//     `bsl-rt`.
//
// ШРИФТЫ, РАМКИ И ВЫРАВНИВАНИЕ приходят сюда не присваиванием, а ЧЕРЕЗ
// MXL: `Новый Шрифт`, `Новый Линия`, `Новый Цвет` и перечисления
// `ГоризонтальноеПоложение`/`ТипЛинииЯчейкиТабличногоДокумента` этой
// реализации пока неизвестны — до документа они доходят только чтением
// файла. Поэтому два оформленных документа материализуются из
// шестнадцатеричных строк (это платформенные файлы корпуса
// `tests/conformance/mxl/`: `combo-font-align.mxl` — Arial 10 полужирный
// с выравниванием по центру, `border-all.mxl` — все четыре сплошные
// границы), читаются `Прочитать` и пишутся в PDF. Так раскладка получает
// шрифт, рамку и выравнивание на ОБЕИХ сторонах.
//
// Правила письма те же, что у остальных снимаемых с платформы фикстур:
// метод нельзя звать на результате вызова, всякая проба, способная
// бросить, — в `Попытка`, а имена локальных переменных не должны
// совпадать со свойствами управляемой формы (`Ширина`, `Высота`,
// `Заголовок`), иначе присваивание уйдёт в саму форму.

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

// Первые пять байтов файла: сигнатура обязана совпасть у обеих сторон.
Функция Сигнатура(Путь)
	Попытка
		Буфер = Новый БуферДвоичныхДанных(5);
		Поток = ФайловыеПотоки.ОткрытьДляЧтения(Путь);
		Поток.Прочитать(Буфер, 0, 5);
		Поток.Закрыть();
		Итог = "";
		Для Сч = 0 По 4 Цикл
			Итог = Итог + Символ(Буфер[Сч]);
		КонецЦикла;
		Возврат Итог;
	Исключение
		Возврат "<нет файла>";
	КонецПопытки;
КонецФункции

// Документ, собираемый средствами, доступными обеим сторонам: текст,
// объединение, ширины колонок и высота строки.
Функция СобратьОтчёт()
	Док = Новый ТабличныйДокумент;

	Шапка = Док.Область(1, 1, 1, 3);
	Шапка.Текст = "Накладная № 7 от 14 августа";
	Шапка.Объединить();

	Док.Область(2, 1, 2, 1).Текст = "Товар";
	Док.Область(2, 2, 2, 2).Текст = "Кол-во";
	Док.Область(2, 3, 2, 3).Текст = "Цена";

	Док.Область(3, 1, 3, 1).Текст = "Гвоздь строительный";
	Док.Область(3, 2, 3, 2).Текст = "100";
	Док.Область(3, 3, 3, 3).Текст = "123,45";
	Док.Область(4, 1, 4, 1).Текст = "Шуруп универсальный";
	Док.Область(4, 2, 4, 2).Текст = "250";
	Док.Область(4, 3, 4, 3).Текст = "67,89";

	Док.Область(5, 1, 5, 1).Текст = "Итого";
	Док.Область(5, 3, 5, 3).Текст = "191,34";

	Док.Область(1, 1, 1, 1).ШиринаКолонки = 30;
	Док.Область(1, 2, 1, 2).ШиринаКолонки = 12;
	Док.Область(1, 3, 1, 3).ШиринаКолонки = 12;
	Док.Область(1, 1, 1, 1).ВысотаСтроки = 24;

	Возврат Док;
КонецФункции

// Байты из шестнадцатеричной строки в файл — тем же способом, что в
// `zip-read` и `measure-zip-write.bsl`.
Функция Материализовать(Путь, Шестнадцатеричный)
	Буфер = Новый БуферДвоичныхДанных(СтрДлина(Шестнадцатеричный) / 2);
	Для Сч = 0 По Буфер.Размер - 1 Цикл
		Буфер[Сч] = ЧислоИзШестнадцатеричнойСтроки("0x" + Сред(Шестнадцатеричный, Сч * 2 + 1, 2));
	КонецЦикла;
	Поток = ФайловыеПотоки.Создать(Путь);
	Поток.Записать(Буфер, 0, Буфер.Размер);
	Поток.Закрыть();
	Возврат Путь;
КонецФункции

