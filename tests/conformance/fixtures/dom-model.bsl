// Модель узлов DOM на чтение: построение дерева из ЧтениеXML, обход,
// атрибуты и пространства имён.
//
// Эталон снят на 8.3.27 (dom-model.platform.txt) — не сгенерирован этой
// реализацией.

Функция Отступ(Уровень)
	Р = "";
	Для н = 1 По Уровень Цикл
		Р = Р + "  ";
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Р = СтрЗаменить(Р, Символ(10), "<ПС>");
	Р = СтрЗаменить(Р, Символ(9), "<Т>");
	Возврат Р;
КонецФункции

Процедура ПечатьУзла(Узел, Уровень)
	Строчка = Отступ(Уровень) + Строка(Узел.ТипУзла) + " «" + Узел.ИмяУзла + "»";
	Строчка = Строчка + " лок=«" + Узел.ЛокальноеИмя + "»";
	Строчка = Строчка + " префикс=«" + Узел.Префикс + "»";
	Строчка = Строчка + " URI=«" + Узел.URIПространстваИмен + "»";
	Строчка = Строчка + " значение=«" + Видимо(Строка(Узел.ЗначениеУзла)) + "»";
	Сообщить(Строчка);
	Если Узел.ЕстьАтрибуты() Тогда
		Для Каждого Атрибут Из Узел.Атрибуты Цикл
			Сообщить(Отступ(Уровень + 1) + "@ «" + Атрибут.ИмяУзла + "» = «" + Атрибут.Значение
				+ "» лок=«" + Атрибут.ЛокальноеИмя + "» префикс=«" + Атрибут.Префикс
				+ "» URI=«" + Атрибут.URIПространстваИмен + "»");
		КонецЦикла;
	КонецЕсли;
	Для Каждого Ребёнок Из Узел.ДочерниеУзлы Цикл
		ПечатьУзла(Ребёнок, Уровень + 1);
	КонецЦикла;
КонецПроцедуры

Текст = "<?xml version=""1.0"" encoding=""UTF-8""?>
	|<?обработка данные инструкции?>
	|<к:каталог xmlns:к=""urn:каталог"" xmlns=""urn:товар"" версия=""2"" к:код=""АБВ"">
	|	<товар ид=""1"">
	|		<имя>Стол</имя>
	|		<цена валюта=""руб"">1200.50</цена>
	|		<!--комментарий о товаре-->
	|		<описание>дуб<![CDATA[ & металл]]>, сборка</описание>
	|	</товар>
	|	<товар ид=""2"">
	|		<имя>Стул</имя>
	|		<цена валюта=""usd"">45</цена>
	|		<описание>раз<!--разрыв-->два</описание>
	|	</товар>
	|	<пусто/>
	|</к:каталог>
	|<!--хвостовой комментарий-->";

Построитель = Новый ПостроительDOM;
Чтение = Новый ЧтениеXML;
Чтение.УстановитьСтроку(Текст);
Документ = Построитель.Прочитать(Чтение);

Сообщить("=== документ ===");
Сообщить("тип значения: " + Строка(ТипЗнч(Документ)));
Сообщить("представление: " + Строка(Документ));
Сообщить("имя узла: " + Документ.ИмяУзла);
Сообщить("версия XML: " + Документ.ВерсияXML);
Сообщить("детей: " + Строка(Документ.ДочерниеУзлы.Количество()));
Сообщить("есть атрибуты: " + Строка(Документ.ЕстьАтрибуты()));
Сообщить("родитель: " + Строка(Документ.РодительскийУзел));
Сообщить("владелец — сам документ: " + Строка(Документ.ДокументВладелец = Документ));
Сообщить("читатель исчерпан: " + Строка(Чтение.Прочитать()) + " " + Строка(Чтение.ТипУзла));

Сообщить("=== дерево ===");
Для Каждого Узел Из Документ.ДочерниеУзлы Цикл
	ПечатьУзла(Узел, 0);
КонецЦикла;

Корень = Документ.ЭлементДокумента;

Сообщить("=== навигация ===");
Сообщить("корень: " + Корень.ИмяУзла + ", родитель " + Корень.РодительскийУзел.ИмяУзла);
Сообщить("первый дочерний: " + Корень.ПервыйДочерний.ИмяУзла);
Сообщить("последний дочерний: " + Корень.ПоследнийДочерний.ИмяУзла);
Сообщить("сосед первого: " + Корень.ПервыйДочерний.СледующийСоседний.ИмяУзла);
Сообщить("предыдущий последнего: " + Корень.ПоследнийДочерний.ПредыдущийСоседний.ИмяУзла);
Сообщить("до первого: " + Строка(Корень.ПервыйДочерний.ПредыдущийСоседний));
Сообщить("после последнего: " + Строка(Корень.ПоследнийДочерний.СледующийСоседний));
Сообщить("тождество: " + Строка(Корень.ПервыйДочерний = Корень.ДочерниеУзлы[0]));
Сообщить("два списка: " + Строка(Корень.ДочерниеУзлы = Корень.ДочерниеУзлы));
Сообщить("владелец документа у корня: " + Строка(Корень.ДокументВладелец = Документ));

Сообщить("=== пространства имён ===");
Сообщить("корень: имя «" + Корень.ИмяУзла + "» лок «" + Корень.ЛокальноеИмя
	+ "» префикс «" + Корень.Префикс + "» URI «" + Корень.URIПространстваИмен + "»");
Товар = Корень.ПервыйДочерний;
Сообщить("товар: имя «" + Товар.ИмяУзла + "» лок «" + Товар.ЛокальноеИмя
	+ "» префикс «" + Товар.Префикс + "» URI «" + Товар.URIПространстваИмен + "»");

Сообщить("=== атрибуты ===");
Сообщить("атрибутов у корня: " + Строка(Корень.Атрибуты.Количество()));
Сообщить("версия по имени: " + Строка(Корень.ПолучитьАтрибут("версия")));
Сообщить("к:код полным именем: " + Строка(Корень.ПолучитьАтрибут("к:код")));
Сообщить("к:код локальным именем: " + Строка(Корень.ПолучитьАтрибут("код")));
Сообщить("к:код по URI: " + Строка(Корень.ПолучитьАтрибут("urn:каталог", "код")));
Сообщить("версия пустым URI: " + Строка(Корень.ПолучитьАтрибут("", "версия")));
Сообщить("версия чужим URI: " + Строка(Корень.ПолучитьАтрибут("urn:товар", "версия")));
Сообщить("которого нет: " + Строка(Корень.ПолучитьАтрибут("нетТакого")));
Сообщить("есть версия: " + Строка(Корень.ЕстьАтрибут("версия")));
Сообщить("есть к:код полным именем: " + Строка(Корень.ЕстьАтрибут("к:код")));
Сообщить("есть к:код по URI: " + Строка(Корень.ЕстьАтрибут("urn:каталог", "код")));
Сообщить("узел атрибута: " + Строка(ТипЗнч(Корень.ПолучитьУзелАтрибута("версия"))));
Узел = Корень.ПолучитьУзелАтрибута("версия");
Сообщить("владелец атрибута: " + Узел.ЭлементВладелец.ИмяУзла);
Сообщить("родитель атрибута: " + Строка(Узел.РодительскийУзел));
Сообщить("детей у атрибута: " + Строка(Узел.ДочерниеУзлы.Количество())
	+ ", первый «" + Узел.ПервыйДочерний.ЗначениеУзла + "»");
Сообщить("у товара атрибутов: " + Строка(Товар.Атрибуты.Количество())
	+ ", у имени: " + Строка(Товар.ПервыйДочерний.Атрибуты.Количество()));

Сообщить("=== текстовое содержимое ===");
Сообщить("каталог: «" + Видимо(Корень.ТекстовоеСодержимое) + "»");
Сообщить("первый товар: «" + Видимо(Товар.ТекстовоеСодержимое) + "»");
Сообщить("описание с CDATA: «" + Видимо(Товар.ПоследнийДочерний.ТекстовоеСодержимое) + "»");
Сообщить("пустой элемент: «" + Видимо(Корень.ПоследнийДочерний.ТекстовоеСодержимое) + "»");
Сообщить("содержимое документа: " + Строка(Документ.ТекстовоеСодержимое));

Сообщить("=== поиск элементов ===");
Сообщить("товаров: " + Строка(Документ.ПолучитьЭлементыПоИмени("товар").Количество()));
Сообщить("всех элементов: " + Строка(Документ.ПолучитьЭлементыПоИмени("*").Количество()));
Сообщить("по полному имени корня: " + Строка(Документ.ПолучитьЭлементыПоИмени("к:каталог").Количество()));
Сообщить("по локальному имени корня: " + Строка(Документ.ПолучитьЭлементыПоИмени("каталог").Количество()));
Сообщить("цен у корня: " + Строка(Корень.ПолучитьЭлементыПоИмени("цена").Количество()));
Сообщить("которых нет: " + Строка(Документ.ПолучитьЭлементыПоИмени("нетТакого").Количество()));
Валюты = "";
Для Каждого Цена Из Документ.ПолучитьЭлементыПоИмени("цена") Цикл
	Валюты = Валюты + Цена.ПолучитьАтрибут("валюта") + "=" + Цена.ТекстовоеСодержимое + " ";
КонецЦикла;
Сообщить("цены: " + СокрЛП(Валюты));
Сообщить("по идентификатору: " + Строка(Документ.ПолучитьЭлементПоИдентификатору("1")));

Сообщить("=== ошибки ===");
Попытка
	Ч2 = Новый ЧтениеXML;
	Ч2.УстановитьСтроку("<а><б></а>");
	Построитель.Прочитать(Ч2);
	Сообщить("битый XML принят");
Исключение
	Сообщить("битый XML отвергнут");
КонецПопытки;
Попытка
	Ч3 = Новый ЧтениеXML;
	Ч3.УстановитьСтроку("");
	Построитель.Прочитать(Ч3);
	Сообщить("пустой ввод принят");
Исключение
	Сообщить("пустой ввод отвергнут");
КонецПопытки;
Попытка
	Сообщить(Строка(Корень.ДочерниеУзлы[99]));
	Сообщить("индекс за границей принят");
Исключение
	Сообщить("индекс за границей отвергнут");
КонецПопытки;
