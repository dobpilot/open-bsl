// Внутреннее подмножество DTD: чтение потоком, ссылки на сущности и то же
// дерево через ПостроительDOM.
//
// Эталон снят на 8.3.27 (xml-dtd-subset.platform.txt) — не сгенерирован
// этой реализацией.

Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Р = СтрЗаменить(Р, Символ(10), "<ПС>");
	Р = СтрЗаменить(Р, Символ(9), "<Т>");
	Возврат Р;
КонецФункции

// Дамп потока: тип, имя и значение каждого узла, по строке на узел.
Процедура ПрочитатьПотоком(Заголовок, Текст)
	Сообщить("=== " + Заголовок + " ===");
	Попытка
		Читатель = Новый ЧтениеXML;
		Читатель.УстановитьСтроку(Текст);
		Пока Читатель.Прочитать() Цикл
			Строчка = Строка(Читатель.ТипУзла) + " «" + Читатель.Имя + "»";
			Строчка = Строчка + " значение=«" + Видимо(Читатель.Значение) + "»";
			Если Читатель.ТипУзла = ТипУзлаXML.НачалоЭлемента И Читатель.КоличествоАтрибутов() > 0 Тогда
				Для Инд = 0 По Читатель.КоличествоАтрибутов() - 1 Цикл
					Строчка = Строчка + " @" + Читатель.ИмяАтрибута(Инд)
						+ "=«" + Читатель.ЗначениеАтрибута(Инд) + "»";
				КонецЦикла;
			КонецЕсли;
			Сообщить(Строчка);
		КонецЦикла;
		Читатель.Закрыть();
	Исключение
		Сообщить("ошибка чтения");
	КонецПопытки;
КонецПроцедуры

// Итог чтения без поузловой выдачи: прочиталось целиком или нет.
Процедура ПрочитатьЦеликом(Заголовок, Текст)
	Сообщить("=== " + Заголовок + " ===");
	Попытка
		Читатель = Новый ЧтениеXML;
		Читатель.УстановитьСтроку(Текст);
		Пока Читатель.Прочитать() Цикл
		КонецЦикла;
		Читатель.Закрыть();
		Сообщить("прочитано целиком");
	Исключение
		Сообщить("ошибка чтения");
	КонецПопытки;
КонецПроцедуры

// Документ с объявлением типа атрибута ID во внутреннем подмножестве:
// именно на нём наивный пропуск `<!…>` до первого `>` и спотыкался.
ДокументСИд = "<!DOCTYPE к [<!ATTLIST т ид ID #IMPLIED>]><к><т ид=""х""/></к>";
ПрочитатьПотоком("подмножество с ATTLIST", ДокументСИд);

// Ловушки сканера: `>` и `]>` внутри литералов, комментарий и инструкция
// обработки с `]>` внутри, объявления в несколько строк.
ПрочитатьПотоком("ловушки подмножества",
	"<!DOCTYPE к SYSTEM ""нет.dtd"" [" + Символ(10)
	+ "<!ENTITY е ""a>b"">" + Символ(10)
	+ "<!ENTITY ж ""]>"">" + Символ(10)
	+ "<!-- ]> -->" + Символ(10)
	+ "<?пи ]> ?>" + Символ(10)
	+ "<!NOTATION н SYSTEM ""х.exe"">" + Символ(10)
	+ "]><к>т</к>");

// Ссылка на объявленную сущность: в содержимом она отдельный узел и
// разрывает текст, в значении атрибута — подставляется.
ПрочитатьПотоком("ссылки на сущности",
	"<!DOCTYPE к [<!ENTITY е ""хи"">]><к з=""&е;"">раз&е;два</к>");

// Необъявленная сущность — ошибка, даже когда подмножество есть.
// Спрашивается только ИТОГ: платформа отвергает такой документ ДО первого
// узла, а здесь ошибка приходит на той ссылке, где встретилась (см.
// «Сознательные расхождения» в заголовке `bsl-rt/src/xml.rs`), так что
// сравнивать поузловую выдачу тут нечего.
ПрочитатьЦеликом("необъявленная сущность",
	"<!DOCTYPE к [<!ENTITY е ""хи"">]><к>&ж;</к>");

// Ошибка разметки НЕ отменяет уже отданных узлов: чтение потоковое, и
// незакрытый корень выясняется только в конце.
ПрочитатьПотоком("ошибка глубже: незакрытый элемент", "<к><а/>");

// Оборванное подмножество — ошибка, а не молчаливое проглатывание файла.
ПрочитатьЦеликом("подмножество не закрыто",
	"<!DOCTYPE к [<!ELEMENT к EMPTY><к/>");

// То же дерево через ПостроительDOM.
Сообщить("=== дерево DOM ===");
Построитель = Новый ПостроительDOM;
ЧитательДерева = Новый ЧтениеXML;
// Сущность здесь только в содержимом: значение атрибута, ПРИШЕДШЕЕ из
// сущности, платформа хранит в дереве ссылкой и такой же ссылкой пишет
// обратно, а здесь оно уже подставлено — сознательное расхождение,
// описанное в заголовке `bsl-rt/src/dom.rs`.
ЧитательДерева.УстановитьСтроку("<!DOCTYPE к [<!ENTITY е ""хи"">]><к з=""прямо"">раз&е;два</к>");
Дерево = Построитель.Прочитать(ЧитательДерева);
Корень = Дерево.ЭлементДокумента;
Сообщить("корень: " + Корень.ИмяУзла);
Сообщить("атрибут з: «" + Корень.ПолучитьАтрибут("з") + "»");
Сообщить("текстовое содержимое: «" + Корень.ТекстовоеСодержимое + "»");
Для Каждого Ребёнок Из Корень.ДочерниеУзлы Цикл
	Сообщить("  " + Строка(Ребёнок.ТипУзла) + " «" + Ребёнок.ИмяУзла + "»"
		+ " значение=«" + Видимо(Строка(Ребёнок.ЗначениеУзла)) + "»");
КонецЦикла;

// Обратная запись: ссылка возвращается ссылкой, а не текстом замены.
Писатель = Новый ЗаписьXML;
Писатель.УстановитьСтроку();
ЗаписьДерева = Новый ЗаписьDOM;
ЗаписьДерева.Записать(Корень, Писатель);
Сообщить("запись корня: " + Писатель.Закрыть());

// Поиск по идентификатору: атрибут объявлен типом ID во внутреннем
// подмножестве, и всё же элемент не находится.
Сообщить("=== поиск по идентификатору ===");
ПостроительИд = Новый ПостроительDOM;
ЧитательИд = Новый ЧтениеXML;
ЧитательИд.УстановитьСтроку(ДокументСИд);
ДеревоИд = ПостроительИд.Прочитать(ЧитательИд);
Найденный = ДеревоИд.ПолучитьЭлементПоИдентификатору("х");
Если Найденный = Неопределено Тогда
	Сообщить("по идентификатору из DTD: Неопределено");
Иначе
	Сообщить("по идентификатору из DTD: " + Найденный.ИмяУзла);
КонецЕсли;
