// Контракт ЗАПИСИ архивов ZIP из встроенного языка: `ЗаписьZipФайла` и
// `ЗаписьФайлаАрхива`, три режима сохранения путей, маски и рекурсия,
// записи-каталоги, два метода сжатия, комментарий, состояние писателя
// (`Записать`, повторный `Записать`, `ПолучитьДвоичныеДанные`, `Открыть`) и
// круг «записали — прочитали своим же читателем».
//
// Эталон снимается ТОЛЬКО платформой:
//
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/fixtures/zip-write.bsl
//   diff tests/conformance/fixtures/zip-write.expected \
//        tests/conformance/fixtures/zip-write.platform.txt
//
// ЧЕГО ЗДЕСЬ НЕТ И ПОЧЕМУ:
//
//   * размер СЖАТОГО у deflate — реализации разные, и совпадать эти числа
//     не обязаны; у `Копирование` он печатается, потому что там сжатия нет
//     вовсе и число обязано равняться исходному размеру;
//   * даты записей — берутся из времени файлов, созданных прогоном;
//   * пароль, шифрование и метод BZIP2 — платформа их умеет, эта
//     реализация честно отказывает, и сверять тут нечего (отказы
//     проверены юнит-тестами `bsl-rt`);
//   * порядок записей в архиве — он файловой системы (измерено), поэтому
//     всё печатается ПО АЛФАВИТУ.
//
// ДЕРЕВО материализуется распаковкой `zip-write-input.zip` (те же байты —
// шестнадцатеричной строкой ниже; каталогов средствами BSL здесь не
// создать). Происхождение архива — python3, `zipfile`, даты записей
// выставлены в 1980-01-01:
//
//   zf.writestr(info("корень.txt"), "Товар;Цена\nГвоздь;100\nШуруп;250\n")
//   zf.writestr(info("данные.dat", ZIP_STORED), bytes(((i*97+13)&0xFF) for i in range(24)))
//   zf.writestr(info("под/вложенный.txt"), "внутри вложенного\n")
//   zf.writestr(info("под/глубже/глубина.txt"), "на дне\n")
//
// Три правила письма, каждое стоит впустую потраченного прогона: метод
// нельзя звать на результате вызова, всякая проба, способная бросить,
// обязана быть в `Попытка`, а текст чужой ошибки печатать нельзя — он у
// сторон разный.

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

Функция Материализовать(Путь, Шестнадцатеричный)
	Буфер = Новый БуферДвоичныхДанных(СтрДлина(Шестнадцатеричный) / 2);
	Для Сч = 0 По Буфер.Размер - 1 Цикл
		Буфер[Сч] = ЧислоИзШестнадцатеричнойСтроки("0x" + Сред(Шестнадцатеричный, Сч * 2 + 1, 2));
	КонецЦикла;
	Поток = ФайловыеПотоки.Создать(Путь);
	Поток.Записать(Буфер, 0, Буфер.Размер);
	Поток.Закрыть();
	Возврат Путь;
КонецФункции

Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Возврат СтрЗаменить(Р, Символ(10), "<ПС>");
КонецФункции

Функция Прочитать(Путь)
	Попытка
		ДД = Новый ДвоичныеДанные(Путь);
		Возврат Видимо(ПолучитьСтрокуИзДвоичныхДанных(ДД));
	Исключение
		Возврат "<нет файла>";
	КонецПопытки;
КонецФункции

// Сумма байтов файла с весами: независимая от распаковщика проверка
// содержимого (свойства с CRC у элемента архива нет ни у одной стороны).
Функция СуммаБайтов(Путь)
	Попытка
		ДД = Новый ДвоичныеДанные(Путь);
		Размер = ДД.Размер();
		Если Размер = 0 Тогда
			Возврат "0";
		КонецЕсли;
		Буфер = Новый БуферДвоичныхДанных(Размер);
		Поток = ФайловыеПотоки.ОткрытьДляЧтения(Путь);
		Поток.Прочитать(Буфер, 0, Размер);
		Поток.Закрыть();
		Сумма = 0;
		Для Сч = 0 По Буфер.Размер - 1 Цикл
			Сумма = Сумма + Буфер[Сч] * (Сч % 7 + 1);
		КонецЦикла;
		Возврат Ч(Сумма);
	Исключение
		Возврат "<нет файла>";
	КонецПопытки;
КонецФункции

Функция ПоАлфавиту(Имена)
	Для Сч = 1 По Имена.Количество() - 1 Цикл
		Текущее = Имена[Сч];
		Поз = Сч - 1;
		Пока Поз >= 0 И Имена[Поз] > Текущее Цикл
			Имена[Поз + 1] = Имена[Поз];
			Поз = Поз - 1;
		КонецЦикла;
		Имена[Поз + 1] = Текущее;
	КонецЦикла;
	Возврат Имена;
КонецФункции

// Полный путь в имени записи — с фиксированным корнем: печатать временный
// путь целиком незачем, а вот то, что он ложится БЕЗ ведущего слэша, важно.
Функция БезКорня(Имя, Корень)
	Возврат СтрЗаменить(Имя, Сред(Корень, 2) + "/", "<корень>/");
КонецФункции

// Перечислить архив: имена по алфавиту и размер несжатого.
Процедура Перечислить(Метка, Путь, Корень, СоСжатым)
	Попытка
		Чт = Новый ЧтениеФайлаАрхива(Путь);
	Исключение
		П(Метка, "<не открылся>");
		Возврат;
	КонецПопытки;
	Колл = Чт.Элементы;
	П(Метка, "записей " + Ч(Колл.Количество()) + ", комментарий [" + Чт.Комментарий + "]");
	Строки = Новый Массив;
	Для Каждого Элемент Из Колл Цикл
		Описание = "[" + БезКорня(Элемент.ПолноеИмя, Корень) + "] разм " + Ч(Элемент.РазмерНесжатого);
		Если СоСжатым Тогда
			Описание = Описание + " сжат " + Ч(Элемент.РазмерСжатого);
		КонецЕсли;
		Строки.Добавить(Описание);
	КонецЦикла;
	Строки = ПоАлфавиту(Строки);
	Для Каждого Описание Из Строки Цикл
		П(Метка, "   " + Описание);
	КонецЦикла;
	Чт.Закрыть();
КонецПроцедуры

