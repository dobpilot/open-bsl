// `СериализаторXDTO` над фабрикой из XSD: перевод значений BSL в XML и
// обратно.
//
// Эталон снят с платформы 8.3.27:
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/fixtures/xdto-serializer.bsl
//
// Обвязка та же, что у `xdto-xml-io`: схема пишется во временный файл и
// фабрика строится по нему. Ошибочные случаи печатаются ФАКТОМ («ошибка»),
// а не текстом исключения: у платформы он многострочный и с координатами.
//
// ЧЕГО ЗДЕСЬ НЕТ И ПОЧЕМУ.
//
// * Глобальный `СериализаторXDTO` конфигурации. Он у платформы есть и умеет
//   больше — например, пишет `Массив` типами пакета
//   `http://v8.1c.ru/8.1/data/core`, — но берёт их из метаданных
//   конфигурации, которых здесь нет и не будет.
// * `XMLТип`, `XMLТипЗнч`, `ВозможностьЧтенияXML`: они у платформы есть и
//   отдают `ТипДанныхXML`, а этого типа здесь нет — вызов даёт ошибку с
//   обеих сторон, но по разным причинам, поэтому в фикстуре его нет.
// * `УникальныйИдентификатор` и значение `Тип`: платформа их пишет
//   (`<UUID>` и `<Type>` того же пакета), здесь первого типа нет вовсе, а
//   отображение типов BSL в имена XML замером не снято.

Перем Фаб;
Перем Сер;
Перем НСXSD;

Процедура П(Метка, Значение)
	Сообщить(Метка + ": " + Значение);
КонецПроцедуры

// Переводы строки и табуляции в записанном XML — видимыми, иначе
// построчное сличение с платформой ничего не покажет.
Функция Видимо(Текст)
	Р = СтрЗаменить(Текст, Символ(13), "<ВК>");
	Р = СтрЗаменить(Р, Символ(10), "<ПС>");
	Возврат СтрЗаменить(Р, Символ(9), "<Т>");
КонецФункции

Функция ИсточникСхемы()
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>"
		+ "<xs:schema xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:t=""urn:test"""
		+ " targetNamespace=""urn:test"" elementFormDefault=""qualified"""
		+ " attributeFormDefault=""unqualified"">"
		+ "<xs:complexType name=""RootType""><xs:sequence>"
		+ "<xs:element name=""name"" type=""xs:string""/>"
		+ "</xs:sequence>"
		+ "<xs:attribute name=""id"" type=""xs:int""/>"
		+ "</xs:complexType>"
		+ "</xs:schema>";
КонецФункции

Функция Зап(Что)
	З = Новый ЗаписьXML;
	З.УстановитьСтроку();
	Сер.ЗаписатьXML(З, Что);
	Возврат Видимо(З.Закрыть());
КонецФункции

Функция ЗапИменем(Что, Имя)
	З = Новый ЗаписьXML;
	З.УстановитьСтроку();
	Сер.ЗаписатьXML(З, Что, Имя);
	Возврат Видимо(З.Закрыть());
КонецФункции

Функция ЗапИменемУРИ(Что, Имя, УРИ)
	З = Новый ЗаписьXML;
	З.УстановитьСтроку();
	Сер.ЗаписатьXML(З, Что, Имя, УРИ);
	Возврат Видимо(З.Закрыть());
КонецФункции

// Запись, от которой интересен только исход.
Функция ИсходЗаписи(Что)
	Попытка
		З = Новый ЗаписьXML;
		З.УстановитьСтроку();
		Сер.ЗаписатьXML(З, Что);
	Исключение
		Возврат "ошибка";
	КонецПопытки;
	Возврат "записано";
КонецФункции

Функция Чит(Текст)
	Ч = Новый ЧтениеXML;
	Ч.УстановитьСтроку(Текст);
	Возврат Сер.ПрочитатьXML(Ч);
КонецФункции

Функция ЧитТипом(Текст, БСЛТип)
	Ч = Новый ЧтениеXML;
	Ч.УстановитьСтроку(Текст);
	Возврат Сер.ПрочитатьXML(Ч, БСЛТип);
КонецФункции

Функция ИсходЧтения(Текст)
	Попытка
		Ч = Новый ЧтениеXML;
		Ч.УстановитьСтроку(Текст);
		Сер.ПрочитатьXML(Ч);
	Исключение
		Возврат "ошибка";
	КонецПопытки;
	Возврат "прочитано";
КонецФункции

Функция ИсходЧтенияТипом(Текст, БСЛТип)
	Попытка
		Ч = Новый ЧтениеXML;
		Ч.УстановитьСтроку(Текст);
		Сер.ПрочитатьXML(Ч, БСЛТип);
	Исключение
		Возврат "ошибка";
	КонецПопытки;
	Возврат "прочитано";
КонецФункции

// Круг: значение -> XML -> значение.
Функция Круг(Что)
	Р = Чит(СтрЗаменить(СтрЗаменить(Зап(Что), "<ПС>", ""), "<Т>", ""));
	Возврат Строка(ТипЗнч(Р)) + " [" + Строка(Р) + "]";
КонецФункции

НСXSD = "http://www.w3.org/2001/XMLSchema";
Путь = "/tmp/open-bsl-xdto-serializer.xsd";
Зп = Новый ЗаписьТекста(Путь);
Зп.Записать(ИсточникСхемы());
Зп.Закрыть();

Фаб = СоздатьФабрикуXDTO(Путь);
Сер = Новый СериализаторXDTO(Фаб);

// --- сам сериализатор ------------------------------------------------------

П("тип", Строка(ТипЗнч(Сер)));
П("строка", Строка(Сер));
П("тип по имени", Строка(Тип("СериализаторXDTO")));
П("тип по имени англ", Строка(Тип("XDTOSerializer")));
П("английский конструктор", Строка(ТипЗнч(Новый XDTOSerializer(Фаб))));
П("два не равны", Строка((Новый СериализаторXDTO(Фаб)) = (Новый СериализаторXDTO(Фаб))));
П("равен себе", Строка(Сер = Сер));

// --- запись значений BSL ---------------------------------------------------

П("число", Зап(42));
П("число дробное", Зап(12.50));
П("число длинное", Зап(1/3));
П("число отрицательное", Зап(-0.25));
П("число ноль", Зап(0));
П("строка значение", Зап("аб"));
П("строка пустая", Зап(""));
П("строка с разметкой", Зап("<&>"""));
П("дата", Зап(Дата(2026, 8, 13)));
П("дата со временем", Зап(Дата(2026, 8, 13, 10, 20, 30)));
П("дата пустая", Зап(Дата(1, 1, 1)));
П("булево истина", Зап(Истина));
П("булево ложь", Зап(Ложь));
П("неопределено", Зап(Неопределено));
П("null", Зап(NULL));
П("двоичные", Зап(ПолучитьДвоичныеДанныеИзСтроки("аб")));
П("двоичные 48", Зап(ПолучитьДвоичныеДанныеИзСтроки("012345678901234567890123456789012345678901234567")));
П("двоичные 49", Зап(ПолучитьДвоичныеДанныеИзСтроки("0123456789012345678901234567890123456789012345678")));

// --- имя и пространство имён -----------------------------------------------

П("с именем", ЗапИменем(42, "мой"));
П("с именем и URI", ЗапИменемУРИ(42, "мой", "urn:иное"));
П("с пустым именем", ЗапИменем(42, ""));
П("с пустым именем и URI", ЗапИменемУРИ(42, "", "urn:иное"));
П("с именем и пустым URI", ЗапИменемУРИ(42, "мой", ""));
П("имя с двоеточием", ЗапИменем(42, "t:мой"));
П("неопределено с именем", ЗапИменем(Неопределено, "мой"));
П("null с именем", ЗапИменем(NULL, "мой"));

// --- что сериализатор не пишет ---------------------------------------------

П("массив", ИсходЗаписи(Новый Массив));
П("структура", ИсходЗаписи(Новый Структура("а", 1)));
П("соответствие", ИсходЗаписи(Новый Соответствие));
П("таблица значений", ИсходЗаписи(Новый ТаблицаЗначений));
П("объект XDTO", ИсходЗаписи(Фаб.Создать(Фаб.Тип("urn:test", "RootType"))));
П("значение XDTO", ИсходЗаписи(Фаб.Создать(Фаб.Тип(НСXSD, "int"), "42")));

// --- чтение по имени элемента ----------------------------------------------

П("чт decimal", Строка(ТипЗнч(Чит("<decimal xmlns=""" + НСXSD + """>42</decimal>"))));
П("чт int", Строка(Чит("<int xmlns=""" + НСXSD + """>42</int>")));
П("чт string", "[" + Чит("<string xmlns=""" + НСXSD + """> аб </string>") + "]");
П("чт string пустой", "[" + Чит("<string xmlns=""" + НСXSD + """/>") + "]");
П("чт decimal пустой", Строка(Чит("<decimal xmlns=""" + НСXSD + """/>")));
П("чт boolean", Строка(Чит("<boolean xmlns=""" + НСXSD + """>true</boolean>")));
П("чт boolean единицей", Строка(Чит("<boolean xmlns=""" + НСXSD + """>1</boolean>")));
П("чт date", Строка(Чит("<date xmlns=""" + НСXSD + """>2026-08-13</date>")));
П("чт dateTime", Строка(Чит("<dateTime xmlns=""" + НСXSD + """>2026-08-13T10:20:30</dateTime>")));
П("чт base64", Строка(Чит("<base64Binary xmlns=""" + НСXSD + """>0LDQsQ==</base64Binary>").Размер()));

// --- чтение: во что превращается неизвестное имя ---------------------------

П("чт чужое имя", Строка(ТипЗнч(Чит("<чужой>привет</чужой>"))) + " [" + Чит("<чужой>привет</чужой>") + "]");
П("чт без пространства", Строка(ТипЗнч(Чит("<decimal>42</decimal>"))) + " [" + Чит("<decimal>42</decimal>") + "]");
П("чт UUID", Строка(ТипЗнч(Чит("<UUID xmlns=""http://v8.1c.ru/8.1/data/core"">01234567-89ab-cdef-0123-456789abcdef</UUID>"))));
П("чт Null", Строка(ТипЗнч(Чит("<Null xmlns=""http://v8.1c.ru/8.1/data/core""/>"))));
П("чт тип схемы", ИсходЧтения("<RootType xmlns=""urn:test""><name>аб</name></RootType>"));
П("чт вложенный элемент", ИсходЧтения("<об><decimal xmlns=""" + НСXSD + """>42</decimal></об>"));
П("чт битая лексика", ИсходЧтения("<decimal xmlns=""" + НСXSD + """>аб</decimal>"));

// --- чтение: xsi:nil и xsi:type --------------------------------------------

П("чт nil у decimal", Строка(ТипЗнч(Чит("<decimal xmlns=""" + НСXSD + """ xmlns:xsi=""" + НСXSD + "-instance"" xsi:nil=""true""/>"))));
П("чт nil у чужого", Строка(ТипЗнч(Чит("<чужой xmlns:xsi=""" + НСXSD + "-instance"" xsi:nil=""true""/>"))));
П("чт Undefined без nil", Строка(ТипЗнч(Чит("<Undefined xmlns=""""/>"))));
П("чт xsi:type", Строка(ТипЗнч(Чит("<мой xmlns:xs=""" + НСXSD + """ xmlns:xsi=""" + НСXSD + "-instance"" xsi:type=""xs:decimal"">42</мой>"))));
П("чт xsi:type неизвестный", Строка(ТипЗнч(Чит("<мой xmlns:xs=""" + НСXSD + """ xmlns:xsi=""" + НСXSD + "-instance"" xsi:type=""xs:чепуха"">42</мой>"))));

// --- чтение с заданным типом BSL -------------------------------------------

П("чт типом Число", Строка(ЧитТипом("<что>42</что>", Тип("Число"))));
П("чт типом Число из int", Строка(ЧитТипом("<int xmlns=""" + НСXSD + """>42</int>", Тип("Число"))));
П("чт типом Строка", "[" + ЧитТипом("<что>аб</что>", Тип("Строка")) + "]");
П("чт типом Дата", Строка(ЧитТипом("<что>2026-08-13T10:20:30</что>", Тип("Дата"))));
П("чт типом Булево", Строка(ЧитТипом("<что>true</что>", Тип("Булево"))));
П("чт типом ДвоичныеДанные", Строка(ЧитТипом("<что>0LDQsQ==</что>", Тип("ДвоичныеДанные")).Размер()));
П("чт типом Массив", ИсходЧтенияТипом("<что/>", Тип("Массив")));
П("чт типом Неопределено", ИсходЧтенияТипом("<что/>", Тип("Неопределено")));
П("чт типом битая лексика", ИсходЧтенияТипом("<что>аб</что>", Тип("Число")));

// --- круг ------------------------------------------------------------------

П("круг число", Круг(42));
П("круг дробное", Круг(12.50));
П("круг строка", Круг("аб"));
П("круг дата", Круг(Дата(2026, 8, 13, 10, 20, 30)));
П("круг булево", Круг(Истина));
П("круг неопределено", Круг(Неопределено));
П("круг null", Круг(NULL));
П("круг двоичные", Строка(ТипЗнч(Чит(Зап(ПолучитьДвоичныеДанныеИзСтроки("аб"))))));

// --- позиция читателя ------------------------------------------------------

Ч = Новый ЧтениеXML;
Ч.УстановитьСтроку("<об><decimal xmlns=""" + НСXSD + """>42</decimal><string xmlns=""" + НСXSD + """>аб</string></об>");
Ч.Прочитать();
Ч.Прочитать();
П("двух подряд", Строка(Сер.ПрочитатьXML(Ч)) + "|" + Строка(Сер.ПрочитатьXML(Ч)));

Ч2 = Новый ЧтениеXML;
Ч2.УстановитьСтроку("<decimal xmlns=""" + НСXSD + """>42</decimal>");
Сер.ПрочитатьXML(Ч2);
П("позиция после корня", Строка(Ч2.ТипУзла));
