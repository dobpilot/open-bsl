// ЗаполнитьЗначенияСвойств: перенос значений одноимённых свойств.
//
// Эталон снят с реальной 8.3.27 тем же скриптом run-on-1c.sh, что и
// tests/conformance/measure/. Модель платформы описана в обзоре модуля
// bsl_rt::fill; сюда вынесено то, на что она распадается наблюдаемо.

Функция Ч(Значение)
	Возврат Формат(Значение, "ЧГ=0; ЧРД=.");
КонецФункции

// --- Структура -> структура -------------------------------------------
// Без списка переносится пересечение имён: Цена есть у обоих, Количество
// только у приёмника (не тронуто), Скидка только у источника (пропущена,
// нового поля не появилось).
Приемник = Новый Структура("Цена, Количество", 1, 7);
ЗаполнитьЗначенияСвойств(Приемник, Новый Структура("Цена, Скидка", 100, 5));
Сообщить(Ч(Приемник.Цена) + " " + Ч(Приемник.Количество) + " полей: " + Ч(Приемник.Количество()));

// Имена свойств сравниваются без учёта регистра.
Регистр = Новый Структура("ЦенаТовара", 1);
ЗаполнитьЗначенияСвойств(Регистр, Новый Структура("ценатовара", 42));
Сообщить(Ч(Регистр.ЦенаТовара));

// --- Структура <-> строка таблицы значений ------------------------------
Т = Новый ТаблицаЗначений;
Т.Колонки.Добавить("Цена");
Т.Колонки.Добавить("Количество");
Строка1 = Т.Добавить();
ЗаполнитьЗначенияСвойств(Строка1, Новый Структура("Цена, Количество, Лишнее", 33, 2, "x"));
Сообщить(Ч(Строка1.Цена) + " " + Ч(Строка1.Количество));

// Строка таблицы источником: колонка, которой нет у приёмника, пропущена.
ИзСтроки = Новый Структура("Цена", 0);
ЗаполнитьЗначенияСвойств(ИзСтроки, Строка1);
Сообщить(Ч(ИзСтроки.Цена) + " полей: " + Ч(ИзСтроки.Количество()));

// --- СписокСвойств: требование, а не фильтр ------------------------------
// Перечисленное переносится...
Список = Новый Структура("А, Б", 8, 9);
ЗаполнитьЗначенияСвойств(Список, Новый Структура("А, Б", 1, 2), "А");
Сообщить(Ч(Список.А) + " " + Ч(Список.Б));

// ...а имя, которого нет у одной из сторон, — ошибка, в отличие от того
// же имени вне списка. Ниже все три случая: нет у приёмника, нет у
// источника, нет ни у кого.
Строгий = Новый Структура("А, Б", 8, 9);
Попытка
	ЗаполнитьЗначенияСвойств(Строгий, Новый Структура("А, В", 1, 3), "В");
	Сообщить("нет у приёмника: принято");
Исключение
	Сообщить("нет у приёмника: ошибка");
КонецПопытки;
Попытка
	ЗаполнитьЗначенияСвойств(Строгий, Новый Структура("А", 1), "Б");
	Сообщить("нет у источника: принято");
Исключение
	Сообщить("нет у источника: ошибка");
КонецПопытки;
Попытка
	ЗаполнитьЗначенияСвойств(Строгий, Новый Структура("А", 1), "ТакогоНет");
	Сообщить("нет ни у кого: принято");
Исключение
	Сообщить("нет ни у кого: ошибка");
КонецПопытки;

// Список обходится с конца: что успело записаться до отказа.
Хвост = Новый Структура("А, Б", 8, 9);
Попытка
	ЗаполнитьЗначенияСвойств(Хвост, Новый Структура("А, Б", 1, 2), "А,ТакогоНет,Б");
Исключение
КонецПопытки;
Сообщить("после отказа: " + Ч(Хвост.А) + " " + Ч(Хвост.Б));

// Пустой список не переносит ничего.
Пусто = Новый Структура("А", 8);
ЗаполнитьЗначенияСвойств(Пусто, Новый Структура("А", 1), "");
Сообщить(Ч(Пусто.А));

// --- ИсключаяСвойства ---------------------------------------------------
// Третий аргумент пропущен позиционно — обычная для этой функции форма.
Исключая = Новый Структура("А, Б", 8, 9);
ЗаполнитьЗначенияСвойств(Исключая, Новый Структура("А, Б", 1, 2), , "Б");
Сообщить(Ч(Исключая.А) + " " + Ч(Исключая.Б));

// При заданном СписокСвойств второй список не анализируется.
Оба = Новый Структура("А, Б", 8, 9);
ЗаполнитьЗначенияСвойств(Оба, Новый Структура("А, Б", 1, 2), "А,Б", "Б");
Сообщить(Ч(Оба.А) + " " + Ч(Оба.Б));

// Пробелы вокруг имён в списке значения не имеют.
Пробелы = Новый Структура("А, Б", 8, 9);
ЗаполнитьЗначенияСвойств(Пробелы, Новый Структура("А, Б", 1, 2), " А , Б ");
Сообщить(Ч(Пробелы.А) + " " + Ч(Пробелы.Б));

// --- Английское имя -----------------------------------------------------
Английский = Новый Структура("А", 8);
FillPropertyValues(Английский, Новый Структура("А", 1));
Сообщить(Ч(Английский.А));

// --- Значения без свойств принимаются с обеих сторон --------------------
Попытка
	ЗаполнитьЗначенияСвойств(Новый Массив, Новый Структура("А", 1));
	Сообщить("массив приёмником: принят");
Исключение
	Сообщить("массив приёмником: ошибка");
КонецПопытки;

БезСвойств = Новый Структура("А", 8);
Попытка
	ЗаполнитьЗначенияСвойств(БезСвойств, Новый Массив);
	Сообщить("массив источником: принят, А = " + Ч(БезСвойств.А));
Исключение
	Сообщить("массив источником: ошибка");
КонецПопытки;

// Ключ соответствия свойством не считается.
СоответствиеИсточник = Новый Соответствие;
СоответствиеИсточник.Вставить("А", 7);
ИзСоответствия = Новый Структура("А", 8);
Попытка
	ЗаполнитьЗначенияСвойств(ИзСоответствия, СоответствиеИсточник);
	Сообщить("соответствие источником: принято, А = " + Ч(ИзСоответствия.А));
Исключение
	Сообщить("соответствие источником: ошибка");
КонецПопытки;

// --- Нестроковый список -------------------------------------------------
Попытка
	ЗаполнитьЗначенияСвойств(Новый Структура("А", 1), Новый Структура("А", 2), 5);
	Сообщить("нестроковый список: принят");
Исключение
	Сообщить("нестроковый список: ошибка");
КонецПопытки;
