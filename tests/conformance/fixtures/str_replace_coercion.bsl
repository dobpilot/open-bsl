// Нативный контроль достигнутой замены строки.
Процедура М(Ид, Значение)
    Сообщить(Ид + Символ(9) + Строка(Значение));
КонецПроцедуры
М("STRREPLACE.COERCION.BEGIN", "1");
Попытка
    РезультатПробы = СтрЗаменить(Неопределено, "x", "y");
Исключение
    РезультатПробы = "ERROR";
КонецПопытки;
М("STRREPLACE.COERCION.UNDEFINED.TEXT", РезультатПробы);
Попытка
    РезультатПробы = СтрЗаменить("abc", Неопределено, "y");
Исключение
    РезультатПробы = "ERROR";
КонецПопытки;
М("STRREPLACE.COERCION.UNDEFINED.NEEDLE", РезультатПробы);
Попытка
    РезультатПробы = СтрЗаменить("abc", "b", Неопределено);
Исключение
    РезультатПробы = "ERROR";
КонецПопытки;
М("STRREPLACE.COERCION.UNDEFINED.REPLACEMENT", РезультатПробы);
Попытка
    РезультатПробы = СтрЗаменить(12345, "34", "XX");
Исключение
    РезультатПробы = "ERROR";
КонецПопытки;
М("STRREPLACE.COERCION.NUMBER.TEXT", РезультатПробы);
Попытка
    РезультатПробы = СтрЗаменить("x12345x", 12345, "Q");
Исключение
    РезультатПробы = "ERROR";
КонецПопытки;
М("STRREPLACE.COERCION.NUMBER.NEEDLE", РезультатПробы);
Попытка
    РезультатПробы = СтрЗаменить("ax", "x", 12345);
Исключение
    РезультатПробы = "ERROR";
КонецПопытки;
М("STRREPLACE.COERCION.NUMBER.REPLACEMENT", РезультатПробы);
Попытка
    РезультатПробы = СтрЗаменить(Истина, Строка(Истина), "Q");
Исключение
    РезультатПробы = "ERROR";
КонецПопытки;
М("STRREPLACE.COERCION.BOOLEAN.TEXT", РезультатПробы);
Попытка
    РезультатПробы = СтрЗаменить(Null, "x", "y");
Исключение
    РезультатПробы = "ERROR";
КонецПопытки;
М("STRREPLACE.COERCION.NULL.TEXT", РезультатПробы);
М("STRREPLACE.COERCION.END", "1");
