// Разбор XSD в объектную модель схемы: `ПостроительСхемXML` строит
// `СхемаXML` по готовому дереву DOM, а обход печатает объявления, типы,
// фасеты, модель содержимого и наследование.
//
// Эталон снят с платформы 8.3.27:
//   ./tests/conformance/measure/1c/run-on-1c.sh \
//       tests/conformance/fixtures/xsd-parse.bsl
//
// Всё, что печатается, здесь ИЗМЕРЕНО: и порядок именованных коллекций
// (по имени, а не по документу), и то, что границы вхождения фрагмента
// платформа на этом этапе не заполняет, и типизированное `Значение`
// объявления.

Функция Схема(Текст)
	Построитель = Новый ПостроительDOM;
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(Текст);
	ПостроительСхем = Новый ПостроительСхемXML;
	Возврат ПостроительСхем.СоздатьСхемуXML(Построитель.Прочитать(Чтение));
КонецФункции

// `Фиксированный` есть РОВНО у числовых фасетов: у образца, перечисления
// и пробельных символов платформа этого свойства не знает (измерено), и
// обращение к нему — ошибка, а не `Неопределено`.
Функция ЕстьФиксированный(Фасет)
	Возврат Фасет.ТипКомпоненты <> ТипКомпонентыXS.ФасетОбразца
		И Фасет.ТипКомпоненты <> ТипКомпонентыXS.ФасетПеречисления
		И Фасет.ТипКомпоненты <> ТипКомпонентыXS.ФасетПробельныхСимволов;
КонецФункции

Процедура ПечатьФасетов(ПростойТип)
	Для Каждого Фасет Из ПростойТип.Фасеты Цикл
		Строчка = "    фасет " + Строка(Фасет.ТипКомпоненты)
			+ " = [" + Фасет.ЛексическоеЗначение + "]";
		Если ЕстьФиксированный(Фасет) Тогда
			Строчка = Строчка + " фиксирован: [" + Строка(Фасет.Фиксированный) + "]";
		КонецЕсли;
		Сообщить(Строчка);
	КонецЦикла;
КонецПроцедуры

Процедура ПечатьГруппы(Группа, Отступ)
	Сообщить(Отступ + "группа " + Строка(Группа.ВидГруппы)
		+ ", фрагментов: " + Строка(Группа.Фрагменты.Количество()));
	Для Каждого Фрагмент Из Группа.Компоненты Цикл
		Часть = Фрагмент.Часть;
		Если Часть.ТипКомпоненты = ТипКомпонентыXS.ОбъявлениеЭлемента Тогда
			Сообщить(Отступ + "  элемент " + Часть.Имя
				+ " тип: " + Строка(Часть.ИмяТипа)
				+ " URI: [" + Часть.URIПространстваИмен + "]"
				+ " глобальное: " + Строка(Часть.ЭтоГлобальноеОбъявление));
			Если Часть.АнонимноеОпределениеТипа <> Неопределено Тогда
				Аноним = Часть.АнонимноеОпределениеТипа;
				Сообщить(Отступ + "    анонимный тип: " + Строка(Аноним.ТипКомпоненты)
					+ ", имя: [" + Аноним.Имя + "]"
					+ ", контейнер: " + Строка(ТипЗнч(Аноним.Контейнер)));
				Если Аноним.Содержимое <> Неопределено Тогда
					ПечатьГруппы(Аноним.Содержимое.Часть, Отступ + "    ");
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Часть.ТипКомпоненты = ТипКомпонентыXS.ГруппаМодели Тогда
			ПечатьГруппы(Часть, Отступ + "  ");
		Иначе
			Сообщить(Отступ + "  прочее: " + Строка(Часть.ТипКомпоненты));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Исходник = "<?xml version=""1.0"" encoding=""UTF-8""?>"
	+ "<xs:schema xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:т=""urn:склад"""
	+ " targetNamespace=""urn:склад"" elementFormDefault=""qualified"" version=""2.1"">"
	+ "<xs:annotation><xs:documentation xml:lang=""ru"">Схема склада</xs:documentation></xs:annotation>"
	+ "<xs:element name=""Склад"" type=""т:ТипСклада""/>"
	+ "<xs:element name=""Метка"" type=""xs:string"" default=""нет""/>"
	+ "<xs:attribute name=""Версия"" type=""xs:int"" fixed=""3""/>"
	+ "<xs:simpleType name=""Артикул"">"
	+ "<xs:restriction base=""xs:string"">"
	+ "<xs:minLength value=""2""/><xs:maxLength value=""8"" fixed=""true""/>"
	+ "<xs:pattern value=""[А-Я]{2}-[0-9]+""/><xs:whiteSpace value=""collapse""/>"
	+ "</xs:restriction></xs:simpleType>"
	+ "<xs:simpleType name=""Цвет"">"
	+ "<xs:restriction base=""xs:string"">"
	+ "<xs:enumeration value=""красный""/><xs:enumeration value=""зелёный""/>"
	+ "</xs:restriction></xs:simpleType>"
	+ "<xs:simpleType name=""Артикулы""><xs:list itemType=""т:Артикул""/></xs:simpleType>"
	+ "<xs:simpleType name=""ЧислоИлиСтрока""><xs:union memberTypes=""xs:string xs:int""/></xs:simpleType>"
	+ "<xs:complexType name=""ТипСклада"">"
	+ "<xs:sequence>"
	+ "<xs:element name=""Название"" type=""xs:string""/>"
	+ "<xs:element name=""Артикул"" type=""т:Артикул"" minOccurs=""0"" maxOccurs=""unbounded""/>"
	+ "<xs:element name=""Адрес"">"
	+ "<xs:complexType><xs:sequence>"
	+ "<xs:element name=""Город"" type=""xs:string""/>"
	+ "<xs:element name=""Индекс"" type=""xs:int""/>"
	+ "</xs:sequence></xs:complexType>"
	+ "</xs:element>"
	+ "<xs:choice minOccurs=""0""><xs:element name=""Свой"" type=""xs:string""/>"
	+ "<xs:element name=""Чужой"" type=""xs:string""/></xs:choice>"
	+ "</xs:sequence>"
	+ "<xs:attribute name=""Код"" type=""xs:int"" use=""required""/>"
	+ "<xs:attribute name=""Цвет"" type=""т:Цвет"" default=""красный"" form=""qualified""/>"
	+ "</xs:complexType>"
	+ "<xs:complexType name=""ТипБольшогоСклада"">"
	+ "<xs:complexContent><xs:extension base=""т:ТипСклада"">"
	+ "<xs:sequence><xs:element name=""Площадь"" type=""xs:decimal""/></xs:sequence>"
	+ "</xs:extension></xs:complexContent></xs:complexType>"
	+ "<xs:complexType name=""ТипПометки"">"
	+ "<xs:simpleContent><xs:extension base=""xs:string"">"
	+ "<xs:attribute name=""Автор"" type=""xs:string""/>"
	+ "</xs:extension></xs:simpleContent></xs:complexType>"
	+ "<xs:complexType name=""ТипПустого""/>"
	+ "</xs:schema>";

Сх = Схема(Исходник);

Сообщить("тип значения: " + Строка(Сх) + ", тип: " + Строка(ТипЗнч(Сх)));
Сообщить("пространство имён: " + Сх.ПространствоИмен);
Сообщить("версия: " + Сх.Версия);
Сообщить("форма элементов: " + Строка(Сх.ФормаЭлементовПоУмолчанию));
Сообщить("форма атрибутов: " + Строка(Сх.ФормаАтрибутовПоУмолчанию));
Сообщить("расположение: [" + Сх.РасположениеСхемы + "]");
Сообщить("тип компоненты: " + Строка(Сх.ТипКомпоненты));
Сообщить("схема сама себе: " + Строка(Сх.Схема = Сх));
Сообщить("корень дерева: " + Сх.ЭлементDOM.ИмяУзла);
Сообщить("аннотация: " + Строка(Сх.Аннотация.ТипКомпоненты)
	+ ", документаций: " + Строка(Сх.Аннотация.Документация.Количество())
	+ ", язык: " + Сх.Аннотация.Документация[0].Язык);

Сообщить("");
Сообщить("компоненты в порядке документа:");
Для Каждого Компонента Из Сх.Компоненты Цикл
	// У аннотации имени НЕТ: `Имя` есть только у именованных компонент, и
	// обращение к нему у `АннотацияXS` — ошибка.
	Если Компонента.ТипКомпоненты = ТипКомпонентыXS.Аннотация Тогда
		Сообщить("  " + Строка(Компонента.ТипКомпоненты));
	Иначе
		Сообщить("  " + Строка(Компонента.ТипКомпоненты) + " " + Компонента.Имя);
	КонецЕсли;
КонецЦикла;

Сообщить("");
Сообщить("объявления элементов (" + Строка(Сх.ОбъявленияЭлементов.Количество()) + "):");
Для Каждого Объявление Из Сх.ОбъявленияЭлементов Цикл
	Сообщить("  " + Объявление.Имя
		+ " тип: " + Строка(Объявление.ИмяТипа)
		+ " URI: " + Объявление.URIПространстваИмен
		+ " значение: [" + Объявление.ЛексическоеЗначение + "]"
		+ " ограничение: " + Строка(Объявление.Ограничение));
КонецЦикла;
Метка = Сх.ОбъявленияЭлементов.Получить("Метка");
Сообщить("  Метка типизированно: " + Строка(Метка.Значение)
	+ " (" + Строка(ТипЗнч(Метка.Значение)) + ")");
Сообщить("  поиск по паре: " + Сх.ОбъявленияЭлементов.Получить("urn:склад", "Склад").Имя);
Сообщить("  поиск по расширенному имени: "
	+ Сх.ОбъявленияЭлементов.Получить(Новый РасширенноеИмяXML("urn:склад", "Склад")).Имя);
Сообщить("  поиск чужого: " + Строка(Сх.ОбъявленияЭлементов.Получить("Нет")));
Сообщить("  тождество: " + Строка(Сх.ОбъявленияЭлементов.Получить("Склад")
	= Сх.ОбъявленияЭлементов.Получить("Склад")));

Сообщить("");
Сообщить("объявления атрибутов (" + Строка(Сх.ОбъявленияАтрибутов.Количество()) + "):");
Для Каждого Объявление Из Сх.ОбъявленияАтрибутов Цикл
	Сообщить("  " + Объявление.Имя
		+ " тип: " + Строка(Объявление.ИмяТипа)
		+ " значение: [" + Объявление.ЛексическоеЗначение + "]"
		+ " ограничение: " + Строка(Объявление.Ограничение)
		+ " типизированно: " + Строка(Объявление.Значение));
КонецЦикла;

Сообщить("");
Сообщить("определения типов (" + Строка(Сх.ОпределенияТипов.Количество()) + "):");
Для Каждого Определение Из Сх.ОпределенияТипов Цикл
	Сообщить("  " + Определение.Имя + " — " + Строка(Определение.ТипКомпоненты));
КонецЦикла;

Сообщить("");
Артикул = Сх.ОпределенияТипов.Получить("Артикул");
Сообщить("простой тип " + Артикул.Имя + ":");
Сообщить("  базовый: " + Строка(Артикул.ИмяБазовогоТипа));
Сообщить("  вариант: " + Строка(Артикул.Вариант));
Сообщить("  фасетов: " + Строка(Артикул.Фасеты.Количество()));
ПечатьФасетов(Артикул);
Сообщить("  контейнер — схема: " + Строка(Артикул.Контейнер = Сх));

ТипЦвет = Сх.ОпределенияТипов.Получить("Цвет");
Сообщить("простой тип " + ТипЦвет.Имя + ":");
ПечатьФасетов(ТипЦвет);

Артикулы = Сх.ОпределенияТипов.Получить("Артикулы");
Сообщить("список " + Артикулы.Имя + ": вариант " + Строка(Артикулы.Вариант)
	+ ", тип элемента " + Строка(Артикулы.ИмяТипаЭлемента));

Объединение = Сх.ОпределенияТипов.Получить("ЧислоИлиСтрока");
Сообщить("объединение " + Объединение.Имя + ": вариант " + Строка(Объединение.Вариант)
	+ ", членов " + Строка(Объединение.ИменаТиповОбъединения.Количество()));
Для Каждого Член Из Объединение.ИменаТиповОбъединения Цикл
	Сообщить("  член: " + Строка(Член));
КонецЦикла;

Сообщить("");
Склад = Сх.ОпределенияТипов.Получить("ТипСклада");
Сообщить("составной тип " + Склад.Имя + ":");
Сообщить("  базовый: " + Строка(Склад.ИмяБазовогоТипа)
	+ ", наследование: " + Строка(Склад.МетодНаследования));
Сообщить("  смешанный: " + Строка(Склад.Смешанный)
	+ ", абстрактный: " + Строка(Склад.Абстрактный));
Сообщить("  модель содержимого: " + Строка(Склад.МодельСодержимого));
Фрагмент = Склад.Содержимое;
Сообщить("  содержимое: " + Строка(Фрагмент.ТипКомпоненты)
	+ ", входит от " + Строка(Фрагмент.МинимальноВходит)
	+ " до " + Строка(Фрагмент.МаксимальноВходит));
ПечатьГруппы(Фрагмент.Часть, "  ");
Сообщить("  атрибутов: " + Строка(Склад.Атрибуты.Количество()));
Для Каждого Использование Из Склад.Атрибуты Цикл
	Объявление = Использование.ОбъявлениеАтрибута;
	Сообщить("    " + Объявление.Имя
		+ " тип: " + Строка(Объявление.ИмяТипа)
		+ " обязательный: " + Строка(Использование.Обязательный)
		+ " значение: [" + Использование.ЛексическоеЗначение + "]"
		+ " ограничение: " + Строка(Использование.Ограничение)
		+ " URI: [" + Объявление.URIПространстваИмен + "]");
КонецЦикла;

Сообщить("");
Большой = Сх.ОпределенияТипов.Получить("ТипБольшогоСклада");
Сообщить("наследник " + Большой.Имя + ":");
Сообщить("  базовый: " + Строка(Большой.ИмяБазовогоТипа)
	+ ", метод: " + Строка(Большой.МетодНаследования));
ПечатьГруппы(Большой.Содержимое.Часть, "  ");

Пометка = Сх.ОпределенияТипов.Получить("ТипПометки");
Сообщить("простое содержимое " + Пометка.Имя + ":");
Сообщить("  базовый: " + Строка(Пометка.ИмяБазовогоТипа)
	+ ", метод: " + Строка(Пометка.МетодНаследования)
	+ ", содержимое: " + Строка(Пометка.Содержимое)
	+ ", атрибутов: " + Строка(Пометка.Атрибуты.Количество()));

Пустой = Сх.ОпределенияТипов.Получить("ТипПустого");
Сообщить("пустой тип " + Пустой.Имя + ": содержимое " + Строка(Пустой.Содержимое)
	+ ", компонент " + Строка(Пустой.Компоненты.Количество()));

Сообщить("");
Набор = Новый НаборСхемXML;
Набор.Добавить(Сх);
Сообщить("набор схем: " + Строка(Набор.Количество())
	+ ", та же схема: " + Строка(Набор[0] = Сх));
Набор.Добавить(Сх);
Сообщить("повторное добавление: " + Строка(Набор.Количество()));
Для Каждого СхемаНабора Из Набор Цикл
	Сообщить("  " + СхемаНабора.ПространствоИмен);
КонецЦикла;

Сообщить("");
Сообщить("не схема: " + Строка(Схема("<товар/>")));
Пустая = Новый СхемаXML;
Сообщить("пустая схема: [" + Пустая.ПространствоИмен + "] компонент "
	+ Строка(Пустая.Компоненты.Количество())
	+ ", дерево " + Строка(Пустая.ЭлементDOM));
РасшИмя = Новый РасширенноеИмяXML("urn:склад", "Склад");
Сообщить("расширенное имя: " + Строка(РасшИмя)
	+ " локальное: " + РасшИмя.ЛокальноеИмя
	+ " URI: " + РасшИмя.URIПространстваИмен
	+ " равенство: " + Строка(РасшИмя = Новый РасширенноеИмяXML("urn:склад", "Склад")));
