// --- вложенные ------------------------------------------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.НачатьГруппуСтрок("Внешняя");
	Д.Область(1, 1, 1, 1).Текст = "A";
	Д.НачатьГруппуСтрок("Внутренняя");
	Д.Область(2, 1, 2, 1).Текст = "B";
	Д.ЗакончитьГруппуСтрок();
	Д.ЗакончитьГруппуСтрок();
Исключение
	Сообщить("ВЛОЖЕННЫЕ	ошибка	" + ОписаниеОшибки());
