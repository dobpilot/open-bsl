// РАЗВЕДКА-10: группы строк. Что меняется в блоке от имени, свёрнутости,
// вложенности и числа строк.

Процедура Сохранить(Док, Имя)
	Попытка
		Док.Записать("/tmp/open-bsl-groups/" + Имя + ".mxl", ТипФайлаТабличногоДокумента.MXL);
		Сообщить("СОХР	" + Имя + "	ок	" + Строка(Док.ВысотаТаблицы) + "x" + Строка(Док.ШиринаТаблицы));
	Исключение
		Сообщить("СОХР	" + Имя + "	ошибка	" + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Попытка
	СоздатьКаталог("/tmp/open-bsl-groups");
Исключение
	Сообщить("КАТАЛОГ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

// --- одна группа на одну строку -------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.НачатьГруппуСтрок("Одна");
	Д.Область(1, 1, 1, 1).Текст = "A";
	Д.ЗакончитьГруппуСтрок();
Исключение
	Сообщить("ОДНА	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "g1-one");

// --- та же группа, но на три строки ------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.НачатьГруппуСтрок("Одна");
	Д.Область(1, 1, 1, 1).Текст = "A";
	Д.Область(2, 1, 2, 1).Текст = "B";
	Д.Область(3, 1, 3, 1).Текст = "C";
	Д.ЗакончитьГруппуСтрок();
Исключение
	Сообщить("ТРИ	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "g2-three-rows");

// --- другое имя ------------------------------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.НачатьГруппуСтрок("СовсемДругоеИмя");
	Д.Область(1, 1, 1, 1).Текст = "A";
	Д.ЗакончитьГруппуСтрок();
Исключение
	Сообщить("ИМЯ	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "g3-other-name");

// --- свёрнутая -----------------------------------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
