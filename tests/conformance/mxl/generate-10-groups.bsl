// --- группа без имени ------------------------------------------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.НачатьГруппуСтрок();
	Д.Область(1, 1, 1, 1).Текст = "A";
	Д.ЗакончитьГруппуСтрок();
	Сообщить("БЕЗИМЕНИ	ок");
Исключение
	Сообщить("БЕЗИМЕНИ	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "g7-noname");

Сообщить("КОНЕЦ	разведки групп");
