Исключение
	Сообщить("СВЁРНУТАЯ	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "g4-collapsed");

// --- две группы подряд -------------------------------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.НачатьГруппуСтрок("Первая");
	Д.Область(1, 1, 1, 1).Текст = "A";
	Д.ЗакончитьГруппуСтрок();
	Д.НачатьГруппуСтрок("Вторая");
	Д.Область(2, 1, 2, 1).Текст = "B";
	Д.ЗакончитьГруппуСтрок();
Исключение
