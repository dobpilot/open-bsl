// РАЗВЕДКА-9: единицы геометрии рисунка и разложение на строки/колонки.

Процедура Сохранить(Док, Имя)
	Попытка
		Док.Записать("/tmp/open-bsl-draw2/" + Имя + ".mxl", ТипФайлаТабличногоДокумента.MXL);
	Исключение
		Сообщить("СОХР	" + Имя + "	ошибка	" + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Попытка
	СоздатьКаталог("/tmp/open-bsl-draw2");
Исключение
	Сообщить("КАТАЛОГ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

// Один параметр за раз, остальные нули: так видно, какое поле записи чему
// соответствует и в каких единицах.
Наборы = Новый Массив;
Наборы.Добавить("t0	0	0	0	0");
Наборы.Добавить("left10	0	10	0	0");
Наборы.Добавить("left100	0	100	0	0");
Наборы.Добавить("top10	10	0	0	0");
Наборы.Добавить("top100	100	0	0	0");
Наборы.Добавить("w10	0	0	0	10");
Наборы.Добавить("w100	0	0	0	100");
Наборы.Добавить("h10	0	0	10	0");
Наборы.Добавить("h100	0	0	100	0");
Наборы.Добавить("all	5	5	5	5");

Для Каждого Набор Из Наборы Цикл
	Части = СтрРазделить(Набор, Символ(9));
	Д = Новый ТабличныйДокумент;
	Д.Область(1, 1, 1, 1).Текст = "A";
	Попытка
		Рис = Д.Рисунки.Добавить(Вычислить("ТипРисункаТабличногоДокумента.Прямоугольник"));
		Рис.Верх = Число(Части[1]);
		Рис.Лево = Число(Части[2]);
		Рис.Высота = Число(Части[3]);
		Рис.Ширина = Число(Части[4]);
		Сообщить("ЧТЕНИЕ	" + Части[0] + "	" + Строка(Рис.Верх) + "	" + Строка(Рис.Лево)
			+ "	" + Строка(Рис.Высота) + "	" + Строка(Рис.Ширина)
			+ "	размер " + Строка(Д.ВысотаТаблицы) + "x" + Строка(Д.ШиринаТаблицы));
		Сохранить(Д, Части[0]);
	Исключение
		Сообщить("ЧТЕНИЕ	" + Части[0] + "	ошибка	" + ОписаниеОшибки());
	КонецПопытки;
КонецЦикла;

// --- ширина колонки и высота строки по умолчанию в тех же единицах ------------
Попытка
	Д = Новый ТабличныйДокумент;
	Д.Область(1, 1, 1, 1).Текст = "A";
	Сообщить("УМОЛЧАНИЕ	ширина	" + Строка(Д.Область(1, 1, 1, 1).ШиринаКолонки));
	Сообщить("УМОЛЧАНИЕ	высота	" + Строка(Д.Область(1, 1, 1, 1).ВысотаСтроки));
Исключение
	Сообщить("УМОЛЧАНИЕ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

// --- рисунок поверх заданной ширины колонки -----------------------------------------
Попытка
	Д = Новый ТабличныйДокумент;
	Д.Область(1, 1, 1, 1).Текст = "A";
	Д.Область(1, 1, 1, 1).ШиринаКолонки = 10;
	Рис = Д.Рисунки.Добавить(Вычислить("ТипРисункаТабличногоДокумента.Прямоугольник"));
	Рис.Лево = 0;
	Рис.Ширина = 100;
	Сообщить("ПОВЕРХ	ширина колонки 10	" + Строка(Рис.Ширина) + "	размер " + Строка(Д.ВысотаТаблицы) + "x" + Строка(Д.ШиринаТаблицы));
	Сохранить(Д, "over-narrow");
Исключение
	Сообщить("ПОВЕРХ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

Сообщить("КОНЕЦ	разведки геометрии");
