// РАЗВЕДКА-4: параметр ячейки, порядок палитры и оставшиеся палитры.

Процедура Сохранить(Док, Имя)
	Попытка
		Док.Записать("/tmp/open-bsl-mxl4/" + Имя + ".mxl", ТипФайлаТабличногоДокумента.MXL);
		Сообщить("СОХР	" + Имя + "	ок");
	Исключение
		Сообщить("СОХР	" + Имя + "	ошибка	" + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Попытка
	СоздатьКаталог("/tmp/open-bsl-mxl4");
Исключение
	Сообщить("КАТАЛОГ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

// --- ПАРАМЕТР: что платформа читает из своего же файла ---------------------
Попытка
	Док = Новый ТабличныйДокумент;
	Док.Прочитать("/tmp/open-bsl-mxl2/21-param.mxl");
	О = Док.Область(1, 1, 1, 1);
	Сообщить("СВОЙ	параметр	[" + О.Параметр + "]");
	Сообщить("СВОЙ	текст	[" + О.Текст + "]");
	Сообщить("СВОЙ	размер	" + Строка(Док.ВысотаТаблицы) + "x" + Строка(Док.ШиринаТаблицы));
Исключение
	Сообщить("СВОЙ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

// --- ПАРАМЕТР: сразу после установки, без файла ------------------------------
Попытка
	Док = Новый ТабличныйДокумент;
	О = Док.Область(1, 1, 1, 1);
	О.Параметр = "ПрямоСейчас";
	Сообщить("ПАМЯТЬ	параметр	[" + О.Параметр + "]");
	Сообщить("ПАМЯТЬ	текст	[" + О.Текст + "]");
	Сообщить("ПАМЯТЬ	размер	" + Строка(Док.ВысотаТаблицы) + "x" + Строка(Док.ШиринаТаблицы));
Исключение
	Сообщить("ПАМЯТЬ	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Док, "param-alone");

