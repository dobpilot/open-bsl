// Как платформа кладёт оформление в XLSX.
Док = Новый ТабличныйДокумент;

// 1. обычная ячейка
Док.Область(1, 1, 1, 1).Текст = "обычная";

// 2. полужирный шрифт
О = Док.Область(2, 1, 2, 1);
О.Текст = "жирная";
О.Шрифт = Вычислить("Новый Шрифт(""Arial"", 14, Истина)");

// 3. курсив другой гарнитуры
О = Док.Область(3, 1, 3, 1);
О.Текст = "курсив";
О.Шрифт = Вычислить("Новый Шрифт(""Times New Roman"", 9, Ложь, Истина)");

// 4. цвет фона и текста
О = Док.Область(4, 1, 4, 1);
О.Текст = "цветная";
О.ЦветФона = Вычислить("Новый Цвет(255, 255, 0)");
О.ЦветТекста = Вычислить("Новый Цвет(255, 0, 0)");

// 5. границы
О = Док.Область(5, 1, 5, 1);
О.Текст = "в рамке";
Л = Вычислить("Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная)");
О.Обвести(Л, Л, Л, Л);

// 6. выравнивание и перенос
О = Док.Область(6, 1, 6, 1);
О.Текст = "по центру с переносом";
О.ГоризонтальноеПоложение = Вычислить("ГоризонтальноеПоложение.Центр");
О.ВертикальноеПоложение = Вычислить("ВертикальноеПоложение.Центр");
О.РазмещениеТекста = Вычислить("ТипРазмещенияТекстаТабличногоДокумента.Переносить");

// 7. повтор оформления второй ячейки — должен переиспользовать стиль
О = Док.Область(7, 1, 7, 1);
О.Текст = "снова жирная";
О.Шрифт = Вычислить("Новый Шрифт(""Arial"", 14, Истина)");

Док.Записать("/tmp/open-bsl-xlsx/стили-наш.xlsx", ТипФайлаТабличногоДокумента.XLSX);
Сообщить("записано " + Строка(Док.ВысотаТаблицы) + "x" + Строка(Док.ШиринаТаблицы));
