// РАЗВЕДКА-8: рисунки табличного документа.

Процедура Сохранить(Док, Имя)
	Попытка
		Док.Записать("/tmp/open-bsl-draw/" + Имя + ".mxl", ТипФайлаТабличногоДокумента.MXL);
		Сообщить("СОХР	" + Имя + "	ок");
	Исключение
		Сообщить("СОХР	" + Имя + "	ошибка	" + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Функция Образец()
	Док = Новый ТабличныйДокумент;
	Док.Область(1, 1, 1, 1).Текст = "A";
	Возврат Док;
КонецФункции

Попытка
	СоздатьКаталог("/tmp/open-bsl-draw");
Исключение
	Сообщить("КАТАЛОГ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

// --- коллекция Рисунки ------------------------------------------------------
Д = Образец();
Попытка
	Сообщить("КОЛЛЕКЦИЯ	тип	" + Строка(ТипЗнч(Д.Рисунки)));
	Сообщить("КОЛЛЕКЦИЯ	количество	" + Строка(Д.Рисунки.Количество()));
Исключение
	Сообщить("КОЛЛЕКЦИЯ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

Методы = СтрРазделить("Добавить,Вставить,Удалить,Очистить,Найти,Получить,Индекс", ",");
Для Каждого М Из Методы Цикл
	Попытка
		Выполнить("Д.Рисунки." + М + "()");
		Сообщить("МЕТОД	" + М + "	есть");
	Исключение
		Текст = ОписаниеОшибки();
		Если СтрНайти(Текст, "не обнаружен") > 0 Тогда
			Сообщить("МЕТОД	" + М + "	нет");
		Иначе
			Сообщить("МЕТОД	" + М + "	есть, но	" + Текст);
		КонецЕсли;
	КонецПопытки;
КонецЦикла;

// --- какие типы рисунков существуют --------------------------------------------
Типы = СтрРазделить("Прямоугольник,Линия,Овал,Текст,Картинка,Диаграмма,ГруппаКартинок,Комментарий,ДиаграммаГанта,СводнаяДиаграмма,Объект", ",");
Для Каждого Т Из Типы Цикл
	Попытка
		Знч = Вычислить("ТипРисункаТабличногоДокумента." + Т);
		Сообщить("ТИПРИС	" + Т + "	есть	" + Строка(Знч));
	Исключение
		Сообщить("ТИПРИС	" + Т + "	нет");
	КонецПопытки;
КонецЦикла;

// --- добавление рисунка каждого доступного типа -------------------------------------
Доступные = СтрРазделить("Прямоугольник,Линия,Овал,Текст,Картинка", ",");
Для Каждого Т Из Доступные Цикл
	Д = Образец();
	Попытка
		Рис = Д.Рисунки.Добавить(Вычислить("ТипРисункаТабличногоДокумента." + Т));
		Сообщить("ДОБАВИТЬ	" + Т + "	ок	" + Строка(ТипЗнч(Рис)) + "	всего " + Строка(Д.Рисунки.Количество()));
		Сохранить(Д, "d-" + Т);
	Исключение
		Сообщить("ДОБАВИТЬ	" + Т + "	ошибка	" + ОписаниеОшибки());
	КонецПопытки;
КонецЦикла;

// --- свойства рисунка ------------------------------------------------------------------
Д = Образец();
Попытка
	Рис = Д.Рисунки.Добавить(Вычислить("ТипРисункаТабличногоДокумента.Прямоугольник"));
	Свойства = СтрРазделить("Имя,Верх,Лево,Высота,Ширина,Текст,ТипРисунка,Расположение,ЦветЛинии,ЦветФона,ЦветТекста,Шрифт,Линия,Картинка,РазмерКартинки,АвтоРазмер,Расшифровка,ПараметрРасшифровки,Параметр,ZНомер", ",");
	Для Каждого С Из Свойства Цикл
		Попытка
			Значение = Вычислить("Рис." + С);
			Сообщить("СВОЙСТВО	" + С + "	есть	" + Строка(Значение));
		Исключение
			Сообщить("СВОЙСТВО	" + С + "	нет");
		КонецПопытки;
	КонецЦикла;
Исключение
	Сообщить("СВОЙСТВА	ошибка	" + ОписаниеОшибки());
КонецПопытки;

// --- геометрия -----------------------------------------------------------------------------
Д = Образец();
Попытка
	Рис = Д.Рисунки.Добавить(Вычислить("ТипРисункаТабличногоДокумента.Прямоугольник"));
	Рис.Верх = 10;
	Рис.Лево = 20;
	Рис.Высота = 30;
	Рис.Ширина = 40;
	Сообщить("ГЕОМЕТРИЯ	" + Строка(Рис.Верх) + "," + Строка(Рис.Лево) + "," + Строка(Рис.Высота) + "," + Строка(Рис.Ширина));
Исключение
	Сообщить("ГЕОМЕТРИЯ	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "d-geometry");

// --- текст в рисунке ---------------------------------------------------------------------------
Д = Образец();
Попытка
	Рис = Д.Рисунки.Добавить(Вычислить("ТипРисункаТабличногоДокумента.Текст"));
	Рис.Текст = "надпись";
	Сообщить("ТЕКСТ	ок	[" + Рис.Текст + "]");
Исключение
	Сообщить("ТЕКСТ	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "d-text");

// --- имя рисунка ------------------------------------------------------------------------------------
Д = Образец();
Попытка
	Рис = Д.Рисунки.Добавить(Вычислить("ТипРисункаТабличногоДокумента.Прямоугольник"));
	Рис.Имя = "МойРисунок";
	Сообщить("ИМЯ	ок	[" + Рис.Имя + "]	областей " + Строка(Д.Области.Количество()));
Исключение
	Сообщить("ИМЯ	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "d-named");

// --- привязка к ячейкам ----------------------------------------------------------------------------------
Д = Образец();
Попытка
	Рис = Д.Рисунки.Добавить(Вычислить("ТипРисункаТабличногоДокумента.Прямоугольник"));
	Рис.Расположение = Д.Область(2, 1, 3, 2);
	Сообщить("РАСПОЛОЖЕНИЕ	ок");
Исключение
	Сообщить("РАСПОЛОЖЕНИЕ	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "d-placement");

// --- картинка из двоичных данных ---------------------------------------------------------------------------
Д = Образец();
Попытка
	Б64 = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==";
	Данные = Base64Значение(Б64);
	Карт = Новый Картинка(Данные);
	Рис = Д.Рисунки.Добавить(Вычислить("ТипРисункаТабличногоДокумента.Картинка"));
	Рис.Картинка = Карт;
	Сообщить("КАРТИНКА	ок	" + Строка(ТипЗнч(Карт)));
Исключение
	Сообщить("КАРТИНКА	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "d-picture");

// --- два рисунка -----------------------------------------------------------------------------------------------
Д = Образец();
Попытка
	Р1 = Д.Рисунки.Добавить(Вычислить("ТипРисункаТабличногоДокумента.Прямоугольник"));
	Р1.Имя = "Первый";
	Р2 = Д.Рисунки.Добавить(Вычислить("ТипРисункаТабличногоДокумента.Овал"));
	Р2.Имя = "Второй";
	Сообщить("ДВА	количество	" + Строка(Д.Рисунки.Количество()));
Исключение
	Сообщить("ДВА	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "d-two");

// --- удаление рисунка --------------------------------------------------------------------------------------------
Д = Образец();
Попытка
	Р1 = Д.Рисунки.Добавить(Вычислить("ТипРисункаТабличногоДокумента.Прямоугольник"));
	Д.Рисунки.Удалить(Р1);
	Сообщить("УДАЛЕНИЕ	количество	" + Строка(Д.Рисунки.Количество()));
Исключение
	Сообщить("УДАЛЕНИЕ	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "d-deleted");

// --- рисунок переживает файл ----------------------------------------------------------------------------------------
Попытка
	Обратно = Новый ТабличныйДокумент;
	Обратно.Прочитать("/tmp/open-bsl-draw/d-named.mxl");
	Сообщить("ФАЙЛ	количество	" + Строка(Обратно.Рисунки.Количество()));
	Если Обратно.Рисунки.Количество() > 0 Тогда
		Сообщить("ФАЙЛ	имя	[" + Обратно.Рисунки[0].Имя + "]");
	КонецЕсли;
Исключение
	Сообщить("ФАЙЛ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

Сообщить("КОНЕЦ	разведки рисунков");
