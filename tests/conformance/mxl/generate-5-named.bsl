Попытка
	Д.Область(1, 1, 1, 1).Имя = "Первая";
	Д.Область(2, 1, 2, 2).Имя = "Вторая";
	Для Каждого Обл Из Д.Области Цикл
		Сообщить("ОБХОД	" + Строка(ТипЗнч(Обл)) + "	[" + Обл.Имя + "]	" + Строка(Обл.Верх) + "," + Строка(Обл.Лево) + "," + Строка(Обл.Низ) + "," + Строка(Обл.Право));
