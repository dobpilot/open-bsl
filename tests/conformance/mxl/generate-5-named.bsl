	Д.Область(2, 1, 3, 2).Имя = "Строки";
	Сообщить("ДВЕ	количество	" + Строка(Д.Области.Количество()));
Исключение
	Сообщить("ДВЕ	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "n02-two");

