// --- имя с недопустимыми знаками ------------------------------------------------------------------------------
Имена = СтрРазделить("С пробелом,С-дефисом,1Цифра,ОченьДлинноеИмяОбластиДляПроверки", ",");
Для Каждого Имя Из Имена Цикл
	Д = Образец();
	Попытка
		Д.Область(1, 1, 1, 1).Имя = Имя;
		Сообщить("ЗНАКИ	[" + Имя + "]	ок	" + Строка(Д.Области.Количество()));
	Исключение
		Сообщить("ЗНАКИ	[" + Имя + "]	ошибка	" + ОписаниеОшибки());
