// РАЗВЕДКА-7: именованные области — устройство списка и поведение.

Процедура Сохранить(Док, Имя)
	Попытка
		Док.Записать("/tmp/open-bsl-named/" + Имя + ".mxl", ТипФайлаТабличногоДокумента.MXL);
		Сообщить("СОХР	" + Имя + "	ок");
	Исключение
		Сообщить("СОХР	" + Имя + "	ошибка	" + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Функция Образец()
	Док = Новый ТабличныйДокумент;
	Док.Область(1, 1, 1, 1).Текст = "шапка";
	Док.Область(2, 1, 2, 1).Текст = "строка1";
	Док.Область(2, 2, 2, 2).Текст = "цена1";
	Док.Область(3, 1, 3, 1).Текст = "строка2";
	Док.Область(4, 1, 4, 1).Текст = "итого";
	Возврат Док;
КонецФункции

Попытка
	СоздатьКаталог("/tmp/open-bsl-named");
Исключение
	Сообщить("КАТАЛОГ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

// --- одна область: работает ли она после именования -----------------------
Д = Образец();
Попытка
	Д.Область(1, 1, 1, 1).Имя = "Заголовок";
	Сообщить("ОДНА	количество	" + Строка(Д.Области.Количество()));
	О = Д.ПолучитьОбласть("Заголовок");
	Сообщить("ОДНА	получена	" + Строка(О.ВысотаТаблицы) + "x" + Строка(О.ШиринаТаблицы) + "	[" + О.Область(1, 1, 1, 1).Текст + "]");
Исключение
	Сообщить("ОДНА	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "n01-one");

// --- две области: чем разделяются записи ------------------------------------------
Д = Образец();
Попытка
