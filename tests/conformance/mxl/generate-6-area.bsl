// РАЗВЕДКА-6: области табличного документа.
//
// Что такое ПолучитьОбласть, чем она отличается от Область, что попадает в
// файл, и как устроена коллекция Области, если Добавить у неё нет.

Процедура Сохранить(Док, Имя)
	Попытка
		Док.Записать("/tmp/open-bsl-area/" + Имя + ".mxl", ТипФайлаТабличногоДокумента.MXL);
		Сообщить("СОХР	" + Имя + "	ок	" + Строка(Док.ВысотаТаблицы) + "x" + Строка(Док.ШиринаТаблицы));
	Исключение
		Сообщить("СОХР	" + Имя + "	ошибка	" + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Функция Образец()
	Док = Новый ТабличныйДокумент;
	Док.Область(1, 1, 1, 1).Текст = "шапка";
	Док.Область(2, 1, 2, 1).Текст = "строка1";
	Док.Область(2, 2, 2, 2).Текст = "цена1";
	Док.Область(3, 1, 3, 1).Текст = "строка2";
	Док.Область(3, 2, 3, 2).Текст = "цена2";
	Док.Область(4, 1, 4, 1).Текст = "итого";
	Возврат Док;
КонецФункции

Попытка
	СоздатьКаталог("/tmp/open-bsl-area");
Исключение
	Сообщить("КАТАЛОГ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

// --- коллекция Области ------------------------------------------------------
Д = Образец();
Попытка
	Сообщить("КОЛЛЕКЦИЯ	тип	" + Строка(ТипЗнч(Д.Области)));
	Сообщить("КОЛЛЕКЦИЯ	количество	" + Строка(Д.Области.Количество()));
Исключение
	Сообщить("КОЛЛЕКЦИЯ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

Методы = СтрРазделить("Добавить,Вставить,Удалить,Очистить,Найти,Получить,Индекс", ",");
Для Каждого М Из Методы Цикл
	Попытка
		Выполнить("Д.Области." + М + "()");
		Сообщить("МЕТОД	" + М + "	есть");
	Исключение
		Текст = ОписаниеОшибки();
		Если СтрНайти(Текст, "не обнаружен") > 0 Тогда
			Сообщить("МЕТОД	" + М + "	нет");
		Иначе
			Сообщить("МЕТОД	" + М + "	есть, но	" + Текст);
		КонецЕсли;
	КонецПопытки;
КонецЦикла;

// --- ПолучитьОбласть по имени, которого нет ------------------------------------
Попытка
	О = Д.ПолучитьОбласть("Заголовок");
	Сообщить("ПОИМЕНИ	ок	" + Строка(ТипЗнч(О)));
Исключение
	Сообщить("ПОИМЕНИ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

// --- ПолучитьОбласть по адресу ---------------------------------------------------
Адреса = СтрРазделить("R1C1:R2C2,R2:R3,C1:C2,R1C1,R2", ",");
Для Каждого Адрес Из Адреса Цикл
	Попытка
		О = Д.ПолучитьОбласть(Адрес);
		Сообщить("АДРЕС	" + Адрес + "	" + Строка(ТипЗнч(О)) + "	" + Строка(О.ВысотаТаблицы) + "x" + Строка(О.ШиринаТаблицы));
	Исключение
		Сообщить("АДРЕС	" + Адрес + "	ошибка	" + ОписаниеОшибки());
	КонецПопытки;
КонецЦикла;

// --- ПолучитьОбласть числами ---------------------------------------------------------
Попытка
	О = Д.ПолучитьОбласть(2, 1, 3, 2);
	Сообщить("ЧИСЛА	" + Строка(ТипЗнч(О)) + "	" + Строка(О.ВысотаТаблицы) + "x" + Строка(О.ШиринаТаблицы));
	Сообщить("ЧИСЛА	содержимое	[" + О.Область(1, 1, 1, 1).Текст + "][" + О.Область(2, 2, 2, 2).Текст + "]");
	Сохранить(О, "area-rows23");
Исключение
	Сообщить("ЧИСЛА	ошибка	" + ОписаниеОшибки());
КонецПопытки;

// --- независимость копии ------------------------------------------------------------------
Попытка
	Д2 = Образец();
	Обл = Д2.ПолучитьОбласть(2, 1, 2, 2);
	Обл.Область(1, 1, 1, 1).Текст = "изменено";
	Сообщить("КОПИЯ	в области	[" + Обл.Область(1, 1, 1, 1).Текст + "]");
	Сообщить("КОПИЯ	в исходном	[" + Д2.Область(2, 1, 2, 1).Текст + "]");
Исключение
	Сообщить("КОПИЯ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

// --- Вывести: что принимает --------------------------------------------------------------------
Попытка
	Приёмник = Новый ТабличныйДокумент;
	Приёмник.Вывести(Образец().ПолучитьОбласть(1, 1, 1, 1));
	Сообщить("ВЫВЕСТИ	область	ок	" + Строка(Приёмник.ВысотаТаблицы) + "x" + Строка(Приёмник.ШиринаТаблицы));
Исключение
	Сообщить("ВЫВЕСТИ	область	ошибка	" + ОписаниеОшибки());
КонецПопытки;

Попытка
	Приёмник = Новый ТабличныйДокумент;
	Приёмник.Вывести(Образец());
	Сообщить("ВЫВЕСТИ	документ	ок	" + Строка(Приёмник.ВысотаТаблицы) + "x" + Строка(Приёмник.ШиринаТаблицы));
Исключение
	Сообщить("ВЫВЕСТИ	документ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

// --- Вывести в цикле: наращивание -----------------------------------------------------------------------
Попытка
	Приёмник = Новый ТабличныйДокумент;
	Исходный = Образец();
	Шапка = Исходный.ПолучитьОбласть(1, 1, 1, 1);
	Строка1 = Исходный.ПолучитьОбласть(2, 1, 2, 2);
	Приёмник.Вывести(Шапка);
	Для Н = 1 По 3 Цикл
		Приёмник.Вывести(Строка1);
	КонецЦикла;
	Сообщить("ЦИКЛ	" + Строка(Приёмник.ВысотаТаблицы) + "x" + Строка(Приёмник.ШиринаТаблицы));
	Сообщить("ЦИКЛ	ячейки	[" + Приёмник.Область(1, 1, 1, 1).Текст + "][" + Приёмник.Область(2, 1, 2, 1).Текст + "][" + Приёмник.Область(4, 2, 4, 2).Текст + "]");
	Сохранить(Приёмник, "area-loop");
Исключение
	Сообщить("ЦИКЛ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

// --- ВывестиГоризонтально ---------------------------------------------------------------------------------
Попытка
	Приёмник = Новый ТабличныйДокумент;
	Исходный = Образец();
	Обл = Исходный.ПолучитьОбласть(1, 1, 1, 1);
	Приёмник.Вывести(Обл);
	Приёмник.ВывестиГоризонтально(Обл);
	Сообщить("ГОРИЗОНТАЛЬНО	" + Строка(Приёмник.ВысотаТаблицы) + "x" + Строка(Приёмник.ШиринаТаблицы));
	Сохранить(Приёмник, "area-horizontal");
Исключение
	Сообщить("ГОРИЗОНТАЛЬНО	ошибка	" + ОписаниеОшибки());
КонецПопытки;

// --- Присоединить -----------------------------------------------------------------------------------------------
Попытка
	Приёмник = Новый ТабличныйДокумент;
	Обл = Образец().ПолучитьОбласть(1, 1, 1, 1);
	Приёмник.Вывести(Обл);
	Приёмник.Присоединить(Обл);
	Сообщить("ПРИСОЕДИНИТЬ	" + Строка(Приёмник.ВысотаТаблицы) + "x" + Строка(Приёмник.ШиринаТаблицы));
Исключение
	Сообщить("ПРИСОЕДИНИТЬ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

// --- Имя у области -------------------------------------------------------------------------------------------------
Попытка
	Д3 = Образец();
	Д3.Область(1, 1, 1, 1).Имя = "МояШапка";
	Сообщить("ИМЯ	ок");
	Сохранить(Д3, "area-named");
Исключение
	Сообщить("ИМЯ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

// --- сохранение самой области как документа ----------------------------------------------------------------------------
Попытка
	Обл = Образец().ПолучитьОбласть(2, 1, 3, 2);
	Сообщить("ОБЛФАЙЛ	тип	" + Строка(ТипЗнч(Обл)));
	Сохранить(Обл, "area-standalone");
Исключение
	Сообщить("ОБЛФАЙЛ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

// --- Область против ПолучитьОбласть: ссылка или копия ------------------------------------------------------------------------
Попытка
	Д4 = Образец();
	Ссылка = Д4.Область(1, 1, 1, 1);
	Ссылка.Текст = "через Область";
	Сообщить("ССЫЛКА	в документе	[" + Д4.Область(1, 1, 1, 1).Текст + "]");
Исключение
	Сообщить("ССЫЛКА	ошибка	" + ОписаниеОшибки());
КонецПопытки;

Сообщить("КОНЕЦ	разведки областей");
