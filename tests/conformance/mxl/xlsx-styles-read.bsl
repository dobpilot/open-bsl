// Платформа читает НАШ xlsx со стилями и показывает, что распознала.
Попытка
	Д = Новый ТабличныйДокумент;
	Д.Прочитать("/tmp/open-bsl-ours/стили.xlsx");
	Сообщить("РАЗМЕР	" + Строка(Д.ВысотаТаблицы) + "x" + Строка(Д.ШиринаТаблицы));
	Для С = 1 По 7 Цикл
		О = Д.Область(С, 1, С, 1);
		Сообщить("ЯЧЕЙКА	" + Строка(С) + "	[" + О.Текст + "]	шрифт " + Строка(О.Шрифт)
			+ "	фон " + Строка(О.ЦветФона) + "	текст " + Строка(О.ЦветТекста)
			+ "	гор " + Строка(О.ГоризонтальноеПоложение));
	КонецЦикла;
Исключение
	Сообщить("ОШИБКА	" + ОписаниеОшибки());
КонецПопытки;
Сообщить("КОНЕЦ");
