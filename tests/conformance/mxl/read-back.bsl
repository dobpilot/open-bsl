// Встречная проверка: платформа читает файлы, записанные НАМИ.
//
// Побайтное совпадение с эталонами доказывает только то, что снято. Здесь
// проверяется обратное направление: 1С открывает наш .mxl, показывает
// содержимое и переписывает его своими руками — если её версия совпадёт с
// нашей побайтно, значит мы пишем не просто читаемый, а канонический файл.
//
// Вход готовит:
//   cargo test -p bsl-rt --test mxl_oracle -- --ignored выгрузить
// Прогон:
//   ./tests/conformance/measure/1c/run-on-1c.sh tests/conformance/mxl/read-back.bsl

Каталог = "/tmp/open-bsl-ours";
Обратно = "/tmp/open-bsl-roundtrip";
Попытка
	СоздатьКаталог(Обратно);
Исключение
	Сообщить("КАТАЛОГ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

Имена = СтрРазделить("many-rows,sparse,merges,styled,text-edges,palettes,borders", ",");
Для Каждого Имя Из Имена Цикл
	Попытка
		Док = Новый ТабличныйДокумент;
		Док.Прочитать(Каталог + "/" + Имя + ".mxl");
		Сообщить("ЧТЕНИЕ	" + Имя + "	ок	" + Строка(Док.ВысотаТаблицы) + "x" + Строка(Док.ШиринаТаблицы));
		Док.Записать(Обратно + "/" + Имя + ".mxl", ТипФайлаТабличногоДокумента.MXL);
	Исключение
		Сообщить("ЧТЕНИЕ	" + Имя + "	ошибка	" + ОписаниеОшибки());
	КонецПопытки;
КонецЦикла;

// --- содержимое выборочно ------------------------------------------------
Попытка
	Док = Новый ТабличныйДокумент;
	Док.Прочитать(Каталог + "/many-rows.mxl");
	Сообщить("ЯЧЕЙКА	many-rows	1	" + Док.Область(1, 1, 1, 1).Текст);
	Сообщить("ЯЧЕЙКА	many-rows	25	" + Док.Область(25, 2, 25, 2).Текст);
	Сообщить("ЯЧЕЙКА	many-rows	50	" + Док.Область(50, 3, 50, 3).Текст);
Исключение
	Сообщить("ЯЧЕЙКА	many-rows	ошибка	" + ОписаниеОшибки());
КонецПопытки;

Попытка
	Док = Новый ТабличныйДокумент;
	Док.Прочитать(Каталог + "/sparse.mxl");
	Сообщить("ЯЧЕЙКА	sparse	1	" + Док.Область(1, 1, 1, 1).Текст);
	Сообщить("ЯЧЕЙКА	sparse	10	" + Док.Область(10, 5, 10, 5).Текст);
	Сообщить("ЯЧЕЙКА	sparse	20	" + Док.Область(20, 10, 20, 10).Текст);
Исключение
	Сообщить("ЯЧЕЙКА	sparse	ошибка	" + ОписаниеОшибки());
КонецПопытки;

Попытка
	Док = Новый ТабличныйДокумент;
	Док.Прочитать(Каталог + "/text-edges.mxl");
	Для Н = 1 По 4 Цикл
		Сообщить("ТЕКСТ	" + Строка(Н) + "	" + СтрЗаменить(Док.Область(Н, 1, Н, 1).Текст, Символ(10), "\n"));
	КонецЦикла;
	Сообщить("ТЕКСТ	длина5	" + Строка(СтрДлина(Док.Область(5, 1, 5, 1).Текст)));
Исключение
	Сообщить("ТЕКСТ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

Попытка
	Док = Новый ТабличныйДокумент;
	Док.Прочитать(Каталог + "/styled.mxl");
	О = Док.Область(1, 1, 1, 1);
	Сообщить("СТИЛЬ	текст	" + О.Текст);
	Сообщить("СТИЛЬ	ширина	" + Строка(О.ШиринаКолонки));
	Сообщить("СТИЛЬ	высота	" + Строка(О.ВысотаСтроки));
	Сообщить("СТИЛЬ	гор	" + Строка(О.ГоризонтальноеПоложение));
	Сообщить("СТИЛЬ	верт	" + Строка(О.ВертикальноеПоложение));
	Сообщить("СТИЛЬ	фиксация	" + Строка(Док.ФиксацияСверху));
	Сообщить("СТИЛЬ	масштаб	" + Строка(Док.МасштабПечати));
	Сообщить("СТИЛЬ	параметр	" + Строка(Док.Область(2, 1, 2, 1).Параметр));
Исключение
	Сообщить("СТИЛЬ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

Попытка
	Док = Новый ТабличныйДокумент;
	Док.Прочитать(Каталог + "/merges.mxl");
	Сообщить("СЛИЯНИЕ	шапка	" + Док.Область(1, 1, 1, 1).Текст);
	Сообщить("СЛИЯНИЕ	бок	" + Док.Область(3, 1, 3, 1).Текст);
	Сообщить("СЛИЯНИЕ	блок	" + Док.Область(3, 3, 3, 3).Текст);
Исключение
	Сообщить("СЛИЯНИЕ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

Сообщить("КОНЕЦ	встречной проверки");
