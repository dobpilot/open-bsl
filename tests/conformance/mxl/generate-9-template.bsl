// Можно ли получить XML-представление табличного документа прямо с
// платформы: тогда эталоны для разбора макетов берутся оттуда же, откуда
// и всё остальное, а не сочиняются.
Попытка
	СоздатьКаталог("/tmp/open-bsl-tmpl");
Исключение
	Сообщить("КАТАЛОГ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

Док = Новый ТабличныйДокумент;
Док.Область(1, 1, 1, 1).Текст = "Отчёт";
Док.Область(1, 1, 1, 3).Объединить();
Док.Область(2, 1, 2, 1).Текст = "Товар";
Док.Область(2, 2, 2, 2).Текст = "Цена";
Док.Область(3, 1, 3, 1).Параметр = "Номенклатура";
Док.Область(3, 2, 3, 2).Параметр = "Сумма";
Док.Область(2, 1, 2, 1).ШиринаКолонки = 30;
Док.Область(1, 1, 1, 1).ВысотаСтроки = 25;
Док.Область(1, 1, 1, 1).ГоризонтальноеПоложение = Вычислить("ГоризонтальноеПоложение.Центр");
Док.Область(1, 1, 1, 1).Имя = "Шапка";
Док.Область(3, 1, 3, 2).Имя = "Строка";

Попытка
	Запись = Новый ЗаписьXML;
	Запись.ОткрытьФайл("/tmp/open-bsl-tmpl/док.xml");
	СериализаторXDTO.ЗаписатьXML(Запись, Док);
	Запись.Закрыть();
	Ф = Новый Файл("/tmp/open-bsl-tmpl/док.xml");
	Сообщить("XDTO	ок	" + Строка(Ф.Размер()));
Исключение
	Сообщить("XDTO	ошибка	" + ОписаниеОшибки());
КонецПопытки;

Попытка
	Стр = ЗначениеВСтрокуВнутр(Док);
	Сообщить("ВНУТР	ок	" + Строка(СтрДлина(Стр)));
Исключение
	Сообщить("ВНУТР	ошибка	" + ОписаниеОшибки());
КонецПопытки;

Сообщить("КОНЕЦ");
