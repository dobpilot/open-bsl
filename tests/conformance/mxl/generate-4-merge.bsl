// РАЗВЕДКА-5: объединение ячеек целиком.
//
// Вопросы: пятое поле записи, порядок записей, глобальные объединения по
// колонкам (r = -1 в XML-описании макетов), отмена объединения, пересечения,
// судьба текста накрытых ячеек, влияние на размер таблицы.

Процедура Сохранить(Док, Имя)
	Попытка
		Док.Записать("/tmp/open-bsl-merge/" + Имя + ".mxl", ТипФайлаТабличногоДокумента.MXL);
		Сообщить("СОХР	" + Имя + "	ок	" + Строка(Док.ВысотаТаблицы) + "x" + Строка(Док.ШиринаТаблицы));
	Исключение
		Сообщить("СОХР	" + Имя + "	ошибка	" + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Попытка
	СоздатьКаталог("/tmp/open-bsl-merge");
Исключение
	Сообщить("КАТАЛОГ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

// --- 01 объединение одной ячейки: попадает ли вообще в файл ------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.Область(1, 1, 1, 1).Текст = "A";
	Д.Область(1, 1, 1, 1).Объединить();
Исключение
	Сообщить("ОДНА	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "m01-single");

// --- 02 порядок записей: объединения заданы снизу вверх -------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.Область(3, 1, 3, 2).Объединить();
	Д.Область(1, 1, 1, 2).Объединить();
	Д.Область(2, 1, 2, 2).Объединить();
Исключение
	Сообщить("ПОРЯДОК	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "m02-order");

// --- 03 объединение за пределами содержимого ---------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.Область(5, 5, 5, 7).Объединить();
Исключение
	Сообщить("ЗАПРЕДЕЛАМИ	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "m03-beyond");

// --- 04 пересекающиеся объединения ---------------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.Область(1, 1, 2, 2).Объединить();
	Д.Область(2, 2, 3, 3).Объединить();
	Сообщить("ПЕРЕСЕЧЕНИЕ	ок");
Исключение
	Сообщить("ПЕРЕСЕЧЕНИЕ	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "m04-overlap");

// --- 05 объединить и разъединить ---------------------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.Область(1, 1, 1, 1).Текст = "A";
	Д.Область(1, 1, 1, 3).Объединить();
	Д.Область(1, 1, 1, 3).Разъединить();
	Сообщить("РАЗЪЕДИНИТЬ	ок");
Исключение
	Сообщить("РАЗЪЕДИНИТЬ	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "m05-unmerge");

// --- 06 объединение ЦЕЛЫХ КОЛОНОК -----------------------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.Область(1, 1, 1, 1).Текст = "A";
	Д.Область("C2:C4").Объединить();
	Сообщить("КОЛОНКИ	C2:C4	ок");
Исключение
	Сообщить("КОЛОНКИ	C2:C4	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "m06-columns");

// --- 07 объединение ЦЕЛЫХ СТРОК ----------------------------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.Область(1, 1, 1, 1).Текст = "A";
	Д.Область("R2:R3").Объединить();
	Сообщить("СТРОКИ	R2:R3	ок");
Исключение
	Сообщить("СТРОКИ	R2:R3	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "m07-rows");

// --- 08 текст накрытых ячеек ------------------------------------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.Область(1, 1, 1, 1).Текст = "первая";
	Д.Область(1, 2, 1, 2).Текст = "вторая";
	Д.Область(1, 3, 1, 3).Текст = "третья";
	Д.Область(1, 1, 1, 3).Объединить();
	Сообщить("НАКРЫТЫЕ	1	[" + Д.Область(1, 1, 1, 1).Текст + "]");
	Сообщить("НАКРЫТЫЕ	2	[" + Д.Область(1, 2, 1, 2).Текст + "]");
	Сообщить("НАКРЫТЫЕ	3	[" + Д.Область(1, 3, 1, 3).Текст + "]");
	Сообщить("НАКРЫТЫЕ	все	[" + Д.Область(1, 1, 1, 3).Текст + "]");
Исключение
	Сообщить("НАКРЫТЫЕ	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "m08-covered");

// --- 09 запись в накрытую ячейку ПОСЛЕ объединения -------------------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.Область(1, 1, 1, 3).Объединить();
	Д.Область(1, 2, 1, 2).Текст = "в накрытую";
	Сообщить("ПОСЛЕ	1	[" + Д.Область(1, 1, 1, 1).Текст + "]");
	Сообщить("ПОСЛЕ	2	[" + Д.Область(1, 2, 1, 2).Текст + "]");
Исключение
	Сообщить("ПОСЛЕ	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "m09-write-covered");

// --- 10 блок 2x2 ------------------------------------------------------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.Область(2, 2, 3, 3).Текст = "блок";
	Д.Область(2, 2, 3, 3).Объединить();
Исключение
	Сообщить("БЛОК	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "m10-block");

// --- 11 два соседних объединения в одной строке -----------------------------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.Область(1, 1, 1, 2).Объединить();
	Д.Область(1, 3, 1, 4).Объединить();
Исключение
	Сообщить("СОСЕДНИЕ	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "m11-adjacent");

// --- 12 повторное объединение того же места ------------------------------------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.Область(1, 1, 1, 3).Объединить();
	Д.Область(1, 1, 1, 3).Объединить();
	Сообщить("ПОВТОР	ок");
Исключение
	Сообщить("ПОВТОР	ошибка	" + ОписаниеОшибки());
КонецПопытки;
