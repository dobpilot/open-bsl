// --- 13 объединение колонок, затем разъединение в одной строке ---------------------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.Область(1, 1, 1, 1).Текст = "A";
	Д.Область(3, 1, 3, 1).Текст = "C";
	Д.Область("C1:C3").Объединить();
	Д.Область(2, 1, 2, 3).Разъединить();
	Сообщить("ОТМЕНА	ок");
Исключение
	Сообщить("ОТМЕНА	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "m13-unmerge-row");

// --- 14 объединение при выводе области в другой документ -------------------------------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Ист = Новый ТабличныйДокумент;
	Ист.Область(1, 1, 1, 1).Текст = "шапка";
	Ист.Область(1, 1, 1, 3).Объединить();
	Д.Вывести(Ист);
	Д.Вывести(Ист);
	Сообщить("ВЫВОД	ок	" + Строка(Д.ВысотаТаблицы) + "x" + Строка(Д.ШиринаТаблицы));
Исключение
	Сообщить("ВЫВОД	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "m14-output");

// --- 15 адресация областей строкой ------------------------------------------------------------------------------------------
Д = Новый ТабличныйДокумент;
Д.Область(1, 1, 1, 1).Текст = "A";
Адреса = СтрРазделить("R1C1:R2C3,R1:R2,C1:C2,R1C1,C1", ",");
Для Каждого Адрес Из Адреса Цикл
	Попытка
		О = Д.Область(Адрес);
		Сообщить("АДРЕС	" + Адрес + "	ок	" + Строка(ТипЗнч(О)));
	Исключение
		Сообщить("АДРЕС	" + Адрес + "	ошибка	" + ОписаниеОшибки());
	КонецПопытки;
КонецЦикла;

// --- 16 объединение через пропущенные аргументы --------------------------------------------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.Область(1, 1, 1, 1).Текст = "A";
	Д.Область(, 2, , 3).Объединить();
	Сообщить("ПРОПУСК	ок");
Исключение
	Сообщить("ПРОПУСК	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "m16-omitted");

Сообщить("КОНЕЦ	разведки объединений");
