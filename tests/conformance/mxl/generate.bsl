// РАЗВЕДКА-2: серия документов, отличающихся ОДНИМ свойством, чтобы
// вывести кодировку mxl попарным сравнением. Каждая проба в Попытка.

Процедура Сохранить(Док, Имя)
	Попытка
		Док.Записать("/tmp/open-bsl-mxl2/" + Имя + ".mxl", ТипФайлаТабличногоДокумента.MXL);
		Сообщить("СОХР	" + Имя + "	ок	" + Строка(Док.ВысотаТаблицы) + "x" + Строка(Док.ШиринаТаблицы));
	Исключение
		Сообщить("СОХР	" + Имя + "	ошибка	" + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Функция НоваяБаза()
	Док = Новый ТабличныйДокумент;
	Док.Область(1, 1, 1, 1).Текст = "A";
	Возврат Док;
КонецФункции

Попытка
	СоздатьКаталог("/tmp/open-bsl-mxl2");
Исключение
	Сообщить("КАТАЛОГ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

// --- 01 база ---------------------------------------------------------
Сохранить(НоваяБаза(), "01-base");

