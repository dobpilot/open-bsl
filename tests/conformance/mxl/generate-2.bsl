// ячейки со значением, группы строк, единицы измерения.

Процедура Сохранить(Док, Имя)
	Попытка
		Док.Записать("/tmp/open-bsl-mxl3/" + Имя + ".mxl", ТипФайлаТабличногоДокумента.MXL);
		Сообщить("СОХР	" + Имя + "	ок	" + Строка(Док.ВысотаТаблицы) + "x" + Строка(Док.ШиринаТаблицы));
	Исключение
		Сообщить("СОХР	" + Имя + "	ошибка	" + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Функция НоваяБаза()
	Док = Новый ТабличныйДокумент;
	Док.Область(1, 1, 1, 1).Текст = "A";
	Возврат Док;
КонецФункции

