// РАЗВЕДКА-11: рисунки — зависимость геометрии от сетки, несколько
// рисунков, разные типы.

Процедура Сохранить(Док, Имя)
	Попытка
		Док.Записать("/tmp/open-bsl-draw3/" + Имя + ".mxl", ТипФайлаТабличногоДокумента.MXL);
		Сообщить("СОХР	" + Имя + "	ок");
	Исключение
		Сообщить("СОХР	" + Имя + "	ошибка	" + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Попытка
	СоздатьКаталог("/tmp/open-bsl-draw3");
Исключение
	Сообщить("КАТАЛОГ	ошибка	" + ОписаниеОшибки());
КонецПопытки;

// --- влияет ли ШИРИНА КОЛОНКИ на разложение координат -----------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.Область(1, 1, 1, 1).Текст = "A";
	Д.Область(1, 1, 1, 1).ШиринаКолонки = 50;
	Рис = Д.Рисунки.Добавить(Вычислить("ТипРисункаТабличногоДокумента.Прямоугольник"));
	Рис.Лево = 100;
	Рис.Ширина = 50;
	Сообщить("ШИРИНА	лево " + Строка(Рис.Лево) + " ширина " + Строка(Рис.Ширина));
Исключение
	Сообщить("ШИРИНА	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "wide-col");

// --- влияет ли ВЫСОТА СТРОКИ ------------------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.Область(1, 1, 1, 1).Текст = "A";
	Д.Область(1, 1, 1, 1).ВысотаСтроки = 60;
	Рис = Д.Рисунки.Добавить(Вычислить("ТипРисункаТабличногоДокумента.Прямоугольник"));
	Рис.Верх = 50;
	Рис.Высота = 20;
	Сообщить("ВЫСОТА	верх " + Строка(Рис.Верх) + " высота " + Строка(Рис.Высота));
Исключение
	Сообщить("ВЫСОТА	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "tall-row");

// --- ДВА рисунка ---------------------------------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.Область(1, 1, 1, 1).Текст = "A";
	Р1 = Д.Рисунки.Добавить(Вычислить("ТипРисункаТабличногоДокумента.Прямоугольник"));
	Р1.Лево = 10;
	Р2 = Д.Рисунки.Добавить(Вычислить("ТипРисункаТабличногоДокумента.Прямоугольник"));
	Р2.Лево = 30;
	Сообщить("ДВА	количество " + Строка(Д.Рисунки.Количество())
		+ " имена " + Р1.Имя + "," + Р2.Имя);
Исключение
	Сообщить("ДВА	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "two-draw");

// --- тип ТЕКСТ с надписью ---------------------------------------------------------------
Д = Новый ТабличныйДокумент;
Попытка
	Д.Область(1, 1, 1, 1).Текст = "A";
	Рис = Д.Рисунки.Добавить(Вычислить("ТипРисункаТабличногоДокумента.Текст"));
	Рис.Текст = "надпись";
	Рис.Лево = 10;
	Рис.Верх = 10;
Исключение
	Сообщить("ТЕКСТ	ошибка	" + ОписаниеОшибки());
КонецПопытки;
Сохранить(Д, "text-draw");

Сообщить("КОНЕЦ	разведки рисунков 3");
