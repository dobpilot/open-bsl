// Сверка ДВУХ ПУТЕЙ записи, а не вывода с эталоном.
//
// Эталон проверяет то, что решили проверить; сверка двух путей — то, о чём
// не подумали. Здесь один документ пишется и в MXL, и в XLSX, а потом
// платформа читает оба и показывает содержимое: расхождение означает, что
// один из экспортов теряет то, что несёт другой. Именно так нашлось, что
// XLSX молча терял ячейки со значением.
//
//   cargo run -p bsl-cli -- tests/conformance/mxl/cross-write.bsl
//   ./tests/conformance/measure/1c/run-on-1c.sh tests/conformance/mxl/cross-read.bsl
Док.Область(1, 1, 1, 1).Текст = "Заголовок";
Док.Область(1, 1, 1, 3).Объединить();
Док.Область(2, 1, 2, 1).Текст = "Товар";
Док.Область(2, 2, 2, 2).Текст = "Цена";
Док.Область(2, 3, 2, 3).Текст = "Сумма";
Ц = Док.Область(3, 2, 3, 2);
Ц.СодержитЗначение = Истина;
Ц.Значение = 1000.5;
Док.Область(3, 1, 3, 1).Текст = "Гвозди";
Док.Область(3, 3, 3, 3).Параметр = "ИтогоСумма";
Док.Область(2, 1, 2, 1).ШиринаКолонки = 20;
Док.Область(1, 1, 1, 1).ВысотаСтроки = 25;
Док.Записать("/tmp/open-bsl-xlsx/оба.mxl", ТипФайлаТабличногоДокумента.MXL);
Док.Записать("/tmp/open-bsl-xlsx/оба.xlsx", ТипФайлаТабличногоДокумента.XLSX);
Сообщить("исходный: " + Строка(Док.ВысотаТаблицы) + "x" + Строка(Док.ШиринаТаблицы));
