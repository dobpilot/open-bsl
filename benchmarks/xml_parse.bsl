// Чтение XML: один документ обходится потоковым `ЧтениеXML` много раз.
//
// Что именно меряется: разбор разметки ПЛЮС обход узлов через `Прочитать()`
// и выборка атрибутов. Значения в структуры здесь не собираются, и это не
// упрощение, а разница форматов: у `ПрочитатьJSON` в паре `json_parse`
// готовое значение — обычная цель вызова, а у XML типовой обмен 1С читают
// именно потоком, узел за узлом.
//
// Поэтому строки `json_parse` и `xml_parse` в таблице НЕ равны по объёму
// работы: JSON-строка включает построение `Структура`/`Массив`, XML-строка —
// нет. Сравнивать их лоб в лоб как «XML быстрее JSON» нельзя; осмысленно
// сравнивать колонки внутри одной строки.
//
// Документ собирается ОДИН раз тем же кодом, что в `xml_write`, и в замер
// не входит. Контрольная сумма после замера — тоже вне его.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

ЧислоЗаписей = 10000;
Проходов = 3;

// --- сборка документа (вне замера) --------------------------------------
Запись = Новый ЗаписьXML;
Запись.УстановитьСтроку(Новый ПараметрыЗаписиXML("UTF-8", "1.0", Ложь));
Запись.ЗаписатьОбъявлениеXML();
Запись.ЗаписатьНачалоЭлемента("контрагенты");
Флаг = Ложь;
Для н = 1 По ЧислоЗаписей Цикл
	Флаг = Не Флаг;
	Ном = Формат(н, "ЧГ=0");

	Запись.ЗаписатьНачалоЭлемента("запись");
	Запись.ЗаписатьАтрибут("ид", Ном);
	Запись.ЗаписатьАтрибут("активен", Строка(Флаг));

	Запись.ЗаписатьНачалоЭлемента("имя");
	Запись.ЗаписатьТекст("запись номер " + Ном);
	Запись.ЗаписатьКонецЭлемента();

	Запись.ЗаписатьНачалоЭлемента("цена");
	Запись.ЗаписатьТекст(Формат(н + 0.75, "ЧГ=0; ЧРД=."));
	Запись.ЗаписатьКонецЭлемента();

	Запись.ЗаписатьНачалоЭлемента("теги");
	Запись.ЗаписатьНачалоЭлемента("тег");
	Запись.ЗаписатьТекст("альфа");
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьНачалоЭлемента("тег");
	Запись.ЗаписатьТекст("бета");
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьНачалоЭлемента("тег");
	Запись.ЗаписатьТекст("гамма");
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();

	Запись.ЗаписатьНачалоЭлемента("вложенное");
	Запись.ЗаписатьАтрибут("число", Ном);
	Запись.ЗаписатьТекст("значение");
	Запись.ЗаписатьКонецЭлемента();

	Запись.ЗаписатьНачалоЭлемента("контрагент");
	Запись.ЗаписатьАтрибут("инн", "77010" + Ном);
	Запись.ЗаписатьАтрибут("кпп", "770101001");

	Запись.ЗаписатьНачалоЭлемента("наименование");
	Запись.ЗаписатьТекст("ООО Ромашка " + Ном);
	Запись.ЗаписатьКонецЭлемента();

	Запись.ЗаписатьНачалоЭлемента("банковскийСчет");
	Запись.ЗаписатьАтрибут("номер", "4070281090000000" + Ном);
	Запись.ЗаписатьАтрибут("бик", "044525225");
	Запись.ЗаписатьАтрибут("коррсчет", "30101810400000000225");
	Запись.ЗаписатьНачалоЭлемента("банк");
	Запись.ЗаписатьТекст("АО Банк " + Ном);
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();

	Запись.ЗаписатьНачалоЭлемента("юрАдрес");
	Запись.ЗаписатьАтрибут("индекс", "101000");
	Запись.ЗаписатьНачалоЭлемента("регион");
	Запись.ЗаписатьТекст("Москва");
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьНачалоЭлемента("город");
	Запись.ЗаписатьТекст("Москва");
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьНачалоЭлемента("адрес");
	Запись.ЗаписатьТекст("ул. Тверская, д. " + Ном);
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();

	Запись.ЗаписатьНачалоЭлемента("фактическийАдрес");
	Запись.ЗаписатьАтрибут("индекс", "141400");
	Запись.ЗаписатьНачалоЭлемента("регион");
	Запись.ЗаписатьТекст("Московская область");
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьНачалоЭлемента("город");
	Запись.ЗаписатьТекст("Химки");
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьНачалоЭлемента("адрес");
	Запись.ЗаписатьТекст("ул. Победы, д. " + Ном);
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();

	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();
КонецЦикла;
Запись.ЗаписатьКонецЭлемента();
Текст = Запись.Закрыть();

// --- замер ---------------------------------------------------------------
// Обход трогает ВСЕ уровни вложенности и обе стороны разбора: узлы и
// атрибуты. Суммируются только поля из цифр и длины значений — они
// одинаковы у всех рантаймов, тогда как кириллица зависела бы от того, в
// чём рантайм меряет длину.
Т = ТекущаяУниверсальнаяДатаВМиллисекундах();
Узлов = 0;
Элементов = 0;
Атрибутов = 0;
СуммаИД = 0;
ДлинаЗначений = 0;
Для п = 1 По Проходов Цикл
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(Текст);
	Пока Чтение.Прочитать() Цикл
		Узлов = Узлов + 1;
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Элементов = Элементов + 1;
			Всего = Чтение.КоличествоАтрибутов();
			Атрибутов = Атрибутов + Всего;
			Для а = 0 По Всего - 1 Цикл
				ДлинаЗначений = ДлинаЗначений + СтрДлина(Чтение.ЗначениеАтрибута(а));
			КонецЦикла;
			Если Чтение.Имя = "запись" Тогда
				СуммаИД = СуммаИД + Число(Чтение.ЗначениеАтрибута("ид"));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
КонецЦикла;
Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

// --- проверка (вне замера) ------------------------------------------------
Сообщить("длина документа: " + Формат(СтрДлина(Текст), "ЧГ=0")
	+ ", узлов: " + Формат(Узлов / Проходов, "ЧГ=0")
	+ ", элементов: " + Формат(Элементов / Проходов, "ЧГ=0")
	+ ", атрибутов: " + Формат(Атрибутов / Проходов, "ЧГ=0")
	+ ", сумма ид: " + Формат(СуммаИД / Проходов, "ЧГ=0")
	+ ", длина значений: " + Формат(ДлинаЗначений / Проходов, "ЧГ=0"));
Сообщить(Формат(Прошло, "ЧГ=0"));
