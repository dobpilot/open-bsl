// Запись XML: тот же документ, что читает `xml_parse`, порождается
// потоковой `ЗаписьXML`.
//
// Пара к `xml_parse` симметрична так же, как `json_write` к `json_parse`, и
// форма записи взята ТА ЖЕ, что в JSON-сценариях — контрагент с реквизитами,
// банковским счётом и двумя адресами, 10 000 штук, 3 прохода. Это сделано
// нарочно: четыре строки таблицы тогда читаются вместе, и видно не только
// «загрузка против выгрузки», но и во что рантайму обходятся два формата на
// одних и тех же данных.
//
// Чего в JSON НЕТ и что меряется здесь дополнительно — атрибуты. В обмене
// 1С реквизиты обычно уходят именно атрибутами, а не вложенными
// элементами, поэтому половина полей записана так: `ЗаписатьАтрибут`
// экранирует иначе, чем `ЗаписатьТекст` (кавычка в атрибуте экранируется, в
// тексте нет), и стоит отдельного пути в писателе.
//
// Отступ ОТКЛЮЧЁН намеренно: с ним замер включал бы ещё и расстановку
// табуляций, а у JSON-пары переносы строк тоже выключены. Меряется
// структура документа, а не его красота.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

ЧислоЗаписей = 10000;
Проходов = 3;

Т = ТекущаяУниверсальнаяДатаВМиллисекундах();
Длина = 0;
Для п = 1 По Проходов Цикл
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиXML("UTF-8", "1.0", Ложь));
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента("контрагенты");
	Флаг = Ложь;
	Для н = 1 По ЧислоЗаписей Цикл
		Флаг = Не Флаг;
		Ном = Формат(н, "ЧГ=0");

		Запись.ЗаписатьНачалоЭлемента("запись");
		Запись.ЗаписатьАтрибут("ид", Ном);
		Запись.ЗаписатьАтрибут("активен", Строка(Флаг));

		Запись.ЗаписатьНачалоЭлемента("имя");
		Запись.ЗаписатьТекст("запись номер " + Ном);
		Запись.ЗаписатьКонецЭлемента();

		Запись.ЗаписатьНачалоЭлемента("цена");
		Запись.ЗаписатьТекст(Формат(н + 0.75, "ЧГ=0; ЧРД=."));
		Запись.ЗаписатьКонецЭлемента();

		Запись.ЗаписатьНачалоЭлемента("теги");
		Запись.ЗаписатьНачалоЭлемента("тег");
		Запись.ЗаписатьТекст("альфа");
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьНачалоЭлемента("тег");
		Запись.ЗаписатьТекст("бета");
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьНачалоЭлемента("тег");
		Запись.ЗаписатьТекст("гамма");
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьКонецЭлемента();

		Запись.ЗаписатьНачалоЭлемента("вложенное");
		Запись.ЗаписатьАтрибут("число", Ном);
		Запись.ЗаписатьТекст("значение");
		Запись.ЗаписатьКонецЭлемента();

		Запись.ЗаписатьНачалоЭлемента("контрагент");
		Запись.ЗаписатьАтрибут("инн", "77010" + Ном);
		Запись.ЗаписатьАтрибут("кпп", "770101001");

		Запись.ЗаписатьНачалоЭлемента("наименование");
		Запись.ЗаписатьТекст("ООО Ромашка " + Ном);
		Запись.ЗаписатьКонецЭлемента();

		Запись.ЗаписатьНачалоЭлемента("банковскийСчет");
		Запись.ЗаписатьАтрибут("номер", "4070281090000000" + Ном);
		Запись.ЗаписатьАтрибут("бик", "044525225");
		Запись.ЗаписатьАтрибут("коррсчет", "30101810400000000225");
		Запись.ЗаписатьНачалоЭлемента("банк");
		Запись.ЗаписатьТекст("АО Банк " + Ном);
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьКонецЭлемента();

		Запись.ЗаписатьНачалоЭлемента("юрАдрес");
		Запись.ЗаписатьАтрибут("индекс", "101000");
		Запись.ЗаписатьНачалоЭлемента("регион");
		Запись.ЗаписатьТекст("Москва");
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьНачалоЭлемента("город");
		Запись.ЗаписатьТекст("Москва");
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьНачалоЭлемента("адрес");
		Запись.ЗаписатьТекст("ул. Тверская, д. " + Ном);
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьКонецЭлемента();

		Запись.ЗаписатьНачалоЭлемента("фактическийАдрес");
		Запись.ЗаписатьАтрибут("индекс", "141400");
		Запись.ЗаписатьНачалоЭлемента("регион");
		Запись.ЗаписатьТекст("Московская область");
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьНачалоЭлемента("город");
		Запись.ЗаписатьТекст("Химки");
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьНачалоЭлемента("адрес");
		Запись.ЗаписатьТекст("ул. Победы, д. " + Ном);
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьКонецЭлемента();

		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();
	Текст = Запись.Закрыть();
	Длина = Длина + СтрДлина(Текст);
КонецЦикла;
Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

// --- проверка (вне замера) ------------------------------------------------
// Длина суммируется по всем проходам: рантайм, «ускорившийся» пропуском
// части документа, разойдётся здесь с остальными сразу.
Сообщить("длина документа: " + Формат(Длина / Проходов, "ЧГ=0")
	+ ", проходов: " + Формат(Проходов, "ЧГ=0"));
Сообщить(Формат(Прошло, "ЧГ=0"));
