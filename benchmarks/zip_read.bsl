// Распаковка ZIP: один архив распаковывается `ЧтениеZipФайла` целиком.
//
// Что именно меряется: чтение central directory, inflate (RFC 1951) каждой
// записи и файловый вывод распакованных байтов на диск. Разделять эти
// стоимости здесь незачем: в реальном коде `ИзвлечьВсе` зовут именно ради
// файлов на диске, а не ради обхода каталога.
//
// Используется `ЧтениеZipФайла`, а не более новый `ЧтениеФайлаАрхива`:
// поверхность у них для ZIP одинакова, а `ЧтениеZipФайла` есть и в
// OneScript, и в платформе — поэтому колонка oscript не пустая.
//
// Входной архив — `benchmarks/data/zip-corpus.zip`, 2,3 МБ сжато, 7,3 МБ
// исходных (породил `make-zip-corpus.py` из `input_regexp.txt` и двух XSD).
// Сжатие deflate, три записи. Перегенерировать архив ради прогона не нужно:
// он лежит в репозитории воспроизводимым.
//
// Сверка: после остановки часов считается сумма размеров распакованных
// файлов на диске. Архив один и тот же для всех рантаймов, поэтому и файлы
// на выходе совпадают побайтно — сумма размеров обязана сойтись. Содержимое
// отдельно проверено conformance-фикстурой `zip-read`, здесь же контроль
// только в том, что `ИзвлечьВсе` честно положил столько байт, сколько заявил
// каталог.
//
// КОЛОНКА 1С СНИМАЕТСЯ С АБСОЛЮТНЫМ ПУТЁМ: у платформы свой текущий каталог,
// поэтому одиночный прогон идёт по копии с подменённой строкой — ровно та
// же подмена, что делает `build-combined.py` для свода:
//
//     sed "s|\"benchmarks/data/|\"$PWD/benchmarks/data/|" \
//         benchmarks/zip_read.bsl > /tmp/zr.bsl
//     ONEC_TIMEOUT=900 ./tests/conformance/measure/1c/run-on-1c.sh /tmp/zr.bsl
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

Процедура Распаковать(ПутьАрхива, Куда)
	Попытка
		Чт = Новый ЧтениеZipФайла(ПутьАрхива);
	Исключение
		Сообщить("не открылся " + ПутьАрхива + " — сценарий гоняется из корня дерева");
		Возврат;
	КонецПопытки;

	Т = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Чт.ИзвлечьВсе(Куда);
	Чт.Закрыть();
	Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

	// Контрольная величина — после остановки часов: сумма размеров
	// распакованных файлов на диске. Один архив → одни и те же байты у
	// всех рантаймов, поэтому сумма сходится. Открываем архив вторично:
	// первый читатель уже закрыт, а коллекцию `Элементы` до закрытия
	// держать незачем — она относится к распаковке, не к контролю.
	Контроль = Новый ЧтениеZipФайла(ПутьАрхива);
	Байт = 0;
	Записей = 0;
	Для Каждого Элемент Из Контроль.Элементы Цикл
		Записей = Записей + 1;
		ДД = Новый ДвоичныеДанные(Куда + "/" + Элемент.Имя);
		Байт = Байт + ДД.Размер();
	КонецЦикла;
	Контроль.Закрыть();

	Сообщить("записей: " + Формат(Записей, "ЧГ=0") + ", байт: " + Формат(Байт, "ЧГ=0"));
	Сообщить(Формат(Прошло, "ЧГ=0"));
КонецПроцедуры

// Путь относительный, от корня дерева: так его видят и `run.sh`, и двойники.
// Платформе он не годится — её текущий каталог свой, — поэтому прогон на
// платформе идёт по копии с подменённой строкой (см. шапку).
Распаковать("benchmarks/data/zip-corpus.zip", "/tmp/open-bsl-zip-read-out");
