		+ "#КонецОбласти" + Символ(10)
		+ "#Область СоставШапка" + Символ(10)
		+ "+--------------------------------+----------------+------------+------------+" + Символ(10)
		+ "|        Номенклатура            |   Количество   |    Цена    |    Сумма   |" + Символ(10)
		+ "+--------------------------------+----------------+------------+------------+" + Символ(10)
		+ "#КонецОбласти" + Символ(10)
		+ "#Область Состав" + Символ(10)
		+ "|[Номенклатура                  ]|[Количество    ]|[Цена      ]|[Сумма     ]|" + Символ(10)
		+ "+--------------------------------+----------------+------------+------------+" + Символ(10)
