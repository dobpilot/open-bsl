Процедура Сценарий_goto_bench()
// Горячий граф из восьми блоков. В отличие от повреждённого исходного
// примера этот сценарий компилируется на 1С и сохраняет измеряемое свойство:
// каждый проход выполняет цепочку условных и безусловных переходов.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

Итерация = 0;
Состояние = 0;
Сумма = 0;
Т = ТекущаяУниверсальнаяДатаВМиллисекундах();

~Диспетчер:
Если Состояние = 0 Тогда Goto ~Ветка0; КонецЕсли;
Если Состояние = 1 Тогда Goto ~Ветка1; КонецЕсли;
Если Состояние = 2 Тогда Goto ~Ветка2; КонецЕсли;
Если Состояние = 3 Тогда Goto ~Ветка3; КонецЕсли;
Если Состояние = 4 Тогда Goto ~Ветка4; КонецЕсли;
Если Состояние = 5 Тогда Goto ~Ветка5; КонецЕсли;
Если Состояние = 6 Тогда Goto ~Ветка6; КонецЕсли;
Goto ~Ветка7;

~Ветка0:
Сумма = Сумма + 1;
Состояние = 1;
Goto ~Следующая;

~Ветка1:
Сумма = Сумма + 3;
Состояние = 2;
Goto ~Следующая;

~Ветка2:
Сумма = Сумма + 5;
Состояние = 3;
Goto ~Следующая;

~Ветка3:
Сумма = Сумма + 7;
Состояние = 4;
Goto ~Следующая;

~Ветка4:
Сумма = Сумма + 11;
Состояние = 5;
Goto ~Следующая;

~Ветка5:
Сумма = Сумма + 13;
Состояние = 6;
Goto ~Следующая;

~Ветка6:
Сумма = Сумма + 17;
Состояние = 7;
Goto ~Следующая;

~Ветка7:
Сумма = Сумма + 19;
Состояние = 0;

~Следующая:
Итерация = Итерация + 1;
Если Итерация < 2000000 Тогда Goto ~Диспетчер; КонецЕсли;

Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;
Сообщить("сумма: " + Формат(Сумма, "ЧГ=0"));
Сообщить(Формат(Прошло, "ЧГ=0; ЧН=0"));
КонецПроцедуры

Процедура Сценарий_invoice_doc_generator()
// ТабличныйДокумент: формирование расходной накладной по макету
// invoice_template.mxl (платформенный MXL, читается напрямую). Макет
// содержит именованные области Заголовок, Поставщик, Покупатель,
// ШапкаТаблицы, Строка, Итого. Ячейки области «Строка» помечены именами
// параметров (НомерСтроки, Товар, Количество, Цена, Сумма и т. д.),
// значения в них подставляются через
// `ЗаполнитьЗначенияСвойств(Область.Параметры, ДанныеСтроки)`.
//
// Документ содержит 100 000 позиций. Контрольная строка печатает количество
// строк и итог, чтобы рантайм, пропустивший часть документа, не дал
// сравнимое число.
//
// Замеряются четыре фазы: генерация табличного документа и сохранения в
// MXL, PDF и XLSX. Каждая печатается отдельной строкой `Сообщить`.
//
// Контракт бенчмарка: последняя напечатанная строка — сумма миллисекунд
// всех четырёх фаз (генерация + mxl + pdf + xlsx) числом.

ПОЗИЦИЙ = 100000;

Т = ТекущаяУниверсальнаяДатаВМиллисекундах();

Макет = Новый ТабличныйДокумент;
Макет.Прочитать("/home/kan/Документы/develop/open-bsl/benchmarks/data/invoice_template.mxl");

Документ = Новый ТабличныйДокумент;

// Заголовок — параметр ТекстЗаголовка (col 2 строки 2 области).
Область = Макет.ПолучитьОбласть("Заголовок");
Область.Параметры.ТекстЗаголовка = "Расходная накладная № 00011 от 10.05.2002";
Документ.Вывести(Область);

// Поставщик — «Поставщик:» уже стоит в col 2; представление — col 6.
Область = Макет.ПолучитьОбласть("Поставщик");
Область.Параметры.ПредставлениеПоставщика = "ООО «Эльбрус»";
Документ.Вывести(Область);

// Покупатель — «Покупатель:» уже стоит в col 2; представление — col 6.
Область = Макет.ПолучитьОбласть("Покупатель");
Область.Параметры.ПредставлениеПолучателя = "Склад «Основной»";
Документ.Вывести(Область);

// Шапка таблицы — заголовки колонок. Параметр ИмяКолонкиКодов задаёт
// заголовок колонки кодов товара.
Область = Макет.ПолучитьОбласть("ШапкаТаблицы");
Область.Параметры.ИмяКолонкиКодов = "Артикул";
Документ.Вывести(Область);

// Строки номенклатуры. Параметры области «Строка» (1-based колонки
// макета): НомерСтроки, Помещение, Артикул, Товар, Количество,
// ЕдиницаИзмерения, Цена, СуммаБезСкидки, Скидка, СуммаНДС, Сумма.
Итог = 0;
ИтогНДС = 0;
ОбластьСтроки = Макет.ПолучитьОбласть("Строка");
Для НомерСтроки = 1 По ПОЗИЦИЙ Цикл
	Количество = 1 + (НомерСтроки % 10);
	Цена = 10 + (НомерСтроки % 997) / 10;
	Сумма = Количество * Цена;
	СуммаНДС = Сумма * 20 / 120;
	Итог = Итог + Сумма;
	ИтогНДС = ИтогНДС + СуммаНДС;

	ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить("НомерСтроки", НомерСтроки);
	ДанныеСтроки.Вставить("Помещение", "Основной склад");
	ДанныеСтроки.Вставить("Артикул", НомерСтроки);
	ДанныеСтроки.Вставить("Товар",
		"Товар расходной накладной " + Формат(НомерСтроки, "ЧГ=0"));
	ДанныеСтроки.Вставить("Количество", Количество);
	ДанныеСтроки.Вставить("ЕдиницаИзмерения", "шт");
	ДанныеСтроки.Вставить("Цена", Цена);
	ДанныеСтроки.Вставить("СуммаБезСкидки", Сумма);
	ДанныеСтроки.Вставить("Скидка", 0);
	ДанныеСтроки.Вставить("СуммаНДС", СуммаНДС);
	ДанныеСтроки.Вставить("Сумма", Сумма);

	ЗаполнитьЗначенияСвойств(ОбластьСтроки.Параметры, ДанныеСтроки);
	Документ.Вывести(ОбластьСтроки);
КонецЦикла;

// Итого (строки 32-33 макета). Параметры: ВсегоБезСкидок, ВсегоСкидок,
// СуммаНДС, Сумма. «Итого:» стоит в row 2 col 8.
Область = Макет.ПолучитьОбласть("Итого");
Область.Параметры.ВсегоБезСкидок = Итог;
Область.Параметры.ВсегоСкидок = 0;
Область.Параметры.СуммаНДС = ИтогНДС;
Область.Параметры.Сумма = Итог;
Документ.Вывести(Область);

ВремяГенерации = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

Сообщить("позиций: " + Формат(ПОЗИЦИЙ, "ЧГ=0")
	+ ", строк: " + Формат(Документ.ВысотаТаблицы, "ЧГ=0")
	+ ", итог: " + Формат(Итог, "ЧГ=0; ЧДЦ=2; ЧРД=."));
Сообщить("генерация: " + Формат(ВремяГенерации, "ЧГ=0") + " мс");

НВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();
Документ.Записать("/tmp/onec-bench-scratch/invoice_doc.mxl", ТипФайлаТабличногоДокумента.MXL);
ВремяMXL = ТекущаяУниверсальнаяДатаВМиллисекундах() - НВремя;
Сообщить("mxl: " + Формат(ВремяMXL, "ЧГ=0") + " мс");

НВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();
Документ.Записать("/tmp/onec-bench-scratch/invoice_doc.pdf", ТипФайлаТабличногоДокумента.PDF);
ВремяPDF = ТекущаяУниверсальнаяДатаВМиллисекундах() - НВремя;
Сообщить("pdf: " + Формат(ВремяPDF, "ЧГ=0") + " мс");

НВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();
Документ.Записать("/tmp/onec-bench-scratch/invoice_doc.xlsx", ТипФайлаТабличногоДокумента.XLSX);
ВремяXLSX = ТекущаяУниверсальнаяДатаВМиллисекундах() - НВремя;
Сообщить("xlsx: " + Формат(ВремяXLSX, "ЧГ=0") + " мс");

// Контракт run.sh: последняя строка — миллисекунды голым числом. Предмет
// замера — весь конвейер: формирование плюс три сохранения.
Сообщить(Формат(ВремяГенерации + ВремяMXL + ВремяPDF + ВремяXLSX, "ЧГ=0;ЧН=0"));
КонецПроцедуры

Процедура Сценарий_json_parse()
// Разбор JSON: один документ читается `ПрочитатьJSON` много раз подряд.
//
// Что именно меряется: сканер текста ПЛЮС построение значений — объект
// становится `Структура` (с интернированием имён и заведением формы),
// массив — `Массив`. Разделять эти две стоимости здесь незачем: в реальном
// коде `ПрочитатьJSON` вызывают именно ради готового значения, а не ради
// обхода токенов.
//
// Форма записи — контрагент с реквизитами, банковским счётом и двумя
// адресами, — взята нарочно: это типовой обмен 1С, а не синтетический
// плоский объект. Вложенность в четыре уровня и полсотни свойств на
// запись нагружают заведение форм структур куда сильнее, чем плоский
// список пар.
//
// Документ собирается ОДИН раз через `ЗаписьJSON` и в замер не входит:
// меряется чтение, а не запись. Обход результата ради контрольной суммы —
// тоже вне замера, он одинаков у всех рантаймов и только разбавлял бы
// число.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

// 10 000 записей — документ на 5,6 МБ код-юнитов, размер выгрузки, какую
// в 1С и правда гоняют. Проходов всего три: один проход сам по себе идёт
// сотни миллисекунд, то есть на три порядка выше разрешения таймера, и
// накручивать повторы значило бы только удлинять прогон всего набора.
ЧислоЗаписей = 10000;
Проходов = 3;

// --- сборка документа (вне замера) --------------------------------------
Запись = Новый ЗаписьJSON;
Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
Запись.ЗаписатьНачалоМассива();
Флаг = Ложь;
Для н = 1 По ЧислоЗаписей Цикл
	Флаг = Не Флаг;
	Ном = Формат(н, "ЧГ=0");

	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("ид");
	Запись.ЗаписатьЗначение(н);
	Запись.ЗаписатьИмяСвойства("имя");
	Запись.ЗаписатьЗначение("запись номер " + Ном);
	Запись.ЗаписатьИмяСвойства("активен");
	Запись.ЗаписатьЗначение(Флаг);
	Запись.ЗаписатьИмяСвойства("цена");
	Запись.ЗаписатьЗначение(н + 0.75);
	Запись.ЗаписатьИмяСвойства("теги");
	Запись.ЗаписатьНачалоМассива();
	Запись.ЗаписатьЗначение("альфа");
	Запись.ЗаписатьЗначение("бета");
	Запись.ЗаписатьЗначение("гамма");
	Запись.ЗаписатьКонецМассива();
	Запись.ЗаписатьИмяСвойства("вложенное");
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("ключ");
	Запись.ЗаписатьЗначение("значение");
	Запись.ЗаписатьИмяСвойства("число");
	Запись.ЗаписатьЗначение(н);
	Запись.ЗаписатьКонецОбъекта();

	Запись.ЗаписатьИмяСвойства("контрагент");
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("инн");
	Запись.ЗаписатьЗначение("77010" + Ном);
	Запись.ЗаписатьИмяСвойства("кпп");
	Запись.ЗаписатьЗначение("770101001");
	Запись.ЗаписатьИмяСвойства("наименование");
	Запись.ЗаписатьЗначение("ООО Ромашка " + Ном);

	Запись.ЗаписатьИмяСвойства("банковскийСчет");
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("номер");
	Запись.ЗаписатьЗначение("4070281090000000" + Ном);
	Запись.ЗаписатьИмяСвойства("банк");
	Запись.ЗаписатьЗначение("АО Банк " + Ном);
	Запись.ЗаписатьИмяСвойства("бик");
	Запись.ЗаписатьЗначение("044525225");
	Запись.ЗаписатьИмяСвойства("коррсчет");
	Запись.ЗаписатьЗначение("30101810400000000225");
	Запись.ЗаписатьКонецОбъекта();

	Запись.ЗаписатьИмяСвойства("юрАдрес");
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("регион");
	Запись.ЗаписатьЗначение("Москва");
	Запись.ЗаписатьИмяСвойства("город");
	Запись.ЗаписатьЗначение("Москва");
	Запись.ЗаписатьИмяСвойства("индекс");
	Запись.ЗаписатьЗначение("101000");
	Запись.ЗаписатьИмяСвойства("адрес");
	Запись.ЗаписатьЗначение("ул. Тверская, д. " + Ном);
	Запись.ЗаписатьКонецОбъекта();

	Запись.ЗаписатьИмяСвойства("фактическийАдрес");
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("регион");
	Запись.ЗаписатьЗначение("Московская область");
	Запись.ЗаписатьИмяСвойства("город");
	Запись.ЗаписатьЗначение("Химки");
	Запись.ЗаписатьИмяСвойства("индекс");
	Запись.ЗаписатьЗначение("141400");
	Запись.ЗаписатьИмяСвойства("адрес");
	Запись.ЗаписатьЗначение("ул. Победы, д. " + Ном);
	Запись.ЗаписатьКонецОбъекта();

	Запись.ЗаписатьКонецОбъекта();
	Запись.ЗаписатьКонецОбъекта();
КонецЦикла;
Запись.ЗаписатьКонецМассива();
Текст = Запись.Закрыть();

// --- замер ---------------------------------------------------------------
Т = ТекущаяУниверсальнаяДатаВМиллисекундах();
Записей = 0;
Для п = 1 По Проходов Цикл
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(Чтение);
	Записей = Записей + Данные.Количество();
КонецЦикла;
Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

// --- проверка (вне замера) ------------------------------------------------
// Сумма трогает ВСЕ четыре уровня вложенности: рантайм, «ускорившийся»
// пропуском хвоста записи или недочитанным поддеревом, здесь сразу
// разойдётся с остальными.
//
// В сумму берутся ТОЛЬКО поля из цифр. Причина не в лени: `СтрДлина` меряет
// код-юниты UTF-16, а `#` в Lua — байты, и на кириллице числа разошлись бы
// от разницы кодировок, а не от разницы разбора. Кириллические поля
// проверяются отдельным счётчиком заполненности — он от кодировки не
// зависит.
Сумма = 0;
Полных = 0;
Для Каждого Стр Из Данные Цикл
	К = Стр.контрагент;
	Сумма = Сумма + Стр.ид + Стр.вложенное.число
		+ СтрДлина(К.инн) + СтрДлина(К.кпп)
		+ СтрДлина(К.банковскийСчет.номер) + СтрДлина(К.банковскийСчет.бик)
		+ СтрДлина(К.банковскийСчет.коррсчет)
		+ СтрДлина(К.юрАдрес.индекс) + СтрДлина(К.фактическийАдрес.индекс);
	Если СтрДлина(К.наименование) > 0 И СтрДлина(К.юрАдрес.адрес) > 0
		И СтрДлина(К.фактическийАдрес.город) > 0 И СтрДлина(Стр.теги[2]) > 0 Тогда
		Полных = Полных + 1;
	КонецЕсли;
КонецЦикла;

Сообщить("длина документа: " + Формат(СтрДлина(Текст), "ЧГ=0")
	+ ", записей: " + Формат(Записей, "ЧГ=0")
	+ ", сумма: " + Формат(Сумма, "ЧГ=0")
	+ ", полных: " + Формат(Полных, "ЧГ=0"));
Сообщить(Формат(Прошло, "ЧГ=0"));
КонецПроцедуры

Процедура Сценарий_json_write()
// Запись JSON: тот же документ, что читает `json_parse`, но меряется его
// ПОРОЖДЕНИЕ через потоковую `ЗаписьJSON`.
//
// Пара к `json_parse` намеренно симметрична: одна и та же форма записи и
// одно и то же их число, поэтому две строки таблицы можно читать вместе —
// во что рантайму обходится выгрузка против загрузки.
//
// Что именно меряется: вызовы `ЗаписатьИмяСвойства`/`ЗаписатьЗначение` с
// экранированием строк, проверкой структуры документа и накоплением
// результата. Финальный `Закрыть()` входит в замер — он и отдаёт текст.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

ЧислоЗаписей = 10000;
Проходов = 3;

Т = ТекущаяУниверсальнаяДатаВМиллисекундах();
Длина = 0;
Для п = 1 По Проходов Цикл
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	Запись.ЗаписатьНачалоМассива();
	Флаг = Ложь;
	Для н = 1 По ЧислоЗаписей Цикл
		Флаг = Не Флаг;
		Ном = Формат(н, "ЧГ=0");

		Запись.ЗаписатьНачалоОбъекта();
		Запись.ЗаписатьИмяСвойства("ид");
		Запись.ЗаписатьЗначение(н);
		Запись.ЗаписатьИмяСвойства("имя");
		Запись.ЗаписатьЗначение("запись номер " + Ном);
		Запись.ЗаписатьИмяСвойства("активен");
		Запись.ЗаписатьЗначение(Флаг);
		Запись.ЗаписатьИмяСвойства("цена");
		Запись.ЗаписатьЗначение(н + 0.75);
		Запись.ЗаписатьИмяСвойства("теги");
		Запись.ЗаписатьНачалоМассива();
		Запись.ЗаписатьЗначение("альфа");
		Запись.ЗаписатьЗначение("бета");
		Запись.ЗаписатьЗначение("гамма");
		Запись.ЗаписатьКонецМассива();
		Запись.ЗаписатьИмяСвойства("вложенное");
		Запись.ЗаписатьНачалоОбъекта();
		Запись.ЗаписатьИмяСвойства("ключ");
		Запись.ЗаписатьЗначение("значение");
		Запись.ЗаписатьИмяСвойства("число");
		Запись.ЗаписатьЗначение(н);
		Запись.ЗаписатьКонецОбъекта();

		Запись.ЗаписатьИмяСвойства("контрагент");
		Запись.ЗаписатьНачалоОбъекта();
		Запись.ЗаписатьИмяСвойства("инн");
		Запись.ЗаписатьЗначение("77010" + Ном);
		Запись.ЗаписатьИмяСвойства("кпп");
		Запись.ЗаписатьЗначение("770101001");
		Запись.ЗаписатьИмяСвойства("наименование");
		Запись.ЗаписатьЗначение("ООО Ромашка " + Ном);

		Запись.ЗаписатьИмяСвойства("банковскийСчет");
		Запись.ЗаписатьНачалоОбъекта();
		Запись.ЗаписатьИмяСвойства("номер");
		Запись.ЗаписатьЗначение("4070281090000000" + Ном);
		Запись.ЗаписатьИмяСвойства("банк");
		Запись.ЗаписатьЗначение("АО Банк " + Ном);
		Запись.ЗаписатьИмяСвойства("бик");
		Запись.ЗаписатьЗначение("044525225");
		Запись.ЗаписатьИмяСвойства("коррсчет");
		Запись.ЗаписатьЗначение("30101810400000000225");
		Запись.ЗаписатьКонецОбъекта();

		Запись.ЗаписатьИмяСвойства("юрАдрес");
		Запись.ЗаписатьНачалоОбъекта();
		Запись.ЗаписатьИмяСвойства("регион");
		Запись.ЗаписатьЗначение("Москва");
		Запись.ЗаписатьИмяСвойства("город");
		Запись.ЗаписатьЗначение("Москва");
		Запись.ЗаписатьИмяСвойства("индекс");
		Запись.ЗаписатьЗначение("101000");
		Запись.ЗаписатьИмяСвойства("адрес");
		Запись.ЗаписатьЗначение("ул. Тверская, д. " + Ном);
		Запись.ЗаписатьКонецОбъекта();

		Запись.ЗаписатьИмяСвойства("фактическийАдрес");
		Запись.ЗаписатьНачалоОбъекта();
		Запись.ЗаписатьИмяСвойства("регион");
		Запись.ЗаписатьЗначение("Московская область");
		Запись.ЗаписатьИмяСвойства("город");
		Запись.ЗаписатьЗначение("Химки");
		Запись.ЗаписатьИмяСвойства("индекс");
		Запись.ЗаписатьЗначение("141400");
		Запись.ЗаписатьИмяСвойства("адрес");
		Запись.ЗаписатьЗначение("ул. Победы, д. " + Ном);
		Запись.ЗаписатьКонецОбъекта();

		Запись.ЗаписатьКонецОбъекта();
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	Длина = СтрДлина(Запись.Закрыть());
КонецЦикла;
Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

// Длина документа — та же контрольная величина, что у `json_parse`:
// рантайм, записавший меньше, сразу здесь и разойдётся.
Сообщить("длина документа: " + Формат(Длина, "ЧГ=0")
	+ ", проходов: " + Формат(Проходов, "ЧГ=0"));
Сообщить(Формат(Прошло, "ЧГ=0"));
КонецПроцедуры

