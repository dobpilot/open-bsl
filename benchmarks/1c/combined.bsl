Процедура Сценарий_json_parse()
// Разбор JSON: один документ читается `ПрочитатьJSON` много раз подряд.
//
// Что именно меряется: сканер текста ПЛЮС построение значений — объект
// становится `Структура` (с интернированием имён и заведением формы),
// массив — `Массив`. Разделять эти две стоимости здесь незачем: в реальном
// коде `ПрочитатьJSON` вызывают именно ради готового значения, а не ради
// обхода токенов.
//
// Документ собирается ОДИН раз и в замер не входит: меряется чтение, а не
// конкатенация строк. Обход результата ради контрольной суммы — тоже вне
// замера, он одинаков у всех рантаймов и только разбавлял бы число.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

ЧислоЗаписей = 2000;
Проходов = 20;

// --- сборка документа (вне замера) --------------------------------------
// Через массив и СтрСоединить, а не сложением в цикле: у сложения строк
// свой бенчмарк (str_concat), и мешать его сюда значит мерять не то.
Части = Новый Массив;
Части.Добавить("[");
Флаг = "false";
Для н = 1 По ЧислоЗаписей Цикл
	Если н > 1 Тогда
		Части.Добавить(",");
	КонецЕсли;
	// Через переключатель, а не остаток от деления: оператора % в языке
	// нет, а заводить деление ради чередования флага незачем.
	Если Флаг = "true" Тогда
		Флаг = "false";
	Иначе
		Флаг = "true";
	КонецЕсли;
	Части.Добавить("{""ид"":" + Формат(н, "ЧГ=0")
		+ ",""имя"":""запись номер " + Формат(н, "ЧГ=0") + """"
		+ ",""активен"":" + Флаг
		+ ",""цена"":" + Формат(н, "ЧГ=0") + ".75"
		+ ",""теги"":[""альфа"",""бета"",""гамма""]"
		+ ",""вложенное"":{""ключ"":""значение"",""число"":" + Формат(н, "ЧГ=0") + "}}");
КонецЦикла;
Части.Добавить("]");
Текст = СтрСоединить(Части, "");

// --- замер ---------------------------------------------------------------
Т = ТекущаяУниверсальнаяДатаВМиллисекундах();
Записей = 0;
Для п = 1 По Проходов Цикл
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(Чтение);
	Записей = Записей + Данные.Количество();
КонецЦикла;
Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

// --- проверка (вне замера) ------------------------------------------------
// Сумма идентификаторов доказывает, что разобрано всё, а не первые
// несколько элементов: рантайм, «ускорившийся» пропуском хвоста, здесь
// сразу разойдётся с остальными.
Сумма = 0;
Для Каждого Запись Из Данные Цикл
	Сумма = Сумма + Запись.ид + Запись.вложенное.число;
КонецЦикла;

Сообщить("длина документа: " + Формат(СтрДлина(Текст), "ЧГ=0")
	+ ", записей: " + Формат(Записей, "ЧГ=0")
	+ ", сумма: " + Формат(Сумма, "ЧГ=0"));
Сообщить(Формат(Прошло, "ЧГ=0"));
КонецПроцедуры

Процедура CalcНаСервере_pi_leibniz()
    sum = 0.0;
    flip = -1.0;

    Для i = 1 По 1000000 Цикл
        flip = -flip;
        sum = sum + flip / (2 * i - 1);
    КонецЦикла;

    Сообщить(sum * 4);
КонецПроцедуры

