// Сумма трогает ВСЕ четыре уровня вложенности: рантайм, «ускорившийся»
// пропуском хвоста записи или недочитанным поддеревом, здесь сразу
// разойдётся с остальными.
//
// В сумму берутся ТОЛЬКО поля из цифр. Причина не в лени: `СтрДлина` меряет
// код-юниты UTF-16, а `#` в Lua — байты, и на кириллице числа разошлись бы
// от разницы кодировок, а не от разницы разбора. Кириллические поля
// проверяются отдельным счётчиком заполненности — он от кодировки не
// зависит.
Сумма = 0;
Полных = 0;
Для Каждого Стр Из Данные Цикл
	К = Стр.контрагент;
	Сумма = Сумма + Стр.ид + Стр.вложенное.число
		+ СтрДлина(К.инн) + СтрДлина(К.кпп)
		+ СтрДлина(К.банковскийСчет.номер) + СтрДлина(К.банковскийСчет.бик)
		+ СтрДлина(К.банковскийСчет.коррсчет)
		+ СтрДлина(К.юрАдрес.индекс) + СтрДлина(К.фактическийАдрес.индекс);
	Если СтрДлина(К.наименование) > 0 И СтрДлина(К.юрАдрес.адрес) > 0
		И СтрДлина(К.фактическийАдрес.город) > 0 И СтрДлина(Стр.теги[2]) > 0 Тогда
		Полных = Полных + 1;
	КонецЕсли;
КонецЦикла;

Сообщить("длина документа: " + Формат(СтрДлина(Текст), "ЧГ=0")
	+ ", записей: " + Формат(Записей, "ЧГ=0")
	+ ", сумма: " + Формат(Сумма, "ЧГ=0")
	+ ", полных: " + Формат(Полных, "ЧГ=0"));
Сообщить(Формат(Прошло, "ЧГ=0"));
КонецПроцедуры

