Процедура Сценарий_regexp()
// Тройка шаблонов из regex-benchmark (github.com/mariomka/regex-benchmark):
// почта, URI и IPv4 по одному большому тексту, счёт всех совпадений.
// Вход — input-text.txt того же репозитория: 6,5 МБ многоязычного текста
// (16 % байтов — не ASCII), в дереве лежит как
// `benchmarks/data/input_regexp.txt`.
//
// Меряется только поиск — три вызова `СтрНайтиВсеПоРегулярномуВыражению`
// подряд, как у апстрима (там re.findall после file.read()); чтение файла
// и раскодировка UTF-8 в замер не входят. Число совпадений печатается по
// каждому шаблону: двойник, насчитавший другое, — не быстрый, а сломанный.
// На этом корпусе все исполнители сходятся: почта 92, URI 5301, IP 6.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

Данные = Новый ДвоичныеДанные("/home/kan/Документы/develop/open-bsl/benchmarks/data/input_regexp.txt");
Текст = ПолучитьСтрокуИзДвоичныхДанных(Данные, "UTF-8");

Т = ТекущаяУниверсальнаяДатаВМиллисекундах();
Почты = СтрНайтиВсеПоРегулярномуВыражению(Текст, "[\w\.+-]+@[\w\.-]+\.[\w\.-]+");
Ссылки = СтрНайтиВсеПоРегулярномуВыражению(Текст, "[\w]+://[^/\s?#]+[^\s?#]+(?:\?[^\s#]*)?(?:#[^\s]*)?");
Адреса = СтрНайтиВсеПоРегулярномуВыражению(Текст, "(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)");
Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

// `ЧГ=0` убирает разрядный пробел: «5301», как у двойников, а не «5 301».
Сообщить("почта: " + Формат(Почты.Количество(), "ЧГ=0"));
Сообщить("URI: " + Формат(Ссылки.Количество(), "ЧГ=0"));
Сообщить("IP: " + Формат(Адреса.Количество(), "ЧГ=0"));
Сообщить(Формат(Прошло, "ЧГ=0"));
КонецПроцедуры

Функция ПрочитатьВарЦелое_simple_parquet_reader(Буф, Поз)
	Результат = 0;
	Множитель = 1;
	Пока Истина Цикл
		Б = Буф[Поз];
		Поз = Поз + 1;
		Результат = Результат + (Б % 128) * Множитель;
		Если Б < 128 Тогда
			Прервать;
		КонецЕсли;
		Множитель = Множитель * 128;
	КонецЦикла;
	Возврат Результат;
КонецФункции
Функция ПрочитатьЗигЗаг_simple_parquet_reader(Буф, Поз)
	Н = ПрочитатьВарЦелое_simple_parquet_reader(Буф, Поз);
	Если Н % 2 = 0 Тогда
		Возврат Н / 2;
	КонецЕсли;
	Возврат -(Н + 1) / 2;
КонецФункции
Функция ПрочитатьДвоичное_simple_parquet_reader(Буф, Поз)
	Длина = ПрочитатьВарЦелое_simple_parquet_reader(Буф, Поз);
	Если Длина = 0 Тогда
		Возврат "";
	КонецЕсли;
	Срез = Буф.ПолучитьСрез(Поз, Длина);
	Поз = Поз + Длина;
	Возврат ПолучитьСтрокуИзБуфераДвоичныхДанных(Срез, КодировкаТекста.UTF8);
КонецФункции
Функция ПрочитатьЗаголовокСписка_simple_parquet_reader(Буф, Поз, ТипЭлемента)
	ЗаголовокБайт = Буф[Поз];
	Поз = Поз + 1;
	ТипЭлемента = ЗаголовокБайт % 16;
	Количество = Цел(ЗаголовокБайт / 16);
	Если Количество = 15 Тогда
		Количество = ПрочитатьВарЦелое_simple_parquet_reader(Буф, Поз);
	КонецЕсли;
	Возврат Количество;
КонецФункции
Процедура ПропуститьЗначение_simple_parquet_reader(Буф, Поз, ТипПоля)
	Если ТипПоля = 1 Или ТипПоля = 2 Тогда
		// Булево целиком в тетраде типа, читать нечего.
	ИначеЕсли ТипПоля = 3 Тогда
		Поз = Поз + 1;
	ИначеЕсли ТипПоля = 4 Или ТипПоля = 5 Или ТипПоля = 6 Тогда
		ПрочитатьЗигЗаг_simple_parquet_reader(Буф, Поз);
	ИначеЕсли ТипПоля = 7 Тогда
		Поз = Поз + 8;
	ИначеЕсли ТипПоля = 8 Тогда
		ПрочитатьДвоичное_simple_parquet_reader(Буф, Поз);
	ИначеЕсли ТипПоля = 9 Или ТипПоля = 10 Тогда
		ТипЭлемента = 0;
		Количество = ПрочитатьЗаголовокСписка_simple_parquet_reader(Буф, Поз, ТипЭлемента);
		Для Н = 1 По Количество Цикл
			ПропуститьЗначение_simple_parquet_reader(Буф, Поз, ТипЭлемента);
		КонецЦикла;
	ИначеЕсли ТипПоля = 11 Тогда
		Количество = ПрочитатьВарЦелое_simple_parquet_reader(Буф, Поз);
		Если Количество > 0 Тогда
			ЗаголовокБайт = Буф[Поз];
			Поз = Поз + 1;
			ТипКлюча = Цел(ЗаголовокБайт / 16);
			ТипЗначения = ЗаголовокБайт % 16;
			Для Н = 1 По Количество Цикл
				ПропуститьЗначение_simple_parquet_reader(Буф, Поз, ТипКлюча);
				ПропуститьЗначение_simple_parquet_reader(Буф, Поз, ТипЗначения);
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли ТипПоля = 12 Тогда
		ПропуститьСтруктуру_simple_parquet_reader(Буф, Поз);
	Иначе
		ВызватьИсключение "parquet: неизвестный тип поля " + Формат(ТипПоля, "ЧГ=0");
	КонецЕсли;
КонецПроцедуры
Функция СледующееПоле_simple_parquet_reader(Буф, Поз, ПоследнийНомер, ТипПоля)
	ЗаголовокБайт = Буф[Поз];
	Поз = Поз + 1;
	Если ЗаголовокБайт = 0 Тогда
		ТипПоля = 0;
		Возврат 0;
	КонецЕсли;
	ТипПоля = ЗаголовокБайт % 16;
	Приращение = Цел(ЗаголовокБайт / 16);
	Если Приращение = 0 Тогда
		Номер = ПрочитатьЗигЗаг_simple_parquet_reader(Буф, Поз);
	Иначе
		Номер = ПоследнийНомер + Приращение;
	КонецЕсли;
	ПоследнийНомер = Номер;
	Возврат Номер;
КонецФункции
Процедура ПропуститьСтруктуру_simple_parquet_reader(Буф, Поз)
	ПоследнийНомер = 0;
	Пока Истина Цикл
		ТипПоля = 0;
		Номер = СледующееПоле_simple_parquet_reader(Буф, Поз, ПоследнийНомер, ТипПоля);
		Если Номер = 0 Тогда
			Прервать;
		КонецЕсли;
		ПропуститьЗначение_simple_parquet_reader(Буф, Поз, ТипПоля);
	КонецЦикла;
КонецПроцедуры
Функция ПрочитатьМетаКолонки_simple_parquet_reader(Буф, Поз)
	Колонка = Новый Структура("ИмяКолонки, ТипДанных, Кодек, Значений, Смещение, Словарь",
		"", -1, 0, 0, 0, 0);
	ПоследнийНомер = 0;
	Пока Истина Цикл
		ТипПоля = 0;
		Номер = СледующееПоле_simple_parquet_reader(Буф, Поз, ПоследнийНомер, ТипПоля);
		Если Номер = 0 Тогда
			Прервать;
		КонецЕсли;
		Если Номер = 1 Тогда
			Колонка.ТипДанных = ПрочитатьЗигЗаг_simple_parquet_reader(Буф, Поз);
		ИначеЕсли Номер = 3 Тогда
			ТипЭлемента = 0;
			Частей = ПрочитатьЗаголовокСписка_simple_parquet_reader(Буф, Поз, ТипЭлемента);
			Для Н = 1 По Частей Цикл
				Часть = ПрочитатьДвоичное_simple_parquet_reader(Буф, Поз);
				Если Колонка.ИмяКолонки = "" Тогда
					Колонка.ИмяКолонки = Часть;
				Иначе
					Колонка.ИмяКолонки = Колонка.ИмяКолонки + "." + Часть;
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли Номер = 4 Тогда
			Колонка.Кодек = ПрочитатьЗигЗаг_simple_parquet_reader(Буф, Поз);
		ИначеЕсли Номер = 5 Тогда
			Колонка.Значений = ПрочитатьЗигЗаг_simple_parquet_reader(Буф, Поз);
		ИначеЕсли Номер = 9 Тогда
			Колонка.Смещение = ПрочитатьЗигЗаг_simple_parquet_reader(Буф, Поз);
		ИначеЕсли Номер = 11 Тогда
			Колонка.Словарь = ПрочитатьЗигЗаг_simple_parquet_reader(Буф, Поз);
		Иначе
			ПропуститьЗначение_simple_parquet_reader(Буф, Поз, ТипПоля);
		КонецЕсли;
	КонецЦикла;
	Возврат Колонка;
КонецФункции
Функция ПрочитатьКусокКолонки_simple_parquet_reader(Буф, Поз)
	Колонка = Неопределено;
	ПоследнийНомер = 0;
	Пока Истина Цикл
		ТипПоля = 0;
		Номер = СледующееПоле_simple_parquet_reader(Буф, Поз, ПоследнийНомер, ТипПоля);
		Если Номер = 0 Тогда
			Прервать;
		КонецЕсли;
		Если Номер = 3 Тогда
			Колонка = ПрочитатьМетаКолонки_simple_parquet_reader(Буф, Поз);
		Иначе
			ПропуститьЗначение_simple_parquet_reader(Буф, Поз, ТипПоля);
		КонецЕсли;
	КонецЦикла;
	Возврат Колонка;
КонецФункции
Функция ПрочитатьГруппуСтрок_simple_parquet_reader(Буф, Поз, Колонки)
	Строк = 0;
	ПоследнийНомер = 0;
	Пока Истина Цикл
		ТипПоля = 0;
		Номер = СледующееПоле_simple_parquet_reader(Буф, Поз, ПоследнийНомер, ТипПоля);
		Если Номер = 0 Тогда
			Прервать;
		КонецЕсли;
		Если Номер = 1 Тогда
			ТипЭлемента = 0;
			Кусков = ПрочитатьЗаголовокСписка_simple_parquet_reader(Буф, Поз, ТипЭлемента);
			Для Н = 1 По Кусков Цикл
				Колонки.Добавить(ПрочитатьКусокКолонки_simple_parquet_reader(Буф, Поз));
			КонецЦикла;
		ИначеЕсли Номер = 3 Тогда
			Строк = ПрочитатьЗигЗаг_simple_parquet_reader(Буф, Поз);
		Иначе
			ПропуститьЗначение_simple_parquet_reader(Буф, Поз, ТипПоля);
		КонецЕсли;
	КонецЦикла;
	Возврат Строк;
КонецФункции
Функция ПрочитатьМетаданные_simple_parquet_reader(Буф, Поз, Колонки)
	Строк = 0;
	ПоследнийНомер = 0;
	Пока Истина Цикл
		ТипПоля = 0;
		Номер = СледующееПоле_simple_parquet_reader(Буф, Поз, ПоследнийНомер, ТипПоля);
		Если Номер = 0 Тогда
			Прервать;
		КонецЕсли;
		Если Номер = 3 Тогда
			Строк = ПрочитатьЗигЗаг_simple_parquet_reader(Буф, Поз);
		ИначеЕсли Номер = 4 Тогда
			ТипЭлемента = 0;
			Групп = ПрочитатьЗаголовокСписка_simple_parquet_reader(Буф, Поз, ТипЭлемента);
			Если Групп <> 1 Тогда
				ВызватьИсключение "parquet: ожидалась одна группа строк, а их "
					+ Формат(Групп, "ЧГ=0");
			КонецЕсли;
			ПрочитатьГруппуСтрок_simple_parquet_reader(Буф, Поз, Колонки);
		Иначе
			ПропуститьЗначение_simple_parquet_reader(Буф, Поз, ТипПоля);
		КонецЕсли;
	КонецЦикла;
	Возврат Строк;
КонецФункции
Функция ПрочитатьЗаголовокСтраницы_simple_parquet_reader(Буф, Поз)
	Страница = Новый Структура("ТипСтраницы, Сжатый, Значений, Кодирование", -1, 0, 0, -1);
	ПоследнийНомер = 0;
	Пока Истина Цикл
		ТипПоля = 0;
		Номер = СледующееПоле_simple_parquet_reader(Буф, Поз, ПоследнийНомер, ТипПоля);
		Если Номер = 0 Тогда
			Прервать;
		КонецЕсли;
		Если Номер = 1 Тогда
			Страница.ТипСтраницы = ПрочитатьЗигЗаг_simple_parquet_reader(Буф, Поз);
		ИначеЕсли Номер = 3 Тогда
			Страница.Сжатый = ПрочитатьЗигЗаг_simple_parquet_reader(Буф, Поз);
		ИначеЕсли Номер = 5 Тогда
			ВложенныйНомер = 0;
			Пока Истина Цикл
				ТипВложенного = 0;
				Поле = СледующееПоле_simple_parquet_reader(Буф, Поз, ВложенныйНомер, ТипВложенного);
				Если Поле = 0 Тогда
					Прервать;
				КонецЕсли;
				Если Поле = 1 Тогда
					Страница.Значений = ПрочитатьЗигЗаг_simple_parquet_reader(Буф, Поз);
				ИначеЕсли Поле = 2 Тогда
					Страница.Кодирование = ПрочитатьЗигЗаг_simple_parquet_reader(Буф, Поз);
				Иначе
					ПропуститьЗначение_simple_parquet_reader(Буф, Поз, ТипВложенного);
				КонецЕсли;
			КонецЦикла;
		Иначе
			ПропуститьЗначение_simple_parquet_reader(Буф, Поз, ТипПоля);
		КонецЕсли;
	КонецЦикла;
	Возврат Страница;
КонецФункции
Функция ЦелоеСоЗнаком32_simple_parquet_reader(Буф, Поз)
	З = Буф.ПрочитатьЦелое32(Поз);
	Если З >= 2147483648 Тогда
		Возврат З - 4294967296;
	КонецЕсли;
	Возврат З;
КонецФункции
Функция ЦелоеСоЗнаком64_simple_parquet_reader(Буф, Поз)
	З = Буф.ПрочитатьЦелое64(Поз);
	Если З >= 9223372036854775808 Тогда
		Возврат З - 18446744073709551616;
	КонецЕсли;
	Возврат З;
КонецФункции
Функция ДваВСтепени_simple_parquet_reader(Показатель, Кэш)
	Готовое = Кэш.Получить(Показатель);
	Если Готовое <> Неопределено Тогда
		Возврат Готовое;
	КонецЕсли;
	Значение = 1;
	Для Н = 1 По Показатель Цикл
		Значение = Значение * 2;
	КонецЦикла;
	Кэш.Вставить(Показатель, Значение);
	Возврат Значение;
КонецФункции
Функция ЧислоИзДвойной_simple_parquet_reader(Буф, Поз, Кэш)
	Низ = Буф.ПрочитатьЦелое32(Поз);
	Верх = Буф.ПрочитатьЦелое32(Поз + 4);
	Порядок = Цел(Верх / 1048576) % 2048;
	Мантисса = (Верх % 1048576) * 4294967296 + Низ;
	Если Порядок = 0 Тогда
		Если Мантисса = 0 Тогда
			Возврат 0;
		КонецЕсли;
		ВызватьИсключение "parquet: денормализованное число двойной точности";
	КонецЕсли;
	Если Порядок = 2047 Тогда
		ВызватьИсключение "parquet: бесконечность или не-число в колонке";
	КонецЕсли;
	Значение = Мантисса + 4503599627370496;
	Степень = Порядок - 1075;
	Если Степень >= 0 Тогда
		Значение = Значение * ДваВСтепени_simple_parquet_reader(Степень, Кэш);
	Иначе
		Значение = Значение / ДваВСтепени_simple_parquet_reader(-Степень, Кэш);
	КонецЕсли;
	Если Цел(Верх / 2147483648) = 1 Тогда
		Возврат -Значение;
	КонецЕсли;
	Возврат Значение;
КонецФункции
Процедура ПрочитатьКолонку_simple_parquet_reader(Буф, Колонка, Значения, Кэш)
	Если Колонка.Кодек <> 0 Тогда
		ВызватьИсключение "parquet: колонка " + Колонка.ИмяКолонки
			+ " сжата, кодек " + Формат(Колонка.Кодек, "ЧГ=0");
	КонецЕсли;
	Если Колонка.Словарь > 0 Тогда
		ВызватьИсключение "parquet: у колонки " + Колонка.ИмяКолонки + " словарная страница";
	КонецЕсли;

	Поз = Колонка.Смещение;
	Осталось = Колонка.Значений;
	Пока Осталось > 0 Цикл
		Страница = ПрочитатьЗаголовокСтраницы_simple_parquet_reader(Буф, Поз);
		Если Страница.ТипСтраницы <> 0 Тогда
			ВызватьИсключение "parquet: страница типа " + Формат(Страница.ТипСтраницы, "ЧГ=0")
				+ " в колонке " + Колонка.ИмяКолонки;
		КонецЕсли;
		Если Страница.Кодирование <> 0 Тогда
			ВызватьИсключение "parquet: страница колонки " + Колонка.ИмяКолонки
				+ " закодирована способом " + Формат(Страница.Кодирование, "ЧГ=0");
		КонецЕсли;

		НачалоДанных = Поз;
		Число = Страница.Значений;

		Если Колонка.ТипДанных = 6 Тогда
			// BYTE_ARRAY: длина беззнаковым 32-разрядным, дальше UTF-8.
			Для Н = 1 По Число Цикл
				Длина = Буф.ПрочитатьЦелое32(Поз);
				Поз = Поз + 4;
				Если Длина = 0 Тогда
					// Нулевая длина у `ПолучитьСрез` значит «до конца
					// буфера», а не «пусто» (измерено), поэтому пустая
					// строка разбирается отдельной веткой.
					Значения.Добавить("");
				Иначе
					Срез = Буф.ПолучитьСрез(Поз, Длина);
					Значения.Добавить(ПолучитьСтрокуИзБуфераДвоичныхДанных(Срез,
						КодировкаТекста.UTF8));
					Поз = Поз + Длина;
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли Колонка.ТипДанных = 1 Тогда
			Для Н = 1 По Число Цикл
				Значения.Добавить(ЦелоеСоЗнаком32_simple_parquet_reader(Буф, Поз));
				Поз = Поз + 4;
			КонецЦикла;
		ИначеЕсли Колонка.ТипДанных = 2 Тогда
			Для Н = 1 По Число Цикл
				Значения.Добавить(ЦелоеСоЗнаком64_simple_parquet_reader(Буф, Поз));
				Поз = Поз + 8;
			КонецЦикла;
		ИначеЕсли Колонка.ТипДанных = 5 Тогда
			Для Н = 1 По Число Цикл
				Значения.Добавить(ЧислоИзДвойной_simple_parquet_reader(Буф, Поз, Кэш));
				Поз = Поз + 8;
			КонецЦикла;
		Иначе
			ВызватьИсключение "parquet: тип данных " + Формат(Колонка.ТипДанных, "ЧГ=0")
				+ " в колонке " + Колонка.ИмяКолонки + " не поддержан";
		КонецЕсли;

		Поз = НачалоДанных + Страница.Сжатый;
		Осталось = Осталось - Число;
	КонецЦикла;
КонецПроцедуры
Процедура ПрочитатьФайлВТаблицу_simple_parquet_reader(ПутьФайла)
	// Отсутствие файла проверяется попыткой его открыть, а не типом `Файл`:
	// этого типа здесь пока нет, а сообщение читателю нужно внятное. Путь
	// ОТНОСИТЕЛЬНЫЙ — `run.sh` гоняет этот сценарий из корня дерева.
	Поток = Неопределено;
	Попытка
		Поток = ФайловыеПотоки.ОткрытьДляЧтения(ПутьФайла);
	Исключение
		Сообщить("не открылся " + ПутьФайла + " — сценарий гоняется из корня дерева");
		Возврат;
	КонецПопытки;

	Т = ТекущаяУниверсальнаяДатаВМиллисекундах();

	РазмерФайла = Поток.Размер();
	Буфер = Новый БуферДвоичныхДанных(РазмерФайла);
	Поток.Прочитать(Буфер, 0, РазмерФайла);
	Поток.Закрыть();

	// Подпись стоит и в начале, и в конце; перед хвостовой лежит длина
	// метаданных беззнаковым 32-разрядным.
	Если Буфер[0] <> 80 Или Буфер[1] <> 65 Или Буфер[2] <> 82 Или Буфер[3] <> 49 Тогда
		ВызватьИсключение "parquet: нет подписи PAR1 в начале файла";
	КонецЕсли;
	ДлинаМетаданных = Буфер.ПрочитатьЦелое32(РазмерФайла - 8);
	НачалоМетаданных = РазмерФайла - 8 - ДлинаМетаданных;

	Колонки = Новый Массив;
	Позиция = НачалоМетаданных;
	ЧислоСтрок = ПрочитатьМетаданные_simple_parquet_reader(Буфер, Позиция, Колонки);

	КэшСтепеней = Новый Соответствие;
	ЗначенияКолонок = Новый Массив;
	Для Каждого Колонка Из Колонки Цикл
		Значения = Новый Массив;
		ПрочитатьКолонку_simple_parquet_reader(Буфер, Колонка, Значения, КэшСтепеней);
		ЗначенияКолонок.Добавить(Значения);
	КонецЦикла;

	// Колонки parquet лежат подряд, а таблица значений построчная — перекладка
	// столбцов в строки входит в замер, ради неё сценарий и написан.
	Таблица = Новый ТаблицаЗначений;
	Для Каждого Колонка Из Колонки Цикл
		Таблица.Колонки.Добавить(Колонка.ИмяКолонки);
	КонецЦикла;

	Для Н = 1 По ЧислоСтрок Цикл
		Таблица.Добавить();
	КонецЦикла;
	// `ЗагрузитьКолонку` — та самая операция «столбец целиком», которой
	// колоночный файл ложится в построчную таблицу; поимённо перебирать
	// ячейки было бы и медленнее, и без нужды.
	Для К = 0 По Колонки.Количество() - 1 Цикл
		Таблица.ЗагрузитьКолонку(ЗначенияКолонок[К], Колонки[К].ИмяКолонки);
	КонецЦикла;

	Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

	СуммаКоличества = Таблица.Итог("quantity");
	СуммаЦены = Таблица.Итог("price");
	СуммаСуммы = Таблица.Итог("summ");
	Первая = Таблица[0];
	Последняя = Таблица[Таблица.Количество() - 1];

	Сообщить("строк: " + Формат(Таблица.Количество(), "ЧГ=0")
		+ ", колонок: " + Формат(Таблица.Колонки.Количество(), "ЧГ=0")
		+ ", первая: " + Первая.Item + ", последняя: " + Последняя.Item);
	Сообщить("суммы: quantity " + Формат(СуммаКоличества, "ЧГ=0")
		+ ", price " + Формат(СуммаЦены, "ЧГ=0")
		+ ", summ " + Формат(СуммаСуммы, "ЧН=0; ЧГ=0; ЧДЦ=0"));
	Сообщить(Формат(Прошло, "ЧГ=0"));
КонецПроцедуры

Процедура Сценарий_simple_parquet_reader()
// Чтение parquet в `ТаблицаЗначений` средствами двоичных данных.
//
// Что именно меряется: разбор файла на 100 000 строк и четыре колонки —
// подвал с метаданными в компактном протоколе Thrift, цепочки страниц
// данных по каждой колонке и раскодирование значений PLAIN — плюс сборка
// из них таблицы значений. Весь файл читается в один
// `БуферДвоичныхДанных`, дальше работают только `ПрочитатьЦелое32/64`,
// индексация и `ПолучитьСрез`; ничего кроме двоичной подсистемы здесь не
// участвует.
//
// Входной файл лежит в репозитории — `benchmarks/data/simple.parquet`,
// пять мегабайт. Породил его `benchmarks/make-parquet.py` (pandas +
// pyarrow, зерно фиксировано), и перезапускать генератор ради прогона не
// нужно: он рядом затем, чтобы файл был воспроизводим, а не был двоичным
// подарком без исходника.
//
// КАКОЕ ПОДМНОЖЕСТВО ФОРМАТА РАЗБИРАЕТСЯ. Ровно то, которым пишет
// `make-parquet.py`: одна группа строк, колонки обязательные (уровней
// определённости в страницах нет), кодирование PLAIN, сжатия нет,
// страницы данных версии 1. Всё остальное — словарные страницы, SNAPPY,
// уровни, INT96 — читатель встречает проверкой и внятным исключением, а
// не молчаливой чепухой: распаковка и RLE это отдельные подсистемы,
// которых в дереве пока нет. Цепочку страниц он при этом проходит
// честно — pyarrow режет колонку по мегабайту, и в этом файле у каждой
// колонки пять страниц, а не одна.
//
// ПРО ЧИСЛА ДВОЙНОЙ ТОЧНОСТИ. `ПрочитатьЦелое64` отдаёт биты, а число из
// них собирается вручную: знак, порядок, мантисса, значение равно
// `М * 2^(Порядок - 1075)`. Отрицательная степень берётся ДЕЛЕНИЕМ на
// `2^n`, а не умножением на `2^-n`: у платформы число ограничено 38
// разрядами, и `2^-40` в него не помещается вовсе, тогда как деление
// мантиссы (16 разрядов) на `2^40` (13 разрядов) точно и там, и здесь.
// Для чисел этого файла — все они целые — результат точен; общий читатель
// потребовал бы разговора про то, чем именно округлять.
//
// Контрольные величины — число строк, первая и последняя номенклатура и
// три суммы. Они снимаются с файла независимо (`pyarrow`), так что
// сходятся не сами с собой: 5 513 870, 5 496 709 и 303 098 539.
//
// Двойники у сценария разные по замыслу: на Lua — тот же разбор вручную,
// сравнимый с этим напрямую, на Python — `pandas.read_parquet`, то есть
// готовая библиотека на C++. Второй меряет не язык, а цену ручного
// разбора против библиотечного; оговорки стоят в шапках самих двойников.
//
// КОЛОНКА 1С СНИМАЕТСЯ С АБСОЛЮТНЫМ ПУТЁМ: у платформы свой текущий
// каталог, поэтому одиночный прогон идёт по копии с подменённой строкой —
// ровно та же подмена, что делает `build-combined.py` для свода:
//
//     sed "s|\"/home/kan/Документы/develop/open-bsl/benchmarks/data/|\"$PWD/benchmarks/data/|" \
//         benchmarks/simple_parquet_reader.bsl > /tmp/pq.bsl
//     ONEC_TIMEOUT=900 ./tests/conformance/measure/1c/run-on-1c.sh /tmp/pq.bsl
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

// --- компактный протокол Thrift ------------------------------------------
// Позиция везде передаётся ПО ССЫЛКЕ (без `Знач`) и двигается самой
// функцией: это дешевле структуры-курсора и читается как обычный поток.

// Целое переменной длины: по семь бит на байт, младшие вперёд, старший
// бит — признак продолжения.

// Знаковое целое: младший бит — знак, остальное сдвинуто влево.

// Строка или байты: длина варинтом, дальше содержимое.

// Заголовок списка: количество и тип элемента. Пятнадцать в тетраде
// означает «длина следующим варинтом».

// Пропуск значения неинтересного поля. Рекурсия здесь настоящая:
// структуры вложены, а пропускать надо любую.

// Заголовок поля структуры: тетрада приращения номера и тетрада типа.
// Нулевой байт — конец структуры, и тогда возвращается 0.


// --- метаданные файла -----------------------------------------------------

// `ColumnMetaData`: из четырнадцати полей нужны пять. Номера полей — из
// `parquet.thrift`: 1 тип, 3 путь в схеме, 4 кодек, 5 число значений,
// 9 смещение первой страницы данных, 11 смещение словарной страницы.

// `ColumnChunk`: нужна только вложенная `meta_data` (поле 3).

// `RowGroup`: список кусков (поле 1) и число строк (поле 3).

// `FileMetaData`: число строк (поле 3) и группы строк (поле 4).

// --- страницы данных ------------------------------------------------------

// `PageHeader`: тип (1), сжатый размер (3) и вложенный `DataPageHeader`
// (5), из которого нужны число значений и кодирование.

// --- значения PLAIN -------------------------------------------------------

// Знаковое 32-разрядное: буфер отдаёт беззнаковое, старший бит означает
// вычитание 2^32.


// Степень двойки с кэшом: в файле их считанные единицы, а считать их
// умножением на каждое значение — впустую.

// IEEE 754 двойной точности из восьми байтов: знак, одиннадцать бит
// порядка, пятьдесят два бита мантиссы.

// Одна колонка целиком: цепочка страниц, значения подряд, по типу —
// свой цикл. Ветвление вынесено ИЗ цикла: на сто тысяч значений разница
// между «проверить тип один раз» и «проверить его сто тысяч раз»
// заметна.

// --- сам замер ------------------------------------------------------------
// Весь замер — в процедуре, а не в теле модуля: `Возврат` из тела
// OneScript не берёт («может использоваться только внутри метода»), а
// ранний выход при отсутствующем файле нужен. По той же причине первый
// оператор модуля стоит после всех объявлений — иначе и платформа, и
// OneScript отвергают файл целиком на разборе.


// Путь относительный, от корня дерева: так его видят и `run.sh`, и
// двойники. Платформе он не годится — её текущий каталог свой, — поэтому
// `build-combined.py` подменяет эту строку абсолютным путём ровно так же,
// как подменяет "/tmp/onec-bench-scratch/csv_write.1c.out" у сценариев с файловым выводом.
ПрочитатьФайлВТаблицу_simple_parquet_reader("/home/kan/Документы/develop/open-bsl/benchmarks/data/simple.parquet");
КонецПроцедуры

Процедура Сценарий_str_concat()
// Сборка строки конкатенацией в цикле — самый частый способ строить текст
// в прикладном коде BSL. Раньше здесь измерялась квадратичная работа:
// строка неизменяема, и каждый шаг копировал всё накопленное. Теперь VM
// дописывает на месте, когда на буфер никто больше не смотрит, и у нас
// работа линейная — а у двойников на других языках осталась квадратичной.
// Именно поэтому сборка повторяется 10 раз с нуля: иначе наше число
// падает ниже разрешения таймера и мерить становится нечего.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.
// `ЧН=0` обязателен: без него `Формат(0, "ЧГ=0")` даёт ПУСТУЮ строку —
// так на платформе, и быстрый сценарий печатал бы пустоту вместо нуля.

Кусок = "абвгдеёжзийклмнопрстуфхцчшщъыьэюя0123456789";

Т = ТекущаяУниверсальнаяДатаВМиллисекундах();
Текст = "";
Для повтор = 1 По 10 Цикл
	Текст = "";
	Для н = 1 По 3000 Цикл
		Текст = Текст + Кусок;
	КонецЦикла;
КонецЦикла;
Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

Сообщить("длина: " + Строка(СтрДлина(Текст)));
Сообщить(Формат(Прошло, "ЧГ=0; ЧН=0"));
КонецПроцедуры

Процедура Сценарий_str_find()
// Поиск подстроки: стог собирается один раз, иголка лежит РОВНО В КОНЦЕ,
// поэтому каждый поиск обязан просканировать всю строку. Меряется
// `BslString::find` — сейчас это наивный цикл со сравнением срезов.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

Кусок = "абвгдеёжзийклмнопрстуфхцчшщъыьэюя0123456789";
Стог = "";
Для н = 1 По 5000 Цикл
	Стог = Стог + Кусок;
КонецЦикла;
Стог = Стог + "ИГОЛКА";

Т = ТекущаяУниверсальнаяДатаВМиллисекундах();
Позиция = 0;
Для н = 1 По 500 Цикл
	Позиция = СтрНайти(Стог, "ИГОЛКА");
КонецЦикла;
Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

Сообщить("длина стога: " + Строка(СтрДлина(Стог)) + ", позиция: " + Строка(Позиция));
Сообщить(Формат(Прошло, "ЧГ=0"));
КонецПроцедуры

Процедура Сценарий_str_index()
// Посимвольный проход по строке через `Сред(s, i, 1)` — самый частый способ
// перебрать символы в прикладном коде BSL. Здесь измеряется именно
// ИНДЕКСАЦИЯ: длина строки берётся один раз, и каждый шаг достаёт один
// символ по позиции. Строка — кириллица, потому что в ней каждый символ
// занимает один код-юнит UTF-16 (как и в самой 1С), и именно на ней
// случайный доступ по позиции виднее всего: на UTF-8 байтовый индекс не
// совпал бы с символьным, и `Сред` ушёл бы в линейный поиск границы.
//
// Стог собирается ВНЕ замера: здесь меряется индексация, а не конкатенация
// (для неё есть отдельный `str_concat`).
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

Алфавит = "абвгдеёжзийклмнопрстуфхцчшщъыьэюя";
Стог = "";
Для н = 1 По 10000 Цикл
	Стог = Стог + Алфавит;
КонецЦикла;
Длина = СтрДлина(Стог);

Т = ТекущаяУниверсальнаяДатаВМиллисекундах();
Сумма = 0;
Для н = 1 По Длина Цикл
	Сумма = Сумма + КодСимвола(Сред(Стог, н, 1));
КонецЦикла;
Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

Сообщить("длина: " + Строка(Длина) + ", контрольная сумма: " + Строка(Сумма));
Сообщить(Формат(Прошло, "ЧГ=0"));
КонецПроцедуры

Процедура Сценарий_table_compare()
// ТаблицаЗначений: сравнение двух таблиц через объединение, знак и свёртку.
//
// Сценарий воспроизводит прикладной алгоритм сравнения: таблицы объединяются,
// `Свернуть` группирует строки по всем исходным колонкам, а отбор по
// `Счет = 1` оставляет значения, встречающиеся ровно один раз.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

// Настройки теста.
// На этих тестовых данных в 1C порядок величин был около 10 секунд на
// генерацию и 65 секунд на сравнение.
КоличествоКолонок = 18;
КоличествоИзмерений = 4;
КоличествоСтрок = 50000;

// Генерация тестовых данных.
НВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();

ИзмеренияМассив = Новый Массив;
Колонки = Новый Массив;
Таблица0 = Новый ТаблицаЗначений;
Для Сч = 1 По КоличествоКолонок Цикл
	ИмяКолонки = СтрШаблон("Колонка_%1", Формат(Сч, "ЧГ=0;ЧН=0"));
	Колонки.Добавить(ИмяКолонки);
	Если Сч <= КоличествоИзмерений Тогда
		ИзмеренияМассив.Добавить(ИмяКолонки);
	КонецЕсли;
	Таблица0.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("Строка"));
КонецЦикла;

Таблица1 = Таблица0.СкопироватьКолонки();
Измерения = СтрСоединить(ИзмеренияМассив, ",");

Для Сч = 1 По КоличествоСтрок Цикл
	Для Каждого ИмяКолонки Из Колонки Цикл
		Ключ = Формат(Сч, "ЧГ=0;ЧН=0") + "_" + ИмяКолонки;
		Источник0 = Новый Структура;
		Источник0.Вставить(ИмяКолонки, "A_" + Ключ);
		ЗаполнитьЗначенияСвойств(Таблица0.Добавить(), Источник0);

		Источник1 = Новый Структура;
		Источник1.Вставить(ИмяКолонки, "B_" + Ключ);
		ЗаполнитьЗначенияСвойств(Таблица1.Добавить(), Источник1);
	КонецЦикла;
КонецЦикла;

ВремяГенерации = ТекущаяУниверсальнаяДатаВМиллисекундах() - НВремя;
Сообщить(СтрШаблон(
	"генерация: %1 мс, строк в каждой таблице: %2",
	Формат(ВремяГенерации, "ЧГ=0;ЧН=0"),
	Формат(Таблица0.Количество(), "ЧГ=0;ЧН=0")
));

// Сравнение.
НВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();

ВсеКолонки = "";
Для Каждого Колонка Из Таблица1.Колонки Цикл
	ВсеКолонки = ВсеКолонки + ", " + Колонка.Имя;
КонецЦикла;
ВсеКолонки = Сред(ВсеКолонки, 2);

Таблица = Таблица1.Скопировать();
Таблица.Колонки.Добавить("Знак", Новый ОписаниеТипов("Число"));
Таблица.ЗаполнитьЗначения(1, "Знак");

Для Каждого Строка Из Таблица0 Цикл
	ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Строка);
КонецЦикла;

Таблица.Колонки.Добавить("Счет");
Таблица.ЗаполнитьЗначения(1, "Счет");

Таблица.Свернуть(ВсеКолонки, "Знак, Счет");

Ответ = Таблица.Скопировать(Новый Структура("Счет", 1), ВсеКолонки + ", Знак");

Если ЗначениеЗаполнено(Измерения) Тогда
	// У OneScript нет типа СравнениеЗначений, а падать сценарий не должен:
	// зонд через Вычислить в Попытке — тот же приём, что в measure-*.bsl.
	// Платформа и open-bsl идут прежним путём, с компаратором; oscript
	// сортирует без него — на печатаемый результат (число строк) порядок
	// сортировки не влияет.
	Компаратор = Неопределено;
	Попытка
		Компаратор = Вычислить("Новый СравнениеЗначений");
	Исключение
	КонецПопытки;
	Если Компаратор = Неопределено Тогда
		Ответ.Сортировать(Измерения);
	Иначе
		Ответ.Сортировать(Измерения, Компаратор);
	КонецЕсли;
КонецЕсли;

ВремяАлгоритма = ТекущаяУниверсальнаяДатаВМиллисекундах() - НВремя;
Сообщить(СтрШаблон(
	"сравнение: %1 мс, строк результата: %2",
	Формат(ВремяАлгоритма, "ЧГ=0;ЧН=0"),
	Формат(Ответ.Количество(), "ЧГ=0;ЧН=0")
));
Сообщить(Формат(ВремяАлгоритма, "ЧГ=0;ЧН=0"));
КонецПроцедуры

Функция РазницаТаблицЗначений_table_compare2(Таблица0, Таблица1, Измерения) Экспорт

	ВсеКолонки = "";
	Для Каждого Колонка Из Таблица1.Колонки Цикл
		ВсеКолонки = ВсеКолонки + ", " + Колонка.Имя
	КонецЦикла;
	ВсеКолонки = Сред(ВсеКолонки, 2);

	Таблица = Таблица1.Скопировать();

	Таблица.Колонки.Добавить("Знак", Новый ОписаниеТипов("Число"));

	Таблица.ЗаполнитьЗначения(1, "Знак");

	Для Каждого Строка Из Таблица0 Цикл
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Строка)
	КонецЦикла;

	Таблица.Колонки.Добавить("Счет");
	Таблица.ЗаполнитьЗначения(1, "Счет");

	Таблица.Свернуть(ВсеКолонки, "Знак, Счет");

	Ответ = Таблица.Скопировать(Новый Структура("Счет", 1), ВсеКолонки + ", Знак");

	Если ЗначениеЗаполнено(Измерения) Тогда
		Ответ.Сортировать(Измерения, Новый СравнениеЗначений);
	КонецЕсли;

	Возврат Ответ;

КонецФункции
Функция Псевдо_table_compare2(Состояние)
	Возврат (Состояние * 1103515245 + 12345) % 2147483648;
КонецФункции
Процедура ДобавитьСтроку_table_compare2(Таблица, НомерКлюча, Соль)
	Стр = Таблица.Добавить();
	// В исходнике ключ — уникальная ссылка документа (~80 символов её
	// текстового вида); здесь строка той же уникальности.
	Стр.Док = "документ-обезличенный-ключ-профиля-выгрузки-" + Формат(1000000000 + НомерКлюча, "ЧГ=0");
	Стр.Склад = "строковое-значение-а-" + Формат(Соль % 2400, "ЧГ=0");
	Стр.Номенклатура = "значение-б-" + Формат(Соль % 800, "ЧГ=0");
	Стр.Количество = Соль % 51;
	Стр.КоличествоКомплектующих = (Соль % 4800) + 0.5;
КонецПроцедуры

Процедура Сценарий_table_compare2()
// Сравнение двух таблиц значений «Свернуть со знаками» на данных с
// профилем РЕАЛЬНОЙ выгрузки (обезличено: сохранены масштабы, типы,
// кардинальности колонок и пересечение ключей; сами значения целиком
// синтетические, генератор детерминированный).
//
// Профиль исходника: Таблица1 — 564 564 строк, Таблица0 — 483 939 строк,
// 5 колонок; ключевая колонка уникальна в каждой строке (в исходнике —
// ссылка документа, здесь строка той же уникальности и близкой длины),
// две строковые колонки с ~2 400 и ~800 уникальными значениями, две
// числовые с ~51 и ~4 800; 483 874 строк совпадают целиком, 65 живут
// только в Таблице0, 80 690 — только в Таблице1. Ожидаемый результат —
// 80 755 строк разницы, как у исходной выгрузки.
//
// Числа строк можно уменьшить переменной МасштабПрофиля ниже (1 = полный профиль);
// пропорции при этом сохраняются.
//
// OneScript 2.1 этот сценарий НЕ проходит: у него нет конструктора
// `Новый СравнениеЗначений` (падает на сортировке результата) — его
// колонка в run.sh честно показывает ошибку.


// Детерминированная псевдослучайность: обычный LCG, одинаковый на всех
// рантаймах. Возвращает 0..2^31-1.


МасштабПрофиля = 1;
ОбщихСтрок    = Цел(483874 / МасштабПрофиля);
ТолькоНулевой = Цел(65);
ТолькоПервой  = Цел(80690 / МасштабПрофиля);

НВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();

Таблица0 = Новый ТаблицаЗначений;
Таблица0.Колонки.Добавить("Док", Новый ОписаниеТипов("Строка"));
Таблица0.Колонки.Добавить("Склад", Новый ОписаниеТипов("Строка"));
Таблица0.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("Строка"));
Таблица0.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
Таблица0.Колонки.Добавить("КоличествоКомплектующих", Новый ОписаниеТипов("Число"));
Таблица1 = Таблица0.СкопироватьКолонки();

Состояние = 20260805;
Ключ = 0;
Для Сч = 1 По ОбщихСтрок Цикл
	Состояние = Псевдо_table_compare2(Состояние);
	Ключ = Ключ + 1;
	ДобавитьСтроку_table_compare2(Таблица0, Ключ, Состояние);
	ДобавитьСтроку_table_compare2(Таблица1, Ключ, Состояние);
КонецЦикла;
Для Сч = 1 По ТолькоНулевой Цикл
	Состояние = Псевдо_table_compare2(Состояние);
	Ключ = Ключ + 1;
	ДобавитьСтроку_table_compare2(Таблица0, Ключ, Состояние);
КонецЦикла;
Для Сч = 1 По ТолькоПервой Цикл
	Состояние = Псевдо_table_compare2(Состояние);
	Ключ = Ключ + 1;
	ДобавитьСтроку_table_compare2(Таблица1, Ключ, Состояние);
КонецЦикла;

Сообщить("генерация: " + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах() - НВремя, "ЧГ=0") + " мс ("
	+ Формат(Таблица0.Количество(), "ЧГ=0") + " + " + Формат(Таблица1.Количество(), "ЧГ=0") + " строк)");

НВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();
Ответ = РазницаТаблицЗначений_table_compare2(Таблица0, Таблица1, "Док");
ВремяСравнения = ТекущаяУниверсальнаяДатаВМиллисекундах() - НВремя;
Сообщить("сравнение: " + Формат(ВремяСравнения, "ЧГ=0") + " мс");

// Контроль правильности — детерминированные агрегаты результата.
СуммаЗнаков = 0;
Для Каждого Стр Из Ответ Цикл
	СуммаЗнаков = СуммаЗнаков + Стр.Знак;
КонецЦикла;
Сообщить("итог: строк " + Формат(Ответ.Количество(), "ЧГ=0") + ", сумма знаков " + Формат(СуммаЗнаков, "ЧГ=0"));

// Контракт run.sh: последняя строка — миллисекунды голым числом. Меряется
// само сравнение, как в table_compare; генерация — подготовка.
Сообщить(Формат(ВремяСравнения, "ЧГ=0;ЧН=0"));
КонецПроцедуры

Функция Псевдо_table_save_load(Состояние)
	Возврат (Состояние * 1103515245 + 12345) % 2147483648;
КонецФункции
Процедура ДобавитьСтроку_table_save_load(Таблица, НомерКлюча, Соль)
	Стр = Таблица.Добавить();
	Стр.Док = "документ-обезличенный-ключ-профиля-выгрузки-" + Формат(1000000000 + НомерКлюча, "ЧГ=0");
	Стр.Склад = "строковое-значение-а-" + Формат(Соль % 2400, "ЧГ=0");
	Стр.Номенклатура = "значение-б-" + Формат(Соль % 800, "ЧГ=0");
	Стр.Количество = Соль % 51;
	Стр.КоличествоКомплектующих = (Соль % 4800) + 0.5;
КонецПроцедуры

Процедура Сценарий_table_save_load()
// Сохранение и загрузка таблицы значений через внутренний формат
// (`ЗначениеВФайл` / `ЗначениеИзФайла`) на масштабе реальной выгрузки —
// та же обезличенная генерация, что у `table_compare2.bsl`: 564 564 строк,
// пять колонок, уникальный на строку ключ, измеренные кардинальности.
//
// Три фазы с таймингами: сохранение в файл, загрузка из файла, проверка
// тождественности (повторная сериализация загруженной таблицы обязана
// совпасть со строкой исходной). Файл ~130 МБ пишется в /tmp под
// фиксированным именем и просто перезаписывается следующим прогоном.

// Детерминированная псевдослучайность — та же, что в table_compare2.bsl.


МасштабПрофиля = 1;
ЧислоСтрок = Цел(564564 / МасштабПрофиля);

НВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();
Таблица = Новый ТаблицаЗначений;
Таблица.Колонки.Добавить("Док", Новый ОписаниеТипов("Строка"));
Таблица.Колонки.Добавить("Склад", Новый ОписаниеТипов("Строка"));
Таблица.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("Строка"));
Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
Таблица.Колонки.Добавить("КоличествоКомплектующих", Новый ОписаниеТипов("Число"));

Состояние = 20260805;
Для Сч = 1 По ЧислоСтрок Цикл
	Состояние = Псевдо_table_save_load(Состояние);
	ДобавитьСтроку_table_save_load(Таблица, Сч, Состояние);
КонецЦикла;
Сообщить("генерация: " + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах() - НВремя, "ЧГ=0") + " мс ("
	+ Формат(Таблица.Количество(), "ЧГ=0") + " строк)");

Путь = "/tmp/open-bsl-bench-vt-save.txt";

НВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();
ЗначениеВФайл(Путь, Таблица);
ВремяСохранения = ТекущаяУниверсальнаяДатаВМиллисекундах() - НВремя;
Сообщить("сохранение: " + Формат(ВремяСохранения, "ЧГ=0") + " мс");

НВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();
Загруженная = ЗначениеИзФайла(Путь);
ВремяЗагрузки = ТекущаяУниверсальнаяДатаВМиллисекундах() - НВремя;
Сообщить("загрузка: " + Формат(ВремяЗагрузки, "ЧГ=0") + " мс");

НВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();
Если ЗначениеВСтрокуВнутр(Загруженная) = ЗначениеВСтрокуВнутр(Таблица) Тогда
	Вердикт = "тождественно";
Иначе
	Вердикт = "РАЗОШЛОСЬ";
КонецЕсли;
Сообщить("проверка: " + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах() - НВремя, "ЧГ=0") + " мс, "
	+ Вердикт + ", строк " + Формат(Загруженная.Количество(), "ЧГ=0")
	+ ", колонок " + Формат(Загруженная.Колонки.Количество(), "ЧГ=0"));

// Контракт run.sh: последняя строка — миллисекунды голым числом. Предмет
// замера — сохранение и загрузка; генерация — подготовка, проверка
// тождественности — гейт корректности, как побайтовое сличение у csv_write.
Сообщить(Формат(ВремяСохранения + ВремяЗагрузки, "ЧГ=0;ЧН=0"));
КонецПроцедуры

Процедура Сценарий_table_sort()
// ТаблицаЗначений: сортировка по колонке и линейный поиск.
//
// Сортировка задевает сразу три вещи: сравнение значений
// (`compare_for_sort`), коллацию строк (`collate` — приближение, см.
// TABLE.SORT.COLLATION) и перестановку ВСЕХ колонок с пересборкой карты
// row_id. Поиск — линейный скан колонки с равенством по `BslValue`.
//
// Сортировки чередуются по направлению нарочно: сортировать уже
// отсортированное — лучший случай устойчивой сортировки, и мерялась бы не
// работа, а её отсутствие.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

СТРОК = 100000;

// Псевдослучайный ключ без ГСЧ: линейный конгруэнтный шаг, чтобы порядок
// был перемешан одинаково во всех рантаймах. Оператора остатка в BSL нет —
// берём его через Цел (усечение к нулю, семя всегда положительное).
ТЗ = Новый ТаблицаЗначений;
ТЗ.Колонки.Добавить("ключ");
ТЗ.Колонки.Добавить("имя");
Семя = 1;
МОДУЛЬ = 2147483648;
Для н = 1 По СТРОК Цикл
	Семя = Семя * 1103515245 + 12345;
	Семя = Семя - Цел(Семя / МОДУЛЬ) * МОДУЛЬ;
	С = ТЗ.Добавить();
	С.ключ = Семя;
	С.имя = "имя" + Строка(н);
КонецЦикла;

Т = ТекущаяУниверсальнаяДатаВМиллисекундах();

ТЗ.Сортировать("ключ");
ТЗ.Сортировать("ключ Убыв");
ТЗ.Сортировать("имя");

Найдена = ТЗ.Найти("имя" + Строка(СТРОК), "имя");
Есть = Найдена <> Неопределено;

Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

Сообщить("строк: " + Строка(ТЗ.Количество()) + ", нашлась: " + Строка(Есть));
Сообщить(Формат(Прошло, "ЧГ=0"));
КонецПроцедуры

Процедура Сценарий_table_total()
// ТаблицаЗначений: заполнение и агрегат по колонке.
//
// Меряется то самое место, ради которого хранение сделано колоночным:
// `Итог` идёт по одной `Vec<BslValue>`, но каждая ячейка — 24-байтное
// тегированное значение, и на каждой делается `match`. Если когда-нибудь
// появится типизированное представление колонки, разница будет видна
// именно здесь.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

СТРОК = 200000;
ПРОГОНОВ = 50;

Т = ТекущаяУниверсальнаяДатаВМиллисекундах();

ТЗ = Новый ТаблицаЗначений;
ТЗ.Колонки.Добавить("ном");
ТЗ.Колонки.Добавить("имя");
Для н = 1 По СТРОК Цикл
	С = ТЗ.Добавить();
	С.ном = н;
	С.имя = "строка";
КонецЦикла;

Сумма = 0;
Для п = 1 По ПРОГОНОВ Цикл
	Сумма = ТЗ.Итог("ном");
КонецЦикла;

Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

Сообщить("строк: " + Строка(ТЗ.Количество()) + ", итог: " + Формат(Сумма, "ЧГ=0"));
Сообщить(Формат(Прошло, "ЧГ=0"));
КонецПроцедуры

