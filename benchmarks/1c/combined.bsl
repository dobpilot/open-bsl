Процедура Сценарий_str_concat()
// Сборка строки конкатенацией в цикле — самый частый способ строить текст
// в прикладном коде BSL. Раньше здесь измерялась квадратичная работа:
// строка неизменяема, и каждый шаг копировал всё накопленное. Теперь VM
// дописывает на месте, когда на буфер никто больше не смотрит, и у нас
// работа линейная — а у двойников на других языках осталась квадратичной.
// Именно поэтому сборка повторяется 10 раз с нуля: иначе наше число
// падает ниже разрешения таймера и мерить становится нечего.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.
// `ЧН=0` обязателен: без него `Формат(0, "ЧГ=0")` даёт ПУСТУЮ строку —
// так на платформе, и быстрый сценарий печатал бы пустоту вместо нуля.

Кусок = "абвгдеёжзийклмнопрстуфхцчшщъыьэюя0123456789";

Т = ТекущаяУниверсальнаяДатаВМиллисекундах();
Текст = "";
Для повтор = 1 По 10 Цикл
	Текст = "";
	Для н = 1 По 3000 Цикл
		Текст = Текст + Кусок;
	КонецЦикла;
КонецЦикла;
Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

Сообщить("длина: " + Строка(СтрДлина(Текст)));
Сообщить(Формат(Прошло, "ЧГ=0; ЧН=0"));
КонецПроцедуры

Процедура Сценарий_str_find()
// Поиск подстроки: стог собирается один раз, иголка лежит РОВНО В КОНЦЕ,
// поэтому каждый поиск обязан просканировать всю строку. Меряется
// `BslString::find` — сейчас это наивный цикл со сравнением срезов.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

Кусок = "абвгдеёжзийклмнопрстуфхцчшщъыьэюя0123456789";
Стог = "";
Для н = 1 По 5000 Цикл
	Стог = Стог + Кусок;
КонецЦикла;
Стог = Стог + "ИГОЛКА";

Т = ТекущаяУниверсальнаяДатаВМиллисекундах();
Позиция = 0;
Для н = 1 По 500 Цикл
	Позиция = СтрНайти(Стог, "ИГОЛКА");
КонецЦикла;
Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

Сообщить("длина стога: " + Строка(СтрДлина(Стог)) + ", позиция: " + Строка(Позиция));
Сообщить(Формат(Прошло, "ЧГ=0"));
КонецПроцедуры

Процедура Сценарий_table_sort()
// ТаблицаЗначений: сортировка по колонке и линейный поиск.
//
// Сортировка задевает сразу три вещи: сравнение значений
// (`compare_for_sort`), коллацию строк (`collate` — приближение, см.
// TABLE.SORT.COLLATION) и перестановку ВСЕХ колонок с пересборкой карты
// row_id. Поиск — линейный скан колонки с равенством по `BslValue`.
//
// Сортировки чередуются по направлению нарочно: сортировать уже
// отсортированное — лучший случай устойчивой сортировки, и мерялась бы не
// работа, а её отсутствие.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

СТРОК = 100000;

// Псевдослучайный ключ без ГСЧ: линейный конгруэнтный шаг, чтобы порядок
// был перемешан одинаково во всех рантаймах. Оператора остатка в BSL нет —
// берём его через Цел (усечение к нулю, семя всегда положительное).
ТЗ = Новый ТаблицаЗначений;
ТЗ.Колонки.Добавить("ключ");
ТЗ.Колонки.Добавить("имя");
Семя = 1;
МОДУЛЬ = 2147483648;
Для н = 1 По СТРОК Цикл
	Семя = Семя * 1103515245 + 12345;
	Семя = Семя - Цел(Семя / МОДУЛЬ) * МОДУЛЬ;
	С = ТЗ.Добавить();
	С.ключ = Семя;
	С.имя = "имя" + Строка(н);
КонецЦикла;

Т = ТекущаяУниверсальнаяДатаВМиллисекундах();

ТЗ.Сортировать("ключ");
ТЗ.Сортировать("ключ Убыв");
ТЗ.Сортировать("имя");

Найдена = ТЗ.Найти("имя" + Строка(СТРОК), "имя");
Есть = Найдена <> Неопределено;

Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

Сообщить("строк: " + Строка(ТЗ.Количество()) + ", нашлась: " + Строка(Есть));
Сообщить(Формат(Прошло, "ЧГ=0"));
КонецПроцедуры

Процедура Сценарий_table_total()
// ТаблицаЗначений: заполнение и агрегат по колонке.
//
// Меряется то самое место, ради которого хранение сделано колоночным:
// `Итог` идёт по одной `Vec<BslValue>`, но каждая ячейка — 24-байтное
// тегированное значение, и на каждой делается `match`. Если когда-нибудь
// появится типизированное представление колонки, разница будет видна
// именно здесь.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

СТРОК = 200000;
ПРОГОНОВ = 50;

Т = ТекущаяУниверсальнаяДатаВМиллисекундах();

ТЗ = Новый ТаблицаЗначений;
ТЗ.Колонки.Добавить("ном");
ТЗ.Колонки.Добавить("имя");
Для н = 1 По СТРОК Цикл
	С = ТЗ.Добавить();
	С.ном = н;
	С.имя = "строка";
КонецЦикла;

Сумма = 0;
Для п = 1 По ПРОГОНОВ Цикл
	Сумма = ТЗ.Итог("ном");
КонецЦикла;

Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

Сообщить("строк: " + Строка(ТЗ.Количество()) + ", итог: " + Формат(Сумма, "ЧГ=0"));
Сообщить(Формат(Прошло, "ЧГ=0"));
КонецПроцедуры

