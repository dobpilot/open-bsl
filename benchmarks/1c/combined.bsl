Процедура Сценарий_textdoc_invoice()
// ТекстовыйДокумент: формирование расходной накладной по текстовому
// макету с официальной страницы 1С. В образце есть области `Заголовок`,
// `Шапка`, `СоставШапка`, `Состав`, `Итого` и `Склад`; здесь они остаются
// отдельными областями, чтобы мерить именно путь макет -> параметры ->
// `Вывести` итогового документа.
//
// Документ содержит 100 000 позиций. Контрольная строка печатает длину,
// количество строк и итог, чтобы рантайм, пропустивший часть документа, не
// дал сравнимое число.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

ПОЗИЦИЙ = 100000;


Т = ТекущаяУниверсальнаяДатаВМиллисекундах();

Макет = МакетРасходнойНакладной_textdoc_invoice();
Документ = Новый ТекстовыйДокумент;

Область = Макет.ПолучитьОбласть("Заголовок");
Документ.Вывести(Область);

Область = Макет.ПолучитьОбласть("Шапка");
Область.Параметры.Номер = "00011";
Область.Параметры.Дата = "10.05.2002";
Область.Параметры.Контрагент = "Эльбрус";
Документ.Вывести(Область);

Область = Макет.ПолучитьОбласть("СоставШапка");
Документ.Вывести(Область);

Итог = 0;
Пробелы = "                                ";
Область = Макет.ПолучитьОбласть("Состав");
Для НомерСтроки = 1 По ПОЗИЦИЙ Цикл
	Количество = 1 + (НомерСтроки % 10);
	Цена = 10 + (НомерСтроки % 997) / 10;
	Сумма = Количество * Цена;
	Итог = Итог + Сумма;

	Область.Параметры.Номенклатура =
		"Товар расходной накладной " + Формат(НомерСтроки, "ЧГ=0");
	Область.Параметры.Количество = Прав(Пробелы + Строка(Количество), 16);
	ЦенаТекст = Формат(Цена, "ЧГ=0; ЧДЦ=2; ЧРД=.");
	СуммаТекст = Формат(Сумма, "ЧГ=0; ЧДЦ=2; ЧРД=.");
	Область.Параметры.Цена = Прав(Пробелы + ЦенаТекст, 12);
	Область.Параметры.Сумма = Прав(Пробелы + СуммаТекст, 12);
	Документ.Вывести(Область);
КонецЦикла;

Область = Макет.ПолучитьОбласть("Итого");
ИтогТекст = Формат(Итог, "ЧГ=0; ЧДЦ=2; ЧРД=.");
Область.Параметры.Итого = Прав(Пробелы + ИтогТекст, 12);
Документ.Вывести(Область);

Область = Макет.ПолучитьОбласть("Склад");
Область.Параметры.Склад = "Основной склад";
Документ.Вывести(Область);

Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

Документ.Записать("benchmarks/textdoc_invoice.txt");

Сообщить("позиций: " + Формат(ПОЗИЦИЙ, "ЧГ=0")
	+ ", строк: " + Формат(Документ.КоличествоСтрок(), "ЧГ=0")
	+ ", длина: " + Формат(СтрДлина(Документ.ПолучитьТекст()), "ЧГ=0")
	+ ", итог: " + Формат(Итог, "ЧГ=0; ЧДЦ=2; ЧРД=."));
Сообщить(Формат(Прошло, "ЧГ=0; ЧН=0"));
КонецПроцедуры

Процедура Сценарий_xml_parse()
// Чтение XML: один документ обходится потоковым `ЧтениеXML` много раз.
//
// Что именно меряется: разбор разметки ПЛЮС обход узлов через `Прочитать()`
// и выборка атрибутов. Значения в структуры здесь не собираются, и это не
// упрощение, а разница форматов: у `ПрочитатьJSON` в паре `json_parse`
// готовое значение — обычная цель вызова, а у XML типовой обмен 1С читают
// именно потоком, узел за узлом.
//
// Поэтому строки `json_parse` и `xml_parse` в таблице НЕ равны по объёму
// работы: JSON-строка включает построение `Структура`/`Массив`, XML-строка —
// нет. Сравнивать их лоб в лоб как «XML быстрее JSON» нельзя; осмысленно
// сравнивать колонки внутри одной строки.
//
// Документ собирается ОДИН раз тем же кодом, что в `xml_write`, и в замер
// не входит. Контрольная сумма после замера — тоже вне его.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

ЧислоЗаписей = 10000;
Проходов = 3;

// --- сборка документа (вне замера) --------------------------------------
Запись = Новый ЗаписьXML;
Запись.УстановитьСтроку(Новый ПараметрыЗаписиXML("UTF-8", "1.0", Ложь));
Запись.ЗаписатьОбъявлениеXML();
Запись.ЗаписатьНачалоЭлемента("контрагенты");
Флаг = Ложь;
Для н = 1 По ЧислоЗаписей Цикл
	Флаг = Не Флаг;
	Ном = Формат(н, "ЧГ=0");

	Запись.ЗаписатьНачалоЭлемента("запись");
	Запись.ЗаписатьАтрибут("ид", Ном);
	Запись.ЗаписатьАтрибут("активен", Строка(Флаг));

	Запись.ЗаписатьНачалоЭлемента("имя");
	Запись.ЗаписатьТекст("запись номер " + Ном);
	Запись.ЗаписатьКонецЭлемента();

	Запись.ЗаписатьНачалоЭлемента("цена");
	Запись.ЗаписатьТекст(Формат(н + 0.75, "ЧГ=0; ЧРД=."));
	Запись.ЗаписатьКонецЭлемента();

	Запись.ЗаписатьНачалоЭлемента("теги");
	Запись.ЗаписатьНачалоЭлемента("тег");
	Запись.ЗаписатьТекст("альфа");
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьНачалоЭлемента("тег");
	Запись.ЗаписатьТекст("бета");
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьНачалоЭлемента("тег");
	Запись.ЗаписатьТекст("гамма");
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();

	Запись.ЗаписатьНачалоЭлемента("вложенное");
	Запись.ЗаписатьАтрибут("число", Ном);
	Запись.ЗаписатьТекст("значение");
	Запись.ЗаписатьКонецЭлемента();

	Запись.ЗаписатьНачалоЭлемента("контрагент");
	Запись.ЗаписатьАтрибут("инн", "77010" + Ном);
	Запись.ЗаписатьАтрибут("кпп", "770101001");

	Запись.ЗаписатьНачалоЭлемента("наименование");
	Запись.ЗаписатьТекст("ООО Ромашка " + Ном);
	Запись.ЗаписатьКонецЭлемента();

	Запись.ЗаписатьНачалоЭлемента("банковскийСчет");
	Запись.ЗаписатьАтрибут("номер", "4070281090000000" + Ном);
	Запись.ЗаписатьАтрибут("бик", "044525225");
	Запись.ЗаписатьАтрибут("коррсчет", "30101810400000000225");
	Запись.ЗаписатьНачалоЭлемента("банк");
	Запись.ЗаписатьТекст("АО Банк " + Ном);
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();

	Запись.ЗаписатьНачалоЭлемента("юрАдрес");
	Запись.ЗаписатьАтрибут("индекс", "101000");
	Запись.ЗаписатьНачалоЭлемента("регион");
	Запись.ЗаписатьТекст("Москва");
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьНачалоЭлемента("город");
	Запись.ЗаписатьТекст("Москва");
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьНачалоЭлемента("адрес");
	Запись.ЗаписатьТекст("ул. Тверская, д. " + Ном);
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();

	Запись.ЗаписатьНачалоЭлемента("фактическийАдрес");
	Запись.ЗаписатьАтрибут("индекс", "141400");
	Запись.ЗаписатьНачалоЭлемента("регион");
	Запись.ЗаписатьТекст("Московская область");
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьНачалоЭлемента("город");
	Запись.ЗаписатьТекст("Химки");
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьНачалоЭлемента("адрес");
	Запись.ЗаписатьТекст("ул. Победы, д. " + Ном);
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();

	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();
КонецЦикла;
Запись.ЗаписатьКонецЭлемента();
Текст = Запись.Закрыть();

// --- замер ---------------------------------------------------------------
// Обход трогает ВСЕ уровни вложенности и обе стороны разбора: узлы и
// атрибуты. Суммируются только поля из цифр и длины значений — они
// одинаковы у всех рантаймов, тогда как кириллица зависела бы от того, в
// чём рантайм меряет длину.
Т = ТекущаяУниверсальнаяДатаВМиллисекундах();
Узлов = 0;
Элементов = 0;
Атрибутов = 0;
СуммаИД = 0;
ДлинаЗначений = 0;
Для п = 1 По Проходов Цикл
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(Текст);
	Пока Чтение.Прочитать() Цикл
		Узлов = Узлов + 1;
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Элементов = Элементов + 1;
			Всего = Чтение.КоличествоАтрибутов();
			Атрибутов = Атрибутов + Всего;
			Для а = 0 По Всего - 1 Цикл
				ДлинаЗначений = ДлинаЗначений + СтрДлина(Чтение.ЗначениеАтрибута(а));
			КонецЦикла;
			Если Чтение.Имя = "запись" Тогда
				СуммаИД = СуммаИД + Число(Чтение.ЗначениеАтрибута("ид"));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
КонецЦикла;
Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

// --- проверка (вне замера) ------------------------------------------------
Сообщить("длина документа: " + Формат(СтрДлина(Текст), "ЧГ=0")
	+ ", узлов: " + Формат(Узлов / Проходов, "ЧГ=0")
	+ ", элементов: " + Формат(Элементов / Проходов, "ЧГ=0")
	+ ", атрибутов: " + Формат(Атрибутов / Проходов, "ЧГ=0")
	+ ", сумма ид: " + Формат(СуммаИД / Проходов, "ЧГ=0")
	+ ", длина значений: " + Формат(ДлинаЗначений / Проходов, "ЧГ=0"));
Сообщить(Формат(Прошло, "ЧГ=0"));
КонецПроцедуры

Процедура Сценарий_xml_write()
// Запись XML: тот же документ, что читает `xml_parse`, порождается
// потоковой `ЗаписьXML`.
//
// Пара к `xml_parse` симметрична так же, как `json_write` к `json_parse`, и
// форма записи взята ТА ЖЕ, что в JSON-сценариях — контрагент с реквизитами,
// банковским счётом и двумя адресами, 10 000 штук, 3 прохода. Это сделано
// нарочно: четыре строки таблицы тогда читаются вместе, и видно не только
// «загрузка против выгрузки», но и во что рантайму обходятся два формата на
// одних и тех же данных.
//
// Чего в JSON НЕТ и что меряется здесь дополнительно — атрибуты. В обмене
// 1С реквизиты обычно уходят именно атрибутами, а не вложенными
// элементами, поэтому половина полей записана так: `ЗаписатьАтрибут`
// экранирует иначе, чем `ЗаписатьТекст` (кавычка в атрибуте экранируется, в
// тексте нет), и стоит отдельного пути в писателе.
//
// Отступ ОТКЛЮЧЁН намеренно: с ним замер включал бы ещё и расстановку
// табуляций, а у JSON-пары переносы строк тоже выключены. Меряется
// структура документа, а не его красота.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

ЧислоЗаписей = 10000;
Проходов = 3;

Т = ТекущаяУниверсальнаяДатаВМиллисекундах();
Длина = 0;
Для п = 1 По Проходов Цикл
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиXML("UTF-8", "1.0", Ложь));
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента("контрагенты");
	Флаг = Ложь;
	Для н = 1 По ЧислоЗаписей Цикл
		Флаг = Не Флаг;
		Ном = Формат(н, "ЧГ=0");

		Запись.ЗаписатьНачалоЭлемента("запись");
		Запись.ЗаписатьАтрибут("ид", Ном);
		Запись.ЗаписатьАтрибут("активен", Строка(Флаг));

		Запись.ЗаписатьНачалоЭлемента("имя");
		Запись.ЗаписатьТекст("запись номер " + Ном);
		Запись.ЗаписатьКонецЭлемента();

		Запись.ЗаписатьНачалоЭлемента("цена");
		Запись.ЗаписатьТекст(Формат(н + 0.75, "ЧГ=0; ЧРД=."));
		Запись.ЗаписатьКонецЭлемента();

		Запись.ЗаписатьНачалоЭлемента("теги");
		Запись.ЗаписатьНачалоЭлемента("тег");
		Запись.ЗаписатьТекст("альфа");
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьНачалоЭлемента("тег");
		Запись.ЗаписатьТекст("бета");
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьНачалоЭлемента("тег");
		Запись.ЗаписатьТекст("гамма");
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьКонецЭлемента();

		Запись.ЗаписатьНачалоЭлемента("вложенное");
		Запись.ЗаписатьАтрибут("число", Ном);
		Запись.ЗаписатьТекст("значение");
		Запись.ЗаписатьКонецЭлемента();

		Запись.ЗаписатьНачалоЭлемента("контрагент");
		Запись.ЗаписатьАтрибут("инн", "77010" + Ном);
		Запись.ЗаписатьАтрибут("кпп", "770101001");

		Запись.ЗаписатьНачалоЭлемента("наименование");
		Запись.ЗаписатьТекст("ООО Ромашка " + Ном);
		Запись.ЗаписатьКонецЭлемента();

		Запись.ЗаписатьНачалоЭлемента("банковскийСчет");
		Запись.ЗаписатьАтрибут("номер", "4070281090000000" + Ном);
		Запись.ЗаписатьАтрибут("бик", "044525225");
		Запись.ЗаписатьАтрибут("коррсчет", "30101810400000000225");
		Запись.ЗаписатьНачалоЭлемента("банк");
		Запись.ЗаписатьТекст("АО Банк " + Ном);
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьКонецЭлемента();

		Запись.ЗаписатьНачалоЭлемента("юрАдрес");
		Запись.ЗаписатьАтрибут("индекс", "101000");
		Запись.ЗаписатьНачалоЭлемента("регион");
		Запись.ЗаписатьТекст("Москва");
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьНачалоЭлемента("город");
		Запись.ЗаписатьТекст("Москва");
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьНачалоЭлемента("адрес");
		Запись.ЗаписатьТекст("ул. Тверская, д. " + Ном);
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьКонецЭлемента();

		Запись.ЗаписатьНачалоЭлемента("фактическийАдрес");
		Запись.ЗаписатьАтрибут("индекс", "141400");
		Запись.ЗаписатьНачалоЭлемента("регион");
		Запись.ЗаписатьТекст("Московская область");
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьНачалоЭлемента("город");
		Запись.ЗаписатьТекст("Химки");
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьНачалоЭлемента("адрес");
		Запись.ЗаписатьТекст("ул. Победы, д. " + Ном);
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьКонецЭлемента();

		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();
	Текст = Запись.Закрыть();
	Длина = Длина + СтрДлина(Текст);
КонецЦикла;
Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

// --- проверка (вне замера) ------------------------------------------------
// Длина суммируется по всем проходам: рантайм, «ускорившийся» пропуском
// части документа, разойдётся здесь с остальными сразу.
Сообщить("длина документа: " + Формат(Длина / Проходов, "ЧГ=0")
	+ ", проходов: " + Формат(Проходов, "ЧГ=0"));
Сообщить(Формат(Прошло, "ЧГ=0"));
КонецПроцедуры

Процедура Распаковать_zip_read(ПутьАрхива, Куда)
	Попытка
		Чт = Новый ЧтениеZipФайла(ПутьАрхива);
	Исключение
		Сообщить("не открылся " + ПутьАрхива + " — сценарий гоняется из корня дерева");
		Возврат;
	КонецПопытки;

	Т = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Чт.ИзвлечьВсе(Куда);
	Чт.Закрыть();
	Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

	// Контрольная величина — после остановки часов: сумма размеров
	// распакованных файлов на диске. Один архив → одни и те же байты у
	// всех рантаймов, поэтому сумма сходится. Открываем архив вторично:
	// первый читатель уже закрыт, а коллекцию `Элементы` до закрытия
	// держать незачем — она относится к распаковке, не к контролю.
	Контроль = Новый ЧтениеZipФайла(ПутьАрхива);
	Байт = 0;
	Записей = 0;
	Для Каждого Элемент Из Контроль.Элементы Цикл
		Записей = Записей + 1;
		ДД = Новый ДвоичныеДанные(Куда + "/" + Элемент.Имя);
		Байт = Байт + ДД.Размер();
	КонецЦикла;
	Контроль.Закрыть();

	Сообщить("записей: " + Формат(Записей, "ЧГ=0") + ", байт: " + Формат(Байт, "ЧГ=0"));
	Сообщить(Формат(Прошло, "ЧГ=0"));
КонецПроцедуры

Процедура Сценарий_zip_read()
// Распаковка ZIP: один архив распаковывается `ЧтениеZipФайла` целиком.
//
// Что именно меряется: чтение central directory, inflate (RFC 1951) каждой
// записи и файловый вывод распакованных байтов на диск. Разделять эти
// стоимости здесь незачем: в реальном коде `ИзвлечьВсе` зовут именно ради
// файлов на диске, а не ради обхода каталога.
//
// Используется `ЧтениеZipФайла`, а не более новый `ЧтениеФайлаАрхива`:
// поверхность у них для ZIP одинакова, а `ЧтениеZipФайла` есть и в
// OneScript, и в платформе — поэтому колонка oscript не пустая.
//
// Входной архив — `benchmarks/data/zip-corpus.zip`, 2,3 МБ сжато, 7,3 МБ
// исходных (породил `make-zip-corpus.py` из `input_regexp.txt` и двух XSD).
// Сжатие deflate, три записи. Перегенерировать архив ради прогона не нужно:
// он лежит в репозитории воспроизводимым.
//
// Сверка: после остановки часов считается сумма размеров распакованных
// файлов на диске. Архив один и тот же для всех рантаймов, поэтому и файлы
// на выходе совпадают побайтно — сумма размеров обязана сойтись. Содержимое
// отдельно проверено conformance-фикстурой `zip-read`, здесь же контроль
// только в том, что `ИзвлечьВсе` честно положил столько байт, сколько заявил
// каталог.
//
// КОЛОНКА 1С СНИМАЕТСЯ С АБСОЛЮТНЫМ ПУТЁМ: у платформы свой текущий каталог,
// поэтому одиночный прогон идёт по копии с подменённой строкой — ровно та
// же подмена, что делает `build-combined.py` для свода:
//
//     sed "s|\"/home/kan/Документы/develop/open-bsl/benchmarks/data/|\"$PWD/benchmarks/data/|" \
//         benchmarks/zip_read.bsl > /tmp/zr.bsl
//     ONEC_TIMEOUT=900 ./tests/conformance/measure/1c/run-on-1c.sh /tmp/zr.bsl
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.


// Путь относительный, от корня дерева: так его видят и `run.sh`, и двойники.
// Платформе он не годится — её текущий каталог свой, — поэтому прогон на
// платформе идёт по копии с подменённой строкой (см. шапку).
Распаковать_zip_read("/home/kan/Документы/develop/open-bsl/benchmarks/data/zip-corpus.zip", "/tmp/open-bsl-zip-read-out");
КонецПроцедуры

Процедура Упаковать_zip_write(ЧтоДобавить, КудаЗаписать)
	З = Новый ЗаписьZipФайла(КудаЗаписать);

	Т = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Для Каждого Путь Из ЧтоДобавить Цикл
		З.Добавить(Путь);
	КонецЦикла;
	З.Записать();
	Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

	// Контрольная величина — после остановки часов: сумма `РазмерНесжатого`
	// элементов записанного архива. Один набор входных файлов → одни и те
	// же размеры у всех рантаймов, поэтому сумма сходится. Сжатый размер
	// не печатается: у разных deflate он расходится, и сверять его нельзя.
	Контроль = Новый ЧтениеZipФайла(КудаЗаписать);
	Байт = 0;
	Записей = 0;
	Для Каждого Элемент Из Контроль.Элементы Цикл
		Записей = Записей + 1;
		Байт = Байт + Элемент.РазмерНесжатого;
	КонецЦикла;
	Контроль.Закрыть();

	Сообщить("записей: " + Формат(Записей, "ЧГ=0") + ", байт: " + Формат(Байт, "ЧГ=0"));
	Сообщить(Формат(Прошло, "ЧГ=0"));
КонецПроцедуры

Процедура Сценарий_zip_write()
// Запись ZIP: три файла упаковываются `ЗаписьZipФайла` за один прогон.
//
// Что именно меряется: чтение исходных файлов с диска, deflate (RFC 1951)
// каждого и сборка контейнера ZIP — local header, central directory, EOCD.
// Разделять эти стоимости здесь незачем: в реальном коде `Записать` зовут
// именно ради готового файла на диске.
//
// Исходные файлы — уже лежащие в `benchmarks/data/`: `input_regexp.txt`
// (6,6 МБ текста), `EnterpriseData_1_0_1.xsd` (496 КБ XML),
// `ExchangeMessage.xsd` (1 КБ XML). Сжимаются deflate, имена плоские —
// `РежимСохраненияПутейZIP.НеСохранятьПути` по умолчанию. `УровеньСжатияZIP`
// здесь не варьируется: реализация один deflate на все уровни (см.
// `crates/bsl-rt/src/zip.rs:1926`), сравнивать нечего.
//
// Используется `ЗаписьZipФайла`, а не более новый `ЗаписьФайлаАрхива`:
// поверхность у них для ZIP одинакова, а `ЗаписьZipФайла` есть и в
// OneScript, и в платформе — поэтому колонка oscript не пустая.
//
// Сверка: после остановки часов записанный архив открывается своим же
// читателем, и суммируются `РазмерНесжатого` элементов. Архивы разных
// deflate-реализаций НЕ совпадают побайтно (см. шапку conformance-фикстуры
// `zip-write.bsl`), но размеры исходных файлов у всех рантаймов одни и те
// же — поэтому сумма обязана сойтись. Содержимое отдельно проверено
// conformance-фикстурой `zip-write`, здесь же контроль в том, что писатель
// честно положил три записи правильного размера.
//
// КОЛОНКА 1С СНИМАЕТСЯ С АБСОЛЮТНЫМ ПУТЁМ — см. шапку `zip_read.bsl`:
//
//     sed "s|\"/home/kan/Документы/develop/open-bsl/benchmarks/data/|\"$PWD/benchmarks/data/|" \
//         benchmarks/zip_write.bsl > /tmp/zw.bsl
//     ONEC_TIMEOUT=900 ./tests/conformance/measure/1c/run-on-1c.sh /tmp/zw.bsl
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.


// Пути относительные, от корня дерева: так их видят и `run.sh`, и двойники.
Файлы = Новый Массив;
Файлы.Добавить("/home/kan/Документы/develop/open-bsl/benchmarks/data/input_regexp.txt");
Файлы.Добавить("/home/kan/Документы/develop/open-bsl/benchmarks/data/EnterpriseData_1_0_1.xsd");
Файлы.Добавить("/home/kan/Документы/develop/open-bsl/benchmarks/data/ExchangeMessage.xsd");
Упаковать_zip_write(Файлы, "/tmp/open-bsl-zip-write-out.zip");
КонецПроцедуры

