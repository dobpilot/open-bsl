Процедура Дополнить_cbr_rates(Приемник, Источник)

	Если Источник = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ЭлементИсточника Из Источник Цикл
		ПараметрНайден = Ложь;

		Если ТипЗнч(Приемник) = Тип("Соответствие") Тогда
			ПараметрНайден = Приемник.Получить(ЭлементИсточника.Ключ) <> Неопределено;
		КонецЕсли;

		Если ТипЗнч(Приемник) = Тип("Структура") Тогда
			ПараметрНайден = Приемник.Свойство(ЭлементИсточника.Ключ);
		КонецЕсли;

		Если Не ПараметрНайден ИЛИ ПараметрНайден И ЭлементИсточника.Значение <> Неопределено Тогда
			Приемник.Вставить(ЭлементИсточника.Ключ, ЭлементИсточника.Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
Функция CbrЧислоИзXML_cbr_rates(Значение)
	ПозицияЗапятой = СтрНайти(Значение, ",");
	Если ПозицияЗапятой = 0 Тогда
		Возврат Число(Значение);
	КонецЕсли;
	ЦелаяЧасть = Число(Лев(Значение, ПозицияЗапятой - 1));
	ДробнаяСтрока = Сред(Значение, ПозицияЗапятой + 1);
	Масштаб = 1;
	Для Индекс = 1 По СтрДлина(ДробнаяСтрока) Цикл
		Масштаб = Масштаб * 10;
	КонецЦикла;
	Возврат ЦелаяЧасть + Число(ДробнаяСтрока) / Масштаб;
КонецФункции
Функция CbrКурсыИзXML_cbr_rates(Ответ)
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(КакТекст_cbr_rates(Ответ, КодировкаТекста.UTF8));
	Курсы = Новый Соответствие;
	Код = "";
	Номинал = "";
	Курс = "";
	Поле = "";

	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если Чтение.Имя = "Valute" Тогда
				Код = "";
				Номинал = "";
				Курс = "";
			КонецЕсли;
			Поле = Чтение.Имя;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
			Если Поле = "CharCode" Тогда
				Код = Чтение.Значение;
			ИначеЕсли Поле = "Nominal" Тогда
				Номинал = Чтение.Значение;
			ИначеЕсли Поле = "Value" Тогда
				Курс = Чтение.Значение;
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Если Чтение.Имя = "Valute" Тогда
				Курсы.Вставить(Код,
					Новый Структура("Номинал,Курс",
						CbrЧислоИзXML_cbr_rates(Номинал), CbrЧислоИзXML_cbr_rates(Курс)));
			КонецЕсли;
			Поле = "";
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Возврат Курсы;
КонецФункции
Функция CbrКурсыИзJSON_cbr_rates(Ответ, Коды)
	Документ = КакJson_cbr_rates(Ответ);
	Валюты = Документ.Получить("Valute");
	Курсы = Новый Соответствие;
	Для Каждого Код Из Коды Цикл
		Валюта = Валюты.Получить(Код);
		Курсы.Вставить(Код, Новый Структура("Номинал,Курс",
			Валюта.Получить("Nominal"), Валюта.Получить("Value")));
	КонецЦикла;
	Возврат Курсы;
КонецФункции
Функция CbrПредставление_cbr_rates(Курсы, Коды)
	Части = Новый Массив;
	Для Каждого Код Из Коды Цикл
		Валюта = Курсы.Получить(Код);
		Если Валюта = Неопределено Тогда
			ВызватьИсключение "В ответе ЦБ нет валюты " + Код;
		КонецЕсли;
		Части.Добавить(Код + "="
			+ Формат(Валюта.Курс / Валюта.Номинал, "ЧГ=0;ЧДЦ=4;ЧРД=."));
	КонецЦикла;
	Возврат СтрСоединить(Части, "; ");
КонецФункции
Функция CbrПроверитьОтвет_cbr_rates(Ответ)
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение КакИсключение_cbr_rates(Ответ, "ЦБ вернул ошибку");
	КонецЕсли;
	Возврат Ответ;
КонецФункции

Процедура Сценарий_cbr_rates()

// @onec-server-without-context _cbr_rates
// Два GET-запроса через Connector 2.6.0, разбор ответов ЦБ в XML и JSON
// и построение одинакового представления трёх курсов. Сетевое время
// намеренно входит в замер; печать и проверка равенства — нет.






Коды = СтрРазделить("USD,EUR,CNY", ",");
Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

ОтветXML = CbrПроверитьОтвет_cbr_rates(Get_cbr_rates("https://www.cbr-xml-daily.ru/daily_eng_utf8.xml"));
КурсыXML = CbrКурсыИзXML_cbr_rates(ОтветXML);
СтрокаXML = CbrПредставление_cbr_rates(КурсыXML, Коды);

ОтветJSON = CbrПроверитьОтвет_cbr_rates(Get_cbr_rates("https://www.cbr-xml-daily.ru/daily_json.js"));
КурсыJSON = CbrКурсыИзJSON_cbr_rates(ОтветJSON, Коды);
СтрокаJSON = CbrПредставление_cbr_rates(КурсыJSON, Коды);

Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

Если СтрокаXML <> СтрокаJSON Тогда
	ВызватьИсключение "Курсы в XML и JSON расходятся: " + СтрокаXML + " / " + СтрокаJSON;
КонецЕсли;
Сообщить("XML: " + СтрокаXML);
Сообщить("JSON: " + СтрокаJSON);
Сообщить(Формат(Прошло, "ЧГ=0"));
КонецПроцедуры

