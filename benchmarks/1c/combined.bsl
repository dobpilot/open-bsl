Процедура Сценарий_edata_writer()
// Выгрузка EnterpriseData: 1000 «Документ.ЗаказКлиента» через фабрику XDTO.
//
// Что именно меряется: создание тысячи объектов XDTO по реальной схеме
// EnterpriseData 1.0.1 — ключевые свойства с организацией, валюта,
// контрагент, данные взаиморасчётов и табличная часть «Товары» на пять
// строк с номенклатурой и единицей измерения в каждой — и их потоковая
// запись «ФабрикаXDTO.ЗаписатьXML» в один файл сообщения обмена (конверт
// «Сообщение»/«Заголовок» пространства имён
// http://www.1c.ru/SSL/Exchange/Message). Построение фабрики по двум XSD в
// замер НЕ входит: обмен строит фабрику один раз, а сообщений пишет много.
// Поиск типов тоже вынесен за часы — типы кешируются в переменные, как это
// делает любой живой код обмена.
//
// Схемы лежат в репозитории как есть, без правок:
// `benchmarks/data/EnterpriseData_1_0_1.xsd` (493 КБ, 348 масок `xs:any`,
// один `xs:import`) и `benchmarks/data/ExchangeMessage.xsd` — распакованный
// https://v8.1c.ru/upload/integraciya/realizovannye-resheniya/enterprisedata-1.0.1.zip
//
// Ссылки — настоящие случайные УИД (`Новый УникальныйИдентификатор`), как
// в живом обмене; всё остальное детерминировано: даты фиксированы,
// количества и цены выводятся из номера заказа. Контрольные значения —
// число заказов и строк, свод сумм, размер файла — совпадают у всех
// рантаймов и с платформой ДАЖЕ при случайных ссылках: каноническая
// строка УИД всегда 36 знаков. Контроль считается ПОСЛЕ остановки часов:
// это сверка, а не нагрузка. Формат записи в своё время зафиксирован
// ПОБАЙТНЫМ сличением с платформенной выгрузкой детерминированной
// редакции этого сценария (см. историю); случайные ссылки делают
// содержимое уникальным на прогон при неизменном размере.
//
// ПОРЯДОК ПРИСВОЕНИЙ НИЖЕ — ПОРЯДОК ПОСЛЕДОВАТЕЛЬНОСТИ СХЕМЫ, И ЭТО НЕ
// СТИЛЬ: типы EnterpriseData несут маски `xs:any`/`xs:anyAttribute`, то
// есть ОТКРЫТЫ, а открытый тип «ЗаписатьXML» пишет в порядке УСТАНОВКИ
// (измерено этим же сценарием — «Сумма», присвоенная после «Товары»,
// ушла в XML после них; разбор и пробы — в
// tests/conformance/measure/measure-xdto-order.bsl, якоря
// `XDTO.WRITE_ORDER.*`). Обе стороны теперь ведут себя так одинаково, но
// схемный порядок присвоений здесь остаётся сознательно: он делает
// выгрузку независимой от того, открыт тип или нет, и потому читаемой
// как эталон.
//
// КОЛОНКА 1С СНИМАЕТСЯ С АБСОЛЮТНЫМИ ПУТЯМИ: у платформы свой текущий
// каталог, поэтому одиночный прогон идёт по копии с подменёнными
// строками — ровно та же подмена, что делает `build-combined.py` для
// свода:
//
//     mkdir -p /tmp/onec-bench-scratch
//     sed -e "s|\"/home/kan/Документы/develop/open-bsl/benchmarks/data/|\"$PWD/benchmarks/data/|" \
//         -e "s|\"benchmarks/edata_writer.xml\"|\"/tmp/onec-bench-scratch/edata_writer.1c.xml\"|" \
//         benchmarks/edata_writer.bsl > /tmp/edata_writer.bsl
//     ONEC_TIMEOUT=900 ./tests/conformance/measure/1c/run-on-1c.sh /tmp/edata_writer.bsl
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

// Имена `Ширина`, `Высота` и `Заголовок` под запретом: сводный скрипт для
// платформы исполняется модулем управляемой формы, где это имена свойств
// самой формы (см. шапку bmp_rotate.bsl). Шапка сообщения поэтому зовётся
// «ШапкаСообщения», хотя её элемент в XML — «Заголовок».

НСДанных = "http://v8.1c.ru/edi/edi_stnd/EnterpriseData/1.0";
НСКонверта = "http://www.1c.ru/SSL/Exchange/Message";
ЧислоЗаказов = 1000;
СтрокНаЗаказ = 5;
ПутьВыгрузки = "/tmp/onec-bench-scratch/edata_writer.1c.xml";

// Фабрика по набору из двух схем: EnterpriseData импортирует пространство
// имён конверта, поэтому одним файлом её не поднять.
Пост = Новый ПостроительDOM;
ПостроительСхем = Новый ПостроительСхемXML;
Набор = Новый НаборСхемXML;
Чтение = Новый ЧтениеXML;
Чтение.ОткрытьФайл("/home/kan/Документы/develop/open-bsl/benchmarks/data/ExchangeMessage.xsd");
Набор.Добавить(ПостроительСхем.СоздатьСхемуXML(Пост.Прочитать(Чтение)));
Чтение.Закрыть();
Чтение = Новый ЧтениеXML;
Чтение.ОткрытьФайл("/home/kan/Документы/develop/open-bsl/benchmarks/data/EnterpriseData_1_0_1.xsd");
Набор.Добавить(ПостроительСхем.СоздатьСхемуXML(Пост.Прочитать(Чтение)));
Чтение.Закрыть();
Фабрика = Новый ФабрикаXDTO(Набор);

ТипШапки = Фабрика.Тип(НСКонверта, "Header");
ТипЗаказа = Фабрика.Тип(НСДанных, "Документ.ЗаказКлиента");
ТипКлючей = Фабрика.Тип(НСДанных, "КлючевыеСвойстваЗаказКлиента");
ТипОрганизации = Фабрика.Тип(НСДанных, "КлючевыеСвойстваОрганизация");
ТипВалюты = Фабрика.Тип(НСДанных, "КлючевыеСвойстваВалюта");
ТипКонтрагента = Фабрика.Тип(НСДанных, "КлючевыеСвойстваКонтрагент");
ТипВзаиморасчетов = Фабрика.Тип(НСДанных, "ОбщиеСвойстваДанныеВзаиморасчетов");
ТипТоваров = Фабрика.Тип(НСДанных, "Документ.ЗаказКлиента.Товары");
ТипСтрокиТоваров = Фабрика.Тип(НСДанных, "Документ.ЗаказКлиента.Товары.Строка");
ТипДанныхНоменклатуры = Фабрика.Тип(НСДанных, "ОбщиеСвойстваДанныеНоменклатуры");
ТипНоменклатуры = Фабрика.Тип(НСДанных, "КлючевыеСвойстваНоменклатура");
ТипЕдиницы = Фабрика.Тип(НСДанных, "КлючевыеСвойстваЕдиницаИзмерения");

Т = ТекущаяУниверсальнаяДатаВМиллисекундах();

Запись = Новый ЗаписьXML;
Запись.ОткрытьФайл(ПутьВыгрузки);
Запись.ЗаписатьОбъявлениеXML();
Запись.ЗаписатьНачалоЭлемента("Сообщение");
Запись.ЗаписатьАтрибут("xmlns", НСКонверта);

ШапкаСообщения = Фабрика.Создать(ТипШапки);
ШапкаСообщения.Format = НСДанных;
ШапкаСообщения.CreationDate = Дата(2026, 3, 15, 12, 0, 0);
ШапкаСообщения.AvailableVersion.Добавить("1.0.1");
Фабрика.ЗаписатьXML(Запись, ШапкаСообщения, "Заголовок", НСКонверта);

СводСумм = 0;
Для НомерЗаказа = 1 По ЧислоЗаказов Цикл
	// Табличная часть собирается первой: «Сумма» документа — свод по
	// строкам, а присвоения заказу обязаны идти в схемном порядке (см.
	// шапку), то есть «Сумма» раньше «Товары».
	Товары = Фабрика.Создать(ТипТоваров);
	СуммаЗаказа = 0;
	Для НомерСтроки = 1 По СтрокНаЗаказ Цикл
		Стр = Фабрика.Создать(ТипСтрокиТоваров);
		Стр.НомерСтрокиДокумента = НомерСтроки;

		ДанныеНом = Фабрика.Создать(ТипДанныхНоменклатуры);
		Ном = Фабрика.Создать(ТипНоменклатуры);
		НомерНоменклатуры = 1 + (НомерЗаказа * 7 + НомерСтроки * 13) % 500;
		Ном.Ссылка = Строка(Новый УникальныйИдентификатор());
		Ном.НаименованиеПолное = "Номенклатура " + Формат(НомерНоменклатуры, "ЧГ=0");
		Ном.КодВПрограмме = "Т-" + Формат(НомерНоменклатуры, "ЧЦ=5; ЧВН=; ЧГ=0");
		ДанныеНом.Номенклатура = Ном;
		Стр.ДанныеНоменклатуры = ДанныеНом;

		Единица = Фабрика.Создать(ТипЕдиницы);
		Единица.Код = "796";
		Стр.ЕдиницаИзмерения = Единица;

		Количество = 1 + (НомерЗаказа + НомерСтроки * 3) % 9;
		Цена = 100 + (НомерЗаказа * 3 + НомерСтроки * 17) % 900 + 0.5;
		СуммаСтроки = Количество * Цена;
		Стр.Количество = Количество;
		Стр.Сумма = СуммаСтроки;
		Стр.Цена = Цена;
		Стр.СтавкаНДС = "НДС18";

		Товары.Строка.Добавить(Стр);
		СуммаЗаказа = СуммаЗаказа + СуммаСтроки;
	КонецЦикла;

	Заказ = Фабрика.Создать(ТипЗаказа);

	Ключи = Фабрика.Создать(ТипКлючей);
	Ключи.Ссылка = Строка(Новый УникальныйИдентификатор());
	Ключи.Дата = Дата(2026, 3, 1 + НомерЗаказа % 28, 8 + НомерЗаказа % 10, НомерЗаказа % 60, 0);
	Ключи.Номер = "ЗК-" + Формат(НомерЗаказа, "ЧЦ=6; ЧВН=; ЧГ=0");
	Организация = Фабрика.Создать(ТипОрганизации);
	Организация.НаименованиеСокращенное = "ООО Ромашка";
	Организация.ИНН = "7701234567";
	Ключи.Организация = Организация;
	Заказ.КлючевыеСвойства = Ключи;

	Валюта = Фабрика.Создать(ТипВалюты);
	Валюта.Код = "643";
	Заказ.Валюта = Валюта;

	Заказ.Сумма = СуммаЗаказа;

	Контрагент = Фабрика.Создать(ТипКонтрагента);
	Контрагент.Ссылка = Строка(Новый УникальныйИдентификатор());
	Контрагент.НаименованиеПолное = "Покупатель " + Формат(1 + НомерЗаказа % 200, "ЧГ=0");
	Контрагент.ИНН = "7809876543";
	Заказ.Контрагент = Контрагент;

	Взаиморасчеты = Фабрика.Создать(ТипВзаиморасчетов);
	Взаиморасчеты.КурсВзаиморасчетов = 1;
	Взаиморасчеты.КратностьВзаиморасчетов = 1;
	Заказ.ДанныеВзаиморасчетов = Взаиморасчеты;

	Заказ.Товары = Товары;
	СводСумм = СводСумм + СуммаЗаказа;

	Фабрика.ЗаписатьXML(Запись, Заказ, "Документ.ЗаказКлиента", НСДанных);
КонецЦикла;

Запись.ЗаписатьКонецЭлемента();
Запись.Закрыть();

Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

// Сверка после часов: агрегаты данных и размер файла на диске.
Выгрузка = Новый ДвоичныеДанные(ПутьВыгрузки);
Сообщить("заказов: " + Формат(ЧислоЗаказов, "ЧГ=0")
	+ ", строк: " + Формат(ЧислоЗаказов * СтрокНаЗаказ, "ЧГ=0")
	+ ", свод сумм: " + Формат(СводСумм, "ЧДЦ=2; ЧГ=0"));
Сообщить("файл: " + Формат(Выгрузка.Размер(), "ЧГ=0") + " байт");
Сообщить(Формат(Прошло, "ЧГ=0"));
КонецПроцедуры

