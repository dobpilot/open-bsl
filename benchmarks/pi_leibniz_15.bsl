Процедура CalcНаСервере()
    sum = 0.0;
    flip = -1.0;

    Для i = 1 По 1000000 Цикл
        flip = -flip;
        sum = Окр(sum + flip / (2 * i - 1), 15);
    КонецЦикла;

    Сообщить(Окр(sum * 4, 15));
КонецПроцедуры

Т1 = ТекущаяУниверсальнаяДатаВМиллисекундах();
CalcНаСервере();
Сообщить(Формат(ТекущаяУниверсальнаяДатаВМиллисекундах() - Т1, "ЧГ=0"));
