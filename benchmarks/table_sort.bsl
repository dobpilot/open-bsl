// ТаблицаЗначений: сортировка по колонке и линейный поиск.
//
// Сортировка задевает сразу три вещи: сравнение значений
// (`compare_for_sort`), коллацию строк (`collate` — приближение, см.
// TABLE.SORT.COLLATION) и перестановку ВСЕХ колонок с пересборкой карты
// row_id. Поиск — линейный скан колонки с равенством по `BslValue`.
//
// Сортировки чередуются по направлению нарочно: сортировать уже
// отсортированное — лучший случай устойчивой сортировки, и мерялась бы не
// работа, а её отсутствие.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

СТРОК = 100000;

// Псевдослучайный ключ без ГСЧ: линейный конгруэнтный шаг, чтобы порядок
// был перемешан одинаково во всех рантаймах. Оператора остатка в BSL нет —
// берём его через Цел (усечение к нулю, семя всегда положительное).
ТЗ = Новый ТаблицаЗначений;
ТЗ.Колонки.Добавить("ключ");
ТЗ.Колонки.Добавить("имя");
Семя = 1;
МОДУЛЬ = 2147483648;
Для н = 1 По СТРОК Цикл
	Семя = Семя * 1103515245 + 12345;
	Семя = Семя - Цел(Семя / МОДУЛЬ) * МОДУЛЬ;
	С = ТЗ.Добавить();
	С.ключ = Семя;
	С.имя = "имя" + Строка(н);
КонецЦикла;

Т = ТекущаяУниверсальнаяДатаВМиллисекундах();

ТЗ.Сортировать("ключ");
ТЗ.Сортировать("ключ Убыв");
ТЗ.Сортировать("имя");

Найдена = ТЗ.Найти("имя" + Строка(СТРОК), "имя");
Есть = Найдена <> Неопределено;

Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

Сообщить("строк: " + Строка(ТЗ.Количество()) + ", нашлась: " + Строка(Есть));
Сообщить(Формат(Прошло, "ЧГ=0"));
