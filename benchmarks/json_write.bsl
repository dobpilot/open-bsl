// Запись JSON: тот же документ, что читает `json_parse`, но меряется его
// ПОРОЖДЕНИЕ через потоковую `ЗаписьJSON`.
//
// Пара к `json_parse` намеренно симметрична: одна и та же форма записи и
// одно и то же их число, поэтому две строки таблицы можно читать вместе —
// во что рантайму обходится выгрузка против загрузки.
//
// Что именно меряется: вызовы `ЗаписатьИмяСвойства`/`ЗаписатьЗначение` с
// экранированием строк, проверкой структуры документа и накоплением
// результата. Финальный `Закрыть()` входит в замер — он и отдаёт текст.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

ЧислоЗаписей = 10000;
Проходов = 3;

Т = ТекущаяУниверсальнаяДатаВМиллисекундах();
Длина = 0;
Для п = 1 По Проходов Цикл
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	Запись.ЗаписатьНачалоМассива();
	Флаг = Ложь;
	Для н = 1 По ЧислоЗаписей Цикл
		Флаг = Не Флаг;
		Ном = Формат(н, "ЧГ=0");

		Запись.ЗаписатьНачалоОбъекта();
		Запись.ЗаписатьИмяСвойства("ид");
		Запись.ЗаписатьЗначение(н);
		Запись.ЗаписатьИмяСвойства("имя");
		Запись.ЗаписатьЗначение("запись номер " + Ном);
		Запись.ЗаписатьИмяСвойства("активен");
		Запись.ЗаписатьЗначение(Флаг);
		Запись.ЗаписатьИмяСвойства("цена");
		Запись.ЗаписатьЗначение(н + 0.75);
		Запись.ЗаписатьИмяСвойства("теги");
		Запись.ЗаписатьНачалоМассива();
		Запись.ЗаписатьЗначение("альфа");
		Запись.ЗаписатьЗначение("бета");
		Запись.ЗаписатьЗначение("гамма");
		Запись.ЗаписатьКонецМассива();
		Запись.ЗаписатьИмяСвойства("вложенное");
		Запись.ЗаписатьНачалоОбъекта();
		Запись.ЗаписатьИмяСвойства("ключ");
		Запись.ЗаписатьЗначение("значение");
		Запись.ЗаписатьИмяСвойства("число");
		Запись.ЗаписатьЗначение(н);
		Запись.ЗаписатьКонецОбъекта();

		Запись.ЗаписатьИмяСвойства("контрагент");
		Запись.ЗаписатьНачалоОбъекта();
		Запись.ЗаписатьИмяСвойства("инн");
		Запись.ЗаписатьЗначение("77010" + Ном);
		Запись.ЗаписатьИмяСвойства("кпп");
		Запись.ЗаписатьЗначение("770101001");
		Запись.ЗаписатьИмяСвойства("наименование");
		Запись.ЗаписатьЗначение("ООО Ромашка " + Ном);

		Запись.ЗаписатьИмяСвойства("банковскийСчет");
		Запись.ЗаписатьНачалоОбъекта();
		Запись.ЗаписатьИмяСвойства("номер");
		Запись.ЗаписатьЗначение("4070281090000000" + Ном);
		Запись.ЗаписатьИмяСвойства("банк");
		Запись.ЗаписатьЗначение("АО Банк " + Ном);
		Запись.ЗаписатьИмяСвойства("бик");
		Запись.ЗаписатьЗначение("044525225");
		Запись.ЗаписатьИмяСвойства("коррсчет");
		Запись.ЗаписатьЗначение("30101810400000000225");
		Запись.ЗаписатьКонецОбъекта();

		Запись.ЗаписатьИмяСвойства("юрАдрес");
		Запись.ЗаписатьНачалоОбъекта();
		Запись.ЗаписатьИмяСвойства("регион");
		Запись.ЗаписатьЗначение("Москва");
		Запись.ЗаписатьИмяСвойства("город");
		Запись.ЗаписатьЗначение("Москва");
		Запись.ЗаписатьИмяСвойства("индекс");
		Запись.ЗаписатьЗначение("101000");
		Запись.ЗаписатьИмяСвойства("адрес");
		Запись.ЗаписатьЗначение("ул. Тверская, д. " + Ном);
		Запись.ЗаписатьКонецОбъекта();

		Запись.ЗаписатьИмяСвойства("фактическийАдрес");
		Запись.ЗаписатьНачалоОбъекта();
		Запись.ЗаписатьИмяСвойства("регион");
		Запись.ЗаписатьЗначение("Московская область");
		Запись.ЗаписатьИмяСвойства("город");
		Запись.ЗаписатьЗначение("Химки");
		Запись.ЗаписатьИмяСвойства("индекс");
		Запись.ЗаписатьЗначение("141400");
		Запись.ЗаписатьИмяСвойства("адрес");
		Запись.ЗаписатьЗначение("ул. Победы, д. " + Ном);
		Запись.ЗаписатьКонецОбъекта();

		Запись.ЗаписатьКонецОбъекта();
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	Длина = СтрДлина(Запись.Закрыть());
КонецЦикла;
Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

// Длина документа — та же контрольная величина, что у `json_parse`:
// рантайм, записавший меньше, сразу здесь и разойдётся.
Сообщить("длина документа: " + Формат(Длина, "ЧГ=0")
	+ ", проходов: " + Формат(Проходов, "ЧГ=0"));
Сообщить(Формат(Прошло, "ЧГ=0"));
