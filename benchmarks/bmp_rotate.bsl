// Поворот изображения BMP на 90° через блочные операции буфера.
//
// Что именно меряется: порождение картинки 600x400 в 32-битном BMP
// (заголовок собирается `ЗаписатьЦелое16/32`, пикселы пишутся побайтно) и
// её поворот попиксельно — `ПолучитьСрез(Позиция, 4)` над источником и
// `Записать(НоваяПозиция, Пиксел)` в приёмник, 240 000 пар вызовов. Срез у
// буфера — ОКНО в тот же массив байтов, а не копия (измерено, см.
// `tests/conformance/measure/measure-binbuf.bsl`), поэтому такой поворот
// не порождает четверти миллиона временных буферов, и меряется здесь
// именно перекладывание байтов, а не работа распределителя памяти.
//
// Схема взята из руководства разработчика (глава 16.3), но с одной
// поправкой: там новый индекс считается как
// `4 * (ИндексВысота + ИндексШирина * Ширина)`, то есть ШАГ СТРОКИ у
// повёрнутой картинки взят от исходной ширины. Для квадрата это верно, для
// 600x400 — нет: у результата ширина 400. Здесь честный поворот по
// часовой стрелке, `новый_х = Высота - 1 - й`, `новый_й = х`, шаг строки —
// высота исходника.
//
// Контрольная величина — контрольная сумма повёрнутых пикселов, свёрнутая
// с учётом ПОРЯДКА: обычная сумма байтов совпала бы и у неповёрнутой
// картинки, а такой бенчмарк проверял бы только скорость, но не работу.
// Считается она ПОСЛЕ остановки часов: это сверка, а не нагрузка.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

// ИМЕНА `Ширина`, `Высота` И `Заголовок` ЗДЕСЬ ПОД ЗАПРЕТОМ. Сводный
// скрипт для платформы (`benchmarks/1c/build-combined.py`) исполняется как
// модуль УПРАВЛЯЕМОЙ ФОРМЫ, а там такое имя достаётся СВОЙСТВУ ФОРМЫ.
// `Заголовок` стоил прогона: `Заголовок = Новый БуферДвоичныхДанных(54)`
// — это присваивание буфера строковому свойству формы, платформа не
// компилирует модуль целиком и показывает модальное окно, то есть даёт
// пустой вывод и таймаут. Разностная проба: тот же скрипт с
// `БуферЗаголовка` печатает всё.
ШиринаПикс = 600;
ВысотаПикс = 400;
БайтНаПиксел = 4;
РазмерЗаголовка = 54;

Т = ТекущаяУниверсальнаяДатаВМиллисекундах();

РазмерПикселов = ШиринаПикс * ВысотаПикс * БайтНаПиксел;
Пикселы = Новый БуферДвоичныхДанных(РазмерПикселов);

// Градиент: синий растёт по горизонтали, зелёный по вертикали, красный по
// диагонали. Всё, что нужно от картинки, — чтобы соседние пикселы
// различались и поворот было чем проверить.
Для й = 0 По ВысотаПикс - 1 Цикл
	СтрокаБазы = й * ШиринаПикс * БайтНаПиксел;
	Для х = 0 По ШиринаПикс - 1 Цикл
		Инд = СтрокаБазы + х * БайтНаПиксел;
		Пикселы[Инд] = х % 256;
		Пикселы[Инд + 1] = й % 256;
		Пикселы[Инд + 2] = (х + й) % 256;
		Пикселы[Инд + 3] = 255;
	КонецЦикла;
КонецЦикла;

// Заголовок исходника: BITMAPFILEHEADER (14 байтов) + BITMAPINFOHEADER
// (40 байтов), 32 бита на пиксел, без сжатия. Порядок байтов у буфера по
// умолчанию LittleEndian — тот, что нужен BMP.
БуферЗаголовка = Новый БуферДвоичныхДанных(РазмерЗаголовка);
БуферЗаголовка[0] = 66;
БуферЗаголовка[1] = 77;
БуферЗаголовка.ЗаписатьЦелое32(2, РазмерЗаголовка + РазмерПикселов);
БуферЗаголовка.ЗаписатьЦелое32(10, РазмерЗаголовка);
БуферЗаголовка.ЗаписатьЦелое32(14, 40);
БуферЗаголовка.ЗаписатьЦелое32(18, ШиринаПикс);
БуферЗаголовка.ЗаписатьЦелое32(22, ВысотаПикс);
БуферЗаголовка.ЗаписатьЦелое16(26, 1);
БуферЗаголовка.ЗаписатьЦелое16(28, 32);
БуферЗаголовка.ЗаписатьЦелое32(34, РазмерПикселов);
БуферЗаголовка.ЗаписатьЦелое32(38, 2835);
БуферЗаголовка.ЗаписатьЦелое32(42, 2835);

БуферИзображения = Новый БуферДвоичныхДанных(РазмерЗаголовка + РазмерПикселов);
БуферИзображения.Записать(0, БуферЗаголовка);
БуферИзображения.Записать(РазмерЗаголовка, Пикселы);

// Поворот по часовой стрелке. Работаем со срезом пикселов, а не со всем
// файлом: смещение заголовка не должно лезть в арифметику индексов.
Источник = БуферИзображения.ПолучитьСрез(РазмерЗаголовка, РазмерПикселов);
Повёрнутые = Новый БуферДвоичныхДанных(РазмерПикселов);

Для й = 0 По ВысотаПикс - 1 Цикл
	СтрокаБазы = й * ШиринаПикс * БайтНаПиксел;
	НоваяКолонка = (ВысотаПикс - 1 - й) * БайтНаПиксел;
	Для х = 0 По ШиринаПикс - 1 Цикл
		ИндексПиксела = СтрокаБазы + х * БайтНаПиксел;
		НовыйИндексПиксела = НоваяКолонка + х * ВысотаПикс * БайтНаПиксел;

		// `ПолучитьСрез`, а не `Прочитать`: срез — окно в те же байты, и
		// лишнего копирования здесь нет, источник ведь не меняется.
		Пиксел = Источник.ПолучитьСрез(ИндексПиксела, БайтНаПиксел);
		Повёрнутые.Записать(НовыйИндексПиксела, Пиксел);
	КонецЦикла;
КонецЦикла;

// Заголовок повёрнутой картинки: стороны меняются местами.
БуферПовёрнутого = Новый БуферДвоичныхДанных(РазмерЗаголовка + РазмерПикселов);
БуферПовёрнутого.Записать(0, БуферЗаголовка);
БуферПовёрнутого.ЗаписатьЦелое32(18, ВысотаПикс);
БуферПовёрнутого.ЗаписатьЦелое32(22, ШиринаПикс);
БуферПовёрнутого.Записать(РазмерЗаголовка, Повёрнутые);

Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

// Свёртка с учётом порядка: `К = К * 31 + слово` по модулю 2^31-1.
// Множитель и модуль подобраны так, чтобы промежуточное произведение
// оставалось меньше 2^36 и считалось точно во всех рантаймах, включая те,
// где числа двойной точности.
Сумма = 0;
Для н = 0 По ШиринаПикс * ВысотаПикс - 1 Цикл
	Слово = Повёрнутые.ПрочитатьЦелое32(н * БайтНаПиксел);
	Сумма = (Сумма * 31 + Слово) % 2147483647;
КонецЦикла;

Сообщить("BMP " + Формат(ВысотаПикс, "ЧГ=0") + "x" + Формат(ШиринаПикс, "ЧГ=0")
	+ ", байтов: " + Формат(БуферПовёрнутого.Размер, "ЧГ=0")
	+ ", контрольная сумма: " + Формат(Сумма, "ЧГ=0"));
Сообщить(Формат(Прошло, "ЧГ=0"));
