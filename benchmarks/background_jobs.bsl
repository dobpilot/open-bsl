//@используй(modules/background_jobs_worker.bsl как ФоновыйBenchmark)
// @skip-1c-combined: цель задания должна быть общим модулем конфигурации.

// Фоновые задания: постоянный объём из 2 400 000 строк делится между
// 1, 2, 4, ..., 256 заданиями. Это повторяет профиль ТестПроцессораКластера1С.
// Каждая группа печатает своё время; последняя строка — сумма в миллисекундах
// по контракту `run.sh`. Проверка terminal-состояний в замер не входит.

Функция ЗапуститьГруппу(КоличествоЭлементов, КоличествоЗаданий)
	Параметры = Новый Массив;
	Параметры.Добавить(КоличествоЭлементов / КоличествоЗаданий);
	Задания = Новый Массив;

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Для Счетчик = 1 По КоличествоЗаданий Цикл
		Ключ = "background_jobs_" + Формат(КоличествоЗаданий, "ЧГ=0") + "_" + Формат(Счетчик, "ЧГ=0");
		Задание = ФоновыеЗадания.Выполнить(
			"ФоновыйBenchmark.РассчитатьТаблицу", Параметры, Ключ, "benchmark");
		Задания.Добавить(Задание);
	КонецЦикла;
	Завершенные = ФоновыеЗадания.ОжидатьЗавершенияВыполнения(Задания);
	Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Если Завершенные.Количество() <> КоличествоЗаданий Тогда
		ВызватьИсключение "Ожидание вернуло не все фоновые задания";
	КонецЕсли;
	Для Каждого Задание Из Завершенные Цикл
		Если Задание.Состояние <> СостояниеФоновогоЗадания.Завершено Тогда
			ВызватьИсключение "Фоновое задание не завершилось";
		КонецЕсли;
	КонецЦикла;

	Сообщить(Формат(КоличествоЗаданий, "ЧГ=0") + " заданий: " + Формат(Прошло, "ЧГ=0") + " мс");
	Возврат Прошло;
КонецФункции

Если АргументыКоманднойСтроки.Количество() > 0 Тогда
	// Меньший объём нужен для быстрой проверки сценария вне замера.
	КоличествоЭлементов = Число(АргументыКоманднойСтроки[0]);
Иначе
	КоличествоЭлементов = 2400000;
КонецЕсли;
ЧислаЗаданий = Новый Массив;
ЧислаЗаданий.Добавить(1);
ЧислаЗаданий.Добавить(2);
ЧислаЗаданий.Добавить(4);
ЧислаЗаданий.Добавить(6);
ЧислаЗаданий.Добавить(8);
ЧислаЗаданий.Добавить(12);
ЧислаЗаданий.Добавить(16);
ЧислаЗаданий.Добавить(24);
ЧислаЗаданий.Добавить(32);
ЧислаЗаданий.Добавить(48);
ЧислаЗаданий.Добавить(64);
ЧислаЗаданий.Добавить(128);
ЧислаЗаданий.Добавить(256);

ОбщееВремя = 0;
ВсегоЗаданий = 0;
Для Каждого КоличествоЗаданий Из ЧислаЗаданий Цикл
	ОбщееВремя = ОбщееВремя + ЗапуститьГруппу(КоличествоЭлементов, КоличествоЗаданий);
	ВсегоЗаданий = ВсегоЗаданий + КоличествоЗаданий;
КонецЦикла;

Сообщить("групп: " + Формат(ЧислаЗаданий.Количество(), "ЧГ=0")
	+ ", заданий: " + Формат(ВсегоЗаданий, "ЧГ=0")
	+ ", строк на группу: " + Формат(КоличествоЭлементов, "ЧГ=0"));
Сообщить(Формат(ОбщееВремя, "ЧГ=0"));
