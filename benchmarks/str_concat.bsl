// Сборка строки конкатенацией в цикле — самый частый способ строить текст
// в прикладном коде BSL. Строка неизменяема (`Rc<[u16]>`), поэтому каждая
// конкатенация копирует весь накопленный текст: работа квадратична от числа
// шагов, и меряется именно она.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

Кусок = "абвгдеёжзийклмнопрстуфхцчшщъыьэюя0123456789";

Т = ТекущаяУниверсальнаяДатаВМиллисекундах();
Текст = "";
Для н = 1 По 3000 Цикл
	Текст = Текст + Кусок;
КонецЦикла;
Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

Сообщить("длина: " + Строка(СтрДлина(Текст)));
Сообщить(Формат(Прошло, "ЧГ=0"));
