// Вызов пользовательской функции: миллион раз подряд, тело — одно
// сложение. Меряется НЕ арифметика, а цена самого вызова: постройка
// кадра, передача аргументов, возврат значения.
//
// В базовом наборе такого сценария не было, а в прикладном BSL вызов
// процедуры — самая частая операция после присваивания. Заодно это
// единственное место, где видно ограничение JIT-а: кадр вызова он менять
// не умеет и на `Call`/`Возврат` отдаёт управление интерпретатору.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

Функция Сложить(А, Б)
	Возврат А + Б;
КонецФункции

Т = ТекущаяУниверсальнаяДатаВМиллисекундах();
Сумма = 0;
Для н = 1 По 1000000 Цикл
	Сумма = Сложить(Сумма, н);
КонецЦикла;
Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

Сообщить("сумма: " + Формат(Сумма, "ЧГ=0"));
Сообщить(Формат(Прошло, "ЧГ=0; ЧН=0"));
