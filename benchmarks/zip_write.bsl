// Запись ZIP: три файла упаковываются `ЗаписьZipФайла` за один прогон.
//
// Что именно меряется: чтение исходных файлов с диска, deflate (RFC 1951)
// каждого и сборка контейнера ZIP — local header, central directory, EOCD.
// Разделять эти стоимости здесь незачем: в реальном коде `Записать` зовут
// именно ради готового файла на диске.
//
// Исходные файлы — уже лежащие в `benchmarks/data/`: `input_regexp.txt`
// (6,6 МБ текста), `EnterpriseData_1_0_1.xsd` (496 КБ XML),
// `ExchangeMessage.xsd` (1 КБ XML). Сжимаются deflate, имена плоские —
// `РежимСохраненияПутейZIP.НеСохранятьПути` по умолчанию. `УровеньСжатияZIP`
// здесь не варьируется: реализация один deflate на все уровни (см.
// `crates/bsl-rt/src/zip.rs:1926`), сравнивать нечего.
//
// Используется `ЗаписьZipФайла`, а не более новый `ЗаписьФайлаАрхива`:
// поверхность у них для ZIP одинакова, а `ЗаписьZipФайла` есть и в
// OneScript, и в платформе — поэтому колонка oscript не пустая.
//
// Сверка: после остановки часов записанный архив открывается своим же
// читателем, и суммируются `РазмерНесжатого` элементов. Архивы разных
// deflate-реализаций НЕ совпадают побайтно (см. шапку conformance-фикстуры
// `zip-write.bsl`), но размеры исходных файлов у всех рантаймов одни и те
// же — поэтому сумма обязана сойтись. Содержимое отдельно проверено
// conformance-фикстурой `zip-write`, здесь же контроль в том, что писатель
// честно положил три записи правильного размера.
//
// КОЛОНКА 1С СНИМАЕТСЯ С АБСОЛЮТНЫМ ПУТЁМ — см. шапку `zip_read.bsl`:
//
//     sed "s|\"benchmarks/data/|\"$PWD/benchmarks/data/|" \
//         benchmarks/zip_write.bsl > /tmp/zw.bsl
//     ONEC_TIMEOUT=900 ./tests/conformance/measure/1c/run-on-1c.sh /tmp/zw.bsl
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

Процедура Упаковать(ЧтоДобавить, КудаЗаписать)
	З = Новый ЗаписьZipФайла(КудаЗаписать);

	Т = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Для Каждого Путь Из ЧтоДобавить Цикл
		З.Добавить(Путь);
	КонецЦикла;
	З.Записать();
	Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

	// Контрольная величина — после остановки часов: сумма `РазмерНесжатого`
	// элементов записанного архива. Один набор входных файлов → одни и те
	// же размеры у всех рантаймов, поэтому сумма сходится. Сжатый размер
	// не печатается: у разных deflate он расходится, и сверять его нельзя.
	Контроль = Новый ЧтениеZipФайла(КудаЗаписать);
	Байт = 0;
	Записей = 0;
	Для Каждого Элемент Из Контроль.Элементы Цикл
		Записей = Записей + 1;
		Байт = Байт + Элемент.РазмерНесжатого;
	КонецЦикла;
	Контроль.Закрыть();

	Сообщить("записей: " + Формат(Записей, "ЧГ=0") + ", байт: " + Формат(Байт, "ЧГ=0"));
	Сообщить(Формат(Прошло, "ЧГ=0"));
КонецПроцедуры

// Пути относительные, от корня дерева: так их видят и `run.sh`, и двойники.
Файлы = Новый Массив;
Файлы.Добавить("benchmarks/data/input_regexp.txt");
Файлы.Добавить("benchmarks/data/EnterpriseData_1_0_1.xsd");
Файлы.Добавить("benchmarks/data/ExchangeMessage.xsd");
Упаковать(Файлы, "/tmp/open-bsl-zip-write-out.zip");
