// ТекстовыйДокумент: формирование расходной накладной по текстовому
// макету с официальной страницы 1С. В образце есть области `Заголовок`,
// `Шапка`, `СоставШапка`, `Состав`, `Итого` и `Склад`; здесь они остаются
// отдельными областями, чтобы мерить именно путь макет -> параметры ->
// `Вывести` итогового документа.
//
// Документ содержит 100 000 позиций. Контрольная строка печатает длину,
// количество строк и итог, чтобы рантайм, пропустивший часть документа, не
// дал сравнимое число.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

ПОЗИЦИЙ = 100000;

Функция МакетРасходнойНакладной()
	Макет = Новый ТекстовыйДокумент;
	Макет.УстановитьТекст(
		"#Область Заголовок" + Символ(10)
		+ "                                Расходная накладная" + Символ(10)
		+ " " + Символ(10)
		+ "#КонецОбласти" + Символ(10)
		+ "#Область Шапка" + Символ(10)
		+ "Номер         [Номер    ]" + Символ(10)
		+ "Дата          [Дата      ]" + Символ(10)
		+ "Контрагент    [Контрагент]" + Символ(10)
		+ " " + Символ(10)
		+ "#КонецОбласти" + Символ(10)
		+ "#Область СоставШапка" + Символ(10)
		+ "+--------------------------------+----------------+------------+------------+" + Символ(10)
		+ "|        Номенклатура            |   Количество   |    Цена    |    Сумма   |" + Символ(10)
		+ "+--------------------------------+----------------+------------+------------+" + Символ(10)
		+ "#КонецОбласти" + Символ(10)
		+ "#Область Состав" + Символ(10)
		+ "|[Номенклатура                  ]|[Количество    ]|[Цена      ]|[Сумма     ]|" + Символ(10)
		+ "+--------------------------------+----------------+------------+------------+" + Символ(10)
		+ "#КонецОбласти" + Символ(10)
		+ "#Область Итого" + Символ(10)
		+ "|Итого                           |                |            |[Итого     ]|" + Символ(10)
		+ "+--------------------------------+----------------+------------+------------+" + Символ(10)
		+ "#КонецОбласти" + Символ(10)
		+ "#Область Склад" + Символ(10)
		+ " " + Символ(10)
		+ "Склад         [Склад                ]" + Символ(10)
		+ "#КонецОбласти");
	Возврат Макет;
КонецФункции

Т = ТекущаяУниверсальнаяДатаВМиллисекундах();

Макет = МакетРасходнойНакладной();
Документ = Новый ТекстовыйДокумент;

Область = Макет.ПолучитьОбласть("Заголовок");
Документ.Вывести(Область);

Область = Макет.ПолучитьОбласть("Шапка");
Область.Параметры.Номер = "00011";
Область.Параметры.Дата = "10.05.2002";
Область.Параметры.Контрагент = "Эльбрус";
Документ.Вывести(Область);

Область = Макет.ПолучитьОбласть("СоставШапка");
Документ.Вывести(Область);

Итог = 0;
Пробелы = "                                ";
Область = Макет.ПолучитьОбласть("Состав");
Для НомерСтроки = 1 По ПОЗИЦИЙ Цикл
	Количество = 1 + (НомерСтроки % 10);
	Цена = 10 + (НомерСтроки % 997) / 10;
	Сумма = Количество * Цена;
	Итог = Итог + Сумма;

	Область.Параметры.Номенклатура =
		"Товар расходной накладной " + Формат(НомерСтроки, "ЧГ=0");
	Область.Параметры.Количество = Прав(Пробелы + Строка(Количество), 16);
	ЦенаТекст = Формат(Цена, "ЧГ=0; ЧДЦ=2; ЧРД=.");
	СуммаТекст = Формат(Сумма, "ЧГ=0; ЧДЦ=2; ЧРД=.");
	Область.Параметры.Цена = Прав(Пробелы + ЦенаТекст, 12);
	Область.Параметры.Сумма = Прав(Пробелы + СуммаТекст, 12);
	Документ.Вывести(Область);
КонецЦикла;

Область = Макет.ПолучитьОбласть("Итого");
ИтогТекст = Формат(Итог, "ЧГ=0; ЧДЦ=2; ЧРД=.");
Область.Параметры.Итого = Прав(Пробелы + ИтогТекст, 12);
Документ.Вывести(Область);

Область = Макет.ПолучитьОбласть("Склад");
Область.Параметры.Склад = "Основной склад";
Документ.Вывести(Область);

Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

Документ.Записать("benchmarks/textdoc_invoice.txt");

Сообщить("позиций: " + Формат(ПОЗИЦИЙ, "ЧГ=0")
	+ ", строк: " + Формат(Документ.КоличествоСтрок(), "ЧГ=0")
	+ ", длина: " + Формат(СтрДлина(Документ.ПолучитьТекст()), "ЧГ=0")
	+ ", итог: " + Формат(Итог, "ЧГ=0; ЧДЦ=2; ЧРД=."));
Сообщить(Формат(Прошло, "ЧГ=0; ЧН=0"));
