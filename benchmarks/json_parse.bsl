// Разбор JSON: один документ читается `ПрочитатьJSON` много раз подряд.
//
// Что именно меряется: сканер текста ПЛЮС построение значений — объект
// становится `Структура` (с интернированием имён и заведением формы),
// массив — `Массив`. Разделять эти две стоимости здесь незачем: в реальном
// коде `ПрочитатьJSON` вызывают именно ради готового значения, а не ради
// обхода токенов.
//
// Форма записи — контрагент с реквизитами, банковским счётом и двумя
// адресами, — взята нарочно: это типовой обмен 1С, а не синтетический
// плоский объект. Вложенность в четыре уровня и полсотни свойств на
// запись нагружают заведение форм структур куда сильнее, чем плоский
// список пар.
//
// Документ собирается ОДИН раз через `ЗаписьJSON` и в замер не входит:
// меряется чтение, а не запись. Обход результата ради контрольной суммы —
// тоже вне замера, он одинаков у всех рантаймов и только разбавлял бы
// число.
//
// Контракт бенчмарка: последняя напечатанная строка — миллисекунды числом.

// 10 000 записей — документ на 5,6 МБ код-юнитов, размер выгрузки, какую
// в 1С и правда гоняют. Проходов всего три: один проход сам по себе идёт
// сотни миллисекунд, то есть на три порядка выше разрешения таймера, и
// накручивать повторы значило бы только удлинять прогон всего набора.
ЧислоЗаписей = 10000;
Проходов = 3;

// --- сборка документа (вне замера) --------------------------------------
Запись = Новый ЗаписьJSON;
Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
Запись.ЗаписатьНачалоМассива();
Флаг = Ложь;
Для н = 1 По ЧислоЗаписей Цикл
	Флаг = Не Флаг;
	Ном = Формат(н, "ЧГ=0");

	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("ид");
	Запись.ЗаписатьЗначение(н);
	Запись.ЗаписатьИмяСвойства("имя");
	Запись.ЗаписатьЗначение("запись номер " + Ном);
	Запись.ЗаписатьИмяСвойства("активен");
	Запись.ЗаписатьЗначение(Флаг);
	Запись.ЗаписатьИмяСвойства("цена");
	Запись.ЗаписатьЗначение(н + 0.75);
	Запись.ЗаписатьИмяСвойства("теги");
	Запись.ЗаписатьНачалоМассива();
	Запись.ЗаписатьЗначение("альфа");
	Запись.ЗаписатьЗначение("бета");
	Запись.ЗаписатьЗначение("гамма");
	Запись.ЗаписатьКонецМассива();
	Запись.ЗаписатьИмяСвойства("вложенное");
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("ключ");
	Запись.ЗаписатьЗначение("значение");
	Запись.ЗаписатьИмяСвойства("число");
	Запись.ЗаписатьЗначение(н);
	Запись.ЗаписатьКонецОбъекта();

	Запись.ЗаписатьИмяСвойства("контрагент");
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("инн");
	Запись.ЗаписатьЗначение("77010" + Ном);
	Запись.ЗаписатьИмяСвойства("кпп");
	Запись.ЗаписатьЗначение("770101001");
	Запись.ЗаписатьИмяСвойства("наименование");
	Запись.ЗаписатьЗначение("ООО Ромашка " + Ном);

	Запись.ЗаписатьИмяСвойства("банковскийСчет");
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("номер");
	Запись.ЗаписатьЗначение("4070281090000000" + Ном);
	Запись.ЗаписатьИмяСвойства("банк");
	Запись.ЗаписатьЗначение("АО Банк " + Ном);
	Запись.ЗаписатьИмяСвойства("бик");
	Запись.ЗаписатьЗначение("044525225");
	Запись.ЗаписатьИмяСвойства("коррсчет");
	Запись.ЗаписатьЗначение("30101810400000000225");
	Запись.ЗаписатьКонецОбъекта();

	Запись.ЗаписатьИмяСвойства("юрАдрес");
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("регион");
	Запись.ЗаписатьЗначение("Москва");
	Запись.ЗаписатьИмяСвойства("город");
	Запись.ЗаписатьЗначение("Москва");
	Запись.ЗаписатьИмяСвойства("индекс");
	Запись.ЗаписатьЗначение("101000");
	Запись.ЗаписатьИмяСвойства("адрес");
	Запись.ЗаписатьЗначение("ул. Тверская, д. " + Ном);
	Запись.ЗаписатьКонецОбъекта();

	Запись.ЗаписатьИмяСвойства("фактическийАдрес");
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("регион");
	Запись.ЗаписатьЗначение("Московская область");
	Запись.ЗаписатьИмяСвойства("город");
	Запись.ЗаписатьЗначение("Химки");
	Запись.ЗаписатьИмяСвойства("индекс");
	Запись.ЗаписатьЗначение("141400");
	Запись.ЗаписатьИмяСвойства("адрес");
	Запись.ЗаписатьЗначение("ул. Победы, д. " + Ном);
	Запись.ЗаписатьКонецОбъекта();

	Запись.ЗаписатьКонецОбъекта();
	Запись.ЗаписатьКонецОбъекта();
КонецЦикла;
Запись.ЗаписатьКонецМассива();
Текст = Запись.Закрыть();

// --- замер ---------------------------------------------------------------
Т = ТекущаяУниверсальнаяДатаВМиллисекундах();
Записей = 0;
Для п = 1 По Проходов Цикл
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(Чтение);
	Записей = Записей + Данные.Количество();
КонецЦикла;
Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т;

// --- проверка (вне замера) ------------------------------------------------
// Сумма трогает ВСЕ четыре уровня вложенности: рантайм, «ускорившийся»
// пропуском хвоста записи или недочитанным поддеревом, здесь сразу
// разойдётся с остальными.
//
// В сумму берутся ТОЛЬКО поля из цифр. Причина не в лени: `СтрДлина` меряет
// код-юниты UTF-16, а `#` в Lua — байты, и на кириллице числа разошлись бы
// от разницы кодировок, а не от разницы разбора. Кириллические поля
// проверяются отдельным счётчиком заполненности — он от кодировки не
// зависит.
Сумма = 0;
Полных = 0;
Для Каждого Стр Из Данные Цикл
	К = Стр.контрагент;
	Сумма = Сумма + Стр.ид + Стр.вложенное.число
		+ СтрДлина(К.инн) + СтрДлина(К.кпп)
		+ СтрДлина(К.банковскийСчет.номер) + СтрДлина(К.банковскийСчет.бик)
		+ СтрДлина(К.банковскийСчет.коррсчет)
		+ СтрДлина(К.юрАдрес.индекс) + СтрДлина(К.фактическийАдрес.индекс);
	Если СтрДлина(К.наименование) > 0 И СтрДлина(К.юрАдрес.адрес) > 0
		И СтрДлина(К.фактическийАдрес.город) > 0 И СтрДлина(Стр.теги[2]) > 0 Тогда
		Полных = Полных + 1;
	КонецЕсли;
КонецЦикла;

Сообщить("длина документа: " + Формат(СтрДлина(Текст), "ЧГ=0")
	+ ", записей: " + Формат(Записей, "ЧГ=0")
	+ ", сумма: " + Формат(Сумма, "ЧГ=0")
	+ ", полных: " + Формат(Полных, "ЧГ=0"));
Сообщить(Формат(Прошло, "ЧГ=0"));
