// Вычислительная цель бенчмарка фоновых заданий. Четыре колонки и
// два прохода повторяют нагрузку ТестПроцессораКластера1С из
// https://github.com/dobpilot/1c_benchmark.
// Квалификаторы колонок исходника опущены: open-bsl их пока не реализует;
// число колонок, значения и проходы остаются теми же.
Процедура РассчитатьТаблицу(КоличествоЭлементов) Экспорт
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ID");
	Таблица.Колонки.Добавить("Q");
	Таблица.Колонки.Добавить("T");
	Таблица.Колонки.Добавить("S");

	Для Счетчик = 1 По КоличествоЭлементов Цикл
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.ID = Счетчик;
		СтрокаТаблицы.Q = 1;
		СтрокаТаблицы.T = "MGT";
		СтрокаТаблицы.S = 0;
	КонецЦикла;

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтрокаТаблицы.S = СтрокаТаблицы.Q * 20;
	КонецЦикла;
КонецПроцедуры
