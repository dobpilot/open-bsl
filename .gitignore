/benchmarks/invoice_doc.xlsx
/benchmarks/invoice_doc.mxl
/benchmarks/invoice_doc.pdf
# Файл выгрузки, который создаёт сценарий edata_writer.
/benchmarks/edata_writer.xml
*.vsix
# Каталоги сборки в любом месте дерева, а не только корневой `/target`.
target/
